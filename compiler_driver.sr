            int rpNwDn = this.newLabel();
            this.asm.bindLabel(rpNwLp);
            this.asm.movRMBase(0, 5, rpNL);
            this.asm.cmpRR64(11, 0);
            this.asm.jgeLabel(rpNwDn);
            this.asm.movRMBase(0, 5, rpN);
            this.asm.addRR64(0, 11);
            this.asm.movzxByteMBase(0, 0, 0);
            this.asm.movRMBase(1, 5, rpFnd);
            this.asm.addRR64(1, 11);
            this.asm.movMBaseByteR(1, 0, 0);
            this.asm.addRI32(11, 1);
            this.asm.jmpLabel(rpNwLp);
            this.asm.bindLabel(rpNwDn);
            this.asm.movRMBase(0, 5, rpFnd);
            this.asm.movRMBase(1, 5, rpNL);
            this.asm.addRR64(0, 1);
            this.asm.movMBaseR(5, 0, rpFnd);
            this.asm.movRMBase(0, 5, rpCnt);
            this.asm.movRMBase(1, 5, rpOL);
            this.asm.addRR64(0, 1);
            this.asm.movMBaseR(5, 0, rpPos);
            this.asm.jmpLabel(rpCpLp);
            this.asm.bindLabel(rpCpDn);
            // Copy remaining: strcpy(dst+wr, pos)
            this.asm.movRMBase(1, 5, rpFnd);
            this.asm.movRMBase(2, 5, rpPos);
            this.addImportPatch("ucrtbase.dll", "strcpy");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBADD);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movRMBase(0, 5, rpDst);
            return;
        }
        if (this.strEq(name, "split")) {
            // split(delim) - returns string[] using strstr iteration
            if (call.childCount() < 2) { this.genExpr(recv); return; }
            int spR = this.allocLocal("__sp_r");
            int spD = this.allocLocal("__sp_d");
            int spRL = this.allocLocal("__sp_rl");
            int spDL = this.allocLocal("__sp_dl");
            int spCnt = this.allocLocal("__sp_cn");
            int spArr = this.allocLocal("__sp_ar");
            int spPos = this.allocLocal("__sp_ps");
            int spFnd = this.allocLocal("__sp_fn");
            int spWr = this.allocLocal("__sp_wr");
            this.genExpr(recv);
            this.asm.movMBaseR(5, 0, spR);
            this.genExpr(call.child(1));
            this.asm.movMBaseR(5, 0, spD);
            // strlen both
            this.asm.movRMBase(1, 5, spR);
            this.addImportPatch("ucrtbase.dll", "strlen");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBACC);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, spRL);
            this.asm.movRMBase(1, 5, spD);
            this.addImportPatch("ucrtbase.dll", "strlen");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBACD);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, spDL);
            // Count parts with strstr
            this.asm.movRI64(0, 1);
            this.asm.movMBaseR(5, 0, spCnt);
            this.asm.movRMBase(0, 5, spR);
            this.asm.movMBaseR(5, 0, spPos);
            int spCntL = this.newLabel();
            int spCntD = this.newLabel();
            this.asm.bindLabel(spCntL);
            this.asm.movRMBase(1, 5, spPos);
            this.asm.movRMBase(2, 5, spD);
            this.addImportPatch("ucrtbase.dll", "strstr");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBACE);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, spFnd);
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(spCntD);
            this.asm.movRMBase(0, 5, spCnt);
            this.asm.addRI32(0, 1);
            this.asm.movMBaseR(5, 0, spCnt);
            this.asm.movRMBase(0, 5, spFnd);
            this.asm.movRMBase(1, 5, spDL);
            this.asm.addRR64(0, 1);
            this.asm.movMBaseR(5, 0, spPos);
            this.asm.jmpLabel(spCntL);
            this.asm.bindLabel(spCntD);
            // Alloc array
            this.asm.movRMBase(0, 5, spCnt);
            this.asm.addRI32(0, 2);
            this.asm.shlR64Imm(0, 3);
            this.asm.movRR64(1, 0);
            this.addImportPatch("msvcrt.dll", "malloc");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBACF);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, spArr);
            this.asm.movRMBase(0, 5, spCnt);
            this.asm.addRI32(0, 2);
            this.asm.movRMBase(1, 5, spArr);
            this.asm.movMBaseR(1, 0, 0);
            this.asm.movRMBase(0, 5, spCnt);
            this.asm.movRMBase(1, 5, spArr);
            this.asm.movMBaseR(1, 0, 8);
            // Second pass: extract parts
            this.asm.movRMBase(0, 5, spR);
            this.asm.movMBaseR(5, 0, spPos);
            this.asm.xorRR64(11, 11);
            int spPassL = this.newLabel();
            int spPassD = this.newLabel();
            this.asm.bindLabel(spPassL);
            this.asm.movRMBase(0, 5, spCnt);
            this.asm.cmpRR64(11, 0);
            this.asm.jgeLabel(spPassD);
            this.asm.movRMBase(1, 5, spPos);
            this.asm.movRMBase(2, 5, spD);
            this.addImportPatch("ucrtbase.dll", "strstr");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD0);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, spFnd);
            int spLast = this.newLabel();
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(spLast);
            this.asm.movRMBase(0, 5, spFnd);
            this.asm.movRMBase(1, 5, spPos);
            this.asm.subRR64(0, 1);
            this.asm.movMBaseR(5, 0, spWr);
            this.asm.movRMBase(0, 5, spWr);
            this.asm.addRI32(0, 1);
            this.asm.movRR64(1, 0);
            this.addImportPatch("msvcrt.dll", "malloc");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD1);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, spFnd);
            this.asm.movRMBase(1, 5, spPos);
            this.asm.movRMBase(2, 5, spFnd);
            this.asm.movRMBase(3, 5, spWr);
            int spCpL = this.newLabel();
            int spCpD = this.newLabel();
            this.asm.xorRR64(10, 10);
            this.asm.bindLabel(spCpL);
            this.asm.cmpRR64(10, 3);
            this.asm.jgeLabel(spCpD);
            this.asm.movzxByteMBase(0, 1, 0);
            this.asm.movMBaseByteR(2, 0, 0);
            this.asm.addRI32(1, 1);
            this.asm.addRI32(2, 1);
            this.asm.addRI32(10, 1);
            this.asm.jmpLabel(spCpL);
            this.asm.bindLabel(spCpD);
            this.asm.movRMBase(0, 5, spFnd);
            this.asm.movRMBase(1, 5, spWr);
            this.asm.addRR64(0, 1);
            this.asm.xorRR64(2, 2);
            this.asm.movMBaseByteR(0, 2, 0);
            this.asm.bindLabel(spLast);
            this.asm.movRMBase(0, 5, spFnd);
            this.asm.shlR64Imm(11, 3);
            this.asm.movRMBase(1, 5, spArr);
            this.asm.addRR64(1, 11);
            this.asm.movMBaseR(1, 0, 16);
            this.asm.movRMBase(0, 5, spFnd);
            this.asm.addRI32(0, 1);
            this.asm.movMBaseR(5, 0, spPos);
            this.asm.addRI32(11, 1);
            this.asm.jmpLabel(spPassL);
            this.asm.bindLabel(spPassD);
            this.asm.movRMBase(0, 5, spArr);
            return;
        }
        if (this.strEq(name, "isAlpha") || this.strEq(name, "isAlphaNum") || this.strEq(name, "isDigit") || this.strEq(name, "isLower") || this.strEq(name, "isUpper")) {
            this.genExpr(recv);
            this.asm.movRR64(1, 0);
            int cYes = this.newLabel();
            int cEnd = this.newLabel();
            int cNo = this.newLabel();
            if (this.strEq(name, "isDigit")) {
                this.asm.cmpRI32(1, 48);
                this.asm.jlLabel(cNo);
                this.asm.cmpRI32(1, 57);
                this.asm.jleLabel(cYes);
            } elif (this.strEq(name, "isLower")) {
                this.asm.cmpRI32(1, 97);
                this.asm.jlLabel(cNo);
                this.asm.cmpRI32(1, 122);
                this.asm.jleLabel(cYes);
            } elif (this.strEq(name, "isUpper")) {
                this.asm.cmpRI32(1, 65);
                this.asm.jlLabel(cNo);
                this.asm.cmpRI32(1, 90);
                this.asm.jleLabel(cYes);
            } elif (this.strEq(name, "isAlpha")) {
                int lo1 = this.newLabel();
                this.asm.cmpRI32(1, 65);
                this.asm.jlLabel(lo1);
                this.asm.cmpRI32(1, 90);
                this.asm.jleLabel(cYes);
                this.asm.bindLabel(lo1);
                this.asm.cmpRI32(1, 97);
                this.asm.jlLabel(cNo);
                this.asm.cmpRI32(1, 122);
                this.asm.jleLabel(cYes);
            } elif (this.strEq(name, "isAlphaNum")) {
                int midNo = this.newLabel();
                this.asm.cmpRI32(1, 48);
                this.asm.jlLabel(midNo);
                this.asm.cmpRI32(1, 57);
                this.asm.jleLabel(cYes);
                this.asm.bindLabel(midNo);
                this.asm.cmpRI32(1, 65);
                this.asm.jlLabel(cNo);
                this.asm.cmpRI32(1, 90);
                this.asm.jleLabel(cYes);
                this.asm.cmpRI32(1, 97);
                this.asm.jlLabel(cNo);
                this.asm.cmpRI32(1, 122);
                this.asm.jleLabel(cYes);
            }
            this.asm.bindLabel(cNo);
            this.asm.movRI64(0, 0);
            this.asm.jmpLabel(cEnd);
            this.asm.bindLabel(cYes);
            this.asm.movRI64(0, 1);
            this.asm.bindLabel(cEnd);
            return;
        }
    }

    public void genTrimEnd(Node recv) {
        int srcOff = this.allocLocal("__trim_src");
        int lenOff = this.allocLocal("__trim_len");
        int iOff = this.allocLocal("__trim_i");
        int outOff = this.allocLocal("__trim_out");
        this.genExpr(recv);
        this.asm.movMBaseR(5, 0, srcOff);
        this.asm.movRMBase(1, 5, srcOff);
        this.addImportPatch("ucrtbase.dll", "strlen");
        int sTrimLen = 0xDEADBEEFCAFEBAD8;
        this.asm.emitImm64(0, sTrimLen);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, lenOff);

        int trimLoop = this.newLabel();
        int trimDone = this.newLabel();
        int trimKeep = this.newLabel();
        this.asm.bindLabel(trimLoop);
        this.asm.movRMBase(0, 5, lenOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jleLabel(trimDone);
        this.asm.subRI32(0, 1);
        this.asm.movRMBase(1, 5, srcOff);
        this.asm.addRR64(1, 0);
        this.asm.movzxByteMBase(2, 1, 0);
        this.asm.cmpRI32(2, 32);
        this.asm.jeLabel(trimKeep);
        this.asm.cmpRI32(2, 9);
        this.asm.jeLabel(trimKeep);
        this.asm.cmpRI32(2, 10);
        this.asm.jeLabel(trimKeep);
        this.asm.cmpRI32(2, 13);
        this.asm.jneLabel(trimDone);
        this.asm.bindLabel(trimKeep);
        this.asm.movMBaseR(5, 0, lenOff);
        this.asm.jmpLabel(trimLoop);
        this.asm.bindLabel(trimDone);

        this.asm.movRMBase(1, 5, lenOff);
        this.asm.addRI32(1, 1);
        this.addImportPatch("msvcrt.dll", "malloc");
        int sTrimAlloc = 0xDEADBEEFCAFEBAD9;
        this.asm.emitImm64(0, sTrimAlloc);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, outOff);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, iOff);
        int copyLoop = this.newLabel();
        int copyDone = this.newLabel();
        this.asm.bindLabel(copyLoop);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(copyDone);
        this.asm.movRMBase(1, 5, srcOff);
        this.asm.addRR64(1, 0);
        this.asm.movzxByteMBase(2, 1, 0);
        this.asm.movRMBase(1, 5, outOff);
        this.asm.addRR64(1, 0);
        this.asm.movMBaseByteR(1, 2, 0);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(copyLoop);
        this.asm.bindLabel(copyDone);
        this.asm.movRMBase(0, 5, outOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.addRR64(0, 1);
        this.asm.xorRR64(2, 2);
        this.asm.movMBaseByteR(0, 2, 0);
        this.asm.movRMBase(0, 5, outOff);
    }

    public void genMemberCall(Node call) {
        string name = call.name;
        Node recv = call.child(0);
        string recvClass = this.inferExprType(recv);
        int funcIdx = -1;
        for (int i = 0; i < this.funcNames.length; i++) {
            if (this.strEq(this.funcNames[i], name) && this.typeNameEq(this.funcClasses[i], recvClass)) {
                funcIdx = i;
            }
        }
        if (funcIdx < 0) {
            for (int i = 0; i < this.funcNames.length; i++) {
                if (this.strEq(this.funcNames[i], name)) {
                    funcIdx = i;
                }
            }
        }
        string lookupClass = "";
        if (funcIdx >= 0) {
            lookupClass = this.funcClasses[funcIdx];
        }

        // Use slots reserved before the function prologue.  The old
        // per-call allocLocal and stack-spill variants either changed the
        // frame after prologue emission or depended on a volatile register
        // surviving nested generated calls.
        // Member-call child(0) is the receiver, not a declared method
        // parameter.  The receiver uses the method ABI's RCX slot; declared
        // parameters begin at child(1) and use RDX/R8/R9/stack.
        int explicitArgs = call.childCount() - 1;
        if (explicitArgs < 0) { explicitArgs = 0; }
        int totalUserArgs = explicitArgs;
        if (funcIdx >= 0 && funcIdx < this.funcParamCounts.length) {
            int paramCount = this.funcParamCounts[funcIdx];
            int paramStart = this.funcParamStarts[funcIdx];
            while (totalUserArgs < paramCount && totalUserArgs + paramStart < this.funcParamHasDefaults.length && this.funcParamHasDefaults[totalUserArgs + paramStart] == 1) {
                totalUserArgs = totalUserArgs + 1;
            }
        }
        int totalArgs = totalUserArgs + 1;
        int scratchBase = this.funcCallArgCount;

        if (scratchBase + totalArgs > 64) {
            printline("too many nested call arguments");
            exit(1);
            return;
        }
        this.funcCallArgCount = this.funcCallArgCount + totalArgs;
        for (int i = 0; i < totalArgs; i++) {
            if (i == 0) {
                this.genExpr(call.child(0));
            } elif (i <= explicitArgs) {
                this.genExpr(call.child(i));
            } elif (funcIdx >= 0 && funcIdx < this.funcParamStarts.length) {
                int defaultIndex = this.funcParamStarts[funcIdx] + i - 1;
                if (defaultIndex < this.funcParamDefaults.length) {
                    this.genExpr(this.funcParamDefaults[defaultIndex]);
                } else {
                    this.asm.xorRR64(0, 0);
                }
            } else {
                this.asm.xorRR64(0, 0);
            }
            int argOff = this.scratchBaseOffset - (8 * (scratchBase + i));
            this.asm.movMBaseR(5, 0, argOff);
        }

        int extraStack = 0;
        if (totalArgs > 4) {
            extraStack = (totalArgs - 4) * 8;
        }
        this.asm.emitCallSetup(extraStack);
        // Methods use RCX for `this`, then RDX/R8/R9 for declared parameters.
        // Further parameters are placed after Win64 shadow space at [RSP+32].
        int[] argRegs = [1, 2, 8, 9];
        int regArgs = totalArgs;
        if (regArgs > 4) { regArgs = 4; }
        for (int i = 0; i < regArgs; i++) {
            int argOff = this.scratchBaseOffset - (8 * (scratchBase + i));
            this.asm.movRMBase(argRegs[i], 5, argOff);
        }
        for (int i = 4; i < totalArgs; i++) {
            int argOff = this.scratchBaseOffset - (8 * (scratchBase + i));
            this.asm.movRMBase(0, 5, argOff);
            this.asm.movMBaseR(4, 0, 32 + (i - 4) * 8);
        }

        if (funcIdx >= 0 && funcIdx < this.funcOffsets.length) {
            int targetOff = this.funcOffsets[funcIdx];
            if (targetOff >= 0) {
                int callPos = this.asm.buf.length;
                int rel32 = targetOff - (callPos + 5);
                this.asm.callRel32(rel32);
            } else {
                this.asm.callRel32(0);
                this.forwardCalls.add(this.asm.buf.length - 4);
                this.forwardCallNames.add(name);
                this.forwardCallClasses.add(lookupClass);
            }
        } else {
            this.asm.callRel32(0);
            this.forwardCalls.add(this.asm.buf.length - 4);
            this.forwardCallNames.add(name);
            this.forwardCallClasses.add(lookupClass);
        }
        this.asm.emitCallTeardown();
        this.funcCallArgCount = scratchBase;
    }

    public void genBinary(Node bin) {
        if (bin.childCount() < 2) { return; }
        int op = bin.op;
        if (op == 25) {
            this.genExpr(bin.child(0));
            this.asm.pushR64(0);
            int fallback = this.newLabel();
            int done = this.newLabel();
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(fallback);
            this.asm.popR64(0);
            this.asm.jmpLabel(done);
            this.asm.bindLabel(fallback);
            this.asm.popR64(1);
            this.genExpr(bin.child(1));
            this.asm.bindLabel(done);
            return;
        }
        if (op == 20) {
            this.genAssign(bin);
            return;
        }
        if (op >= 14 && op <= 17) {
            this.genCompoundAssign(bin, op);
            return;
        }
        if (op == 1) {
            string lt = this.inferExprType(bin.child(0));
            string rt = this.inferExprType(bin.child(1));
            // Only a real string operand makes `+` string concatenation.
            // A char operand alone (`'a' + 1`, `'a' + 'b'`) is integer
            // arithmetic on the code point; treating char as string there
            // silently produced garbage from the string-concat path.
            if (this.strEq(lt, "string") || this.strEq(rt, "string")) {
                this.genStringConcat(bin);
                return;
            }
        }
        // Strings are pointers, so pointer comparison is not value equality.
        // Lower string equality through strcmp while leaving numeric/char
        // comparisons on the ordinary integer path below.
        if (op == 5 || op == 6) {
            string eqLt = this.inferExprType(bin.child(0));
            string eqRt = this.inferExprType(bin.child(1));
            if (this.strEq(eqLt, "string") && this.strEq(eqRt, "string")) {
                this.genExpr(bin.child(0));
                this.asm.pushR64(0);
                this.genExpr(bin.child(1));
                this.asm.movRR64(2, 0);
                this.asm.popR64(1);
                this.addImportPatch("ucrtbase.dll", "strcmp");
                int sEq = 0xDEADBEEFCAFEBAD8;
                this.asm.emitImm64(0, sEq);
                this.asm.movRMBase(0, 0, 0);
                this.asm.emitCallSetup(0);
                this.asm.callR64(0);
                this.asm.emitCallTeardown();
                this.asm.cmpRI32(0, 0);
                int eqTrue = this.newLabel();
                int eqDone = this.newLabel();
                if (op == 5) { this.asm.jeLabel(eqTrue); }
                else { this.asm.jneLabel(eqTrue); }
                this.asm.xorRR64(0, 0);
                this.asm.jmpLabel(eqDone);
                this.asm.bindLabel(eqTrue);
                this.asm.movRI64(0, 1);
                this.asm.bindLabel(eqDone);
                return;
            }
        }
        this.genExpr(bin.child(0));
        this.asm.pushR64(0);
        this.genExpr(bin.child(1));
        this.asm.movRR64(1, 0);
        this.asm.popR64(0);
        if (op == 1) {
            this.asm.addRR64(0, 1);
        } elif (op == 2) {
            this.asm.subRR64(0, 1);
        } elif (op == 3) {
            this.asm.mulRR64(1);
        } elif (op == 4) {
            this.asm.cqo();
            this.asm.idivR64(1);
        } elif (op == 13) {
            this.asm.cqo();
            this.asm.idivR64(1);
            this.asm.movRR64(0, 2);
        } elif (op == 18) {
            // << : shl rax, cl (RAX=lhs, RCX=rhs count)
            this.asm.shlRCl64(0);
        } elif (op == 19) {
            // >> : shr rax, cl
            this.asm.shrRCl64(0);
        } elif (op == 22) {
            // & : bitwise and
            this.asm.andRR64(0, 1);
        } elif (op == 23) {
            // | : bitwise or
            this.asm.orRR64(0, 1);
        } elif (op == 24) {
            // ^ : bitwise xor
            this.asm.xorRR64(0, 1);
    } elif (op >= 5 && op <= 10) {
        this.asm.cmpRR64(0, 1);
            int t = this.newLabel();
            int e = this.newLabel();
            if (op == 5) { this.asm.jeLabel(t); }
            elif (op == 6) { this.asm.jneLabel(t); }
            elif (op == 7) { this.asm.jlLabel(t); }
            elif (op == 8) { this.asm.jleLabel(t); }
            elif (op == 9) { this.asm.jgLabel(t); }
            elif (op == 10) { this.asm.jgeLabel(t); }
            this.asm.movRI64(0, 0);
            this.asm.jmpLabel(e);
            this.asm.bindLabel(t);
            this.asm.movRI64(0, 1);
            this.asm.bindLabel(e);
        } elif (op == 11) {
            int f = this.newLabel();
            int ed = this.newLabel();
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(f);
            this.asm.cmpRI32(1, 0);
            this.asm.jeLabel(f);
            this.asm.movRI64(0, 1);
            this.asm.jmpLabel(ed);
            this.asm.bindLabel(f);
            this.asm.movRI64(0, 0);
            this.asm.bindLabel(ed);
        } elif (op == 12) {
            int t = this.newLabel();
            int ed = this.newLabel();
            this.asm.cmpRI32(0, 0);
            this.asm.jneLabel(t);
            this.asm.cmpRI32(1, 0);
            this.asm.jneLabel(t);
            this.asm.movRI64(0, 0);
            this.asm.jmpLabel(ed);
            this.asm.bindLabel(t);
            this.asm.movRI64(0, 1);
            this.asm.bindLabel(ed);
        }
    }

    public void genCompoundAssign(Node bin, int op) {
        Node lhs = bin.child(0);
        Node rhs = bin.child(1);
        if (lhs.kind == 6) {
            int off = this.findLocal(lhs.name);
            int gi = this.findGlobal(lhs.name);
            if (op == 14) {
                string lt = this.getLocalType(lhs.name);
                if (this.strEq(lt, "string")) {
                    this.genStringConcat(bin);
                    if (off != 0) { this.asm.movMBaseR(5, 0, off); }
                    elif (gi >= 0) { this.genGlobalStore(gi); }
                    else { this.asm.movMBaseR(5, 0, 0); }
                    return;
                }
            }
            if (off != 0) { this.asm.movRMBase(0, 5, off); }
            elif (gi >= 0) { this.genGlobalLoad(gi); }
            else { this.asm.movRMBase(0, 5, 0); }
            this.asm.pushR64(0);
            this.genExpr(rhs);
            this.asm.movRR64(1, 0);
            this.asm.popR64(0);
            if (op == 14) { this.asm.addRR64(0, 1); }
            elif (op == 15) { this.asm.subRR64(0, 1); }
            elif (op == 16) { this.asm.mulRR64(1); }
            elif (op == 17) { this.asm.cqo(); this.asm.idivR64(1); }
            if (off != 0) { this.asm.movMBaseR(5, 0, off); }
            elif (gi >= 0) { this.genGlobalStore(gi); }
            else { this.asm.movMBaseR(5, 0, 0); }
            return;
        }
        if (lhs.kind == 24 && lhs.childCount() >= 2) {
            Node arrNode = lhs.child(0);
            Node idxNode = lhs.child(1);
            bool arrIsByte = false;
            if (arrNode.kind == 6) {
                arrIsByte = this.isByteElemType(this.getLocalType(arrNode.name));
            } elif (arrNode.kind == 13) {
                Node arrObj = arrNode.child(0);
                if (arrObj.kind == 6 && this.strEq(arrObj.name, "this")) {
                    // Stable classification for self-hosted stages: resolve the
                    // field type from the class table instead of the recursive
                    // inferExprType path.
                    arrIsByte = this.isByteElemType(this.findFieldType(this.currentClassName, arrNode.name));
                } else {
                    arrIsByte = this.isByteElemType(this.inferExprType(arrNode));
                }
            }
            if (arrNode.kind == 6) {
                int arrOff = this.findLocal(arrNode.name);
                this.genExpr(idxNode);
                this.asm.pushR64(0);
                this.asm.movRMBase(11, 5, arrOff);
                this.asm.popR64(0);
                if (!arrIsByte) { this.asm.shlR64Imm(0, 3); }
                this.asm.addRR64(11, 0);
                if (arrIsByte) {
                    this.asm.movzxByteMBase(0, 11, 0);
                } else {
                    this.asm.movRMBase(0, 11, 0);
                }
                this.asm.pushR64(0);
                this.genExpr(rhs);
                this.asm.movRR64(1, 0);
                this.asm.popR64(0);
                if (op == 14) { this.asm.addRR64(0, 1); }
                elif (op == 15) { this.asm.subRR64(0, 1); }
                elif (op == 16) { this.asm.mulRR64(1); }
                if (arrIsByte) {
                    this.asm.movMBaseByteR(11, 0, 0);
                } else {
                    this.asm.movMBaseR(11, 0, 0);
                }
                return;
            } else {
                this.genExpr(arrNode);
                this.asm.pushR64(0);
                this.genExpr(idxNode);
                if (!arrIsByte) { this.asm.shlR64Imm(0, 3); }
                this.asm.movRR64(11, 0);
                this.asm.popR64(0);
                this.asm.addRR64(0, 11);
                this.asm.pushR64(0);
                if (arrIsByte) {
                    this.asm.movzxByteMBase(0, 0, 0);
                } else {
                    this.asm.movRMBase(0, 0, 0);
                }
                this.asm.pushR64(0);
                this.genExpr(rhs);
                this.asm.movRR64(1, 0);
                this.asm.popR64(0);
                if (op == 14) { this.asm.addRR64(0, 1); }
                elif (op == 15) { this.asm.subRR64(0, 1); }
                elif (op == 16) { this.asm.mulRR64(1); }
                this.asm.popR64(11);
                if (arrIsByte) {
                    this.asm.movMBaseByteR(11, 0, 0);
                } else {
                    this.asm.movMBaseR(11, 0, 0);
                }
                return;
            }
        }
        if (lhs.kind == 13 && lhs.childCount() >= 1) {
            Node obj = lhs.child(0);
            string fieldName = lhs.name;
            if (obj.kind == 6 && this.strEq(obj.name, "this")) {
                int thisOff = this.findLocal("this");
                int fieldOff = this.findFieldOffset(this.currentClassName, fieldName);
                if (fieldOff < 0) { this.genExpr(rhs); return; }
                this.asm.movRMBase(0, 5, thisOff);
                this.asm.movRMBase(0, 0, fieldOff);
                this.asm.pushR64(0);
                this.genExpr(rhs);
                this.asm.movRR64(1, 0);
                this.asm.popR64(0);
                if (op == 14) { this.asm.addRR64(0, 1); }
                elif (op == 15) { this.asm.subRR64(0, 1); }
                elif (op == 16) { this.asm.mulRR64(1); }
                elif (op == 17) { this.asm.cqo(); this.asm.idivR64(1); }
                this.asm.movRMBase(10, 5, thisOff);
                this.asm.addRI32(10, fieldOff);
                this.asm.movMBaseR(10, 0, 0);
                return;
            }
            if (obj.kind == 13) {
                // Nested member chain compound assign (e.g. this.inner.x += 1)
                string ownerType = this.inferMemberAccessType(obj);
                int fieldOff = this.findFieldOffset(ownerType, fieldName);
                if (fieldOff < 0) {
                    fieldOff = this.findFieldOffsetInAllClasses(fieldName);
                }
                if (fieldOff >= 0) {
                    this.genExpr(obj);
                    this.asm.pushR64(0);
                    this.genExpr(lhs);
                    this.asm.pushR64(0);
                    this.genExpr(rhs);
                    this.asm.movRR64(1, 0);
                    this.asm.popR64(0);
                    if (op == 14) { this.asm.addRR64(0, 1); }
                    elif (op == 15) { this.asm.subRR64(0, 1); }
                    elif (op == 16) { this.asm.mulRR64(1); }
                    elif (op == 17) { this.asm.cqo(); this.asm.idivR64(1); }
                    this.asm.popR64(11);
                    this.asm.addRI32(11, fieldOff);
                    this.asm.movMBaseR(11, 0, 0);
                } else {
                    this.genExpr(rhs);
                }
                return;
            }
        }
        this.genExpr(rhs);
    }

    public void genAssign(Node bin) {
        Node lhs = bin.child(0);
        Node rhs = bin.child(1);
        if (lhs.kind == 6) {
            int off = this.findLocal(lhs.name);
            int gi = this.findGlobal(lhs.name);
            this.genExpr(rhs);
            if (off != 0) {
                this.asm.movMBaseR(5, 0, off);
            } elif (gi >= 0) {
                this.genGlobalStore(gi);
            } else {
                this.asm.movMBaseR(5, 0, 0);
            }
            return;
        }
        if (lhs.kind == 13 && lhs.childCount() >= 1) {
            Node obj = lhs.child(0);
            string fieldName = lhs.name;
            if (obj.kind == 6 && this.strEq(obj.name, "this")) {
                int thisOff = this.findLocal("this");
                int fieldOff = this.findFieldOffset(this.currentClassName, fieldName);
                if (fieldOff < 0) {
                    this.genExpr(rhs);
                    return;
                }
                this.genExpr(rhs);
                this.asm.pushR64(0);
                this.asm.movRMBase(0, 5, thisOff);
                this.asm.addRI32(0, fieldOff);
                this.asm.popR64(1);
                this.asm.movMBaseR(0, 1, 0);
                return;
            }
            if (obj.kind == 6) {
                string varType = this.getLocalType(obj.name);
                int off = this.findLocal(obj.name);
                int gi = this.findGlobal(obj.name);
                string lookupType = varType;
                string elemType = this.arrayElementType(varType);
                if (!this.strEq(elemType, "")) { lookupType = elemType; }
                int fieldOff = this.findFieldOffset(lookupType, fieldName);
                if (fieldOff < 0) {
                    this.genExpr(rhs);
                    return;
                }
                this.genExpr(rhs);
                this.asm.pushR64(0);
                if (off != 0) {
                    this.asm.movRMBase(0, 5, off);
                } elif (gi >= 0) {
                    // Global object field write: load the object pointer from
                    // its global slot (findLocal returns 0 for globals, which
                    // would dereference [rbp+0] - the saved rbp - and crash).
                    this.genGlobalLoad(gi);
                } else {
                    this.asm.movRMBase(0, 5, 0);
                }
                this.asm.addRI32(0, fieldOff);
                this.asm.popR64(1);
                this.asm.movMBaseR(0, 1, 0);
                return;
            }
            if (obj.kind == 13) {
                // Nested member chain (e.g. this.inner.arr = rhs): evaluate the
                // owner object, then store the value into its field slot.
                string ownerType = this.inferMemberAccessType(obj);
                int fieldOff = this.findFieldOffset(ownerType, fieldName);
                if (fieldOff < 0) {
                    fieldOff = this.findFieldOffsetInAllClasses(fieldName);
                }
                if (fieldOff >= 0) {
                    this.genExpr(obj);
                    this.asm.pushR64(0);
                    this.genExpr(rhs);
                    this.asm.movRR64(12, 0);
                    this.asm.popR64(0);
                    this.asm.addRI32(0, fieldOff);
                    this.asm.movMBaseR(0, 12, 0);
                } else {
                    this.genExpr(rhs);
                }
                return;
            }
        }
        if (lhs.kind == 24 && lhs.childCount() >= 2) {
            Node arrNode = lhs.child(0);
            Node idxNode = lhs.child(1);
            if (this.isDictType(this.inferReceiverType(arrNode))) {
                this.genDictIndexSet(bin);
                return;
            }
            bool arrIsByte = false;
            if (arrNode.kind == 6) {
                arrIsByte = this.isByteElemType(this.getLocalType(arrNode.name));
            } elif (arrNode.kind == 13) {
                Node arrObj = arrNode.child(0);
                if (arrObj.kind == 6 && this.strEq(arrObj.name, "this")) {
                    // Classify from the class field table directly.  The
                    // recursive inferExprType path is not stable in later
                    // self-hosted stages (see genArrayIndex), so `this.field`
                    // array stores must resolve the element size here.
                    arrIsByte = this.isByteElemType(this.findFieldType(this.currentClassName, arrNode.name));
                } else {
                    arrIsByte = this.isByteElemType(this.inferExprType(arrNode));
                }
            }
            if (arrNode.kind == 6) {
                int arrOff = this.findLocal(arrNode.name);
                this.genExpr(idxNode);
                this.asm.pushR64(0);
                this.genExpr(rhs);
                this.asm.pushR64(0);
                this.asm.movRMBase(11, 5, arrOff);
                this.asm.popR64(12);
                this.asm.popR64(0);
                if (!arrIsByte) { this.asm.shlR64Imm(0, 3); }
                this.asm.addRR64(11, 0);
                if (arrIsByte) {
                    this.asm.movMBaseByteR(11, 12, 0);
                } else {
                    this.asm.movMBaseR(11, 12, 0);
                }
                this.asm.movRI64(0, 0);
                return;
            } else {
                this.genExpr(arrNode);
                this.asm.pushR64(0);
                this.genExpr(idxNode);
                if (!arrIsByte) { this.asm.shlR64Imm(0, 3); }
                this.asm.movRR64(11, 0);
                this.asm.popR64(0);
                this.asm.addRR64(0, 11);
                this.asm.pushR64(0);
                this.genExpr(rhs);
                this.asm.movRR64(12, 0);
                this.asm.popR64(0);
                if (arrIsByte) {
                    this.asm.movMBaseByteR(0, 12, 0);
                } else {
                    this.asm.movMBaseR(0, 12, 0);
                }
                this.asm.movRI64(0, 0);
                return;
            }
        }
        this.genExpr(rhs);
    }

    public void addFormatStr(string fmt) {
        int fmtIdx = this.addString(fmt);
        int sp = this.asm.buf.length;
        this.asm.emitImm64(0, 0);
        int fmtPatchPos = sp + 2;
        this.stringPatchOffsets.add(fmtPatchPos);
        this.stringPatchIndices.add(fmtIdx);
        this.asm.movRR64(1, 0);
    }

    public bool isByteElemType(string t) {
        // True when an array type stores single bytes per element (byte[],
        // char[], and the internal string representation).  Such arrays must
        // be indexed without the *8 scaling used for 64-bit element types and
        // accessed with byte loads/stores instead of full-width moves.
        if (this.strEq(t, "byte[]")) { return true; }
        if (this.strEq(t, "char[]")) { return true; }
        if (this.strEq(t, "string")) { return true; }
        return false;
    }

    public bool isStringLike(Node expr) {
        // Characters are represented as integer code points in the native
        // printf path.  Treat only actual strings as `%s`; passing a char
        // value to `%s` makes printf dereference the code point as a pointer.
        if (expr.kind == 2) { return true; }
        if (expr.kind == 6) {
            string t = this.getLocalType(expr.name);
            if (this.strEq(t, "")) {
                for (int ci = 0; ci < this.constNames.length; ci++) {
                    if (this.strEq(this.constNames[ci], expr.name)) {
                        if (ci < this.constStringValues.length && !this.strEq(this.constStringValues[ci], "")) {
                            return true;
                        }
                    }
                }
            }
            return this.strEq(t, "string") || this.strEq(t, "char");
        }
        if (expr.kind == 13) {
            string t = this.inferMemberAccessType(expr);
            return this.strEq(t, "string");
        }
        if (expr.kind == 24) {
            string t = this.inferExprType(expr);
            return this.strEq(t, "string");
        }
        if (expr.kind == 10) {
            string t = this.inferExprType(expr);
            return this.strEq(t, "string");
        }
        if (expr.kind == 7) {
            int op = expr.op;
            if (op == 1) {
                if (this.isStringLike(expr.child(0))) { return true; }
                if (this.isStringLike(expr.child(1))) { return true; }
            }
        }
        return false;
    }

    public void genPrintCall(Node call, bool newline) {
        if (call.childCount() < 1) { return; }
        Node arg = call.child(0);
        if (arg.kind == 2) {
            string s = arg.strVal;
            if (newline) { s = s + "\n"; }
            int strIdx = this.addString(s);
            int sp = this.asm.buf.length;
            this.asm.emitImm64(0, 0);
            int strPatchPos = sp + 2;
            this.stringPatchOffsets.add(strPatchPos);
            this.stringPatchIndices.add(strIdx);
            this.asm.movRR64(1, 0);
        } else {
            this.genExpr(arg);
            this.asm.pushR64(0);
            bool strLike = this.isStringLike(arg);
            if (newline) {
                if (strLike) { this.addFormatStr("%s\n"); } else { this.addFormatStr("%lld\n"); }
            } else {
                if (strLike) { this.addFormatStr("%s"); } else { this.addFormatStr("%lld"); }
            }
            this.asm.popR64(2);
        }
        this.addImportPatch("msvcrt.dll", "printf");
        int s1 = 0xDEADBEEFCAFEBAD0;
        this.asm.emitImm64(0, s1);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }

    public void genCharToString(Node expr) {
        this.genExpr(expr);
        int chOff = this.allocLocal("__c2s_ch");
        this.asm.movMBaseR(5, 0, chOff);
        this.asm.movRI64(1, 2);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRMBase(1, 5, chOff);
        this.asm.andRImm(1, 0xFF);
        this.asm.movMBaseByteR(0, 1, 0);
        this.asm.movRI64(2, 0);
        this.asm.movMBaseByteR(0, 2, 1);
    }

    public void genIntToString(Node expr) {
        this.genExpr(expr);
        int valOff = this.allocLocal("__i2s_val");
        this.asm.movMBaseR(5, 0, valOff);
        this.asm.movRI64(1, 32);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int bufOff = this.allocLocal("__i2s_buf");
        this.asm.movMBaseR(5, 0, bufOff);
        this.addFormatStr("%lld");
        this.asm.movRMBase(8, 5, valOff);
        this.asm.movRR64(2, 1);
        this.asm.movRMBase(1, 5, bufOff);
        this.addImportPatch("msvcrt.dll", "sprintf");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD6);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRMBase(0, 5, bufOff);
    }

    public void genStringConcat(Node bin) {
        if (bin.childCount() < 2) { return; }
        string rt = this.inferExprType(bin.child(1));
        if (this.strEq(rt, "char")) {
            this.genCharToString(bin.child(1));
        } elif (this.strEq(rt, "string")) {
            this.genExpr(bin.child(1));
        } else {
            this.genIntToString(bin.child(1));
        }
        int rhsOff = this.allocLocal("__cc_rhs");
        this.asm.movMBaseR(5, 0, rhsOff);
        string lt = this.inferExprType(bin.child(0));
        if (this.strEq(lt, "char")) {
            this.genCharToString(bin.child(0));
        } elif (this.strEq(lt, "string")) {
            this.genExpr(bin.child(0));
        } else {
            this.genIntToString(bin.child(0));
        }
        int lhsOff = this.allocLocal("__cc_lhs");
        this.asm.movMBaseR(5, 0, lhsOff);

        // Allocate exactly strlen(lhs) + strlen(rhs) + 1 bytes. The old
        // fixed 1024-byte buffer overflowed the heap whenever a
        // concatenated string exceeded 1 KiB (e.g. a large LLM response),
        // silently corrupting later allocations.
        this.asm.movRMBase(1, 5, lhsOff);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD1);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int lhsLenOff = this.allocLocal("__cc_lhslen");
        this.asm.movMBaseR(5, 0, lhsLenOff);

        this.asm.movRMBase(1, 5, rhsOff);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD1);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.movRMBase(1, 5, lhsLenOff);
        this.asm.addRR64(0, 1);
        this.asm.addRI32(0, 1);
        this.asm.movRR64(1, 0);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int newOff = this.allocLocal("__cc_new");
        this.asm.movMBaseR(5, 0, newOff);

        this.asm.movRMBase(1, 5, newOff);
        this.asm.movRMBase(2, 5, lhsOff);
        this.addImportPatch("ucrtbase.dll", "strcpy");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD4);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.movRMBase(1, 5, newOff);
        this.asm.movRMBase(2, 5, rhsOff);
        this.addImportPatch("ucrtbase.dll", "strcat");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD5);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.movRMBase(0, 5, newOff);
    }

    public void genStrlenCall(Node call) {
        if (call.childCount() < 1) { return; }
        this.genExpr(call.child(0));
        this.asm.movRR64(1, 0);
        this.addImportPatch("ucrtbase.dll", "strlen");
        int s2 = 0xDEADBEEFCAFEBAD1;
        this.asm.emitImm64(0, s2);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }

    // len(x): returns the number of elements in an array, or the byte length
    // of a string. Arrays store [capacity, length, ...] with the length at
    // base-8; strings are null-terminated so strlen() gives the length.
    public void genLenCall(Node call) {
        if (call.childCount() < 1) {
            this.asm.xorRR64(0, 0);
            return;
        }
        Node arg = call.child(0);
        this.genExpr(arg);
        string t = this.inferExprType(arg);
        bool isArr = t.length >= 2 && t[t.length - 2] == '[' && t[t.length - 1] == ']';
        if (isArr) {
            // rax = array data pointer; length is at [data - 8]
            this.asm.movRMBase(1, 0, -8);
            this.asm.movRR64(0, 1);
        } else {
            // String: strlen(ptr) with ptr in rcx
            this.asm.movRR64(1, 0);
            this.addImportPatch("ucrtbase.dll", "strlen");
            int s2 = 0xDEADBEEFCAFEBAD2;
            this.asm.emitImm64(0, s2);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
        }
    }

    public void genExitCall(Node call) {
        if (call.childCount() > 0) {
            this.genExpr(call.child(0));
            this.asm.movRR64(1, 0);
        } else {
            this.asm.xorRR64(1, 1);
        }
        this.addImportPatch("kernel32.dll", "ExitProcess");
        int s3 = 0xDEADBEEFCAFEBABE;
        this.asm.emitImm64(0, s3);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }

    public void genCargsCall(Node call) {
        int cmdOff = this.allocLocal("__cargs_cmd");
        int lenOff = this.allocLocal("__cargs_len");
        int argcOff = this.allocLocal("__cargs_argc");
        int arrOff = this.allocLocal("__cargs_arr");
        int posOff = this.allocLocal("__cargs_pos");
        int inqOff = this.allocLocal("__cargs_inq");
        int intkOff = this.allocLocal("__cargs_intk");
        int tstartOff = this.allocLocal("__cargs_ts");
        int tlenOff = this.allocLocal("__cargs_tl");
        int bufOff = this.allocLocal("__cargs_buf");
        int allocSizeOff = this.allocLocal("__cargs_alloc_size");

        this.addImportPatch("kernel32.dll", "GetCommandLineA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, cmdOff);

        this.asm.movRMBase(1, 5, cmdOff);
        this.addImportPatch("ucrtbase.dll", "strlen");
        int sCL = 0xDEADBEEFCAFEBAD1;
        this.asm.emitImm64(0, sCL);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, lenOff);

        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, argcOff);
        this.asm.movMBaseR(5, 0, posOff);
        this.asm.movMBaseR(5, 0, inqOff);
        this.asm.movMBaseR(5, 0, intkOff);

        int cLoop = this.newLabel();
        int cDone = this.newLabel();
        int cInq = this.newLabel();
        int cSpace = this.newLabel();
        int cQuote = this.newLabel();
        int cQuoteInside = this.newLabel();
        int cTok = this.newLabel();
        int cNext = this.newLabel();

        this.asm.bindLabel(cLoop);
        this.asm.movRMBase(0, 5, posOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(cDone);
        this.asm.movRMBase(0, 5, cmdOff);
        this.asm.movRMBase(1, 5, posOff);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(2, 0, 0);
        this.asm.movRMBase(0, 5, inqOff);
        this.asm.cmpRI32(0, 1);
        this.asm.jeLabel(cInq);
        this.asm.cmpRI32(2, 0x20);
        this.asm.jeLabel(cSpace);
        this.asm.cmpRI32(2, 0x09);
        this.asm.jeLabel(cSpace);
        this.asm.cmpRI32(2, 0x22);
        this.asm.jeLabel(cQuote);
        this.asm.movRMBase(0, 5, intkOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jneLabel(cNext);
        this.asm.bindLabel(cTok);
        this.asm.movRMBase(0, 5, argcOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, argcOff);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, intkOff);
        this.asm.jmpLabel(cNext);
        this.asm.bindLabel(cInq);
        this.asm.cmpRI32(2, 0x22);
        this.asm.jneLabel(cNext);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, inqOff);
        this.asm.jmpLabel(cNext);
        this.asm.bindLabel(cQuote);
        this.asm.movRMBase(0, 5, intkOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jneLabel(cQuoteInside);
        this.asm.movRMBase(0, 5, argcOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, argcOff);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, intkOff);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, inqOff);
        this.asm.jmpLabel(cNext);
        this.asm.bindLabel(cQuoteInside);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, inqOff);
        this.asm.jmpLabel(cNext);
        this.asm.bindLabel(cSpace);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, intkOff);
        this.asm.bindLabel(cNext);
        this.asm.movRMBase(0, 5, posOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, posOff);
        this.asm.jmpLabel(cLoop);
        this.asm.bindLabel(cDone);

        this.asm.movRMBase(0, 5, argcOff);
        this.asm.addRI32(0, 1);
        this.asm.shlR64Imm(0, 3);
        this.asm.pushR64(0);
        this.addImportPatch("kernel32.dll", "GetProcessHeap");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRR64(1, 0);
        this.asm.xorRR64(2, 2);
        this.asm.popR64(8);
        this.addImportPatch("kernel32.dll", "HeapAlloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, arrOff);
        this.asm.movRMBase(1, 5, argcOff);
        this.asm.movMBaseR(0, 1, 0);

        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, argcOff);
        this.asm.movMBaseR(5, 0, posOff);
        this.asm.movMBaseR(5, 0, inqOff);
        this.asm.movMBaseR(5, 0, intkOff);

        int pLoop = this.newLabel();
        int pDone = this.newLabel();
        int pInq = this.newLabel();
        int pSpace = this.newLabel();
        int pQuote = this.newLabel();
        int pQuoteInside = this.newLabel();
        int pTokStart = this.newLabel();
        int pTokBody = this.newLabel();
        int pTokEnd = this.newLabel();
        int pNext = this.newLabel();

        this.asm.bindLabel(pLoop);
        this.asm.movRMBase(0, 5, posOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(pDone);
        this.asm.movRMBase(0, 5, cmdOff);
        this.asm.movRMBase(1, 5, posOff);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(2, 0, 0);
        this.asm.movRMBase(0, 5, inqOff);
        this.asm.cmpRI32(0, 1);
        this.asm.jeLabel(pInq);
        this.asm.cmpRI32(2, 0x20);
        this.asm.jeLabel(pSpace);
        this.asm.cmpRI32(2, 0x09);
        this.asm.jeLabel(pSpace);
        this.asm.cmpRI32(2, 0x22);
        this.asm.jeLabel(pQuote);
        this.asm.movRMBase(0, 5, intkOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jneLabel(pTokBody);
        this.asm.bindLabel(pTokStart);
        this.asm.movRMBase(0, 5, posOff);
        this.asm.movMBaseR(5, 0, tstartOff);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, tlenOff);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, intkOff);
        this.asm.jmpLabel(pNext);
        this.asm.bindLabel(pTokBody);
        this.asm.movRMBase(0, 5, tlenOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, tlenOff);
        this.asm.jmpLabel(pNext);
        this.asm.bindLabel(pInq);
        this.asm.cmpRI32(2, 0x22);
        this.asm.jneLabel(pTokBody);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, inqOff);
        this.asm.jmpLabel(pNext);
        this.asm.bindLabel(pQuote);
        this.asm.movRMBase(0, 5, intkOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jneLabel(pQuoteInside);
        this.asm.movRMBase(0, 5, posOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, tstartOff);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, tlenOff);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, intkOff);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, inqOff);
        this.asm.jmpLabel(pNext);
        this.asm.bindLabel(pQuoteInside);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, inqOff);
        this.asm.jmpLabel(pNext);
        this.asm.bindLabel(pSpace);
        this.asm.movRMBase(0, 5, intkOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(pNext);
        this.asm.bindLabel(pTokEnd);
        this.asm.movRMBase(1, 5, tlenOff);
        this.asm.addRI32(1, 1);
        this.asm.movMBaseR(5, 1, allocSizeOff);
        this.addImportPatch("kernel32.dll", "GetProcessHeap");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRR64(1, 0);
        this.asm.xorRR64(2, 2);
        this.asm.movRMBase(8, 5, allocSizeOff);
        this.addImportPatch("kernel32.dll", "HeapAlloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, bufOff);
        int bCopy = this.newLabel();
        int bDone = this.newLabel();
        int bi = this.allocLocal("__cargs_bi");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, bi);
        this.asm.bindLabel(bCopy);
        this.asm.movRMBase(0, 5, bi);
        this.asm.movRMBase(1, 5, tlenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(bDone);
        this.asm.movRMBase(0, 5, cmdOff);
        this.asm.movRMBase(1, 5, tstartOff);
        this.asm.addRR64(0, 1);
        this.asm.movRMBase(1, 5, bi);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(2, 0, 0);
        this.asm.movRMBase(0, 5, bufOff);
        this.asm.movRMBase(1, 5, bi);
        this.asm.movByteMBaseIdxR(0, 1, 2);
        this.asm.movRMBase(0, 5, bi);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, bi);
        this.asm.jmpLabel(bCopy);
        this.asm.bindLabel(bDone);
        this.asm.movRMBase(0, 5, bufOff);
        this.asm.movRMBase(1, 5, tlenOff);
        this.asm.addRR64(0, 1);
        this.asm.movRI64(1, 0);
        this.asm.movByteMBaseIdxR(0, 1, 1);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.addRI32(0, 8);
        this.asm.movRMBase(1, 5, argcOff);
        this.asm.shlR64Imm(1, 3);
        this.asm.addRR64(0, 1);
        this.asm.movRMBase(1, 5, bufOff);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRMBase(0, 5, argcOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, argcOff);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, intkOff);
        this.asm.bindLabel(pNext);
        this.asm.movRMBase(0, 5, posOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, posOff);
        this.asm.jmpLabel(pLoop);
        this.asm.bindLabel(pDone);
        // The command line normally ends inside the final token, not on a
        // separator. Flush that token through the same allocation/copy path
        // used for space-delimited tokens before returning the array.
        this.asm.movRMBase(0, 5, intkOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jneLabel(pTokEnd);

        // Arrays point at their first element; the length word lives one
        // element before it.  HeapAlloc returned the header address, so skip
        // the length word before exposing the array to normal array code.
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.addRI32(0, 8);
    }

    public void genGetCommandLineCall(Node call) {
        this.addImportPatch("kernel32.dll", "GetCommandLineA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }

    public void genGetEnvCall(Node call) {
        // The variable-name argument sits at child(1) for member calls
        // (`env.get(name)` where child(0) is the receiver) and at child(0) for
        // a global `getenv(name)` call.
        int keyIdx = 0;
        if (call.isMember) { keyIdx = 1; }
        if (call.childCount() <= keyIdx) { this.emitLlmaiStringLiteral(""); return; }
        this.genExpr(call.child(keyIdx));
        int keyOff = this.allocLocal("__env_key");
        this.asm.movMBaseR(5, 0, keyOff);

        // size = GetEnvironmentVariableA(key, NULL, 0): returns the required
        // buffer size including the NUL terminator, or 0 when unset.
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, keyOff);
        this.asm.xorRR64(2, 2);
        this.asm.xorRR64(8, 8);
        this.addImportPatch("kernel32.dll", "GetEnvironmentVariableA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int sizeOff = this.allocLocal("__env_size");
        this.asm.movMBaseR(5, 0, sizeOff);

        int notFound = this.asm.createLabel();
        int done = this.asm.createLabel();
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(notFound);

        // buf = HeapAlloc(GetProcessHeap(), 0, size)
        this.asm.emitCallSetup(0);
        this.addImportPatch("kernel32.dll", "GetProcessHeap");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.emitCallSetup(0);
        this.asm.movRR64(1, 0);
        this.asm.xorRR64(2, 2);
        this.asm.movRMBase(8, 5, sizeOff);
        this.addImportPatch("kernel32.dll", "HeapAlloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int bufOff = this.allocLocal("__env_buf");
        this.asm.movMBaseR(5, 0, bufOff);

        // GetEnvironmentVariableA(key, buf, size) writes the value + NUL
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, keyOff);
        this.asm.movRMBase(2, 5, bufOff);
        this.asm.movRMBase(8, 5, sizeOff);
        this.addImportPatch("kernel32.dll", "GetEnvironmentVariableA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.movRMBase(0, 5, bufOff);
        this.asm.jmpLabel(done);
        this.asm.bindLabel(notFound);
        this.emitLlmaiStringLiteral("");
        this.asm.bindLabel(done);
    }

    public void genOsVersionCall() {
        // os.version - returns the Windows version string (e.g. "10.0").
        // Uses RtlGetVersion from ntdll.dll to get the real OS version,
        // then formats it as "major.minor".
        int verOff = this.allocLocal("__os_ver");

        // Zero out RTL_OSVERSIONINFOW on the stack (284 bytes).
        for (int zi = 0; zi < 36; zi++) {
            this.asm.movRI64(0, 0);
            this.asm.movMBaseR(5, 0, verOff + zi * 8);
        }
        // dwOSVersionInfoSize = 284
        this.asm.movRI64(0, 284);
        this.asm.movMBaseR(5, 0, verOff);

        // RtlGetVersion(&ver)
        this.asm.emitCallSetup(0);
        this.asm.leaRBase(1, 5, verOff);
        this.addImportPatch("ntdll.dll", "RtlGetVersion");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        // Check if build >= 22000 → Windows 11 (major == 10 with high build)
        int os110 = this.newLabel();
        int osDone = this.newLabel();
        this.asm.movRMBase(0, 5, verOff + 4);              // dwMajorVersion
        this.asm.cmpRI32(0, 10);
        this.asm.jneLabel(osDone);                          // Not 10 → emit "10.0"
        // Major == 10: check build number for Win 11
        this.asm.movRMBase(0, 5, verOff + 12);             // dwBuildNumber
        this.asm.cmpRI32(0, 22000);
        this.asm.jlLabel(osDone);                          // build < 22000 → Win 10
        // Win 11
        this.emitLlmaiStringLiteral("11.0");
        return;
        this.asm.bindLabel(osDone);
        // Win 10 or unknown → emit "10.0"
        this.emitLlmaiStringLiteral("10.0");
    }

    public void genOsBuildCall() {
        // os.build - returns the Windows build number as a string.
        int verOff = this.allocLocal("__os_bver");

        // Zero out RTL_OSVERSIONINFOW on the stack (284 bytes).
        for (int zi = 0; zi < 36; zi++) {
            this.asm.movRI64(0, 0);
            this.asm.movMBaseR(5, 0, verOff + zi * 8);
        }
        // dwOSVersionInfoSize = 284
        this.asm.movRI64(0, 284);
        this.asm.movMBaseR(5, 0, verOff);

        // RtlGetVersion(&ver)
        this.asm.emitCallSetup(0);
        this.asm.leaRBase(1, 5, verOff);
        this.addImportPatch("ntdll.dll", "RtlGetVersion");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        // Allocate a 12-byte buffer for itoa output
        this.asm.movRI64(1, 12);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD5);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int bufOff = this.allocLocal("__os_bbuf");
        this.asm.movMBaseR(5, 0, bufOff);

        // itoa(buildNumber, buffer, 10)
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, verOff + 12);             // R1 = dwBuildNumber
        this.asm.movRMBase(2, 5, bufOff);                  // R2 = buffer
        this.asm.movRI64(8, 10);                            // R8 = radix 10
        this.addImportPatch("msvcrt.dll", "_itoa");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD6);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        // Return buffer
        this.asm.movRMBase(0, 5, bufOff);
    }

    public void genGetExtCall(Node call) {
        // file.getExt(path) - returns extension after last dot.
        // Uses strrchr; returns a pointer into the original string.
        int pathIdx = 0;
        if (call.isMember) { pathIdx = 1; }
        if (call.childCount() <= pathIdx) { this.emitLlmaiStringLiteral(""); return; }

        this.genExpr(call.child(pathIdx));
        int pOff = this.allocLocal("__ge_p");
        this.asm.movMBaseR(5, 0, pOff);

        // strrchr(path, '.'). Same pattern as genStrlenCall.
        this.asm.movRR64(1, 0);
        this.asm.movRI64(2, 46);
        this.addImportPatch("ucrtbase.dll", "strrchr");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        // R0 = dot or NULL
        int dOff = this.allocLocal("__ge_d");
        this.asm.movMBaseR(5, 0, dOff);

        int geHas = this.newLabel();
        int geEnd = this.newLabel();
        this.asm.cmpRI32(0, 0);
        this.asm.jneLabel(geHas);

        // No dot
        this.emitLlmaiStringLiteral("");
        this.asm.jmpLabel(geEnd);

        // Has dot: return dot + 1
        this.asm.bindLabel(geHas);
        this.asm.movRMBase(0, 5, dOff);
        this.asm.movRI64(1, 1);
        this.asm.addRR64(0, 1);

        this.asm.bindLabel(geEnd);
    }

    public void genReadStringCall(Node call) {
        // The path argument sits at child(1) for member calls (`file.readString(p)`
        // where child(0) is the receiver) but at child(0) for the global
        // `readFile(p)` builtin.  Using the wrong slot silently skipped the
        // read and left garbage in RAX.
        int pathIdx = 0;
        if (call.isMember) { pathIdx = 1; }
        if (call.childCount() <= pathIdx) { return; }
        this.genExpr(call.child(pathIdx));
        int pathOff = this.allocLocal("__rs_path");
        this.asm.movMBaseR(5, 0, pathOff);

        this.asm.emitCallSetup(24);
        this.asm.movRI64(0, 3);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRI64(0, 0x80);
        this.asm.movMBaseR(4, 0, 40);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(4, 0, 48);
        this.asm.movRMBase(1, 5, pathOff);
        this.asm.movRI64(2, 0x80000000);
        this.asm.movRI64(8, 1);
        this.asm.xorRR64(9, 9);
        this.addImportPatch("kernel32.dll", "CreateFileA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int hfileOff = this.allocLocal("__rs_hfile");
        this.asm.movMBaseR(5, 0, hfileOff);

        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hfileOff);
        this.asm.xorRR64(2, 2);
        this.addImportPatch("kernel32.dll", "GetFileSize");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int sizeOff = this.allocLocal("__rs_size");
        this.asm.movMBaseR(5, 0, sizeOff);

        this.asm.emitCallSetup(0);
        this.addImportPatch("kernel32.dll", "GetProcessHeap");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.emitCallSetup(0);
        this.asm.movRR64(1, 0);
        this.asm.xorRR64(2, 2);
        this.asm.movRMBase(8, 5, sizeOff);
        this.asm.addRI32(8, 1);
        this.addImportPatch("kernel32.dll", "HeapAlloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int bufOff = this.allocLocal("__rs_buf");
        this.asm.movMBaseR(5, 0, bufOff);

        int breadOff = this.allocLocal("__rs_bread");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, breadOff);

        this.asm.emitCallSetup(8);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRMBase(1, 5, hfileOff);
        this.asm.movRMBase(2, 5, bufOff);
        this.asm.movRMBase(8, 5, sizeOff);
        this.asm.leaRBase(9, 5, breadOff);
        this.addImportPatch("kernel32.dll", "ReadFile");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        // HeapAlloc reserves size + 1 bytes; terminate the source buffer so
        // string.length and the lexer never read past the bytes returned by
        // ReadFile.  This is essential when the next byte is non-zero in a
        // reused heap block, and keeps every bootstrap stage deterministic.
        this.asm.movRMBase(0, 5, bufOff);
        this.asm.movRMBase(1, 5, breadOff);
        this.asm.addRR64(0, 1);
        this.asm.movRI64(1, 0);
        this.asm.movMBaseByteR(0, 1, 0);

        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hfileOff);
        this.addImportPatch("kernel32.dll", "CloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.movRMBase(0, 5, bufOff);
    }

    // input() builtin: reads a line from stdin via GetStdHandle + ReadFile.
    // Modeled after genReadStringCall but uses the stdin handle instead of
    // CreateFileA, and a fixed-size (4096-byte) heap buffer.
    public void genInputCall(Node call) {
        // GetStdHandle(-10) -> stdin handle
        this.asm.emitCallSetup(0);
        this.asm.movRI64(1, -10);
        this.addImportPatch("kernel32.dll", "GetStdHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int hstdinOff = this.allocLocal("__in_hstdin");
        this.asm.movMBaseR(5, 0, hstdinOff);

        // Allocate a 4096-byte heap buffer
        int bufSize = 4096;
        int sizeOff = this.allocLocal("__in_size");
        this.asm.movRI64(0, bufSize);
        this.asm.movMBaseR(5, 0, sizeOff);

        this.asm.emitCallSetup(0);
        this.addImportPatch("kernel32.dll", "GetProcessHeap");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.emitCallSetup(0);
        this.asm.movRR64(1, 0);
        this.asm.xorRR64(2, 2);
        this.asm.movRMBase(8, 5, sizeOff);
        this.addImportPatch("kernel32.dll", "HeapAlloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int bufOff = this.allocLocal("__in_buf");
        this.asm.movMBaseR(5, 0, bufOff);

        int breadOff = this.allocLocal("__in_bread");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, breadOff);

        // ReadFile(stdin, buf, 4096, &read, 0)
        this.asm.emitCallSetup(8);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRMBase(1, 5, hstdinOff);
        this.asm.movRMBase(2, 5, bufOff);
        this.asm.movRMBase(8, 5, sizeOff);
        this.asm.leaRBase(9, 5, breadOff);
        this.addImportPatch("kernel32.dll", "ReadFile");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        // Null-terminate the buffer at the bytes-read position
        this.asm.movRMBase(0, 5, bufOff);
        this.asm.movRMBase(1, 5, breadOff);
        this.asm.addRR64(0, 1);
        this.asm.movRI64(1, 0);
        this.asm.movMBaseByteR(0, 1, 0);

        // Return buffer pointer in RAX
        this.asm.movRMBase(0, 5, bufOff);
    }

    public void emitLlmaiStringLiteral(string s) {
        int strIdx = this.addString(s);
        int sp = this.asm.buf.length;
        this.asm.emitImm64(0, 0);
        int strPatchPos = sp + 2;
        this.stringPatchOffsets.add(strPatchPos);
        this.stringPatchIndices.add(strIdx);
    }

    public void emitLlmaiHeapAlloc(int sizeOff) {
        // RAX = HeapAlloc(GetProcessHeap(), 0, [sizeOff])
        this.asm.emitCallSetup(0);
        this.addImportPatch("kernel32.dll", "GetProcessHeap");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.emitCallSetup(0);
        this.asm.movRR64(1, 0);
        this.asm.xorRR64(2, 2);
        this.asm.movRMBase(8, 5, sizeOff);
        this.addImportPatch("kernel32.dll", "HeapAlloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }

    public void emitLlmaiEmptyString() {
        int emptySize = this.allocLocal("__llmai_empty_size");
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, emptySize);
        this.emitLlmaiHeapAlloc(emptySize);
        this.asm.movRI64(1, 0);
        this.asm.movMBaseByteR(0, 1, 0);
    }

    public void emitLlmaiMemcpy(int dstOff, int srcOff, int lenOff, int idxOff) {
        // for idx in 0..len: dst[idx] = src[idx]
        int cpLoop = this.newLabel();
        int cpEnd = this.newLabel();
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, idxOff);
        this.asm.bindLabel(cpLoop);
        this.asm.movRMBase(0, 5, idxOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(cpEnd);
        // byte = src[idx]
        this.asm.movRMBase(0, 5, srcOff);
        this.asm.movRMBase(1, 5, idxOff);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(2, 0, 0);
        // dst[idx] = byte  (movByteMBaseIdxR encodes [base + index])
        this.asm.movRMBase(0, 5, dstOff);
        this.asm.movRMBase(1, 5, idxOff);
        this.asm.movByteMBaseIdxR(0, 1, 2);
        this.asm.movRMBase(0, 5, idxOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, idxOff);
        this.asm.jmpLabel(cpLoop);
        this.asm.bindLabel(cpEnd);
    }

    // llmai.chat(url, headers, body) -> raw HTTP response body string.
    // Emits a WinInet POST (ANSI versions, no UTF-16 conversion needed) with
    // the URL parsed at runtime: host/port/path are extracted from `url`.
    public void genLlmaiChatCall(Node call) {
        if (call.childCount() < 4) {
            this.emitLlmaiEmptyString();
            return;
        }
        this.genExpr(call.child(1));
        int urlOff = this.allocLocal("__llmai_url");
        this.asm.movMBaseR(5, 0, urlOff);
        this.genExpr(call.child(2));
        int hdrOff = this.allocLocal("__llmai_hdr");
        this.asm.movMBaseR(5, 0, hdrOff);
        this.genExpr(call.child(3));
        int bodyOff = this.allocLocal("__llmai_body");
        this.asm.movMBaseR(5, 0, bodyOff);

        int schemeOff = this.allocLocal("__llmai_scheme");
        int hstartOff = this.allocLocal("__llmai_hstart");
        int hlenOff = this.allocLocal("__llmai_hlen");
        int portOff = this.allocLocal("__llmai_port");
        int pathOff = this.allocLocal("__llmai_path");
        int jOff = this.allocLocal("__llmai_j");
        int kOff = this.allocLocal("__llmai_k");
        int hbufOff = this.allocLocal("__llmai_hbuf");
        int hinOff = this.allocLocal("__llmai_hin");
        int hcoOff = this.allocLocal("__llmai_hco");
        int hreOff = this.allocLocal("__llmai_hre");
        int resOff = this.allocLocal("__llmai_res");
        int resCapOff = this.allocLocal("__llmai_rescap");
        int resLenOff = this.allocLocal("__llmai_reslen");
        int chunkOff = this.allocLocal("__llmai_chunk");
        int breadOff = this.allocLocal("__llmai_bread");
        int tmpOff = this.allocLocal("__llmai_tmp");
        int idxOff = this.allocLocal("__llmai_idx");

        // ---- URL parse: p = strstr(url, "://") ----
        this.emitLlmaiStringLiteral("://");
        this.asm.movMBaseR(5, 0, schemeOff);
        this.asm.movRMBase(1, 5, urlOff);
        this.asm.movRMBase(2, 5, schemeOff);
        this.addImportPatch("msvcrt.dll", "strstr");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int noScheme = this.newLabel();
        int afterScheme = this.newLabel();
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(noScheme);
        this.asm.addRI32(0, 3);
        this.asm.movMBaseR(5, 0, hstartOff);
        this.asm.jmpLabel(afterScheme);
        this.asm.bindLabel(noScheme);
        this.asm.movRMBase(0, 5, urlOff);
        this.asm.movMBaseR(5, 0, hstartOff);
        this.asm.bindLabel(afterScheme);

        // ---- scan host: j=0; while host[j] not in {0, ':', '/'}: j++ ----
        int hostLoop = this.newLabel();
        int hostDone = this.newLabel();
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, jOff);
        this.asm.bindLabel(hostLoop);
        this.asm.movRMBase(0, 5, hstartOff);
        this.asm.movRMBase(1, 5, jOff);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(0, 0, 0);
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(hostDone);
        this.asm.cmpRI32(0, 58);
        this.asm.jeLabel(hostDone);
        this.asm.cmpRI32(0, 47);
        this.asm.jeLabel(hostDone);
        this.asm.movRMBase(0, 5, jOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, jOff);
        this.asm.jmpLabel(hostLoop);
        this.asm.bindLabel(hostDone);
        this.asm.movRMBase(0, 5, jOff);
        this.asm.movMBaseR(5, 0, hlenOff);

        // ---- default port: https -> 443, else 80 ----
        int notHttps = this.newLabel();
        int httpsDone = this.newLabel();
        this.asm.movRMBase(0, 5, urlOff);
        this.asm.movzxByteMBase(1, 0, 0);
        this.asm.cmpRI32(1, 104);
        this.asm.jneLabel(notHttps);
        this.asm.movRMBase(0, 5, urlOff);
        this.asm.movzxByteMBase(1, 0, 1);
        this.asm.cmpRI32(1, 116);
        this.asm.jneLabel(notHttps);
        this.asm.movRMBase(0, 5, urlOff);
        this.asm.movzxByteMBase(1, 0, 2);
        this.asm.cmpRI32(1, 116);
        this.asm.jneLabel(notHttps);
        this.asm.movRMBase(0, 5, urlOff);
        this.asm.movzxByteMBase(1, 0, 3);
        this.asm.cmpRI32(1, 112);
        this.asm.jneLabel(notHttps);
        this.asm.movRMBase(0, 5, urlOff);
        this.asm.movzxByteMBase(1, 0, 4);
        this.asm.cmpRI32(1, 115);
        this.asm.jneLabel(notHttps);
        this.asm.movRI64(0, 443);
        this.asm.movMBaseR(5, 0, portOff);
        this.asm.jmpLabel(httpsDone);
        this.asm.bindLabel(notHttps);
        this.asm.movRI64(0, 80);
        this.asm.movMBaseR(5, 0, portOff);
        this.asm.bindLabel(httpsDone);

        // ---- path handling ----
        this.emitLlmaiStringLiteral("/");
        this.asm.movMBaseR(5, 0, pathOff);
        int pathColon = this.newLabel();
        int pathSlash = this.newLabel();
        int pathNone = this.newLabel();
        int pathDone = this.newLabel();
        this.asm.movRMBase(0, 5, hstartOff);
        this.asm.movRMBase(1, 5, jOff);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(0, 0, 0);
        this.asm.cmpRI32(0, 58);
        this.asm.jeLabel(pathColon);
        this.asm.cmpRI32(0, 47);
        this.asm.jeLabel(pathSlash);
        this.asm.jmpLabel(pathNone);

        // ':' -> parse port digits, then find '/' at or after them
        this.asm.bindLabel(pathColon);
        this.asm.movRMBase(0, 5, jOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, kOff);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, portOff);
        int portLoop = this.newLabel();
        int portDone = this.newLabel();
        this.asm.bindLabel(portLoop);
        this.asm.movRMBase(0, 5, hstartOff);
        this.asm.movRMBase(1, 5, kOff);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(2, 0, 0);
        this.asm.cmpRI32(2, 48);
        this.asm.jlLabel(portDone);
        this.asm.cmpRI32(2, 57);
        this.asm.jgLabel(portDone);
        this.asm.movRMBase(0, 5, portOff);
        this.asm.movRI64(1, 10);
        this.asm.imulRR64(0, 1);
        this.asm.subRI32(2, 48);
        this.asm.addRR64(0, 2);
        this.asm.movMBaseR(5, 0, portOff);
        this.asm.movRMBase(0, 5, kOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, kOff);
        this.asm.jmpLabel(portLoop);
        this.asm.bindLabel(portDone);
        int pathFind = this.newLabel();
        int pathFindDone = this.newLabel();
        int pathFromK = this.newLabel();
        this.asm.bindLabel(pathFind);
        this.asm.movRMBase(0, 5, hstartOff);
        this.asm.movRMBase(1, 5, kOff);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(0, 0, 0);
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(pathFindDone);
        this.asm.cmpRI32(0, 47);
        this.asm.jeLabel(pathFromK);
        this.asm.movRMBase(0, 5, kOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, kOff);
        this.asm.jmpLabel(pathFind);
        this.asm.bindLabel(pathFindDone);
        this.asm.jmpLabel(pathDone);
        // '/' found after the port digits -> path = host + k
        this.asm.bindLabel(pathFromK);
        this.asm.movRMBase(0, 5, hstartOff);
        this.asm.movRMBase(1, 5, kOff);
        this.asm.addRR64(0, 1);
        this.asm.movMBaseR(5, 0, pathOff);
        this.asm.jmpLabel(pathDone);

        // '/' at host[j] -> path = host + j
        this.asm.bindLabel(pathSlash);
        this.asm.movRMBase(0, 5, hstartOff);
        this.asm.movRMBase(1, 5, jOff);
        this.asm.addRR64(0, 1);
        this.asm.movMBaseR(5, 0, pathOff);
        this.asm.jmpLabel(pathDone);

        // no path -> keep "/"
        this.asm.bindLabel(pathNone);
        this.asm.bindLabel(pathDone);

        // ---- copy host to a heap buffer: hbuf = HeapAlloc(hostLen + 1) ----
        this.asm.movRMBase(0, 5, hlenOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, tmpOff);
        this.emitLlmaiHeapAlloc(tmpOff);
        this.asm.movMBaseR(5, 0, hbufOff);
        this.emitLlmaiMemcpy(hbufOff, hstartOff, hlenOff, idxOff);
        this.asm.movRMBase(0, 5, hbufOff);
        this.asm.movRMBase(1, 5, hlenOff);
        this.asm.addRR64(0, 1);
        this.asm.movRI64(1, 0);
        this.asm.movMBaseByteR(0, 1, 0);

        // ---- InternetOpenA(NULL, 0, NULL, NULL, 0) ----
        this.asm.emitCallSetup(8);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.xorRR64(1, 1);
        this.asm.xorRR64(2, 2);
        this.asm.xorRR64(8, 8);
        this.asm.xorRR64(9, 9);
        this.addImportPatch("wininet.dll", "InternetOpenA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, hinOff);

        int failInet = this.newLabel();
        int failConn = this.newLabel();
        int failReq = this.newLabel();
        int failSend = this.newLabel();
        int readLoop = this.newLabel();
        int readDone = this.newLabel();
        int doneLbl = this.newLabel();

        this.asm.movRMBase(0, 5, hinOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(failInet);

        // ---- InternetConnectA(hin, host, port, NULL, NULL, HTTP(3), 0, 0) ----
        this.asm.emitCallSetup(32);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRI64(0, 3);
        this.asm.movMBaseR(4, 0, 40);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(4, 0, 48);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(4, 0, 56);
        this.asm.movRMBase(1, 5, hinOff);
        this.asm.movRMBase(2, 5, hbufOff);
        this.asm.movRMBase(8, 5, portOff);
        this.asm.xorRR64(9, 9);
        this.addImportPatch("wininet.dll", "InternetConnectA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, hcoOff);

        this.asm.movRMBase(0, 5, hcoOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(failConn);

        // ---- HttpOpenRequestA(hco, "POST", path, NULL, NULL, NULL, FLAGS, 0) ----
        this.emitLlmaiStringLiteral("POST");
        this.asm.movMBaseR(5, 0, tmpOff);
        this.asm.emitCallSetup(32);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(4, 0, 40);
        this.asm.movRI64(0, 0x84800200);
        this.asm.movMBaseR(4, 0, 48);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(4, 0, 56);
        this.asm.movRMBase(1, 5, hcoOff);
        this.asm.movRMBase(2, 5, tmpOff);
        this.asm.movRMBase(8, 5, pathOff);
        this.asm.xorRR64(9, 9);
        this.addImportPatch("wininet.dll", "HttpOpenRequestA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, hreOff);

        this.asm.movRMBase(0, 5, hreOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(failReq);

        // ---- strlen(body) ----
        this.asm.movRMBase(1, 5, bodyOff);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, tmpOff);

        // ---- HttpSendRequestA(hre, headers, -1, body, strlen(body)) ----
        this.asm.emitCallSetup(8);
        this.asm.movRMBase(0, 5, tmpOff);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRMBase(1, 5, hreOff);
        this.asm.movRMBase(2, 5, hdrOff);
        this.asm.movRI64(8, 0xFFFFFFFF);
        this.asm.movRMBase(9, 5, bodyOff);
        this.addImportPatch("wininet.dll", "HttpSendRequestA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(failSend);

        // ---- allocate result (8192) and chunk (4096) ----
        this.asm.movRI64(0, 8192);
        this.asm.movMBaseR(5, 0, resCapOff);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, resLenOff);
        this.asm.movRI64(0, 8192);
        this.asm.movMBaseR(5, 0, tmpOff);
        this.emitLlmaiHeapAlloc(tmpOff);
        this.asm.movMBaseR(5, 0, resOff);
        this.asm.movRI64(0, 4096);
        this.asm.movMBaseR(5, 0, tmpOff);
        this.emitLlmaiHeapAlloc(tmpOff);
        this.asm.movMBaseR(5, 0, chunkOff);

        // ---- read loop ----
        this.asm.bindLabel(readLoop);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, breadOff);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hreOff);
        this.asm.movRMBase(2, 5, chunkOff);
        this.asm.movRI64(8, 4096);
        this.asm.leaRBase(9, 5, breadOff);
        this.addImportPatch("wininet.dll", "InternetReadFile");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(readDone);
        this.asm.movRMBase(0, 5, breadOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(readDone);

        // need to grow? resLen + bread >= resCap
        int noGrow = this.newLabel();
        int growCapLoop = this.newLabel();
        int growCapDone = this.newLabel();
        this.asm.movRMBase(0, 5, resLenOff);
        this.asm.movRMBase(1, 5, breadOff);
        this.asm.addRR64(0, 1);
        this.asm.movRMBase(1, 5, resCapOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jlLabel(noGrow);
        // newCap = resCap; while (newCap < resLen + bread + 1) newCap *= 2
        this.asm.movRMBase(0, 5, resCapOff);
        this.asm.movMBaseR(5, 0, tmpOff);
        this.asm.bindLabel(growCapLoop);
        this.asm.movRMBase(0, 5, resLenOff);
        this.asm.movRMBase(1, 5, breadOff);
        this.asm.addRR64(0, 1);
        this.asm.addRI32(0, 1);
        this.asm.movRMBase(1, 5, tmpOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jleLabel(growCapDone);
        this.asm.movRMBase(0, 5, tmpOff);
        this.asm.addRR64(0, 0);
        this.asm.movMBaseR(5, 0, tmpOff);
        this.asm.jmpLabel(growCapLoop);
        this.asm.bindLabel(growCapDone);
        // newRes = HeapAlloc(newCap); copy res[0..resLen]
        int newResOff = this.allocLocal("__llmai_newres");
        this.emitLlmaiHeapAlloc(tmpOff);
        this.asm.movMBaseR(5, 0, newResOff);
        this.emitLlmaiMemcpy(newResOff, resOff, resLenOff, idxOff);
        this.asm.movRMBase(0, 5, newResOff);
        this.asm.movMBaseR(5, 0, resOff);
        this.asm.movRMBase(0, 5, tmpOff);
        this.asm.movMBaseR(5, 0, resCapOff);
        this.asm.bindLabel(noGrow);

        // copy chunk[0..bread] into res + resLen
        this.asm.movRMBase(0, 5, resOff);
        this.asm.movRMBase(1, 5, resLenOff);
        this.asm.addRR64(0, 1);
        int dstBaseOff = this.allocLocal("__llmai_dstbase");
        this.asm.movMBaseR(5, 0, dstBaseOff);
        this.emitLlmaiMemcpy(dstBaseOff, chunkOff, breadOff, idxOff);
        this.asm.movRMBase(0, 5, resLenOff);
        this.asm.movRMBase(1, 5, breadOff);
        this.asm.addRR64(0, 1);
        this.asm.movMBaseR(5, 0, resLenOff);
        this.asm.jmpLabel(readLoop);

        // ---- finish: terminate, close, return res ----
        this.asm.bindLabel(readDone);
        this.asm.movRMBase(0, 5, resOff);
        this.asm.movRMBase(1, 5, resLenOff);
        this.asm.addRR64(0, 1);
        this.asm.movRI64(1, 0);
        this.asm.movMBaseByteR(0, 1, 0);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hreOff);
        this.addImportPatch("wininet.dll", "InternetCloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hcoOff);
        this.addImportPatch("wininet.dll", "InternetCloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hinOff);
        this.addImportPatch("wininet.dll", "InternetCloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRMBase(0, 5, resOff);
        this.asm.jmpLabel(doneLbl);

        // ---- failure paths: close what was opened, return empty string ----
        this.asm.bindLabel(failSend);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hreOff);
        this.addImportPatch("wininet.dll", "InternetCloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.bindLabel(failReq);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hcoOff);
        this.addImportPatch("wininet.dll", "InternetCloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.bindLabel(failConn);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hinOff);
        this.addImportPatch("wininet.dll", "InternetCloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.bindLabel(failInet);
        this.emitLlmaiEmptyString();

        this.asm.bindLabel(doneLbl);
    }

    public void genWriteBytesCall(Node call) {
        // The path/data arguments sit at child(1)/child(2) for member calls
        // (file.writeString(p, d) where child(0) is the receiver) but at
        // child(0)/child(1) for the global writeString(p, d) builtin.  Using
        // the wrong slots silently skipped the write and left the file
        // uncreated (the old guard also rejected the 2-child global form).
        int pathIdx = 0;
        int dataIdx = 1;
        if (call.isMember) { pathIdx = 1; dataIdx = 2; }
        if (call.childCount() <= dataIdx) { return; }
        this.genExpr(call.child(pathIdx));
        int pathOff = this.allocLocal("__wb_path");
        this.asm.movMBaseR(5, 0, pathOff);

        this.genExpr(call.child(dataIdx));
        int dataOff = this.allocLocal("__wb_data");
        this.asm.movMBaseR(5, 0, dataOff);

        string dataType = this.inferExprType(call.child(dataIdx));
        int isString = 0;
        if (this.strEq(dataType, "string")) { isString = 1; }

        int sizeOff = this.allocLocal("__wb_size");
        int bufOff = dataOff;
        if (isString == 1) {
            this.asm.emitCallSetup(0);
            this.asm.movRMBase(1, 5, dataOff);
            this.addImportPatch("kernel32.dll", "lstrlenA");
            this.asm.emitImm64(0, 0);
            this.asm.movRMBase(0, 0, 0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, sizeOff);
        } else {
            // int[] points at element zero; its length is stored at -8.
            // Compact the low byte of each eight-byte element in place. The
            // array allocation has enough capacity for this prefix, so this
            // avoids a second heap allocation and keeps the bootstrap ABI
            // identical across compiler generations.
            this.asm.movRMBase(10, 5, dataOff);
            this.asm.movRMBase(0, 10, -8);
            this.asm.movMBaseR(5, 0, sizeOff);

            int iOff = this.allocLocal("__wb_i");
            this.asm.movRI64(0, 0);
            this.asm.movMBaseR(5, 0, iOff);
            // Walk source elements by eight bytes and compact output bytes
            // with ordinary [base] stores. This deliberately avoids the
            // indexed-SIB encoder so stage2 and later stages use the same
            // conservative instruction subset as stage1.
            this.asm.movRMBase(10, 5, dataOff);
            this.asm.movRR64(11, 10);
            int loopLbl = this.newLabel();
            int doneLbl = this.newLabel();
            this.asm.bindLabel(loopLbl);
            this.asm.movRMBase(0, 5, iOff);
            this.asm.movRMBase(8, 5, sizeOff);
            this.asm.cmpRR64(0, 8);
            this.asm.jgeLabel(doneLbl);
            this.asm.movRMBase(8, 10, 0);
            this.asm.andRImm(8, 0xFF);
            this.asm.movMBaseByteR(11, 8, 0);
            this.asm.addRI32(10, 8);
            this.asm.addRI32(11, 1);
            this.asm.movRMBase(0, 5, iOff);
            this.asm.addRI32(0, 1);
            this.asm.movMBaseR(5, 0, iOff);
            this.asm.jmpLabel(loopLbl);
            this.asm.bindLabel(doneLbl);
        }

        this.asm.emitCallSetup(24);
        this.asm.movRI64(0, 2);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRI64(0, 0x80);
        this.asm.movMBaseR(4, 0, 40);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(4, 0, 48);
        this.asm.movRMBase(1, 5, pathOff);
        this.asm.movRI64(2, 0x40000000);
        this.asm.xorRR64(8, 8);
        this.asm.xorRR64(9, 9);
        this.addImportPatch("kernel32.dll", "CreateFileA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int hfileOff = this.allocLocal("__wb_hfile");
        this.asm.movMBaseR(5, 0, hfileOff);
        int writtenOff = this.allocLocal("__wb_written");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, writtenOff);

        this.asm.emitCallSetup(8);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRMBase(1, 5, hfileOff);
        this.asm.movRMBase(0, 5, bufOff);
        this.asm.movRR64(2, 0);
        this.asm.movRMBase(8, 5, sizeOff);
        this.asm.leaRBase(9, 5, writtenOff);
        this.addImportPatch("kernel32.dll", "WriteFile");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hfileOff);
        this.addImportPatch("kernel32.dll", "CloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }
}

class PeImport {
    public prop string dll;
    public prop string name;

    construct (string dll, string name) {
        this.dll = dll;
        this.name = name;
    }
}

class PeDllGroup {
    public prop string dll;
    public prop int count;

    construct (string dll) {
        this.dll = dll;
        this.count = 0;
    }
}

class MiniPe {
    public int[] code;
    public int entryRva;
    public int globalAreaSize;
    public PeImport[] imports;
    public int[] relocOffsets;
    public int[] extraData;

    construct () {
        this.code = [];
        this.entryRva = 0;
        this.globalAreaSize = 0;
        this.imports = [];
        this.relocOffsets = [];
        this.extraData = [];
        this.viKeys = [];
        this.viValues = [];
    }

    public void addSectionData(int[] data) {
        this.extraData = data;
    }

    public string[] viKeys;
    public string[] viValues;

    public void setVersionInfo(string[] keys, string[] values) {
        this.viKeys = keys;
        this.viValues = values;
    }

    public void writeFile(string path) {
        int[] peBytes = this.build(this.code, this.extraData);
        file.writeBytes(path, peBytes);
    }

    public void addImport(string dll, string name) {
        this.imports.add(new PeImport(dll, name));
    }

    private bool strEq(string a, string b) {
        if (a.length != b.length) { return false; }
        for (int i = 0; i < a.length; i++) {
            if (a[i] != b[i]) { return false; }
        }
        return true;
    }

    public int computeRdataRva() {
        int FILE_ALIGN = 0x200;
        int SECT_ALIGN = 0x1000;
        int textRva = SECT_ALIGN;
        int textVirt = this.padToAlign(this.code.length, SECT_ALIGN);
        return textRva + textVirt;
    }

    public int[] computeLayout(int stringDataLen) {
        PeDllGroup[] groups = [];
        int[] groupMap = [];
        for (int i = 0; i < this.imports.length; i++) {
            string impDll = this.imports[i].dll;
            int gIdx = -1;
            for (int j = 0; j < groups.length; j++) {
                string gDll = groups[j].dll;
                if (this.strEq(gDll, impDll)) {
                    gIdx = j;
                    break;
                }
            }
            if (gIdx < 0) {
                groups.add(new PeDllGroup(impDll));
                gIdx = groups.length - 1;
            }
            PeDllGroup grp = groups[gIdx];
            grp.count = grp.count + 1;
            groupMap.add(gIdx);
        }
        int numGroups = groups.length;
        int descBytes = (numGroups + 1) * 20;
        int iltTotal = 0;
        for (int g = 0; g < numGroups; g++) {
            int cnt = groups[g].count;
            iltTotal += (cnt + 1) * 8;
        }
        int iatTotal = iltTotal;
        int namesStart = descBytes + iltTotal + iatTotal;
        int hintNamesLen = 0;
        for (int i = 0; i < this.imports.length; i++) {
            string nm = this.imports[i].name;
            hintNamesLen += 2 + nm.length + 1;
        }
        for (int g = 0; g < numGroups; g++) {
            string gDll2 = groups[g].dll;
            hintNamesLen += gDll2.length + 1;
        }
        int stringsStart = namesStart + hintNamesLen;
        int[] layout = [];
        layout.add(stringsStart);
        layout.add(numGroups);
        layout.add(iltTotal);
        return layout;
    }

    public int padToAlign(int offset, int align) {
        int m = offset % align;
        if (m != 0) {
            return offset + (align - m);
        }
        return offset;
    }

    public void writeLe32(int[] buf, int offset, int val) {
        buf[offset] = val & 0xFF;
        buf[offset + 1] = (val >> 8) & 0xFF;
        buf[offset + 2] = (val >> 16) & 0xFF;
        buf[offset + 3] = (val >> 24) & 0xFF;
    }

    public void writeLe64(int[] buf, int offset, int64 val) {
        buf[offset] = val & 0xFF;
        buf[offset + 1] = (val >> 8) & 0xFF;
        buf[offset + 2] = (val >> 16) & 0xFF;
        buf[offset + 3] = (val >> 24) & 0xFF;
        buf[offset + 4] = (val >> 32) & 0xFF;
        buf[offset + 5] = (val >> 40) & 0xFF;
        buf[offset + 6] = (val >> 48) & 0xFF;
        buf[offset + 7] = (val >> 56) & 0xFF;
    }

    private void rsrcWriteUtf16Pad(int[] buf, string s) {
        for (int i = 0; i < s.length; i++) {
            int ch = s[i];
            buf.add(ch & 0xFF);
            buf.add((ch >> 8) & 0xFF);
        }
        buf.add(0);
        buf.add(0);
    }

    private string rsrcFixVer(string v) {
        int dots = 0;
        for (int i = 0; i < v.length; i++) {
            if (v[i] == '.') { dots = dots + 1; }
        }
        for (int i = 0; dots < 3; dots++) {
            v = v + ".0";
        }
        return v;
    }

    private int[] buildVERSIONINFO() {
        int kc = this.viKeys.length;

        int strBlockSize = 6 + 4 * kc;
        int strTableNameBytes = 18;
        int strSize = 24 + 6 + strBlockSize + strTableNameBytes;
        for (int i = 0; i < kc; i++) {
            strSize = strSize + (this.viKeys[i].length + 1) * 2;
            strSize = strSize + (this.viValues[i].length + 1) * 2;
        }
        int pad = strSize % 4;
        if (pad != 0) { strSize = strSize + (4 - pad); }

        int viLen = 52 + 6 + 6 + 52 + strSize;

        int[] s = [];
        for (int i = 0; i < viLen; i++) { s.add(0); }

        s[0] = 'V'; s[1] = 'S'; s[2] = '_'; s[3] = 'V'; s[4] = 'E'; s[5] = 'R'; s[6] = 'S'; s[7] = 'I';
        s[8] = 'O'; s[9] = 'N'; s[10] = '_'; s[11] = 'I'; s[12] = 'N'; s[13] = 'F'; s[14] = 'O';

        this.writeLe32(s, 8, 52);
        this.writeLe32(s, 12, viLen);

        this.writeLe32(s, 52, 0xFEEF04BD);
        this.writeLe32(s, 54, 34 + 6 + strSize);

        s.add('S'); s.add(0); s.add('t'); s.add(0); s.add('r'); s.add(0); s.add('i'); s.add(0);
        s.add('n'); s.add(0); s.add('g'); s.add(0); s.add('F'); s.add(0); s.add('i'); s.add(0);
        s.add('l'); s.add(0); s.add('e'); s.add(0); s.add('I'); s.add(0); s.add('n'); s.add(0);
        s.add('f'); s.add(0); s.add('o'); s.add(0); s.add(0); s.add(0);

        this.writeLe32(s, 86 + 4, 28 + strBlockSize + strTableNameBytes);

        s.add('V'); s.add(0); s.add('a'); s.add(0); s.add('r'); s.add(0);
        s.add('F'); s.add(0); s.add('i'); s.add(0); s.add('l'); s.add(0);
        s.add('e'); s.add(0); s.add('I'); s.add(0); s.add('n'); s.add(0);
        s.add('f'); s.add(0); s.add('o'); s.add(0); s.add(0); s.add(0);
        this.writeLe32(s, 120, 4);

        s.add(0x09); s.add(0x04); s.add(0xB0); s.add(0x04);

        int strBlockOff = s.length;
        s.add(0); s.add(0); s.add(0); s.add(0); s.add(0); s.add(0);
        this.writeLe32(s, strBlockOff, strBlockSize + strTableNameBytes);

        for (int i = 0; i < kc; i++) {
            int keyLen = (this.viKeys[i].length + 1) * 2;
            int valLen = (this.viValues[i].length + 1) * 2;
            int pos = s.length;
            this.writeLe32(s, pos, keyLen);
            this.writeLe32(s, pos + 2, strBlockSize + strTableNameBytes + pos - strBlockOff);
        }
        for (int i = 0; i < kc; i++) {
            int valLen = (this.viValues[i].length + 1) * 2;
            int pos = s.length;
            this.writeLe32(s, pos, valLen);
            this.writeLe32(s, pos + 2, strBlockSize + strTableNameBytes + pos - strBlockOff);
        }

        s.add('0'); s.add(0); s.add('4'); s.add(0); s.add('0'); s.add(0); s.add('9'); s.add(0);
        s.add('0'); s.add(0); s.add('4'); s.add(0); s.add('B'); s.add(0); s.add('0'); s.add(0);
        s.add(0); s.add(0);

        for (int i = 0; i < kc; i++) {
            this.rsrcWriteUtf16Pad(s, this.viKeys[i]);
        }
        for (int i = 0; i < kc; i++) {
            string vv = this.viValues[i];
            if (this.strEq(this.viKeys[i], "FileVersion") || this.strEq(this.viKeys[i], "ProductVersion")) {
                vv = this.rsrcFixVer(vv);
            }
            this.rsrcWriteUtf16Pad(s, vv);
        }

        int tailPad = s.length % 4;
        if (tailPad != 0) {
            for (int i = 0; i < 4 - tailPad; i++) { s.add(0); }
        }

        this.writeLe32(s, 2, s.length);

        return s;
    }

public int[] build(int[] codeIn, int[] stringData) {
        this.code = codeIn;

        int numImports = this.imports.length;
        string[] uniqueDlls = [];
        int[] groupSizes = [];
        int[] importGroupIdx = [];
        for (int i = 0; i < numImports; i++) {
            string impDll = this.imports[i].dll;
            int gIdx = -1;
            for (int j = 0; j < uniqueDlls.length; j++) {
                if (this.strEq(uniqueDlls[j], impDll)) {
                    gIdx = j;
                    break;
                }
            }
            if (gIdx < 0) {
                uniqueDlls.add(impDll);
                groupSizes.add(0);
                gIdx = uniqueDlls.length - 1;
            }
            groupSizes[gIdx] = groupSizes[gIdx] + 1;
            importGroupIdx.add(gIdx);
        }
        int numGroups = uniqueDlls.length;
        int[] posInGroup = [];
        int[] runningCount = [];
        for (int g = 0; g < numGroups; g++) {
            runningCount.add(0);
        }
        for (int i = 0; i < numImports; i++) {
            posInGroup.add(0);
        }
        for (int i = 0; i < numImports; i++) {
            int g = importGroupIdx[i];
            posInGroup[i] = runningCount[g];
            runningCount[g] = runningCount[g] + 1;
        }

        int descBytes = (numGroups + 1) * 20;
        int iltTotal = 0;
        int[] iltSizes = [];
        for (int g = 0; g < numGroups; g++) {
            int sz = (groupSizes[g] + 1) * 8;
            iltSizes.add(sz);
            iltTotal += sz;
        }
        int iatTotal = iltTotal;

        int[] hintNameOffsets = [];
        int off = 0;
        for (int i = 0; i < numImports; i++) {
            string nm = this.imports[i].name;
            hintNameOffsets.add(off);
            off += 2 + nm.length + 1;
        }
        int[] dllNameOffsets = [];
        for (int g = 0; g < numGroups; g++) {
            string dll = uniqueDlls[g];
            dllNameOffsets.add(off);
            off += dll.length + 1;
        }

        int[] hintNames = [];
        for (int i = 0; i < numImports; i++) {
            hintNames.add(0);
            hintNames.add(0);
            string nm = this.imports[i].name;
            for (int c = 0; c < nm.length; c++) {
                hintNames.add(nm[c]);
            }
            hintNames.add(0);
        }
        for (int g = 0; g < numGroups; g++) {
            string dll = uniqueDlls[g];
            for (int c = 0; c < dll.length; c++) {
                hintNames.add(dll[c]);
            }
            hintNames.add(0);
        }

        int namesStart = descBytes + iltTotal + iatTotal;
        int stringsStart = namesStart + hintNames.length;
        int importDataSize = stringsStart + stringData.length + this.globalAreaSize;

        int[] rsrcData = [];
        if (this.viKeys.length > 0) {
            int[] viBlob = this.buildVERSIONINFO();
            int viPad = viBlob.length % 4;
            if (viPad != 0) {
                for (int i = 0; i < 4 - viPad; i++) { viBlob.add(0); }
            }
            int resHdrLen = 16 + 8 + 16 + 8 + 16 + 8 + 16;
            for (int i = 0; i < resHdrLen; i++) { rsrcData.add(0); }
            int viOff = resHdrLen;
            rsrcData[12] = 0; rsrcData[13] = 0; rsrcData[14] = 1; rsrcData[15] = 0;
            this.writeLe32(rsrcData, 16, 16);
            this.writeLe32(rsrcData, 20, 0x80000000 | 24);
            rsrcData[36] = 0; rsrcData[37] = 0; rsrcData[38] = 1; rsrcData[39] = 0;
            this.writeLe32(rsrcData, 40, 1);
            this.writeLe32(rsrcData, 44, 0x80000000 | 48);
            rsrcData[60] = 0; rsrcData[61] = 0; rsrcData[62] = 1; rsrcData[63] = 0;
            this.writeLe32(rsrcData, 64, 0x409);
            this.writeLe32(rsrcData, 68, 72);
            this.writeLe32(rsrcData, 72, viOff);
            this.writeLe32(rsrcData, 76, viBlob.length);
            for (int i = 0; i < viBlob.length; i++) { rsrcData.add(viBlob[i]); }
        }

        int FILE_ALIGN = 0x200;
        int SECT_ALIGN = 0x1000;
        int numSections = 2;
        if (rsrcData.length > 0) { numSections = 3; }
        int headersRawSize = 64 + 4 + 20 + 240 + numSections * 40;
        int headersSize = this.padToAlign(headersRawSize, FILE_ALIGN);

        int textRva = SECT_ALIGN;
        int textVirt = this.padToAlign(this.code.length, SECT_ALIGN);
        int textRaw = this.padToAlign(this.code.length, FILE_ALIGN);
        int textFileOff = headersSize;

        int rdataRva = textRva + textVirt;
        int importVirt = this.padToAlign(importDataSize, SECT_ALIGN);
        int importRaw = this.padToAlign(importDataSize, FILE_ALIGN);
        int rdataFileOff = textFileOff + textRaw;

        int rsrcRva = rdataRva + importVirt;
        int rsrcVirt = 0;
        int rsrcRaw = 0;
        int rsrcFileOff = 0;
        if (rsrcData.length > 0) {
            rsrcVirt = this.padToAlign(rsrcData.length, SECT_ALIGN);
            rsrcRaw = this.padToAlign(rsrcData.length, FILE_ALIGN);
            rsrcFileOff = rdataFileOff + importRaw;
        }

        int iatSectionStart = descBytes + iltTotal;
        int[] groupIatStart = [];
        int runOff = 0;
        for (int g = 0; g < numGroups; g++) {
            groupIatStart.add(descBytes + iltTotal + runOff);
            runOff += iltSizes[g];
        }
        int firstIatRva = rdataRva + groupIatStart[0];
        int iatSize = iatTotal;

        int imageSize = this.padToAlign(rdataRva + importVirt + rsrcVirt, SECT_ALIGN);
        int totalSize = rdataFileOff + importRaw;
        if (rsrcData.length > 0) { totalSize = rsrcFileOff + rsrcRaw; }
        int[] pe = [];
        for (int i = 0; i < totalSize; i++) {
            pe.add(0);
        }

        pe[0] = 0x4D; pe[1] = 0x5A;
        this.writeLe32(pe, 0x3C, 64);

        int p = 64;
        pe[p] = 0x50; pe[p+1] = 0x45; pe[p+2] = 0; pe[p+3] = 0;
        p += 4;
        pe[p] = 0x64; pe[p+1] = 0x86; p += 2;
        pe[p] = numSections; pe[p+1] = 0; p += 2;
        this.writeLe32(pe, p, 0x42); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        pe[p] = 0xF0; pe[p+1] = 0; p += 2;
        pe[p] = 0x2F; pe[p+1] = 0; p += 2;

        pe[p] = 0x0B; pe[p+1] = 0x02; p += 2;
        pe[p] = 14; pe[p+1] = 0; p += 2;
        this.writeLe32(pe, p, textRaw); p += 4;
        this.writeLe32(pe, p, importRaw); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, this.entryRva); p += 4;
        this.writeLe32(pe, p, textRva); p += 4;
        this.writeLe64(pe, p, 0x140000000); p += 8;
        this.writeLe32(pe, p, SECT_ALIGN); p += 4;
        this.writeLe32(pe, p, FILE_ALIGN); p += 4;
        pe[p] = 6; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        pe[p] = 6; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, imageSize); p += 4;
        this.writeLe32(pe, p, headersSize); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        pe[p] = 3; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        this.writeLe64(pe, p, 0x100000); p += 8;
        this.writeLe64(pe, p, 0x1000); p += 8;
        this.writeLe64(pe, p, 0x100000); p += 8;
        this.writeLe64(pe, p, 0x1000); p += 8;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 16); p += 4;

        for (int i = 0; i < 16; i++) {
            if (i == 1) {
                this.writeLe32(pe, p, rdataRva); p += 4;
                this.writeLe32(pe, p, importVirt); p += 4;

            } elif (i == 2 && rsrcData.length > 0) {
                this.writeLe32(pe, p, rsrcRva); p += 4;
                this.writeLe32(pe, p, rsrcData.length); p += 4;
            } elif (i == 12) {
                this.writeLe32(pe, p, firstIatRva); p += 4;
                this.writeLe32(pe, p, iatSize); p += 4;
            } else {
                this.writeLe32(pe, p, 0); p += 4;
                this.writeLe32(pe, p, 0); p += 4;
            }
        }

        pe[p] = 0x2E; pe[p+1] = 0x74; pe[p+2] = 0x65; pe[p+3] = 0x78; pe[p+4] = 0x74; pe[p+5] = 0; pe[p+6] = 0; pe[p+7] = 0;
        p += 8;
        this.writeLe32(pe, p, textVirt); p += 4;
        this.writeLe32(pe, p, textRva); p += 4;
        this.writeLe32(pe, p, textRaw); p += 4;
        this.writeLe32(pe, p, textFileOff); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0x60000020); p += 4;

        pe[p] = 0x2E; pe[p+1] = 0x72; pe[p+2] = 0x64; pe[p+3] = 0x61; pe[p+4] = 0x74; pe[p+5] = 0x61; pe[p+6] = 0; pe[p+7] = 0;
        p += 8;
        this.writeLe32(pe, p, importVirt); p += 4;
        this.writeLe32(pe, p, rdataRva); p += 4;
        this.writeLe32(pe, p, importRaw); p += 4;
        this.writeLe32(pe, p, rdataFileOff); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0xC0000040); p += 4;

        if (rsrcData.length > 0) {
            pe[p] = 0x2E; pe[p+1] = 0x72; pe[p+2] = 0x73; pe[p+3] = 0x72; pe[p+4] = 0x63; pe[p+5] = 0; pe[p+6] = 0; pe[p+7] = 0;
            p += 8;
            this.writeLe32(pe, p, rsrcVirt); p += 4;
            this.writeLe32(pe, p, rsrcRva); p += 4;
            this.writeLe32(pe, p, rsrcRaw); p += 4;
            this.writeLe32(pe, p, rsrcFileOff); p += 4;
            this.writeLe32(pe, p, 0); p += 4;
            this.writeLe32(pe, p, 0); p += 4;
            this.writeLe32(pe, p, 0); p += 4;
            this.writeLe32(pe, p, 0x40000040); p += 4;
        }

        for (int i = 0; i < this.code.length; i++) {
            pe[textFileOff + i] = this.code[i];
        }

        int importBase = rdataFileOff;

        int descOff = 0;
        int[] groupIltStart = [];
        int rOff = 0;
        for (int g = 0; g < numGroups; g++) {
            groupIltStart.add(descBytes + rOff);
            rOff += iltSizes[g];
        }
        for (int g = 0; g < numGroups; g++) {
            int iltRva = rdataRva + groupIltStart[g];
            int iatRva = rdataRva + groupIatStart[g];
            int dllNameRva = rdataRva + namesStart + dllNameOffsets[g];

            this.writeLe32(pe, importBase + descOff, iltRva);
            this.writeLe32(pe, importBase + descOff + 4, 0);
            this.writeLe32(pe, importBase + descOff + 8, 0);
            this.writeLe32(pe, importBase + descOff + 12, dllNameRva);
            this.writeLe32(pe, importBase + descOff + 16, iatRva);
            descOff += 20;
        }

        int iltOff = descBytes;
        for (int g = 0; g < numGroups; g++) {
            int gBase = importBase + groupIltStart[g];
            int gIatBase = importBase + groupIatStart[g];
            for (int i = 0; i < numImports; i++) {
                if (importGroupIdx[i] == g) {
                    int entryOff = posInGroup[i] * 8;
                    int hintRva = rdataRva + namesStart + hintNameOffsets[i];
                    this.writeLe64(pe, gBase + entryOff, hintRva);
                    this.writeLe64(pe, gIatBase + entryOff, hintRva);
                }
            }
            int nullOff = groupSizes[g] * 8;
            this.writeLe64(pe, gBase + nullOff, 0);
            this.writeLe64(pe, gIatBase + nullOff, 0);
        }

        for (int i = 0; i < hintNames.length; i++) {
            pe[importBase + namesStart + i] = hintNames[i];
        }
        for (int i = 0; i < stringData.length; i++) {
            pe[importBase + stringsStart + i] = stringData[i];
        }

        for (int i = 0; i < rsrcData.length; i++) {
            pe[rsrcFileOff + i] = rsrcData[i];
        }

        return pe;
    }
}


class Lexer {
    private prop string src;
    private prop int pos;
    private prop int line;
    private prop int col;
    private prop char lastChar;
    // Keep the dispatch character in the receiver instead of passing it as a
    // method argument.  This avoids the self-hosted ABI path that can corrupt
    // the first scalar argument after one bootstrap boundary.
    private prop int currentCode;

    construct (string source) {
        this.src = source;
        this.pos = 0;
        this.line = 1;
        this.col = 1;
        this.lastChar = ' ';
        this.currentCode = 0;
    }

    private bool strEq(string a, string b) {
        if (a.length != b.length) { return false; }
        for (int i = 0; i < a.length; i++) {
            if (a[i] != b[i]) { return false; }
        }
        return true;
    }

    private char? peek() {
        if (this.pos < this.src.length) {
            char c = this.src[this.pos];
            return c;
        }
        return null;
    }

    private char? peekNext() {
        if (this.pos + 1 < this.src.length) {
            char c2 = this.src[this.pos + 1];
            return c2;
        }
        return null;
    }

    private char? advance() {
        if (this.pos >= this.src.length) { return null; }
        char c = this.src[this.pos];
        this.pos += 1;
        if (c == '\n') {
            this.line += 1;
            this.col = 1;
        } else {
            this.col += 1;
        }
        return c;
    }

    private void skipWhitespace() {
        while (this.pos < this.src.length) {
            // Compare the byte value as an int.  A local char comparison in
            // this hot path was miscompiled by the second self-hosted stage,
            // causing it to consume the first non-whitespace source byte.
            int cCode = this.src[this.pos];
            if (cCode == 32 || cCode == 9 || cCode == 10 || cCode == 13) {
                this.advance();
            } else {
                break;
            }
        }
    }

    private void skipLineComment() {
        while (this.pos < this.src.length) {
            char c = this.src[this.pos];
            if (c == '\n') { break; }
            this.advance();
        }
    }

    private bool skipBlockComment() {
        int depth = 1;
        while (this.pos < this.src.length && depth > 0) {
            char c = this.src[this.pos];
            if (c == '/' && this.peekNext() == '*') {
                depth += 1;
                this.advance();
                this.advance();
            } else if (c == '*' && this.peekNext() == '/') {
                depth -= 1;
                this.advance();
                this.advance();
            } else {
                this.advance();
            }
        }
        return depth == 0;
    }

    public Token[] tokenize() {
        Token[] tokens = [];
        while (true) {
            this.skipWhitespace();
            if (this.pos >= this.src.length) {
                tokens.add(new Token(0, "", this.line, this.col));
                break;
            }
        Token? tok = this.nextToken();
        if (tok != null) {
            tokens.add(tok);
        }
        }
        return tokens;
    }

    private Token? nextToken() {
        while (this.pos < this.src.length) {
        char c = this.src[this.pos];
        this.lastChar = c;
        int ln = this.line;
        int cl = this.col;

        if (c == '/' && this.peekNext() != null) {
            char next = this.peekNext();
            if (next == '/') { this.advance(); this.skipLineComment(); return null; }
            if (next == '*') { this.advance(); this.advance(); this.skipBlockComment(); return null; }
        }

        if (c == '"') { this.advance(); return this.readStringToken(); }
        if (c == '\'') { this.advance(); return this.readChar(); }
        if ((c >= '0' && c <= '9')) { this.currentCode = c; return this.readNumber(); }
        if (isAlpha(c) || c == '_') { this.currentCode = c; return this.readIdent(); }

        this.advance();

        if (c == '(') { return new Token(100, "(", ln, cl); }
        if (c == ')') { return new Token(101, ")", ln, cl); }
        if (c == '{') { return new Token(102, "{", ln, cl); }
        if (c == '}') { return new Token(103, "}", ln, cl); }
        if (c == '[') { return new Token(104, "[", ln, cl); }
        if (c == ']') { return new Token(105, "]", ln, cl); }
        if (c == ';') { return new Token(106, ";", ln, cl); }
        if (c == ',') { return new Token(107, ",", ln, cl); }
        if (c == '.') {
            if (this.peek() == '.' && this.peekNext() != null && this.peekNext() == '.') {
                this.advance(); this.advance();
                return new Token(147, "...", ln, cl);
            }
            if (this.peek() == '.') { this.advance(); return new Token(144, "..", ln, cl); }
            return new Token(108, ".", ln, cl);
        }
        if (c == ':') { return new Token(109, ":", ln, cl); }
        if (c == '+') {
            if (this.peek() == '+') { this.advance(); return new Token(142, "++", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(130, "+=", ln, cl); }
            return new Token(111, "+", ln, cl);
        }
        if (c == '-') {
            if (this.peek() == '-') { this.advance(); return new Token(143, "--", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(131, "-=", ln, cl); }
            if (this.peek() == '>') { this.advance(); return new Token(145, "->", ln, cl); }
            return new Token(112, "-", ln, cl);
        }
        if (c == '*') {
            if (this.peek() == '=') { this.advance(); return new Token(132, "*=", ln, cl); }
            return new Token(113, "*", ln, cl);
        }
        if (c == '/') {
            if (this.peek() == '=') { this.advance(); return new Token(133, "/=", ln, cl); }
            return new Token(114, "/", ln, cl);
        }
        if (c == '%') { return new Token(115, "%", ln, cl); }
        if (c == '&') {
            if (this.peek() == '&') { this.advance(); return new Token(138, "&&", ln, cl); }
            return new Token(116, "&", ln, cl);
        }
        if (c == '|') {
            if (this.peek() == '|') { this.advance(); return new Token(139, "||", ln, cl); }
            return new Token(117, "|", ln, cl);
        }
        if (c == '<') {
            if (this.peek() == '<') { this.advance(); return new Token(140, "<<", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(136, "<=", ln, cl); }
            return new Token(120, "<", ln, cl);
        }
        if (c == '>') {
            if (this.peek() == '>') { this.advance(); return new Token(141, ">>", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(137, ">=", ln, cl); }
            return new Token(121, ">", ln, cl);
        }
        if (c == '=') {
            if (this.peek() == '=') { this.advance(); return new Token(134, "==", ln, cl); }
            if (this.peek() == '>') { this.advance(); return new Token(146, "=>", ln, cl); }
            return new Token(110, "=", ln, cl);
        }
        if (c == '!') {
            if (this.peek() == '=') { this.advance(); return new Token(135, "!=", ln, cl); }
            return new Token(122, "!", ln, cl);
        }
        if (c == '~') { return new Token(119, "~", ln, cl); }
        if (c == '^') { return new Token(118, "^", ln, cl); }
        if (c == '?') {
            if (this.peek() == '?') { this.advance(); return new Token(148, "??", ln, cl); }
            return new Token(123, "?", ln, cl);
        }
        if (c == '#') { return new Token(125, "#", ln, cl); }

        }
        return null;
    }

    private Token readStringToken() {
        int ln = this.line; int cl = this.col;
        string s = "";
        while (this.pos < this.src.length) {
            char ch = this.src[this.pos]; this.advance();
            if (ch == '"') { break; }
            if (ch == '\\') {
                if (this.pos < this.src.length) {
                    char esc = this.src[this.pos]; this.advance();
                    if (esc == 'n') { s = s + "\n"; }
                    else if (esc == 't') { s = s + "\t"; }
                    else if (esc == '0') { s = s + "\0"; }
                    else if (esc == 'r') { s = s + "\r"; }
                    else if (esc == '\\') { s = s + "\\"; }
                    else if (esc == '\"') { s = s + "\""; }
                    else if (esc == 'x') {
                        // Hex escape \xHH: decode 1-2 hex digits into a raw
                        // byte (ANSI codes like \x1B are the primary use).
                        int hv = 0;
                        int nd = 0;
                        while (nd < 2 && this.pos < this.src.length) {
                            char hc = this.src[this.pos];
                            int dv = -1;
                            if (hc >= '0' && hc <= '9') { dv = hc - '0'; }
                            elif (hc >= 'a' && hc <= 'f') { dv = hc - 'a' + 10; }
                            elif (hc >= 'A' && hc <= 'F') { dv = hc - 'A' + 10; }
                            if (dv < 0) { break; }
                            this.advance();
                            hv = hv * 16 + dv;
                            nd = nd + 1;
                        }
                        if (nd > 0) {
                            char xc = hv;
                            s = s + charToString(xc);
                        } else {
                            s = s + "\\x";
                        }
                    }
                    else { s = s + "\\" + esc; }
                }
            } else {
                s = s + charToString(ch);
            }
        }
        Token tok = new Token(3, s, ln, cl);
        tok.strVal = s;
        return tok;
    }

    private Token readChar() {
        int ln = this.line; int cl = this.col;
        char ch = ' ';
        if (this.pos < this.src.length) {
            ch = this.src[this.pos]; this.advance();
            if (ch == '\\' && this.pos < this.src.length) {
                char esc = this.src[this.pos]; this.advance();
                if (esc == 'n') { ch = '\n'; }
                else if (esc == 't') { ch = '\t'; }
                else if (esc == '0') { ch = '\0'; }
                else if (esc == 'r') { ch = '\r'; }
                else if (esc == '\\') { ch = '\\'; }
                else if (esc == '\'') { ch = '\''; }
                else if (esc == 'x') {
                    // Hex escape \xHH (e.g. '\x1B').
                    int hv = 0;
                    int nd = 0;
                    while (nd < 2 && this.pos < this.src.length) {
                        char hc = this.src[this.pos];
                        int dv = -1;
                        if (hc >= '0' && hc <= '9') { dv = hc - '0'; }
                        elif (hc >= 'a' && hc <= 'f') { dv = hc - 'a' + 10; }
                        elif (hc >= 'A' && hc <= 'F') { dv = hc - 'A' + 10; }
                        if (dv < 0) { break; }
                        this.advance();
                        hv = hv * 16 + dv;
                        nd = nd + 1;
                    }
                    if (nd > 0) { ch = hv; } else { ch = esc; }
                }
                else { ch = esc; }
            }
        }
        if (this.pos < this.src.length && this.src[this.pos] == '\'') {
            this.advance();
        }
        string charText = "";
        charText = charText + ch;
        Token tok = new Token(4, charText, ln, cl);
        tok.charVal = ch;
        return tok;
    }

    private Token readNumber() {
        int ln = this.line; int cl = this.col;
        int firstCode = this.currentCode;
        this.advance();
        string s = "";
        if (firstCode == 48) { s = s + "0"; }
        elif (firstCode == 49) { s = s + "1"; }
        elif (firstCode == 50) { s = s + "2"; }
        elif (firstCode == 51) { s = s + "3"; }
        elif (firstCode == 52) { s = s + "4"; }
        elif (firstCode == 53) { s = s + "5"; }
        elif (firstCode == 54) { s = s + "6"; }
        elif (firstCode == 55) { s = s + "7"; }
        elif (firstCode == 56) { s = s + "8"; }
        elif (firstCode == 57) { s = s + "9"; }
        bool isFloat = false;
        int base = 10;
        if (firstCode == 48 && this.pos < this.src.length) {
            char next = this.src[this.pos];
            if (next == 'x' || next == 'X') {
                this.advance();
                base = 16;
                s = "";
            }
        }
        while (this.pos < this.src.length) {
            char ch = this.src[this.pos];
            if ((ch >= '0' && ch <= '9') || ch == '_') {
                s = s + ch; this.advance();
            } elif (base == 16 && ((ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F'))) {
                s = s + ch; this.advance();
            } elif (ch == '.' && !isFloat) {
                if (this.peek() == '.') { break; }
                isFloat = true; s = s + "."; this.advance();
            } elif (ch == 'e' || ch == 'E') {
                isFloat = true; s = s + ch; this.advance();
if (this.pos < this.src.length) {
                char sign = this.src[this.pos];
                if (sign == '+' || sign == '-') {
                    s = s + sign; this.advance();
                }
            }
            } else { break; }
        }
        Token tok = new Token(1, s, ln, cl);
        if (isFloat) {
            tok.intVal = 0;
        } else {
            // Parse the digit string manually.  The toInt64 / toInt64FromBase
            // builtin methods are not dispatched by every backend, so compute
            // the value directly with arithmetic that all stages support.
            int64 val = 0;
            for (int i = 0; i < s.length; i++) {
                char ch = s[i];
                int d = -1;
                if (ch >= '0' && ch <= '9') { d = ch - '0'; }
                elif (base == 16 && ch >= 'a' && ch <= 'f') { d = ch - 'a' + 10; }
                elif (base == 16 && ch >= 'A' && ch <= 'F') { d = ch - 'A' + 10; }
                if (d >= 0) { val = val * base + d; }
            }
            tok.intVal = val;
        }
        return tok;
    }

    private Token readIdent() {
        int ln = this.line; int cl = this.col;
        int firstCode = this.currentCode;
        this.advance();
        string s = "";
        if (firstCode == 97) { s = s + "a"; }
        elif (firstCode == 98) { s = s + "b"; }
        elif (firstCode == 99) { s = s + "c"; }
        elif (firstCode == 100) { s = s + "d"; }
        elif (firstCode == 101) { s = s + "e"; }
        elif (firstCode == 102) { s = s + "f"; }
        elif (firstCode == 103) { s = s + "g"; }
        elif (firstCode == 104) { s = s + "h"; }
        elif (firstCode == 105) { s = s + "i"; }
        elif (firstCode == 106) { s = s + "j"; }
        elif (firstCode == 107) { s = s + "k"; }
        elif (firstCode == 108) { s = s + "l"; }
        elif (firstCode == 109) { s = s + "m"; }
        elif (firstCode == 110) { s = s + "n"; }
        elif (firstCode == 111) { s = s + "o"; }
        elif (firstCode == 112) { s = s + "p"; }
        elif (firstCode == 113) { s = s + "q"; }
        elif (firstCode == 114) { s = s + "r"; }
        elif (firstCode == 115) { s = s + "s"; }
        elif (firstCode == 116) { s = s + "t"; }
        elif (firstCode == 117) { s = s + "u"; }
        elif (firstCode == 118) { s = s + "v"; }
        elif (firstCode == 119) { s = s + "w"; }
        elif (firstCode == 120) { s = s + "x"; }
        elif (firstCode == 121) { s = s + "y"; }
        elif (firstCode == 122) { s = s + "z"; }
        elif (firstCode == 65) { s = s + "A"; }
        elif (firstCode == 66) { s = s + "B"; }
        elif (firstCode == 67) { s = s + "C"; }
        elif (firstCode == 68) { s = s + "D"; }
        elif (firstCode == 69) { s = s + "E"; }
        elif (firstCode == 70) { s = s + "F"; }
        elif (firstCode == 71) { s = s + "G"; }
        elif (firstCode == 72) { s = s + "H"; }
        elif (firstCode == 73) { s = s + "I"; }
        elif (firstCode == 74) { s = s + "J"; }
        elif (firstCode == 75) { s = s + "K"; }
        elif (firstCode == 76) { s = s + "L"; }
        elif (firstCode == 77) { s = s + "M"; }
        elif (firstCode == 78) { s = s + "N"; }
        elif (firstCode == 79) { s = s + "O"; }
        elif (firstCode == 80) { s = s + "P"; }
        elif (firstCode == 81) { s = s + "Q"; }
        elif (firstCode == 82) { s = s + "R"; }
        elif (firstCode == 83) { s = s + "S"; }
        elif (firstCode == 84) { s = s + "T"; }
        elif (firstCode == 85) { s = s + "U"; }
        elif (firstCode == 86) { s = s + "V"; }
        elif (firstCode == 87) { s = s + "W"; }
        elif (firstCode == 88) { s = s + "X"; }
        elif (firstCode == 89) { s = s + "Y"; }
        elif (firstCode == 90) { s = s + "Z"; }
        elif (firstCode == 95) { s = s + "_"; }
        while (this.pos < this.src.length) {
            char ch = this.src[this.pos];
            if (isAlphaNum(ch) || ch == '_') {
                s = s + ch; this.advance();
            } else { break; }
        }
        int kind = this.keywordKind(s);
        Token tok = new Token(kind, s, ln, cl);
        if (kind == 7) { tok.strVal = s; }
        return tok;
    }

    private int keywordKind(string s) {
        if (this.strEq(s, "if")) { return 10; }
        if (this.strEq(s, "else")) { return 11; }
        if (this.strEq(s, "while")) { return 12; }
        if (this.strEq(s, "for")) { return 13; }
        if (this.strEq(s, "foreach")) { return 14; }
        if (this.strEq(s, "return")) { return 15; }
        if (this.strEq(s, "match")) { return 16; }
        if (this.strEq(s, "void")) { return 17; }
        if (this.strEq(s, "int")) { return 18; }
        if (this.strEq(s, "int32")) { return 19; }
        if (this.strEq(s, "int64")) { return 20; }
        if (this.strEq(s, "float")) { return 22; }
        if (this.strEq(s, "float64")) { return 23; }
        if (this.strEq(s, "bool")) { return 25; }
        if (this.strEq(s, "char")) { return 26; }
        if (this.strEq(s, "string")) { return 27; }
        if (this.strEq(s, "var")) { return 28; }
        if (this.strEq(s, "struct")) { return 29; }
        if (this.strEq(s, "class")) { return 30; }
        if (this.strEq(s, "enum")) { return 31; }
        if (this.strEq(s, "def")) { return 32; }
        if (this.strEq(s, "new")) { return 39; }
        if (this.strEq(s, "const")) { return 40; }
        if (this.strEq(s, "true")) { return 5; }
        if (this.strEq(s, "false")) { return 5; }
        if (this.strEq(s, "null")) { return 6; }
        if (this.strEq(s, "import")) { return 36; }
        if (this.strEq(s, "from")) { return 37; }
        if (this.strEq(s, "as")) { return 38; }
        if (this.strEq(s, "mod")) { return 35; }
        if (this.strEq(s, "mut")) { return 50; }
        if (this.strEq(s, "public")) { return 44; }
        if (this.strEq(s, "private")) { return 45; }
        if (this.strEq(s, "static")) { return 46; }
        if (this.strEq(s, "prop")) { return 47; }
        if (this.strEq(s, "construct")) { return 48; }
        if (this.strEq(s, "unset")) { return 49; }
        if (this.strEq(s, "try")) { return 52; }
        if (this.strEq(s, "catch")) { return 53; }
        if (this.strEq(s, "found")) { return 33; }
        if (this.strEq(s, "collect")) { return 34; }
        if (this.strEq(s, "ref")) { return 51; }
        if (this.strEq(s, "in")) { return 54; }
        if (this.strEq(s, "to")) { return 55; }
        if (this.strEq(s, "elif")) { return 56; }
        if (this.strEq(s, "break")) { return 57; }
        if (this.strEq(s, "continue")) { return 58; }
        if (this.strEq(s, "export")) { return 59; }
        if (this.strEq(s, "extends")) { return 60; }
        return 7;
    }
}

class Token {
    public prop int kind;
    public prop string text;
    public prop int line;
    public prop int col;
    public prop int64 intVal;
    public prop float64 floatVal;
    public prop string strVal;
    public prop char charVal;

    construct (int kind, string text, int line, int col) {
        this.kind = kind; this.text = text;
        this.line = line; this.col = col;
        this.intVal = 0; this.floatVal = 0.0;
        this.strVal = ""; this.charVal = ' ';
    }
}

class Parser {
    private prop Token[] tokens;
    private prop int pos;

    construct (Token[] toks) {
        this.tokens = toks;
        this.pos = 0;
    }

    private bool strEq(string a, string b) {
        if (a.length != b.length) { return false; }
        for (int i = 0; i < a.length; i++) {
            if (a[i] != b[i]) { return false; }
        }
        return true;
    }

    private void pppp() {
        Node n = new Node();
        n.kind = 64;
        this.expect(14);
        this.expect(100);
        Node v = new Node();
        v.kind = 50;
        string vt = this.advance().text;
        if (this.check(120)) {
            while (!this.check(121) && !this.check(106) && !this.check(103)) {
                vt = vt + this.advance().text;
            }
            if (this.check(121)) { vt = vt + ">"; this.advance(); }
        }
        while (this.check(104)) { this.advance(); this.expect(105); vt = vt + "[]"; }
        if (this.check(123)) { this.advance(); vt = vt + "?"; }
        v.typeHint = vt;
        v.name = this.advance().text;
        n.children.add(v);
        this.expect(54);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlock());
        return n;
    }

    private Token peek() {
        if (this.pos < this.tokens.length) {
            return this.tokens[this.pos];
        }
        return this.tokens[this.tokens.length - 1];
    }

    private Token advance() {
        Token t = this.tokens[this.pos];
        this.pos = this.pos + 1;
        return t;
    }

    private bool check(int kind) {
        Token t = this.peek();
        return t.kind == kind;
    }

    private Token expect(int kind) {
        if (this.check(kind)) {
            return this.advance();
        }
        exit(1);
        return this.peek();
    }

    public Node[] parseProgram() {
        Node[] items = [];
        Node mainBody = new Node();
        mainBody.kind = 16;
        bool mainSeen = false;
        while (!this.check(0)) {
            int posBefore = this.pos;
            Node? item = this.parseItem();
            if (item != null) {
                if (item.kind == 100 && this.strEq(item.name, "main")) {
                    mainSeen = true;
                }
                if (item.kind == 61 || item.kind == 50 || item.kind == 16 || item.kind == 53 || item.kind == 54 || item.kind == 55) {
                    mainBody.children.add(item);
                } else {
                    items.add(item);
                }
            }
            if (this.pos == posBefore) {
                break;
            }
        }
        if (mainBody.children.length > 0 && !mainSeen) {
            Node main = new Node();
            main.kind = 100;
            main.name = "main";
            main.typeHint = "void";
            Node params = new Node();
            main.children.add(params);
            main.children.add(mainBody);
            items.add(main);
        }
        if (mainSeen) {
            // Top-level variable declarations become real globals when a main
            // function exists: keep them in the program list so codegen can
            // allocate writable slots and run their initializers before main().
            for (int gi = 0; gi < mainBody.children.length; gi++) {
                if (mainBody.children[gi].kind == 50) {
                    items.add(mainBody.children[gi]);
                }
            }
        }
        return items;
    }    private Node? parseItem() {
        if (this.check(35)) { this.advance(); if (this.check(59)) { this.advance(); } this.advance(); this.expect(106); return null; }
		if (this.check(36)) { return this.parseImport(); }
        if (this.check(40)) { return this.parseConst(); }
        if (this.check(32)) { return this.parseDef(); }
        if (this.check(29)) { return this.parseStruct(); }
        if (this.check(30)) { return this.parseClass(); }
        if (this.check(31)) { return this.parseEnum(); }
        // Top-level statements (e.g. `printline(42);`) are legal: a source
        // without a function is compiled as if the statements were the body
        // of an implicit `void main()`.  Functions are recognized by their
        // `Type name (` shape (including array returns like `string[] name (`
        // and optional public/private/static prefixes); anything else is
        // parsed as a statement.
        if (this.pos + 1 < this.tokens.length) {
            int typePos = this.pos;
            Token t0 = this.tokens[this.pos];
            if ((t0.kind == 44 || t0.kind == 45 || t0.kind == 46) && this.pos + 1 < this.tokens.length) {
                typePos = this.pos + 1;
                t0 = this.tokens[typePos];
            }
            bool typeStart = t0.kind == 17 || t0.kind == 18 || t0.kind == 19 || t0.kind == 20 || t0.kind == 22 || t0.kind == 23 || t0.kind == 25 || t0.kind == 26 || t0.kind == 27 || t0.kind == 28 || t0.kind == 7;
            if (typeStart) {
                int scan = typePos + 1;
                if (this.tokens[scan].kind == 120) {
                    scan = scan + 1;
                    while (scan < this.tokens.length && this.tokens[scan].kind != 121) { scan = scan + 1; }
                    scan = scan + 1;
                }
                while (scan + 1 < this.tokens.length && this.tokens[scan].kind == 104 && this.tokens[scan + 1].kind == 105) { scan = scan + 2; }
                if (this.tokens[scan].kind == 123) { scan = scan + 1; }
                if (scan + 1 < this.tokens.length && this.tokens[scan].kind == 7 && this.tokens[scan + 1].kind == 100) {
                    return this.parseFunction();
                }
                return this.parseStmt();
            }
            return this.parseStmt();
        }
        return this.parseFunction();
    }

    private Node parseImport() {
        // DOCS/213 -- import grammar:
        //   `import * from win32.kernel32;`        every export of one DLL
        //   `import kernel32 from win32;`          one native module
        //   `import { a, b } from win32;`          several native modules
        //   `import ReadFile from win32.kernel32;` a single export
        //   `import ast;` / `import * from mod;`   source modules (unchanged)
        // Node layout: name = first name, children = extra names,
        // typeHint = source module after `from`, isStatic = star form.
        Node node = new Node();
        node.kind = 105;
        this.expect(36);
        if (this.check(113)) {
            this.advance();
            node.isStatic = true;
        } elif (this.check(102)) {
            this.advance();
            node.name = this.advance().text;
            while (this.check(107)) {
                this.advance();
                Node extra = new Node();
                extra.name = this.advance().text;
                node.children.add(extra);
            }
            this.expect(103);
        } else {
            node.name = this.advance().text;
            while (this.check(107)) {
                this.advance();
                Node extra = new Node();
                extra.name = this.advance().text;
                node.children.add(extra);
            }
        }
        if (this.check(37)) {
            this.advance();
            string src = this.advance().text;
            while (this.check(108)) {
                this.advance();
                src = src + "." + this.advance().text;
            }
            node.typeHint = src;
        }
        this.expect(106);
        return node;
    }

    private Node parseConst() {
        Node node = new Node();
        node.kind = 104;
        this.expect(40);
        // Support both `const int NAME = 3;` and C-style `const NAME = "x";`.
        // If the token after `const` is a primitive type keyword, consume it;
        // otherwise the name comes directly (type is inferred from the
        // initializer).  Identifiers (kind 7) are always treated as the name.
        if (this.check(17) || this.check(18) || this.check(19) || this.check(20) || this.check(22) || this.check(23) || this.check(25) || this.check(26) || this.check(27) || this.check(28)) {
            node.typeHint = this.advance().text;
        } else {
            node.typeHint = "";
        }
        node.name = this.advance().text;
        this.expect(110);
        node.children.add(this.parseExpr(0));
        this.expect(106);
        return node;
    }

    private Node parseDef() {
        Node node = new Node();
        this.expect(32);
        node.name = this.advance().text;
        if (this.check(110)) {
            node.kind = 103;
            this.advance();
            this.expect(31);
            this.expect(102);
            while (!this.check(103)) {
                node.children.add(this.parsePattern());
                if (this.check(107)) { this.advance(); }
            }
            this.expect(103);
            this.expect(106);
        } else {
            node.kind = 110;
            this.expect(106);
        }
        return node;
    }

    private Node parseStruct() {
        Node node = new Node();
        node.kind = 101;
        this.expect(29);
        node.name = this.advance().text;
        this.expect(102);
        while (!this.check(103)) {
            Node field = new Node();
            field.typeHint = this.advance().text;
            string fn = this.advance().text;
            field.name = fn;
            field.kind = 0;
            node.children.add(field);
            this.expect(106);
        }
        this.expect(103);
        return node;
    }

    private Node parseClass() {
        Node node = new Node();
        node.kind = 102;
        this.expect(30);
        node.name = this.advance().text;
        if (this.check(109) || this.check(60)) {
            this.advance();
            node.parentClass = this.advance().text;
        }
        this.expect(102);
        while (!this.check(103)) {
            Node member = this.parseClassMember();
            if (member != null) { node.children.add(member); }
        }
        this.expect(103);
        return node;
    }

    private Node? parseEnum() {
        this.expect(31);
        Node node = new Node();
        node.kind = 105;
        node.name = this.advance().text;
        this.expect(102);
        int value = 0;
        while (!this.check(103)) {
            Node member = new Node();
            member.kind = 106;
            member.name = this.advance().text;
            member.intVal = value;
            node.children.add(member);
            value = value + 1;
            if (this.check(107)) { this.advance(); }
        }
        this.expect(103);
        return node;
    }

    private Node? parseClassMember() {
        if (this.check(44) || this.check(45)) { this.advance(); }
        if (this.check(46)) { this.advance(); }
        if (this.check(48)) {
            Node ctor = new Node();
            ctor.kind = 100;
            ctor.name = "construct";
            this.advance();
            this.expect(100);
            Node params = new Node();
            while (!this.check(101)) {
                Node param = new Node();
                string cpt = this.advance().text;
                if (this.check(120)) {
                    while (!this.check(121) && !this.check(106) && !this.check(103)) {
                        cpt = cpt + this.advance().text;
                    }
                    if (this.check(121)) { cpt = cpt + ">"; this.advance(); }
                }
                while (this.check(104)) { this.advance(); this.expect(105); cpt = cpt + "[]"; }
                if (this.check(123)) { this.advance(); cpt = cpt + "?"; }
                param.typeHint = cpt;
                param.name = this.advance().text;
                if (this.check(110)) {
                    this.advance();
                    param.children.add(this.parseExpr(0));
                }
                params.children.add(param);
                if (this.check(107)) { this.advance(); }
            }
            this.expect(101);
            ctor.children.add(params);
            ctor.children.add(this.parseBlock());
            return ctor;
        }
        if (this.check(47)) {
            this.advance();
            Node field = new Node();
            field.kind = 50;
            string ft = this.advance().text;
            if (this.check(120)) {
                while (!this.check(121) && !this.check(106) && !this.check(103)) {
                    ft = ft + this.advance().text;
                }
                if (this.check(121)) { ft = ft + ">"; this.advance(); }
            }
            while (this.check(104)) { this.advance(); this.expect(105); ft = ft + "[]"; }
            if (this.check(123)) { this.advance(); ft = ft + "?"; }
            field.typeHint = ft;
            field.name = this.advance().text;
            this.expect(106);
            return field;
        }
        if (this.check(28) || this.check(18) || this.check(19) || this.check(20) || this.check(25) || this.check(27) || this.check(22) || this.check(23) || this.check(26) || this.check(7)) {
            int savedPos = this.pos;
            string ft = this.advance().text;
            if (this.check(120)) {
                while (!this.check(121) && !this.check(106) && !this.check(103)) {
                    ft = ft + this.advance().text;
                }
                if (this.check(121)) { ft = ft + ">"; this.advance(); }
            }
            while (this.check(104)) { this.advance(); this.expect(105); ft = ft + "[]"; }
            if (this.check(123)) { this.advance(); ft = ft + "?"; }
            if (this.check(7) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 106) {
                Node field = new Node();
                field.kind = 50;
                field.typeHint = ft;
                field.name = this.advance().text;
                this.expect(106);
                return field;
            }
            // Legacy class sources (cd_test_classes.sr) omit the trailing
            // semicolon on fields.  Accept `Type name` followed by another
            // type/field or the closing brace as a field declaration.
            if (this.check(7) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind != 100 && this.tokens[this.pos + 1].kind != 102) {
                Node field = new Node();
                field.kind = 50;
                field.typeHint = ft;
                field.name = this.advance().text;
                if (this.check(106)) { this.advance(); }
                return field;
            }
            this.pos = savedPos;
        }
        return this.parseFunction();
    }

    private Node parseFunction() {
        Node node = new Node();
        node.kind = 100;
        if (this.check(44) || this.check(45) || this.check(46)) { this.advance(); }
        string retType = this.advance().text;
        if (this.check(120)) {
            while (!this.check(121) && !this.check(106) && !this.check(103)) {
                retType = retType + this.advance().text;
            }
            if (this.check(121)) { retType = retType + ">"; this.advance(); }
        }
        while (this.check(104)) { this.advance(); this.expect(105); retType = retType + "[]"; }
        if (this.check(123)) { this.advance(); retType = retType + "?"; }
        node.typeHint = retType;
        node.name = this.advance().text;
        this.expect(100);
        Node params = new Node();
        while (!this.check(101)) {
            Node param = new Node();
            string pt = this.advance().text;
            if (this.check(120)) {
                while (!this.check(121) && !this.check(106) && !this.check(103)) {
                    pt = pt + this.advance().text;
                }
                if (this.check(121)) { pt = pt + ">"; this.advance(); }
            }
            while (this.check(104)) { this.advance(); this.expect(105); pt = pt + "[]"; }
            if (this.check(123)) { this.advance(); pt = pt + "?"; }
            param.typeHint = pt;
            param.name = this.advance().text;
            if (this.check(110)) {
                this.advance();
                param.children.add(this.parseExpr(0));
            }
            params.children.add(param);
            if (this.check(107)) { this.advance(); }
        }
        this.expect(101);
        node.children.add(params);
        if (this.check(141)) {
            this.advance();
            node.children.add(this.parseExpr(0));
        } else {
            node.children.add(this.parseBlock());
        }
        return node;
    }

    private Node parseBlock() {
        Node block = new Node();
        block.kind = 16;
        this.expect(102);
        while (!this.check(103)) {
            block.children.add(this.parseStmt());
        }
        this.expect(103);
        return block;
    }

    // Accepts either a brace block or a single brace-less statement
    // (JS-style `if (x) return 1;` one-liners).
    private Node parseBlockOrStmt() {
        if (this.check(102)) {
            return this.parseBlock();
        }
        return this.parseStmt();
    }

    private Node parseStmt() {
        if (this.check(7) && this.pos + 1 < this.tokens.length) {
            Token next = this.tokens[this.pos + 1];
            if (next.kind == 7) {
                return this.parseVarDecl();
            }
if (next.kind == 104 && this.pos + 2 < this.tokens.length && this.tokens[this.pos + 2].kind == 105) {
                return this.parseVarDecl();
            }
            if (next.kind == 123 && this.pos + 2 < this.tokens.length && this.tokens[this.pos + 2].kind == 7) {
                return this.parseVarDecl();
            }
            if (next.kind == 120) {
                return this.parseVarDecl();
            }
        }
        if (this.check(15)) {
            Node n = new Node(); n.kind = 51;
            this.advance();
            if (!this.check(106)) { n.children.add(this.parseExpr(0)); }
            this.expect(106);
            return n;
        }
        if (this.check(141)) {
            Node n = new Node(); n.kind = 52;
            this.advance();
            n.children.add(this.parseExpr(0));
            this.expect(106);
            return n;
        }
        if (this.check(10)) { return this.parseIf(); }
        if (this.check(12)) { return this.parseWhile(); }
        if (this.check(13)) { return this.parseFor(); }
        if (this.check(14)) { return this.pppp(); }
        if (this.check(57)) { Node n = new Node(); n.kind = 62; this.advance(); this.expect(106); return n; }
        if (this.check(58)) { Node n = new Node(); n.kind = 63; this.advance(); this.expect(106); return n; }
        if (this.check(49)) {
            Node n = new Node(); n.kind = 60;
            this.advance();
            n.name = this.advance().text;
            this.expect(106);
            return n;
        }
        if (this.check(28) || this.check(18) || this.check(19) || this.check(20) || this.check(25) || this.check(27) || this.check(22) || this.check(23) || this.check(26)) {
            return this.parseVarDecl();
        }
        Node exprStmt = new Node(); exprStmt.kind = 61;
        exprStmt.children.add(this.parseExpr(0));
        // A trailing semicolon is optional for the final statement (top-level
        // scripts and legacy tests such as test_42.sr omit it).
        if (this.check(106)) { this.advance(); }
        return exprStmt;
    }

    private Node parseVarDecl() {
        Node n = new Node(); n.kind = 50;
        string typeName = this.advance().text;
        if (this.check(120)) {
            while (!this.check(121) && !this.check(106) && !this.check(103)) {
                typeName = typeName + this.advance().text;
            }
            if (this.check(121)) { typeName = typeName + ">"; this.advance(); }
        }
        while (this.check(104)) {
            this.advance();
            this.expect(105);
            typeName = typeName + "[]";
        }
        if (this.check(123)) { this.advance(); typeName = typeName + "?"; }
        n.typeHint = typeName;
        if (this.check(50)) { this.advance(); n.isMut = true; }
        n.name = this.advance().text;
        if (this.check(110)) {
            this.advance();
            n.children.add(this.parseExpr(0));
        }
        this.expect(106);
        return n;
    }

    private Node parseIf() {
        Node n = new Node(); n.kind = 53;
        if (this.check(56)) {
            this.advance();
        } else {
            this.expect(10);
        }
        this.expect(100);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlockOrStmt());
        if (this.check(11)) {
            this.advance();
            if (this.check(10)) {
                n.children.add(this.parseIf());
            } elif (this.check(56)) {
                n.children.add(this.parseIf());
            } else {
                n.children.add(this.parseBlockOrStmt());
            }
        } elif (this.check(56)) {
            n.children.add(this.parseIf());
        }
        return n;
    }

    private Node parseWhile() {
        Node n = new Node(); n.kind = 54;
        this.expect(12);
        this.expect(100);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlockOrStmt());
        return n;
    }

    private Node parseFor() {
        Node n = new Node();
        this.expect(13);
        this.expect(100);
        if (this.check(28) || this.check(18) || this.check(19) || this.check(20)) {
            n.kind = 55;
            n.children.add(this.parseVarDecl());
        } else {
            n.kind = 55;
            n.children.add(this.parseStmt());
        }
        n.children.add(this.parseExpr(0));
        this.expect(106);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlockOrStmt());
        return n;
    }

    private Node parseExpr(int minPrec) {
        Node lhs = this.parsePrefix();
        while (true) {
            if (this.check(100) && lhs.kind == 6) {
                Node call = new Node(); call.kind = 10;
                call.name = lhs.name;
                this.advance();
                while (!this.check(101)) {
                    call.children.add(this.parseExpr(0));
                    if (this.check(107)) { this.advance(); }
                }
                this.expect(101);
                lhs = call;
                continue;
            }
            if (this.check(104)) {
                Node idx = new Node(); idx.kind = 24;
                idx.children.add(lhs);
                this.advance();
                idx.children.add(this.parseExpr(0));
                // Slice syntax: arr[a:b] (colon) or arr[a..b] (range) -> kind 67.
                if (this.check(109) || this.check(144)) {
                    this.advance();
                    idx.kind = 67;
                    if (this.check(105)) {
                        // Open-ended slice [a:]: the end bound is the base's
                        // length, resolved in genSlice (sentinel intVal -1).
                        Node openEnd = new Node(); openEnd.kind = 0; openEnd.intVal = -1;
                        idx.children.add(openEnd);
                    } else {
                        idx.children.add(this.parseExpr(0));
                    }
                }
                this.expect(105);
                lhs = idx;
                continue;
            }
            if (this.check(108)) {
                this.advance();
                Token name = this.advance();
                if (this.check(100)) {
                    Node call = new Node(); call.kind = 10;
                    call.name = name.text;
                    call.isMember = true;
                    call.children.add(lhs);
                    this.advance();
                    while (!this.check(101)) {
                        call.children.add(this.parseExpr(0));
                        if (this.check(107)) { this.advance(); }
                    }
                    this.expect(101);
                    lhs = call;
                } else {
                    Node member = new Node(); member.kind = 13;
                    member.name = name.text;
                    member.children.add(lhs);
                    lhs = member;
                }
                continue;
            }
            if (this.check(142)) {
                this.advance();
                Node add = new Node(); add.kind = 7; add.op = 1;
                Node one = new Node(); one.kind = 0; one.intVal = 1;
                add.children.add(lhs);
                add.children.add(one);
                Node assign = new Node(); assign.kind = 7; assign.op = 20;
                assign.children.add(lhs);
                assign.children.add(add);
                lhs = assign;
                continue;
            }
            if (this.check(143)) {
                this.advance();
                Node sub = new Node(); sub.kind = 7; sub.op = 2;
                Node one = new Node(); one.kind = 0; one.intVal = 1;
                sub.children.add(lhs);
                sub.children.add(one);
                Node assign = new Node(); assign.kind = 7; assign.op = 20;
                assign.children.add(lhs);
                assign.children.add(sub);
                lhs = assign;
                continue;
            }
            if (this.check(148) && minPrec <= 1) {
                this.advance();
                Node coalesce = new Node(); coalesce.kind = 7; coalesce.op = 25;
                coalesce.children.add(lhs);
                coalesce.children.add(this.parseExpr(2));
                lhs = coalesce;
                continue;
            }
            if (this.check(123) && minPrec <= 1) {
                this.advance();
                Node thenExpr = this.parseExpr(0);
                this.expect(109);
                Node elseExpr = this.parseExpr(0);
                Node tern = new Node(); tern.kind = 65;
                tern.children.add(lhs);
                tern.children.add(thenExpr);
                tern.children.add(elseExpr);
                lhs = tern;
                continue;
            }
            int prec = this.getPrec(this.peek().kind);
            if (prec < minPrec) { break; }
            int nextMin = prec + 1;
            int op = this.peek().kind;
            this.advance();
            Node rhs = this.parseExpr(nextMin);
            Node bin = new Node(); bin.kind = 7;
            bin.op = this.tokenToOp(op);
            bin.children.add(lhs);
            bin.children.add(rhs);
            lhs = bin;
        }
        return lhs;
    }

    private int tokenToOp(int kind) {
        if (kind == 111) { return 1; }
        if (kind == 112) { return 2; }
        if (kind == 113) { return 3; }
        if (kind == 114) { return 4; }
        if (kind == 115) { return 13; }
        if (kind == 134) { return 5; }
        if (kind == 135) { return 6; }
        if (kind == 120) { return 7; }
        if (kind == 136) { return 8; }
        if (kind == 121) { return 9; }
        if (kind == 137) { return 10; }
        if (kind == 138) { return 11; }
        if (kind == 139) { return 12; }
        if (kind == 110) { return 20; }
        if (kind == 130) { return 14; }
        if (kind == 131) { return 15; }
        if (kind == 132) { return 16; }
        if (kind == 133) { return 17; }
        if (kind == 140) { return 18; }
        if (kind == 141) { return 19; }
        if (kind == 144) { return 20; }
        if (kind == 148) { return 25; }
        if (kind == 116) { return 22; }
        if (kind == 117) { return 23; }
        if (kind == 118) { return 24; }
        return 0;
    }

    private int getPrec(int kind) {
        if (kind == 110 || kind == 130 || kind == 131 || kind == 132 || kind == 133 || kind == 148) { return 1; }
        if (kind == 139) { return 2; }
        if (kind == 138) { return 3; }
        if (kind == 135 || kind == 134) { return 4; }
        if (kind == 120 || kind == 136 || kind == 121 || kind == 137) { return 5; }
        if (kind == 117) { return 6; }
        if (kind == 116) { return 7; }
        if (kind == 118) { return 7; }
        if (kind == 140 || kind == 141) { return 8; }
        if (kind == 111 || kind == 112) { return 9; }
        if (kind == 113 || kind == 114 || kind == 115) { return 10; }
        if (kind == 144) { return 11; }
        return -1;
    }

    private Node parsePrefix() {
        Token t = this.advance();
        Node n = new Node();
        n.line = t.line; n.col = t.col;
        int kind = t.kind;

        if (kind == 1) { n.kind = 0; n.intVal = t.intVal; return n; }
        if (kind == 2) { n.kind = 1; n.floatVal = t.floatVal; return n; }
        if (kind == 3) { n.kind = 2; n.strVal = t.strVal; return n; }
        if (kind == 4) { n.kind = 3; n.charVal = t.charVal; return n; }
        if (kind == 5) {
            n.kind = 4;
            n.boolVal = this.strEq(t.text, "true");
            return n;
        }
        if (kind == 6) { n.kind = 5; return n; }
        if (kind == 7) { n.kind = 6; n.name = t.text; return n; }        if (kind == 39) {
            Node ctor = new Node();
            ctor.kind = 10;
            ctor.name = this.advance().text;
            if (this.check(104)) {
                // new T[n]: native array allocation.  A zero/omitted size
                // produces an empty array; a positive constant size produces
                // that many zeroed slots.
                this.advance();
                Node sizeExpr = this.parseExpr(0);
                this.expect(105);
                Node arr = new Node(); arr.kind = 19;
                if (sizeExpr.kind == 0 && sizeExpr.intVal > 0 && sizeExpr.intVal <= 256) {
                    for (int zi = 0; zi < sizeExpr.intVal; zi++) {
                        Node zero = new Node(); zero.kind = 0; zero.intVal = 0;
                        arr.children.add(zero);
                    }
                }
                return arr;
            }
            this.expect(100);
            while (!this.check(101)) {
                ctor.children.add(this.parseExpr(0));
                if (this.check(107)) { this.advance(); }
            }
            this.expect(101);
            return ctor;
        }

        if (kind == 100) { n.kind = 23; n.children.add(this.parseExpr(0)); this.expect(101); return n; }
        if (kind == 102) {
            if (this.check(103)) {
                n.kind = 66;
                this.advance();
                return n;
            }
            // Braced string/int key pairs are dictionary literals; other
            // braced expressions retain the historical array-compatible form.
            if (this.check(3) || this.check(1) || this.check(7)) {
                int saved = this.pos;
                Node firstKey = this.parseExpr(0);
                if (this.check(109)) {
                    n.kind = 66;
                    this.advance();
                    Node pair = new Node(); pair.kind = 18;
                    pair.children.add(firstKey);
                    pair.children.add(this.parseExpr(0));
                    n.children.add(pair);
                    while (this.check(107)) {
                        this.advance();
                        Node key = this.parseExpr(0);
                        this.expect(109);
                        Node nextPair = new Node(); nextPair.kind = 18;
                        nextPair.children.add(key);
                        nextPair.children.add(this.parseExpr(0));
                        n.children.add(nextPair);
                    }
                    this.expect(103);
                    return n;
                }
                this.pos = saved;
            }
            n.kind = 19;
            while (!this.check(103)) {
                n.children.add(this.parseExpr(0));
                if (this.check(107)) { this.advance(); }
            }
            this.expect(103);
            return n;
        }

        if (kind == 104) {
            n.kind = 19;
            while (!this.check(105)) {
                n.children.add(this.parseExpr(0));
                if (this.check(107)) { this.advance(); }
            }
            this.expect(105);
            return n;
        }

        if (kind == 112) { n.kind = 8; n.op = 0; n.children.add(this.parseExpr(10)); return n; }
        if (kind == 122) { n.kind = 8; n.op = 1; n.children.add(this.parseExpr(10)); return n; }
        if (kind == 116) { n.kind = 8; n.op = 3; n.children.add(this.parseExpr(10)); return n; }

        Node ident = new Node(); ident.kind = 6; ident.name = t.text;
        return ident;
    }

    private Node parsePattern() {
        Node n = new Node();
        Token t = this.advance();
        if (t.kind == 126) { n.name = "_"; return n; }
        if (t.kind == 1) { n.kind = 0; n.intVal = t.intVal; return n; }
        if (t.kind == 7) { n.name = t.text; return n; }
        return n;
    }
}

class Node {
    public prop int kind;
    public prop int64 intVal;
    public prop float64 floatVal;
    public prop string strVal;
    public prop char charVal;
    public prop bool boolVal;
    public prop int op;
    public prop string name;
    public prop string typeHint;
    public prop bool isMut;
    public prop bool isPublic;
    public prop bool isStatic;
    public prop bool isMember;
    public prop string parentClass;
    public prop Node[] children;
    public prop int line;
    public prop int col;

    construct () {
        this.kind = 0; this.intVal = 0; this.floatVal = 0.0;
        this.strVal = ""; this.charVal = ' '; this.boolVal = false;
        this.op = 0; this.name = ""; this.typeHint = "";
        this.isMut = false; this.isPublic = true; this.isStatic = false;
        this.isMember = false;
        this.parentClass = ""; this.children = [];
        this.line = 0; this.col = 0;
    }

    public int childCount() {
        return this.children.length;
    }

    public Node child(int i) {
        if (i >= 0 && i < this.children.length) {
            return this.children[i];
        }
        return new Node();
    }
}


