mod export compiler;

import * from fs;
import * from string;
import * from project;

void printHelp() {
    printline("Silver Compiler v0.3.0");
    printline("Copyright: © 2025 Edan M.");
    printline("");
    printline("Usage:");
    printline("  silverc [options] [<input.sr> [<output.exe>]]");
    printline("  silverc -i <input.sr> -o <output.exe>");
    printline("");
    printline("Options:");
    printline("  -h, --help, -?    Show this help message");
    printline("  -v, --version     Show compiler and language version");
    printline("  -i <file>         Input Silver source file (default: compiler_driver.sr)");
    printline("  -o <file>         Output executable file (default: silverc)");
    printline("");
    printline("Examples:");
    printline("  silverc --help");
    printline("  silverc input.sr output.exe");
    printline("  silverc -i input.sr -o output.exe");
    printline("");
    printline("Run with --help to show this message.");
}

void main() {
    string[] args = cargs;
    string inputFile = "";
    string outputFile = "";
    bool showHelp = false;
    bool showVersion = false;

    // cargs[0] is the executable name. Keep argument handling independent of
    // the platform's quoting rules and of the current working directory.
    int argIdx = 1;
    bool inputSet = false;
    bool outputSet = false;
    while (argIdx < args.length) {
        string arg = args[argIdx];
        bool isOption = false;

        // Compare option spelling by length and characters.  String equality
        // is deliberately avoided here: the self-hosted backend represents
        // strings as pointers, while character equality is value-based.
        if (arg.length == 2) {
            if (arg[0] == '-') {
                if (arg[1] == 'h') {
                    showHelp = true;
                    isOption = true;
                }
                if (arg[1] == 'v') {
                    showVersion = true;
                    isOption = true;
                }
                if (arg[1] == 'i') {
                    isOption = true;
                    argIdx = argIdx + 1;
                    if (argIdx < args.length) {
                        inputFile = args[argIdx];
                        inputSet = true;
                    }
                }
                if (arg[1] == 'o') {
                    isOption = true;
                    argIdx = argIdx + 1;
                    if (argIdx < args.length) {
                        outputFile = args[argIdx];
                        outputSet = true;
                    }
                }
                if (arg[1] == '?') {
                    showHelp = true;
                    isOption = true;
                }
            }
            if (arg[0] == '/') {
                if (arg[1] == '?') {
                    showHelp = true;
                    isOption = true;
                }
            }
        }
        if (arg.length == 5) {
            if (arg[0] == '-') {
                if (arg[1] == 'h') {
                    if (arg[2] == 'e') {
                        if (arg[3] == 'l') {
                            if (arg[4] == 'p') {
                                showHelp = true;
                                isOption = true;
                            }
                        }
                    }
                }
            }
        }
        if (arg.length == 6) {
            if (arg[0] == '-') {
                if (arg[1] == '-') {
                    if (arg[2] == 'h') {
                        if (arg[3] == 'e') {
                            if (arg[4] == 'l') {
                                if (arg[5] == 'p') {
                                    showHelp = true;
                                    isOption = true;
                                }
                            }
                        }
                    }
                }
            }
        }
        if (arg.length == 9) {
            if (arg[0] == '-') {
                if (arg[1] == '-') {
                    if (arg[2] == 'v') {
                        if (arg[3] == 'e') {
                            if (arg[4] == 'r') {
                                if (arg[5] == 's') {
                                    if (arg[6] == 'i') {
                                        if (arg[7] == 'o') {
                                            if (arg[8] == 'n') {
                                                showVersion = true;
                                                isOption = true;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if (isOption == false) {
            if (inputSet == false) {
                inputFile = arg;
                inputSet = true;
            } else {
                if (outputSet == false) {
                    outputFile = arg;
                    outputSet = true;
                }
            }
        }
        argIdx = argIdx + 1;
    }

    bool skipCompile = false;
    if (showVersion) {
        printline("Silver Compiler v0.3.0");
        printline("Language: Silver");
        printline("Version:  0.3.0");
        printline("Copyright: © 2025 Edan M.");
        printline("Run with --help for usage information.");
        skipCompile = true;
    }

    if (args.length <= 1) {
        printHelp();
        skipCompile = true;
    } elif (showHelp) {
        printHelp();
        skipCompile = true;
    }

    if (inputFile == "") {
        inputFile = "compiler_driver.sr";
    }
    if (outputFile == "") {
        outputFile = "silverc";
    }

    // Compute the exact project suffix once. Keeping this decision in one
    // boolean avoids duplicated string-index lowering in self-generated stages.
    bool inputIsProject = false;
    if (!skipCompile) {
        inputIsProject = projectHasSuffix(inputFile, ".srp");
        if (inputIsProject) {
            string manifest = file.readString(inputFile);
            if (!outputSet) {
                string projectOutput = projectManifestValue(manifest, "output");
                if (!cliArgEq(projectOutput, "")) { outputFile = projectOutput; }
            }
        }
    }

    if (skipCompile) {
        // Do nothing else; fall through to the ExitProcess at the end.
    } else {
    string source = file.readString(inputFile);
    if (inputIsProject) {
        source = projectBuildSource(inputFile);
    } else {
        // The universal llmai client is a source-level standard library. Keep
        // the low-level WinInet builtin available, but include the shared
        // wrapper when a standalone source imports llmai. The test runner
        // invokes the compiler from tests/, so ../std is the stable library
        // location for both self-hosting and top-level suites.
        int llmaiImport = projectFind(source, "from llmai", 0);
        if (llmaiImport < 0) { llmaiImport = projectFind(source, "from LLMAI", 0); }
        if (llmaiImport >= 0) {
            // Load the wrapper by content instead of probing with
            // file.exists(): the self-hosted exists lowering is not reliable
            // for paths containing `..` on every bootstrap stage. Try paths
            // relative to the process cwd and the test-suite directories.
            string llmaiSource = file.readString("std\\llmai.sr");
            if (llmaiSource.length == 0) {
                llmaiSource = file.readString("silverc\\std\\llmai.sr");
            }
            if (llmaiSource.length == 0) {
                llmaiSource = file.readString("..\\std\\llmai.sr");
            }
            if (llmaiSource.length == 0) {
                llmaiSource = file.readString("..\\silverc\\std\\llmai.sr");
            }
            if (llmaiSource.length == 0) {
                llmaiSource = file.readString("..\\..\\std\\llmai.sr");
            }
            source = llmaiSource + "\\n" + source;
        }
    }

    Lexer lexer;
    lexer = new Lexer(source);

    Token[] tokens;
    tokens = lexer.tokenize();

    Parser parser;
    parser = new Parser(tokens);

    Node[] ast;
    ast = parser.parseProgram();

    MiniAsm asm;
    asm = new MiniAsm();

    MiniCg cg;
    cg = new MiniCg(asm);

    cg.genProgram(ast);

    cg.getStringData();

    MiniPe pe;
    pe = new MiniPe();

    int entryOff = cg.mainLabelOffset;
    if (cg.globalNames.length > 0) { entryOff = cg.entryOffset; }
    pe.entryRva = 0x1000 + entryOff;

    for (int i = 0; i < cg.importDlls.length; i++) {
        pe.addImport(cg.importDlls[i], cg.importFuncs[i]);
    }

    int[] stringData = cg.stringData;

    int[] finalCode = asm.getBytes();
    pe.code = finalCode;

        int rdataRva = pe.computeRdataRva();
        int[] layout = pe.computeLayout(stringData.length);
        int stringsStart = layout[0];
        int[] iatAddrs = cg.computeIatAddresses(layout);

    cg.patchForwardCalls(finalCode);

    cg.patchStringRefs(finalCode, stringsStart, rdataRva);
    cg.patchImportRefs(finalCode, iatAddrs, rdataRva);
    cg.patchGlobalRefs(finalCode, stringsStart + stringData.length, rdataRva);

    string[] viKeys = [];
    string[] viValues = [];
    if (inputIsProject) {
        string manifest2 = file.readString(inputFile);
        string viName = projectManifestValue(manifest2, "name");
        string viVers = projectManifestValue(manifest2, "version");
        string viDesc = projectManifestValue(manifest2, "description");
        string viProd = projectManifestValue(manifest2, "product");
        string viCopy = projectManifestValue(manifest2, "copyright");
        string viComp = projectManifestValue(manifest2, "company");
        if (viName != "")   { viKeys.add("FileDescription");  viValues.add(viName); }
        if (viProd != "")  { viKeys.add("ProductName");      viValues.add(viProd); }
        if (viCopy != "")  { viKeys.add("LegalCopyright");   viValues.add(viCopy); }
        if (viComp != "")  { viKeys.add("CompanyName");      viValues.add(viComp); }
        if (viName != "")  { viKeys.add("InternalName");     viValues.add(viName); }
        if (viName != "")  { viKeys.add("OriginalFilename"); viValues.add(viName + ".exe"); }
        if (viVers != "")  { viKeys.add("FileVersion");      viValues.add(viVers); }
        if (viVers != "")  { viKeys.add("ProductVersion");   viValues.add(viVers); }
    }
    pe.setVersionInfo(viKeys, viValues);

    pe.globalAreaSize = cg.globalAreaSize;
int[] peData = pe.build(finalCode, stringData);
        file.writeBytes(outputFile, peData);
    }
}

class MiniAsm {
    public prop int[] buf;
    public prop int[] labelPositions;
    public prop int[] relocLabelIds;
    public prop int[] relocOffsets;
    public prop int[] relocIs32;
    public prop int resolved;

    construct () {
        this.buf = [];
        this.labelPositions = [];
        this.relocLabelIds = [];
        this.relocOffsets = [];
        this.relocIs32 = [];
        this.resolved = 0;
    }

    public void emitU8(int b) {
        this.buf.add(b & 0xFF);
    }

    public void emitU16(int v) {
        this.emitU8(v);
        this.emitU8(v >> 8);
    }

    public void emitU32(int v) {
        this.emitU8(v);
        this.emitU8(v >> 8);
        this.emitU8(v >> 16);
        this.emitU8(v >> 24);
    }

    public void emitU64(int64 v) {
        this.emitU32(v & 0xFFFFFFFF);
        this.emitU32((v >> 32) & 0xFFFFFFFF);
    }

    public void emitBytes(int[] data) {
        for (int i = 0; i < data.length; i++) {
            this.emitU8(data[i]);
        }
    }

    public int[] getBytes() {
        this.resolveRelocs();
        return this.buf;
    }

    public void emitImm64(int reg, int64 imm) {
        this.buf.add(0x48);
        this.buf.add(0xB8 + (reg & 7));
        for (int b = 0; b < 8; b++) {
            this.buf.add((imm >> (b * 8)) & 0xFF);
        }
    }

    public void pushR64(int r) {
        int opcode = 0x50 + (r & 7);
        if (r > 7) { this.emitU8(0x41); }
        this.emitU8(opcode);
    }

    public void popR64(int r) {
        if (r > 7) { this.emitU8(0x41); }
        this.emitU8(0x58 + (r & 7));
    }

    public void movRR64(int dst, int src) {
        int rFlag = 0;
        int sFlag = 0;
        if (src > 7) { rFlag = 1; }
        if (dst > 7) { sFlag = 1; }
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x89);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void movRI64(int dst, int64 imm) {
        int dFlag = 0;
        if (dst > 7) { dFlag = 1; }
        this.emitU8(0x48 | dFlag);
        this.emitU8(0xB8 + (dst & 7));
        int lo = imm & 0xFFFFFFFF;
        this.emitU8(lo);
        this.emitU8(lo >> 8);
        this.emitU8(lo >> 16);
        this.emitU8(lo >> 24);
        int hi = (imm >> 32) & 0xFFFFFFFF;
        this.emitU8(hi);
        this.emitU8(hi >> 8);
        this.emitU8(hi >> 16);
        this.emitU8(hi >> 24);
    }

    public void movRMBase(int r, int base, int disp) {
        int rex = 0x48;
        if (r > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x8B);
        if (base == 5 || base == 13) {
            this.emitU8(0x85 | ((r & 7) << 3) | (base & 7));
            this.emitU32(disp);
        } elif (base == 4 || base == 12) {
            if (disp >= -128 && disp <= 127) {
                this.emitU8(0x44 | ((r & 7) << 3));
                this.emitU8(0x24);
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x84 | ((r & 7) << 3));
                this.emitU8(0x24);
                this.emitU32(disp);
            }
        } else {
            if (disp == 0 && base != 5 && base != 13) {
                this.emitU8(((r & 7) << 3) | (base & 7));
            } elif (disp >= -128 && disp <= 127) {
                this.emitU8(0x40 | ((r & 7) << 3) | (base & 7));
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x80 | ((r & 7) << 3) | (base & 7));
                this.emitU32(disp);
            }
        }
    }

    public void movMBaseR(int base, int r, int disp) {
        int rex = 0x48;
        if (r > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x89);
        if (base == 5 || base == 13) {
            this.emitU8(0x85 | ((r & 7) << 3) | (base & 7));
            this.emitU32(disp);
        } elif (base == 4 || base == 12) {
            if (disp >= -128 && disp <= 127) {
                this.emitU8(0x44 | ((r & 7) << 3));
                this.emitU8(0x24);
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x84 | ((r & 7) << 3));
                this.emitU8(0x24);
                this.emitU32(disp);
            }
        } else {
            if (disp == 0 && base != 5 && base != 13) {
                this.emitU8(((r & 7) << 3) | (base & 7));
            } elif (disp >= -128 && disp <= 127) {
                this.emitU8(0x40 | ((r & 7) << 3) | (base & 7));
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x80 | ((r & 7) << 3) | (base & 7));
                this.emitU32(disp);
            }
        }
    }

    public void movMBaseByteR(int base, int r, int disp) {
        int rex = 0x40;
        if (r > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        if (rex != 0x40) {
            this.emitU8(rex);
        }
        this.emitU8(0x88);
        if (base == 5 || base == 13) {
            this.emitU8(0x85 | ((r & 7) << 3) | (base & 7));
            this.emitU32(disp);
        } elif (base == 4 || base == 12) {
            if (disp >= -128 && disp <= 127) {
                this.emitU8(0x44 | ((r & 7) << 3));
                this.emitU8(0x24);
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x84 | ((r & 7) << 3));
                this.emitU8(0x24);
                this.emitU32(disp);
            }
        } else {
            if (disp == 0 && base != 5 && base != 13) {
                this.emitU8(((r & 7) << 3) | (base & 7));
            } elif (disp >= -128 && disp <= 127) {
                this.emitU8(0x40 | ((r & 7) << 3) | (base & 7));
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x80 | ((r & 7) << 3) | (base & 7));
                this.emitU32(disp);
            }
        }
    }

    public void subRI32(int r, int imm) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        if (imm >= -128 && imm <= 127) {
            this.emitU8(0x83);
            this.emitU8(0xE8 | (r & 7));
            this.emitU8(imm & 0xFF);
        } else {
            this.emitU8(0x81);
            this.emitU8(0xE8 | (r & 7));
            this.emitU32(imm);
        }
    }

    public void addRI32(int r, int imm) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        if (imm >= -128 && imm <= 127) {
            this.emitU8(0x83);
            this.emitU8(0xC0 | (r & 7));
            this.emitU8(imm & 0xFF);
        } else {
            this.emitU8(0x81);
            this.emitU8(0xC0 | (r & 7));
            this.emitU32(imm);
        }
    }

    public void xorRR64(int dst, int src) {
        int rFlag = 0;
        int sFlag = 0;
        if (src > 7) { rFlag = 1; }
        if (dst > 7) { sFlag = 1; }
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x31);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void andRImm(int r, int imm) {
        int rFlag = 0;
        if (r > 7) { rFlag = 1; }
        this.emitU8(0x48 | rFlag);
        if (imm >= -128 && imm <= 127) {
            this.emitU8(0x83);
            this.emitU8(0xE0 | (r & 7));
            this.emitU8(imm & 0xFF);
        } else {
            this.emitU8(0x81);
            this.emitU8(0xE0 | (r & 7));
            this.emitU32(imm);
        }
    }

    public void emitCallSetup(int extraBytes) {
        this.pushR64(13);
        this.movRR64(13, 4);
        this.andRImm(4, -16);
        int total = 32 + extraBytes;
        int alignedTotal = ((total + 15) / 16) * 16;
        this.subRI32(4, alignedTotal);
    }

    public void emitCallTeardown() {
        this.movRR64(4, 13);
        this.popR64(13);
    }

    public void cmpRI32(int r, int imm) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        if (imm >= -128 && imm <= 127) {
            this.emitU8(0x83);
            this.emitU8(0xF8 | (r & 7));
            this.emitU8(imm & 0xFF);
        } else {
            this.emitU8(0x81);
            this.emitU8(0xF8 | (r & 7));
            this.emitU32(imm);
        }
    }

    public void cmpRR64(int r1, int r2) {
        int rex = 0x48;
        if (r2 > 7) { rex = rex + 4; }
        if (r1 > 7) { rex = rex + 1; }
        this.emitU8(rex);
        this.emitU8(0x39);
        this.emitU8(0xC0 | ((r2 & 7) << 3) | (r1 & 7));
    }

    public void ret() {
        this.emitU8(0xC3);
    }

    public void callR64(int r) {
        if (r > 7) { this.emitU8(0x41); }
        this.emitU8(0xFF);
        this.emitU8(0xD0 | (r & 7));
    }

    public void leaRBase(int dst, int base, int disp) {
        int rex = 0x48;
        if (dst > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x8D);
        if (base == 4 || base == 12) {
            this.emitU8(0x80 | ((dst & 7) << 3) | 0x04);
            this.emitU8(0x24);
            this.emitU32(disp);
        } elif (base == 5 || base == 13) {
            this.emitU8(0x85 | ((dst & 7) << 3) | (base & 7));
            this.emitU32(disp);
        } else {
            if (disp == 0) {
                this.emitU8(((dst & 7) << 3) | (base & 7));
            } elif (disp >= -128 && disp <= 127) {
                this.emitU8(0x40 | ((dst & 7) << 3) | (base & 7));
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x80 | ((dst & 7) << 3) | (base & 7));
                this.emitU32(disp);
            }
        }
    }

    public void addRR64(int dst, int src) {
        int rFlag = 0;
        int sFlag = 0;
        if (src > 7) { rFlag = 1; }
        if (dst > 7) { sFlag = 1; }
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x01);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void shlR64Imm(int reg, int imm) {
        // reg is encoded in the ModRM.rm field, so reg 8-15 needs REX.B (bit 0).
        // (REX.R would be wrong here; that extends the /4 opcode-extension field.)
        int rFlag = 0;
        if (reg > 7) { rFlag = 1; }
        this.emitU8(0x48 | rFlag);
        this.emitU8(0xC1);
        this.emitU8(0xE0 | (reg & 7));
        this.emitU8(imm & 0xFF);
    }

    public void movByteMBaseIdxR(int base, int index, int src) {
        int rb = 0;
        int ri = 0;
        int rs = 0;
        if (base > 7) { rb = 1; }
        if (index > 7) { ri = 1; }
        if (src > 7) { rs = 1; }
        int rex = 0x40 | (rs << 2) | (ri << 1) | rb;
        this.emitU8(rex);
        this.emitU8(0x88);
        if (base == 5 || base == 13) {
            this.emitU8(0x44 | ((src & 7) << 3));
            this.emitU8(((index & 7) << 3) | (base & 7));
            this.emitU8(0);
        } else {
            this.emitU8(0x04 | ((src & 7) << 3));
            this.emitU8(((index & 7) << 3) | (base & 7));
        }
    }

    public void movRImm32(int dst, int imm) {
        if (dst > 7) { this.emitU8(0x41); }
        this.emitU8(0xB8 + (dst & 7));
        this.emitU32(imm);
    }

    public void movRMBaseDisp8(int r, int base, int disp) {
        int rex = 0x48;
        if (r > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x8B);
        this.emitU8(0x40 | ((r & 7) << 3) | (base & 7));
        this.emitU8(disp & 0xFF);
    }

    public void orRR64(int dst, int src) {
        int rFlag = 0;
        int sFlag = 0;
        if (src > 7) { rFlag = 1; }
        if (dst > 7) { sFlag = 1; }
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x09);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void andRR64(int dst, int src) {
        int rFlag = 0;
        int sFlag = 0;
        if (src > 7) { rFlag = 1; }
        if (dst > 7) { sFlag = 1; }
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x21);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void imulRR64(int dst, int src) {
        int rFlag = 0;
        int sFlag = 0;
        if (src > 7) { rFlag = 1; }
        if (dst > 7) { sFlag = 1; }
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x0F);
        this.emitU8(0xAF);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void syscall() {
        this.emitU8(0x0F);
        this.emitU8(0x05);
    }

    public void cdq() {
        this.emitU8(0x99);
    }

    public void cqo() {
        this.emitU8(0x48);
        this.emitU8(0x99);
    }

    public void idivR64(int r) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        this.emitU8(0xF7);
        this.emitU8(0xF8 | (r & 7));
    }

    public void negR64(int r) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        this.emitU8(0xF7);
        this.emitU8(0xD8 | (r & 7));
    }

    public void incR64(int r) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        this.emitU8(0xFF);
        this.emitU8(0xC0 | (r & 7));
    }

    public void decR64(int r) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        this.emitU8(0xFF);
        this.emitU8(0xC8 | (r & 7));
    }

    public void shlRCl64(int r) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        this.emitU8(0xD3);
        this.emitU8(0xE0 | (r & 7));
    }

    public void shrRCl64(int r) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        this.emitU8(0xD3);
        this.emitU8(0xE8 | (r & 7));
    }

    public void movzxRR64(int dst, int src) {
        int rex = 0x48;
        if (dst > 7) { rex = rex | 0x04; }
        if (src > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x0F);
        this.emitU8(0xB6);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void movzxByteMBase(int r, int base, int disp) {
        int rex = 0;
        if (r > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        if (rex != 0) { this.emitU8(0x40 | rex); }
        this.emitU8(0x0F);
        this.emitU8(0xB6);
        if (base == 5 || base == 13) {
            this.emitU8(0x80 | ((r & 7) << 3) | (base & 7));
            this.emitU32(disp);
        } elif (base == 4 || base == 12) {
            if (disp >= -128 && disp <= 127) {
                this.emitU8(0x44 | ((r & 7) << 3));
                this.emitU8(0x24);
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x84 | ((r & 7) << 3));
                this.emitU8(0x24);
                this.emitU32(disp);
            }
        } else {
            if (disp == 0) {
                this.emitU8(((r & 7) << 3) | (base & 7));
            } elif (disp >= -128 && disp <= 127) {
                this.emitU8(0x40 | ((r & 7) << 3) | (base & 7));
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x80 | ((r & 7) << 3) | (base & 7));
                this.emitU32(disp);
            }
        }
    }

    public void setCC64(int cc, int r) {
        this.emitU8(0x0F);
        if (cc == 0) { this.emitU8(0x94); }
        elif (cc == 1) { this.emitU8(0x95); }
        elif (cc == 2) { this.emitU8(0x9C); }
        elif (cc == 3) { this.emitU8(0x9D); }
        elif (cc == 4) { this.emitU8(0x9E); }
        elif (cc == 5) { this.emitU8(0x9F); }
        this.emitU8(0xC0 | (r & 7));
    }

    public void jmpR64(int r) {
        if (r > 7) { this.emitU8(0x41); }
        this.emitU8(0xFF);
        this.emitU8(0xE0 | (r & 7));
    }

    public void movRMBaseIdx64(int r, int base, int idx, int scale, int disp) {
        int rex = 0x48;
        if (r > 7) { rex = rex | 0x04; }
        if (idx > 7) { rex = rex | 0x02; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x8B);
        this.emitU8(0x84 | ((r & 7) << 3) | 0x04);
        this.emitU8((scale << 6) | ((idx & 7) << 3) | (base & 7));
        this.emitU32(disp);
    }

    public void movMBaseIdxR64(int base, int idx, int scale, int r, int disp) {
        int rex = 0x48;
        if (r > 7) { rex = rex | 0x04; }
        if (idx > 7) { rex = rex | 0x02; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x89);
        this.emitU8(0x84 | ((r & 7) << 3) | 0x04);
        this.emitU8((scale << 6) | ((idx & 7) << 3) | (base & 7));
        this.emitU32(disp);
    }

    public void nop() {
        this.emitU8(0x90);
    }

    public void int3() {
        this.emitU8(0xCC);
    }

    public void emitPrologue(int stackSize) {
        this.pushR64(5);
        this.movRR64(5, 4);
        if (stackSize > 0) {
            this.subRI32(4, stackSize);
        }
    }

    public void emitEpilogue(int stackSize) {
        if (stackSize > 0) {
            this.addRI32(4, stackSize);
        }
        this.popR64(5);
        this.ret();
    }

    public void subRR64(int dst, int src) {
        int rFlag = 0;
        int sFlag = 0;
        if (src > 7) { rFlag = 1; }
        if (dst > 7) { sFlag = 1; }
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x29);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void mulRR64(int src) {
        int sFlag = 0;
        if (src > 7) { sFlag = 1; }
        if (sFlag != 0) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        this.emitU8(0xF7);
        this.emitU8(0xE0 | (src & 7));
    }

    public void label(string name) {
    }

    public int createLabel() {
        int id = this.labelPositions.length;
        this.labelPositions.add(-1);
        return id;
    }

    public void bindLabel(int id) {
        this.labelPositions[id] = this.buf.length;
    }

    public int getLabelOffset(int id) {
        if (id < this.labelPositions.length && this.labelPositions[id] >= 0) {
            return this.labelPositions[id];
        }
        return 0;
    }

    public void addReloc(int labelId, int offset, int is32) {
        this.relocLabelIds.add(labelId);
        this.relocOffsets.add(offset);
        this.relocIs32.add(is32);
    }

    public void jeLabel(int id) {
        this.emitU8(0x0F);
        this.emitU8(0x84);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void jneLabel(int id) {
        this.emitU8(0x0F);
        this.emitU8(0x85);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void jmpLabel(int id) {
        this.emitU8(0xE9);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void jlLabel(int id) {
        this.emitU8(0x0F);
        this.emitU8(0x8C);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void jleLabel(int id) {
        this.emitU8(0x0F);
        this.emitU8(0x8E);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void jgLabel(int id) {
        this.emitU8(0x0F);
        this.emitU8(0x8F);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void jgeLabel(int id) {
        this.emitU8(0x0F);
        this.emitU8(0x8D);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void resolveRelocs() {
        if (this.resolved == 1) { return; }
        this.resolved = 1;
        for (int i = 0; i < this.relocLabelIds.length; i++) {
            int labelId = this.relocLabelIds[i];
            int offset = this.relocOffsets[i];
            int is32 = this.relocIs32[i];
            int target = this.labelPositions[labelId];
            if (is32 == 1) {
                int cur = offset + 4;
                int disp = target - cur;
                this.buf[offset] = disp & 0xFF;
                this.buf[offset + 1] = (disp >> 8) & 0xFF;
                this.buf[offset + 2] = (disp >> 16) & 0xFF;
                this.buf[offset + 3] = (disp >> 24) & 0xFF;
            } else {
                int cur = offset + 1;
                int disp = target - cur;
                this.buf[offset] = disp & 0xFF;
            }
        }
    }

    public void resolveRelocations() {
        this.resolveRelocs();
    }

    public void callRel32(int rel32) {
        this.emitU8(0xE8);
        this.emitU32(rel32);
    }
}

class StrEntry {
    public prop string text;
    public prop int dataOffset;

    construct (string text) {
        this.text = text;
        this.dataOffset = 0;
    }
}

class MiniCg {
    public prop MiniAsm asm;
    public prop StrEntry[] strings;
    public prop int[] stringData;
    public prop int mainLabelOffset;
    public prop string[] funcNames;
    public prop string[] funcClasses;
    public prop string[] constNames;
    public prop int[] constValues;
    public prop string[] constStringValues;
    public prop int[] constIsString;
    public prop string[] funcRetTypes;
    public prop int[] funcOffsets;
    public prop int[] funcParamStarts;
    public prop int[] funcParamCounts;
    public prop int[] funcParamHasDefaults;
    public prop Node[] funcParamDefaults;
    public prop string[] funcParamTypes;
    public prop int[] localOffsets;
    public prop string[] localNames;
    public prop int stackSize;
    public prop int[] stringPatchOffsets;
    public prop int[] stringPatchIndices;
    public prop int[] importPatchOffsets;
    public prop int[] importPatchDllIndices;
    public prop int[] importPatchFuncIndices;
    public prop string[] importDlls;
    public prop string[] importFuncs;
    // DOCS/213 -- win32 module grants. win32Dlls lists DLLs opened in full
    // via `import * from win32.<mod>;` / `import <mod> from win32;`.
    // win32Grants lists single exports as "dll|name" entries granted via
    // `import Name from win32.<mod>;`.
    public prop string[] win32Dlls;
    public prop string[] win32Grants;
    public prop int[] loopStartStack;
    public prop int[] loopEndStack;
    public prop int[] loopContinueStack;
    public prop int labelCounter;
    public prop int[] stringOffsets;
    // Retained for self-hosting object-layout compatibility.  Member-call
    // code uses scratchBaseOffset directly, but preserving this field and its
    // reserved entries keeps MiniCg's generated layout stable across stages.
    public prop int[] funcCallArgTemps;
    public prop int scratchBaseOffset;
    public prop int funcCallArgCount;
    public prop int retValOff;
    public prop string[] classNames;
    public prop string[] classParentClasses;
    public prop string[] enumNames;
    public prop int[] classFieldStarts;
    public prop int[] classFieldCounts;
    public prop string[] classFieldNames;
    public prop int[] classFieldOffsets;
    public prop string[] classFieldTypes;
    public prop string[] methodClassNames;
    public prop string[] methodNames;
    public prop string currentClassName;
    public prop string currentFunctionName;
    public prop bool dynamicAsmActive;
    public prop string[] localTypes;
    public prop int[] forwardCalls;
    public prop string[] forwardCallNames;
    public prop string[] forwardCallClasses;
    public prop int currentReturnLabel;
    public prop bool currentIsMain;
    public prop bool hasMain;
    public prop string[] globalNames;
    public prop string[] globalTypes;
    public prop int[] globalOffsets;
    public prop Node[] globalInits;
    public prop int[] globalPatchOffsets;
    public prop int[] globalPatchIndices;
    public prop int globalAreaSize;
    public prop int entryOffset;

    construct (MiniAsm asm) {
        this.asm = asm;
        this.strings = [];
        this.stringData = [];
        this.mainLabelOffset = 0;
        this.funcNames = [];
        this.funcClasses = [];
        this.constNames = [];
        this.constValues = [];
        this.constStringValues = [];
        this.constIsString = [];
        this.funcRetTypes = [];
        this.funcOffsets = [];
        this.funcParamStarts = [];
        this.funcParamCounts = [];
        this.funcParamHasDefaults = [];
        this.funcParamDefaults = [];
        this.funcParamTypes = [];
        this.localOffsets = [];
        this.localNames = [];
        this.stackSize = 0;
        this.stringPatchOffsets = [];
        this.stringPatchIndices = [];
        this.importPatchOffsets = [];
        this.importPatchDllIndices = [];
        this.importPatchFuncIndices = [];
        this.importDlls = [];
        this.importFuncs = [];
        this.win32Dlls = [];
        this.win32Grants = [];
        this.loopStartStack = [];
        this.loopEndStack = [];
        this.loopContinueStack = [];
        this.labelCounter = 0;
        this.stringOffsets = [];
        this.funcCallArgTemps = [];
        this.funcCallArgCount = 0;
        this.retValOff = 0;
        this.classNames = [];
        this.classParentClasses = [];
        this.enumNames = [];
        this.classFieldStarts = [];
        this.classFieldCounts = [];
        this.classFieldNames = [];
        this.classFieldOffsets = [];
        this.classFieldTypes = [];
        this.methodClassNames = [];
        this.methodNames = [];
        this.currentClassName = "";
        this.currentFunctionName = "";
        this.dynamicAsmActive = false;
        this.hasMain = false;
        this.localTypes = [];
        this.forwardCalls = [];
        this.forwardCallNames = [];
        this.forwardCallClasses = [];
        this.globalNames = [];
        this.globalTypes = [];
        this.globalOffsets = [];
        this.globalInits = [];
        this.globalPatchOffsets = [];
        this.globalPatchIndices = [];
        this.globalAreaSize = 0;
        this.entryOffset = 0;
    }

    public void collectClassLayouts(Node[] program) {
        // First pass: collect all class names so parent references work
        for (int i = 0; i < program.length; i++) {
            Node item = program[i];
            if (item.kind == 102) {
                this.classNames.add(item.name);
                this.classParentClasses.add(item.parentClass);
                this.classFieldStarts.add(0);
                this.classFieldCounts.add(0);
            }
        }
        // Second pass: collect fields and methods with inheritance
        int classIdx = 0;
        for (int i = 0; i < program.length; i++) {
            Node item = program[i];
            if (item.kind == 102) {
                int start = this.classFieldNames.length;
                int cnt = 0;
                if (!this.strEq(item.parentClass, "")) {
                    int parentIdx = -1;
                    for (int pi = 0; pi < this.classNames.length; pi++) {
                        if (this.strEq(this.classNames[pi], item.parentClass)) {
                            parentIdx = pi;
                        }
                    }
                    if (parentIdx >= 0) {
                        int pStart = this.classFieldStarts[parentIdx];
                        int pCnt = this.classFieldCounts[parentIdx];
                        for (int pj = 0; pj < pCnt; pj++) {
                            this.classFieldNames.add(this.classFieldNames[pStart + pj]);
                            this.classFieldOffsets.add(cnt * 8);
                            this.classFieldTypes.add(this.classFieldTypes[pStart + pj]);
                            cnt = cnt + 1;
                        }
                    }
                }
                for (int j = 0; j < item.childCount(); j++) {
                    Node member = item.child(j);
                    if (member.kind == 50) {
                        this.classFieldNames.add(member.name);
                        this.classFieldOffsets.add(cnt * 8);
                        this.classFieldTypes.add(member.typeHint);
                        cnt = cnt + 1;
                    }
                }
                this.classFieldStarts[classIdx] = start;
                this.classFieldCounts[classIdx] = cnt;
                for (int j = 0; j < item.childCount(); j++) {
                    Node member = item.child(j);
                    if (member.kind == 100) {
                        this.methodNames.add(member.name);
                        this.methodClassNames.add(item.name);
                    }
                }
                if (!this.strEq(item.parentClass, "")) {
                    int parentIdx = -1;
                    for (int pi = 0; pi < this.classNames.length; pi++) {
                        if (this.strEq(this.classNames[pi], item.parentClass)) {
                            parentIdx = pi;
                        }
                    }
                    if (parentIdx >= 0) {
                        int savedLen = this.methodNames.length;
                        for (int mi = 0; mi < savedLen; mi++) {
                            if (this.strEq(this.methodClassNames[mi], item.parentClass) && !this.strEq(this.methodClassNames[mi], "")) {
                                bool hasOverride = false;
                                for (int mj = 0; mj < this.methodNames.length; mj++) {
                                    if (this.strEq(this.methodClassNames[mj], item.name) && this.strEq(this.methodNames[mj], this.methodNames[mi])) {
                                        hasOverride = true;
                                    }
                                }
                                if (!hasOverride) {
                                    this.methodNames.add(this.methodNames[mi]);
                                    this.methodClassNames.add(item.name);
                                }
                            }
                        }
                    }
                }
                classIdx = classIdx + 1;
            }
        }
    }

    public bool typeNameEq(string bare, string typed) {
        // Class-name comparison that tolerates a nullable suffix: a receiver
        // typed `Node?` resolves to the same class layout as `Node`.
        if (this.strEq(bare, typed)) { return true; }
        if (typed.length == bare.length + 1 && typed[typed.length - 1] == '?') {
            for (int i = 0; i < bare.length; i++) {
                if (typed[i] != bare[i]) { return false; }
            }
            return true;
        }
        return false;
    }

    public bool isDictType(string t) {
        if (t.length >= 4) {
            if (t[0] == 'd' && t[1] == 'i' && t[2] == 'c' && t[3] == 't') { return true; }
        }
        return false;
    }

    public string dictValueType(string t) {
        int len = t.length;
        int i = 5;
        int depth = 1;
        bool inVal = false;
        string result = "";
        while (i < len) {
            if (t[i] == '<') { depth = depth + 1; }
            elif (t[i] == '>') {
                depth = depth - 1;
                if (depth == 0) { return result; }
            } elif (t[i] == ',' && depth == 1) {
                inVal = true;
            } elif (inVal) {
                result = result + t[i];
            }
            i = i + 1;
        }
        return result;
    }

    public string inferReceiverType(Node expr) {
        if (expr.kind == 6) {
            if (this.strEq(expr.name, "this")) { return this.currentClassName; }
            return this.getLocalType(expr.name);
        }
        return this.inferExprType(expr);
    }

    public int findFieldOffset(string className, string fieldName) {
        int start = -1;
        int cnt = 0;
        for (int i = 0; i < this.classNames.length; i++) {
            if (this.typeNameEq(this.classNames[i], className)) {
                start = this.classFieldStarts[i];
                cnt = this.classFieldCounts[i];
            }
        }
        if (start < 0) { return -1; }
        for (int i = 0; i < cnt; i++) {
            if (this.strEq(this.classFieldNames[start + i], fieldName)) {
                return this.classFieldOffsets[start + i];
            }
        }
        return -1;
    }

    public string findFieldType(string className, string fieldName) {
        int start = -1;
        int cnt = 0;
        for (int i = 0; i < this.classNames.length; i++) {
            if (this.typeNameEq(this.classNames[i], className)) {
                start = this.classFieldStarts[i];
                cnt = this.classFieldCounts[i];
            }
        }
        if (start < 0) { return ""; }
        for (int i = 0; i < cnt; i++) {
            if (this.strEq(this.classFieldNames[start + i], fieldName)) {
                return this.classFieldTypes[start + i];
            }
        }
        return "";
    }

    public string getLocalType(string name) {
        for (int i = 0; i < this.localNames.length; i++) {
            if (this.strEq(this.localNames[i], name)) {
                if (i < this.localTypes.length) {
                    return this.localTypes[i];
                }
                return "";
            }
        }
        for (int i = 0; i < this.globalNames.length; i++) {
            if (this.strEq(this.globalNames[i], name)) {
                if (i < this.globalTypes.length) {
                    return this.globalTypes[i];
                }
                return "";
            }
        }
        return "";
    }

    public void setLocalType(string name, string typeName) {
        for (int i = 0; i < this.localNames.length; i++) {
            if (this.strEq(this.localNames[i], name)) {
                while (this.localTypes.length <= i) {
                    this.localTypes.add("");
                }
                this.localTypes[i] = typeName;
                return;
            }
        }
    }

    public string arrayElementType(string arrType) {
        // Element type of a declared array type.  Type names are built as
        // `base + "[]"*n` (see parseVarDecl), so the element type of `T[]` is
        // `T` and the element type of `T[][]` is `T[]`.  Strip exactly ONE
        // trailing `[]` pair; the old scan stopped at the FIRST pair, which
        // collapsed `string[][]` to `string` and made `m[1][0]` infer as a
        // character (byte load) instead of a string pointer.
        if (arrType.length >= 2) {
            int len = arrType.length;
            if (arrType[len - 2] == '[' && arrType[len - 1] == ']') {
                string result = "";
                for (int i = 0; i < len - 2; i = i + 1) {
                    result = result + arrType[i];
                }
                return result;
            }
        }
        return arrType;
    }

    public int newLabel() {
        int id = this.asm.labelPositions.length;
        this.asm.labelPositions.add(-1);
        return id;
    }

    public int addString(string s) {
        for (int i = 0; i < this.strings.length; i++) {
            StrEntry se = this.strings[i];
            if (this.strEq(se.text, s)) {
                return i;
            }
        }
        int off = this.stringData.length;
        for (int i = 0; i < s.length; i++) {
            int ch = s[i];
            this.stringData.add(ch);
        }
        this.stringData.add(0);
        StrEntry e;
        e = new StrEntry(s);
        e.dataOffset = off;
        this.strings.add(e);
        return this.strings.length - 1;
    }

    public int[] getStringData() {
        return this.stringData;
    }

    public int findImport(string dll, string name) {
        for (int i = 0; i < this.importDlls.length; i++) {
            if (this.strEq(this.importDlls[i], dll) && this.strEq(this.importFuncs[i], name)) {
                return i;
            }
        }
        this.importDlls.add(dll);
        this.importFuncs.add(name);
        return this.importDlls.length - 1;
    }

    public int addImportPatch(string dll, string name) {
        int idx = this.findImport(dll, name);
        this.importPatchOffsets.add(this.asm.buf.length + 2);
        this.importPatchDllIndices.add(-1);
        this.importPatchFuncIndices.add(idx);
        return idx;
    }

    public bool strEq(string a, string b) {
        if (a.length != b.length) { return false; }
        for (int i = 0; i < a.length; i++) {
            if (a[i] != b[i]) { return false; }
        }
        return true;
    }

    // ------------------------------------------------------------------
    // DOCS/213 -- win32 module system. Win32 API functions are no longer
    // auto-imported globals: a source must open the owning DLL with an
    // `import ... from win32[.<module>];` statement before calling its
    // exports as free functions.
    // ------------------------------------------------------------------

    // Map a win32 module name (the part after "win32.") to its DLL.
    public string win32ModuleDll(string module) {
        if (this.strEq(module, "kernel32")) { return "kernel32.dll"; }
        if (this.strEq(module, "ws2_32")) { return "ws2_32.dll"; }
        if (this.strEq(module, "winhttp")) { return "winhttp.dll"; }
        if (this.strEq(module, "wininet")) { return "wininet.dll"; }
        if (this.strEq(module, "shell32")) { return "shell32.dll"; }
        if (this.strEq(module, "msvcrt")) { return "msvcrt.dll"; }
        if (this.strEq(module, "user32")) { return "user32.dll"; }
        if (this.strEq(module, "registry") || this.strEq(module, "advapi32")) { return "advapi32.dll"; }
        if (this.strEq(module, "version")) { return "version.dll"; }
        return "";
    }

    // The export table of a supported DLL as a space-separated name list.
    public string win32ExportTable(string dll) {
        if (this.strEq(dll, "kernel32.dll")) { return "CreateFileA ReadFile WriteFile CloseHandle GetFileSize GetFileSizeEx SetFilePointer FlushFileBuffers DeleteFileA MoveFileA CopyFileA GetFileAttributesA SetFileAttributesA CreateDirectoryA RemoveDirectoryA SetCurrentDirectoryA GetCurrentDirectoryA GetFullPathNameA FindFirstFileA FindNextFileA FindClose GetStdHandle SetConsoleTextAttribute GetConsoleScreenBufferInfo SetConsoleCursorPosition GetConsoleMode SetConsoleMode ReadConsoleA WriteConsoleA GetModuleHandleA GetModuleFileNameA LoadLibraryA GetProcAddress Sleep GetTickCount GetTickCount64 GetLastError CreateProcessA CreateProcessW WaitForSingleObject GetExitCodeProcess TerminateProcess OpenProcess GetProcessId CreatePipe GetProcessHeap HeapFree GlobalAlloc GlobalFree VirtualAlloc VirtualFree GetCurrentProcessId GetCurrentProcess GetCurrentThreadId GetCurrentThread GetEnvironmentVariableA GetEnvironmentVariableW SetEnvironmentVariableA SetEnvironmentVariableW ExpandEnvironmentStringsA GetEnvironmentStringsA FreeEnvironmentStringsA GetTempPathA GetComputerNameA GetUserNameA QueryPerformanceCounter QueryPerformanceFrequency GetVersionExA GetSystemDirectoryA GetWindowsDirectoryA GetLocalTime GetSystemTime OutputDebugStringA IsDebuggerPresent GetCommandLineA SetThreadPriority lstrlenA lstrcpyA lstrcatA lstrcmpA"; }
        if (this.strEq(dll, "ws2_32.dll")) { return "WSAStartup WSACleanup socket bind listen accept recv send shutdown closesocket connect select setsockopt ioctlsocket htons inet_addr getaddrinfo freeaddrinfo WSAGetLastError"; }
        if (this.strEq(dll, "winhttp.dll")) { return "WinHttpOpen WinHttpConnect WinHttpOpenRequest WinHttpSendRequest WinHttpReceiveResponse WinHttpQueryHeaders WinHttpQueryDataAvailable WinHttpReadData WinHttpCloseHandle WinHttpSetOption"; }
        if (this.strEq(dll, "wininet.dll")) { return "InternetOpenA InternetConnectA InternetOpenUrlA InternetReadFile InternetReadFileExA InternetCloseHandle HttpSendRequestA HttpSendRequestExA InternetQueryDataAvailable InternetSetOptionA InternetQueryOptionA HttpQueryInfoA InternetWriteFile InternetGetConnectedState InternetCrackUrlA InternetCanonicalizeUrlA InternetSetStatusCallback"; }
        if (this.strEq(dll, "shell32.dll")) { return "ShellExecuteA ShellExecuteW ShellExecuteExA ShellExecuteExW"; }
        if (this.strEq(dll, "msvcrt.dll")) { return "memcpy memset memmove memcmp strlen strcmp strchr strstr strrchr strcpy strcat strncmp strncat strncpy strtok strpbrk strspn strcspn atoi atol strtol malloc free realloc calloc printf fprintf sprintf sscanf fopen fclose fread fwrite fflush fgets fputs fseek ftell system getenv putenv time rand srand abs labs toupper tolower isalpha isdigit isspace isprint isalnum isxdigit isupper islower"; }
        if (this.strEq(dll, "user32.dll")) { return "keybd_event VkKeyScanA GetKeyState GetAsyncKeyState GetKeyboardState SetKeyboardState MapVirtualKeyA SendInput mouse_event GetCursorPos SetCursorPos ClipCursor GetClipCursor GetDoubleClickTime SetDoubleClickTime GetForegroundWindow GetWindowTextA GetWindowThreadProcessId RegisterHotKey UnregisterHotKey MessageBeep RegisterRawInputDevices GetRawInputData GetRawInputDeviceList RegisterClassExA CreateWindowExA ShowWindow UpdateWindow SetWindowTextA DestroyWindow GetMessageA TranslateMessage DispatchMessageA DefWindowProcA PostQuitMessage GetSystemMetrics LoadIconA LoadCursorA LoadImageA SendMessageA"; }
        if (this.strEq(dll, "advapi32.dll")) { return "RegOpenKeyExA RegCreateKeyExA RegQueryValueExA RegSetValueExA RegDeleteValueA RegDeleteKeyA RegEnumKeyExA RegEnumValueA RegQueryInfoKeyA RegCloseKey"; }
        if (this.strEq(dll, "version.dll")) { return "GetFileVersionInfoSizeA GetFileVersionInfoA VerQueryValueA"; }
        return "";
    }

    public bool win32TableHas(string dll, string fn) {
        string table = this.win32ExportTable(dll);
        int i = 0;
        while (i < table.length) {
            while (i < table.length && table[i] == ' ') { i = i + 1; }
            int start = i;
            while (i < table.length && table[i] != ' ') { i = i + 1; }
            if (i > start && this.strEq(fn, projectSlice(table, start, i))) { return true; }
        }
        return false;
    }

    public void win32AddDll(string dll) {
        if (dll.length == 0) { return; }
        for (int i = 0; i < this.win32Dlls.length; i++) {
            if (this.strEq(this.win32Dlls[i], dll)) { return; }
        }
        this.win32Dlls.add(dll);
    }

    public void win32AddGrant(string dll, string fn) {
        if (dll.length == 0 || fn.length == 0) { return; }
        string grant = dll + "|" + fn;
        for (int i = 0; i < this.win32Grants.length; i++) {
            if (this.strEq(this.win32Grants[i], grant)) { return; }
        }
        this.win32Grants.add(grant);
    }

    // True when `fn` may be called as a free function targeting `dll`.
    public bool win32Allowed(string dll, string fn) {
        for (int i = 0; i < this.win32Dlls.length; i++) {
            if (this.strEq(this.win32Dlls[i], dll)) {
                if (this.win32TableHas(dll, fn)) { return true; }
            }
        }
        string grant = dll + "|" + fn;
        for (int i = 0; i < this.win32Grants.length; i++) {
            if (this.strEq(this.win32Grants[i], grant)) { return true; }
        }
        return false;
    }

    // Inverse of win32ModuleDll: first module alias for a DLL.
    public string win32ModuleOf(string dll) {
        if (this.strEq(dll, "kernel32.dll")) { return "kernel32"; }
        if (this.strEq(dll, "ws2_32.dll")) { return "ws2_32"; }
        if (this.strEq(dll, "winhttp.dll")) { return "winhttp"; }
        if (this.strEq(dll, "wininet.dll")) { return "wininet"; }
        if (this.strEq(dll, "shell32.dll")) { return "shell32"; }
        if (this.strEq(dll, "msvcrt.dll")) { return "msvcrt"; }
        if (this.strEq(dll, "user32.dll")) { return "user32"; }
        if (this.strEq(dll, "advapi32.dll")) { return "registry"; }
        if (this.strEq(dll, "version.dll")) { return "version"; }
        return dll;
    }

    // Register one parsed import statement (node.kind == 105 with
    // typeHint/isStatic set by the parser).
    public void registerWin32Import(Node node) {
        string source = node.typeHint;
        bool all = node.isStatic;
        if (!this.strEq(source, "win32") && source.length > 6) {
            string prefix = projectSlice(source, 0, 6);
            if (!this.strEq(prefix, "win32.")) { return; }
        } elif (!this.strEq(source, "win32")) {
            return;
        }
        if (this.strEq(source, "win32")) {
            if (all) {
                this.win32AddDll(this.win32ModuleDll("kernel32"));
                this.win32AddDll(this.win32ModuleDll("ws2_32"));
                this.win32AddDll(this.win32ModuleDll("winhttp"));
                this.win32AddDll(this.win32ModuleDll("wininet"));
                this.win32AddDll(this.win32ModuleDll("shell32"));
                this.win32AddDll(this.win32ModuleDll("msvcrt"));
                this.win32AddDll(this.win32ModuleDll("user32"));
                this.win32AddDll(this.win32ModuleDll("registry"));
                this.win32AddDll(this.win32ModuleDll("version"));
                return;
            }
            this.win32AddDll(this.win32ModuleDll(node.name));
            for (int j = 0; j < node.childCount(); j++) {
                this.win32AddDll(this.win32ModuleDll(node.child(j).name));
            }
            return;
        }
        string module = projectSlice(source, 6, source.length);
        string dll = this.win32ModuleDll(module);
        if (dll.length == 0) { return; }
        if (all) {
            this.win32AddDll(dll);
            return;
        }
        this.win32AddGrant(dll, node.name);
        for (int j = 0; j < node.childCount(); j++) {
            this.win32AddGrant(dll, node.child(j).name);
        }
    }

    public int findLocal(string name) {
        for (int i = 0; i < this.localNames.length; i++) {
            if (this.strEq(this.localNames[i], name)) {
                return this.localOffsets[i];
            }
        }
        return 0;
    }

    public int findGlobal(string name) {
        for (int i = 0; i < this.globalNames.length; i++) {
            if (this.strEq(this.globalNames[i], name)) {
                return i;
            }
        }
        return -1;
    }

    public void genGlobalLoad(int gi) {
        // Load the 8-byte global slot value into RAX.  The slot's absolute
        // address is patched after codegen (see patchGlobalRefs).
        int sp = this.asm.buf.length;
        this.asm.emitImm64(0, 0);
        this.globalPatchOffsets.add(sp + 2);
        this.globalPatchIndices.add(gi);
        this.asm.movRMBase(0, 0, 0);
    }

    public void genGlobalStore(int gi) {
        // Store the value currently in RAX into the global slot.  Mirrors
        // genGlobalLoad but dereferences the patched slot address as a store.
        this.asm.pushR64(0);
        int sp = this.asm.buf.length;
        this.asm.emitImm64(0, 0);
        this.globalPatchOffsets.add(sp + 2);
        this.globalPatchIndices.add(gi);
        this.asm.popR64(1);
        this.asm.movMBaseR(0, 1, 0);
    }

    public void patchGlobalRefs(int[] code, int globalsStart, int rdataRva) {
        for (int i = 0; i < this.globalPatchOffsets.length; i++) {
            int patchPos = this.globalPatchOffsets[i];
            int gi = this.globalPatchIndices[i];
            int64 addr = 0x140000000 + rdataRva + globalsStart + this.globalOffsets[gi];
            code[patchPos] = addr & 0xFF;
            code[patchPos + 1] = (addr >> 8) & 0xFF;
            code[patchPos + 2] = (addr >> 16) & 0xFF;
            code[patchPos + 3] = (addr >> 24) & 0xFF;
            code[patchPos + 4] = (addr >> 32) & 0xFF;
            code[patchPos + 5] = (addr >> 40) & 0xFF;
            code[patchPos + 6] = (addr >> 48) & 0xFF;
            code[patchPos + 7] = (addr >> 56) & 0xFF;
        }
    }

    public int allocLocal(string name) {
        this.stackSize += 8;
        int off = -8 * (this.localOffsets.length + 1);
        this.localOffsets.add(off);
        this.localNames.add(name);
        this.localTypes.add("");
        return off;
    }

    public void emitPrologue() {
        this.asm.pushR64(5);
        this.asm.movRR64(5, 4);
        this.asm.subRI32(4, 32);
        this.asm.pushR64(15);
        this.asm.pushR64(13);
        this.asm.pushR64(12);
        this.asm.movRR64(15, 4);
    }

    public void emitEpilogue() {
        this.asm.popR64(12);
        this.asm.popR64(13);
        this.asm.popR64(15);
        this.asm.addRI32(4, this.stackSize);
        this.asm.popR64(5);
        this.asm.ret();
    }

    public int[] computeIatAddresses(int[] layout) {
        int stringsStart = layout[0];
        int numGroups = layout[1];
        int iltTotal = layout[2];
        int[] iatAddrs = [];
        for (int i = 0; i < this.importDlls.length; i++) {
            iatAddrs.add(0);
        }
        string[] uniqueDlls = [];
        int[] groupSizes = [];
        int[] importGroupIdx = [];
        for (int i = 0; i < this.importDlls.length; i++) {
            int gIdx = -1;
            for (int j = 0; j < uniqueDlls.length; j++) {
                if (this.strEq(uniqueDlls[j], this.importDlls[i])) {
                    gIdx = j;
                    break;
                }
            }
            if (gIdx < 0) {
                uniqueDlls.add(this.importDlls[i]);
                groupSizes.add(0);
                gIdx = uniqueDlls.length - 1;
            }
            groupSizes[gIdx] = groupSizes[gIdx] + 1;
            importGroupIdx.add(gIdx);
        }
        int[] posInGroup = [];
        for (int i = 0; i < this.importDlls.length; i++) {
            posInGroup.add(0);
        }
        int[] runningCount = [];
        for (int g = 0; g < uniqueDlls.length; g++) {
            runningCount.add(0);
        }
        for (int i = 0; i < this.importDlls.length; i++) {
            int g = importGroupIdx[i];
            posInGroup[i] = runningCount[g];
            runningCount[g] = runningCount[g] + 1;
        }
        int[] groupStart = [];
        int runningOff = 0;
        for (int g = 0; g < uniqueDlls.length; g++) {
            groupStart.add(runningOff);
            runningOff = runningOff + groupSizes[g] * 8 + 8;
        }
        int descBytes = (numGroups + 1) * 20;
        for (int i = 0; i < this.importDlls.length; i++) {
            int g = importGroupIdx[i];
            iatAddrs[i] = descBytes + iltTotal + groupStart[g] + posInGroup[i] * 8;
        }
        return iatAddrs;
    }

    public void patchImportRefs(int[] code, int[] iatAddrs, int rdataRva) {
        for (int i = 0; i < this.importPatchOffsets.length; i++) {
            int patchPos = this.importPatchOffsets[i];
            int funcIdx = this.importPatchFuncIndices[i];
            int iatOff = iatAddrs[funcIdx];
            int64 addr = 0x140000000 + rdataRva + iatOff;
            code[patchPos] = addr & 0xFF;
            code[patchPos + 1] = (addr >> 8) & 0xFF;
            code[patchPos + 2] = (addr >> 16) & 0xFF;
            code[patchPos + 3] = (addr >> 24) & 0xFF;
            code[patchPos + 4] = (addr >> 32) & 0xFF;
            code[patchPos + 5] = (addr >> 40) & 0xFF;
            code[patchPos + 6] = (addr >> 48) & 0xFF;
            code[patchPos + 7] = (addr >> 56) & 0xFF;
        }
    }

    public void patchStringRefs(int[] code, int stringsStart, int rdataRva) {
        for (int i = 0; i < this.stringPatchOffsets.length; i++) {
            int patchPos = this.stringPatchOffsets[i];
int strIdx = this.stringPatchIndices[i];
        StrEntry se2 = this.strings[strIdx];
        int dataOff = se2.dataOffset;
            int64 addr = 0x140000000 + rdataRva + stringsStart + dataOff;
            code[patchPos] = addr & 0xFF;
            code[patchPos + 1] = (addr >> 8) & 0xFF;
            code[patchPos + 2] = (addr >> 16) & 0xFF;
            code[patchPos + 3] = (addr >> 24) & 0xFF;
            code[patchPos + 4] = (addr >> 32) & 0xFF;
            code[patchPos + 5] = (addr >> 40) & 0xFF;
            code[patchPos + 6] = (addr >> 48) & 0xFF;
            code[patchPos + 7] = (addr >> 56) & 0xFF;
        }
    }

    public void genProgram(Node[] program) {
        this.collectClassLayouts(program);
        for (int i = 0; i < program.length; i++) {
            Node pi = program[i];
            if (pi.kind == 104) {
                this.constNames.add(pi.name);
                if (pi.childCount() > 0 && pi.child(0).kind == 0) {
                    this.constValues.add(pi.child(0).intVal);
                    this.constStringValues.add("");
                    this.constIsString.add(0);
                } elif (pi.childCount() > 0 && pi.child(0).kind == 2) {
                    this.constValues.add(0);
                    this.constStringValues.add(pi.child(0).strVal);
                    this.constIsString.add(1);
                } else {
                    this.constValues.add(0);
                    this.constStringValues.add("");
                    this.constIsString.add(0);
                }
            }
            if (pi.kind == 105 && (pi.typeHint.length > 0 || pi.isStatic)) {
                // DOCS/213 -- import statement (win32 module grants or a
                // no-op source-module marker). Registered, not treated as an
                // enum.
                this.registerWin32Import(pi);
            } elif (pi.kind == 105) {
                this.enumNames.add(pi.name);
                for (int j = 0; j < pi.childCount(); j++) {
                    Node member = pi.child(j);
                    string fullName = pi.name + "." + member.name;
                    this.constNames.add(fullName);
                    this.constValues.add(member.intVal);
                    this.constStringValues.add("");
                    this.constIsString.add(0);
                }
            }
        }
        for (int i = 0; i < program.length; i++) {
            Node pg = program[i];
            if (pg.kind == 50) {
                this.globalNames.add(pg.name);
                this.globalTypes.add(pg.typeHint);
                this.globalOffsets.add(this.globalOffsets.length * 8);
                if (pg.childCount() > 0) {
                    this.globalInits.add(pg.child(0));
                } else {
                    Node missing = new Node(); missing.kind = 255;
                    this.globalInits.add(missing);
                }
            }
        }
        if (this.globalNames.length > 0) {
            this.globalAreaSize = this.globalNames.length * 8;
        }
        for (int i = 0; i < program.length; i++) {
            Node pi = program[i];
            if (pi.kind == 100) {
                this.funcNames.add(pi.name);
                this.funcClasses.add("");
                this.funcRetTypes.add(pi.typeHint);
                this.funcOffsets.add(-1);
                int paramStart = this.funcParamDefaults.length;
                int paramCount = 0;
                if (pi.childCount() > 0) {
                    Node params = pi.child(0);
                    paramCount = params.childCount();
                    for (int p = 0; p < params.childCount(); p++) {
                        Node param = params.child(p);
                        this.funcParamTypes.add(param.typeHint);
                        if (param.childCount() > 0) {
                            this.funcParamHasDefaults.add(1);
                            this.funcParamDefaults.add(param.child(0));
                        } else {
                            Node missing = new Node(); missing.kind = 255;
                            this.funcParamHasDefaults.add(0);
                            this.funcParamDefaults.add(missing);
                        }
                    }
                }
                this.funcParamStarts.add(paramStart);
                this.funcParamCounts.add(paramCount);
            }
        }
        for (int i = 0; i < program.length; i++) {
            Node pi2 = program[i];
            if (pi2.kind == 102) {
                for (int j = 0; j < pi2.childCount(); j++) {
                    Node member = pi2.child(j);
                    if (member.kind == 100) {
                        this.funcNames.add(member.name);
                        this.funcClasses.add(pi2.name);
                        this.funcRetTypes.add(member.typeHint);
                        this.funcOffsets.add(-1);
                        int paramStart = this.funcParamDefaults.length;
                        int paramCount = 0;
                        if (member.childCount() > 0) {
                            Node params = member.child(0);
                            paramCount = params.childCount();
                            for (int p = 0; p < params.childCount(); p++) {
                                Node param = params.child(p);
                                this.funcParamTypes.add(param.typeHint);
                                if (param.childCount() > 0) {
                                    this.funcParamHasDefaults.add(1);
                                    this.funcParamDefaults.add(param.child(0));
                                } else {
                                    Node missing = new Node(); missing.kind = 255;
                                    this.funcParamHasDefaults.add(0);
                                    this.funcParamDefaults.add(missing);
                                }
                            }
                        }
                        this.funcParamStarts.add(paramStart);
                        this.funcParamCounts.add(paramCount);
                    }
                }
            }
        }
        for (int i = 0; i < program.length; i++) {
            Node pi3 = program[i];
            if (pi3.kind == 100) {
                this.emitFunction(pi3);
            }
        }
        for (int i = 0; i < program.length; i++) {
            Node pi4 = program[i];
            if (pi4.kind == 102) {
                for (int j = 0; j < pi4.childCount(); j++) {
                    Node member = pi4.child(j);
                    if (member.kind == 100) {
                        this.emitMethod(member, pi4.name);
                    }
                }
            }
        }
        if (this.globalNames.length > 0) {
            this.emitGlobalInitStub();
        }
        if (this.hasMain == false) {
            // Sources without a main function still produce a valid
            // executable: synthesize an entry that exits with status 0.
            this.mainLabelOffset = this.asm.buf.length;
            this.asm.xorRR64(0, 0);
            this.asm.movRR64(1, 0);
            this.addImportPatch("kernel32.dll", "ExitProcess");
            int sSyn = 0xDEADBEEFCAFEBABE;
            this.asm.emitImm64(0, sSyn);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
        }
    }

    public void emitGlobalInitStub() {
        // Emitted at the end of .text when the program declares globals.  The
        // synthesized __init_globals() function runs every global initializer
        // through the ordinary assignment machinery (so heap allocations and
        // string constants work exactly as they do inside main), then the
        // entry stub calls main() and exits with its status.  The entry point
        // is the stub call sequence below, so entryOffset is recorded after
        // the init function's body has been emitted.
        Node initFunc = new Node();
        initFunc.kind = 100;
        initFunc.name = "__init_globals";
        initFunc.typeHint = "void";
        Node params = new Node();
        params.kind = 61;
        Node body = new Node();
        body.kind = 16;
        for (int gi = 0; gi < this.globalNames.length; gi++) {
            Node initExpr = this.globalInits[gi];
            if (initExpr.kind == 255) {
                string gt = this.globalTypes[gi];
                if (gt.length >= 2 && gt[gt.length - 2] == '[' && gt[gt.length - 1] == ']') {
                    initExpr = new Node(); initExpr.kind = 19;
                } else {
                    initExpr = new Node(); initExpr.kind = 0; initExpr.intVal = 0;
                }
            }
            Node assign = new Node();
            assign.kind = 7;
            assign.op = 20;
            Node lhs = new Node();
            lhs.kind = 6;
            lhs.name = this.globalNames[gi];
            assign.children.add(lhs);
            assign.children.add(initExpr);
            Node stmt = new Node();
            stmt.kind = 61;
            stmt.children.add(assign);
            body.children.add(stmt);
        }
        initFunc.children.add(params);
        initFunc.children.add(body);
        this.emitFunction(initFunc);

        this.entryOffset = this.asm.buf.length;

        // __init_globals();
        this.asm.emitCallSetup(0);
        this.asm.callRel32(0);
        this.forwardCalls.add(this.asm.buf.length - 4);
        this.forwardCallNames.add("__init_globals");
        this.forwardCallClasses.add("");
        this.asm.emitCallTeardown();

        // main();
        this.asm.emitCallSetup(0);
        this.asm.callRel32(0);
        this.forwardCalls.add(this.asm.buf.length - 4);
        this.forwardCallNames.add("main");
        this.forwardCallClasses.add("");
        this.asm.emitCallTeardown();

        // ExitProcess(main's return value in RAX).
        this.asm.movRR64(1, 0);
        this.addImportPatch("kernel32.dll", "ExitProcess");
        int sEx = 0xDEADBEEFCAFEBABF;
        this.asm.emitImm64(0, sEx);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }

    public void patchForwardCalls(int[] code) {
        for (int i = 0; i < this.forwardCalls.length; i++) {
            int patchPos = this.forwardCalls[i];
            string targetName = this.forwardCallNames[i];
            string targetClass = this.forwardCallClasses[i];
            int targetOff = -1;
            for (int j = 0; j < this.funcNames.length; j++) {
                if (this.strEq(this.funcNames[j], targetName) && this.strEq(this.funcClasses[j], targetClass)) {
                    targetOff = this.funcOffsets[j];
                }
            }
            if (targetOff >= 0) {
                int rel32 = targetOff - (patchPos + 4);
                code[patchPos] = rel32 & 0xFF;
                code[patchPos + 1] = (rel32 >> 8) & 0xFF;
                code[patchPos + 2] = (rel32 >> 16) & 0xFF;
                code[patchPos + 3] = (rel32 >> 24) & 0xFF;
            }
        }
    }    public void emitMethod(Node func, string className) {
    this.currentFunctionName = func.name;
    int emitIdx = -1;
    for (int fi = 0; fi < this.funcNames.length; fi++) {
        if (this.funcOffsets[fi] == -1 && this.strEq(this.funcNames[fi], func.name) && this.strEq(this.funcClasses[fi], className)) {
            emitIdx = fi;
            break;
        }
    }
    if (emitIdx >= 0) {
        this.funcOffsets[emitIdx] = this.asm.buf.length;
    } else {
        this.funcNames.add(func.name);
        this.funcClasses.add(className);
        this.funcRetTypes.add(func.typeHint);
        this.funcOffsets.add(this.asm.buf.length);
    }
    this.localOffsets = [];
    this.localNames = [];
    this.localTypes = [];
    this.stackSize = 0;
    this.currentClassName = className;
    this.asm.label(func.name);
    this.asm.pushR64(5);
    this.asm.movRR64(5, 4);
    this.allocLocal("this");
    int[] paramRegs = [1, 2, 8, 9];
    int numParams = 0;
    if (func.childCount() > 0) {
        Node params = func.child(0);
        numParams = params.childCount();
        for (int i = 0; i < params.childCount(); i++) {
            this.allocLocal(params.child(i).name);
            this.localTypes[this.localTypes.length - 1] = params.child(i).typeHint;
        }
    }
    this.emitFunctionBody(func);
}    public void emitFunction(Node func) {
    this.currentFunctionName = func.name;
    if (this.strEq(func.name, "main")) {
        this.mainLabelOffset = this.asm.buf.length;
        this.hasMain = true;
    }
    int emitIdx = -1;
    for (int fi = 0; fi < this.funcNames.length; fi++) {
        if (this.funcOffsets[fi] == -1 && this.strEq(this.funcNames[fi], func.name)) {
            emitIdx = fi;
            break;
        }
    }
    if (emitIdx >= 0) {
        this.funcOffsets[emitIdx] = this.asm.buf.length;
    } else {
        this.funcNames.add(func.name);
        this.funcClasses.add("");
        this.funcRetTypes.add(func.typeHint);
        this.funcOffsets.add(this.asm.buf.length);
    }
    this.localOffsets = [];
    this.localNames = [];
    this.localTypes = [];
    this.stackSize = 0;
    this.currentClassName = "";
    this.asm.label(func.name);
    this.asm.pushR64(5);
    this.asm.movRR64(5, 4);
    if (func.childCount() > 0) {
        Node paramsFn = func.child(0);
        for (int i = 0; i < paramsFn.childCount(); i++) {
            this.allocLocal(paramsFn.child(i).name);
            this.localTypes[this.localTypes.length - 1] = paramsFn.child(i).typeHint;
        }
    }
    this.emitFunctionBody(func);
}    public void emitUtf8ConsoleSetup() {
        // Silver strings and file contents are UTF-8 bytes. Configure the
        // Windows console so printf/WriteFile displays those bytes correctly.
        this.asm.movRI64(1, 65001);
        this.asm.emitCallSetup(0);
        this.addImportPatch("kernel32.dll", "SetConsoleOutputCP");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }

    public void emitFunctionBody(Node func) {

        int isMethod = 0;
        if (!this.strEq(this.currentClassName, "")) {
            isMethod = 1;
        }
        string savedClass = this.currentClassName;
        int retLbl = this.newLabel();
        int exitLbl = this.newLabel();
        this.currentReturnLabel = retLbl;
        this.currentIsMain = this.strEq(func.name, "main") && this.strEq(this.currentClassName, "");
        // Reserve member-call argument slots before emitting the function
        // prologue.  Calls can nest while generating expressions; keeping a
        // fixed pool avoids changing stackSize after RSP has been reserved.
        this.funcCallArgTemps = [];
        this.funcCallArgCount = 0;
        this.scratchBaseOffset = -8 * (this.localOffsets.length + 1);
        for (int si = 0; si < 64; si = si + 1) {
            int scratchOff = this.allocLocal("__call_scratch");
            this.funcCallArgTemps.add(scratchOff);
        }
        if (func.childCount() > 1) {
            Node body = func.child(1);
            this.allocLocals(body);
            this.stackSize = ((this.stackSize + 15) / 16) * 16;
            int initialStackSize = this.stackSize;
            int subRspPatchPos = -1;
            // RBP is the stable frame anchor. Align the working stack before
            // reserving locals so every generated function enters calls with
            // the Win64 16-byte stack invariant, even when its caller's RSP
            // was not aligned. The epilogue restores RSP from RBP because an
            // AND operation cannot be undone by adding stackSize.
            this.asm.andRImm(4, -16);
            this.asm.emitU8(0x48);
            this.asm.emitU8(0x81);
            this.asm.emitU8(0xEC);
            this.asm.emitU32(this.stackSize);
            subRspPatchPos = this.asm.buf.length - 4;
            if (isMethod == 1) {
                int thisOff = this.findLocal("this");
                this.asm.movMBaseR(5, 1, thisOff);
                int[] paramRegsMb = [2, 8, 9];
                if (func.childCount() > 0) {
                    Node params = func.child(0);
                    for (int i = 0; i < params.childCount(); i++) {
                        int poff = this.findLocal(params.child(i).name);
                        if (poff != 0) {
                            if (i < 3) {
                                this.asm.movMBaseR(5, paramRegsMb[i], poff);
                            } else {
                                // Method ABI: `this` is RCX, declared params
                                // use RDX/R8/R9, and params 4+ come from the
                                // caller's stack. After push rbp and the local
                                // frame, the first stack argument is at
                                // [RBP+48]: return address (8), saved frame
                                // pointer (8), shadow space (32).
                                this.asm.movRMBase(0, 5, 48 + (i - 3) * 8);
                                this.asm.movMBaseR(5, 0, poff);
                            }
                        }
                    }
                }
            } else {
                int[] paramRegsFb = [1, 2, 8, 9];
                if (func.childCount() > 0) {
                    Node params = func.child(0);
                    for (int i = 0; i < params.childCount(); i++) {
                        int poff = this.findLocal(params.child(i).name);
                        if (poff != 0) {
                            if (i < 4) {
                                this.asm.movMBaseR(5, paramRegsFb[i], poff);
                            } else {
                                // Free-function ABI: params 1-4 use RCX/RDX/
                                // R8/R9; params 5+ come from the caller's
                                // stack at [RBP+48], [RBP+56], ... (return
                                // address 8 + saved frame pointer 8 + shadow
                                // space 32).
                                this.asm.movRMBase(0, 5, 48 + (i - 4) * 8);
                                this.asm.movMBaseR(5, 0, poff);
                            }
                        }
                    }
                }
            }
            if (this.currentIsMain) {
                this.emitUtf8ConsoleSetup();
            }
            if (body.kind == 16) {
                this.genBlock(body);
            } elif (body.kind == 61) {
                this.genStmt(body);
            }
            if (this.stackSize != initialStackSize) {
                this.stackSize = ((this.stackSize + 15) / 16) * 16;
                this.asm.buf[subRspPatchPos] = (this.stackSize) & 0xFF;
                this.asm.buf[subRspPatchPos+1] = (this.stackSize >> 8) & 0xFF;
                this.asm.buf[subRspPatchPos+2] = (this.stackSize >> 16) & 0xFF;
                this.asm.buf[subRspPatchPos+3] = (this.stackSize >> 24) & 0xFF;
            }
        } else {
            if (this.stackSize > 0) {
                this.asm.subRI32(4, this.stackSize);
            }
            if (isMethod == 1) {
                int thisOff = this.findLocal("this");
                this.asm.movMBaseR(5, 1, thisOff);
            }
        }
        if (this.currentIsMain) {
            // A fall-through void main exits successfully; an explicit
            // return expression keeps its value for ExitProcess.
            this.asm.xorRR64(0, 0);
            this.asm.jmpLabel(exitLbl);
            this.asm.bindLabel(retLbl);
            this.asm.bindLabel(exitLbl);
        } else {
            this.asm.bindLabel(retLbl);
        }
        this.asm.movRR64(4, 5);
        if (this.currentIsMain) {
            this.asm.movRR64(1, 0);
            this.addImportPatch("kernel32.dll", "ExitProcess");
            int sExit = 0xDEADBEEFCAFEBABE;
            this.asm.emitImm64(0, sExit);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
        } else {
            this.asm.popR64(5);
            this.asm.ret();
        }
        this.currentClassName = savedClass;
    }

    public void allocLocals(Node node) {
    if (node.kind == 50) {
        this.allocLocal(node.name);
        while (this.localTypes.length < this.localNames.length) {
            this.localTypes.add("");
        }
            if (this.localTypes.length > 0) {
                this.localTypes[this.localTypes.length - 1] = node.typeHint;
                if (node.childCount() > 0 && node.child(0).kind == 66) {
                    this.localTypes[this.localTypes.length - 1] = "dict<string,int>";
                }
            }
        }
        for (int i = 0; i < node.childCount(); i++) {
            this.allocLocals(node.child(i));
        }
    }

    public void genBlock(Node block) {
        for (int i = 0; i < block.childCount(); i++) {
            this.genStmt(block.child(i));
        }
    }

    public void genProgram2(Node[] program) {
        for (int i = 0; i < program.length; i++) {
            Node item = program[i];
            if (item.kind == 100) {
                this.emitFunction(item);
            }
        }
    }

    public void genStmt(Node stmt) {
        if (stmt.kind == 61) {
            if (stmt.childCount() > 0) {
                this.genExpr(stmt.child(0));
            }
    } elif (stmt.kind == 50) {
        int off = this.findLocal(stmt.name);
        if (stmt.childCount() > 0) {
            this.genExpr(stmt.child(0));
            if (off != 0) {
                this.asm.movMBaseR(5, 0, off);
            }
        } else {
            // Uninitialized locals start zeroed; array-typed locals start as
            // an empty array so that later .add() never touches garbage.
            string localTy = this.getLocalType(stmt.name);
            bool isArrTy = false;
            if (localTy.length >= 2) {
                if (localTy[localTy.length - 2] == '[' && localTy[localTy.length - 1] == ']') {
                    isArrTy = true;
                }
            }
            if (off != 0) {
                if (isArrTy) {
                    Node arrInit = new Node(); arrInit.kind = 19;
                    this.genExpr(arrInit);
                    this.asm.movMBaseR(5, 0, off);
                } else {
                    this.asm.xorRR64(0, 0);
                    this.asm.movMBaseR(5, 0, off);
                }
            }
        }        } elif (stmt.kind == 51) {
            if (stmt.childCount() > 0) {
                this.genExpr(stmt.child(0));
            } else {
                this.asm.xorRR64(0, 0);
            }
            this.asm.jmpLabel(this.currentReturnLabel);
        } elif (stmt.kind == 16) {
            this.genBlock(stmt);
    } elif (stmt.kind == 53) {
        int elseLbl = this.newLabel();
        int endLbl = this.newLabel();
        this.genExpr(stmt.child(0));
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(elseLbl);
        if (stmt.childCount() > 1) {
            Node body = stmt.child(1);
            if (body.kind == 16) {
                this.genBlock(body);
            } else {
                this.genStmt(body);
            }
        }
        this.asm.jmpLabel(endLbl);
        this.asm.bindLabel(elseLbl);
        if (stmt.childCount() > 2) {
            Node elseBody = stmt.child(2);
            if (elseBody.kind == 16) {
                this.genBlock(elseBody);
            } else {
                this.genStmt(elseBody);
            }
        }
        this.asm.bindLabel(endLbl);
        } elif (stmt.kind == 54) {
            int startLbl = this.newLabel();
            int endLbl = this.newLabel();
            this.loopStartStack.add(startLbl);
            this.loopEndStack.add(endLbl);
            this.loopContinueStack.add(startLbl);
            this.asm.bindLabel(startLbl);
            if (stmt.childCount() > 0) {
                this.genExpr(stmt.child(0));
            }
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(endLbl);
            if (stmt.childCount() > 1) {
                Node body = stmt.child(1);
                if (body.kind == 16) {
                    this.genBlock(body);
                } else {
                    this.genStmt(body);
                }
            }
            this.asm.jmpLabel(startLbl);
            this.asm.bindLabel(endLbl);
            this.popLoopStart();
            this.popLoopEnd();
            this.popLoopContinue();
        } elif (stmt.kind == 55) {
            // C-style for loop: child(0)=init, child(1)=cond, child(2)=update, child(3)=body
            if (stmt.childCount() > 0) {
                Node init = stmt.child(0);
                if (init.kind == 50 || init.kind == 61) {
                    this.genStmt(init);
                } else {
                    this.genExpr(init);
                }
            }
            int startLbl = this.newLabel();
            int endLbl = this.newLabel();
            int contLbl = this.newLabel();
            this.loopStartStack.add(startLbl);
            this.loopEndStack.add(endLbl);
            this.loopContinueStack.add(contLbl);
            this.asm.bindLabel(startLbl);
            if (stmt.childCount() > 1) {
                this.genExpr(stmt.child(1));
            }
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(endLbl);
            if (stmt.childCount() > 3) {
                Node body = stmt.child(3);
                if (body.kind == 16) {
                    this.genBlock(body);
                } else {
                    this.genStmt(body);
                }
            }
            this.asm.bindLabel(contLbl);
            if (stmt.childCount() > 2) {
                this.genExpr(stmt.child(2));
            }
            this.asm.jmpLabel(startLbl);
            this.asm.bindLabel(endLbl);
            this.popLoopStart();
            this.popLoopEnd();
            this.popLoopContinue();
        } elif (stmt.kind == 62) {
            if (this.loopEndStack.length > 0) {
                int endLbl = this.loopEndStack[this.loopEndStack.length - 1];
                this.asm.jmpLabel(endLbl);
            }
        } elif (stmt.kind == 63) {
            if (this.loopContinueStack.length > 0) {
                int contLbl = this.loopContinueStack[this.loopContinueStack.length - 1];
                this.asm.jmpLabel(contLbl);
            }
        } elif (stmt.kind == 64) {
            int startLbl = this.newLabel();
            int endLbl = this.newLabel();
            int contLbl = this.newLabel();
            this.loopStartStack.add(startLbl);
            this.loopEndStack.add(endLbl);
            this.loopContinueStack.add(contLbl);
            if (stmt.childCount() > 1) {
                this.genExpr(stmt.child(1));
                int arrOff = this.allocLocal("__foreach_arr");
                this.asm.movMBaseR(5, 0, arrOff);
                this.asm.movRMBase(0, 0, -8);
                int lenOff = this.allocLocal("__foreach_len");
                this.asm.movMBaseR(5, 0, lenOff);
                int idxOff = this.allocLocal("__foreach_idx");
                this.asm.movRI64(0, 0);
                this.asm.movMBaseR(5, 0, idxOff);
                int vOff = this.findLocal(stmt.child(0).name);
                this.asm.bindLabel(startLbl);
                this.asm.movRMBase(0, 5, idxOff);
                this.asm.movRMBase(1, 5, lenOff);
                this.asm.cmpRR64(0, 1);
                this.asm.jgeLabel(endLbl);
                this.asm.movRMBase(0, 5, arrOff);
                this.asm.movRMBase(1, 5, idxOff);
                this.asm.shlR64Imm(1, 3);
                this.asm.addRR64(0, 1);
                this.asm.movRMBase(0, 0, 0);
                this.asm.movMBaseR(5, 0, vOff);
                if (stmt.childCount() > 2) {
                    Node body = stmt.child(2);
                    if (body.kind == 16) {
                        this.genBlock(body);
                    } elif (body.kind == 61) {
                        this.genStmt(body);
                    }
                }
                this.asm.bindLabel(contLbl);
                this.asm.movRMBase(0, 5, idxOff);
                this.asm.addRI32(0, 1);
                this.asm.movMBaseR(5, 0, idxOff);
                this.asm.jmpLabel(startLbl);
                this.asm.bindLabel(endLbl);
            }
            this.popLoopStart();
            this.popLoopEnd();
            this.popLoopContinue();
        }
    }

    public void popLoopStart() {
        int[] ns = [];
        for (int i = 0; i < this.loopStartStack.length - 1; i++) {
            ns.add(this.loopStartStack[i]);
        }
        this.loopStartStack = ns;
    }

    public void popLoopEnd() {
        int[] ns = [];
        for (int i = 0; i < this.loopEndStack.length - 1; i++) {
            ns.add(this.loopEndStack[i]);
        }
        this.loopEndStack = ns;
    }

    public void popLoopContinue() {
        int[] ns = [];
        for (int i = 0; i < this.loopContinueStack.length - 1; i++) {
            ns.add(this.loopContinueStack[i]);
        }
        this.loopContinueStack = ns;
    }

    public void genExpr(Node expr) {
        int kind = expr.kind;
        if (kind == 0) {
            this.asm.emitImm64(0, expr.intVal);
        } elif (kind == 2) {
            int strIdx = this.addString(expr.strVal);
            int sp = this.asm.buf.length;
            this.asm.emitImm64(0, 0);
            int strPatchPos = sp + 2;
            this.stringPatchOffsets.add(strPatchPos);
            this.stringPatchIndices.add(strIdx);
        } elif (kind == 3) {
            this.asm.emitImm64(0, expr.charVal);
        } elif (kind == 4) {
            if (expr.boolVal) { this.asm.emitImm64(0, 1); } else { this.asm.emitImm64(0, 0); }
        } elif (kind == 5) {
            this.asm.xorRR64(0, 0);
        } elif (kind == 66) {
            // Dictionary layout: [capacity, length, key/value slots...].
            int count = expr.childCount();
            int capacity = 16;
            int allocSize = 16 + capacity * 16;
            this.asm.emitImm64(1, allocSize);
            this.addImportPatch("msvcrt.dll", "malloc");
            int sDict = 0xDEADBEEFCAFEBAB0;
            this.asm.emitImm64(0, sDict);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            int dictOff = this.allocLocal("__dict_lit");
            this.asm.movMBaseR(5, 0, dictOff);
            // Dictionary expressions return the data pointer (allocation base
            // plus 16), so the two header words live immediately before it:
            // [capacity, length, key/value slots...].  Store the header at the
            // allocation base before applying the returned-pointer bias.
            this.asm.movRMBase(0, 5, dictOff);
            this.asm.emitImm64(1, capacity);
            this.asm.movMBaseR(0, 1, 0);
            this.asm.movRMBase(0, 5, dictOff);
            this.asm.emitImm64(1, count);
            this.asm.movMBaseR(0, 1, 8);
            for (int di = 0; di < count; di++) {
                Node pair = expr.child(di);
                this.genExpr(pair.child(0));
                this.asm.movRMBase(1, 5, dictOff);
                this.asm.movMBaseR(1, 0, 16 + di * 16);
                this.genExpr(pair.child(1));
                this.asm.movRMBase(1, 5, dictOff);
                this.asm.movMBaseR(1, 0, 24 + di * 16);
            }
            this.asm.movRMBase(0, 5, dictOff);
            this.asm.addRI32(0, 16);
        } elif (kind == 19) {
            int count = expr.childCount();
            int capacity = 8;
            if (count > 8) { capacity = count; }
            int allocSize = (capacity + 2) * 8;
            this.asm.emitImm64(1, allocSize);
            this.addImportPatch("msvcrt.dll", "malloc");
            int s4 = 0xDEADBEEFCAFEBAB0;
            this.asm.emitImm64(0, s4);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            int arrOff = this.allocLocal("__arr_lit");
            this.asm.movMBaseR(5, 0, arrOff);
            this.asm.movRMBase(0, 5, arrOff);
            this.asm.emitImm64(1, capacity);
            this.asm.movMBaseR(0, 1, 0);
            this.asm.movRMBase(0, 5, arrOff);
            this.asm.emitImm64(1, count);
            this.asm.movMBaseR(0, 1, 8);
            for (int i = 0; i < count; i++) {
                this.genExpr(expr.child(i));
                this.asm.movRMBase(1, 5, arrOff);
                this.asm.movMBaseR(1, 0, 16 + i * 8);
            }
            this.asm.movRMBase(0, 5, arrOff);
            this.asm.addRI32(0, 16);    } elif (kind == 6) {
        bool isConst = false;
        int constVal = 0;
        string constString = "";
        int constIdx = 0;
        for (int ci = 0; ci < this.constNames.length; ci++) {
            if (this.strEq(this.constNames[ci], expr.name)) {
                constVal = this.constValues[ci];
                if (ci < this.constStringValues.length) {
                    constString = this.constStringValues[ci];
                }
                constIdx = ci;
                isConst = true;
                break;
            }
        }
        if (isConst) {
            if (constIdx < this.constIsString.length && this.constIsString[constIdx] == 1) {
                int strIdx = this.addString(constString);
                int sp = this.asm.buf.length;
                this.asm.emitImm64(0, 0);
                this.stringPatchOffsets.add(sp + 2);
                this.stringPatchIndices.add(strIdx);
            } else {
                this.asm.emitImm64(0, constVal);
            }
        } else if (this.strEq(expr.name, "cargs")) {
            this.genCargsCall(expr);
        } elif (this.strEq(expr.name, "getCommandLine")) {
            this.genGetCommandLineCall(expr);
        } else {
            int off = this.findLocal(expr.name);
            if (off != 0) {
                this.asm.movRMBase(0, 5, off);
            } else {
                int gi = this.findGlobal(expr.name);
                if (gi >= 0) {
                    this.genGlobalLoad(gi);
                } else {
                    this.asm.movRMBase(0, 5, 0);
                }
            }
        }
        } elif (kind == 9 || kind == 10) {
            this.genCall(expr);
        } elif (kind == 23) {
            if (expr.childCount() > 0) {
                this.genExpr(expr.child(0));
            }
        } elif (kind == 7) {
            this.genBinary(expr);
        } elif (kind == 8) {
            if (expr.op == 3) {
                // Address-of operator (&x): compute the address of the operand.
                // For a simple local variable, emit LEA [rbp+off] instead of
                // loading the value (the old code evaluated the child, leaving
                // the *value* in RAX, so &x passed the value to the callee).
                if (expr.childCount() > 0) {
                    Node addrChild = expr.child(0);
                    if (addrChild.kind == 6) {
                        int off = this.findLocal(addrChild.name);
                        this.asm.leaRBase(0, 5, off);
                    } else {
                        this.genExpr(addrChild);
                    }
                }
            } else {
                if (expr.childCount() > 0) {
                    this.genExpr(expr.child(0));
                }
                if (expr.op == 1) {
                    int t = this.newLabel();
                    int e = this.newLabel();
                    this.asm.cmpRI32(0, 0);
                    this.asm.jeLabel(t);
                    this.asm.movRI64(0, 0);
                    this.asm.jmpLabel(e);
                    this.asm.bindLabel(t);
                    this.asm.movRI64(0, 1);
                    this.asm.bindLabel(e);
                } elif (expr.op == 0) {
                    this.asm.negR64(0);
                }
            }
        } elif (kind == 24) {
            this.genArrayIndex(expr);
        } elif (kind == 13) {
            this.genMemberAccess(expr);
        } elif (kind == 65) {
            int elseLbl = this.newLabel();
            int endLbl = this.newLabel();
            this.genExpr(expr.child(0));
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(elseLbl);
            this.genExpr(expr.child(1));
            this.asm.jmpLabel(endLbl);
            this.asm.bindLabel(elseLbl);
            this.genExpr(expr.child(2));
            this.asm.bindLabel(endLbl);
        } elif (kind == 67) {
            this.genSlice(expr);
        }
    }

    public void genMemberAccess(Node expr) {
        Node obj = expr.child(0);
        string fieldName = expr.name;
        if (obj.kind == 6) {
            for (int ei = 0; ei < this.enumNames.length; ei++) {
                if (this.strEq(this.enumNames[ei], obj.name)) {
                    string fullName = obj.name + "." + fieldName;
                    for (int ci = 0; ci < this.constNames.length; ci++) {
                        if (this.strEq(this.constNames[ci], fullName)) {
                            this.asm.emitImm64(0, this.constValues[ci]);
                            return;
                        }
                    }
                }
            }
        }
        // os.name / os.version / os.build - builtin OS detection fields
        if (obj.kind == 6 && this.strEq(obj.name, "os")) {
            if (this.strEq(fieldName, "name")) {
                this.emitLlmaiStringLiteral("windows");
                return;
            }
            if (this.strEq(fieldName, "version")) {
                this.genOsVersionCall();
                return;
            }
            if (this.strEq(fieldName, "build")) {
                this.genOsBuildCall();
                return;
            }
        }
        if (this.strEq(fieldName, "length")) {
            string objType = this.inferExprType(obj);
            if (this.strEq(objType, "string")) {
                // Use the same aligned imported strlen path as the explicit
                // strlen() builtin.  Keeping this out of the hand-written
                // byte loop avoids a stage-sensitive movzx lowering issue in
                // d2 while preserving the string length semantics.
                this.genExpr(obj);
                this.asm.movRR64(1, 0);
                this.addImportPatch("ucrtbase.dll", "strlen");
                int sLen = 0xDEADBEEFCAFEBAD1;
                this.asm.emitImm64(0, sLen);
                this.asm.movRMBase(0, 0, 0);
                this.asm.emitCallSetup(0);
                this.asm.callR64(0);
                this.asm.emitCallTeardown();
                return;
            }
            this.genExpr(obj);
            this.asm.movRMBase(0, 0, -8);
            return;
        }
        if (obj.kind == 6 && this.strEq(obj.name, "this")) {
            int thisOff = this.findLocal("this");
            int fieldOff = this.findFieldOffset(this.currentClassName, fieldName);
            if (fieldOff < 0) { return; }
            this.asm.movRMBase(0, 5, thisOff);
            this.asm.movRMBase(0, 0, fieldOff);
            return;
        }
        if (obj.kind == 6 && this.strEq(obj.name, "this") && !this.strEq(this.currentClassName, "")) {
            int thisOff = this.findLocal("this");
            int fieldOff = this.findFieldOffset(this.currentClassName, fieldName);
            if (fieldOff < 0) { return; }
            this.asm.movRMBase(0, 5, thisOff);
            this.asm.movRMBase(0, 0, fieldOff);
            return;
        }
        if (obj.kind == 6) {
            string varType = this.getLocalType(obj.name);
            if (!this.strEq(varType, "")) {
                this.genExpr(obj);
                string elemType = this.arrayElementType(varType);
                string lookupType = varType;
                if (!this.strEq(elemType, "")) { lookupType = elemType; }
                int fieldOff = this.findFieldOffset(lookupType, fieldName);
                if (fieldOff < 0) {
                    // A self-hosted compiler can temporarily lose the class
                    // type table while rebuilding it.  If the member name is
                    // unique across the known layouts, its slot is still
                    // unambiguous and the fallback keeps object reads typed.
                    fieldOff = this.findFieldOffsetInAllClasses(fieldName);
                }
                if (fieldOff >= 0) {
                    this.asm.movRMBase(0, 0, fieldOff);
                }
                return;
            }
        }
        if (obj.kind == 24) {
            Node arrNode = obj.child(0);
            string arrType = this.inferExprType(arrNode);
            this.genArrayIndex(obj);
            string elemType = this.inferExprType(obj);
            if (this.strEq(elemType, "")) { elemType = this.arrayElementType(arrType); }
            if (!this.strEq(elemType, "")) {
                int fieldOff = this.findFieldOffset(elemType, fieldName);
                if (fieldOff >= 0) {
                    this.asm.movRMBase(0, 0, fieldOff);
                }
            }
            return;
        }
        if (obj.kind == 13) {
            this.genMemberAccess(obj);
            string objType = this.inferMemberAccessType(obj);
            int fieldOff = this.findFieldOffset(objType, fieldName);
            if (fieldOff < 0) {
                fieldOff = this.findFieldOffsetInAllClasses(fieldName);
            }
            if (fieldOff >= 0) {
                this.asm.movRMBase(0, 0, fieldOff);
            }
            return;
        }
        if (obj.kind == 10) {
            // Member access on a call result (e.g. this.advance().text):
            // evaluate the call, then load the field using the call's
            // inferred return type.  Falls back to a whole-program field
            // scan when the return type cannot be resolved.
            this.genExpr(obj);
            string retType = this.inferExprType(obj);
            int fieldOff = this.findFieldOffset(retType, fieldName);
            if (fieldOff < 0) {
                fieldOff = this.findFieldOffsetInAllClasses(fieldName);
            }
            if (fieldOff >= 0) {
                this.asm.movRMBase(0, 0, fieldOff);
            }
            return;
        }
        this.genExpr(obj);
    }

    public string inferExprType(Node expr) {
        if (expr.kind == 0) {
            return "int";
        }
        if (expr.kind == 2) {
            return "string";
        }
        if (expr.kind == 3) {
            return "char";
        }
        if (expr.kind == 4) {
            return "bool";
        }
        if (expr.kind == 66) {
            return "dict<string,int>";
        }
        if (expr.kind == 23) {
            if (expr.childCount() > 0) {
                return this.inferExprType(expr.child(0));
            }
            return "";
        }
        if (expr.kind == 67) {
            return this.inferExprType(expr.child(0));
        }
        if (expr.kind == 6) {
            if (this.strEq(expr.name, "this")) { return this.currentClassName; }
            for (int ci = 0; ci < this.constNames.length; ci++) {
                if (this.strEq(this.constNames[ci], expr.name)) {
                    if (ci < this.constIsString.length && this.constIsString[ci] == 1) {
                        return "string";
                    }
                    return "int";
                }
            }
            return this.getLocalType(expr.name);
        }
        if (expr.kind == 13) {
            if (this.strEq(expr.name, "length")) { return "int"; }
            return this.inferMemberAccessType(expr);
        }
        if (expr.kind == 24) {
            Node arrNode = expr.child(0);
            string arrType = this.inferExprType(arrNode);
            if (this.isDictType(arrType)) { return this.dictValueType(arrType); }
            if (this.strEq(arrType, "string")) { return "char"; }
            return this.arrayElementType(arrType);
        }
        if (expr.kind == 9) {
            return expr.name;
        }
        if (expr.kind == 10) {
            string cname = expr.name;
            string recvType = "";
            if (expr.isMember && expr.childCount() > 0) {
                recvType = this.inferExprType(expr.child(0));
                // env.get / env.getenv / env.getEnv return the environment
                // value as a string.  Without this, `env.get(k) == "v"`
                // inferred an unknown type and lowered to pointer comparison
                // instead of strcmp, so the comparison was always false.
                if (this.strEq(expr.child(0).name, "env") && (this.strEq(cname, "get") || this.strEq(cname, "getenv") || this.strEq(cname, "getEnv"))) {
                    return "string";
                }
                if (this.strEq(cname, "toInt64") || this.strEq(cname, "toInt") || this.strEq(cname, "toNumber")) { return "int64"; }
                if (this.strEq(cname, "toString") && (this.strEq(recvType, "string") || this.strEq(recvType, "char") || this.strEq(recvType, "int") || this.strEq(recvType, "int64") || this.strEq(recvType, "bool"))) {
                    return "string";
                }
                if (this.strEq(cname, "trimEnd") && this.strEq(recvType, "string")) {
                    return "string";
                }
                if (this.strEq(cname, "contains") && this.strEq(recvType, "string")) {
                    return "bool";
                }
                if (this.strEq(cname, "indexOf") && this.strEq(recvType, "string")) {
                    return "int";
                }
                if (this.strEq(cname, "toLower") && this.strEq(recvType, "string")) {
                    return "string";
                }
                if (this.strEq(cname, "toUpper") && this.strEq(recvType, "string")) {
                    return "string";
                }
                if (this.strEq(cname, "endsWith") && this.strEq(recvType, "string")) {
                    return "bool";
                }
                if (this.strEq(cname, "replace") && this.strEq(recvType, "string")) {
                    return "string";
                }
            }
            string cls = recvType;
            if (expr.isMember && expr.childCount() > 0 && this.strEq(cls, "")) {
                Node recv = expr.child(0);
                cls = this.inferExprType(recv);
            }
            for (int i = 0; i < this.funcNames.length; i++) {
                if (this.strEq(this.funcNames[i], cname) && this.typeNameEq(this.funcClasses[i], cls)) {
                    return this.funcRetTypes[i];
                }
            }
            for (int i = 0; i < this.funcNames.length; i++) {
                if (this.strEq(this.funcNames[i], cname)) {
                    return this.funcRetTypes[i];
                }
            }
            if (this.strEq(cname, "readString") || this.strEq(cname, "readFile") || this.strEq(cname, "input") || this.strEq(cname, "readLine")) { return "string"; }
            if (this.strEq(cname, "strlen") || this.strEq(cname, "len")) { return "int"; }
            if (this.strEq(cname, "getenv")) { return "string"; }
            if (this.strEq(cname, "getExt") || this.strEq(cname, "getExtension")) { return "string"; }
            if (this.strEq(cname, "cargs")) { return "string[]"; }
            if (this.strEq(cname, "findFieldType")) { return "string"; }
            if (this.strEq(cname, "findFieldOffset")) { return "int"; }
            return "";
        }
        if (expr.kind == 7) {
            if (expr.op == 1) {
                string lt = this.inferExprType(expr.child(0));
                string rt = this.inferExprType(expr.child(1));
                if (this.strEq(lt, "string") || this.strEq(rt, "string")) {
                    return "string";
                }
                return "int";
            }
            // Comparisons (==, !=, <, <=, >, >=, &&, ||) yield bool; every
            // other arithmetic/bitwise op yields int. Without these cases,
            // (a + b).toString() failed to be recognized as a builtin member
            // call and was lowered as a user call instead.
            if (expr.op >= 5 && expr.op <= 12) {
                return "bool";
            }
            return "int";
        }
        return "";
    }

    public string inferMemberAccessType(Node expr) {
        Node obj = expr.child(0);
        string fieldName = expr.name;
        // os.name / os.version / os.build → string
        if (obj.kind == 6 && this.strEq(obj.name, "os")) { return "string"; }
        string objType = this.inferExprType(obj);
        string fieldType = this.findFieldType(objType, fieldName);
        return fieldType;
    }

    public int findFieldOffsetInAllClasses(string fieldName) {
        for (int i = 0; i < this.classFieldNames.length; i++) {
            if (this.strEq(this.classFieldNames[i], fieldName)) {
                int off = this.classFieldOffsets[i];
                int unique = 1;
                for (int j = 0; j < this.classFieldNames.length; j++) {
                    if (j != i && this.strEq(this.classFieldNames[j], fieldName)) {
                        unique = 0;
                    }
                }
                if (unique == 1) {
                    return off;
                }
            }
        }
        return -1;
    }

    public void genArrayIndex(Node idx) {
        Node arrNode = idx.child(0);
        Node idxNode = idx.child(1);
        if (this.isDictType(this.inferReceiverType(arrNode))) {
            this.genDictIndexGet(idx);
            return;
        }
        // Lower this.field[index] directly.  Going through the generic
        // member-expression path evaluates a field receiver across a nested
        // index expression and is not stable in later self-hosted stages.
        if (arrNode.kind == 13) {
            Node arrObj = arrNode.child(0);
            if (arrObj.kind == 6 && this.strEq(arrObj.name, "this")) {
                int thisOff = this.findLocal("this");
                int fieldOff = this.findFieldOffset(this.currentClassName, arrNode.name);
                string fieldType = this.findFieldType(this.currentClassName, arrNode.name);
                if (fieldOff >= 0) {
                    this.asm.movRMBase(0, 5, thisOff);
                    this.asm.movRMBase(0, 0, fieldOff);
                    this.asm.pushR64(0);
                    this.genExpr(idxNode);
                    if (!this.strEq(fieldType, "string")) {
                        this.asm.shlR64Imm(0, 3);
                    }
                    this.asm.movRR64(11, 0);
                    this.asm.popR64(0);
                    this.asm.addRR64(0, 11);
                    if (this.strEq(fieldType, "string")) {
                        this.asm.movzxByteMBase(0, 0, 0);
                    } else {
                        this.asm.movRMBase(0, 0, 0);
                    }
                    return;
                }
            }
            if (arrObj.kind == 6) {
                // obj.field[index] where obj is a local variable whose class
                // declares field as a string array.  Resolve the owner type
                // through the local type table so string elements are read as
                // characters (byte loads) instead of raw pointers.
                string ownerType = this.getLocalType(arrObj.name);
                int fieldOff = this.findFieldOffset(ownerType, arrNode.name);
                string fieldType = this.findFieldType(ownerType, arrNode.name);
                if (fieldOff >= 0) {
                    this.asm.movRMBase(0, 5, this.findLocal(arrObj.name));
                    this.asm.movRMBase(0, 0, fieldOff);
                    this.asm.pushR64(0);
                    this.genExpr(idxNode);
                    if (!this.strEq(fieldType, "string")) {
                        this.asm.shlR64Imm(0, 3);
                    }
                    this.asm.movRR64(11, 0);
                    this.asm.popR64(0);
                    this.asm.addRR64(0, 11);
                    if (this.strEq(fieldType, "string")) {
                        this.asm.movzxByteMBase(0, 0, 0);
                    } else {
                        this.asm.movRMBase(0, 0, 0);
                    }
                    return;
                }
            }
        }
        int isString = 0;
        if (arrNode.kind == 6) {
            if (this.isByteElemType(this.getLocalType(arrNode.name))) { isString = 1; }
        } elif (arrNode.kind == 13) {
            if (this.isByteElemType(this.inferExprType(arrNode))) { isString = 1; }
        } elif (arrNode.kind == 24) {
            // Nested index (m[i][j]): the inner expression's inferred type is
            // the row element type, so byte-backed rows (char[][], string[]
            // vs. byte elements) are classified the same way as a member
            // access row.  Without this, char[][] reads used full-width loads.
            if (this.isByteElemType(this.inferExprType(arrNode))) { isString = 1; }
        }
        if (arrNode.kind == 6 && this.findLocal(arrNode.name) != 0) {
            int arrOff = this.findLocal(arrNode.name);
            this.genExpr(idxNode);
            if (isString == 0) { this.asm.shlR64Imm(0, 3); }
            this.asm.pushR64(0);
            this.asm.movRMBase(11, 5, arrOff);
            this.asm.popR64(0);
            this.asm.addRR64(11, 0);
            if (isString == 1) {
                this.asm.movzxByteMBase(0, 11, 0);
            } else {
                this.asm.movRMBase(0, 11, 0);
            }
        } else {
            this.genExpr(arrNode);
            this.asm.pushR64(0);
            this.genExpr(idxNode);
            if (isString == 0) { this.asm.shlR64Imm(0, 3); }
            this.asm.movRR64(11, 0);
            this.asm.popR64(0);
            this.asm.addRR64(0, 11);
            if (isString == 1) {
                this.asm.movzxByteMBase(0, 0, 0);
            } else {
                this.asm.movRMBase(0, 0, 0);
            }
        }
    }

    public void genSlice(Node expr) {
        // Slice expr: [0]=base, [1]=start, [2]=end (end-exclusive).
        // Strings copy bytes into a fresh NUL-terminated buffer; arrays copy
        // elements (8 bytes each, or 1 byte for byte[]/char[]) into a new
        // [capacity, length, ...] allocation.  Returns the data pointer.
        Node baseNode = expr.child(0);
        string baseType = this.inferExprType(baseNode);
        bool isStr = this.strEq(baseType, "string");
        bool isByteArr = false;
        if (!isStr) { isByteArr = this.isByteElemType(baseType); }

        int baseOff = this.allocLocal("__sl_base");
        int startOff = this.allocLocal("__sl_start");
        int endOff = this.allocLocal("__sl_end");
        int lenOff = this.allocLocal("__sl_len");
        int dstOff = this.allocLocal("__sl_dst");

        this.genExpr(baseNode);
        this.asm.movMBaseR(5, 0, baseOff);
        this.genExpr(expr.child(1));
        this.asm.movMBaseR(5, 0, startOff);
        // Open-ended slice [a:] carries a -1 sentinel end; resolve it to the
        // base's actual length (strlen for strings, the length header word at
        // base-8 for arrays).
        bool openEnd = false;
        if (expr.childCount() >= 3) {
            Node endNode = expr.child(2);
            if (endNode.kind == 0 && endNode.intVal == -1) { openEnd = true; }
        }
        if (openEnd) {
            if (isStr) {
                this.asm.movRMBase(1, 5, baseOff);
                this.addImportPatch("ucrtbase.dll", "strlen");
                int sSlLen = 0xDEADBEEFCAFEBAC3;
                this.asm.emitImm64(0, sSlLen);
                this.asm.movRMBase(0, 0, 0);
                this.asm.emitCallSetup(0);
                this.asm.callR64(0);
                this.asm.emitCallTeardown();
            } else {
                this.asm.movRMBase(0, 5, baseOff);
                this.asm.movRMBase(0, 0, -8);
            }
            this.asm.movMBaseR(5, 0, endOff);
        } else {
            this.genExpr(expr.child(2));
            this.asm.movMBaseR(5, 0, endOff);
        }

        // len = end - start, clamped to >= 0.
        this.asm.movRMBase(0, 5, endOff);
        this.asm.movRMBase(8, 5, startOff);
        this.asm.subRR64(0, 8);
        int lenNonNeg = this.newLabel();
        this.asm.cmpRI32(0, 0);
        this.asm.jgeLabel(lenNonNeg);
        this.asm.xorRR64(0, 0);
        this.asm.bindLabel(lenNonNeg);
        this.asm.movMBaseR(5, 0, lenOff);

        if (isStr) {
            // malloc(len + 1)
            this.asm.movRMBase(1, 5, lenOff);
            this.asm.addRI32(1, 1);
            this.addImportPatch("msvcrt.dll", "malloc");
            int sSlAlloc = 0xDEADBEEFCAFEBAC1;
            this.asm.emitImm64(0, sSlAlloc);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, dstOff);

            int iOff = this.allocLocal("__sl_i");
            this.asm.xorRR64(0, 0);
            this.asm.movMBaseR(5, 0, iOff);
            int slLoop = this.newLabel();
            int slDone = this.newLabel();
            this.asm.bindLabel(slLoop);
            this.asm.movRMBase(0, 5, iOff);
            this.asm.movRMBase(8, 5, lenOff);
            this.asm.cmpRR64(0, 8);
            this.asm.jgeLabel(slDone);
            // src byte = base[start + i]
            this.asm.movRMBase(10, 5, startOff);
            this.asm.movRMBase(11, 5, iOff);
            this.asm.addRR64(10, 11);
            this.asm.movRMBase(11, 5, baseOff);
            this.asm.addRR64(11, 10);
            this.asm.movzxByteMBase(10, 11, 0);
            // dst[i] = byte
            this.asm.movRMBase(11, 5, dstOff);
            this.asm.movRMBase(8, 5, iOff);
            this.asm.addRR64(11, 8);
            this.asm.movMBaseByteR(11, 10, 0);
            this.asm.movRMBase(0, 5, iOff);
            this.asm.addRI32(0, 1);
            this.asm.movMBaseR(5, 0, iOff);
            this.asm.jmpLabel(slLoop);
            this.asm.bindLabel(slDone);
            // dst[len] = 0
            this.asm.movRMBase(0, 5, dstOff);
            this.asm.movRMBase(1, 5, lenOff);
            this.asm.addRR64(0, 1);
            this.asm.xorRR64(1, 1);
            this.asm.movMBaseByteR(0, 1, 0);
            this.asm.movRMBase(0, 5, dstOff);
        } else {
            // Array slice: allocSize = (len + 2) * 8; header [capacity, length].
            this.asm.movRMBase(0, 5, lenOff);
            this.asm.addRI32(0, 2);
            this.asm.shlR64Imm(0, 3);
            this.asm.movRR64(1, 0);
            this.addImportPatch("msvcrt.dll", "malloc");
            int sSlAlloc2 = 0xDEADBEEFCAFEBAC2;
            this.asm.emitImm64(0, sSlAlloc2);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, dstOff);
            this.asm.movRMBase(0, 5, dstOff);
            this.asm.movRMBase(1, 5, lenOff);
            this.asm.movMBaseR(0, 1, 0);
            this.asm.movRMBase(0, 5, dstOff);
            this.asm.movRMBase(1, 5, lenOff);
            this.asm.movMBaseR(0, 1, 8);
            int iOff2 = this.allocLocal("__sl_i2");
            this.asm.xorRR64(0, 0);
            this.asm.movMBaseR(5, 0, iOff2);
            int slLoop2 = this.newLabel();
            int slDone2 = this.newLabel();
            this.asm.bindLabel(slLoop2);
            this.asm.movRMBase(0, 5, iOff2);
            this.asm.movRMBase(8, 5, lenOff);
            this.asm.cmpRR64(0, 8);
            this.asm.jgeLabel(slDone2);
            // src element index = (start + i) * esize
            this.asm.movRMBase(10, 5, startOff);
            this.asm.movRMBase(11, 5, iOff2);
            this.asm.addRR64(10, 11);
            if (!isByteArr) { this.asm.shlR64Imm(10, 3); }
            this.asm.movRMBase(11, 5, baseOff);
            this.asm.addRR64(11, 10);
            // dst element index = dst + 16 + i * esize
            this.asm.movRMBase(9, 5, dstOff);
            this.asm.addRI32(9, 16);
            this.asm.movRMBase(8, 5, iOff2);
            if (!isByteArr) { this.asm.shlR64Imm(8, 3); }
            this.asm.addRR64(9, 8);
            if (isByteArr) {
                this.asm.movzxByteMBase(10, 11, 0);
                this.asm.movMBaseByteR(9, 10, 0);
            } else {
                this.asm.movRMBase(10, 11, 0);
                this.asm.movMBaseR(9, 10, 0);
            }
            this.asm.movRMBase(0, 5, iOff2);
            this.asm.addRI32(0, 1);
            this.asm.movMBaseR(5, 0, iOff2);
            this.asm.jmpLabel(slLoop2);
            this.asm.bindLabel(slDone2);
            this.asm.movRMBase(0, 5, dstOff);
            this.asm.addRI32(0, 16);
        }
    }

    public void genArrayAdd(Node call) {
        Node arrNode = call.child(0);
        Node valNode = call.child(1);
        this.genExpr(arrNode);
        int arrOff = this.allocLocal("__arr_add_arr");
        this.asm.movMBaseR(5, 0, arrOff);
        if (arrNode.kind == 6) {
            int origOff = this.findLocal(arrNode.name);
            int gArr = this.findGlobal(arrNode.name);
            if (origOff != 0) {
                this.asm.movMBaseR(5, 0, origOff);
            } elif (gArr >= 0) {
                this.genGlobalStore(gArr);
            }
        } elif (arrNode.kind == 13) {
            Node arrObj = arrNode.child(0);
            if (arrObj.kind == 6 && this.strEq(arrObj.name, "this")) {
                int thisOff2 = this.findLocal("this");
                int fieldOff2 = this.findFieldOffset(this.currentClassName, arrNode.name);
                if (fieldOff2 >= 0 && thisOff2 != 0) {
                    this.asm.movRMBase(1, 5, thisOff2);
                    this.asm.movMBaseR(1, 0, fieldOff2);
                }
            }
        }
        this.genExpr(valNode);
        int valOff = this.allocLocal("__arr_add_val");
        this.asm.movMBaseR(5, 0, valOff);
        int needGrow = this.newLabel();
        int doneGrow = this.newLabel();
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(1, 0, -8);
        this.asm.movRMBase(2, 0, -16);
        this.asm.cmpRR64(1, 2);
        this.asm.jgeLabel(needGrow);
        this.asm.jmpLabel(doneGrow);
        this.asm.bindLabel(needGrow);
        int newCapOff = this.allocLocal("__arr_new_cap");
        this.asm.movRR64(1, 2);
        this.asm.shlR64Imm(1, 1);
        this.asm.movMBaseR(5, 1, newCapOff);
        this.asm.movRMBase(0, 5, newCapOff);
        this.asm.addRI32(0, 2);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(1, 0);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int newArrOff = this.allocLocal("__arr_new_arr");
        this.asm.movMBaseR(5, 0, newArrOff);
        this.asm.movRMBase(0, 5, newArrOff);
        this.asm.movRMBase(1, 5, newCapOff);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(1, 0, -8);
        this.asm.movRMBase(0, 5, newArrOff);
        this.asm.movMBaseR(0, 1, 8);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(1, 0, -8);
        this.asm.shlR64Imm(1, 3);
        int copySzOff = this.allocLocal("__arr_copy_sz");
        this.asm.movMBaseR(5, 1, copySzOff);
        // Copy existing elements with scalar loads/stores instead of
        // memcpy. This keeps the growth path in the conservative instruction
        // subset used by every self-hosted stage.
        int copySrcOff = this.allocLocal("__arr_copy_src");
        int copyDstOff = this.allocLocal("__arr_copy_dst");
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movMBaseR(5, 0, copySrcOff);
        this.asm.movRMBase(0, 5, newArrOff);
        this.asm.addRI32(0, 16);
        this.asm.movMBaseR(5, 0, copyDstOff);
        int copyLoop = this.newLabel();
        int copyDone = this.newLabel();
        this.asm.bindLabel(copyLoop);
        this.asm.movRMBase(0, 5, copySzOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jleLabel(copyDone);
        this.asm.movRMBase(10, 5, copySrcOff);
        this.asm.movRMBase(8, 10, 0);
        this.asm.movRMBase(11, 5, copyDstOff);
        this.asm.movMBaseR(11, 8, 0);
        this.asm.addRI32(10, 8);
        this.asm.movMBaseR(5, 10, copySrcOff);
        this.asm.addRI32(11, 8);
        this.asm.movMBaseR(5, 11, copyDstOff);
        this.asm.movRMBase(0, 5, copySzOff);
        this.asm.subRI32(0, 8);
        this.asm.movMBaseR(5, 0, copySzOff);
        this.asm.jmpLabel(copyLoop);
        this.asm.bindLabel(copyDone);
        this.asm.movRMBase(0, 5, newArrOff);
        this.asm.addRI32(0, 16);
        this.asm.movMBaseR(5, 0, arrOff);
        if (arrNode.kind == 6) {
            int origOff2 = this.findLocal(arrNode.name);
            if (origOff2 != 0) {
                this.asm.movMBaseR(5, 0, origOff2);
            }
        } elif (arrNode.kind == 13) {
            Node arrObj2 = arrNode.child(0);
            if (arrObj2.kind == 6 && this.strEq(arrObj2.name, "this")) {
                int thisOff3 = this.findLocal("this");
                int fieldOff3 = this.findFieldOffset(this.currentClassName, arrNode.name);
                if (fieldOff3 >= 0 && thisOff3 != 0) {
                    this.asm.movRMBase(1, 5, thisOff3);
                    this.asm.movMBaseR(1, 0, fieldOff3);
                }
            } elif (arrObj2.kind == 13) {
                // Nested chain: this.asm.field (e.g. this.asm.labelPositions).
                // Preserve the new array pointer (rax) while resolving the
                // owning object, then store the pointer back into the field.
                this.asm.pushR64(0);
                this.genMemberAccess(arrObj2);
                this.asm.movRR64(1, 0);
                this.asm.popR64(0);
                string ownerType = this.inferMemberAccessType(arrObj2);
                int fieldOff4 = this.findFieldOffset(ownerType, arrNode.name);
                if (fieldOff4 < 0) {
                    fieldOff4 = this.findFieldOffsetInAllClasses(arrNode.name);
                }
                if (fieldOff4 >= 0) {
                    this.asm.movMBaseR(1, 0, fieldOff4);
                }
            } elif (arrObj2.kind == 6) {
                // A normal object field (for example node.children) can also
                // move during growth.  The old lowering updated only the
                // temporary array slot, leaving the object's field pointing
                // at the exhausted buffer.  That silently drops later AST
                // children in stage 2 and makes the generated compiler emit
                // only a prefix of a block.
                this.asm.pushR64(0);
                this.genExpr(arrObj2);
                this.asm.movRR64(1, 0);
                this.asm.popR64(0);
                string ownerType2 = this.inferExprType(arrObj2);
                int fieldOff5 = this.findFieldOffset(ownerType2, arrNode.name);
                if (fieldOff5 < 0) {
                    fieldOff5 = this.findFieldOffsetInAllClasses(arrNode.name);
                }
                if (fieldOff5 >= 0) {
                    this.asm.movMBaseR(1, 0, fieldOff5);
                }
            }
        }
        this.asm.bindLabel(doneGrow);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(1, 0, -8);
        this.asm.shlR64Imm(1, 3);
        this.asm.addRR64(0, 1);
        this.asm.movRMBase(8, 5, valOff);
        this.asm.movMBaseR(0, 8, 0);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(1, 0, -8);
        this.asm.addRI32(1, 1);
        this.asm.movMBaseR(0, 1, -8);
        // Persist the (possibly reallocated) array pointer back into the
        // member field slot so later field reads see the appended element.
        if (arrNode.kind == 13) {
            Node arrObj3 = arrNode.child(0);
            if (arrObj3.kind == 6 && this.strEq(arrObj3.name, "this")) {
                int thisOff4 = this.findLocal("this");
                int fieldOff6 = this.findFieldOffset(this.currentClassName, arrNode.name);
                if (fieldOff6 >= 0 && thisOff4 != 0) {
                    this.asm.movRMBase(1, 5, thisOff4);
                    this.asm.movRMBase(0, 5, arrOff);
                    this.asm.movMBaseR(1, 0, fieldOff6);
                }
            }
        }
    }

    public bool hasDynamicAsmArg(Node call) {
        // Calls on this.asm are compiler-time assembler operations.  Their
        // identifier operands (local offsets, label ids, and sentinels) are
        // values in MiniCg's compile-time environment, not values that the
        // generated compiler must pass through MiniAsm at runtime.
        //
        // Routing non-literal operands through genDynamicAsmCall emits a
        // runtime call to a MiniAsm method while compiling compiler_driver.sr;
        // that corrupts the stage-2 compiler before it can process cargs.
        return false;
    }

    public bool isBuiltinModuleReceiver(Node call) {
        // A member call is routed to a global builtin only when its receiver
        // is a stdlib namespace object (fs, file, folder, json, yaml, llmai,
        // Value).  Member calls on user objects (e.g. a Lexer with a
        // readString method) must dispatch to their own class methods, never
        // to the fs/printline builtins -- mirroring the Rust compiler's
        // MethodCall dispatch which only special-cases those receiver names.
        if (!call.isMember || call.childCount() < 1) { return false; }
        Node recv = call.child(0);
        if (recv.kind != 6) { return false; }
        if (this.strEq(recv.name, "fs")) { return true; }
        if (this.strEq(recv.name, "env")) { return true; }
        if (this.strEq(recv.name, "file")) { return true; }
        if (this.strEq(recv.name, "folder")) { return true; }
        if (this.strEq(recv.name, "json")) { return true; }
        if (this.strEq(recv.name, "yaml")) { return true; }
        if (this.strEq(recv.name, "llmai") || this.strEq(recv.name, "LLMAI")) { return true; }
        if (this.strEq(recv.name, "Value")) { return true; }
        if (this.strEq(recv.name, "os")) { return true; }
        return false;
    }

    public void genCall(Node call) {
        string name = call.name;
        int isClass = 0;
        for (int i = 0; i < this.classNames.length; i++) {
            if (this.strEq(this.classNames[i], name)) { isClass = 1; }
        }
        bool builtinName = (!call.isMember || this.isBuiltinModuleReceiver(call));
        if (isClass == 1) {
            this.genNewCall(call);
        } elif (builtinName && this.strEq(name, "printline")) {
            this.genPrintCall(call, 1);
        } elif (builtinName && this.strEq(name, "print")) {
            this.genPrintCall(call, 0);
        } elif (builtinName && this.strEq(name, "readString")) {
            this.genReadStringCall(call);
        } elif (builtinName && this.strEq(name, "readFile")) {
            this.genReadStringCall(call);
        } elif (builtinName && this.strEq(name, "input")) {
            this.genInputCall(call);
        } elif (builtinName && this.strEq(name, "readLine")) {
            this.genInputCall(call);
        } elif (builtinName && this.strEq(name, "writeBytes")) {
            this.genWriteBytesCall(call);
        } elif (builtinName && this.strEq(name, "writeFile")) {
            this.genWriteBytesCall(call);
        } elif (builtinName && this.strEq(name, "writeString")) {
            this.genWriteBytesCall(call);
        } elif (builtinName && this.strEq(name, "strlen")) {
            this.genStrlenCall(call);
        } elif (builtinName && this.strEq(name, "len")) {
            this.genLenCall(call);
        } elif (builtinName && this.strEq(name, "exit")) {
            this.genExitCall(call);
        } elif (builtinName && this.strEq(name, "cargs")) {
            this.genCargsCall(call);
        } elif (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && (this.strEq(call.child(0).name, "llmai") || this.strEq(call.child(0).name, "LLMAI")) && this.strEq(call.name, "chat")) {
            // Builtin LLM chat completion (DOCS/206): llmai.chat(url, headers, body)
            this.genLlmaiChatCall(call);
        } elif (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && this.strEq(call.child(0).name, "env") && (this.strEq(call.name, "get") || this.strEq(call.name, "getenv") || this.strEq(call.name, "getEnv"))) {
            // Environment variable lookup: env.get(name) / env.getenv(name)
            this.genGetEnvCall(call);
        } elif (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && (this.strEq(call.child(0).name, "fs") || this.strEq(call.child(0).name, "file") || this.strEq(call.child(0).name, "folder")) && (this.strEq(call.name, "getExt") || this.strEq(call.name, "getExtension"))) {
            this.genGetExtCall(call);
        } elif (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && (this.strEq(call.child(0).name, "fs") || this.strEq(call.child(0).name, "file") || this.strEq(call.child(0).name, "folder")) && (this.strEq(call.name, "getenv") || this.strEq(call.name, "getEnv"))) {
            // fs.getenv(name) alias for environment variable lookup
            this.genGetEnvCall(call);
        } elif (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && this.strEq(call.child(0).name, "Value")) {
            // Static factory on the builtin Value tagged union (e.g. Value.makeInt).
            this.genValueFactoryCall(call);
        } elif (call.isMember && call.childCount() > 1 && this.strEq(call.name, "contains") && this.isDictType(this.inferReceiverType(call.child(0)))) {
            this.genDictContains(call);
        } elif (call.isMember && this.isThisAsmMember(call)) {
            // MiniAsm is a runtime object owned by MiniCg. Every this.asm
            // operation must remain a receiver-aware method call in the
            // self-hosted compiler; lowering it as raw bytes here would place
            // assembler output in the generated compiler's function body.
            this.genMemberCall(call);
        } elif (call.isMember && this.isBuiltinMemberCall(call)) {
            this.genBuiltinMemberCall(call);
        } elif (call.isMember && !this.isThisAsmMember(call) && this.isUserClassMemberCall(call)) {
            this.genMemberCall(call);
        } elif (this.strEq(name, "pushR64") || this.strEq(name, "popR64") || this.strEq(name, "movRR64") || this.strEq(name, "movRI64") || this.strEq(name, "movRMBase") || this.strEq(name, "movMBaseR") || this.strEq(name, "subRI32") || this.strEq(name, "addRI32") || this.strEq(name, "xorRR64") || this.strEq(name, "cmpRI32") || this.strEq(name, "cmpRR64") || this.strEq(name, "ret") || this.strEq(name, "callR64") || this.strEq(name, "leaRBase") || this.strEq(name, "emitU8") || this.strEq(name, "emitU32") || this.strEq(name, "emitImm64") || this.strEq(name, "emitCallSetup") || this.strEq(name, "emitCallTeardown") || this.strEq(name, "addRR64") || this.strEq(name, "subRR64") || this.strEq(name, "mulRR64") || this.strEq(name, "andRImm") || this.strEq(name, "shlR64Imm") || this.strEq(name, "incR64") || this.strEq(name, "decR64") || this.strEq(name, "movByteMBaseIdxR") || this.strEq(name, "movMBaseByteR") || this.strEq(name, "label") || this.strEq(name, "bindLabel") || this.strEq(name, "jeLabel") || this.strEq(name, "jneLabel") || this.strEq(name, "jmpLabel") || this.strEq(name, "jlLabel") || this.strEq(name, "jleLabel") || this.strEq(name, "jgLabel") || this.strEq(name, "jgeLabel") || this.strEq(name, "movzxByteMBase") || this.strEq(name, "callRel32")) {
            this.genAsmCall(call);        } elif ((call.isMember && this.strEq(name, "add") && call.childCount() > 0) || (call.isMember && this.strEq(name, "push") && call.childCount() > 0) || (call.isMember && this.strEq(name, "append") && call.childCount() > 0)) {
             // Only a receiver-qualified `.add(value)` or `.push(value)` on an
             // array is an append. A user class method named add remains a
             // normal call.
             string addRecvType = this.inferExprType(call.child(0));
             if (addRecvType.length >= 2 && addRecvType[addRecvType.length - 2] == '[' && addRecvType[addRecvType.length - 1] == ']') {
                 this.genArrayAdd(call);
             } else {
                 this.genMemberCall(call);
             }
        } elif (this.strEq(name, "super")) {
            // super(...) - parent constructor call
            this.genSuperCall(call);
        } else {
            this.genUserCall(call);
        }
    }

    public void genDictIndexGet(Node idx) {
        // dict = array [cap, len, k1, v1, k2, v2, ...], data ptr at base+16.
        // Linear search over i < len; returns the value whose key equals
        // the searched key, or 0 when absent.
        Node dictNode = idx.child(0);
        Node keyNode = idx.child(1);
        this.genExpr(dictNode);
        int dBase = this.allocLocal("__dg_base");
        this.asm.movMBaseR(5, 0, dBase);
        this.genExpr(keyNode);
        int dKey = this.allocLocal("__dg_key");
        this.asm.movMBaseR(5, 0, dKey);
        int dI = this.allocLocal("__dg_i");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, dI);
        int lL = this.newLabel();
        int fL = this.newLabel();
        int nL = this.newLabel();
        int eL = this.newLabel();
        int iter = this.newLabel();
        this.asm.bindLabel(lL);
        this.asm.movRMBase(0, 5, dI);
        this.asm.movRMBase(1, 5, dBase);
        this.asm.movRMBase(1, 1, -8);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(nL);
        this.asm.movRMBase(0, 5, dI);
        this.asm.shlR64Imm(0, 1);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(11, 0);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.addRR64(0, 11);
        this.asm.movRMBase(1, 0, 0);
        this.asm.cmpRI32(1, 0);
        this.asm.jeLabel(iter);
        this.asm.movRR64(1, 1);
        this.asm.movRMBase(2, 5, dKey);
        this.addImportPatch("ucrtbase.dll", "strcmp");
        int sCmp = 0xDEADBEEFCAFEBADF;
        this.asm.emitImm64(0, sCmp);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(fL);
        this.asm.bindLabel(iter);
        this.asm.movRMBase(0, 5, dI);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, dI);
        this.asm.jmpLabel(lL);
        this.asm.bindLabel(fL);
        this.asm.movRMBase(0, 5, dI);
        this.asm.shlR64Imm(0, 1);
        this.asm.addRI32(0, 1);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(11, 0);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.addRR64(0, 11);
        this.asm.movRMBase(0, 0, 0);
        this.asm.jmpLabel(eL);
        this.asm.bindLabel(nL);
        this.asm.xorRR64(0, 0);
        this.asm.bindLabel(eL);
    }

    public void genDictIndexSet(Node bin) {
        Node lhs = bin.child(0);
        Node rhs = bin.child(1);
        Node dictNode = lhs.child(0);
        Node keyNode = lhs.child(1);
        this.genExpr(dictNode);
        int dBase = this.allocLocal("__ds_base");
        this.asm.movMBaseR(5, 0, dBase);
        this.genExpr(keyNode);
        int dKey = this.allocLocal("__ds_key");
        this.asm.movMBaseR(5, 0, dKey);
        this.genExpr(rhs);
        int dVal = this.allocLocal("__ds_val");
        this.asm.movMBaseR(5, 0, dVal);
        int dI = this.allocLocal("__ds_i");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, dI);
        int slotKind = 0;
        int slotOff = 0;
        int slotOff2 = 0;
        if (dictNode.kind == 6) {
            slotKind = 1;
            slotOff = this.findLocal(dictNode.name);
        } elif (dictNode.kind == 13 && dictNode.childCount() > 0) {
            Node dobj = dictNode.child(0);
            if (dobj.kind == 6 && this.strEq(dobj.name, "this")) {
                slotKind = 2;
                slotOff = this.findLocal("this");
                slotOff2 = this.findFieldOffset(this.currentClassName, dictNode.name);
            } elif (dobj.kind == 6) {
                slotKind = 3;
                slotOff = this.findLocal(dobj.name);
                slotOff2 = this.findFieldOffset(this.getLocalType(dobj.name), dictNode.name);
            }
        }
        int lL = this.newLabel();
        int fL = this.newLabel();
        int aL = this.newLabel();
        int eL = this.newLabel();
        int nG = this.newLabel();
        int iter = this.newLabel();
        this.asm.bindLabel(lL);
        this.asm.movRMBase(0, 5, dI);
        this.asm.movRMBase(1, 5, dBase);
        this.asm.movRMBase(1, 1, -8);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(aL);
        this.asm.movRMBase(0, 5, dI);
        this.asm.shlR64Imm(0, 1);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(11, 0);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.addRR64(0, 11);
        this.asm.movRMBase(1, 0, 0);
        this.asm.cmpRI32(1, 0);
        this.asm.jeLabel(iter);
        this.asm.movRR64(1, 1);
        this.asm.movRMBase(2, 5, dKey);
        this.addImportPatch("ucrtbase.dll", "strcmp");
        int sCmp2 = 0xDEADBEEFCAFEBADE;
        this.asm.emitImm64(0, sCmp2);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(fL);
        this.asm.bindLabel(iter);
        this.asm.movRMBase(0, 5, dI);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, dI);
        this.asm.jmpLabel(lL);
        this.asm.bindLabel(fL);
        this.asm.movRMBase(0, 5, dI);
        this.asm.shlR64Imm(0, 1);
        this.asm.addRI32(0, 1);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(11, 0);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.addRR64(0, 11);
        this.asm.movRMBase(1, 5, dVal);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.jmpLabel(eL);
        this.asm.bindLabel(aL);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.movRMBase(1, 0, -16);
        this.asm.movRMBase(2, 0, -8);
        this.asm.cmpRR64(2, 1);
        this.asm.jlLabel(nG);
        int ncO = this.allocLocal("__ds_nc");
        this.asm.movRMBase(0, 5, dBase);
        this.asm.movRMBase(0, 0, -16);
        this.asm.shlR64Imm(0, 1);
        this.asm.movMBaseR(5, 0, ncO);
        // Each dictionary entry occupies two 8-byte words, in addition to
        // the 16-byte header.  Allocate the full new capacity, not the array
        // sized `(capacity + 2) * 8` used by ordinary arrays.
        this.asm.movRMBase(0, 5, ncO);
        this.asm.shlR64Imm(0, 4);
        this.asm.addRI32(0, 16);
        this.asm.movRR64(1, 0);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int naO = this.allocLocal("__ds_na");
        this.asm.movMBaseR(5, 0, naO);
        // Preserve the old logical length; the new allocation must initialize
        // both header words before it becomes the active dictionary pointer.
        int oldLenO = this.allocLocal("__ds_old_len");
        this.asm.movRMBase(0, 5, dBase);
        this.asm.movRMBase(0, 0, -8);
        this.asm.movMBaseR(5, 0, oldLenO);
        int cpI = this.allocLocal("__ds_cpi");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, cpI);
        int cpL = this.newLabel();
        int cpE = this.newLabel();
        this.asm.bindLabel(cpL);
        this.asm.movRMBase(0, 5, cpI);
        this.asm.movRMBase(1, 5, dBase);
        this.asm.movRMBase(1, 1, -8);
        this.asm.shlR64Imm(1, 1);
        this.asm.addRI32(1, 2);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(cpE);
        this.asm.movRMBase(0, 5, cpI);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(11, 0);
        // dBase points at the old data area (allocation base + 16), while
        // naO is the new allocation base.  Keep the header out of the copied
        // key/value slots by biasing the destination by 16 bytes.
        this.asm.movRMBase(0, 5, dBase);
        this.asm.addRR64(0, 11);
        this.asm.movRMBase(1, 0, 0);
        this.asm.movRMBase(0, 5, naO);
        this.asm.addRI32(0, 16);
        this.asm.addRR64(0, 11);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRMBase(0, 5, cpI);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, cpI);
        this.asm.jmpLabel(cpL);
        this.asm.bindLabel(cpE);
        this.asm.movRMBase(0, 5, naO);
        this.asm.movRMBase(1, 5, ncO);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRMBase(0, 5, naO);
        this.asm.movRMBase(1, 5, oldLenO);
        this.asm.movMBaseR(0, 1, 8);
        if (slotKind == 1) {
            this.asm.movRMBase(0, 5, naO);
            this.asm.addRI32(0, 16);
            this.asm.movMBaseR(5, 0, slotOff);
        } elif (slotKind == 2) {
            this.asm.movRMBase(1, 5, slotOff);
            this.asm.movRMBase(0, 5, naO);
            this.asm.addRI32(0, 16);
            this.asm.movMBaseR(1, 0, slotOff2);
        } elif (slotKind == 3) {
            this.asm.movRMBase(1, 5, slotOff);
            this.asm.movRMBase(0, 5, naO);
            this.asm.addRI32(0, 16);
            this.asm.movMBaseR(1, 0, slotOff2);
        }
        this.asm.movRMBase(0, 5, naO);
        this.asm.addRI32(0, 16);
        this.asm.movMBaseR(5, 0, dBase);
        this.asm.bindLabel(nG);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.movRMBase(1, 0, -8);
        this.asm.shlR64Imm(1, 1);
        this.asm.shlR64Imm(1, 3);
        this.asm.addRR64(0, 1);
        this.asm.movRMBase(1, 5, dKey);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRMBase(1, 5, dVal);
        this.asm.movMBaseR(0, 1, 8);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.movRMBase(1, 0, -8);
        this.asm.addRI32(1, 1);
        this.asm.movMBaseR(0, 1, -8);
        this.asm.movRI64(0, 0);
        this.asm.bindLabel(eL);
    }

    public void genDictContains(Node call) {
        Node dictNode = call.child(0);
        Node keyNode = call.child(1);
        this.genExpr(dictNode);
        int dBase = this.allocLocal("__dc_base");
        this.asm.movMBaseR(5, 0, dBase);
        this.genExpr(keyNode);
        int dKey = this.allocLocal("__dc_key");
        this.asm.movMBaseR(5, 0, dKey);
        int dI = this.allocLocal("__dc_i");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, dI);
        int lL = this.newLabel();
        int fL = this.newLabel();
        int nL = this.newLabel();
        int eL = this.newLabel();
        int iter = this.newLabel();
        this.asm.bindLabel(lL);
        this.asm.movRMBase(0, 5, dI);
        this.asm.movRMBase(1, 5, dBase);
        this.asm.movRMBase(1, 1, -8);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(nL);
        this.asm.movRMBase(0, 5, dI);
        this.asm.shlR64Imm(0, 1);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(11, 0);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.addRR64(0, 11);
        this.asm.movRMBase(1, 0, 0);
        this.asm.cmpRI32(1, 0);
        this.asm.jeLabel(iter);
        this.asm.movRR64(1, 1);
        this.asm.movRMBase(2, 5, dKey);
        this.addImportPatch("ucrtbase.dll", "strcmp");
        int sCmp3 = 0xDEADBEEFCAFEBADD;
        this.asm.emitImm64(0, sCmp3);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(fL);
        this.asm.bindLabel(iter);
        this.asm.movRMBase(0, 5, dI);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, dI);
        this.asm.jmpLabel(lL);
        this.asm.bindLabel(fL);
        this.asm.movRI64(0, 1);
        this.asm.jmpLabel(eL);
        this.asm.bindLabel(nL);
        this.asm.xorRR64(0, 0);
        this.asm.bindLabel(eL);
    }

    public void genValueFactoryCall(Node call) {
        // Value.makeXxx(...) builtin tagged-union factory: allocate a 112-byte
        // zeroed block, set the tag and payload at the fixed Value offsets.
        string m = call.name;
        this.asm.emitImm64(1, 112);
        this.addImportPatch("msvcrt.dll", "malloc");
        int sV0 = 0xDEADBEEFCAFEBAB0;
        this.asm.emitImm64(0, sV0);
        this.asm.movRMBase(11, 0, 0);
        this.asm.xorRR64(0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(11);
        this.asm.emitCallTeardown();
        int vP = this.allocLocal("__val_ptr");
        this.asm.movMBaseR(5, 0, vP);
        for (int zi = 0; zi < 14; zi++) {
            this.asm.movRMBase(0, 5, vP);
            this.asm.movRI64(1, 0);
            this.asm.movMBaseR(0, 1, zi * 8);
        }
        int[] vArgs = [];
        // child(0) is the `Value` receiver; arguments start at child(1).
        for (int ai = 1; ai < call.childCount(); ai++) {
            this.genExpr(call.child(ai));
            int t = this.allocLocal("__val_arg");
            this.asm.movMBaseR(5, 0, t);
            vArgs.add(t);
        }
        int tag = 0;
        int fOff = 8;
        if (this.strEq(m, "makeInt")) { tag = 1; fOff = 8; }
        elif (this.strEq(m, "makeFloat")) { tag = 2; fOff = 16; }
        elif (this.strEq(m, "makeBool")) { tag = 3; fOff = 24; }
        elif (this.strEq(m, "makeString")) { tag = 4; fOff = 32; }
        elif (this.strEq(m, "makeChar")) { tag = 5; fOff = 40; }
        elif (this.strEq(m, "makeArray")) { tag = 6; fOff = 48; }
        elif (this.strEq(m, "makeTuple")) { tag = 7; fOff = 48; }
        elif (this.strEq(m, "makeObject")) { tag = 8; fOff = 56; }
        elif (this.strEq(m, "makeFunc")) { tag = 9; fOff = 72; }
        elif (this.strEq(m, "makeBuiltin")) { tag = 10; fOff = 72; }
        elif (this.strEq(m, "makeClassInst")) { tag = 12; fOff = 56; }
        elif (this.strEq(m, "makeEnumVal")) { tag = 13; fOff = 64; }
        elif (this.strEq(m, "makeDict")) { tag = 15; fOff = 56; }
        this.asm.movRMBase(0, 5, vP);
        this.asm.movRI64(1, tag);
        this.asm.movMBaseR(0, 1, 0);
        if (vArgs.length > 0) {
            this.asm.movRMBase(0, 5, vP);
            this.asm.movRMBase(1, 5, vArgs[0]);
            this.asm.movMBaseR(0, 1, fOff);
        }
        if (this.strEq(m, "makeEnumVal")) {
            if (vArgs.length > 1) {
                this.asm.movRMBase(0, 5, vP);
                this.asm.movRMBase(1, 5, vArgs[1]);
                this.asm.movMBaseR(0, 1, 32);
            }
        }
        // strVal = "" so printing or concatenating a value that never received
        // a string payload cannot dereference a null pointer.
        this.asm.movRMBase(0, 5, vP);
        this.asm.pushR64(0);
        Node es = new Node(); es.kind = 2; es.strVal = "";
        this.genExpr(es);
        this.asm.movRR64(1, 0);
        this.asm.popR64(0);
        this.asm.movMBaseR(0, 1, 32);
        this.asm.movRMBase(0, 5, vP);
    }

public void genNewCall(Node call) {
    int size = 16;
    for (int i = 0; i < this.classNames.length; i++) {
        if (this.strEq(this.classNames[i], call.name)) {
            int cnt = this.classFieldCounts[i];
            size = cnt * 8;
            if (size < 16) { size = 16; }
        }
    }
    this.asm.emitImm64(1, size);
    this.addImportPatch("msvcrt.dll", "malloc");
    int s4 = 0xDEADBEEFCAFEBAB0;            this.asm.emitImm64(0, s4);
            this.asm.movRMBase(11, 0, 0);
            this.asm.xorRR64(0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(11);
            this.asm.emitCallTeardown();
            int tmpOff = this.allocLocal("__new_tmp");
    this.asm.movMBaseR(5, 0, tmpOff);
    int[] argRegs = [1, 2, 8, 9];
    int nargs = call.childCount();
    int[] argTemps = [];
    for (int i = 0; i < nargs; i++) {
        bool convertedMessageArray = false;
        // ChatCompletionRequest's second parameter is ChatMessage[]. Lower
        // anonymous `{role: ..., content: ...}` entries to actual objects.
        bool hasAnonymousMessage = false;
        if (call.child(i).kind == 19 && call.child(i).childCount() > 0) {
            if (call.child(i).child(0).kind == 66) { hasAnonymousMessage = true; }
        }
        if (this.strEq(call.name, "ChatCompletionRequest") && i == 1 && hasAnonymousMessage) {
            int count = call.child(i).childCount();
            int capacity = 8;
            int allocSize = (capacity + 2) * 8;
            this.asm.emitImm64(1, allocSize);
            this.addImportPatch("msvcrt.dll", "malloc");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            int msgArr = this.allocLocal("__msg_arr");
            this.asm.movMBaseR(5, 0, msgArr);
            this.asm.movRMBase(0, 5, msgArr);
            this.asm.emitImm64(1, capacity);
            this.asm.movMBaseR(0, 1, 0);
            this.asm.movRMBase(0, 5, msgArr);
            this.asm.emitImm64(1, count);
            this.asm.movMBaseR(0, 1, 8);
            for (int mi = 0; mi < count; mi++) {
                Node literal = call.child(i).child(mi);
                Node fake = new Node(); fake.kind = 10; fake.name = "ChatMessage";
                for (int mf = 0; mf < literal.childCount(); mf++) {
                    Node pair = literal.child(mf);
                    if (pair.kind == 18 && pair.childCount() > 1) {
                        fake.children.add(pair.child(1));
                    }
                }
                this.genNewCall(fake);
                this.asm.movRMBase(1, 5, msgArr);
                this.asm.movMBaseR(1, 0, 16 + mi * 8);
            }
            this.asm.movRMBase(0, 5, msgArr);
            this.asm.addRI32(0, 16);
            convertedMessageArray = true;
        }
        if (!convertedMessageArray) {
            this.genExpr(call.child(i));
        }
        int t = this.allocLocal("__na");
        this.asm.movMBaseR(5, 0, t);
        argTemps.add(t);
    }
    int ctorIdx = -1;
    for (int i = 0; i < this.funcNames.length; i++) {
        if (this.strEq(this.funcNames[i], "construct") && this.strEq(this.funcClasses[i], call.name)) {
            ctorIdx = i;
        }
    }
    if (ctorIdx >= 0 && ctorIdx < this.funcOffsets.length) {
        int paramCount = this.funcParamCounts[ctorIdx];
        int paramStart = this.funcParamStarts[ctorIdx];
        for (int di = nargs; di < paramCount; di++) {
            int defaultIndex = paramStart + di;
            if (defaultIndex < this.funcParamDefaults.length) {
                this.genExpr(this.funcParamDefaults[defaultIndex]);
            } else {
                this.asm.xorRR64(0, 0);
            }
            int dt = this.allocLocal("__nd");
            this.asm.movMBaseR(5, 0, dt);
            argTemps.add(dt);
        }
        nargs = argTemps.length;
        // Constructor ABI: RCX = `this` (the new instance), RDX/R8/R9 = first
        // three declared params, params 4+ go on the caller stack after the
        // 32-byte shadow space ([RSP+32], [RSP+40], ...).  Spill every
        // argument to the shadow/stack slots first (nested call in a later
        // argument would clobber the volatile argument registers), then load
        // the registers.
        int extraStack = 0;
        if (nargs > 3) { extraStack = (nargs - 3) * 8; }
        this.asm.emitCallSetup(extraStack);
        this.asm.movRMBase(0, 5, tmpOff);
        this.asm.movMBaseR(4, 0, 0);
        for (int i = 0; i < nargs; i++) {
            this.asm.movRMBase(0, 5, argTemps[i]);
            if (i < 3) {
                this.asm.movMBaseR(4, 0, 8 + i * 8);
            } else {
                this.asm.movMBaseR(4, 0, 32 + (i - 3) * 8);
            }
        }
        this.asm.movRMBase(1, 5, tmpOff);
        for (int i = 0; i < nargs && i < 3; i++) {
            this.asm.movRMBase(argRegs[i + 1], 5, argTemps[i]);
        }
        if (this.funcOffsets[ctorIdx] >= 0) {
            int targetOff = this.funcOffsets[ctorIdx];
            int callPos = this.asm.buf.length;
            int rel32 = targetOff - (callPos + 5);
            this.asm.callRel32(rel32);
        } else {
            this.asm.callRel32(0);
            this.forwardCalls.add(this.asm.buf.length - 4);
            this.forwardCallNames.add("construct");
            this.forwardCallClasses.add(call.name);
        }
        this.asm.emitCallTeardown();
    }
    this.asm.movRMBase(0, 5, tmpOff);
}

    public void genSuperCall(Node call) {
        // super(arg0, arg1, ...) - call parent class constructor with `this`.
        // Only valid inside a class constructor.
        if (!this.strEq(this.currentFunctionName, "construct")) { return; }

        // Find parent class of the current class.
        string parentClass = "";
        for (int i = 0; i < this.classNames.length; i++) {
            if (this.strEq(this.classNames[i], this.currentClassName)) {
                parentClass = this.classParentClasses[i];
            }
        }
        if (this.strEq(parentClass, "")) { return; }

        // Find parent's construct function.
        int ctorIdx = -1;
        for (int i = 0; i < this.funcNames.length; i++) {
            if (this.strEq(this.funcNames[i], "construct") && this.strEq(this.funcClasses[i], parentClass)) {
                ctorIdx = i;
            }
        }
        if (ctorIdx < 0 || ctorIdx >= this.funcOffsets.length) { return; }

        // Evaluate super() arguments into temporary stack slots.
        int nargs = call.childCount();
        int[] argTemps = [];
        for (int i = 0; i < nargs; i++) {
            this.genExpr(call.child(i));
            int t = this.allocLocal("__sa");
            this.asm.movMBaseR(5, 0, t);
            argTemps.add(t);
        }

        // Set up the call: R1 = this, R2..R9 = args 0-2, stack = rest.
        int[] argRegs = [1, 2, 8, 9];
        int extraStack = 0;
        if (nargs > 3) { extraStack = (nargs - 3) * 8; }
        this.asm.emitCallSetup(extraStack);
        // Load `this` directly from its local slot into R1.
        this.asm.movRMBase(1, 5, this.findLocal("this"));   // R1 = this
        for (int i = 0; i < nargs; i++) {
            if (i < 3) {
                this.asm.movRMBase(argRegs[i + 1], 5, argTemps[i]);
            } else {
                this.asm.movRMBase(0, 5, argTemps[i]);
                this.asm.movMBaseR(4, 0, 32 + (i - 3) * 8);
            }
        }

        // Call the parent constructor.
        int targetOff = this.funcOffsets[ctorIdx];
        if (targetOff >= 0) {
            int callPos = this.asm.buf.length;
            int rel32 = targetOff - (callPos + 5);
            this.asm.callRel32(rel32);
        } else {
            this.asm.callRel32(0);
            this.forwardCalls.add(this.asm.buf.length - 4);
            this.forwardCallNames.add("construct");
            this.forwardCallClasses.add(parentClass);
        }
        this.asm.emitCallTeardown();
    }

    public int asmOperand(Node expr) {
        if (expr.kind == 0) { return expr.intVal; }
        if (expr.kind == 6) { return this.findLocal(expr.name); }
        return 0;
    }

    public void genAsmCall(Node call) {
        string name = call.name;
        if (this.strEq(name, "ret")) {
            this.asm.ret();
            return;
        }
        if (this.strEq(name, "label")) {
            string lbl = "";
            if (call.childCount() > 0 && call.child(0).kind == 2) {
                lbl = call.child(0).strVal;
            }
            this.asm.label(lbl);
            return;
        }
        if (this.strEq(name, "bindLabel")) {
            int id = 0;
            if (call.childCount() > 0) {
                id = this.asmOperand(call.child(0));
            }
            this.asm.bindLabel(id);
            return;
        }
        if (this.strEq(name, "emitImm64")) {
            int reg = 0;
            int64 imm = 0;
            if (call.childCount() > 1) {
                reg = this.asmOperand(call.child(1));
            }
            if (call.childCount() > 2) {
                Node immNode = call.child(2);
                if (immNode.kind == 0) {
                    imm = immNode.intVal;
                } elif (immNode.kind == 6) {
                    imm = this.findLocal(immNode.name);
                }
            }
            this.asm.emitImm64(reg, imm);
            return;
        }
        // NOTE: avoid `continue` inside this for-loop on purpose: old compiler
        // builds miscompile continue-in-for (they skip the increment), which
        // breaks self-hosting bootstrap. Use if/else instead.
        int[] args = [];
        for (int i = 0; i < call.childCount(); i++) {
            Node c = call.child(i);
            if (c.kind != 13) {
                args.add(this.asmOperand(c));
            }
        }
        if (this.strEq(name, "pushR64")) { this.asm.pushR64(args[0]); }
        elif (this.strEq(name, "popR64")) { this.asm.popR64(args[0]); }
        elif (this.strEq(name, "movRR64")) { this.asm.movRR64(args[0], args[1]); }
        elif (this.strEq(name, "movRI64")) {
            int64 v = 0;
            if (call.childCount() > 1) { v = this.asmOperand(call.child(1)); }
            this.asm.movRI64(args[0], v);
        }
        elif (this.strEq(name, "movRMBase")) { this.asm.movRMBase(args[0], args[1], args[2]); }
        elif (this.strEq(name, "movMBaseR")) { this.asm.movMBaseR(args[0], args[1], args[2]); }
        elif (this.strEq(name, "subRI32")) { this.asm.subRI32(args[0], args[1]); }
        elif (this.strEq(name, "addRI32")) { this.asm.addRI32(args[0], args[1]); }
        elif (this.strEq(name, "xorRR64")) { this.asm.xorRR64(args[0], args[1]); }
        elif (this.strEq(name, "cmpRI32")) { this.asm.cmpRI32(args[0], args[1]); }
        elif (this.strEq(name, "cmpRR64")) { this.asm.cmpRR64(args[0], args[1]); }
        elif (this.strEq(name, "callR64")) { this.asm.callR64(args[0]); }
        elif (this.strEq(name, "leaRBase")) { this.asm.leaRBase(args[0], args[1], args[2]); }
        elif (this.strEq(name, "emitU8")) { this.asm.emitU8(args[0]); }
        elif (this.strEq(name, "emitU32")) { this.asm.emitU32(args[0]); }
        elif (this.strEq(name, "emitImm64")) { this.asm.emitImm64(args[0], args[1]); }
        elif (this.strEq(name, "emitCallSetup")) { this.asm.emitCallSetup(args[0]); }
        elif (this.strEq(name, "emitCallTeardown")) { this.asm.emitCallTeardown(); }
        elif (this.strEq(name, "addRR64")) { this.asm.addRR64(args[0], args[1]); }
        elif (this.strEq(name, "subRR64")) { this.asm.subRR64(args[0], args[1]); }
        elif (this.strEq(name, "mulRR64")) { this.asm.mulRR64(args[0]); }
        elif (this.strEq(name, "andRImm")) { this.asm.andRImm(args[0], args[1]); }
        elif (this.strEq(name, "shlR64Imm")) { this.asm.shlR64Imm(args[0], args[1]); }
        elif (this.strEq(name, "incR64")) { this.asm.incR64(args[0]); }
        elif (this.strEq(name, "decR64")) { this.asm.decR64(args[0]); }
        elif (this.strEq(name, "movByteMBaseIdxR")) { this.asm.movByteMBaseIdxR(args[0], args[1], args[2]); }
        elif (this.strEq(name, "movMBaseByteR")) { this.asm.movMBaseByteR(args[0], args[1], args[2]); }
        elif (this.strEq(name, "jeLabel")) { this.asm.jeLabel(args[0]); }
        elif (this.strEq(name, "jneLabel")) { this.asm.jneLabel(args[0]); }
        elif (this.strEq(name, "jmpLabel")) { this.asm.jmpLabel(args[0]); }
        elif (this.strEq(name, "jlLabel")) { this.asm.jlLabel(args[0]); }
        elif (this.strEq(name, "jleLabel")) { this.asm.jleLabel(args[0]); }
        elif (this.strEq(name, "jgLabel")) { this.asm.jgLabel(args[0]); }
        elif (this.strEq(name, "jgeLabel")) { this.asm.jgeLabel(args[0]); }
        elif (this.strEq(name, "movzxByteMBase")) { this.asm.movzxByteMBase(args[0], args[1], args[2]); }
        elif (this.strEq(name, "callRel32")) { this.asm.callRel32(args[0]); }
    }

    public void genUserCall(Node call) {
        string name = call.name;
        // Module-qualified call (e.g. json_runtime.get(x, "y") inside a class
        // method). The receiver is an identifier that is neither a user-class
        // instance nor `this`, so it names a module: the target must resolve
        // to the GLOBAL function, never to a method of the current class
        // (SessionStore.get would otherwise shadow json_runtime.get).
        bool isModuleCall = false;
