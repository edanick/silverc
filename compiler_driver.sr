// Timing and pid identity ride the universal std modules (time -> QPC behind
// its own #on WINDOWS regions; sysinfo -> GetCurrentProcessId likewise). No
// bare win32 import remains in the driver: the only raw OS surface left is
// the JIT child-process runner, whose calls sit inside #on WINDOWS / #on
// LINUX / #on MAC regions (see jitExecute) because process.run cannot supply
// its contract (no exit code, faults on self-host — see that function's
// comment).
import * from time;
import * from datetime;
import * from sysinfo;
#on LINUX
import * from linux.libc;
#on MAC
import * from mac.libsystem;
#off

// Print the final success line on STDERR (alongside the progress lines) once
// a compile has produced its output: `<output> (N modules, Xs)`. `moduleCount`
// is the number of modules (entry + collected imports/sources) processed and
// `startMs` when the compile pass started. The elapsed computation rides the
// universal time module: time.now() is QPC (monotonic, float64 ms since
// boot-referenced counter), so successive readings are strictly comparable —
// an equivalent monotonic basis to the GetTickCount deltas this replaces
// (better, in fact: GetTickCount can jump with wall-clock changes).
void drvReportSuccess(string outputFile, int moduleCount, float64 startMs) {
    int elapsedMs = int(time.now() - startMs);
    if (elapsedMs < 0) { elapsedMs = 0; }
    eprintln("compilation successful: " + outputFile + " (" + (string)moduleCount + " modules, " + formatDuration(elapsedMs / 1000) + ")");
}

// Per-file cache markers: when --cache-bytecode is active the aggregate
// source carries one marker comment line before each collected file so the
// driver can split it back into per-file chunks and route each through the
// bytecode cache. Marker lines are plain comments to every other stage.
string cacheMarkerPrefix() {
    return "//@@SILVER_FILE@@ ";
}

