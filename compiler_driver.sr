    printline("Silver Compiler v0.7.9.4");
    printline("Copyright: © 2025 Edan M.");
    printline("Silver for macOS: Copyright © 2026 StavA - macOS support,");
    printline("macOS compiler support, maintainer and QA of the macOS version");
    printline("(unit tests). Programming language creator: Edan M.");
    printline("");
    printline("Usage:");
#on WINDOWS
    printline("  silverc [options] [<input.sr> [<output.exe>]]");
    printline("  silverc -i <input.sr> -o <output.exe>");
#on LINUX
    printline("  silverc [options] [<input.sr> [<output>]]");
    printline("  silverc -i <input.sr> -o <output>");
#on MAC
    printline("  silverc [options] [<input.sr> [<output>]]");
    printline("  silverc -i <input.sr> -o <output>");
#off
    printline("  silverc <project.srp> [flags]");
    printline("");
    printline("Options:");
    printline("  -h, --help, -?    Show this help message");
    printline("  -v, --version     Show compiler and language version");
    printline("  -i <file>         Input Silver source file (default: compiler_driver.sr)");
#on WINDOWS
    printline("  -o <file>         Output executable file (default: silverc.exe)");
#on LINUX
    printline("  -o <file>         Output executable file (default: silverc)");
#on MAC
    printline("  -o <file>         Output executable file (default: silverc)");
#off
    printline("");
    printline("Execution modes (mutually exclusive):");
    printline("  --aot             Ahead-of-time compilation (default pipeline)");
    printline("  --jit             Compile then execute in this run");
    printline("  --runtime         Embed the full runtime (allocator + GC)");
    printline("");
    printline("Independent flags:");
    printline("  --optimize        Dead-code elimination + constant folding + peephole");
#on WINDOWS
    printline("  --cache-bytecode  Persistent bytecode cache (APPDATA\\silver cache)");
#on LINUX
    printline("  --cache-bytecode  Persistent bytecode cache (/var/cache/silver)");
#on MAC
    printline("  --cache-bytecode  Persistent bytecode cache (/Library/Caches/Silver)");
#off
    printline("  --cache-object    Persistent per-target object cache (<os>-<arch> under the same root)");
    printline("  --watch           Predictive precompilation watcher");
    printline("  --threads <N>     Explicit worker count (default: total threads - 2)");
    printline("  --os windows|linux|mac|macx64  Target OS (default: host; WINDOWS, LINUX, MAC, MACX64)");
    printline("  --debug           Debug build-mode: feeds `#on DEBUG` regions (default is release)");
    printline("  --release         Release is the default build mode, no flag needed - don't use this. Not a flag: prints a notice (default mode is release) and exits");
    printline("");
    printline("Examples:");
    printline("  silverc --help");
#on WINDOWS
    printline("  silverc input.sr output.exe");
    printline("  silverc -i input.sr -o output.exe");
#on LINUX
    printline("  silverc input.sr output");
    printline("  silverc -i input.sr -o output");
#on MAC
    printline("  silverc input.sr output");
    printline("  silverc -i input.sr -o output");
#off
    printline("");
    printline("Run with --help to show this message.");
}

// Read a file, returning the empty string when it does not exist.  The fs
// builtin `file.readString` throws FileNotFoundException on a missing path,
// so path-probing code routes through this helper instead of relying on a
// sentinel empty-string return.
string tryReadFile(string path) {
    string result = "";
    try {
        result = file.readString(path);
    } catch (int e) {
        result = "";
    }
    return result;
}

// DOCS/260 — run the `#on`/`#else`/`#off` preprocessor over one file's text.
// On a region error the messages print to stderr and the compile aborts with
// status 1 (matching silverc-rs). Empty input passes through unchanged.
// `debugBuild` selects the build-mode axis (`#on DEBUG` vs `#on RELEASE`);
// callers forward the --debug flag so every file filters alike.
string drvPreprocessOrDie(string src, bool debugBuild) {
    string[] ppErrs = [];
    string target = ppTargetOs();
    string out = ppPreprocess(src, target, debugBuild, ppErrs);
    if (ppErrs.length > 0) {
        for (int peI = 0; peI < ppErrs.length; peI++) {
            eprintln(ppErrs[peI]);
        }
        exit(1);
    }
    return out;
}

// File stem of a path: characters after the last separator, extension
// removed.
string drvFileStem(string path) {
    int last = -1;
    for (int i = 0; i < path.length; i++) {
        if (path[i] == '\\' || path[i] == '/') { last = i; }
    }
    string name = path;
    if (last >= 0) { name = projectSlice(path, last + 1, path.length); }
    int dot = -1;
    for (int j = name.length - 1; j >= 0; j--) {
        if (name[j] == '.') { dot = j; break; }
    }
    if (dot > 0) { return projectSlice(name, 0, dot); }
    return name;
}

// Locate a source-level module by name, returning its path (or "" when the
// module is native/builtin or cannot be found). The candidate paths mirror
// silverc-rs's resolve_imports: the input file's directory first (sibling
// modules such as helper.sr), then std/ and silveri/src in the locations the
// test suites and checkouts use.
// Nested module resolution (flat-first) mirrors push_module_candidates:
// per base dir `<name>.sr` first, then dotted `a.b` -> `a/b.sr`, then the
// `<name>/<name>.sr` package convention.
//
// Every static path piece is one `*"..."` path literal (DOCS/257) in
// forward-slash spelling: no OS regions anywhere in this function, correct
// separators on every target (Windows rewrites byte-identical to the old
// backslash ladder). Dotted names always probe the `/` mapping, which the
// OS file APIs accept on Windows too; runtime-built prefixes (sibBase,
// exeDir) already carry native separators and are concatenated as-is.

// Map dots in `name` to `sep` (`mini_cg.windows` -> `mini_cg/windows.sr`
// with sep "/").
string drvDottedPath(string name, string sep) {
    string[] parts = [];
    for (int i = 0; i < name.length; i++) {
        if (name[i] == '.') { parts.add(sep); }
        else { parts.add((string)name[i]); }
    }
    return parts.join("");
}

// True when `name` is a dotted child of the baked-in `root` module
// (`mini_cg.windows` under `mini_cg`).
bool drvIsDottedChild(string name, string root) {
    if (name.length <= root.length) { return false; }
    return projectFind(name, root + ".", 0) == 0;
}

// Directory holding this compiler binary (from cargs[0]), or "" when the
// executable name carries no path (bare name on PATH). Captured INLINE in
// main() from its already-rebuilt `args` copy: the bootstrap's Linux cargs
// lowering rebuilds argv from RBP, which is only valid in main-as-entry
// (silverc-rs emit_cargs_linux known gap) — reading cargs inside any called
// helper segfaults, so no drvExeDir() helper may exist; every consumer below
// receives the captured `exeDir` string as a parameter.
// Module resolution probes `<exeDir>\std\` and `<exeDir>\compiler\` before
// any cwd-relative tree so a foreign cwd can never shadow the library the
// compiler shipped with (mirrors silverc-rs exe-ancestor probing): e.g.
// running the test suites from silverc-rs/ must not pick up its stale std
// stubs instead of silverc/std. User files still win — input siblings and
// cwd-bare names are probed before this tree.

// Read `rel` (a compiler-tree-relative path with a leading separator, spelled
// as a `*"..."` path literal like `*"/std/llmai.sr"` so it normalizes per OS)
// from the compiler's own directory; "" when unavailable so callers fall
// through to the historical cwd-relative ladder. `exeDir` arrives from main()
// (captured inline there): this helper must never read cargs itself.
string drvTryExeTree(string exeDir, string rel) {
    if (exeDir.length == 0) { return ""; }
    return tryReadFile(exeDir + rel);
}

string findModulePath(string name, string inputFile, string exeDir) {
    if (projectBuiltin(name)) { return ""; }
    // Modules the driver already prepends above (llmai/exception/bom/process/
    // notifications) and the compiler's own baked-in modules must not be
    // re-collected from disk: that would duplicate their definitions.  Source
    // modules shared by name with the compiler internals (lexer, token) are
    // NOT excluded: a standalone program imports the sibling/source-level
    // module, exactly as silverc-rs resolves `import lexer;` / `import token;`.
    // Dotted children of the baked-ins (mini_cg.windows, mini_asm.*,
    // mini_ef.*, parser.*, node.*, project.*, ...) are excluded too:
    // standalone user programs must never pull compiler internals from disk
    // (the .srp move phase wires the real nested backends instead).
    if ( name == "project"
        || name == "exception" || name == "bom"
        || name == "process" || name == "notifications"
        || name == "http" || name == "mini_asm"
        || name == "mini_cg" || name == "mini_ef"
        || name == "parser" || name == "node"
        || drvIsDottedChild(name, "project") || drvIsDottedChild(name, "exception")
        || drvIsDottedChild(name, "bom") || drvIsDottedChild(name, "process")
        || drvIsDottedChild(name, "notifications") || drvIsDottedChild(name, "http")
        || drvIsDottedChild(name, "mini_asm") || drvIsDottedChild(name, "mini_cg")
        || drvIsDottedChild(name, "mini_ef") || drvIsDottedChild(name, "parser")
        || drvIsDottedChild(name, "node")) { return ""; }
    bool drvHasDot = projectFind(name, ".", 0) >= 0;
    string drvDottedSlash = drvDottedPath(name, "/");
    string[] candidates = [];
    // Same directory as the input source (sibling modules). The sibling
    // prefix carries the input file's own separator; flat `<name>.sr` stays
    // first, then the nested layouts in `/` spelling (valid on Windows too).
    int lastSep = -1;
    for (int ci = 0; ci < inputFile.length; ci++) {
        if (inputFile[ci] == '\\' || inputFile[ci] == '/') { lastSep = ci; }
    }
    if (lastSep >= 0) {
        string sibBase = projectSlice(inputFile, 0, lastSep + 1);
        candidates.add(sibBase + name + ".sr");
        if (drvHasDot) {
            candidates.add(sibBase + drvDottedSlash + ".sr");
        }
        candidates.add(sibBase + name + *"/" + name + ".sr");
        // Library subdirectory (`<sibBase>/std/`): sources that keep their
        // own modules under src/std/ (flat, dotted, packaged). Probed after
        // the plain sibling layouts so existing resolutions never move.
        candidates.add(sibBase + *"std/" + name + ".sr");
        if (drvHasDot) {
            candidates.add(sibBase + *"std/" + drvDottedSlash + ".sr");
        }
        candidates.add(sibBase + *"std/" + name + *"/" + name + ".sr");
    }
    candidates.add(name + ".sr");
    if (drvHasDot) {
        candidates.add(drvDottedSlash + ".sr");
    }
    candidates.add(name + *"/" + name + ".sr");
    // The compiler's own tree (exe-relative, captured inline in main()) beats
    // every cwd-relative tree below: a foreign cwd std/ (e.g. silverc-rs/std
    // when the suites run from there) must never shadow silverc/std.
    if (exeDir.length > 0) {
        candidates.add(exeDir + *"/std/" + name + ".sr");
        if (drvHasDot) { candidates.add(exeDir + *"/std/" + drvDottedSlash + ".sr"); }
        candidates.add(exeDir + *"/std/" + name + *"/" + name + ".sr");
        candidates.add(exeDir + *"/compiler/" + name + ".sr");
        if (drvHasDot) { candidates.add(exeDir + *"/compiler/" + drvDottedSlash + ".sr"); }
        candidates.add(exeDir + *"/compiler/" + name + *"/" + name + ".sr");
    }
    candidates.add(*"std/" + name + ".sr");
    if (drvHasDot) { candidates.add(*"std/" + drvDottedSlash + ".sr"); }
    candidates.add(*"std/" + name + *"/" + name + ".sr");
    candidates.add(*"silverc/std/" + name + ".sr");
    if (drvHasDot) { candidates.add(*"silverc/std/" + drvDottedSlash + ".sr"); }
    candidates.add(*"silverc/std/" + name + *"/" + name + ".sr");
    candidates.add(*"../std/" + name + ".sr");
    if (drvHasDot) { candidates.add(*"../std/" + drvDottedSlash + ".sr"); }
    candidates.add(*"../std/" + name + *"/" + name + ".sr");
    candidates.add(*"../silverc/std/" + name + ".sr");
    if (drvHasDot) { candidates.add(*"../silverc/std/" + drvDottedSlash + ".sr"); }
    candidates.add(*"../silverc/std/" + name + *"/" + name + ".sr");
    candidates.add(*"../../std/" + name + ".sr");
    if (drvHasDot) { candidates.add(*"../../std/" + drvDottedSlash + ".sr"); }
    candidates.add(*"../../std/" + name + *"/" + name + ".sr");
    candidates.add(*"../../silverc/std/" + name + ".sr");
    if (drvHasDot) { candidates.add(*"../../silverc/std/" + drvDottedSlash + ".sr"); }
    candidates.add(*"../../silverc/std/" + name + *"/" + name + ".sr");
    // Compiler-internal modules (e.g. progress.sr) live under compiler/.
    // stdlib modules that import them (project -> progress) must resolve them
    // for standalone compiles, not just .srp builds. std/ stays ahead so
    // stdlib names never get shadowed by a same-named compiler module.
    candidates.add(*"compiler/" + name + ".sr");
    if (drvHasDot) { candidates.add(*"compiler/" + drvDottedSlash + ".sr"); }
    candidates.add(*"compiler/" + name + *"/" + name + ".sr");
    candidates.add(*"silverc/compiler/" + name + ".sr");
    if (drvHasDot) { candidates.add(*"silverc/compiler/" + drvDottedSlash + ".sr"); }
    candidates.add(*"silverc/compiler/" + name + *"/" + name + ".sr");
    candidates.add(*"../compiler/" + name + ".sr");
    if (drvHasDot) { candidates.add(*"../compiler/" + drvDottedSlash + ".sr"); }
    candidates.add(*"../compiler/" + name + *"/" + name + ".sr");
    candidates.add(*"../silverc/compiler/" + name + ".sr");
    if (drvHasDot) { candidates.add(*"../silverc/compiler/" + drvDottedSlash + ".sr"); }
    candidates.add(*"../silverc/compiler/" + name + *"/" + name + ".sr");
    candidates.add(*"../../compiler/" + name + ".sr");
    if (drvHasDot) { candidates.add(*"../../compiler/" + drvDottedSlash + ".sr"); }
    candidates.add(*"../../compiler/" + name + *"/" + name + ".sr");
    candidates.add(*"../../silverc/compiler/" + name + ".sr");
    if (drvHasDot) { candidates.add(*"../../silverc/compiler/" + drvDottedSlash + ".sr"); }
    candidates.add(*"../../silverc/compiler/" + name + *"/" + name + ".sr");
    candidates.add(*"../silveri/src/" + name + ".sr");
    if (drvHasDot) { candidates.add(*"../silveri/src/" + drvDottedSlash + ".sr"); }
    candidates.add(*"../silveri/src/" + name + *"/" + name + ".sr");
    candidates.add(*"silveri/src/" + name + ".sr");
    if (drvHasDot) { candidates.add(*"silveri/src/" + drvDottedSlash + ".sr"); }
    candidates.add(*"silveri/src/" + name + *"/" + name + ".sr");
    candidates.add(*"../../silveri/src/" + name + ".sr");
    if (drvHasDot) { candidates.add(*"../../silveri/src/" + drvDottedSlash + ".sr"); }
    candidates.add(*"../../silveri/src/" + name + *"/" + name + ".sr");
    for (int i = 0; i < candidates.length; i++) {
        string src = tryReadFile(candidates[i]);
        if (src.length > 0) { return candidates[i]; }
    }
    return "";
}

string cacheMarkerLine(string path) {
    return cacheMarkerPrefix() + path.normalize(path) + "\n";
}

// One output buffer for standalone import collection: per-module texts are
// appended here and joined once by collectImports. The old per-module
// `result += collectModule(...)` recursion left quadratic never-freed
// intermediates behind (one abandoned buffer per collected module).
class DrvSourcePieces {
    public prop string[] parts;

    construct {
        this.parts = [];
    }

    public void add(string s) {
        this.parts.add(s);
    }

    public string joinAll() {
        return this.parts.join("");
    }
}

// Module-resolution cache: each module name resolves to its path once per
// compile instead of being re-probed (dozens of file reads) per importer,
// per pass, and per probe. The stored path is the findModulePath hit itself,
// so progress lines and cache markers read byte-identically; the file text
// is read once and passed through to collectModuleInto, never re-read.
class DrvModuleCache {
    public prop string[] names;
    public prop string[] paths;

    construct {
        this.names = [];
        this.paths = [];
    }

    public int find(string name) {
        for (int i = 0; i < this.names.length; i++) {
            if (this.names[i] == name) { return i; }
        }
        return -1;
    }

    public string pathFor(string name) {
        int idx = this.find(name);
        if (idx < 0) { return ""; }
        return this.paths[idx];
    }

    public void store(string name, string path) {
        int idx = this.find(name);
        if (idx < 0) {
            this.names.add(name);
            this.paths.add(path);
            return;
        }
        this.paths[idx] = path;
    }
}

// Resolve one module name to its path, once per name per compile ("" when
// native/builtin/missing). Misses stay uncached: an unknown module aborts
// the compile, so no second probe ever happens. `exeDir` arrives from main()
// (captured inline there): this helper must never read cargs itself.
string drvCachedModulePath(string name, string inputFile, DrvModuleCache cache, string exeDir) {
    string hit = cache.pathFor(name);
    if (hit.length > 0) { return hit; }
    string resolved = findModulePath(name, inputFile, exeDir);
    if (resolved.length > 0) { cache.store(name, resolved); }
    return resolved;
}

// Recursively collect the sources of every non-builtin module imported by
// the module whose path and text are given, appending each module's own
// dependencies first into `out` (with the leading `mod export` line and
// inner import lines intact: the parser ignores import statements and
// `mod export` at the top level). A module is collected once (by name in
// `visited`, a ProjectVisited so growth past 8 modules stays visible to the
// caller). The pieces join once in collectImports. With emitMarkers set, one
// cache-marker comment line precedes each file's content so the aggregate
// can be split per file again (--cache-bytecode).
// When progress is non-null, one progress line is printed per module.
// `exeDir` arrives from main() (captured inline there): this helper must
// never read cargs itself.
void collectModuleInto(string name, string inputFile, string modPath, string modSrc, ProjectVisited visited, DrvModuleCache cache, bool emitMarkers, ProgressReporter progress, bool debugBuild, DrvSourcePieces out, string exeDir) {
    if (visited.contains(name)) { return; }
    visited.add(name);
    // DOCS/260 — filter the module BEFORE its imports are scanned so imports
    // inside non-matching regions are never resolved.
    string modFiltered = drvPreprocessOrDie(modSrc, debugBuild);
    modSrc = modFiltered;
    int cursor = 0;
    // Length read once (strlen is O(n)), not once per import occurrence.
    int modLen = modSrc.length;
    while (cursor < modLen) {
        int importPos = projectFind(modSrc, "import", cursor);
        if (importPos < 0) { break; }
        // Line-leading + whole-word guard: module sources contain the word
        // "import" in comments, strings and identifiers (e.g. `importPath`);
        // only a real statement may resolve a dependency. Mirrors
        // collectImports below.
        bool lineLeading = true;
        for (int bi = importPos - 1; bi >= 0; bi--) {
            char bc = modSrc[bi];
            if (bc == '\n') { break; }
            if (bc != ' ' && bc != '\t' && bc != '\r') { lineLeading = false; break; }
        }
        if (!lineLeading) {
            cursor = importPos + 6;
            continue;
        }
        if (importPos + 6 < modLen) {
            char ic = modSrc[importPos + 6];
            if (ic != ' ' && ic != '\t' && ic != '\r' && ic != '\n' && ic != '{' && ic != '*') {
                cursor = importPos + 6;
                continue;
            }
        }
        int semi = projectFind(modSrc, ";", importPos + 6);
        if (semi < 0) { break; }
        string statement = projectSlice(modSrc, importPos + 6, semi);
        string depName = projectImportModule(statement);
        if (depName.length > 0 && !visited.contains(depName)) {
            string depPath = drvCachedModulePath(depName, inputFile, cache, exeDir);
            if (depPath.length > 0) {
                string depText = tryReadFile(depPath);
                if (depText.length > 0) {
                    collectModuleInto(depName, inputFile, depPath, depText, visited, cache, emitMarkers, progress, debugBuild, out, exeDir);
                }
            }
        }
        cursor = semi + 1;
    }
    string marker = "";
    if (emitMarkers) { marker = cacheMarkerLine(modPath); }
    if (progress != null) { progress.moduleDone(modPath); }
    out.add(marker);
    out.add(modSrc);
    out.add("\n");
}

// Known built-in module names used for did-you-mean suggestions on imports.
string[] diagKnownModules() {
    string[] known = [];
    known.add("fs"); known.add("json"); known.add("yaml"); known.add("env");
    known.add("url"); known.add("hash"); known.add("path"); known.add("bom");
    known.add("console"); known.add("math"); known.add("http");
    return known;
}

// Compute the 1-based line and column of a character offset in src into loc
// (loc[0] = line, loc[1] = column).
void diagLocateOffset(string src, int off, int[] loc) {
    int total = src.length;
    if (off > total) { off = total; }
    if (off < 0) { off = 0; }
    int line = 1;
    int lineStart = 0;
    for (int i = 0; i < off; i++) {
        if (src[i] == '\n') { line++; lineStart = i + 1; }
    }
    loc[0] = line;
    loc[1] = off - lineStart + 1;
}

// `win32.<module>` imports name native DLL access, never Silver sources
// (DOCS/213).
bool importIsWin32(string name) {
    if (name.length < 5) { return false; }
    return name[0] == 'w' && name[1] == 'i' && name[2] == 'n' && name[3] == '3' && name[4] == '2';
}

// `linux` / `linux.<module>` imports name native Linux lib access, never
// Silver sources (LINUX.md Phase B). Mirrors importIsWin32.
bool importIsLinux(string name) {
    if (name.length < 5) { return false; }
    return name[0] == 'l' && name[1] == 'i' && name[2] == 'n' && name[3] == 'u' && name[4] == 'x';
}

// `mac` / `mac.<module>` imports name native macOS access, never Silver
// sources (MAC.md Phase C). Mirrors importIsLinux.
bool importIsMac(string name) {
    if (name.length < 3) { return false; }
    return name[0] == 'm' && name[1] == 'a' && name[2] == 'c';
}

string collectImports(string source, string inputFile, string ignored, string[] errs, bool emitMarkers, ProgressReporter progress, bool debugBuild, string exeDir) {
    ProjectVisited visited = new ProjectVisited();
    DrvModuleCache cache = new DrvModuleCache();
    DrvSourcePieces pieces = new DrvSourcePieces();
    int cursor = 0;
    // Length read once (strlen is O(n)), not once per import occurrence.
    int srcLen = source.length;
    while (cursor < srcLen) {
        int importPos = projectFind(source, "import", cursor);
        if (importPos < 0) { break; }
        // Only treat a line-leading `import` as an import statement: the
        // amalgamated compiler source contains the literal word "import" in
        // comments and string literals (e.g. projectFind(source, "import")),
        // and scanning those would resolve a bogus module name.
        bool lineLeading = true;
        for (int bi = importPos - 1; bi >= 0; bi--) {
            char bc = source[bi];
            if (bc == '\n') { break; }
            if (bc != ' ' && bc != '\t' && bc != '\r') { lineLeading = false; break; }
        }
        if (!lineLeading) {
            cursor = importPos + 6;
            continue;
        }
        // Whole-word check: reject matches glued to identifier characters
        // (e.g. an identifier spelled `importGroupIdx`). Structured as a
        // direct continue (no flag variable) for robustness.
        if (importPos + 6 < srcLen) {
            char inc = source[importPos + 6];
            if (inc != ' ' && inc != '\t' && inc != '\r' && inc != '\n' && inc != '{' && inc != '*') {
                cursor = importPos + 6;
                continue;
            }
        }
        int semi = projectFind(source, ";", importPos + 6);
        if (semi < 0) { break; }
        string statement = projectSlice(source, importPos + 6, semi);
        string moduleName = projectImportModule(statement);
        if (moduleName.length > 0 && !projectBuiltin(moduleName) && !importIsWin32(moduleName) && !importIsLinux(moduleName) && !importIsMac(moduleName) && moduleName != "project") {
            // Native builtin modules and the modules the driver prepends by
            // hand above always resolve; probing them would report a bogus
            // unknown-module error.
            bool prepended = moduleName == "llmai" || moduleName == "LLMAI"
                || moduleName == "exception" || moduleName == "bom"
                || moduleName == "process" || moduleName == "notifications"
                || moduleName == "env" || moduleName == "url"
                || moduleName == "hash" || moduleName == "path"
                || moduleName == "console" || moduleName == "math"
                || moduleName == "http" || moduleName == "os";
            if (!prepended && !visited.contains(moduleName)) {
                string depPath = drvCachedModulePath(moduleName, inputFile, cache, exeDir);
                string depText = "";
                if (depPath.length > 0) { depText = tryReadFile(depPath); }
                if (depText.length == 0) {
                    // SYNTAX_EXCEPTIONS.md — unknown module, with a did-you-mean
                    // suggestion when it resembles a known one.
                    int rel = projectFind(statement, moduleName, 0);
                    int absOff = importPos + 6;
                    if (rel >= 0) { absOff = importPos + 6 + rel; }
                    int[] loc = []; loc.add(0); loc.add(0);
                    diagLocateOffset(source, absOff, loc);
                    string sugg = array.findBestMatch(diagKnownModules(), moduleName);
                    if (sugg.length > 0) {
                        errs.add("did you mean to import the module \"" + sugg + "\"?, unknown module \"" + moduleName + "\" was found at line " + (string)loc[0] + " column " + (string)loc[1]);
                    } else {
                        errs.add("unknown module \"" + moduleName + "\" was found at line " + (string)loc[0] + ", column " + (string)loc[1] + ". module either doesn't exist or not installed.");
                    }
                } else {
                    collectModuleInto(moduleName, inputFile, depPath, depText, visited, cache, emitMarkers, progress, debugBuild, pieces, exeDir);
                }
            } else if (prepended && !visited.contains(moduleName)) {
                // Hand-prepended or native-backed modules (llmai, exception,
                // env, math, ...): never an unknown-module error, but their
                // source-level bodies (e.g. std/env.sr's set/keys, which the
                // self-host dispatches to as globals) still collect from disk
                // exactly like the old unconditional collectModule call did.
                string prePath = drvCachedModulePath(moduleName, inputFile, cache, exeDir);
                if (prePath.length > 0) {
                    string preText = tryReadFile(prePath);
                    if (preText.length > 0) {
                        collectModuleInto(moduleName, inputFile, prePath, preText, visited, cache, emitMarkers, progress, debugBuild, pieces, exeDir);
                    }
                }
            }
        }
        cursor = semi + 1;
    }
    if (emitMarkers) {
        pieces.add(cacheMarkerLine(inputFile));
    }
    pieces.add(source);
    return pieces.joinAll();
}

// ---------------------------------------------------------------------------
// OVERHAUL.md --jit: execute the emitted image as a direct child process
// (no shell involved — CreateProcessA maps straight onto the OS), wait for
// it to finish, and hand its exit code back to the caller.
//
// The spawn ladder stays raw `#on` regions (the one OS layer this driver
// carries): std process.run() cannot stand in for it — it passes a
// null lpProcessInformation (faults 0xC0000005 on the self-hosted compiler
// on every path, per the std/process.sr header), never waits explicitly, and
// hardcodes exitCode = 0 instead of reading the child's exit code, while the
// driver must propagate it. The universal scaffold (temp dir, unique path
// via sysinfo.pid(), image write, delete) stays ungated.
// LINUX branch (additive, below) mirrors this with a TEMP ELF +
// fork/execve/waitpid ladder via linux.libc; the WINDOWS ladder stays
// byte-identical.
// MAC branch (additive, below) mirrors this with a TEMP Mach-O +
// posix_spawn/waitpid ladder via mac.libsystem (Darwin has no bare fork:
// macos.rs deliberately absents fork/execve; posix_spawn is the native
// spawn). The WINDOWS/LINUX ladders stay byte-identical.
// ---------------------------------------------------------------------------

int jitExecute(CliFlags flags, int[] peData, string inputPath) {
    string tempBase = env.get("TEMP");
    if (tempBase.length == 0) { tempBase = env.get("TMP"); }
    if (tempBase.length == 0) { tempBase = "."; }
    string jitDir = tempBase + "\\silverc-jit";
    ensureDirTree(jitDir);
    string stem = drvFileStem(inputPath);
    if (stem.length == 0) { stem = "jit"; }
    string exePath = jitDir + "\\" + stem + "_" + (string)datetime.now().milliseconds() + "_" + (string)sysinfo.pid() + ".exe";
    #on LINUX
    string tmpL = env.get("TMPDIR");
    if (tmpL.length == 0) { tmpL = "/tmp"; }
    string jitDirL = tmpL + "/silverc-jit";
    ensureDirTree(jitDirL);
    string stemL = drvFileStem(inputPath);
    if (stemL.length == 0) { stemL = "jit"; }
    string elfPath = jitDirL + "/" + stemL + "_" + (string)datetime.now().milliseconds() + "_" + (string)sysinfo.pid();
    file.writeBytes(elfPath, peData);
    int pid = fork();
    if (pid == 0) {
        execve(elfPath, null, null);
        exit(127);
    }
    if (pid < 0) {
        flags.errLine("jit: failed to execute " + elfPath);
        return 1;
    }
    int st = 0;
    waitpid(pid, &st, 0);
    file.delete(elfPath);
    return (st >> 8) & 0xFF;
    #off
    #on MAC
    // Darwin spawn: posix_spawn (NOT fork/execve — absent from the mac grant
    // tables, matching silverc-rs macos.rs) + waitpid, via mac.libsystem
    // (imported above). argv/env ride null exactly like the LINUX ladder's
    // execve(elfPath, null, null): the entry rebuilds argv itself.
    string tmpM = env.get("TMPDIR");
    if (tmpM.length == 0) { tmpM = "/tmp"; }
    string jitDirM = tmpM + "/silverc-jit";
    ensureDirTree(jitDirM);
    string stemM = drvFileStem(inputPath);
    if (stemM.length == 0) { stemM = "jit"; }
    string machoPath = jitDirM + "/" + stemM + "_" + (string)datetime.now().milliseconds() + "_" + (string)sysinfo.pid();
    file.writeBytes(machoPath, peData);
    int pidM = 0;
    int spawnRc = posix_spawn(&pidM, machoPath, null, null, null, null);
    if (spawnRc != 0 || pidM <= 0) {
        flags.errLine("jit: failed to execute " + machoPath);
        return 1;
    }
    int stM = 0;
    waitpid(pidM, &stM, 0);
    file.delete(machoPath);
    return (stM >> 8) & 0xFF;
    #off
    file.writeBytes(exePath, peData);
    #on WINDOWS
    // Zeroed STARTUPINFO (104 bytes) and PROCESS_INFORMATION (24 bytes)
    // buffers; the arrays lower to data pointers across the Win32 boundary.
    int[] si = [];
    for (int zi = 0; zi < 104; zi++) { si.add(0); }
    int[] pi = [];
    for (int pz = 0; pz < 6; pz++) { pi.add(0); }
    int created = CreateProcessA(null, "\"" + exePath + "\"", null, null, 0, 0, null, null, si, pi);
    if (created == 0) {
        flags.errLine("jit: failed to execute " + exePath);
        return 1;
    }
    int hProcess = pi[0];
    WaitForSingleObject(hProcess, -1);
    int gotCode = 0;
    GetExitCodeProcess(hProcess, &gotCode);
    CloseHandle(hProcess);
    file.delete(exePath);
    return gotCode;
    #off
    // Non-Windows/non-Linux/non-Mac machines have no spawn backend yet
    // (regions are filled on those machines later); the same failure shape
    // as a failed spawn.
    flags.errLine("jit: failed to execute " + exePath);
    return 1;
}

// Split a marked aggregate into per-file chunks: paths, body ranges as
// character offsets into the aggregate, and the aggregate 0-based line
// index of each chunk's first content line. Bodies are kept as ranges —
// slicing each file out with per-char concatenation was quadratic in the
// file size and is what exhausted memory on large --cache-bytecode builds
// (string `+` allocates a fresh buffer per char and the runtime never
// frees the old ones).
class MarkedChunks {
    public prop string[] paths;
    public prop int[] startLines;
    public prop int[] starts;
    public prop int[] ends;

    construct {
        this.paths = [];
        this.startLines = [];
        this.starts = [];
        this.ends = [];
    }

    public void split(string source) {
        this.paths = [];
        this.startLines = [];
        this.starts = [];
        this.ends = [];
        string prefix = cacheMarkerPrefix();
        int prefixLen = prefix.length;
        string curPath = "";
        bool havePath = false;
        int bodyStart = 0;
        int bodyLine = 0;
        // One bounded line walk with the length read once. `.length` and
        // `indexOf(needle, start)` both strlen the whole aggregate (O(n)), so
        // the old per-line indexOf chain was quadratic in the aggregate size
        // (the aggregate is re-split on every cached build). A marker line is
        // a line STARTING with the prefix and carrying a path after it —
        // exactly the lines the old indexOf scan accepted; aggLine is the
        // 0-based index of the current line (every newline counted once).
        int srcLen = source.length;
        int lineStart = 0;
        int aggLine = 0;
        while (lineStart < srcLen) {
            int lineEnd = lineStart;
            while (lineEnd < srcLen && source[lineEnd] != '\n') { lineEnd++; }
            bool isMarker = lineEnd - lineStart > prefixLen;
            for (int pk = 0; isMarker && pk < prefixLen; pk++) {
                if (source[lineStart + pk] != prefix[pk]) { isMarker = false; }
            }
            if (!isMarker) {
                if (lineEnd >= srcLen) { break; }
                lineStart = lineEnd + 1;
                aggLine++;
                continue;
            }
            int hit = lineStart;
            if (havePath && lineEnd > bodyStart) {
                this.paths.add(curPath);
                this.startLines.add(bodyLine);
                this.starts.add(bodyStart);
                // The chunk ends where the NEXT marker line starts:
                // marker lines are comments to every stage, but the
                // freshness hash must cover exactly the file's own
                // bytes (like the reference hashes the file text),
                // never the following marker.
                this.ends.add(hit);
            }
            curPath = projectSlice(source, hit + prefixLen, lineEnd);
            if (havePath || hit == 0) {
                // Second-or-later marker, or a marker opening the very
                // first line: the chunk body starts right after it.
                bodyStart = lineEnd + 1;
                bodyLine = aggLine + 1;
            }
            // First marker sitting below leading content (project
            // metadata like APP_VERSION / LANG_VERSION prepended by
            // projectBuildSource, or a prepended source-level stdlib):
            // keep bodyStart = 0 so those leading lines are preserved
            // in the first chunk instead of being dropped.
            havePath = true;
            if (lineEnd >= srcLen) { break; }
            lineStart = lineEnd + 1;
            aggLine++;
        }
        if (havePath && srcLen > bodyStart) {
            this.paths.add(curPath);
            this.startLines.add(bodyLine);
            this.starts.add(bodyStart);
            this.ends.add(srcLen);
        }
    }
}

// Grouped compiler diagnostics: `[file]` headers over unchanged bodies.
//
// silverc-rs prints one `[file]` header per file on the error stream and keeps
// every error body byte-identical; the self-host mirrors that shape on the
// stream its diagnostics already use (stdout via printline). Files print in
// first-seen order with all of one file's errors contiguous under a single
// header, and errors within a file keep their source order.
//
// The .srp/standalone aggregate is lexed and parsed as ONE unit, so error
// lines are aggregate-relative. With --cache-bytecode the aggregate carries
// `//@@SILVER_FILE@@ <path>` marker lines and each error's `line L` maps back
// to its file through the MarkedChunks split above (paths/startLines).
// Without markers per-file attribution is impossible, so every error prints
// under a single `[input-as-given]` header. Bodies are never rewritten.

// First `line <N>` in a diagnostic body (1-based aggregate line), or -1 when
// the message carries no line. Every SYNTAX body embeds one (`at line L,
// column C`, `in line L, column C`, `was found at line L column C`); the
// match must start at a word boundary so prose like "outline" never hits.
int drvDiagLine(string msg) {
    string needle = "line ";
    int pos = projectFind(msg, needle, 0);
    while (pos >= 0) {
        bool wordStart = true;
        if (pos > 0) {
            char pb = msg[pos - 1];
            if ((pb >= 'a' && pb <= 'z') || (pb >= 'A' && pb <= 'Z')) { wordStart = false; }
        }
        int ds = pos + needle.length;
        int de = ds;
        while (de < msg.length && msg[de] >= '0' && msg[de] <= '9') { de++; }
        if (wordStart && de > ds) {
            int n = 0;
            for (int i = ds; i < de; i++) { n = n * 10 + (msg[i] - '0'); }
            return n;
        }
        pos = projectFind(msg, needle, pos + 1);
    }
    return -1;
}

// Marker path owning aggregate 1-based line `aggLine`: the last chunk whose
// first content line starts at or before it (startLines is a 0-based
// aggregate line index). "" when no chunk covers the line (empty split, or
// the line is a marker comment itself): the caller falls back to the entry.
string drvChunkOwner(MarkedChunks chunks, int aggLine) {
    string owner = "";
    for (int i = 0; i < chunks.paths.length; i++) {
        if (chunks.startLines[i] <= aggLine - 1) { owner = chunks.paths[i]; }
        else { break; }
    }
    return owner;
}

// Print `msgs` grouped under one `[file]` header per file, on stdout via
// printline (the stream these diagnostics already use). `source` is the
// aggregate the messages were reported against and `entryName` the input path
// as given. With markers (useMarkers: --cache-bytecode emitted them) each
// message maps to its file and unmappable ones fall under the entry header;
// without markers everything prints under a single `[entryName]` header.
void drvPrintDiagnostics(string[] msgs, string source, string entryName, bool useMarkers) {
    if (msgs.length == 0) { return; }
    string[] owners = [];
    if (useMarkers) {
        MarkedChunks chunks = new MarkedChunks();
        chunks.split(source);
        for (int m = 0; m < msgs.length; m++) {
            string owner = entryName;
            int ln = drvDiagLine(msgs[m]);
            if (ln > 0) {
                string hit = drvChunkOwner(chunks, ln);
                if (hit.length > 0) { owner = hit; }
            }
            owners.add(owner);
        }
    } else {
        for (int m = 0; m < msgs.length; m++) { owners.add(entryName); }
    }
    string[] order = [];
    for (int m = 0; m < owners.length; m++) {
        bool seen = false;
        for (int o = 0; o < order.length; o++) {
            if (order[o] == owners[m]) { seen = true; break; }
        }
        if (!seen) { order.add(owners[m]); }
    }
    for (int o = 0; o < order.length; o++) {
        printline("[" + order[o] + "]");
        for (int m = 0; m < msgs.length; m++) {
            if (owners[m] == order[o]) { printline(msgs[m]); }
        }
    }
}

// The single executable writer. An existing output is removed before the
// write: truncating an executable the on-access scanner is still checking
// (the previous build's output, seconds old) blocks until that scan ends —
// ~250 ms per rebuild, larger than a whole warm cached build — while
// removing it returns at once and the new file is written fresh.
void drvWriteOutput(string outputFile, int[] peData) {
    if (file.exists(outputFile)) { file.delete(outputFile); }
    file.writeBytes(outputFile, peData);
}

// Session naming mirrors silverc-rs: projects key the cache by their
// manifest name (or manifest stem), standalone files by the source stem.
string cacheSessionName(string inputFile, bool inputIsProject) {
    if (inputIsProject) {
        string mn = projectManifestValue(file.readString(inputFile), "name");
        if (mn.length > 0) { return mn; }
        return drvFileStem(inputFile);
    }
    return drvFileStem(inputFile);
}

// OVERHAUL.md --cache-object fast link for full-hit warm runs: every unit
// is fresh (the plan holds no stale), so no codegen runs at all — the staged
// validated .o bytes flow straight to link without re-reading the files
// (the reference staged-bytes shape), and the record compare-before-write
// below leaves disk untouched. Returns the linked image, or an empty array
// when the tier is off or a v1 boundary falls back loudly (the message is
// printed here; the cache is left untouched). Link failures exit loudly.
// A fresh plan implies the emitting flag set already matched (a switch
// clears the records without comparing hashes) and, for MAC, that the
// program lowered natively before (out-of-tier programs emit no objects,
// so a full-hit set cannot be out-of-tier) — no AST is needed to re-prove it.
int[] objLinkFresh(CliFlags flags, ObjSession? osess, ObjPlan p, int subsystem, string[] verKeys, string[] verVals) {
    int[] empty = [];
    if (osess == null) { return empty; }
    string target = ppTargetOsFor(flags.targetOs);
    if (target != "WINDOWS" && target != "LINUX" && target != "MAC") {
        flags.errLine("cache-object: " + objTargetDirName(target) + " target is outside the v1 object tier; full monolithic compile, objects not updated");
        return empty;
    }
    if (flags.mode == 2) {
        flags.errLine("cache-object: --runtime is outside the v1 object tier; full monolithic compile, objects not updated");
        return empty;
    }
    if (p.stale.length > 0 || p.fresh.length == 0) { return empty; }
    bool debugObj = objDebugEnabled();
    string[] noted = osess.notedOrder();
    ParsedObj[] parsed = [];
    for (int li = 0; li < noted.length; li++) {
        string lrel = noted[li];
        if (p.fresh.indexOf(lrel) < 0) { return empty; }
        if (debugObj) { eprintln("[objcache] reuse " + lrel); }
        ParsedObj u = new ParsedObj();
        string rerr = osess.readUnit(lrel, u);
        if (rerr.length > 0) {
            flags.errLine(rerr);
            exit(1);
        }
        parsed.add(u);
    }
    ObjLinkResult link = new ObjLinkResult();
    if (target == "MAC") {
        linkUnitsMac(parsed, link);
    } else if (target == "LINUX") {
        linkUnitsElf(parsed, link);
    } else {
        linkUnits(parsed, subsystem, verKeys, verVals, link);
    }
    if (link.err.length > 0) {
        flags.errLine(link.err);
        exit(1);
    }
    ObjFinish fin = new ObjFinish();
    osess.finishRecords(fin);
    if (fin.err.length > 0) {
        flags.errLine(fin.err);
        exit(1);
    }
    if (debugObj) {
        eprintln("[objcache] link " + (string)parsed.length + " units (" + (string)p.fresh.length + " fresh, 0 emitted, " + (string)fin.dropped + " dropped) -> " + (string)link.bytes.length + " bytes");
    }
    return link.bytes;
}

// OVERHAUL.md --cache-object (genuine object tier): compile the program
// through per-file relocatable machine-code objects plus the built-in
// static link, returning the linked image. Fresh objects are reused with no
// codegen at all; only stale files go through the backend.
//
// Returns the linked bytes, or an empty array when the tier is off or a v1
// boundary falls back loudly to the monolithic path (the message is
// printed here; the object cache is left untouched). Link failures print
// the exact reference error and exit — never a silent mislink.
int[] objCompileFlow(CliFlags flags, ObjSession? osess, CacheSession? sess, Node[] ast, string source, string inputFile, bool inputIsProject, string manifest, ProgressReporter progress, int subsystem, string[] verKeys, string[] verVals) {
    int[] empty = [];
    if (osess == null) { return empty; }
    string target = ppTargetOsFor(flags.targetOs);
    if (target != "WINDOWS" && target != "LINUX" && target != "MAC") {
        flags.errLine("cache-object: " + objTargetDirName(target) + " target is outside the v1 object tier; full monolithic compile, objects not updated");
        return empty;
    }
    if (flags.mode == 2) {
        flags.errLine("cache-object: --runtime is outside the v1 object tier; full monolithic compile, objects not updated");
        return empty;
    }
    MarkedChunks chunks = new MarkedChunks();
    chunks.split(source);
    if (chunks.paths.length == 0 || osess.notedKeys.length == 0) {
        flags.errLine("cache-object: no cacheable files observed; full monolithic compile, objects not updated");
        return empty;
    }
    // Ownership: every top-level item belongs to its chunk's file (class
    // items own their methods); unattributed items belong to the entry
    // file, mirroring the reference bundle-constant rule.
    string entryPath = inputFile;
    if (inputIsProject) {
        string root = projectDirname(inputFile);
        string entry = projectManifestValue(manifest, "entry");
        if (entry.length > 0) { entryPath = projectJoin(root, entry); }
    }
    string entryKey = osess.relKeyFor(entryPath.replaceAll("/", "\\"));
    bool entryNoted = false;
    for (int i = 0; i < osess.notedKeys.length; i++) {
        if (osess.notedKeys[i] == entryKey) { entryNoted = true; break; }
    }
    if (!entryNoted) { entryKey = osess.notedKeys[osess.notedKeys.length - 1]; }
    string[] owners = [];
    for (int i = 0; i < ast.length; i++) {
        string owner = entryKey;
        if (ast[i].line > 0) {
            string hit = drvChunkOwner(chunks, ast[i].line);
            if (hit.length > 0) { owner = osess.relKeyFor(hit.replaceAll("/", "\\")); }
        }
        owners.add(owner);
    }
    // macOS object tier: only in-tier programs lower to ARM64 objects.
    // Anything else compiles monolithically with a loud reason — never a
    // stub object — and the cache on disk is left untouched (the fallback
    // returns before plan/records are touched, same posture as --runtime).
    if (target == "MAC") {
        string tierReason = macTierReason(ast);
        if (tierReason.length > 0) {
            flags.errLine("cache-object: mac target is outside the v1 ARM64 object tier (" + tierReason + "); full monolithic compile, objects not updated");
            return empty;
        }
    }
    bool debugObj = objDebugEnabled();
    ObjPlan p = new ObjPlan();
    osess.plan(p);
    if (debugObj) {
        eprintln("[objcache] plan: " + (string)p.fresh.length + " fresh, " + (string)p.stale.length + " stale");
    }
    // Finalize every unit's SINGLE input kind in canonical noted order (the
    // collection order the aggregate was built in): an object-tier hit goes
    // straight to link, otherwise the unit keeps the frontend tier (synced
    // `.srbc` when it decoded, `.sr` source otherwise). Each unit logs
    // exactly once, proving no unit is two kinds at once and none is
    // processed twice.
    // Debug channel for the [pipe] lines below: objDebugEnabled() reads
    // SILVERC_DEBUG_OBJ straight from the OS. env.get cannot supply it —
    // the compiler build excludes env.sr, so env.get returns a bare value
    // pointer with no usable length (see cacheAppData) — and a second
    // direct reader for SILVERC_DEBUG_PIPE would clone that OS logic.
    // One channel drives both [objcache] and [pipe] lines.
    bool debugPipe = objDebugEnabled();
    string[] noted = osess.notedOrder();
    for (int ni = 0; ni < noted.length; ni++) {
        string nrel = noted[ni];
        bool isFresh = p.fresh.indexOf(nrel) >= 0;
        bool hit = false;
        if (!isFresh && sess != null) { hit = sess.wasHitKey(nrel); }
        int64[] hOut = [];
        int[] sOut = [];
        osess.notedHashStamp(nrel, hOut, sOut);
        int64 hval = 0;
        if (hOut.length > 0) { hval = hOut[0]; }
        PipeUnit punit = new PipeUnit(nrel, hval, pipeClassifyUnit(isFresh, hit));
        if (debugPipe || debugObj) {
            eprintln("[pipe] " + nrel + " " + punit.kindName());
        }
    }
    // ONE recorded full-program emission serves every stale unit: the
    // emission is identical whichever unit is extracted, so each stale file
    // slices its OWN separate unit buffer out of the same run, in plan order
    // (mirrors silverc-rs generate_object_units). Re-running the whole
    // backend once per stale file made a cold build of N files pay N full
    // emissions — slower than no cache at all. Fresh units run no codegen;
    // session writes stay post-join and sequential.
    ObjUnit[] emitUnits = [];
    MiniAsm oasm = new MiniAsm();
    MiniCg ocg = new MiniCg(oasm);
    if (target != "MAC" && p.stale.length > 0) {
        ocg.threadCount = flags.threadCount;
        ocg.runtimeMode = false;
        ocg.targetOs = target;
        if (inputIsProject) {
            NativeModules ocgNm = projectParseNativeModules(manifest);
            ocg.customNative = ocgNm;
        }
        // Progress ticks stay on the monolithic path: the recorded
        // emission runs without progress (mirrors the reference).
        ocg.genProgramOwned(ast, owners, entryKey);
        if (ocg.objHasRawRel32) {
            flags.errLine("cache-object: inline assembly is outside the v1 object tier; full monolithic compile, objects not updated");
            return empty;
        }
        // Load-bearing: getBytes() resolves the assembler's label
        // relocations into buf, which extractUnit slices — once for all units.
        oasm.getBytes();
    }
    for (int si = 0; si < p.stale.length; si++) {
        string rel = p.stale[si];
        ObjUnit unit = new ObjUnit();
        if (target == "MAC") {
            // Genuine per-file ARM64 machine code via the mac lowering
            // (whole-program emission sliced to this file's unit).
            string merr = macLowerOwned(ast, owners, entryKey, rel, unit);
            if (merr.length > 0) {
                flags.errLine(merr);
                exit(1);
            }
        } else {
            string xerr = extractUnit(ocg, rel, unit);
            if (xerr.length > 0) {
                flags.errLine(xerr);
                exit(1);
            }
        }
        if (objTooManyRelocs(unit)) {
            flags.errLine("cache-object: too many relocations in '" + rel + "' for one COFF section (v1 boundary); full monolithic compile, objects not updated");
            return empty;
        }
        emitUnits.add(unit);
    }
    // Ordered join in canonical noted order (never inside workers): write +
    // re-parse each emitted unit sequentially. The linked unit is the parsed
    // file, never a memory image (like the reference parse-after-write).
    string[] wroteRels = [];
    ParsedObj[] wroteParsed = [];
    for (int wi = 0; wi < noted.length; wi++) {
        string wrel = noted[wi];
        int widx = p.stale.indexOf(wrel);
        if (widx < 0) { continue; }
        if (debugObj) { eprintln("[objcache] emit " + wrel + " (codegen)"); }
        ObjUnit wunit = emitUnits[widx];
        int64[] whOut = [];
        int[] wsOut = [];
        if (!osess.notedHashStamp(wrel, whOut, wsOut)) {
            flags.errLine("object cache: '" + wrel + "' was never noted");
            exit(1);
        }
        int[] obytes = emitObject(wunit, osess.flags, whOut[0], wsOut[0], target);
        string werr = osess.writeUnit(wrel, obytes);
        if (werr.length > 0) {
            flags.errLine(werr);
            exit(1);
        }
        // Parse the exact bytes just written, from memory (like the
        // reference parse_object over its written bytes): the linked unit
        // is still the parsed object file, but it is never read back from
        // disk inside the same run (OVERHAUL.md RAM residency — and reading
        // a just-written file waits on the on-access scanner).
        ParsedObj pu = new ParsedObj();
        ObjReader orr = new ObjReader(objBytesOf(obytes));
        string perr = "";
        if (target == "MAC") { perr = objParseMacho(orr, pu); }
        else if (target == "LINUX") { perr = objParseElf(orr, pu); }
        else { perr = objParseCoff(orr, pu); }
        if (perr.length > 0) {
            flags.errLine(perr);
            exit(1);
        }
        wroteRels.add(wrel);
        wroteParsed.add(pu);
    }
    // Single downstream link over units in canonical noted order — identical
    // consumption regardless of tier mix or file count. (Fresh units read
    // straight from cache: no codegen ran for them at all.)
    ParsedObj[] parsed = [];
    for (int li = 0; li < noted.length; li++) {
        string lrel = noted[li];
        if (p.fresh.indexOf(lrel) >= 0) {
            if (debugObj) { eprintln("[objcache] reuse " + lrel); }
            ParsedObj u = new ParsedObj();
            string rerr = osess.readUnit(lrel, u);
            if (rerr.length > 0) {
                flags.errLine(rerr);
                exit(1);
            }
            parsed.add(u);
        } else {
            int sidx = wroteRels.indexOf(lrel);
            if (sidx < 0) {
                flags.errLine("object cache: '" + lrel + "' was noted but never emitted");
                exit(1);
            }
            parsed.add(wroteParsed[sidx]);
        }
    }
    ObjLinkResult link = new ObjLinkResult();
    if (target == "MAC") {
        linkUnitsMac(parsed, link);
    } else if (target == "LINUX") {
        linkUnitsElf(parsed, link);
    } else {
        linkUnits(parsed, subsystem, verKeys, verVals, link);
    }
    if (link.err.length > 0) {
        flags.errLine(link.err);
        exit(1);
    }
    ObjFinish fin = new ObjFinish();
    osess.finishRecords(fin);
    if (fin.err.length > 0) {
        flags.errLine(fin.err);
        exit(1);
    }
    if (debugObj) {
        eprintln("[objcache] link " + (string)parsed.length + " units (" + (string)p.fresh.length + " fresh, " + (string)p.stale.length + " emitted, " + (string)fin.dropped + " dropped) -> " + (string)link.bytes.length + " bytes");
    }
    return link.bytes;
}

void main() {
    string[] args = cargs;

    // cargs[0] is the executable name. Keep argument handling independent of
    // the platform's quoting rules and of the current working directory.
    if (args.length <= 1) {
        printHelp();
        exit(0);
    }
    string arg0 = args[1];
    if (arg0 == "--version" || arg0 == "-v") {
        printline("Silver Compiler v0.7.9.4");
        printline("Language: Silver");
        printline("Version:  0.7.9.4");
        printline("Copyright: © 2025 Edan M.");
        printline("Silver for macOS: Copyright © 2026 StavA - macOS support,");
        printline("macOS compiler support, maintainer and QA of the macOS version");
        printline("(unit tests). Programming language creator: Edan M.");
        printline("Run with --help for usage information.");
        exit(0);
    }
    if (arg0 == "--help" || arg0 == "-h" || arg0 == "-?" || arg0 == "/?") {
        printHelp();
        exit(0);
    }

    // OVERHAUL.md flag parsing: modes, independent flags, validation.
    CliFlags flags = parseCliArgs(args);
    if (flags.failed()) {
        // `--release` is not a real flag: release is the default build mode,
        // so print the notice and exit without compiling (mirrors
        // silverc-rs, which exits 0 on the same notice).
        if (flags.error == releaseNotice()) {
            printline(flags.error);
            exit(0);
        }
        flags.errLine(flags.error);
        exit(1);
    }

    // Hard-coded self-protection layer: refuse dangerous modes on
    // compiler/interpreter inputs and outputs regardless of any manifest.
    string spErr = flags.selfProtectionError();
    if (spErr.length > 0) {
        flags.errLine(spErr);
        exit(1);
    }

    // Legacy default invocation keeps compiling the compiler itself.
    string inputFile = flags.input;
    if (inputFile.length == 0) { inputFile = "compiler_driver.sr"; }

    // Legacy guard retained: unknown suffixes still report the same error.
    bool inputIsProject = projectHasSuffix(inputFile, ".srp");
    if (!inputIsProject && !projectHasSuffix(inputFile, ".sr")) {
        printline("Error: Unknown file type. Expected .sr or .srp");
        exit(1);
    }

    string outputFile = flags.output;

    // Manifest-level forbidden_flags are checked before anything runs.
    string manifestText = "";
    if (inputIsProject) {
        manifestText = file.readString(inputFile);
        string ffErr = flags.forbiddenFlagsError(manifestText);
        if (ffErr.length > 0) {
            flags.errLine(ffErr);
            exit(1);
        }
        if (outputFile.length == 0) {
            string projectOutput = projectManifestValue(manifestText, "output");
            if (projectOutput != "") { outputFile = projectOutput; }
        }
    }
    // No -o and no manifest `output:`: Windows keeps the historical
    // `silverc.exe` fallback (mirror silverc-rs main.rs:1083); Linux targets
    // emit the bare `silverc` stem. Explicit -o / manifest output is honored
    // verbatim either way (silverc.srp `output: silverc.exe` untouched).
    #on WINDOWS
    if (outputFile.length == 0) { outputFile = "silverc.exe"; }
    #on LINUX
    if (outputFile.length == 0) { outputFile = "silverc"; }
    #on MAC
    if (outputFile.length == 0) { outputFile = "silverc"; }
    #off

    // OVERHAUL.md --threads resolution: over-request aborts with the exact
    // spec message and no fallback; requesting every thread warns about
    // hang/lag with a margin of at least 2 recommended.
    flags.resolveThreads();
    if (flags.failed()) {
        flags.errLine(flags.error);
        exit(1);
    }
    if (flags.warnAllThreads) {
        flags.errLine(flags.warnAllMessage());
    }

    // OVERHAUL.md --watch: idle-debounce precompilation loop.
    // The compiler-binary directory, captured here inline in main() from the
    // already-rebuilt `args` copy (main-as-entry: the only place the
    // bootstrap's Linux cargs lowering is valid). Every helper below receives
    // it as a parameter and never re-reads cargs.
    string exeDir = "";
    if (args.length > 0) {
        string exeArg = args[0];
        int exeLast = -1;
        for (int exeI = 0; exeI < exeArg.length; exeI++) {
            if (exeArg[exeI] == '\\' || exeArg[exeI] == '/') { exeLast = exeI; }
        }
        if (exeLast >= 0) { exeDir = projectSlice(exeArg, 0, exeLast); }
    }
    if (flags.watch) {
        runWatchLoop(flags, inputIsProject, manifestText, outputFile, exeDir);
        exit(0);
    }

    int code = compileOnce(flags, outputFile, exeDir);
    exit(code);
}

// One full pipeline pass. Returns the process exit code: 0 on success, 1 on
// failure; in --jit mode the compiled program runs as a child and its exit
// code propagates. `exeDir` arrives from main() (captured inline there):
// this pass must never read cargs itself.
int compileOnce(CliFlags flags, string outputFile, string exeDir) {
    float64 startTick = time.now();
    string inputFile = flags.input;
    bool inputIsProject = projectHasSuffix(inputFile, ".srp");
    int moduleCount = 1;
    // Phase reporter shared across the whole pipeline (module collection +
    // codegen + emission + cache flush). Standalone sources create it during
    // import collection; project builds create it once the module count is
    // known so the codegen/emission phases can report too.
    ProgressReporter progress = null;

    string manifest = "";
    if (inputIsProject) {
        manifest = file.readString(inputFile);
        string projectType = projectManifestValue(manifest, "type");
        if (projectType == "quicksilver") {
            // `type: quicksilver` (DOCS/226): emit a QuickSilver (.qs) library
            // bundle instead of an executable. The module count for the
            // success line comes back from the single bundle walk (no counting
            // pre-pass: it re-read and re-filtered every file).
            int[] qsCount = [];
            qsCount.add(0);
            int[] bundle = projectBuildBundle(inputFile, qsCount);
            moduleCount = qsCount[0];
            file.writeBytes(outputFile, bundle);
            drvReportSuccess(outputFile, moduleCount, startTick);
            return 0;
        }
    }

    string source = file.readString(inputFile);
    if (inputIsProject) {
        // No counting pre-pass (it re-read and re-filtered every file just
        // for the progress total). Collection reports indeterminate `[N/N]`
        // lines while running; the exact success-line count comes back from
        // the single projectBuildSource pass in buildCount.
        progress = new ProgressReporter(1);
        int[] buildCount = [];
        buildCount.add(0);
        // DOCS/260 — the .srp aggregate (markers + per-file sources) was
        // already filtered per file inside projectCollect; this pass is a
        // no-op safety net (files with no directives return unchanged).
        string builtSource = projectBuildSource(inputFile, flags.cacheBytecode || flags.cacheObject, flags.debugBuild, buildCount);
        moduleCount = buildCount[0];
        progress.setTotal(moduleCount);
        source = drvPreprocessOrDie(builtSource, flags.debugBuild);
    } else {
        // `.col` declarations require a project manifest with a configured
        // collection directory. Standalone source compilation reports the
        // same UnknownCollectionException as the native compiler.
        source = projectExpandCollections(source, ".", "");

        // DOCS/260 — the preprocessor runs before anything else scans the
        // entry source (import probes, module collection, the lexer).
        source = drvPreprocessOrDie(source, flags.debugBuild);

        // The universal llmai client is a source-level standard library. Keep
        // the low-level WinInet builtin available, but include the shared
        // wrapper when a standalone source imports llmai. The test runner
        // invokes the compiler from tests/, so ../std is the stable library
        // location for both self-hosting and top-level suites.
        int llmaiImport = projectFind(source, "from " + "llmai", 0);
        if (llmaiImport < 0) { llmaiImport = projectFind(source, "from " + "LLMAI", 0); }
        if (llmaiImport >= 0) {
            // Load the wrapper by content instead of probing with
            // file.exists(): the self-hosted exists lowering is not reliable
            // for paths containing `..` on every bootstrap stage. The
            // compiler's own tree (exe-relative) goes first so a foreign cwd
            // std/ can never shadow the shipped wrapper; then paths relative
            // to the process cwd and the test-suite directories. Every rung
            // is one `*"..."` path literal (DOCS/257): no OS regions, correct
            // separators on every target.
            string llmaiSource = drvTryExeTree(exeDir, *"/std/llmai.sr");
            if (llmaiSource.length == 0) {
                llmaiSource = tryReadFile(*"std/llmai.sr");
            }
            if (llmaiSource.length == 0) {
                llmaiSource = tryReadFile(*"silverc/std/llmai.sr");
            }
            if (llmaiSource.length == 0) {
                llmaiSource = tryReadFile(*"../std/llmai.sr");
            }
            if (llmaiSource.length == 0) {
                llmaiSource = tryReadFile(*"../silverc/std/llmai.sr");
            }
            if (llmaiSource.length == 0) {
                llmaiSource = tryReadFile(*"../../std/llmai.sr");
            }
            source = drvPreprocessOrDie(llmaiSource, flags.debugBuild) + "\n" + source;
        }

        // The exception hierarchy is a source-level standard library. When a
        // standalone source imports it, prepend the
        // std class definitions so `catch (Exception e) { e.message }` resolves
        // the shared fields to strings. Mirrors the llmai handling above.
        int excImport = projectFind(source, "from " + "exception", 0);
        if (excImport >= 0) {
            string excSource = drvTryExeTree(exeDir, *"/std/exception.sr");
            if (excSource.length == 0) {
                excSource = tryReadFile(*"std/exception.sr");
            }
            if (excSource.length == 0) {
                excSource = tryReadFile(*"silverc/std/exception.sr");
            }
            if (excSource.length == 0) {
                excSource = tryReadFile(*"../std/exception.sr");
            }
            if (excSource.length == 0) {
                excSource = tryReadFile(*"../silverc/std/exception.sr");
            }
            if (excSource.length == 0) {
                excSource = tryReadFile(*"../../std/exception.sr");
            }
            source = drvPreprocessOrDie(excSource, flags.debugBuild) + "\n" + source;
        }

        // BOM and focused-process APIs are source-level standard libraries.
        // Prepend their definitions for standalone compilation, matching the
        // self-hosted import behavior used by llmai and exception.
        int bomImport = projectFind(source, "from " + "bom", 0);
        if (bomImport >= 0) {
            string bomSource = drvTryExeTree(exeDir, *"/std/bom.sr");
            if (bomSource.length == 0) { bomSource = tryReadFile(*"std/bom.sr"); }
            if (bomSource.length == 0) { bomSource = tryReadFile(*"silverc/std/bom.sr"); }
            if (bomSource.length == 0) { bomSource = tryReadFile(*"../std/bom.sr"); }
            if (bomSource.length == 0) { bomSource = tryReadFile(*"../silverc/std/bom.sr"); }
            if (bomSource.length == 0) { bomSource = tryReadFile(*"../../std/bom.sr"); }
            source = drvPreprocessOrDie(bomSource, flags.debugBuild) + "\n" + source;
        }
        int processImport = projectFind(source, "from " + "process", 0);
        if (processImport >= 0) {
            string processSource = drvTryExeTree(exeDir, *"/std/process.sr");
            if (processSource.length == 0) { processSource = tryReadFile(*"std/process.sr"); }
            if (processSource.length == 0) { processSource = tryReadFile(*"silverc/std/process.sr"); }
            if (processSource.length == 0) { processSource = tryReadFile(*"../std/process.sr"); }
            if (processSource.length == 0) { processSource = tryReadFile(*"../silverc/std/process.sr"); }
            if (processSource.length == 0) { processSource = tryReadFile(*"../../std/process.sr"); }
            source = drvPreprocessOrDie(processSource, flags.debugBuild) + "\n" + source;
        }
        // Notifications (Windows toast / tray-balloon) is a source-level
        // standard library.  Prepend its definitions when a standalone source
        // imports it, matching the self-hosted import behavior above.
        int notifImport = projectFind(source, "from " + "notifications", 0);
        if (notifImport >= 0) {
            string notifSource = drvTryExeTree(exeDir, *"/std/notifications.sr");
            if (notifSource.length == 0) { notifSource = tryReadFile(*"std/notifications.sr"); }
            if (notifSource.length == 0) { notifSource = tryReadFile(*"silverc/std/notifications.sr"); }
            if (notifSource.length == 0) { notifSource = tryReadFile(*"../std/notifications.sr"); }
            if (notifSource.length == 0) { notifSource = tryReadFile(*"../silverc/std/notifications.sr"); }
            if (notifSource.length == 0) { notifSource = tryReadFile(*"../../std/notifications.sr"); }
            source = drvPreprocessOrDie(notifSource, flags.debugBuild) + "\n" + source;
        }

        // Generic source-level imports (`import * from helper;`, `import
        // value;`, `import * from math;`): any module that lives in a .sr
        // file next to the input, under std/, or under silveri/src is
        // collected the same way. Native modules (fs/json/yaml/os + the
        // special-cased std libs above) are never read from disk.
        // Progress (STDERR): no counting pre-pass (it re-read and
        // re-filtered every file just for the total). Collection reports
        // indeterminate `[N/N]` lines while running; the exact total is
        // pinned once the single pass below finishes.
        string[] moduleErrors = [];
        progress = new ProgressReporter(1);
        progress.moduleDone(inputFile);
        source = collectImports(source, inputFile, "", moduleErrors, flags.cacheBytecode || flags.cacheObject, progress, flags.debugBuild, exeDir);
        if (moduleErrors.length > 0) {
            // Unknown-module diagnostics are reported against the entry
            // source (pre-collection lines), so they always belong to the
            // entry file: single `[input-as-given]` header, bodies untouched.
            printline("[" + inputFile + "]");
            for (int meI = 0; meI < moduleErrors.length; meI++) {
                printline(moduleErrors[meI]);
            }
            exit(1);
        }
        progress.setTotal(progress.processedCount());
        moduleCount = progress.processedCount();
        progress.finish();
    }

    // Version-metadata and subsystem inputs shared by the monolithic, object,
    // and fast-link paths (the object tier links them into its image
    // directly). Pure manifest reads hoisted here so the fast link below
    // reuses the same values with no second computation.
    string projectType = "";
    if (inputIsProject) {
        projectType = projectManifestValue(file.readString(inputFile), "type");
    }
    int linkSubsystem = 3;
    if (projectType == "app" || projectType == "service") {
        linkSubsystem = 2;
    }
    string[] viKeys = [];
    string[] viValues = [];
    if (inputIsProject) {
        string manifest2 = file.readString(inputFile);
        string viName = projectManifestValue(manifest2, "name");
        string viVers = projectManifestValue(manifest2, "version");
        string viProd = projectManifestValue(manifest2, "product");
        string viCopy = projectManifestValue(manifest2, "copyright");
        string viComp = projectManifestValue(manifest2, "company");
        if (viName != "")   { viKeys.add("FileDescription");  viValues.add(viName); }
        if (viProd != "")  { viKeys.add("ProductName");      viValues.add(viProd); }
        if (viCopy != "")  { viKeys.add("LegalCopyright");   viValues.add(viCopy); }
        if (viComp != "")  { viKeys.add("CompanyName");      viValues.add(viComp); }
        if (viName != "")  { viKeys.add("InternalName");     viValues.add(viName); }
        if (viName != "")  { viKeys.add("OriginalFilename"); viValues.add(viName + ".exe"); }
        if (viVers != "")  { viKeys.add("FileVersion");      viValues.add(viVers); }
        if (viVers != "")  { viKeys.add("ProductVersion");   viValues.add(viVers); }
    }

    // Per-line character lengths so bracket diagnostics can point just past
    // the end of a line (SYNTAX_EXCEPTIONS.md #3). Computed over the whole
    // aggregate either way; cached token streams get re-offset below so their
    // line numbers land on the same aggregate rows.
    int[] lineLens = [];
    int lineCur = 0;
    int srcTotal = source.length;
    for (int li = 0; li < srcTotal; li++) {
        char lc = source[li];
        if (lc == '\n') { lineLens.add(lineCur); lineCur = 0; }
        else if (lc != '\r') { lineCur++; }
    }
    lineLens.add(lineCur);

    Token[] tokens = [];
    Node[] ast = [];
    int[] peData = [];
    bool objFast = false;
    ObjPlan fastPlan = new ObjPlan();
    CacheSession? sess = null;
    // OVERHAUL.md --cache-object: per-target object session over the same
    // root/name as the bytecode session. Null unless requested (or when the
    // per-host cache root is unavailable) — callers fall back to the
    // uncached pipeline.
    ObjSession? osess = null;
    if (flags.cacheObject) {
        osess = new ObjSession(path.dirname(inputFile), cacheSessionName(inputFile, inputIsProject), ppTargetOsFor(flags.targetOs), flags.modeName(), flags.optimize);
        if (!osess.ok) { osess = null; }
    }
    // OVERHAUL.md threading model: the unified pipeline maps per-file
    // emission under this resolved count (default `total - 2`, or explicit
    // `--threads`).
    if (osess != null) { osess.setWorkers(flags.threadCount); }
    // OVERHAUL.md --cache-object alone (no --cache-bytecode) still routes
    // through the chunked bytecode path below with a READ ONLY session: hits
    // decode the synced .srbc per file (.sr fallback per file otherwise) and
    // bytecode\ is never written. Only the fully uncached configuration
    // (neither flag) lexes the aggregate whole here.
    if (!flags.cacheBytecode && osess == null) {
        // No-cache builds use the SAME line: a plain fresh lex through the
        // pipeline's single lex entry.
        string[] lexErrs = [];
        tokens = pipeLexUnit(source, lexErrs);

        // Lexical diagnostics print grouped under `[file]` headers and abort
        // before parsing (unmarked builds: single `[input-as-given]` header).
        if (lexErrs.length > 0) {
            drvPrintDiagnostics(lexErrs, source, inputFile, flags.cacheBytecode);
            exit(1);
        }
    } else {
        // OVERHAUL.md --cache-bytecode: lex each collected file separately,
        // going through the persistent bytecode cache; only files whose hash
        // or mtime changed are re-lexed and re-cached. With --cache-object
        // alone the same loop runs on a READ ONLY session instead (hits decode
        // the synced .srbc, misses lex fresh, nothing re-cached). Chunk bodies are kept
        // as ranges into the aggregate and sliced only on a miss, so
        // unchanged files are never sliced out of the aggregate at all.
        MarkedChunks chunks = new MarkedChunks();
        chunks.split(source);
        // OVERHAUL.md freshness steps 1-2, shared once: one stat plus one
        // hash per file for the unit record, both tiers, and the fast-link
        // check below — bytes are never hashed or stat-ed twice on the hot
        // path (the reference single-hash shape).
        int64[] preHashes = [];
        int[] preMtimes = [];
        string[] preAbs = [];
        for (int ci0 = 0; ci0 < chunks.paths.length; ci0++) {
            string chunkAbs0 = chunks.paths[ci0].replaceAll("/", "\\");
            // FS-native spelling for the stat below: marker paths arrive
            // with `/` separators, which the `\` key spelling above keeps
            // for the record keys (relOf/bcNormKey fold them back). On
            // LINUX/MAC a `\` path never stats — modification() falls back
            // to the epoch default and freshness rode the hash alone.
            // WINDOWS keeps the `\` spelling verbatim.
            string chunkFs0 = chunkAbs0;
            #on LINUX or MAC
            chunkFs0 = chunkAbs0.replaceAll("\\", "/");
            #off
            int hashEnd0 = chunks.ends[ci0];
            if (hashEnd0 > chunks.starts[ci0] && hashEnd0 < source.length && source[hashEnd0 - 1] == '\n') { hashEnd0--; }
            int64 chunkHash0 = hash.fnv1(source, chunks.starts[ci0], hashEnd0);
            int chunkMtime0 = file.modification(chunkFs0).milliseconds();
            preHashes.add(chunkHash0);
            preMtimes.add(chunkMtime0);
            preAbs.add(chunkAbs0);
            if (osess != null) {
                osess.noteFileHashed(chunkAbs0, chunkHash0, chunkMtime0);
            }
        }
        // Fast-link check: when every unit is fresh, the staged validated .o
        // bytes flow straight to link with no bytecode I/O, no lexing, and no
        // parsing — the frontend below is skipped entirely (the interpreter
        // trial shape: the object record is checked first, and an up-to-date
        // set verifies straight from the staged bytes). A stale plan falls
        // through to the full line, which reuses the shared hashes above.
        if (osess != null && chunks.paths.length > 0) {
            osess.plan(fastPlan);
            if (fastPlan.stale.length == 0 && fastPlan.fresh.length == chunks.paths.length && fastPlan.fresh.length > 0) {
                int[] fastPe = objLinkFresh(flags, osess, fastPlan, linkSubsystem, viKeys, viValues);
                if (fastPe.length > 0) {
                    peData = fastPe;
                    objFast = true;
                }
            }
        }
        if (!objFast) {
        // OVERHAUL.md --cache-object alone (no --cache-bytecode): the third
        // argument opens the bytecode tier READ ONLY — synced .srbc files
        // decode on a hit, misses lex fresh, nothing is written back (flush
        // below is a no-op for these sessions). Reached exactly when
        // --cache-bytecode is absent (the outer branch guarantees osess).
        sess = new CacheSession(path.dirname(inputFile), cacheSessionName(inputFile, inputIsProject), !flags.cacheBytecode);
        if (sess.ok && chunks.paths.length > 0) {
            // Misses slice their chunk straight out of the aggregate (one
            // O(len) substring); hits never materialize a chunk at all.
            for (int ci2 = 0; ci2 < chunks.paths.length; ci2++) {
                // Shared hashes above (no re-hash/re-stat, no second note —
                // the unit record, both tiers, and the fast-link check all
                // consume the one precomputed pair).
                string chunkAbs = preAbs[ci2];
                int64 chunkHash = preHashes[ci2];
                int chunkMtime = preMtimes[ci2];
                Token[] part = sess.tokensForRange(
                    chunkAbs,
                    source, chunks.starts[ci2], chunks.ends[ci2], chunkHash, chunkMtime);
                // OVERHAUL.md --cache-object two-tier flow: tokens come from
                // the synced .srbc when the bytecode tier hit, otherwise
                // from a fresh lex — never re-lexed for the object tier.
                // Freshness keys on the shared slice hash above (reference:
                // the exact lexed text).
                int off = chunks.startLines[ci2];
                for (int tj = 0; tj < part.length; tj++) {
                    Token t = part[tj];
                    // Each chunk's stream carries its own trailing EOF; keep
                    // them all so only one sentinel reaches the parser.
                    if (t.kind == 0) { continue; }
                    t.line += off;
                    tokens.add(t);
                }
            }
            tokens.add(new Token(0, "", 1, 1));
        } else {
            // Cache tiers off and no chunk split: same line, fresh lex
            // through the single lex entry.
            string[] fbErrs = [];
            tokens = pipeLexUnit(source, fbErrs);
            if (fbErrs.length > 0) {
                drvPrintDiagnostics(fbErrs, source, inputFile, flags.cacheBytecode);
                exit(1);
            }
        }
        } // end if (!objFast): fast-link warm hits skip the bytecode tier entirely
    }

    if (!objFast) {
    // Every token stream parses through the pipeline's single parse entry.
    // DOCS/261 custom native modules: the manifest map lets declared custom
    // grants resolve (standalone compiles keep the empty default — a null
    // custom set). Bare customs resolve the manifest side matching `--os`.
    NativeModules? drvNm = null;
    if (inputIsProject) {
        drvNm = projectParseNativeModules(manifest);
    }
    PipeParseOut pout = new PipeParseOut();
    // MAC.md Phase D: the Rosetta bridge emits SysV, so native grants
    // resolve Linux-side (linux.* names lower through the SysV call
    // shapes and link from libSystem at finalize).
    string parseTargetOs = ppTargetOsFor(flags.targetOs);
    if (parseTargetOs == "MACX64") { parseTargetOs = "LINUX"; }
    pipeParseUnit(tokens, lineLens, true, drvNm, parseTargetOs, true, pout);
    ast = pout.program;

    // Post-parse call diagnostics (EXCEPTIONS/*.md): unknown-method /
    // did-you-mean over the fully collected symbol table, and filesystem
    // ValueException checks over literal path arguments. Runs inside the
    // single parse entry above, over the same parser state.

    // Syntax diagnostics grouped under `[file]` headers, in source order
    // within each file (SYNTAX_EXCEPTIONS.md #4). Bodies are byte-identical;
    // only the headers are added.
    if (pout.errors.length > 0) {
        drvPrintDiagnostics(pout.errors, source, inputFile, flags.cacheBytecode);
        exit(1);
    }

    // DOCS/258 -- `internal` project-boundary enforcement. A standalone
    // compile's project is the entry file itself; every module resolved from
    // outside it is external and its internal items are off limits to the
    // entry's code. `.srp` projects compile their whole source set as one
    // project, so nothing external exists there and the pass is skipped
    // (mirrors silverc-rs, which enforces on the single-file path).
    if (!inputIsProject) {
        VisibilityChecker vis = new VisibilityChecker(inputFile, flags.debugBuild, exeDir);
        vis.run();
        if (vis.errors.length > 0) {
            // Visibility diagnostics are reported against the entry file
            // (the checker re-parses it standalone), so they always belong
            // to the entry file: single `[input-as-given]` header.
            printline("[" + inputFile + "]");
            for (int veI = 0; veI < vis.errors.length; veI++) {
                printline(vis.errors[veI]);
            }
            exit(1);
        }
    }

    MemoryGuard guard = new MemoryGuard();
    guard.checkProgram(ast);
    // Non-fatal flow diagnostics (warning-channel concept): unreachable
    // code and other suspicious-but-legal shapes report to stderr after a
    // successful check and never fail the compile.
    for (int gwI = 0; gwI < guard.warnings.length; gwI++) {
        eprintln("warning: " + guard.warnings[gwI]);
    }

    // OVERHAUL.md --optimize: constant folding + dead-code elimination run
    // after parsing and guarding so diagnostics stay unchanged; codegen
    // consumes the optimized program.
    if (flags.optimize) {
        Optimizer opt = new Optimizer();
        opt.optimizeProgram(ast);
    }
    } // end if (!objFast): fast-link warm hits skip parse/guard/vis/optimize entirely

    // Version-metadata and subsystem inputs hoisted above (shared with the
    // fast link); the object tier consumes the same values.
    // OVERHAUL.md --cache-object (genuine object tier): per-file
    // machine-code objects plus the built-in static link, whose image
    // replaces the monolithic one below. Empty when the tier is off or a
    // v1 boundary falls back loudly; link failures exit inside. Fast-link
    // warm hits already hold the linked image above, so the tier is skipped.
    if (!objFast && osess != null) {
        peData = objCompileFlow(flags, osess, sess, ast, source, inputFile, inputIsProject, manifest, progress, linkSubsystem, viKeys, viValues);
    }
    if (peData.length == 0) {
    MiniAsm asm = new MiniAsm();

    MiniCg cg = new MiniCg(asm);

    // OVERHAUL.md threading model: programs can query the effective worker
    // count via threads.length; --runtime embeds allocator/GC entry points.
    cg.threadCount = flags.threadCount;
    cg.runtimeMode = flags.mode == 2;
    // LINUX.md Phase C (additive): the codegen target OS selects the SysV
    // backend branches inside mini_cg (ppTargetOsFor: explicit --os wins,
    // otherwise the host default). WINDOWS builds with no --os resolve to
    // WINDOWS exactly as before, so emission is byte-identical.
    cg.targetOs = ppTargetOsFor(flags.targetOs);
    // DOCS/261: same manifest map lets declared custom grants resolve in
    // codegen (lazy emission reuses the fixed machinery verbatim).
    if (inputIsProject) {
        NativeModules drvCgNm = projectParseNativeModules(manifest);
        cg.customNative = drvCgNm;
    }

    // Phase B/C reporting: the parse/typecheck frontend is done, native
    // emission begins, and the executable + cache flush must both complete
    // before the final success line prints.
    if (progress != null) { progress.parseDone(); }
    if (progress != null) { progress.phaseCodegen(); }
    cg.progress = progress;

    cg.genProgram(ast);

    // OVERHAUL.md --optimize: behavior-preserving peephole pass over the
    // emitted machine code (in-place NOP rewrites only; DISABLED — see
    // optimizer.sr peepholeOptimize for the rationale).
    if (flags.optimize) {
        peepholeOptimize(asm);
    }

    MiniEf pe = new MiniEf();

    // DOCS/253 -- project type selects the PE subsystem (hoisted
    // linkSubsystem above; the object tier consumes the same value).
    pe.subsystem = linkSubsystem;

    // OVERHAUL.md --runtime: reserve the writable runtime state block and the
    // internal __silver_rt_alloc pointer slot inside the data area.
    cg.appendRuntimeData();

    // MAC.md Phase D (additive): Rosetta-bridge (MACX64) finalize. The
    // emission above already ran as SysV (isLinuxTarget covers MACX64);
    // here imports remap to their macOS owners and the image links as a
    // non-PIE x86_64 Mach-O. --runtime has no bridge support yet (loud).
    bool isMacX64 = cg.targetOs == "MACX64";
    if (isMacX64 && flags.mode == 2) {
        eprintln("silverc: --runtime is not supported with --os macx64");
        exit(1);
    }
    if (isMacX64) {
        int macEntryOff = cg.mainLabelOffset;
        if (cg.globalNames.length > 0) { macEntryOff = cg.entryOffset; }
        if (cg.runtimeEntryOffset >= 0) { macEntryOff = cg.runtimeEntryOffset; }
        int[] macCode = asm.getBytes();
        int[] macData = cg.getStringData();
        for (int zg = 0; zg < cg.globalAreaSize; zg++) { macData.add(0); }
        string[] macFuncNames = [];
        for (int mi = 0; mi < cg.importDlls.length; mi++) {
            string mDll = cg.importDlls[mi];
            string mFn = cg.importFuncs[mi];
            if (mDll == "libc.so.6" || mDll == "") {
                mDll = "/usr/lib/libSystem.B.dylib";
            } else if (mDll == "libcrypto.so.3") {
                mDll = "/usr/lib/libcrypto.dylib";
            } else if (mDll != "/usr/lib/libSystem.B.dylib" && mDll != "/usr/lib/libcrypto.dylib") {
                eprintln("silverc: --os macx64 cannot link " + mDll + " (" + mFn + "); Windows-only modules are unsupported on macOS");
                exit(1);
            }
            cg.importDlls[mi] = mDll;
            macFuncNames.add("_" + mFn);
        }
        int64[] macLayout = macX64Plan(macCode.length, macData.length, macFuncNames.length, macEntryOff);
        cg.macX64DataVaddr = macLayout[2];
        cg.macX64SlotAddrs = [];
        for (int si = 0; si < macFuncNames.length; si++) {
            cg.macX64SlotAddrs.add(macLayout[5] + si * 8);
        }
        cg.patchForwardCalls(macCode);
        cg.patchStringRefs(macCode, 0, 0);
        cg.patchMacX64ImportRefs(macCode);
        cg.patchRuntimeRefs(macCode, 0, 0);
        cg.patchGlobalRefs(macCode, macData.length - cg.globalAreaSize, 0);
        peData = macX64Emit(macLayout, macCode, macData, macFuncNames);
    } else {
    int entryOff = cg.mainLabelOffset;
    if (cg.globalNames.length > 0) { entryOff = cg.entryOffset; }
    if (cg.runtimeEntryOffset >= 0) { entryOff = cg.runtimeEntryOffset; }
    pe.entryRva = 0x1000 + entryOff;

    int nImp = cg.importDlls.length;
    for (int i = 0; i < nImp; i++) {
        string impDll = cg.importDlls[i];
        string impFn = cg.importFuncs[i];
        pe.addImport(impDll, impFn);
    }

    int[] stringData = cg.getStringData();

    int[] finalCode = asm.getBytes();
    pe.code = finalCode;

    int rdataRva = pe.computeRdataRva();
    int[] layout = pe.computeLayout(stringData.length);
    int stringsStart = layout[0];
    int[] iatAddrs = cg.computeIatAddresses(layout);

    cg.patchForwardCalls(finalCode);

    cg.patchStringRefs(finalCode, stringsStart, rdataRva);
    cg.patchImportRefs(finalCode, iatAddrs, rdataRva);
    // OVERHAUL.md --runtime: repoint HeapAlloc references at the embedded
    // allocator slot and fix up the runtime state addresses. Runs after the
    // ordinary IAT patch so the redirect wins.
    cg.patchRuntimeRefs(finalCode, stringsStart, rdataRva);
    cg.patchGlobalRefs(finalCode, stringsStart + stringData.length, rdataRva);

    // Version pairs ride the hoisted viKeys/viValues (shared with the
    // object tier above).
    string[] versionData = [];
    for (int vi = 0; vi < viKeys.length; vi++) {
        versionData.add(viKeys[vi]);
        versionData.add(viValues[vi]);
    }

    pe.globalAreaSize = cg.globalAreaSize;
    peData = pe.build(finalCode, stringData, versionData);
    } // end else (non-MACX64 finalize)
    }

    if (flags.mode == 1) {
        // OVERHAUL.md --jit: run the emitted image as a direct child process
        // and propagate its exit code. Standalone outputs keep the requested
        // binary on disk (legacy parity); projects leave nothing behind.
        if (progress != null) { progress.phaseEmit(); }
        if (!inputIsProject) {
            drvWriteOutput(outputFile, peData);
        }
        // OVERHAUL.md --cache-bytecode: flush the session before the success
        // line so the compile is only reported done once every artifact is on
        // disk. Read-only --cache-object-alone sessions skip this entirely
        // (the tier was only read, never synced — no report either).
        if (sess != null && !sess.readOnly) {
            if (progress != null) { progress.phaseCache(); }
            sess.flush();
            if (progress != null) { progress.cacheDone(sess.statsDirty(), sess.statsTotal()); }
        }
        // Compilation succeeded before the image executes.
        drvReportSuccess(outputFile, moduleCount, startTick);
        return jitExecute(flags, peData, inputFile);
    }

    // Phase C: announce the write, then persist the bytecode cache (stale
    // entries dropped too) BEFORE the success line so the compile is only
    // reported done once every artifact is on disk.
    if (progress != null) { progress.phaseEmit(); }
    drvWriteOutput(outputFile, peData);
    eprintln("Generated: " + outputFile);
    // Read-only --cache-object-alone sessions skip the sync report (see above).
    if (sess != null && !sess.readOnly) {
        if (progress != null) { progress.phaseCache(); }
        sess.flush();
        if (progress != null) { progress.cacheDone(sess.statsDirty(), sess.statsTotal()); }
    }
    drvReportSuccess(outputFile, moduleCount, startTick);
    return 0;
}

// ---------------------------------------------------------------------------
// OVERHAUL.md --watch: idle-debounce watcher loop. Every save resets the
// timer; precompilation fires only after exactly the configured idle time.
// Polling goes through the fs builtins (mtime + size signatures every 500 ms).
// ---------------------------------------------------------------------------

void runWatchLoop(CliFlags flags, bool inputIsProject, string manifestText, string outputFile, string exeDir) {
    // Memory note: every rebuild runs in-process, so each tick's full working
    // set (aggregate + tokens + AST) stays resident in the never-free runtime.
    // Reclaiming it fully would need each rebuild to run in a fresh child
    // process — deliberately not restructured here. What IS bounded cheaply:
    // the poll snapshot buffers below are drained and refilled in place
    // instead of reallocated per tick.
    string root = ".";
    string[] files = [];
    bool multiFile = false;
    string cfgManifest = "";
    if (inputIsProject) {
        root = projectDirname(flags.input);
        files = watchScanSources(root);
        multiFile = files.length > 1;
        cfgManifest = manifestText;
    } else {
        root = path.dirname(flags.input);
        files.add(flags.input);
    }

    WatchConfig cfg = watchConfigFor(multiFile, cfgManifest);
    int totalSize = wtTotalSize(files);
    if (totalSize > cfg.sizeLimitBytes) {
        flags.errLine("watch: project exceeds the size limit (" + (string)totalSize + " bytes); nothing is watched");
        exit(1);
    }

    flags.errLine("watching " + root + " (" + (string)files.length + " file(s), idle timer " + (string)cfg.frequencySecs + "s)");

    // Initial signature snapshot (mtime + size per watched file).
    string[] sigPaths = [];
    int[] sigMtimes = [];
    int[] sigSizes = [];
    for (int i = 0; i < files.length; i++) {
        sigPaths.add(files[i]);
        sigMtimes.add(file.modification(files[i]).milliseconds());
        sigSizes.add(file.size(files[i]));
    }

    // Idle-debounce timers ride the universal time module (QPC, monotonic).
    float64 idleStart = time.now();
    while (true) {
        time.sleep(500);

        // Rescan: any change (mtime, size, new or removed file) resets the
        // idle timer to zero.
        string[] current = files;
        if (inputIsProject) { current = watchScanSources(root); }
        bool changed = current.length != sigPaths.length;
        int newestSrc = 0;
        for (int c = 0; c < current.length && !changed; c++) {
            string path = current[c];
            int m = file.modification(path).milliseconds();
            if (m <= 0) {
                // File vanished mid-save; treat as a change.
                changed = true;
                break;
            }
            int s = file.size(path);
            bool known = false;
            for (int p = 0; p < sigPaths.length; p++) {
                if (sigPaths[p] == path) {
                    known = true;
                    if (sigMtimes[p] != m || sigSizes[p] != s) {
                        sigMtimes[p] = m;
                        sigSizes[p] = s;
                        changed = true;
                    }
                    break;
                }
            }
            if (!known) { changed = true; }
        }
        if (changed) {
            // Re-sync the snapshot so newly added files gain entries. The
            // buffers drain in place (capacity reused) instead of reallocating.
            while (sigPaths.length > 0) { sigPaths.pop(); }
            while (sigMtimes.length > 0) { sigMtimes.pop(); }
            while (sigSizes.length > 0) { sigSizes.pop(); }
            for (int r = 0; r < current.length; r++) {
                sigPaths.add(current[r]);
                sigMtimes.add(file.modification(current[r]).milliseconds());
                sigSizes.add(file.size(current[r]));
            }
            idleStart = time.now();
            continue;
        }

        // Idle long enough? Fires only after exactly the configured idle
        // duration with no saves in between. (int() truncation keeps the
        // whole-ms granularity the GetTickCount comparison had.)
        if (int(time.now() - idleStart) < cfg.frequencySecs * 1000) { continue; }

        // Manual-compilation guard: if the output binary is newer than the
        // newest source mtime recorded at the last check, someone built it
        // externally since then — skip this tick and resync.
        if (file.exists(outputFile)) {
            int outM = file.modification(outputFile).milliseconds();
            for (int m2 = 0; m2 < sigMtimes.length; m2++) {
                if (sigMtimes[m2] > newestSrc) { newestSrc = sigMtimes[m2]; }
            }
            if (outM > newestSrc) {
                flags.errLine("watch: external build detected, skipping this tick");
                idleStart = time.now();
                continue;
            }
        }

        flags.errLine("watch: idle timer expired, precompiling");
        int code = compileOnce(flags, outputFile, exeDir);
        if (code != 0) {
            flags.errLine("watch: precompilation failed");
        }

        // Re-sync state after the tick (same in-place drain as above).
        while (sigPaths.length > 0) { sigPaths.pop(); }
        while (sigMtimes.length > 0) { sigMtimes.pop(); }
        while (sigSizes.length > 0) { sigSizes.pop(); }
        string[] post = files;
        if (inputIsProject) { post = watchScanSources(root); }
        for (int q = 0; q < post.length; q++) {
            sigPaths.add(post[q]);
            sigMtimes.add(file.modification(post[q]).milliseconds());
            sigSizes.add(file.size(post[q]));
        }
        idleStart = time.now();
    }
}
