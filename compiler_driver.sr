    public bool isBuiltinMemberCall(Node call) {
        if (!call.isMember || call.childCount() < 1) { return false; }
        string name = call.name;
        string recvType = this.inferExprType(call.child(0));
        if (this.strEq(name, "toString")) {
            if (this.strEq(recvType, "string") || this.strEq(recvType, "char") || this.strEq(recvType, "int") || this.strEq(recvType, "int64") || this.strEq(recvType, "bool") || this.strEq(recvType, "float64")) {
                return true;
            }
        }
        if (this.strEq(recvType, "string")) {
            if (this.strEq(name, "contains") || this.strEq(name, "trimEnd") || this.strEq(name, "startsWith") || this.strEq(name, "endsWith") || this.strEq(name, "indexOf") || this.strEq(name, "substr") || this.strEq(name, "toLower") || this.strEq(name, "toUpper") || this.strEq(name, "replace") || this.strEq(name, "toInt64") || this.strEq(name, "toInt") || this.strEq(name, "toNumber")) {
                return true;
            }
        }
        if (this.strEq(recvType, "char")) {
            if (this.strEq(name, "isDigit") || this.strEq(name, "isAlpha") || this.strEq(name, "isAlphaNum") || this.strEq(name, "isLower") || this.strEq(name, "isUpper")) {
                return true;
            }
        }
        return false;
    }

    public void genBuiltinMemberCall(Node call) {
