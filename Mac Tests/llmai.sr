// Offline coverage for the LLM client surface (mirrors silverc/std/llmai.sr).
//
// NOTE: this file is deliberately self-contained (no `import * from llmai`).
// A test named llmai.sr shadows the std module of the same name, so the
// import would resolve to this file itself and the std classes would never
// load (`unknown method "LLMClient"`). Keep the classes below in sync with
// silverc/std/llmai.sr; only the network call is stubbed out by omission —
// main() never invokes ChatCompletions.create(), so no live network or API
// key is required on any OS.

// --- surface mirror (keep in sync with silverc/std/llmai.sr) ---

enum Compatibility {
    OpenAI,
    Anthropic,
    Gemini,
    DeepSeek,
    Qwen,
    Zhipu,
    Moonshot,
    Baichuan,
    Doubao,
    MiniMax,
    Custom
}

class LlmHeaders {
    public prop string contentType;
    public prop string authorization;
    public prop string extraName;
    public prop string extraValue;

    construct(string key, Compatibility compatibility) {
        this.contentType = "application/json";
        this.authorization = "Bearer " + key;
        this.extraName = "";
        this.extraValue = "";
    }

    private bool same(string a, string b) {
        if (a.length != b.length) { return false; }
        for (int i = 0; i < a.length; i++) {
            char ca = a[i];
            char cb = b[i];
            if (ca >= 'a' && ca <= 'z') { ca = ca - 32; }
            if (cb >= 'a' && cb <= 'z') { cb = cb - 32; }
            if (ca != cb) { return false; }
        }
        return true;
    }

    public bool has(string name) {
        return this.same(name, "Content-Type") || this.same(name, "Authorization")
            || (this.extraName.length > 0 && this.same(name, this.extraName));
    }

    public string get(string name) {
        if (this.same(name, "Content-Type")) { return this.contentType; }
        if (this.same(name, "Authorization")) { return this.authorization; }
        if (this.extraName.length > 0 && this.same(name, this.extraName)) {
            return this.extraValue;
        }
        return "";
    }

    public void set(string name, string value) {
        if (this.same(name, "Content-Type")) {
            this.contentType = value;
        } else if (this.same(name, "Authorization")) {
            this.authorization = value;
        } else {
            this.extraName = name;
            this.extraValue = value;
        }
    }

    public string serialize() {
        string result = "Content-Type: " + this.contentType + "\r\n";
        result += "Authorization: " + this.authorization + "\r\n";
        if (this.extraName.length > 0) {
            result += this.extraName + ": " + this.extraValue + "\r\n";
        }
        return result;
    }
}

class ChatResponseMessage {
    public prop string content;

    construct {
        this.content = "";
    }
}

class ChatChoice {
    public prop ChatResponseMessage message;

    construct {
        this.message = new ChatResponseMessage();
    }
}

class ChatCompletionResponse {
    public prop ChatChoice[] choices;

    construct {
        this.choices = [];
        this.choices.push(new ChatChoice());
    }
}

class ChatCompletionRequest {
    public prop string model;
    public prop string messageRole;
    public prop string messageContent;
    public prop ChatCompletionResponse response;

    construct(string modelName) {
        this.model = modelName;
        this.messageRole = "";
        this.messageContent = "";
        this.response = new ChatCompletionResponse();
    }

    public void addMessage(string role, string content) {
        this.messageRole = role;
        this.messageContent = content;
    }

    public string serialize() {
        return "{\"model\":\"" + this.model
            + "\",\"messages\":[{\"role\":\"" + this.messageRole
            + "\",\"content\":\"" + this.messageContent + "\"}]}";
    }

    public void updateResponse(string raw) {
        this.response.choices[0].message.content = raw;
    }
}

class ChatCompletions {
    public prop string url;
    public prop LlmHeaders headers;

    construct(string endpoint, LlmHeaders requestHeaders) {
        this.url = endpoint;
        this.headers = requestHeaders;
    }
}

class ChatRoot {
    public prop ChatCompletions completions;

    construct(string endpoint, LlmHeaders requestHeaders) {
        this.completions = new ChatCompletions(endpoint, requestHeaders);
    }
}

class LLMClient {
    public prop string url;
    public prop string apiKey;
    public prop Compatibility compatibility;
    public prop LlmHeaders headers;
    public prop ChatRoot chat;

    construct(string endpoint, string key, Compatibility mode) {
        this.url = endpoint;
        this.apiKey = key;
        this.compatibility = mode;
        this.headers = new LlmHeaders(key, mode);
        this.chat = new ChatRoot(endpoint, this.headers);
    }
}

// --- offline test (no network, no API key) ---

void fail(string msg) {
    printline("FAILED: " + msg);
    exit(1);
}

void main() {
    string url = "https://api.example.com/v1/chat/completions";

    // 1) Environment-variable path: env.get(name) returns "" when missing.
    string missing = env.get("SILVER_LLM_TEST_ABSENT_VAR");
    if (missing.length != 0) {
        fail("env.get of an absent variable should be empty");
    }
    string key = env.get("LLM_API_KEY");
    string keySource = "env(LLM_API_KEY)";
    // 2) Offline fallback: a dummy key is enough — nothing is sent anywhere.
    if (key.length == 0) {
        key = "offline-test-key";
        keySource = "offline fallback";
    }
    printline("API key source: " + keySource);
    if (key.length == 0) {
        fail("no API key available");
    }

    // 3) Client construction + header surface.
    LLMClient client = new LLMClient(url, key, Compatibility.OpenAI);
    if (client.url != url) {
        fail("client url not stored");
    }
    if (client.apiKey != key) {
        fail("client api key not stored");
    }
    client.headers.set("X-Client", "silver");
    printline("LLM compatibility: OpenAI");
    if (!client.headers.has("Content-Type")) {
        fail("missing Content-Type header");
    }
    if (client.headers.get("Content-Type") != "application/json") {
        fail("wrong Content-Type value");
    }
    // Header lookup is case-insensitive.
    if (!client.headers.has("content-type")) {
        fail("header lookup should be case-insensitive");
    }
    if (!client.headers.has("AUTHORIZATION")) {
        fail("header lookup should be case-insensitive");
    }
    if (!client.headers.has("Authorization")) {
        fail("missing Authorization header");
    }
    if (client.headers.get("Authorization") != "Bearer " + key) {
        fail("wrong Authorization value");
    }
    if (!client.headers.has("X-Client")) {
        fail("missing custom header");
    }
    string wire = client.headers.serialize();
    printline("LLM headers:");
    printline(wire);
    if (wire != "Content-Type: application/json\r\nAuthorization: Bearer " + key + "\r\nX-Client: silver\r\n") {
        fail("header serialization mismatch");
    }

    // 4) Request construction + body serialization.
    ChatCompletionRequest request = new ChatCompletionRequest("auto");
    if (request.model != "auto") {
        fail("request model not stored");
    }
    if (request.response.choices.length != 1) {
        fail("fresh response should hold exactly one choice");
    }
    if (request.response.choices[0].message.content.length != 0) {
        fail("fresh response content should be empty");
    }
    request.addMessage("user", "Say hello in one sentence.");
    string body = request.serialize();
    printline("Serialized body: " + body);
    if (body != "{\"model\":\"auto\",\"messages\":[{\"role\":\"user\",\"content\":\"Say hello in one sentence.\"}]}") {
        fail("request serialization mismatch");
    }

    // 5) Mocked completion flow: feed a canned payload through the same
    // response path the live call fills in (no network involved).
    string canned = "{\"id\":\"chatcmpl-mock\",\"choices\":[{\"message\":{\"content\":\"Hello!\"}}]}";
    request.updateResponse(canned);
    string content = request.response.choices[0].message.content;
    printline("LLM response: " + content);
    if (content != canned) {
        fail("mocked response did not round-trip");
    }

    // 6) Client wiring: chat root shares the endpoint and headers.
    if (client.chat.completions.url != url) {
        fail("chat completions url not wired");
    }
    if (client.chat.completions.headers.serialize() != wire) {
        fail("chat completions headers not wired");
    }

    // 7) Remaining compatibility modes construct cleanly.
    LLMClient a2 = new LLMClient(url, key, Compatibility.Anthropic);
    LLMClient c2 = new LLMClient(url, key, Compatibility.Custom);
    if (a2.headers.get("Content-Type") != "application/json") {
        fail("anthropic client headers broken");
    }
    if (c2.headers.get("Authorization") != "Bearer " + key) {
        fail("custom client headers broken");
    }

    printline("OK: LLM client offline coverage passed");
}
