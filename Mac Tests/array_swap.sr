// Array swap (DOCS/272): arr.swap(i, j) exchanges two elements in place
// for every element type, bounds-checks both indexes, and leaves the array
// unchanged when either index is out of range. Exit code 0 = exact.

void check(bool ok, string label) {
    if (!ok) {
        printline("FAIL " + label);
        exit(1);
    }
}

void main() {
    // The requested example: strings swap positions 1 and 2.
    string[] fruits = ["apple", "citrus", "banana"];
    fruits.swap(1, 2);
    check(fruits[0] == "apple", "fruit-0");
    check(fruits[1] == "banana", "fruit-1");
    check(fruits[2] == "citrus", "fruit-2");

    // Ints: first and last exchange.
    int[] nums = [1, 2, 3];
    nums.swap(0, 2);
    check(nums[0] == 3, "int-0");
    check(nums[1] == 2, "int-1");
    check(nums[2] == 1, "int-2");

    // Floats keep their values through the swap.
    float[] vals = [1.5, 2.5, 3.5];
    vals.swap(0, 1);
    check(vals[0] == 2.5, "float-0");
    check(vals[1] == 1.5, "float-1");
    check(vals[2] == 3.5, "float-2");

    // Same index is a checked no-op.
    int[] same = [7, 8];
    same.swap(1, 1);
    check(same[0] == 7, "same-0");
    check(same[1] == 8, "same-1");

    // Out-of-range high index throws and changes nothing.
    int[] guarded = [1, 2, 3];
    try {
        guarded.swap(0, 9);
        printline("FAIL oob-high silently swapped");
        exit(1);
    } catch (Exception e) {
    }
    check(guarded[0] == 1, "oob-high-0");
    check(guarded[1] == 2, "oob-high-1");
    check(guarded[2] == 3, "oob-high-2");

    // Negative index throws too.
    try {
        guarded.swap(-1, 0);
        printline("FAIL oob-negative silently swapped");
        exit(1);
    } catch (Exception e) {
    }
    check(guarded[0] == 1, "oob-neg-0");

    // Wrong arity throws.
    try {
        guarded.swap(0);
        printline("FAIL arity silently swapped");
        exit(1);
    } catch (Exception e) {
    }
    check(guarded[0] == 1, "arity-0");

    printline("array swap ok");
}
