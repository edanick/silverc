// DOCS/273: null-safe indexing (`?[]`).
// Exit code 0 = exact. Covers null/non-null receivers, chaining with
// `?.`/`?[]`, combos with `??`, and the OOB rule (only null is safe:
// a live out-of-range index still throws).

class Row {
    public prop string[] cells;
    construct (string[] c) {
        this.cells = c;
    }
}

void check(bool ok, string label) {
    if (!ok) {
        printline("FAIL " + label);
        exit(1);
    }
}

int boomIdx() {
    printline("FAIL index evaluated on null receiver");
    exit(1);
    return 0;
}

void main() {
    string[] users = ["alice", "bob"];
    string[]? missing = null;

    // Live receiver yields the element.
    string? a = users?[0];
    check((a ?? "MISSING") == "alice", "live-index-0");
    string? b = users?[1];
    check((b ?? "MISSING") == "bob", "live-index-1");

    // Null receiver yields null without touching the index.
    string? c = missing?[0];
    check((c ?? "MISSING") == "MISSING", "null-index");

    // Null receiver with a side-effecting index: the index never runs.
    // `boomIdx` exits 1 if it ever evaluates, so reaching the next line
    // proves laziness.
    string? d = missing?[boomIdx()];
    check((d ?? "MISSING") == "MISSING", "null-index-lazy");

    // Chain `?[]` with `?.`: row holds the array, null row short-circuits.
    Row r = new Row(["x", "y"]);
    Row? nr = null;
    string? e = r?.cells?[1];
    check((e ?? "MISSING") == "y", "chain-member-index");
    string? f = nr?.cells?[1];
    check((f ?? "MISSING") == "MISSING", "chain-null-row");

    // Chain `?[]` with `?.`: element length via a temp (method calls on
    // complex receivers miscompile on the bootstrap, so the two-step
    // variable form is the supported spelling here).
    string? tmpElem = users?[0];
    int g = tmpElem?.length() ?? 0;
    check(g == 5, "index-then-length");

    // OOB on a live receiver still throws (only null is safe).
    try {
        string? oob = users?[5];
        printline("FAIL oob silently yielded " + (oob ?? "null"));
        exit(1);
    } catch (Exception e) {
    }

    printline("null safe index ok");
}
