// `internal` visibility: items are usable anywhere within the current .srp
// project but must not leak to external imports. This test exercises the
// modifier on classes, props, top-level globals, constants, functions,
// combined `public internal` / `internal public` spellings, and modules.

internal class Vehicle {
	public internal prop string Name;
	internal prop int wheels;

	construct (string name) {
		this.Name = name;
		this.wheels = 4;
	}
}

public class Person {
	public internal prop bool verified;
	public prop string Name;

	construct (string name) {
		this.Name = name;
		this.verified = false;
	}
}

internal mod vehstats {
	internal int base_weight = 100;
}

internal mod export internal_helpers;

internal int x = 2;
internal bool skip = false;
internal const int LIMIT = 10;

internal int bonus(int v) {
	return v + x;
}

public internal int doubled(int v) {
	return v * 2;
}

internal public int tripled(int v) {
	return v * 3;
}

void main() {
	Vehicle v = new Vehicle("truck");
	Person p = new Person("ada");
	int total = v.wheels + x;
	if (skip) {
		total = 0;
	}
	if (p.verified) {
		total = 0;
	}
	total += bonus(1) + doubled(2) + tripled(3) + LIMIT;
	if (total != 32) {
		exit(1);
	}
	printline(v.Name);
	printline(p.Name);
	printline(total);
}
