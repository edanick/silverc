// Compression modules (DOCS/260) -- the `gzip.compress(data)` handle form,
// compile-only (no main). After `import { gzip, zstd, deflate } from
// compression;` the static facades are called with no `new`; `compress(data)`
// uses each algorithm's default level (6 / 6 / 3) and `compress(data, level)`
// overrides it. Compiles under silverc-rs, silverc and silveri; the codecs
// execute end to end in the compiler suites (silverc-rs/tests/suite,
// silverc/tests) -- the interpreter cannot run these byte-level engines, so
// this file has no main.
import { gzip, zstd, deflate } from compression;

void useSurface() {
    byte[] data = [1, 2, 3, 4];
    printline(deflate.decompress(deflate.compress(data)).length.toString());
    printline(deflate.decompress(deflate.compress(data, 9)).length.toString());
    printline(gzip.decompress(gzip.compress(data)).length.toString());
    printline(gzip.decompress(gzip.compress(data, 0)).length.toString());
    printline(zstd.decompress(zstd.compress(data)).length.toString());
    printline(zstd.decompress(zstd.compress(data, 22)).length.toString());
}
