// Compile-only fixture for `.srp` `nativeModules` (custom native modules).
// No `main`: this file passes on compile. Nothing here runs, so the fake
// libraries are never loaded — a successful build proves the declared
// custom modules resolve into the PE table / ELF dynamic entries.
// `neverCalled` is granted but never called (lazy: emits nothing), and
// `unusedmod`/`winonly` are declared but never used (emits nothing).
import bare_imports;
import star_imports;
import { fakeCompute, neverCalled } from win32.fakebridge;
import { fakeComputeLinux } from linux.fakebridge;

int probeHelper(int x) {
    int a = fakeCompute(x);
    int b = fakeComputeLinux(a);
    return a + b;
}
