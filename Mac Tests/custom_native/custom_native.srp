{
    name: "custom_native",
    version: "0.1.0",
    license: "test",
    entry: "bridge.sr",
    sources: ["."],
    nativeModules: [
        { "module": "fakebridge", "windows": "fake-win.dll", "linux": "libfake.so.9" },
        { "module": "unusedmod", "windows": "never-used.dll", "linux": "libneverused.so.9" },
        { "module": "gfx", "windows": "fake-gfx.dll", "linux": "libfakegfx.so.1" },
        { "module": "winonly", "windows": "fake-winonly.dll" },
        { "module": "samefile", "windows": "fake-common.dll", "linux": "fake-common.dll" },
        { "module": "sharea", "windows": "fake-shared.dll", "linux": "libfakeshared.so.1" },
        { "module": "shareb", "windows": "fake-shared.dll", "linux": "libfakeshared.so.1" },
        { "module": "starmod", "windows": "fake-star.dll", "linux": "libfakestar.so.1", "exports": ["starAlpha", "starBeta"] }
    ],
    output: "custom_native"
}
