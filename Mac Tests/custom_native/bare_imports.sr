// Compile-only fixture: one bare line per custom module, no `#on` regions.
// The compiler resolves each bare name against `nativeModules` for the
// TARGET OS (`--os` flag): the `windows` file on Windows targets, the
// `linux` file on Linux targets.
import { gfxCompute } from gfx;
import { sameCompute } from samefile;
import { sharedAlpha } from sharea;
import { sharedBeta } from shareb;

int bareGfxHelper(int x) {
    return gfxCompute(x);
}

int bareSameHelper(int x) {
    return sameCompute(x);
}

int bareSharedHelper(int x) {
    int a = sharedAlpha(x);
    int b = sharedBeta(a);
    return a + b;
}
