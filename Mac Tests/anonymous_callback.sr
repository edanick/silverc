// DOCS/259 — anonymous function arguments and function-typed parameters.
// Self-hosted-suite mirror of silverc-rs/tests/suite/anonymous_callback.sr:
// runJob invokes the parameter twice, retry once per loop iteration, and
// runTwo receives two anonymous functions in one call. Each body asserts its
// own computation and exits non-zero on mismatch, so the suite fails unless
// the indirect calls actually run the bodies.

void runJob(void () job) {
    job();
    job();
}

void retry(int attempts, void () job) {
    for (int i = 0; i < attempts; i++) {
        job();
    }
}

void runTwo(void () first, void () second) {
    first();
    second();
}

void main() {
    runJob((void () {
        printline("job body running");
        int sum = 0;
        for (int i = 0; i < 3; i++) {
            sum += i;
        }
        if (sum != 3) {
            exit(1);
        }
        printline("sum " + sum);
    }));
    retry(2, (void () {
        printline("retry attempt");
        int doubled = 21 + 21;
        if (doubled != 42) {
            exit(2);
        }
    }));
    runTwo((void () {
        printline("first callback");
    }), (void () {
        printline("second callback");
    }));
    printline("all callbacks done");
}
