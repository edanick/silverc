mod export compiler;

import * from fs;

class MyClass {
    public prop int val;
    
    construct(int v) {
        this.val = v;
    }
    
    public int getVal() {
        return this.val;
    }
}

void testFunc(MyClass c) {
    printline(c.getVal());
}

void main() {
    MyClass obj = new MyClass(42);
    printline(obj.getVal());
    testFunc(obj);
}
