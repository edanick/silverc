// Multiple class inheritance (DOCS/207): a class lists two or more
// parents (`:` or `extends` + comma-separated names). Fields concatenate
// in listed order, methods resolve left-to-right (own first, then the
// first listed parent), super() builds the first parent, and a diamond
// shares nothing but compiles and runs. Exit code 0 = exact.
public class Creature {
    string species;
    int age;

    construct(string s, int a) {
        this.species = s;
        this.age = a;
    }

    string breathe() {
        return this.species + " breathes";
    }

    string move() {
        return this.species + " moves";
    }

    string identify() {
        return "creature:" + this.species;
    }
}

public class Human {
    string name;
    string language;

    construct(string n, string l) {
        this.name = n;
        this.language = l;
    }

    string speak() {
        return this.name + " speaks " + this.language;
    }

    string work() {
        return this.name + " works";
    }

    string identify() {
        return "human:" + this.name;
    }
}

public class Person : Creature, Human {
    string job;

    construct(string s, int a, string n, string l, string j) {
        super(s, a);
        this.name = n;
        this.language = l;
        this.job = j;
    }

    string identify() {
        return "person:" + this.name;
    }

    string describe() {
        return this.name + " the " + this.species + " aged " + (string)this.age + " works as " + this.job;
    }
}

public class Citizen extends Creature, Human {
    string city;

    construct(string s, int a, string n, string l, string c) {
        super(s, a);
        this.name = n;
        this.language = l;
        this.city = c;
    }
}

class A {
    string tag;

    construct(string t) {
        this.tag = t;
    }

    string who() {
        return "A:" + this.tag;
    }
}

class B : A {
    string bval;

    construct(string t, string b) {
        super(t);
        this.bval = b;
    }

    string getB() {
        return "B:" + this.bval;
    }
}

class C : A {
    string cval;

    construct(string t, string c) {
        super(t);
        this.cval = c;
    }

    string getC() {
        return "C:" + this.cval;
    }
}

class D : B, C {
    string dval;

    construct(string t, string b, string c, string d) {
        super(t, b);
        this.cval = c;
        this.dval = d;
    }
}

void check(bool ok, string label) {
    if (!ok) {
        printline("FAIL " + label);
        exit(1);
    }
}

void main() {
    Person p = new Person("homo sapiens", 30, "Alice", "English", "engineer");
    check(p.species == "homo sapiens", "creature-field");
    check(p.age == 30, "creature-int-field");
    check(p.name == "Alice", "human-field");
    check(p.language == "English", "human-field-2");
    check(p.job == "engineer", "own-field");
    check(p.breathe() == "homo sapiens breathes", "creature-method");
    check(p.move() == "homo sapiens moves", "creature-method-2");
    check(p.speak() == "Alice speaks English", "human-method");
    check(p.work() == "Alice works", "human-method-2");
    check(p.identify() == "person:Alice", "own-override");
    check(p.describe() == "Alice the homo sapiens aged 30 works as engineer", "own-method");

    Citizen c = new Citizen("homo sapiens", 41, "Bob", "French", "Paris");
    check(c.speak() == "Bob speaks French", "extends-form-human");
    check(c.breathe() == "homo sapiens breathes", "extends-form-creature");
    check(c.identify() == "creature:homo sapiens", "mro-first-parent");
    check(c.city == "Paris", "extends-own-field");

    D d = new D("root", "bee", "cee", "dee");
    check(d.tag == "root", "diamond-shared-direct");
    check(d.bval == "bee", "diamond-b-direct");
    check(d.cval == "cee", "diamond-c-direct");
    check(d.dval == "dee", "diamond-own-direct");
    check(d.who() == "A:root", "diamond-a-method");
    check(d.getB() == "B:bee", "diamond-b-method");
    check(d.getC() == "C:cee", "diamond-c-method");
    printline("MI-OK");
}
