mod export test_driver;

void main() {
    printline("driver start");
    MiniPe pe;
    pe = new MiniPe();
    printline("pe created");
    int[] result = pe.build([]);
    printline("build returned: " + result.length);
}

class MiniPe {
    public prop int[] code;
    public prop int entryRva;
    public prop int[] imports;

    construct () {
        this.code = [];
        this.entryRva = 0;
        this.imports = [];
    }

    public int padToAlign(int value, int align) {
        if (value % align == 0) { return value; }
        return value + align - (value % align);
    }

    public void addImport(string dll, string name) {
        this.imports.add(0);
    }

    public int computeRdataRva() {
        int SECT_ALIGN = 0x1000;
        int headersRawSize = 64 + 4 + 20 + 240 + 2 * 40;
        int FILE_ALIGN = 0x200;
        int headersSize = this.padToAlign(headersRawSize, FILE_ALIGN);
        int textRva = SECT_ALIGN;
        int textVirt = this.padToAlign(this.code.length, SECT_ALIGN);
        return textRva + textVirt;
    }

    public int[] build(int[] stringData) {
        printline("build start");
        int[] result = [];
        result.add(1);
        result.add(2);
        result.add(3);
        printline("build end");
        return result;
    }
}
