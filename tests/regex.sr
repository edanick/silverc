// The regex std module provides a simple wildcard matcher: `.` and `?`
// match any single character, `*` matches any run of characters, `+`
// matches a non-empty run. `test` matches the whole input against the
// pattern; `match`/`findAll`/`replace` anchor at the earliest position
// where the whole remaining suffix matches, so star-led patterns are the
// predictable shape. `regex.split` delegates to the string split. The
// member call sites exercise keyword-named methods (`pattern.match`)
// after the dot.
import * from regex;

void expect(bool got, string what) {
    if (!got) {
        printline("regex check failed: " + what);
        exit(1);
    }
}

void main() {
    pattern dot = regex.compile("h.llo");
    expect(dot.test("hello"), "h.llo matches hello");
    expect(dot.test("hallo"), "h.llo matches hallo");
    expect(!dot.test("hllo"), "h.llo rejects a missing character");
    expect(!dot.test("hello!"), "h.llo rejects trailing text");

    pattern star = regex.compile("ab*");
    expect(!star.test("a"), "ab* needs the literal b");
    expect(star.test("ab"), "ab* matches ab");
    expect(star.test("abzzz"), "ab* matches trailing run");

    pattern plus = regex.compile("ab+");
    expect(plus.test("abz"), "ab+ matches a non-empty run");
    expect(!plus.test("a"), "ab+ rejects a bare a");

    pattern any = regex.compile("h?llo");
    expect(any.test("hello"), "h?llo matches hello");
    expect(!any.test("hllo"), "h?llo rejects a missing character");

    pattern all = regex.compile("*");
    expect(all.test("anything"), "* matches everything");
    expect(all.match("hey") == "hey", "match returns the whole hit");

    pattern lead = regex.compile("a*");
    expect(lead.match("anana") == "anana", "match grows from the first hit");
    string[] hits = lead.findAll("banana");
    expect(hits.length == 1, "findAll finds the anana hit");
    expect(hits[0] == "anana", "findAll returns the hit text");

    pattern tail = regex.compile("o*");
    expect(tail.replace("hello world", "O") == "hellO", "replace swaps the hit");
    pattern none = regex.compile("z*");
    expect(none.replace("apple", "Q") == "apple", "replace leaves a miss alone");

    string[] parts = regex.split("a,b,c", ",");
    expect(parts.length == 3, "split makes three parts");
    expect(parts[0] == "a" && parts[1] == "b" && parts[2] == "c", "split keeps the parts");

    printline("ok");
}
