// Null-state propagation (null-state-flow concept): assignments,
// `??=` results, and declarations carry their source's null-state, and
// branch joins keep only facts that hold on every completing path.
// Exit code 0 = exact.

int? src() << null;

int? src_or(int v) << v;

void main() {
    // Assignment propagation: `x = 5` proves x non-null; reassignment of
    // a maybe-null source drops the fact again.
    int? x = src();
    if (x != null) {
        int a = x;
        printline(a);
    }
    x = 5;
    int b = x;
    printline(b);
    x = src();
    if (x != null) {
        // `??=` with a non-null right side leaves the target non-null.
        x ??= 9;
        int c = x;
        printline(c);
    }

    // Declaration state: a literal initializer starts non-null even for
    // a nullable declaration.
    int? lit = 7;
    int d = lit;
    printline(d);

    // Join: the fact holds on BOTH branches, so it survives the if.
    int? y = src();
    if (src_or(1) > 0) {
        y = 1;
    } else {
        y = 2;
    }
    int e = y;
    printline(e);

    // Join with a terminal branch: the null path returns, so the
    // surviving path's fact (from the condition's false-facts) holds.
    int? z = src();
    if (z == null) {
        return;
    }
    int f = z;
    printline(f);

    // While exit facts: the loop only exits when the condition is false,
    // which proves `w` non-null after it.
    int? w = src();
    while (w == null) {
        w = src_or(3);
    }
    int g = w;
    printline(g);

    // `??` unwrapping still proves the result non-null.
    int? q = src();
    int h = q ?? 0;
    printline(h);

    printline("nullstate propagation ok");
}
