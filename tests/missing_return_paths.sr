// Missing-return analysis ("not all code paths return a value"
// concept / MEMORY_GUARD totality): every function declaring a value
// return type must return on all paths. void functions may fall off.

int both_branches_return(int x) {
    if (x > 0) {
        return 1;
    } else {
        return 2;
    }
}

int oneliner_arrow(int x) << x + 1;

int shortcut_tail(int x) {
    if (x < 0) {
        return 0;
    }
    >> x * 2;
}

int while_true_never_falls_off(int x) {
    while (true) {
        if (x > 0) {
            return x;
        }
        x++;
    }
}

int exhaustive_match_returns(int x) {
    return match (x) {
        0 => 100;
        _ => x;
    };
}

void void_falls_off_freely() {
    if (false) {
        return;
    }
}

void main() {
    printline(both_branches_return(1));
    printline(oneliner_arrow(41));
    printline(shortcut_tail(21));
    printline(while_true_never_falls_off(5));
    printline(exhaustive_match_returns(0));
    void_falls_off_freely();
}
