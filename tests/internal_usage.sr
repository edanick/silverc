// `internal` usage enforcement, positive case: every internal item stays
// fully usable from code inside the same project (here: the same file).
// Covers module-qualified calls into an internal mod, unqualified calls of
// internal functions, internal constants, and internal classes with
// internal members. The negative side (external modules) is enforced by
// the compiler and exercised manually via tests/output fixtures.

internal mod vehstats {
	internal int bonus(int v) {
		return v + 100;
	}
}

internal mod export internal_helpers;

internal const int LIMIT = 10;

internal int base_weight = 100;

internal int helper_fn(int v) {
	return v * 3 + LIMIT + base_weight;
}

public internal int doubled(int v) {
	return v * 2;
}

internal class Engine {
	public prop int power;
	internal prop int serial;

	construct (int p) {
		this.power = p;
		this.serial = 7;
	}

	internal int boost(int v) {
		return power + v + serial;
	}
}

void main() {
	int total = vehstats.bonus(5);
	total += helper_fn(2) + doubled(4);
	Engine e = new Engine(50);
	total += e.boost(5) + e.power + e.serial;
	if (total != 348) {
		exit(1);
	}
	printline(total);
}
