// Overload sets dispatch by argument count: every declaration's arity is
// visible at the call sites, and legal calls pick the matching declaration.
// Exercises the guard's overload-arity walk with all-legal calls.

int pick(int a) {
    return a;
}

int pick(int a, int b) {
    return a + b;
}

string pick(string a, string b, string c) {
    return a + b + c;
}

int spread(int base, int[] rest) {
    int total = base;
    foreach (int r in rest) {
        total += r;
    }
    return total;
}

void main() {
    printline(pick(7));
    printline(pick(2, 3));
    printline(pick("o", "n", "e"));
    int[] tail = [10, 20];
    printline(spread(1, tail));
}
