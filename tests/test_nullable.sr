class NullableTest {
    private prop string src;
    private prop int pos;
    construct (string source) {
        this.src = source;
        this.pos = 0;
    }
    char? peek() {
        if (this.pos < this.src.length) {
            return this.src[this.pos];
        }
        return null;
    }
    char? advance() {
        if (this.pos >= this.src.length) { return null; }
        char c = this.src[this.pos];
        this.pos = this.pos + 1;
        return c;
    }
}
void main() {
    NullableTest n = new NullableTest("XY");
    char? c1 = n.advance();
    char? c2 = n.advance();
    char? c3 = n.peek();
    printline("c1=" + c1);
    printline("c2=" + c2);
    if (c3 != null) {
        printline("c3=notnull");
    } else {
        printline("c3=null");
    }
}
