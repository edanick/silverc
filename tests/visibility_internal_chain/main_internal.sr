// Negative case: secretB is internal to mod_b, so using it from the entry
// must make the VisibilityChecker emit the `is internal to project`
// diagnostic and exit(1). Compiling this file is expected to FAIL with
// that diagnostic and non-zero exit; byte-identical diagnostics before and
// after the read-once change are the parity bar.
import mod_b;

void main() {
    int total = mod_b.secretB();
    printline(total);
}
