// Positive case: only public members of the external module are used, so the
// compile must succeed and print vis-public-ok. main_internal.sr in this
// directory is the negative case (uses secretB and must be rejected).
import mod_b;

void main() {
    int total = mod_b.openB();
    if (total != 5) {
        exit(1);
    }
    printline("vis-public-ok");
}
