// A string[] produced by a method call must render as the array's text
// (`["x"]`) wherever a text value is expected: printed on its own and
// concatenated with a string. The compiled backends used to print the
// raw data pointer (`663974352`) because the call result was not
// classified as an array value, so the printer fell back to the pointer
// format. The interpreter (silveri/src/value.sr arrayToString) is the
// reference rendering.
void main() {
    dict<string, int> d = {"x": 1};

    // The printed form: printline(d.keys()) renders the array text.
    printline(d.keys());

    // The concatenated form (observable inside the program).
    string out = "" + d.keys();
    if (out != "[\"x\"]") {
        printline($"array text wrong: {out}");
        exit(1);
    }

    // A string[] local renders the same text.
    string[] ks = d.keys();
    string localOut = "" + ks;
    if (localOut != "[\"x\"]") {
        printline($"local array text wrong: {localOut}");
        exit(1);
    }

    // The projected element itself is text.
    if (d.keys()[0] != "x") {
        printline("keys element wrong");
        exit(1);
    }

    // A values() projection renders the dict's value kind.
    dict<string, string> m = {"k": "v"};
    string valuesOut = "" + m.values();
    if (valuesOut != "[\"v\"]") {
        printline($"values text wrong: {valuesOut}");
        exit(1);
    }

    printline("ok");
}
