// A field read through an `object`-typed local that holds a CLASS
// INSTANCE keeps the class: the read answers the instance's field
// instead of an empty value. The same holds for a class instance
// stored in a `dict<string, object>` (the shape the JSON parser
// builds): the element's dynamic type selects the field's offset and
// the method a call dispatches on.
class Item {
    public string v;
    public int n;

    construct(string s) {
        this.v = s;
        this.n = 7;
    }

    public string describe() {
        return this.v;
    }
}

void main() {
    Item it = new Item("y");
    object o = it;
    if (o.v != "y") {
        printline("object string field read wrong");
        exit(1);
    }
    if (o.n != 7) {
        printline("object int field read wrong");
        exit(1);
    }
    if (o.describe() != "y") {
        printline("object method call wrong");
        exit(1);
    }
    dict<string, object> m = {};
    m["k"] = it;
    if (m["k"].v != "y") {
        printline("dict string field read wrong");
        exit(1);
    }
    if (m["k"].n != 7) {
        printline("dict int field read wrong");
        exit(1);
    }
    if (m["k"].describe() != "y") {
        printline("dict method call wrong");
        exit(1);
    }
    printline("ok");
}
