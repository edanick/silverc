// DOCS/66 json helpers: typed accessors over the dict values json.parse
// builds (getString/getNumber) and constructors for module-built objects
// (objectValue/stringValue/set) that json.stringify serializes. Before the
// fix the helpers did not exist in std/json.sr, so json.getString answered
// 0, and a JsonValue holder had no dict lowering for stringify.
import * from json;

void main() {
    string data = "{\"name\": \"Alice\", \"age\": 30, \"pi\": 3.5}";
    JsonValue parsed = json.parse(data);

    string name = json.getString(parsed, "name");
    if (name != "Alice") {
        printline("name wrong: " + name);
        exit(1);
    }
    int age = json.getNumber(parsed, "age");
    if (age != 30) {
        printline("age wrong: " + age.toString());
        exit(1);
    }
    int pi = json.getNumber(parsed, "pi");
    if (pi != 3) {
        printline("pi should truncate toward zero: " + pi.toString());
        exit(1);
    }
    // Missing keys answer the empty defaults, never a fault.
    if (json.getString(parsed, "missing") != "") {
        printline("missing key should answer an empty string");
        exit(1);
    }
    if (json.getNumber(parsed, "missing") != 0) {
        printline("missing key should answer 0");
        exit(1);
    }

    JsonValue obj = json.objectValue();
    json.set(obj, "greeting", json.stringValue("Hello"));
    string text = json.stringify(obj);
    if (text != "{\"greeting\": \"Hello\"}") {
        printline("stringify wrong: " + text);
        exit(1);
    }
    printline("ok");
}
