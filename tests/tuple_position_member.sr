// A tuple position is addressed by an integer-literal member: `t.0`, `t.1`.
// The member-after-dot rule accepts identifiers and integer literals.

void main() {
    var t = (11, "two", true);
    printline(t.0);
    printline(t.1);
    var p = (4, 5);
    int sum = p.0 + p.1;
    printline(sum);
}
