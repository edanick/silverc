void main() {
    int a = 5;
    int b = 10;
    if (a < b) {
        if (a > 3) {
            printline("nested_if_ok");
        }
    } else {
        printline("nested_fail");
    }
    int sum = 0;
    int i = 1;
    while (i <= 10) {
        sum = sum + i;
        i = i + 1;
    }
    printline(sum);
    if (sum == 55) {
        printline("sum_ok");
    }
}
