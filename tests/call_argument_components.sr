// Full argument checking: composed argument types must agree with the
// parameter in their components (array element types), and a callee that
// reads a parameter through a null-safe form (a `??` coalesce or an
// `== null` guard in its body) accepts a nullable argument — the
// portable-core `choose(value ?? fallback)` shape. Exit code 0 = exact.

string choose(string value, string fallback = "fallback") {
    return value ?? fallback;
}

int lenOr(string s, int fallback) {
    if (s == null) {
        return fallback;
    }
    return s.length;
}

int sumAll(int[] values) {
    int total = 0;
    foreach (int v in values) {
        total += v;
    }
    return total;
}

void check(bool ok, string label) {
    if (!ok) {
        printline("FAIL " + label);
        exit(1);
    }
}

void main() {
    // Array element types agree on both sides.
    int[] nums = [1, 2, 3];
    check(sumAll(nums) == 6, "array-component-agreement");

    // A `??`-coalescing callee is null-tolerant: the nullable argument
    // is legal even though the parameter is declared non-nullable.
    string? missing = null;
    check(choose(missing) == "fallback", "coalescing-callee-tolerant");
    check(choose("solid") == "solid", "coalescing-callee-live");

    // An `== null` guard in the body is null-tolerance too.
    string? blank = null;
    check(lenOr(blank, 0) == 0, "guard-callee-tolerant");
    check(lenOr("abc", 0) == 3, "guard-callee-live");

    printline("call argument components ok");
}
