class Token3 {
    public prop int kind;
    public prop string text;
    public prop int line;

    construct (int k, string t, int ln) {
        this.kind = k; this.text = t; this.line = ln;
    }
}

class Token4 {
    public prop int kind;
    public prop string text;
    public prop int line;
    public prop int col;

    construct (int k, string t, int ln, int c) {
        printline($"CTOR4: k={k} t={t} ln={ln} c={c}");
        this.kind = k; this.text = t; this.line = ln; this.col = c;
    }
}

void main() {
    Token3 a;
    a = new Token3(7, "three", 2);
    printline($"3-arg: kind={a.kind} text={a.text} line={a.line}");

    Token4 b;
    b = new Token4(7, "four", 2, 5);
    printline($"4-arg: kind={b.kind} text={b.text} line={b.line} col={b.col}");
}
