// Token/Node fixture (compiler/token.sr + compiler/node.sr audit): both
// modules are pure data holders — the audit verified they have no
// aggregate `+=` in a loop, no per-character builder, no
// whole-collection copy in a loop, no unbounded growth, no allocation
// written through without a null check and no size computation that can
// overflow or go negative (the M2/M3/M5/M6 families are absent by grep:
// the only heap-shape members are constant per-instance defaults plus
// the never-null sentinel). This program mirrors each pinned default
// and the child access contract in user code so a future edit that
// breaks a default or drops the never-null sentinel fails here. It must
// compile and print exactly `token-node-defaults-ok 28`.
class MirrorToken {
    public prop int kind;
    public prop string text;
    public prop int line;
    public prop int col;
    public prop int64 intVal;
    public prop float64 floatVal;
    public prop string strVal;
    public prop char charVal;
    public prop bool isHexNum;
    public prop int[] ipKinds;
    public prop string[] ipTexts;
    public prop int[] ipLines;
    public prop int[] ipCols;

    construct (int kind, string text, int line, int col) {
        this.kind = kind; this.text = text;
        this.line = line; this.col = col;
        this.intVal = 0; this.floatVal = 0.0;
        this.strVal = ""; this.charVal = ' ';
        this.isHexNum = false;
        this.ipKinds = []; this.ipTexts = []; this.ipLines = []; this.ipCols = [];
    }
}

class MirrorNode {
    public prop int kind;
    public prop int64 intVal;
    public prop float64 floatVal;
    public prop string strVal;
    public prop char charVal;
    public prop bool boolVal;
    public prop int op;
    public prop string name;
    public prop string typeHint;
    public prop string parentClass;
    public prop string[] parentClasses;
    public prop int srcModule;
    public prop int line;
    public prop int col;
    public prop int localBindingSlot;
    public prop MirrorNode[] children;

    construct {
        this.kind = 0; this.intVal = 0; this.floatVal = 0.0;
        this.strVal = ""; this.charVal = ' '; this.boolVal = false;
        this.op = 0; this.name = ""; this.typeHint = "";
        this.parentClass = ""; this.parentClasses = []; this.srcModule = 0; this.children = [];
        this.line = 0; this.col = 0; this.localBindingSlot = 0;
    }

    public int childCount() {
        return this.children.length;
    }

    public MirrorNode child(int i) {
        if (i >= 0 && i < this.children.length) {
            return this.children[i];
        }
        return new MirrorNode();
    }
}

void main() {
    int checks = 0;
    MirrorToken tok = new MirrorToken(168, "x", 7, 9);
    if (tok.kind != 168) { exit(1); }
    checks++;
    if (tok.text != "x") { exit(1); }
    checks++;
    if (tok.line != 7) { exit(1); }
    checks++;
    if (tok.col != 9) { exit(1); }
    checks++;
    if (tok.intVal != 0) { exit(1); }
    checks++;
    if (tok.floatVal != 0.0) { exit(1); }
    checks++;
    if (tok.strVal != "") { exit(1); }
    checks++;
    if (tok.charVal != ' ') { exit(1); }
    checks++;
    if (tok.isHexNum != false) { exit(1); }
    checks++;
    if (tok.ipKinds.length != 0) { exit(1); }
    checks++;
    if (tok.ipTexts.length != 0) { exit(1); }
    checks++;
    if (tok.ipLines.length != 0) { exit(1); }
    checks++;
    if (tok.ipCols.length != 0) { exit(1); }
    checks++;
    MirrorNode node = new MirrorNode();
    if (node.kind != 0) { exit(1); }
    checks++;
    if (node.intVal != 0) { exit(1); }
    checks++;
    if (node.name != "") { exit(1); }
    checks++;
    if (node.typeHint != "") { exit(1); }
    checks++;
    if (node.parentClass != "") { exit(1); }
    checks++;
    if (node.parentClasses.length != 0) { exit(1); }
    checks++;
    if (node.children.length != 0) { exit(1); }
    checks++;
    if (node.srcModule != 0) { exit(1); }
    checks++;
    if (node.childCount() != 0) { exit(1); }
    checks++;
    if (node.child(0).kind != 0) { exit(1); }
    checks++;
    if (node.child(-1).kind != 0) { exit(1); }
    checks++;
    MirrorNode leaf = new MirrorNode();
    leaf.kind = 42;
    node.children.add(leaf);
    if (node.childCount() != 1) { exit(1); }
    checks++;
    if (node.child(0).kind != 42) { exit(1); }
    checks++;
    if (node.child(1).kind != 0) { exit(1); }
    checks++;
    if (checks != 28) { exit(1); }
    printline("token-node-defaults-ok " + (string)checks);
}
