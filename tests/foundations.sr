// A `found` foundation (SPEC 8) is a TYPE: a class implements it by
// listing it among its parents, and the class must provide the members
// the foundation declares. The foundation carries no code, so it
// contributes no fields and no methods: the class is the implementation.
found Greeter {
    string greet();
}

class Person : Greeter {
    public string name;
    construct(string n) {
        this.name = n;
    }
    string greet() {
        return "hi " + this.name;
    }
}

class Robot : Greeter {
    public int id;
    construct(int i) {
        this.id = i;
    }
    string greet() {
        return "beep " + this.id.toString();
    }
}

void main() {
    // The implementing class answers its own members.
    Person p = new Person("ann");
    if (p.greet() != "hi ann") {
        printline("FAIL person greet");
        exit(1);
    }
    if (p.name != "ann") {
        printline("FAIL person field");
        exit(1);
    }
    Robot r = new Robot(7);
    if (r.greet() != "beep 7") {
        printline("FAIL robot greet");
        exit(1);
    }
    // A variable of the foundation type holds one implementing class and
    // dispatches the call on it.
    Greeter g = new Person("bob");
    if (g.greet() != "hi bob") {
        printline("FAIL foundation greet");
        exit(1);
    }
    printline("ok");
}
    // A foundation-typed variable assigned another instance of the SAME
    // implementing class keeps dispatching on it.
    Greeter g2 = r;
    if (g2.greet() != "beep 7") {
        printline("FAIL foundation reassign");
        exit(1);
    }
