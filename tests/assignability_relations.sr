// Assignability relations (type relations concept, restricted to Silver's
// shapes): composed types must agree in their components — nullable
// inner types and array element types recurse — and strings never
// interchange with numbers or bools. Legal alias widths and casts stay
// accepted.

void main() {
    // Array element agreement: same element type passes.
    int[] a = [1, 2, 3];
    int[] b = a;
    printline(b[0]);

    // Nullable inner agreement: same inner type passes.
    int? n = 5;
    int? m = n;
    printline(m ?? 0);

    // Numeric alias widths still interchangeable.
    int wide = 5;
    int32 alias_ok = wide;
    printline(alias_ok + 1);

    // Non-null into nullable still widens.
    int? widened = alias_ok;
    printline(widened ?? -1);

    // Unwrapping via ?? and null-checked reads stay safe.
    int? maybe = null;
    printline(maybe ?? 7);
    if (maybe != null) {
        printline(maybe);
    }
}
