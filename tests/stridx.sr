class StrIdx {
    private prop string src;
    construct (string source) {
        this.src = source;
    }
    char charAt(int i) {
        return this.src[i];
    }
    int len() {
        return this.src.length;
    }
}
void main() {
    StrIdx s = new StrIdx("ABC");
    printline("len=" + s.len());
    printline("char0=" + s.charAt(0));
    printline("char1=" + s.charAt(1));
}
