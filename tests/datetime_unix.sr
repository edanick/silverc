// Unix timestamp conversions (DOCS/173): toUnixTimestamp() on a datetime
// variable, fromUnixTimestamp()/fromUnix() on timestamp ints. Fixed vectors
// only (no wall clock): epoch, a 2024 date with time, int32 max, pre-1970
// negatives, and round-trips back through toUnixTimestamp(). Plain calls and
// var locals only (no dotted-new, which the interpreter cannot parse), so
// this runs identically on every implementation. Exit code 0 = exact.
import * from datetime;

void checkFrom(int64 ts, int y, int mo, int d, int h, int mi, int s) {
    var back = datetime.fromUnixTimestamp(ts);
    if (back.year != y || back.month != mo || back.day != d || back.hour != h || back.minute != mi || back.second != s || back.millisecond != 0) {
        printline("FAIL fromUnixTimestamp " + ts.toString());
        exit(1);
    }
    var same = datetime.fromUnix(ts);
    if (same.year != y || same.month != mo || same.day != d || same.hour != h || same.minute != mi || same.second != s) {
        printline("FAIL fromUnix " + ts.toString());
        exit(1);
    }
    if (back.toUnixTimestamp() != ts) {
        printline("FAIL roundtrip " + ts.toString());
        exit(1);
    }
}

void main() {
    checkFrom(0, 1970, 1, 1, 0, 0, 0);
    checkFrom(1704067200, 2024, 1, 1, 0, 0, 0);
    checkFrom(1718461800, 2024, 6, 15, 14, 30, 0);
    checkFrom(2147483647, 2038, 1, 19, 3, 14, 7);
    checkFrom(-1, 1969, 12, 31, 23, 59, 59);
    checkFrom(-86400, 1969, 12, 31, 0, 0, 0);
    checkFrom(-86401, 1969, 12, 30, 23, 59, 59);
    printline("unix-timestamp-ok");
}
