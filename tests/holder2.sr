class Entry {
    public prop string name;
    public prop int val;

    construct (string n, int v) {
        this.name = n;
        this.val = v;
    }
}

class Holder {
    public prop Entry[] items;

    construct () {
        this.items = [];
    }

    public void addItem(string n, int v) {
        Entry e;
        e = new Entry(n, v);
        this.items.add(e);
    }

    public void testDirect() {
        Entry e;
        e = this.items[0];
        print("direct name=");
        print(e.name);
        print(" val=");
        printline(e.val);
    }

    public void testChained() {
        print("chained name=");
        print(this.items[0].name);
        print(" val=");
        printline(this.items[0].val);
    }
}

void main() {
    Holder h;
    h = new Holder();
    h.addItem("hello", 42);
    h.testDirect();
    h.testChained();
}
