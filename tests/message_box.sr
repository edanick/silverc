// Message box surface (DOCS/258): compile-only (no main) so no dialog can
// ever block a runner. Typechecks the enums, all six show() overloads, and
// result comparison.
import * from msgbox;

void checkSurface() {
    dialogResult r1 = msgbox.show("t");
    dialogResult r2 = msgbox.show("t", "c");
    dialogResult r3 = msgbox.show("t", "c", msgboxButtons.OkCancel);
    dialogResult r4 = msgbox.show("t", "c", msgboxButtons.YesNo, msgboxIcon.Warning);
    dialogResult r5 = msgbox.show("t", "c", msgboxButtons.RetryCancel, msgboxIcon.Error, msgboxDefaultButton.Button3);
    dialogResult r6 = msgbox.show("t", "c", msgboxButtons.AbortRetryIgnore, msgboxIcon.Info, msgboxDefaultButton.Button1, msgboxOptions.RtlReading);
    if (r1 == dialogResult.None) { printline("none"); }
    if (r2 == dialogResult.None) { printline("none"); }
    if (r3 == dialogResult.None) { printline("none"); }
    if (r4 == dialogResult.None) { printline("none"); }
    if (r5 == dialogResult.None) { printline("none"); }
    if (r6 == dialogResult.None) { printline("none"); }
}
