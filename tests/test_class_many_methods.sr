mod export compiler;

import * from fs;

class Helper {
    public int doA(int x) { return x + 1; }
    public int doB(int x) { return x + 2; }
    public int doC(int x) { return x + 3; }
    public int doD(int x) { return x + 4; }
    public int doE(int x) { return x + 5; }
    public int doF(int x) { return x + 6; }
    public int doG(int x) { return x + 7; }
    public int doH(int x) { return x + 8; }
    public int doI(int x) { return x + 9; }
    public int doJ(int x) { return x + 10; }
}

void main() {
    Helper h;
    h = new Helper();
    int v = h.doA(h.doB(h.doC(h.doD(h.doE(0)))));
    printline(v);
    v = h.doF(h.doG(h.doH(h.doI(h.doJ(0)))));
    printline(v);
    string s = file.readString("test_class_many_methods.sr");
    printline(s.length);
    printline("done");
}
