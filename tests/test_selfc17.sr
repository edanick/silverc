class Token {
    string kind;
    int line;
}

class Lexer {
    string src;
    int pos;

    Token[] tokenize() {
        Token[] tokens = new Token[0];
        return tokens;
    }
}

void main() {
    Lexer lex = new Lexer();
    Token[] t = lex.tokenize();
    printline("tokens: " + t.length);
}
