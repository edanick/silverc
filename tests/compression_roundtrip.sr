// Compression modules (DOCS/260): free-function compress/decompress with no
// `new` and no var, via the facade star import. A fixed deflate vector plus
// round trips for all three. Runs on the compilers (executes the codecs end to
// end).
import * from compression;

bool eqByte(byte[] a, byte[] e) {
    if (a.length != e.length) { return false; }
    for (int i = 0; i < a.length; i++) { if (a[i] != e[i]) { return false; } }
    return true;
}

void main() {
    byte[] abc = [97, 98, 99];
    if (!eqByte(deflateDecompress([75, 76, 74, 6, 0]), abc)) { printline("FAIL deflate vec"); exit(1); }
    byte[] rep = [];
    for (int i = 0; i < 100; i++) { rep.add((i * 7 + 3) & 255); }
    if (!eqByte(deflateDecompress(deflateCompress(rep)), rep)) { printline("FAIL deflate rt"); exit(1); }
    if (!eqByte(deflateDecompress(deflateCompress(rep, 0)), rep)) { printline("FAIL deflate stored"); exit(1); }
    if (!eqByte(gzipDecompress(gzipCompress(rep)), rep)) { printline("FAIL gzip rt"); exit(1); }
    if (!eqByte(zstdDecompress(zstdCompress(rep)), rep)) { printline("FAIL zstd rt"); exit(1); }
    printline("compression-ok");
}
