// Compression modules (DOCS/260): after `import { gzip, zstd, deflate } from
// compression;` call `gzip.compress(bytes)` / `gzip.decompress(bytes)` etc --
// no `new`, no var (static class facades). A fixed deflate vector plus round
// trips for all three. Runs on the compilers (they execute the codecs).
import { gzip, zstd, deflate } from compression;

bool eqByte(byte[] a, byte[] e) {
    if (a.length != e.length) { return false; }
    for (int i = 0; i < a.length; i++) { if (a[i] != e[i]) { return false; } }
    return true;
}

void main() {
    byte[] abc = [97, 98, 99];
    if (!eqByte(deflate.decompress([75, 76, 74, 6, 0]), abc)) { printline("FAIL deflate vec"); exit(1); }
    byte[] rep = [];
    for (int i = 0; i < 100; i++) { rep.add((i * 7 + 3) & 255); }
    if (!eqByte(deflate.decompress(deflate.compress(rep)), rep)) { printline("FAIL deflate rt"); exit(1); }
    if (!eqByte(gzip.decompress(gzip.compress(rep)), rep)) { printline("FAIL gzip rt"); exit(1); }
    if (!eqByte(zstd.decompress(zstd.compress(rep)), rep)) { printline("FAIL zstd rt"); exit(1); }
    printline("compression-ok");
}
