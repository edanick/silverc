// Compression modules (DOCS/260): gzip + deflate + zstd-store round trips and
// a fixed deflate vector. In-memory only (byte[]/int[] cells), the binding
// import form. Runs on the compilers (executes the codecs end to end).
import deflate from compression.deflate;
import gzip from compression.gzip;
import zstd from compression.zstd;

bool eqByte(byte[] a, byte[] e) {
    if (a.length != e.length) { return false; }
    for (int i = 0; i < a.length; i++) { if (a[i] != e[i]) { return false; } }
    return true;
}

void main() {
    var d = new deflate();
    byte[] abc = [97, 98, 99];
    if (!eqByte(d.decompress([75, 76, 74, 6, 0]), abc)) { printline("FAIL deflate vec"); exit(1); }
    byte[] rep = [];
    for (int i = 0; i < 100; i++) { rep.add((i * 7 + 3) & 255); }
    if (!eqByte(d.decompress(d.compress(rep)), rep)) { printline("FAIL deflate rt"); exit(1); }
    var g = new gzip();
    if (!eqByte(g.decompress(g.compress(rep)), rep)) { printline("FAIL gzip rt"); exit(1); }
    var z = new zstd();
    if (!eqByte(z.decompress(z.compress(rep)), rep)) { printline("FAIL zstd rt"); exit(1); }
    printline("compression-ok");
}
