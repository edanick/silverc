class Bar {
    string name;
    
    void setName(string s) {
        this.name = s;
    }
    
    string getName() {
        return this.name;
    }
}

void main() {
    printline("START");
    Bar b;
    b = new Bar();
    b.setName("world");
    printline(b.getName());
    printline(b.getName().length);
    string s = "hello " + b.getName();
    printline(s);
    printline(s.length);
    printline("END");
}
