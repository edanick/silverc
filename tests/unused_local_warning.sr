// Assigned-but-never-used locals (unused-local analog): every
// local here IS used (read, compound-assigned, aliased, addressed,
// passed, returned, or captured), so the warning must stay silent.
// Exit code 0 = exact.

int add(int a, int b) {
    return a + b;
}

void main() {
    // Read after assignment.
    int used_read = 5;
    printline(used_read);

    // Compound assignment counts as a use (it reads the target).
    int used_compound = 10;
    used_compound += 5;
    printline(used_compound);

    // Increment reads its operand.
    int used_inc = 0;
    used_inc++;
    printline(used_inc);

    // Passed as an argument: the callee reads it.
    int used_arg = 3;
    printline(add(used_arg, 4));

    // The value flows through an array literal.
    int used_in_array = 2;
    int[] carrier = [used_in_array, 8];
    printline(carrier[0]);

    // String interpolation reads its holes.
    int used_interp = 11;
    printline($"v={used_interp}");

    // Ternary branches read both sides' variables.
    int used_tern = 1;
    int t = used_read > 0 ? used_tern : used_compound;
    printline(t);

    // Returned from a nested block: a use inside any scope counts.
    int used_nested = 20;
    if (used_read > 0) {
        used_nested = used_nested + 1;
    }
    printline(used_nested);

    // Unset still counts the earlier value as used here (defensive
    // programs free explicitly); reading before unset is a use.
    int used_unset = 4;
    printline(used_unset);
    unset used_unset;

    // Shadow-safe: the inner assignment's target is read inside its
    // block; the outer read keeps the outer name used too.
    int shadow = 1;
    {
        int shadow = 2;
        printline(shadow);
    }
    printline(shadow);

    printline("unused local exemptions ok");
}
