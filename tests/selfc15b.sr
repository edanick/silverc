class Lexer {
    int pos;
    Token[] tokens;

    void initialize() {
        this.pos = 0;
        this.tokens = new Token[0];
    }
}

class Token {
    string kind;
    int line;
}

void main() {
    Lexer lex = new Lexer();
    lex.initialize();
    printline("tokens: " + lex.tokens.length);
}
