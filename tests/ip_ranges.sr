// IP (DOCS/201): parse, toInt, toString, cidr, rangeOf, isPrivate,
// isPublic, isLoopback, normalize, range.contains. Exit code 0 = all pass.
import * from ip;

void expect(bool got, string what) {
    if (!got) {
        printline("ip check failed: " + what);
        exit(1);
    }
}

void main() {
    ip.address addr = ip.parse("192.168.1.1");
    expect(addr.version == 4, "parse version");
    expect(addr.toInt() == 3232235777, "toInt canonical");
    expect(addr.toString() == "192.168.1.1", "toString roundtrip");
    expect(addr.isPrivate, "parsed private flag");
    expect(!addr.isLoopback, "parsed loopback clear");

    expect(ip.parse("10.0.0.1").toInt() == 167772161, "toInt ten");
    expect(ip.parse("127.0.0.1").isLoopback, "parsed loopback flag");
    expect(ip.parse("8.8.8.8").isPrivate == false, "parsed public flag");

    expect(ip.isPrivate("10.1.2.3"), "isPrivate ten");
    expect(ip.isPrivate("172.16.0.1"), "isPrivate 172.16");
    expect(ip.isPrivate("192.168.0.1"), "isPrivate 192");
    expect(!ip.isPrivate("8.8.8.8"), "isPrivate public false");
    expect(ip.isLoopback("127.0.0.1"), "isLoopback true");
    expect(!ip.isLoopback("8.8.8.8"), "isLoopback false");
    expect(ip.isPublic("8.8.8.8"), "isPublic true");
    expect(!ip.isPublic("10.0.0.1"), "isPublic private false");
    expect(!ip.isPublic("127.0.0.1"), "isPublic loopback false");
    expect(ip.normalize("8.8.8.8") == "8.8.8.8", "normalize identity");

    ip.range cidr = ip.cidr("192.168.1.0/24");
    expect(cidr.network == "192.168.1.0", "cidr network");
    expect(cidr.prefix == 24, "cidr prefix");
    expect(cidr.size == 256, "cidr size");
    expect(ip.cidr("10.0.0.0/8").prefix == 8, "cidr prefix eight");

    ip.range span = ip.rangeOf("10.0.0.1", "10.0.0.10");
    expect(span.first == "10.0.0.1", "rangeOf first");
    expect(span.last == "10.0.0.10", "rangeOf last");
    expect(span.contains(ip.parse("10.0.0.5")), "range contains");

    printline("ip-ranges-ok");
}
