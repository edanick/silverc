// A store past the end of an array must be refused at runtime: the write
// must never land outside the allocation. The same refusal covers a
// negative index (a write before the start of the block), a compound
// store, and a global array (an array whose base is not a local).

int[] global = [1, 2, 3];

bool refusedLocal(int[] a, int index) {
    try {
        a[index] = 42;
    } catch (Exception e) {
        return true;
    }
    return false;
}

void main() {
    int[] a = [1, 2, 3];

    if (!refusedLocal(a, 5)) {
        printline("FAIL: a store past the end of an array was not refused");
        throw "a store past the end of an array was not refused";
    }
    if (!refusedLocal(a, -1)) {
        printline("FAIL: a store before the start of an array was not refused");
        throw "a store before the start of an array was not refused";
    }

    bool refusedGlobal = false;
    try {
        global[5] = 42;
    } catch (Exception e) {
        refusedGlobal = true;
    }
    if (!refusedGlobal) {
        printline("FAIL: a store past the end of a global array was not refused");
        throw "a store past the end of a global array was not refused";
    }

    bool refusedCompound = false;
    try {
        a[5] += 42;
    } catch (Exception e) {
        refusedCompound = true;
    }
    if (!refusedCompound) {
        printline("FAIL: a compound store past the end of an array was not refused");
        throw "a compound store past the end of an array was not refused";
    }

    // The array is untouched by every refused store.
    if (a.length != 3) {
        printline("FAIL: the array grew past its end");
        throw "the array grew past its end";
    }
    if (a[0] != 1 || a[1] != 2 || a[2] != 3) {
        printline("FAIL: an element of the array was changed by a refused store");
        throw "an element of the array was changed by a refused store";
    }

    printline("ok");
}
