class Foo {
    int val;
    
    void setVal(int x) {
        this.val = x;
    }
    
    int getVal() {
        return this.val;
    }
}

class Bar {
    string name;
    
    void setName(string s) {
        this.name = s;
    }
    
    string getName() {
        return this.name;
    }
    
    int getNameLen() {
        return this.name.length;
    }
}

void main() {
    printline("START");
    Foo f;
    f = new Foo();
    f.setVal(42);
    printline(f.getVal());
    
    Bar b;
    b = new Bar();
    b.setName("world");
    printline(b.getName());
    printline(b.getNameLen());
    
    int[] arr = [10, 20, 30, 40, 50];
    printline(arr[0]);
    printline(arr[4]);
    
    string s = "hello " + b.getName();
    printline(s);
    printline(s.length);
    
    printline("DONE");
}
