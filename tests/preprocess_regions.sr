// Preprocessor regions (DOCS/253, DOCS/260): #on DEBUG/RELEASE and chained
// #on LINUX/WINDOWS/MAC regions with #else and OR-lists. This file compiles
// in the default RELEASE mode on the host OS, so the RELEASE and host-OS
// branches feed and the others blank. Exit code 0 = all checks pass.
void expect(bool got, string what) {
    if (!got) {
        printline("preprocess check failed: " + what);
        exit(1);
    }
}

void main() {
    int mode = 0;
    #on DEBUG
    mode = 1;
    #on RELEASE
    mode = 2;
    #off
    expect(mode == 2, "RELEASE branch feeds by default");

    int host = 0;
    #on WINDOWS
    host = 1;
    #on LINUX
    host = 2;
    #on MAC
    host = 3;
    #off
    expect(host >= 1 && host <= 3, "host OS branch feeds");

    int picked = 0;
    #on LINUX or MAC
    picked = 1;
    #on WINDOWS
    picked = 2;
    #else
    picked = 3;
    #off
    expect(picked >= 1 && picked <= 3, "or-list and else chain feeds");

    int rejected = 0;
    #on DEBUG
    rejected = 99;
    #off
    expect(rejected == 0, "non-matching region blanks code");

    printline("preprocess-regions-ok");
}
