// Cache streaming-decode fixture (MEMORY.md §3.2 row 14, bcache audit).
// Exercises the --cache-bytecode encode/decode paths fixed in bcache.sr:
// tokenFromRange's string-payload and interpolation-segment hex decodes
// (were per-byte lstrcatA scans, O(n^2) per payload, spaces on non-Windows),
// bcPutHex's hex encode (was per-byte hex += h), ensureDirTree's path build
// (was per-char cur += c), and the hex-length bound checks (blen * 2 and
// glen * 2 overflows on corrupt cache files). The file carries all three
// payload shapes: a long string literal, a float literal (forces the text
// .srbc.t decode fallback because loadSrbcBin bails on tag 201), and an
// interpolation string with text + hole segments (tag 207).
void main() {
    string longLit = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789";
    float f = 1.5;
    string name = "world";
    string msg = $"hello {name} len={longLit.length}";
    if (longLit.length != 60) { printline("FAIL longLit"); exit(1); }
    if (msg != "hello world len=60") { printline("FAIL interp"); exit(1); }
    if (f != 1.5) { printline("FAIL float"); exit(1); }
    printline("cache-streaming-decode-ok");
}
