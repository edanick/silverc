// A nested read through a toml parse result renders the VALUE, never the
// raw pointer: the parse result holds heap text scalars under runtime
// keys (dyn roots, like json/yaml parse results), so the member chain
// (`config.server.port`) formats with %s on every implementation. The
// nested section dict is fully built before it is stored under its
// section name (storing an empty dict first and filling it later would
// snapshot the empty dict under copy-on-assign semantics).

import toml;

void main() {
    object config = toml.parse("title = 'My App'\n\n[server]\nport = 8080\nhost = 'localhost'\n\n[database]\nname = 'mydb'\npool = 10\n");

    printline(config.title);
    printline(config.server.port);
    printline(config.server.host);
    printline(config.database.name);
    printline(config.database.pool);

    if (config.title != "My App") { exit(1); }
    if (config.server.port != "8080") { exit(2); }
    if (config.server.host != "localhost") { exit(3); }
    if (config.database.name != "mydb") { exit(4); }
    if (config.database.pool != "10") { exit(5); }

    // Dotted section names build a dict two levels deep.
    object dotted = toml.parse("[a.b]\nvalue = 'deep'\n");
    if (dotted.a.b.value != "deep") { exit(6); }

    printline("toml nested parse: ok");
}
