// Legal shadowing shapes the guard must not flag: a name may be reused
// across scopes — sibling branch arms, separate loop bodies, and lambda
// parameters — while the same scope never declares it twice.

int twice(int n) {
    int x = n * 2;
    return x;
}

void main() {
    int total = 0;
    for (int i = 0; i < 3; i++) {
        int step = i + 1;
        total += step;
    }
    foreach (int step in [10, 20]) {
        total += step;
    }
    if (total > 10) {
        int marker = 1;
        printline(marker);
    } else {
        int marker = 2;
        printline(marker);
    }
    while (total < 100) {
        int bump = 5;
        total += bump;
    }
    int rounded = twice(total);
    printline(rounded);
    int kind = 2;
    match (kind) {
        1 => printline(10);
        2 => printline(20);
        _ => printline(30);
    }
    int[] xs = [4, 5];
    xs.map(v => v * 2);
    printline("done");
}
