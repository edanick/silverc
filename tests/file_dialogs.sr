// File dialogs surface (DOCS/259): compile-only (no main) so no dialog can
// ever block a runner. Typechecks every dialogs class, setter, result
// getter and the reused dialogResult enum without calling showDialog.
import * from dialogs;

void checkDialogSurface() {
    OpenFileDialog openDlg = new OpenFileDialog();
    openDlg.setFilter("Text files (*.txt)|*.txt|All files (*.*)|*.*");
    openDlg.setFilterIndex(2);
    openDlg.setInitialDirectory("C:\\Temp");
    openDlg.setTitle("Open a document");
    openDlg.setDefaultExt("txt");
    openDlg.setCheckFileExists(true);
    openDlg.setMultiselect(true);
    string openFirst = openDlg.fileName();
    string[] openAll = openDlg.fileNames();

    SaveFileDialog saveDlg = new SaveFileDialog();
    saveDlg.setFilter("Text files (*.txt)|*.txt");
    saveDlg.setFilterIndex(1);
    saveDlg.setInitialDirectory("C:\\Temp");
    saveDlg.setTitle("Save a document");
    saveDlg.setDefaultExt("txt");
    saveDlg.setOverwritePrompt(true);
    string savePath = saveDlg.fileName();

    OpenFolderDialog folderDlg = new OpenFolderDialog();
    folderDlg.setTitle("Pick a folder");
    string pickedFolder = folderDlg.folderPath();

    dialogResult none = dialogResult.None;
    dialogResult ok = dialogResult.Ok;
    dialogResult cancel = dialogResult.Cancel;
    if (none == ok) { printline(openFirst); }
    if (cancel == ok) { printline(savePath); }
    if (openAll.length == 0) { printline(pickedFolder); }
}
