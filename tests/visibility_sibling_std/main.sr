// Positive case: only public members of the sibling-std module (helper,
// resolved via <sib>/std/helper.sr) and the normal-sibling module (mod_a)
// are used, so the compile must succeed and print vis-sibling-ok.
// main_internal.sr in this directory is the negative case (uses secretH
// from the sibling-std module and must be rejected).
import helper;
import mod_a;

void main() {
    int h = helper.openH();
    int a = mod_a.openA();
    if (h != 11 || a != 3) {
        exit(1);
    }
    printline("vis-sibling-ok");
}
