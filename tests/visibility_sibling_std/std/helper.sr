// helper: external module under sibling-std for the visibility_sibling_std
// fixture. Resolved via <sib>/std/<name>.sr (driver findModuleFile and
// visibility visFindModuleFile both probe it since the ladder unification).
// Its internal declarations must be rejected by the VisibilityChecker when
// used from the entry file, and its public declarations must stay usable.
// The entry's driver-collected text and the checker's probe text must be
// byte-identical (shared-text handoff).
mod export helper;

internal int secretH() {
    return 7;
}

int openH() {
    return 11;
}
