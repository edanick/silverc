// Lexer slice fixture (MEMORY.md §3.2 row 6, lexer audit): the per-char
// += builders in readNumber / readIdent / readInterpStringToken
// (hole) / ipCopyQuoted are now single source slices, so long
// identifiers, long numeric spellings, and interpolation holes with
// nested quoted literals build in linear garbage instead of
// quadratic. This program must compile and print exactly
// `lexer-slice-ok 7`.

void main() {
    int _a_very_long_identifier_name_0123456789 = 3;
    int a_very_long_number_spelling_00000000000000000004 = 4;
    string nested = "inner";
    string text = $"hole={nested} end";
    string plain = $"{nested}";
    int total = _a_very_long_identifier_name_0123456789 + a_very_long_number_spelling_00000000000000000004;
    printline("lexer-slice-ok " + (string)total);
    printline(text);
    printline(plain);
}
