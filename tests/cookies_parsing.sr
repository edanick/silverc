// Cookies (DOCS/198): parse, cookie setters, serialize, parseSetCookie,
// parseSetCookies. Exit code 0 = all checks pass.
import * from cookies;

void expect(bool got, string what) {
    if (!got) {
        printline("cookies check failed: " + what);
        exit(1);
    }
}

void main() {
    cookies.multimap jar = cookies.parse("session=abc123; theme=dark");
    expect(jar.get("session") == "abc123", "parse session");
    expect(jar.get("theme") == "dark", "parse theme");
    expect(jar.get("missing") == "", "parse missing is empty");
    jar.set("theme", "light");
    expect(jar.get("theme") == "light", "multimap set overwrites");

    cookies.cookie cookie = new cookies.cookie("token", "xyz");
    expect(cookie.path == "/", "cookie default path");
    cookie.setPath("/app");
    cookie.setDomain("example.com");
    cookie.setHttpOnly(true);
    cookie.setSecure(true);
    cookie.setSameSite("Strict");
    cookie.setMaxAge(3600);
    string serialized = cookie.serialize();
    expect(serialized.indexOf("token=xyz") == 0, "serialize name value");
    expect(serialized.indexOf("Path=/app") >= 0, "serialize path");
    expect(serialized.indexOf("Domain=example.com") >= 0, "serialize domain");
    expect(serialized.indexOf("HttpOnly") >= 0, "serialize httponly");
    expect(serialized.indexOf("Secure") >= 0, "serialize secure");
    expect(serialized.indexOf("SameSite=Strict") >= 0, "serialize samesite");
    expect(serialized.indexOf("Max-Age=3600") >= 0, "serialize max age");

    cookies.cookie parsed = cookies.parseSetCookie("id=42; Path=/shop; HttpOnly; Max-Age=60");
    expect(parsed.name == "id", "set-cookie name");
    expect(parsed.value == "42", "set-cookie value");
    expect(parsed.path == "/shop", "set-cookie path");
    expect(parsed.httpOnly, "set-cookie httponly");
    expect(parsed.maxAge == 60, "set-cookie max age");

    cookies.cookie[] many = cookies.parseSetCookies(["a=1; Path=/", "b=2; Secure"]);
    expect(many.length == 2, "parseSetCookies length");
    expect(many[0].value == "1", "parseSetCookies first");
    expect(many[1].secure, "parseSetCookies secure");

    printline("cookies-parsing-ok");
}
