mod export compiler;
import * from fs;

class Box {
    public prop int[] items;
    public prop int val;

    construct() {
        this.val = 42;
        this.items = [];
        this.items.add(10);
        this.items.add(20);
    }

    public void addItem(int v) {
        this.items.add(v);
    }

    public void show() {
        printline(this.val);
        printline(this.items.length);
        for (int i = 0; i < this.items.length; i++) {
            printline(this.items[i]);
        }
    }
}

void main() {
    Box b = new Box();
    b.addItem(30);
    b.show();
}
