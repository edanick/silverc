// Operand-kind relations: `+` concatenates strings, `+=` concatenates onto
// a string and pushes onto an array, numeric compound stores compute, and
// dict lookups take any key shape (an array/string index is int-addressed).
// Exit code 0 = exact.
void check(bool ok, string label) {
    if (!ok) {
        printline("FAIL " + label);
        exit(1);
    }
}

void main() {
    string a = "x";
    string b = a + "y";
    check(b == "xy", "string-concat");
    b += "z";
    check(b == "xyz", "string-append");

    int[] xs = [1];
    xs += 2;
    check(xs.length == 2 && xs[1] == 2, "array-push");

    int n = 6;
    n *= 3;
    n -= 4;
    n /= 2;
    n %= 5;
    check(n == 2, "numeric-compound");

    var ages = {"amy": 30, "bo": 12};
    check(ages["amy"] == 30, "dict-string-key");
    check(ages["bo"] == 12, "dict-second-key");

    string s = "hello";
    check(s[1] == 'e', "string-int-index");

    printline("operand kinds ok");
}
