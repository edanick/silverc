import * from fs;

class Token {
    string kind;
    int line;
}

class Lexer {
    string src;
    int pos;
    Token[] tokens;

    void setup(string source) {
        this.src = source;
        this.pos = 0;
        this.tokens = new Token[0];
    }

    void doTokenize() {
        while(this.pos < this.src.length) {
            Token t = new Token();
            t.kind = "char";
            t.line = 1;
            this.tokens.add(t);
            this.pos = this.pos + 1;
        }
    }
}

void main() {
    string source = file.readString("C:\\Users\\haya_\\OneDrive\\Desktop\\Code\\rust\\silver\\silverc\\tests\\simple.sr");
    printline("read " + source.length + " bytes");
    Lexer lex = new Lexer();
    lex.setup(source);
    lex.doTokenize();
    printline("tokens: " + lex.tokens.length);
}
