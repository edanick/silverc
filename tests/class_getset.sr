mod export compiler;
import * from fs;

class Box {
    public prop int val;
    construct() { this.val = 0; }
    public int getVal() { return this.val; }
    public void setVal(int v) { this.val = v; }
    public int add(int x, int y) { return x + y; }
}

void testFn(Box b, int n) {
    b.setVal(n);
    printline(b.getVal());
    printline(b.add(b.getVal(), 10));
}

void main() {
    Box b = new Box();
    b.setVal(42);
    printline(b.getVal());
    testFn(b, 99);
}
