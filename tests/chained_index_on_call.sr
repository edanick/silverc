// An index chained directly on a string[]-returning method call must
// classify as text in printline/concat/interp position: `d.keys()[0]` and
// `s.split(",")[1]` used to format the element pointer as a decimal
// integer because only module-qualified calls consulted the element-type
// registration, never a plain method-call receiver.
void main() {
    dict<string, int> d = {"x": 1};

    string k = d.keys()[0];
    if (k != "x") {
        printline($"keys element wrong: {k}");
        exit(1);
    }
    if (d.keys()[0] != "x") {
        printline("chained keys index compare wrong");
        exit(1);
    }

    string s = "a,b";
    if (s.split(",")[1] != "b") {
        printline("chained split index compare wrong");
        exit(1);
    }

    string joined = "a=" + d.keys()[0];
    if (joined != "a=x") {
        printline($"concat wrong: {joined}");
        exit(1);
    }
    if (("first " + s.split(",")[0]) != "first a") {
        printline("concat split element wrong");
        exit(1);
    }

    string hole = $"hole={(d.keys()[0])}";
    if (hole != "hole=x") {
        printline($"interp hole wrong: {hole}");
        exit(1);
    }

    // The whole-dict value kind must still govern values(): a string-valued
    // dict's element is text, an int-valued dict's element stays decimal.
    dict<string, string> m = {"k": "v"};
    if (m.values()[0] != "v") {
        printline("chained values index compare wrong");
        exit(1);
    }
    if (("v=" + m.values()[0]) != "v=v") {
        printline("concat values element wrong");
        exit(1);
    }
    if (d.values()[0] != 1) {
        printline("int values element wrong");
        exit(1);
    }

    printline("ok");
}
