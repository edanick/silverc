// Copy-on-assign for strings (SPEC 9.2 / D11): the destination owns its
// own text. Strings are immutable, so += (which mints a fresh string)
// leaves the source alone in both models; this fixture pins that both
// bindings stay valid and hold their own value after the assignment.
void main() {
    string a = "hello";
    string b = a;
    b += " world";
    if (a != "hello") {
        printline("string decl copy corrupted source");
        throw "copy check failed";
    }
    if (b != "hello world") {
        printline("string decl copy wrong");
        throw "copy check failed";
    }

    string x = "one";
    string y = "two";
    y = x;
    y += "!";
    if (x != "one" || y != "one!") {
        printline("string assign copy shared");
        throw "copy check failed";
    }

    printline("assigned string is a copy ok");
}
