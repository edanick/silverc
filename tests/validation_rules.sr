// Validation (DOCS/196): email, url, ip, phone, creditCard predicates,
// the rules builder chain, and validate. Exit code 0 = all checks pass.
import * from validation;

void expect(bool got, string what) {
    if (!got) {
        printline("validation check failed: " + what);
        exit(1);
    }
}

void main() {
    expect(validation.email("alice@example.com"), "email valid");
    expect(!validation.email("aliceexample.com"), "email missing at");
    expect(!validation.email("alice@example"), "email missing dot");
    expect(!validation.email("@example.com"), "email empty local");

    expect(validation.url("https://example.com/path"), "url valid");
    expect(validation.url("ftp://host"), "url ftp");
    expect(!validation.url("example.com"), "url missing scheme");

    expect(validation.ip("192.168.1.1"), "ip valid");
    expect(!validation.ip("192.168.1"), "ip short");
    expect(!validation.ip("999.168.1.1"), "ip octet too big");

    expect(validation.phone("5551234567"), "phone valid");
    expect(!validation.phone("123"), "phone short");

    expect(validation.creditCard("4111111111111111"), "card valid");
    expect(!validation.creditCard("123"), "card short");

    validation.rules ruleChain = new validation.rules();
    ruleChain.required().string().min(3).max(20).alpha();
    expect(ruleChain != null, "rules chain returns");

    validation.result check = validation.validate({}, ruleChain);
    expect(check.passed, "validate passes");

    expect(validation.required() != null, "required factory");
    expect(validation.optional() != null, "optional factory");

    printline("validation-rules-ok");
}
