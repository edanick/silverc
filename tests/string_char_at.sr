// DOCS/104 -- `charAt(i)` returns the char at the index of a string;
// an index at or past the length (or a negative one) returns a space
// instead of reading past the end. The index form (`s[i]`, the one
// the compilers lower natively) reads the same char inside the string;
// outside it the index form is refused with the catchable "index out of
// range" error (see string_element_bounds.sr).
void main() {
    string s = "hello";
    if (s.charAt(1) != 'e') { printline("FAIL charAt 1: got '" + (string)s.charAt(1) + "'"); exit(1); }
    if (s.charAt(0) != 'h') { printline("FAIL charAt 0: got '" + (string)s.charAt(0) + "'"); exit(2); }
    if (s.charAt(4) != 'o') { printline("FAIL charAt 4: got '" + (string)s.charAt(4) + "'"); exit(3); }
    if (s[1] != 'e' || s[4] != 'o') { printline("FAIL string index: expected e and o"); exit(4); }
    if (s.charAt(5) != ' ') { printline("FAIL charAt 5: expected the space fallback"); exit(5); }
    if (s.charAt(-1) != ' ') { printline("FAIL charAt -1: expected the space fallback"); exit(6); }
    char c = s.charAt(2);
    if (c != 'l') { printline("FAIL charAt 2 as a char: got '" + (string)c + "'"); exit(7); }
    printline("string char at ok");
}
