void main() {
    printline("start");
    Token t = Token();
    t.kind = 1;
    t.text = "hello";
    Lexer lex = Lexer();
    lex.source = "test source code";
    lex.pos = 0;
    printline("done");
}
class Token {
  int kind
  string text
  int line
  int col
  int intVal
  float floatVal
  string strVal
  char charVal
}
class Lexer {
  string source
  int pos
  int line
  int col
  Token[] tokens
}
