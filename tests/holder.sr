class Entry {
    public prop string name;
    public prop int val;

    construct (string n, int v) {
        this.name = n;
        this.val = v;
    }
}

class Holder {
    public prop Entry[] items;

    construct () {
        this.items = [];
    }

    public void addItem(string n, int v) {
        Entry e;
        e = new Entry(n, v);
        this.items.add(e);
    }

    public void dump() {
        for (int i = 0; i < this.items.length; i++) {
            print("items[");
            print(i);
            print("].name=");
            print(this.items[i].name);
            print(" val=");
            printline(this.items[i].val);
        }
    }
}

void main() {
    Holder h;
    h = new Holder();
    h.addItem("hello", 42);
    h.dump();
}
