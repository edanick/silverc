// Object-cache index fixture (objcache audit): exercises the --cache-object
// cold/hit/link paths whose definition lookups and string builders were
// changed here. Cross-file shape: main calls helper and helper2 (defined
// symbols resolved through the linker's definition index), the long symbol
// names force the COFF long-name string table in the Windows emitter, the
// interpolation and data-anchor paths carry data relocations, and the long
// path-derived data anchor exercises the run-slice sanitizer. Import calls
// (print/printline/exit) carry import relocations through the import-index
// parse (now length-capped).
string helperResult(string name) {
    return $"objcache {name} index-ok";
}

int helper2(int a, int b) {
    return a * b + 1;
}

void main() {
    string msg = helperResult("world");
    if (msg != "objcache world index-ok") { printline("FAIL interp"); exit(1); }
    if (helper2(6, 7) != 43) { printline("FAIL arith"); exit(1); }
    if (msg.length != 23) { printline("FAIL length"); exit(1); }
    printline("objcache-index-ok");
}
