// An index addresses an ELEMENT of a container.
//
// The receiver's scalar type must be proven through every shape the
// checker can see, not only through a plain typed binding. A member
// field, a call result, a class-method result, and the inferred
// initializer of an untyped `var` all name a scalar here: each index
// was lowered as an offset from a number, so the program read through
// a wild address (a segfault at runtime) instead of being refused at
// compile time. Indexing any of them is refused with the same
// diagnostic a typed binding gets.
class Box {
    prop int n;
    construct { this.n = 5; }
    int getN() { return this.n; }
}

int five() { return 5; }

void main() {
    Box b = new Box();
    int a = b.n[0];
    int c = five()[0];
    int d = b.getN()[0];
    var v = 5;
    int e = v[0];
    printline("unreachable");
}
// expect-diagnostic: expected 'an indexable value'
