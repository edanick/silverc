// Overload arity: the name has three declarations (1, 2, 3 parameters);
// the four-argument call matches none of them.
// Expect: no overload of 'pick' takes 4 argument(s)

int pick(int a) { return a; }
int pick(int a, int b) { return a + b; }
int pick(int a, int b, int c) { return a + b + c; }

void main() {
    printline(pick(1, 2, 3, 4));
}
