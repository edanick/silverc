// Export-table set cache fixture (C5 / MEMORY.md row 12, parser half):
// every fixed DLL/lib export table is parsed into a word set ONCE per
// Parser and membership is a slice-free `.contains` test, instead of
// re-slicing the whole table per call node. This program must compile
// with NO unknown-method diagnostics (every free call below resolves:
// user functions via the sig-name set, natives via the per-OS opened
// tables) and print exactly `export-table-cache-ok 42`.

#on WINDOWS
import * from win32.kernel32;
import * from win32.ws2_32;
#on LINUX
import * from linux.libc;
import * from linux.x11;
#on MAC
import * from mac.libsystem;
import * from mac.objc;
#off

int add(int a, int b) {
    return a + b;
}

string greet(string who) {
    return "hi " + who;
}

int answer() {
    return 42;
}

void nativeProbe() {
#on WINDOWS
    Sleep(0);
    GetTickCount();
    GetLastError();
#on LINUX
    getpid();
    getuid();
#on MAC
    getpid();
    getuid();
#off
}

void main() {
    int total = 0;
    for (int i = 0; i < 20; i++) {
        total += add(1, 1);
    }
    string g = greet("parser");
    int n = answer();
    int parsed = int.parseInt("2");
    nativeProbe();
    printline("export-table-cache-ok " + (string)(total + parsed));
    printline(g + " " + (string)n);
}
