// String helpers (DOCS/255, DOCS/269, DOCS/205): equals with StringCase,
// pad/padLeft/padRight, slugify, dissimilarity. Exit code 0 = all checks pass.
import * from string;

void expect(bool got, string what) {
    if (!got) {
        printline("string check failed: " + what);
        exit(1);
    }
}

void main() {
    expect(string.equals("Hello", "hello", StringCase.INSENSITIVE), "equals insensitive");
    expect(string.equals("hello", "hello", StringCase.SENSITIVE), "equals sensitive same");
    expect(!string.equals("Hello", "hello", StringCase.SENSITIVE), "equals sensitive differs");
    expect(string.equals("abc", "abc", StringCase.SENSITIVE), "equals identical");
    expect(!string.equals("abc", "abd", StringCase.INSENSITIVE), "equals different text");

    expect(string.pad("hi", 2, "*") == "**hi**", "pad both sides");
    expect(string.padLeft("hi", 2, "*") == "**hi", "pad left");
    expect(string.padRight("hi", 2, "*") == "hi**", "pad right");
    expect(string.pad("hi", 0, "*") == "hi", "pad zero is identity");

    expect(string.slugify("Hello World") == "hello-world", "slugify basic");
    expect(string.slugify("Silver_Programming Language!") == "silver-programming-language", "slugify symbols");
    expect(string.slugify("  spaces  ") == "spaces", "slugify trims edges");

    expect(string.dissimilarity("abc", "abc") == 0, "dissimilarity identical");
    expect(string.dissimilarity("kitten", "sitting") == 3, "dissimilarity kitten");
    expect(string.dissimilarity("hello", "hallo") == 1, "dissimilarity substitution");
    expect(string.dissimilarity("", "abc") == 3, "dissimilarity empty left");
    expect(string.dissimilarity("abc", "") == 3, "dissimilarity empty right");
    expect(string.dissimilarity("flaw", "lawn") == 2, "dissimilarity flaw");

    printline("string-helpers-ok");
}
