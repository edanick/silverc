void check(string name, bool got, bool want) {
    if (got != want) { printline("FAIL " + name); exit(1); }
    printline("ok " + name);
}

void main() {
    // String relational truth table: ordinal (strcmp) byte order. A
    // prefix is less than any longer string starting with it, and case
    // compares by byte value, so "Z" < "a".
    check("apple < banana", "apple" < "banana", true);
    check("b < a", "b" < "a", false);
    check("a <= b", "a" <= "b", true);
    check("cat > bear", "cat" > "bear", true);
    check("generate doc example", "apple" < "banana", true);

    // Variables, not only literals.
    string x = "cat";
    string y = "bear";
    check("var x > y", x > y, true);
    check("var x < y", x < y, false);
    x = "dog";
    check("var x > y after assign", x > y, true);
    check("var y < x", y < x, true);

    // Print form used by the probe.
    printline("lt=" + (string)("apple" < "banana"));
    printline("lt2=" + (string)("b" < "a"));
    printline("le=" + (string)("a" <= "b"));
    printline("gt=" + (string)("cat" > "bear"));
    check("probe lt", (string)("apple" < "banana") == "1", true);
    check("probe lt2", (string)("b" < "a") == "0", true);
    check("probe le", (string)("a" <= "b") == "1", true);
    check("probe gt", (string)("cat" > "bear") == "1", true);

    // Equal strings.
    check("melon == melon", "melon" == "melon", true);
    check("melon != melon", "melon" != "melon", false);
    check("melon < melon", "melon" < "melon", false);
    check("melon <= melon", "melon" <= "melon", true);
    check("melon > melon", "melon" > "melon", false);
    check("melon >= melon", "melon" >= "melon", true);

    // Prefix strings.
    check("app < apple", "app" < "apple", true);
    check("apple < app", "apple" < "app", false);
    check("app <= apple", "app" <= "apple", true);
    check("apple <= app", "apple" <= "app", false);
    check("apple > app", "apple" > "app", true);
    check("app > apple", "app" > "apple", false);
    check("apple >= app", "apple" >= "app", true);
    check("app >= apple", "app" >= "apple", false);
    check("app == apple", "app" == "apple", false);
    check("app != apple", "app" != "apple", true);

    // Empty string boundaries.
    check("empty < a", "" < "a", true);
    check("a < empty", "a" < "", false);
    check("empty == empty", "" == "", true);
    check("empty <= empty", "" <= "", true);
    check("empty >= empty", "" >= "", true);
    check("empty > empty", "" > "", false);
    check("empty <= a", "" <= "a", true);
    check("empty >= a", "" >= "a", false);
    check("empty != a", "" != "a", true);

    // Reverse direction.
    check("banana > apple", "banana" > "apple", true);
    check("banana < apple", "banana" < "apple", false);
    check("banana >= apple", "banana" >= "apple", true);
    check("apple >= banana", "apple" >= "banana", false);
    check("apple > banana", "apple" > "banana", false);

    // Case: byte order, so uppercase sorts before lowercase.
    check("Z < a", "Z" < "a", true);
    check("a < Z", "a" < "Z", false);
    check("A < a", "A" < "a", true);
    check("apple < Apple", "apple" < "Apple", false);
    check("Apple < apple", "Apple" < "apple", true);
    check("BANANA < banana", "BANANA" < "banana", true);
    check("banana > Apple", "banana" > "Apple", true);
    check("z >= Z", "z" >= "Z", true);
    check("Z >= z", "Z" >= "z", false);

    // Guard form (DOCS/45-style) with relational string tests.
    string label = "quux";
    if (label < "m") {
        printline("FAIL guard: quux should not be < m");
        exit(2);
    }
    if (label >= "m") {
        printline("ok guard form");
    } else {
        printline("FAIL guard: quux should be >= m");
        exit(2);
    }

    // Doc example: alphabetical first order.
    string first = "apple";
    string second = "banana";
    if (first < second) {
        printline("first comes first");
    } else {
        printline("FAIL doc example: apple should come first");
        exit(3);
    }

    printline("ALL OK");
}
