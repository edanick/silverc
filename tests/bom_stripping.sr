// BOM (DOCS/235): hasBom, strip, prepend. Exit code 0 = all checks pass.
import * from bom;

void expect(bool got, string what) {
    if (!got) {
        printline("bom check failed: " + what);
        exit(1);
    }
}

void main() {
    expect(!bom.hasBom("hello"), "no bom on plain text");
    expect(bom.hasBom(bom.prepend("hello")), "prepend adds bom");
    expect(bom.strip(bom.prepend("hello")) == "hello", "strip roundtrip");
    expect(bom.strip("hello") == "hello", "strip plain is identity");
    expect(bom.prepend(bom.prepend("hello")) == bom.prepend("hello"), "prepend is idempotent");
    expect(bom.strip(bom.prepend("")) == "", "bom empty roundtrip");

    printline("bom-stripping-ok");
}
