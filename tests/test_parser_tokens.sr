class Token {
    public prop int kind;
    public prop string text;
    public prop int line;
    public prop int col;

    construct (int k, string t, int ln, int c) {
        this.kind = k; this.text = t;
        this.line = ln; this.col = c;
    }
}

class Parser {
    private prop Token[] tokens;
    private prop int pos;

    construct (Token[] toks) {
        this.tokens = toks;
        this.pos = 0;
    }

    public Token peek() {
        return this.tokens[this.pos];
    }

    public void advance() {
        this.pos = this.pos + 1;
    }
}

void main() {
    Token[] tokens;
    tokens = [];

    tokens.add(new Token(7, "Foo", 2, 5));
    tokens.add(new Token(7, "f", 2, 9));

    print("direct[0]: kind=");
    print(tokens[0].kind);
    print(" text=");
    print(tokens[0].text);
    print(" line=");
    print(tokens[0].line);
    print(" col=");
    printline(tokens[0].col);

    print("direct[1]: kind=");
    print(tokens[1].kind);
    print(" text=");
    print(tokens[1].text);
    print(" line=");
    print(tokens[1].line);
    print(" col=");
    printline(tokens[1].col);

    Parser parser;
    parser = new Parser(tokens);

    Token p0;
    p0 = parser.peek();
    print("peek[0]: kind=");
    print(p0.kind);
    print(" text=");
    print(p0.text);
    print(" line=");
    print(p0.line);
    print(" col=");
    printline(p0.col);

    parser.advance();

    Token p1;
    p1 = parser.peek();
    print("peek[1]: kind=");
    print(p1.kind);
    print(" text=");
    print(p1.text);
    print(" line=");
    print(p1.line);
    print(" col=");
    printline(p1.col);
}
