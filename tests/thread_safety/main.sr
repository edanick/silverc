int safetyMargin(int total) {
    int quarter = total / 4;
    if (quarter < 2) { quarter = 2; }
    return quarter;
}

int capacityBudget(int total) {
    int capacity = total - safetyMargin(total);
    if (capacity < 1) { capacity = 1; }
    return capacity;
}

int demandForThreads(int threads) {
    int demand = threads + 1;
    if (demand < 1) { demand = 1; }
    return demand;
}

int chunkSizeForThreads(int hint, int threads, int64 budget) {
    if (threads < 1) { threads = 1; }
    int64 perWorker = budget / threads / 1024;
    if (perWorker < 1) { perWorker = 1; }
    int cap = int(perWorker);
    if (hint < 1) { hint = 1; }
    if (hint < cap) { return hint; }
    return cap;
}

bool capacityAdmits(int admitted, int demand, int capacity) {
    if (admitted == 0) { return true; }
    if (demand > capacity) { return false; }
    return admitted + demand <= capacity;
}

void main() {
    int checks = 0;
    if (safetyMargin(1) != 2) { exit(1); }
    checks++;
    if (safetyMargin(4) != 2) { exit(1); }
    checks++;
    if (safetyMargin(8) != 2) { exit(1); }
    checks++;
    if (safetyMargin(16) != 4) { exit(1); }
    checks++;
    if (safetyMargin(20) != 5) { exit(1); }
    checks++;
    if (capacityBudget(1) != 1) { exit(1); }
    checks++;
    if (capacityBudget(4) != 2) { exit(1); }
    checks++;
    if (capacityBudget(8) != 6) { exit(1); }
    checks++;
    if (capacityBudget(16) != 12) { exit(1); }
    checks++;
    if (demandForThreads(1) != 2) { exit(1); }
    checks++;
    if (demandForThreads(4) != 5) { exit(1); }
    checks++;
    if (chunkSizeForThreads(1000, 4, 24576) != 6) { exit(1); }
    checks++;
    if (chunkSizeForThreads(100, 1, 1024000) != 100) { exit(1); }
    checks++;
    if (chunkSizeForThreads(100, 2, 1024000) != 100) { exit(1); }
    checks++;
    if (chunkSizeForThreads(1000, 1, 24576) != 24) { exit(1); }
    checks++;
    if (chunkSizeForThreads(1000, 2, 24576) != 12) { exit(1); }
    checks++;
    if (capacityAdmits(0, 5, 4) != true) { exit(1); }
    checks++;
    if (capacityAdmits(2, 2, 4) != true) { exit(1); }
    checks++;
    if (capacityAdmits(3, 2, 4) != false) { exit(1); }
    checks++;
    if (capacityAdmits(1, 5, 4) != false) { exit(1); }
    checks++;
    if (checks != 20) { exit(1); }
    printline("thread-safety-ok " + (string)checks);
}
