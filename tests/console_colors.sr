// Console colors (DOCS/171, DOCS/241): compile-only, no main, so no
// console side effect can fire in a runner. Typechecks every console
// constant, cursor/title/clear entry, true-color entry, and named-color /
// style string entry.
import console;

void checkConsoleSurface() {
    int black = console.Black;
    int darkBlue = console.DarkBlue;
    int darkGreen = console.DarkGreen;
    int darkCyan = console.DarkCyan;
    int darkRed = console.DarkRed;
    int darkMagenta = console.DarkMagenta;
    int darkYellow = console.DarkYellow;
    int gray = console.Gray;
    int darkGray = console.DarkGray;
    int blue = console.Blue;
    int green = console.Green;
    int cyan = console.Cyan;
    int red = console.Red;
    int magenta = console.Magenta;
    int yellow = console.Yellow;
    int white = console.White;
    int brightGreen = console.BrightGreen;
    int brightRed = console.BrightRed;

    console.setForeground(black);
    console.setBackground(white);
    console.foreground(brightGreen);
    console.reset();
    console.setTitle("Silver console");
    string title = console.getTitle();
    console.clear();
    console.rgb(100, 200, 255);
    console.bgRgb(30, 30, 30);

    string paint = console.black("black") + console.darkblue("blue") + console.darkgreen("green");
    paint += console.darkcyan("cyan") + console.darkred("red") + console.darkmagenta("magenta");
    paint += console.darkyellow("yellow") + console.gray("gray") + console.darkgray("darkgray");
    paint += console.brightred("bright red") + console.brightgreen("bright green");
    paint += console.red("red") + console.green("green") + console.yellow("yellow");
    paint += console.blue("blue") + console.magenta("magenta") + console.cyan("cyan");
    paint += console.white("white");
    paint += console.bold("bold") + console.dim("dim") + console.underline("underlined");
    if (darkBlue == darkRed) { printline(title); }
    if (gray == white) { printline(paint); }
    if (green == yellow) { printline("never"); }
    if (cyan == magenta) { printline("never"); }
    if (brightGreen == brightRed) { printline("never"); }
}
