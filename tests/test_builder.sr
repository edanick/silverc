class Builder {
    public prop int[] data;

    construct () {
        this.data = [];
    }

    public void addStringChars(string s) {
        for (int i = 0; i < s.length; i++) {
            this.data.add(s[i]);
        }
        this.data.add(0);
    }

    public int getLen() {
        return this.data.length;
    }

    public int getAt(int idx) {
        return this.data[idx];
    }
}

void main() {
    Builder b;
    b = new Builder();
    b.addStringChars("hello");
    print("len=");
    printline(b.getLen());
    for (int i = 0; i < b.getLen(); i++) {
        print(" [");
        print(i);
        print("]=");
        print(b.getAt(i));
    }
    printline("");
}
