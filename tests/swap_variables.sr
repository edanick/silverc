// Variable swap (DOCS/272): swap(a, b) exchanges two variables of the same
// type with no `&` needed; mismatched kinds throw a catchable value error
// and leave both variables unchanged. Exit code 0 = exact.

int g1 = 10;
int g2 = 20;

void check(bool ok, string label) {
    if (!ok) {
        printline("FAIL " + label);
        exit(1);
    }
}

void main() {
    // The requested example: two ints exchange values.
    int x = 1;
    int y = 2;
    swap(x, y);
    check(x == 2, "int-x");
    check(y == 1, "int-y");

    // Strings swap their contents.
    string p = "aa";
    string q = "bb";
    swap(p, q);
    check(p == "bb", "string-p");
    check(q == "aa", "string-q");

    // Floats swap as well.
    float f1 = 1.5;
    float f2 = 2.5;
    swap(f1, f2);
    check(f1 == 2.5, "float-f1");
    check(f2 == 1.5, "float-f2");

    // Array variables exchange their whole arrays.
    int[] arr1 = [1, 2];
    int[] arr2 = [3, 4, 5];
    swap(arr1, arr2);
    check(arr1.length == 3, "array-len1");
    check(arr2.length == 2, "array-len2");
    check(arr1[0] == 3, "array-0");
    check(arr2[0] == 1, "array-back-0");

    // Globals swap through the same builtin.
    swap(g1, g2);
    check(g1 == 20, "global-g1");
    check(g2 == 10, "global-g2");

    // The `&` spelling is tolerated and swaps the same way.
    int m = 5;
    int n = 6;
    swap(&m, &n);
    check(m == 6, "ref-m");
    check(n == 5, "ref-n");

    // Swapping a variable with itself is a no-op.
    int same = 42;
    swap(same, same);
    check(same == 42, "self");

    // Mismatched types throw and change nothing.
    int xi = 1;
    string s = "hi";
    try {
        swap(xi, s);
        printline("FAIL mismatch silently swapped");
        exit(1);
    } catch (Exception e) {
    }
    check(xi == 1, "mismatch-int");
    check(s == "hi", "mismatch-string");

    // Non-variables throw as well.
    try {
        swap(1, 2);
        printline("FAIL literals silently swapped");
        exit(1);
    } catch (Exception e) {
    }

    printline("swap variables ok");
}
