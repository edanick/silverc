// Copy-on-assign for arrays (SPEC 9.2 / D11): assigning a heap array
// produces an independent copy. Mutating one binding leaves the other.
void grow(int[] p) {
    p.push(99);
}

void main() {
    // Variable declaration with initializer.
    int[] a = [1, 2, 3];
    int[] b = a;
    b[0] = 99;
    if (a[0] != 1) {
        printline("decl copy shared: a[0] changed");
        throw "copy check failed";
    }
    if (b[0] != 99) {
        printline("decl copy wrong");
        throw "copy check failed";
    }

    // Plain assignment (not declaration).
    int[] c = [7, 8, 9];
    int[] d = [];
    d = c;
    d[1] = 42;
    if (c[1] != 8 || d[1] != 42) {
        printline("assign copy shared");
        throw "copy check failed";
    }

    // Push through the copy must not grow the source.
    int[] s = [1, 2, 3];
    int[] t = s;
    t.push(4);
    if (s.length != 3 || t.length != 4) {
        printline("push through copy reached source");
        throw "copy check failed";
    }

    // Container element store of an array.
    int[] inner = [5, 6, 7];
    int[][] outer = [];
    outer.push([0]);
    outer[0] = inner;
    outer[0][0] = 99;
    if (inner[0] != 5) {
        printline("element store shared");
        throw "copy check failed";
    }

    // Parameters stay by reference: a push inside a callee still reaches
    // the caller.
    int[] p = [1, 2];
    grow(p);
    if (p.length != 3 || p[2] != 99) {
        printline("param growth lost");
        throw "copy check failed";
    }

    // Move (<<) still transfers, it does not copy.
    int[] m = [11, 12];
    int[] n << m;
    n[0] = 77;
    if (n[0] != 77) {
        printline("move lost value");
        throw "copy check failed";
    }

    printline("assigned array is a copy ok");
}
