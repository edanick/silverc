// Argument-level type checking on calls (argument-type analog):
// a nullable argument may only reach a non-nullable parameter when the
// flow proved it non-null, when `??` unwrapped it, or when a nullable
// parameter overload accepts it. Exit code 0 = exact.

int? src() << null;

int? src_or(int v) << v;

int twice(int v) {
    return v + v;
}

string tagOf(string t) {
    return "[" + t + "]";
}

string? maybeTag() << null;

string? nullTag() << null;

string describe(string? t) {
    // Overload-style rescue: a `string?` parameter takes the nullable.
    return t ?? "none";
}

void main() {
    // Narrowed nullable passes.
    int? x = src_or(4);
    if (x != null) {
        printline(twice(x));
    }

    // `??` unwrapping passes (inferred type is the inner int).
    int? y = src();
    printline(twice(y ?? 1));

    // A nullable-parameter function takes the nullable directly.
    printline(describe(nullTag()));

    // Non-nullable into nullable parameter is fine.
    printline(describe("solid"));

    // Assignment-derived fact: `w = 6` proves w non-null.
    int? w = src();
    w = 6;
    printline(twice(w));

    // Literal into a nullable-holding helper via string? param.
    printline(tagOf(maybeTag() ?? "fallback"));

    printline("call argument types ok");
}
