// A read THROUGH a nested object yields the VALUE, never the raw pointer:
// the member form (`root.server.port`) and the index form
// (`root["server"]["port"]`) answer the same, and a nested object two
// levels deep reads the same way. Before the fix the compilers rendered the
// string's address as a decimal (and the index form took the array path,
// which threw "index out of range" on the dict's own header).

void main() {
    object root = {};
    object server = {};
    server["port"] = "8080";
    server["backlog"] = 128;
    root["server"] = server;

    if (root.server.port != "8080") { exit(1); }
    if (root["server"]["port"] != "8080") { exit(2); }
    if (root.server.backlog != 128) { exit(3); }
    if (root["server"]["backlog"] != 128) { exit(4); }

    // Two levels deep: the member form and the index form agree.
    object mid = {};
    object leaf = {};
    leaf["name"] = "deep";
    mid["leaf"] = leaf;
    root["mid"] = mid;

    if (root.mid.leaf.name != "deep") { exit(5); }
    if (root["mid"]["leaf"]["name"] != "deep") { exit(6); }

    // A flat object reads the same way as before.
    object flat = {};
    flat["key"] = "value";
    if (flat.key != "value") { exit(7); }
    if (flat["key"] != "value") { exit(8); }

    printline("nested object reads: ok");
}
