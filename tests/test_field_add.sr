mod export compiler;
import * from fs;

class Box {
    public prop int[] items;
    public prop string[] names;
    public prop string name;
    
    construct() {
        this.items = [];
        this.names = [];
        this.name = "test";
    }
    
    public void addItem(int v) {
        this.items.add(v);
    }
    
    public void addName(string s) {
        this.names.add(s);
    }
    
    public int getCount() {
        return this.items.length;
    }
    
    public void printAll() {
        printline(this.name);
        for (int i = 0; i < this.items.length; i++) {
            printline(this.items[i]);
        }
        for (int i = 0; i < this.names.length; i++) {
            printline(this.names[i]);
        }
    }
}

void main() {
    Box c = new Box();
    c.addItem(10);
    c.addItem(20);
    c.addName("hello");
    c.addName("world");
    printline(c.getCount());
    c.printAll();
    printline("done");
}
