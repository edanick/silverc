// Variant-reference checking: every EnumName.Variant spelling — in
// declarations, expressions, match patterns and switch case values —
// names a declared variant; invented variants are compile errors.
// Exit code 0 = exact.

enum Color { Red, Green, Blue }

string nameOf(Color c) {
    switch (c) {
        case Color.Red { return "red"; }
        case Color.Green { return "green"; }
        else { return "blue"; }
    }
}

void check(bool ok, string label) {
    if (!ok) {
        printline("FAIL " + label);
        exit(1);
    }
}

void main() {
    Color warm = Color.Red;
    Color cool = Color.Blue;
    check(warm == Color.Red, "variant-expression");
    check(nameOf(cool) == "blue", "variant-switch-case");

    match (warm) {
        Color.Red => { check(true, "variant-pattern"); }
        Color.Green => { check(false, "wrong-arm"); }
        _ => { check(false, "wrong-arm"); }
    }

    printline("enum variant reference ok");
}
