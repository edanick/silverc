// DOCS/261 / SPEC 15.6: membership operators `in` and `not in`.
// Tests every documented combination: value-in-literal, value-in-var,
// variable-in-literal, variable-in-var, not-in, precedence, for-loop
// regression, and int/string/char/float element types.

void main() {
    // ── basic `in` ──────────────────────────────────────────────────
    // 2 in [1, 2, 3]  →  1 (true)
    if (!(2 in [1, 2, 3])) { printline("FAIL 2 in [1,2,3]"); exit(1); }
    // 2 in [1, 3]     →  0 (false)
    if (2 in [1, 3]) { printline("FAIL 2 in [1,3]"); exit(1); }

    // ── `in` with variable arrays ────────────────────────────────────
    int[] y = [1, 2, 3];
    if (!(2 in y)) { printline("FAIL 2 in y"); exit(1); }

    string x = "a";
    if (!(x in ["a", "b"])) { printline("FAIL x in [a,b]"); exit(1); }

    string[] names = ["Ann", "Bo"];
    if (x in names) { printline("FAIL x in names"); exit(1); }

    // ── result is a usable bool ──────────────────────────────────────
    bool test = (2 in [2, 2]);
    if (!test) { printline("FAIL bool assignment"); exit(1); }

    // ── `in` inside if-else ──────────────────────────────────────────
    if (2 in [1, 3]) {
        printline("FAIL if-branch taken");
        exit(1);
    } else {
        // expected path
    }

    // ── `not in` (must be parenthesized) ─────────────────────────────
    bool z = ("yes" not in ["hello", "bye"]);
    if (!z) { printline("FAIL not in bool"); exit(1); }

    if (2 not in [2, 4]) {
        printline("FAIL if-branch not-in");
        exit(1);
    } else {
        // expected path
    }

    // ── precedence: `a in b && c` == `(a in b) && c` ────────────────
    bool flag = true;
    if (!(2 in [1, 2, 3] && flag)) { printline("FAIL precedence in &&"); exit(1); }
    if (2 in [1, 3] && flag) { printline("FAIL precedence in && false"); exit(1); }

    // ── `in` with char elements ──────────────────────────────────────
    if (!('b' in ['a', 'b', 'c'])) { printline("FAIL char in"); exit(1); }
    if ('z' in ['a', 'b', 'c']) { printline("FAIL char not-in"); exit(1); }

    // ── `in` with float elements ─────────────────────────────────────
    float pi = 3.14;
    if (!(pi in [1.0, 3.14, 9.9])) { printline("FAIL float in"); exit(1); }
    if (pi in [1.0, 2.0]) { printline("FAIL float not-in"); exit(1); }

    // ── `not in` on a variable array ─────────────────────────────────
    if ("Ann" not in names) { printline("FAIL not-in var"); exit(1); }

    // ── empty array ──────────────────────────────────────────────────
    int[] empty = [];
    if (1 in empty) { printline("FAIL in empty"); exit(1); }
    if (!(1 not in empty)) { printline("FAIL not-in empty"); exit(1); }

    // ── foreach-loop `in` still works (regression) ───────────────────
    int sum = 0;
    foreach (int v in [10, 20, 30]) {
        sum += v;
    }
    if (sum != 60) { printline("FAIL foreach-loop in regression"); exit(1); }

    // ── computed strings use content comparison (strcmp), not pointer ──
    // equality: `ab` is a fresh heap string, never interned with literals.
    string ab = "a" + "b";
    if (!(ab in ["ab", "cd"])) { printline("FAIL computed string in literal"); exit(1); }
    if (ab in ["ax", "cd"]) { printline("FAIL computed string not-in literal"); exit(1); }
    string[] words = ["ab", "cd"];
    if (!(ab in words)) { printline("FAIL computed string in var"); exit(1); }

    printline("membership ok");
}
