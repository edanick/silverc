// An anonymous function body is an isolated unit: free calls inside it
// resolve against the file's declarations and the built-ins, so known
// calls pass the walk while nothing enclosing leaks in. The fn-typed
// local is declared with its `void ()` type and invoked with no args.

int helper(int v) {
    return v * 3;
}

void main() {
    int captured = 5;
    int r = helper(captured);
    printline(r);
    void () run = (void () {
        int inner = helper(2);
        printline(inner);
    });
    run();
    printline("done");
}
