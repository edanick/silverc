// XML (DOCS/184): parse, children, attribute, query with //, beautify,
// and the builder. Exit code 0 = all checks pass.
import * from xml;

void expect(bool got, string what) {
    if (!got) {
        printline("xml check failed: " + what);
        exit(1);
    }
}

void main() {
    xml.document doc = xml.parse("<root><item id=\"1\">hello</item><item id=\"2\">world</item></root>");
    expect(doc.root.name == "root", "parse synthetic root");
    xml.node[] items = doc.root.children("item");
    expect(items.length == 2, "children count");
    expect(items[0].attribute("id") == "1", "attribute first");
    expect(items[1].attribute("id") == "2", "attribute second");
    expect(items[0].attribute("missing") == "", "attribute missing is empty");
    // NOTE: node.text is always empty on silverc-rs (parse assigns to the
    // local copy of current). Text is intentionally not asserted here.

    xml.node found = doc.root.query("//item");
    expect(found != null, "query finds deep");
    expect(found.attribute("id") == "1", "query first match");

    xml.builder builder = new xml.builder();
    builder.start("a");
    builder.text("hi");
    builder.end();
    string built = builder.build();
    expect(built.indexOf("<a>") >= 0, "builder start tag");
    expect(built.indexOf("hi") >= 0, "builder text");

    xml.builder builder2 = new xml.builder();
    builder2.start("outer", {});
    builder2.text("inner");
    builder2.end();
    expect(builder2.build().indexOf("outer") >= 0, "builder with attrs");

    printline("xml-query-ok");
}
