// Optimizer fold fixture (MEMORY.md §3.2 row 7, optimizer audit): a fold
// attempt that does not fold allocates no replacement Node (the null path
// is allocation-free). Successful folds must still fold to the same
// values, faulting folds (div/mod by zero, INT64_MIN / -1, shifts outside
// 0..63) must stay unfolded so runtime behavior is byte-identical, and
// dead top-level functions sharing one bucket must still be dropped
// while live ones are kept. This program must compile and print exactly
// `optimizer-fold-ok 205`.

int liveHelper(int x) {
    return x * 2 + 1;
}

int deadHelper(int x) {
    return x + 1000;
}

int aa1(int x) {
    return x - 1;
}

int aa2(int x) {
    return x - 2;
}

void main() {
    int add = 7 + 5;
    int sub = 20 - 8;
    int mul = 6 * 7;
    int div = 100 / 4;
    int mod = 100 % 7;
    int band = 12 & 10;
    int bor = 12 | 10;
    int bxor = 12 ^ 10;
    int shl = 3 << 4;
    int shr = 64 >> 2;
    bool cmp = 42 < 100;
    bool eq = 9 == 9;
    int live = liveHelper(4);
    int first = aa1(10);
    if (false) {
        int fdiv = 5 / 0;
        int fmod = 5 % 0;
        int fmin = (-9223372036854775807 - 1) / -1;
        int fmin2 = (-9223372036854775807 - 1) % -1;
        int fshl = 1 << 64;
        int fshr = 8 >> -1;
        printline("dead " + (string)fdiv + (string)fmod + (string)fmin + (string)fmin2 + (string)fshl + (string)fshr);
    }
    int total = add + sub + mul + div + mod + band + bor + bxor + shl + shr + live + first;
    if (cmp) { total = total + 1; }
    if (eq) { total = total + 1; }
    printline("optimizer-fold-ok " + (string)total);
}
