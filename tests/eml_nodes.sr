// EML (EML.md): parse, attribute/hasAttribute/addChild/children/child/
// childCount, attributeNames, stringify/beautify, load/save through output/.
// Exit code 0 = all checks pass.
import * from eml;

void expect(bool got, string what) {
    if (!got) {
        printline("eml check failed: " + what);
        exit(1);
    }
}

void main() {
    eml.EmlDocument doc = eml.parse("Root { Child (A=\"x\"); Leaf; };");
    expect(doc.root.childCount() == 1, "synthetic root holds one child");
    eml.EmlNode root = doc.root.children("")[0];
    expect(root.name == "Root", "parsed root name");
    expect(root.childCount() == 2, "root child count");
    eml.EmlNode[] kids = root.children("");
    expect(kids.length == 2, "children empty lists all");
    expect(kids[0].name == "Child", "first child name");
    expect(kids[1].name == "Leaf", "second child name");
    eml.EmlNode[] childOnly = root.children("Child");
    expect(childOnly.length == 1, "children filters tag");
    expect(childOnly[0].attribute("A") == "x", "attribute read");
    expect(childOnly[0].hasAttribute("A"), "hasAttribute true");
    expect(!childOnly[0].hasAttribute("Z"), "hasAttribute false");
    string[] attrNames = childOnly[0].attributeNames();
    expect(attrNames.length == 1 && attrNames[0] == "A", "attributeNames");
    expect(root.child(0) != null, "child zero present");
    expect(root.child(99) == null, "child out of range null");

    eml.EmlNode manual = new eml.EmlNode();
    manual.name = "Manual";
    manual.setAttribute("K", "V");
    expect(manual.attribute("K") == "V", "setAttribute roundtrip");
    eml.EmlNode kid = new eml.EmlNode();
    kid.name = "Kid";
    manual.addChild(kid);
    expect(manual.childCount() == 1, "addChild count");

    string rendered = eml.stringify(doc);
    expect(rendered.indexOf("Root") >= 0, "stringify root");
    expect(rendered.indexOf("Child") >= 0, "stringify child");
    string pretty = eml.beautify("Solo (Name=\"a\");");
    expect(pretty.indexOf("Solo") >= 0, "beautify solo");

    string savePath = "output/eml_nodes_tmp.eml";
    eml.save(savePath, doc);
    eml.EmlDocument loaded = eml.load(savePath);
    expect(loaded.root.childCount() == 1, "load synthetic child count");
    expect(loaded.root.children("")[0].childCount() == 2, "load child count");
    file.delete(savePath);

    printline("eml-nodes-ok");
}
