// The standalone import-collection path: the driver resolves every
// source-level import of the entry file, reads each module file ONCE, and
// joins the collected module sources (dependencies first) with the entry
// source into ONE aggregate that is lexed and parsed as a single unit.
//
// This fixture covers that path with several source-level modules at once.
// Every module's own definitions must be present in the aggregate exactly
// once: a module that was not collected shows up as a missing definition
// (the compile fails), a module collected twice shows up as a duplicate
// definition (the compile fails). Those are the failure modes the
// collection path can produce (MEMORY.md §3.2 rank 4 — resolve once, read
// once, pass the text through).
import * from json;
import * from datetime;
import * from encoding;

void main() {
    // json: the module's own parser and its typed accessors.
    JsonValue parsed = json.parse("{\"n\": 7}");
    if (json.getNumber(parsed, "n") != 7) {
        printline("FAIL json");
        exit(1);
    }
    // datetime: the module's own DateTime type.
    var moment = datetime.fromUnix(0);
    if (moment.year != 1970 || moment.month != 1 || moment.day != 1) {
        printline("FAIL datetime");
        exit(1);
    }
    // encoding: the module's own codec.
    int[] points = [];
    points.add(65);
    byte[] out = new byte[4];
    if (encoding.utf8Encode(points, out) != 1) {
        printline("FAIL encoding");
        exit(1);
    }
    printline("import-collection-ok");
}
