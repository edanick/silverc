// Constant-condition reachability (constant-fold concept):
// literal-false if/while conditions warn that the body is dead code but
// still compile; literal-true forms stay silent (ordinary idioms).
// Exit code 0 = exact.

void main() {
    // Guaranteed-run block: no warning, runs normally.
    int ran = 0;
    if (true) {
        ran = 1;
    }
    printline(ran);

    // Dead then-body with a live else: warns, takes the else path.
    int taken = 0;
    if (false) {
        taken = 5;
    } else {
        taken = 6;
    }
    printline(taken);

    // while (true) with break: the intentional-loop idiom, no warning.
    int n = 0;
    while (true) {
        n++;
        if (n >= 3) {
            break;
        }
    }
    printline(n);

    printline("constant condition ok");
}
