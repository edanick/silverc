class Token {
    int kind;
    string text;

    construct(int k, string t) {
        this.kind = k;
        this.text = t;
    }
}

void main() {
    int[] data = [72, 101, 108, 108, 111];
    printline(data.length);
    printline(data[0]);

    Token t1 = new Token(17, "void");
    Token[] toks = [t1];
    printline($"toks = {toks}");
    printline($"toks[0] = {toks[0]}");
    printline($"toks[0].kind = {toks[0].kind}");

    int idx = 0;
    Token[] arr = toks;
    printline($"arr = {arr}");
    printline($"arr[idx] = {arr[idx]}");
    printline($"arr[idx].kind = {arr[idx].kind}");
}
