mod export compiler;
import * from fs;

class Box {
    public prop int val;
    public prop string name;

    construct() {
        printline("ctor");
        this.val = 42;
        this.name = "hello";
    }

    public void show() {
        printline(this.val);
        printline(this.name);
    }
}

void main() {
    Box b = new Box();
    b.show();
}
