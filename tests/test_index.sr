class Token {
    int kind;
    string text;

    construct(int k, string t) {
        this.kind = k;
        this.text = t;
    }
}

void main() {
    Token t1 = new Token(17, "void");
    Token t2 = new Token(7, "main");
    printline($"t1 kind = {t1.kind}");
    printline($"t2 kind = {t2.kind}");

    Token[] toks = [t1, t2];
    printline($"toks[0] kind = {toks[0].kind}");
    printline($"toks[1] kind = {toks[1].kind}");
}
