class Token {
    int kind;
    string text;

    construct(int k, string t) {
        this.kind = k;
        this.text = t;
    }
}

class Parser {
    Token[] tokens;
    int pos;

    construct(Token[] toks) {
        this.tokens = toks;
        this.pos = 0;
    }

    private Token peek() {
        if (this.pos < this.tokens.length) {
            return this.tokens[this.pos];
        }
        return this.tokens[this.tokens.length - 1];
    }

    private bool check(int kind) {
        return this.peek().kind == kind;
    }

    public void run() {
        printline($"peek kind = {this.peek().kind}");
        printline($"check(17) = {this.check(17)}");
        printline($"check(99) = {this.check(99)}");
        printline($"pos = {this.pos}");
    }
}

void main() {
    Token t1 = new Token(17, "void");
    Token t2 = new Token(7, "main");
    Token[] toks = [t1, t2];
    Parser p = new Parser(toks);
    p.run();
}
