// Mouse and keyboard input (DOCS/225, DOCS/226): compile-only, no main,
// so no keystroke can be injected or the cursor moved in a runner.
// Typechecks the mouse Cursor/Position/buttons/scroll surface and the
// keyboard press/release/hold/send/type/isDown/vk/name surface.
import * from mouse;
import * from keyboard;

void checkMouseKeyboardSurface() {
    mouse.mouse device = new mouse.mouse();
    device.press(1);
    device.hold(1);
    device.release(1);
    device.click(1);
    device.tap(1);
    device.scroll(3);
    mouse.ScrollDirection down = new mouse.ScrollDirection(0);
    device.scroll(3, down);
    int cursorX = device.cursorX();
    int cursorY = device.cursorY();
    int gotX = device.getCursorX();
    int gotY = device.getCursorY();

    mouse.Cursor cursor = device.cursor;
    int localX = cursor.getX();
    int localY = cursor.getY();
    cursor.setX(localX);
    cursor.setY(localY);
    mouse.Position pos = cursor.getPosition();
    cursor.setPosition(pos.x, pos.y);

    mouse.MouseButton button = new mouse.MouseButton(1);
    bool isDown = button != null;

    keyboard.press("a");
    keyboard.press(65);
    keyboard.release("a");
    keyboard.release(65);
    keyboard.hold("a");
    keyboard.hold(65);
    keyboard.send("hello");
    keyboard.type("hello");
    bool keyIsDownName = keyboard.isDown("enter");
    bool keyIsDownVk = keyboard.isDown(13);
    int vkCode = keyboard.vk("enter");
    int nameVk = keyboard.nameToVk("enter");
    int fromKey = keyboard.keyNameToVk("enter");
    string xName = keyboard.keyNameToX("enter");
    string[] samples = ["a", xName, (string)vkCode, (string)nameVk, (string)fromKey];
    if (cursorX == gotX) { printline(samples[0]); }
    if (cursorY == gotY) { printline(samples[1]); }
    if (isDown) { printline(samples[2]); }
    if (keyIsDownName) { printline(samples[3]); }
    if (keyIsDownVk) { printline(samples[4]); }
    if (down.type == button.type) { printline("never"); }
}
