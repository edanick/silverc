import json;

int sub2(int x, int y) { return x - y; }
int f3(int a, int b, int c) { return a * 100 + b * 10 + c; }

void main() {
    printline("order: " + sub2(y = 3, x = 10));
    printline("three: " + f3(c = 7, a = 1, b = 2));
    object data = {"name": "Alice", "age": 30};
    printline(json.stringify(data, 4, multiline = true));
}
