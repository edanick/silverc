class Tok {
    private prop int kind;
    private prop string text;
    construct (int k, string t) {
        this.kind = k;
        this.text = t;
    }
    int getKind() { return this.kind; }
    string getText() { return this.text; }
}
void main() {
    Tok t = new Tok(1, "hello");
    printline("kind=" + t.getKind());
    printline("text=" + t.getText());
}
