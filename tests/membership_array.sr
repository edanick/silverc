// Membership (`in` / `not in`) scans arrays and ranges; the collection side
// of every form here is an array-typed value, so all calls are legal.

void main() {
    int[] xs = [1, 2, 3, 4];
    if (2 in xs) { printline("two in"); }
    if (9 in xs) { printline("nine in"); } else { printline("nine out"); }
    if (5 not in xs) { printline("five not in"); }
    string[] names = ["ada", "grace", "edsger"];
    if ("grace" in names) { printline("grace in"); }
    if (1 in 0..3) { printline("range in"); }
    printline("done");
}
