mod export compiler;

class MiniAsm {
    public prop int[] buf;

    construct () {
        this.buf = [];
    }

    public void emitU8(int b) {
        this.buf.add(b & 0xFF);
    }

    public void emitU16(int v) {
        this.emitU8(v);
        this.emitU8(v >> 8);
    }

    public void emitU32(int v) {
        this.emitU8(v);
        this.emitU8(v >> 8);
        this.emitU8(v >> 16);
        this.emitU8(v >> 24);
    }

    public void emitU64(int64 v) {
        this.emitU32(v & 0xFFFFFFFF);
        this.emitU32((v >> 32) & 0xFFFFFFFF);
    }

    public int[] getBytes() {
        return this.buf;
    }

    public void pushR64(int r) {
        if (r > 7) { this.emitU8(0x41); }
        this.emitU8(0x50 + (r & 7));
    }

    public void popR64(int r) {
        if (r > 7) { this.emitU8(0x41); }
        this.emitU8(0x58 + (r & 7));
    }

    public void movRR64(int dst, int src) {
        int rFlag = dst > 7 ? 1 : 0;
        int sFlag = src > 7 ? 1 : 0;
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x89);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void movRI64(int dst, int64 imm) {
        int dFlag = dst > 7 ? 1 : 0;
        this.emitU8(0x48 | dFlag);
        this.emitU8(0xB8 + (dst & 7));
        this.emitU64(imm);
    }

    public void movRMBase(int r, int base, int disp) {
        int rex = 0x48;
        if (r > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x8B);
        if (base == 5 || base == 13) {
            this.emitU8(0x85 | ((r & 7) << 3) | (base & 7));
            this.emitU32(disp);
        } elif (base == 4 || base == 12) {
            this.emitU8(((r & 7) << 3) | 0x04);
            this.emitU8(0x24);
            if (disp != 0) {
                this.emitU32(disp);
            }
        } else {
            if (disp == 0 && base != 5 && base != 13) {
                this.emitU8(((r & 7) << 3) | (base & 7));
            } elif (disp >= -128 && disp <= 127) {
                this.emitU8(0x40 | ((r & 7) << 3) | (base & 7));
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x80 | ((r & 7) << 3) | (base & 7));
                this.emitU32(disp);
            }
        }
    }

    public void movMBaseR(int base, int r, int disp) {
        int rex = 0x48;
        if (r > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x89);
        if (base == 5 || base == 13) {
            this.emitU8(0x85 | ((r & 7) << 3) | (base & 7));
            this.emitU32(disp);
        } elif (base == 4 || base == 12) {
            this.emitU8(((r & 7) << 3) | 0x04);
            this.emitU8(0x24);
            if (disp != 0) {
                this.emitU32(disp);
            }
        } else {
            if (disp == 0 && base != 5 && base != 13) {
                this.emitU8(((r & 7) << 3) | (base & 7));
            } elif (disp >= -128 && disp <= 127) {
                this.emitU8(0x40 | ((r & 7) << 3) | (base & 7));
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x80 | ((r & 7) << 3) | (base & 7));
                this.emitU32(disp);
            }
        }
    }

    public void subRI32(int r, int imm) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        if (imm >= -128 && imm <= 127) {
            this.emitU8(0x83);
            this.emitU8(0xE8 | (r & 7));
            this.emitU8(imm & 0xFF);
        } else {
            this.emitU8(0x81);
            this.emitU8(0xE8 | (r & 7));
            this.emitU32(imm);
        }
    }

    public void addRI32(int r, int imm) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        if (imm >= -128 && imm <= 127) {
            this.emitU8(0x83);
            this.emitU8(0xC0 | (r & 7));
            this.emitU8(imm & 0xFF);
        } else {
            this.emitU8(0x81);
            this.emitU8(0xC0 | (r & 7));
            this.emitU32(imm);
        }
    }

    public void xorRR64(int dst, int src) {
        int rFlag = dst > 7 ? 1 : 0;
        int sFlag = src > 7 ? 1 : 0;
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x31);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void cmpRI32(int r, int imm) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        if (imm >= -128 && imm <= 127) {
            this.emitU8(0x83);
            this.emitU8(0xF8 | (r & 7));
            this.emitU8(imm & 0xFF);
        } else {
            this.emitU8(0x81);
            this.emitU8(0xF8 | (r & 7));
            this.emitU32(imm);
        }
    }

    public void ret() {
        this.emitU8(0xC3);
    }

    public void callR64(int r) {
        if (r > 7) { this.emitU8(0x41); }
        this.emitU8(0xFF);
        this.emitU8(0xD0 | (r & 7));
    }

    public void leaRBase(int dst, int base, int disp) {
        int rex = 0x48;
        if (dst > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x8D);
        if (base == 4 || base == 12) {
            this.emitU8(0x80 | ((dst & 7) << 3) | 0x04);
            this.emitU8(0x24);
            this.emitU32(disp);
        } elif (base == 5 || base == 13) {
            this.emitU8(0x85 | ((dst & 7) << 3) | (base & 7));
            this.emitU32(disp);
        } else {
            if (disp == 0) {
                this.emitU8(((dst & 7) << 3) | (base & 7));
            } elif (disp >= -128 && disp <= 127) {
                this.emitU8(0x40 | ((dst & 7) << 3) | (base & 7));
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x80 | ((dst & 7) << 3) | (base & 7));
                this.emitU32(disp);
            }
        }
    }
}

void main() {
    MiniAsm a = new MiniAsm();
    a.emitU8(0x48);
}
