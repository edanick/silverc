// Unreachable-code analysis (flow analysis unreachable-flag concept):
// statements after `return` / `>>` / `throw` / `break` / `continue` in the
// same block are reported as warnings; valid code with terminal statements
// in legal positions must compile and run cleanly.

void after_return_is_flagged() {
    return;
    printline("never runs");
}

int after_throw_is_flagged() {
    throw "boom";
    return 1;
}

void main() {
    // Legal: terminal statement as the last statement of its block.
    int i = 0;
    while (i < 3) {
        i++;
        if (i == 2) {
            break;
        }
    }

    // Legal: code after a loop that contains a break.
    for (int k = 0; k < 2; k++) {
        if (k == 1) {
            continue;
        }
    }

    // Legal: both branches return, nothing follows inside the if.
    int pick = i > 1 ? 1 : 0;
    if (pick > 0) {
        printline("positive");
        return;
    } else {
        printline("done");
        return;
    }
}
