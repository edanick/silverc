// Loop-scope tracking: break and continue resolve inside every loop form —
// while, C-style for, range for and foreach — including through a switch
// nested in the loop, whose cases never open loop scope. Exit code 0 =
// exact.
void check(bool ok, string label) {
    if (!ok) {
        printline("FAIL " + label);
        exit(1);
    }
}

void main() {
    int total = 0;

    int i = 0;
    while (true) {
        i++;
        if (i > 4) { break; }
        if (i == 2) { continue; }
        total += i;
    }
    check(total == 8, "while-break-continue");

    for (int j = 0; j < 10; j++) {
        if (j % 2 == 0) { continue; }
        if (j > 5) { break; }
        total += j;
    }
    check(total == 17, "cfor-break-continue");

    for (int k as 0 to 9) {
        if (k == 3) { break; }
        total += k;
    }
    check(total == 20, "range-break");

    int[] xs = [5, 10, 15, 20];
    foreach (int x in xs) {
        switch (x) {
            case 10 { continue; }
            case 20 { break; }
            else { total += x; }
        }
    }
    check(total == 40, "foreach-switch");

    printline("loop control ok");
}
