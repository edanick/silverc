// The built-in string prefix/suffix predicates take exactly one argument;
// one-argument calls are the legal shape (a user-declared same-named
// method would be exempt, this file uses only the built-ins).

void main() {
    string s = "hello world";
    printline(s.startsWith("hello"));
    printline(s.endsWith("world"));
    string p = "he";
    printline(s.startsWith(p));
    printline("plain".endsWith("in"));
}
