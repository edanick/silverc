// Small helpers (DOCS/174, DOCS/125, DOCS/210): log setLevel/setFormat/
// trace/debug/info/warn/error/toFile, env get/set/keys, os.osType.
// Exit code 0 = all checks pass.
import * from log;
import * from env;
import * from os;
import * from assert;

void main() {
    assert(true);
    assertEq(3, 3);
    assertNe(3, 4);
    assertEqStr("helper", "helper");
    expect_log_consts();
    log.setLevel(log.WARN);
    log.setFormat("[${level}] ${message}");
    log.trace("trace below warn");
    log.debug("debug below warn");
    log.info("info below warn");
    log.warn("warn at level");
    log.error("error at level");
    log.setLevel(log.TRACE);
    log.info("info at trace");

    string logPath = "output/small_helpers_log.txt";
    log.toFile(logPath);
    log.info("file entry");
    if (!file.exists(logPath)) {
        printline("small helpers: log file missing");
        exit(1);
    }
    file.delete(logPath);

    env.set("SILVER_TEST_KEY", "silver-test-value");
    if (env.get("SILVER_TEST_KEY") != "silver-test-value") {
        printline("small helpers: env roundtrip failed");
        exit(1);
    }
    if (env.get("SILVER_MISSING_KEY_XYZ_123") != "") {
        printline("small helpers: missing env should be empty");
        exit(1);
    }
    string[] keys = env.keys();
    bool found = false;
    for (int i = 0; i < keys.length; i++) {
        if (keys[i] == "SILVER_TEST_KEY") { found = true; }
    }
    if (os.osType() != 0) {
        printline("small helpers: osType should be WINDOWS(0) here");
        exit(1);
    }

    printline("small-helpers-ok");
}

void expect_log_consts() {
    if (log.TRACE != 0 || log.DEBUG != 1 || log.INFO != 2 || log.WARN != 3 || log.ERROR != 4) {
        printline("small helpers: log level constants wrong");
        exit(1);
    }
}
