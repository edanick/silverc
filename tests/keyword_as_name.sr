// A keyword may stand for an ordinary variable name: the DECLARATION and
// the REFERENCE must agree. The self-hosted compiler reads any token's
// text as a name, and Silver's own sources use `found` and `match` as
// variables (`string found = ...`, `bool match = ...`), so a compiler
// that only accepts a plain identifier in expression position breaks
// them. `default` stays reserved and is never read as a name.

void check(bool ok, string label) {
    if (!ok) {
        printline("FAIL " + label);
        exit(1);
    }
}

void main() {
    // `found` - a declaration keyword used as a name.
    string found = "found-value";
    check(found == "found-value", "found reference");

    // `match` - a statement keyword used as a name. The `!match` and
    // `match` reads must not be taken for a match expression.
    bool match = true;
    check(match, "match reference");
    if (!match) {
        printline("FAIL match reference");
        exit(1);
    }

    // `local` - a modifier keyword used as a name.
    string local = "local-value";
    check(local == "local-value", "local reference");

    // A keyword-named variable reads as a call argument and as a
    // receiver.
    printline(found);
    check(found.length() == 11, "found member");

    // Assignment to a keyword-named variable.
    found = "second";
    check(found == "second", "found assign");

    printline("keyword as name ok");
}
