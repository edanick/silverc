// Schema: mixed-case field names, unknown keys ignored, single-line layout.
// All three entries must resolve exactly like their lowercase forms.
import { caseFn } from casemod;
import { unkFn } from unkmod;

int caselessHelper(int x) {
    int a = caseFn(x);
    int b = unkFn(a);
    return a + b;
}
