// Star with a per-OS override: on WINDOWS the `windowsExports` list wins
// (`wonly` granted); on LINUX the present-but-empty `linuxExports` beats the
// shared list, so this star must fail there (negative on LINUX, positive on
// WINDOWS).
import * from ovm;

int overrideStarHelper(int x) {
    return wonly(x);
}
