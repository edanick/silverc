// YAML document (DOCS/68-69): parse/load with top-level keys. Plain
// import only (star imports crash yaml.parse; see the final report).
// All paths target output/. Exit code 0 = all checks pass.
import yaml;

void expect(bool got, string what) {
    if (!got) {
        printline("yaml check failed: " + what);
        exit(1);
    }
}

void main() {
    object yamlData = yaml.parse("name: Alice\n");
    expect(yamlData.name == "Alice", "yaml parse name");
    string yamlPath = "output/yaml_files_tmp.yaml";
    file.writeString(yamlPath, "name: Alice\n");
    object yamlHolder = {};
    yaml.load(yamlPath, yamlHolder);
    file.delete(yamlPath);

    printline("yaml-files-ok");
}
