// Nullable flow narrowing (condition-flow narrowing concept,
// MEMORY_GUARD check 6): a nullable read is safe only inside branches
// where a null check proved it non-null. Covers both operand orders,
// && / || short-circuit facts, while-loop bodies, ternary branches,
// ?? unwrapping, and re-narrowing after invalidating assignments.

int? src() << null;

int? src_or(int v) << v;

void main() {
    // Reversed operand order: `null != x` narrows the then-branch.
    int? x = src();
    if (null != x) {
        int a = x;
        printline(a);
    }

    // `&&` truth proves both operands' true-facts.
    int? y = src_or(3);
    if (y != null && y > 0) {
        int b = y + 1;
        printline(b);
    }

    // A while condition narrows its body.
    int? z = src();
    while (z != null) {
        int c = z;
        printline(c);
        z = null;
    }

    // Ternary branches narrow like if/else.
    int? w = src();
    int d = w == null ? 0 : w;
    printline(d);

    // `||` falsity proves both operands' false-facts: in the else
    // branch, v cannot be null.
    int? v = src();
    if (v == null || 1 == 2) {
        printline("null or impossible");
    } else {
        int e = v;
        printline(e);
    }

    // `!` negation flips the facts.
    int? n = src();
    if (!(n == null)) {
        int f = n;
        printline(f);
    }

    // Parenthesized conditions narrow through.
    int? p = src_or(9);
    if ((p != null)) {
        int g = p;
        printline(g);
    }

    // ?? unwrapping stays safe.
    int? q = src();
    printline(q ?? 0);
}
