// Progress display fixture (MEMORY.md §3.2, progress audit):
// progressDisplayPath rebuilt every module path with a per-character
// += (quadratic in path length) on every progress line. The fix builds
// each display path with verbatim runs + one join (and returns the
// already-normalized string unchanged when no separator needs
// replacing), so the progress line text is the same chars with linear
// garbage. This program must compile and print exactly
// `progress-display-ok 121`.
import alpha_progress_display_helper;
import beta_progress_display_helper;

void main() {
    int total = alpha_progress_display_helper.alphaValue() + beta_progress_display_helper.betaValue();
    if (total != 121) {
        exit(1);
    }
    printline("progress-display-ok " + (string)total);
}
