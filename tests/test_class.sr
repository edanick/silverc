void main() {
    MiniAsm asm = new MiniAsm();
    asm.emitU8(72);
    printline("asm buf length: " + asm.getLen());
}

class MiniAsm {
    public prop int[] buf;

    construct () {
        this.buf = [];
    }

    public void emitU8(int b) {
        this.buf.add(b & 0xFF);
    }

    public int getLen() {
        return this.buf.length;
    }
}
