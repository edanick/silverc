// INI document (DOCS/186): parse/load with top-level keys. Plain import
// only (see document_files.sr for why no second parse module is imported).
// Nested section reads return null on silverc-rs and are not asserted.
// All paths target output/. Exit code 0 = all checks pass.
import ini;

void expect(bool got, string what) {
    if (!got) {
        printline("ini check failed: " + what);
        exit(1);
    }
}

void main() {
    object iniData = ini.parse("owner = sam\n");
    expect(iniData.owner == "sam", "ini parse owner");
    string iniPath = "output/ini_files_tmp.ini";
    file.writeString(iniPath, "owner = sam\n");
    object iniBack = ini.load(iniPath);
    expect(iniBack.owner == "sam", "ini load owner");
    file.delete(iniPath);

    printline("ini-files-ok");
}
