// Headers (DOCS/197): header record, multimap get/getAll/has/set/add/
// remove/serialize, and parse. Exit code 0 = all checks pass.
import * from headers;

void expect(bool got, string what) {
    if (!got) {
        printline("headers check failed: " + what);
        exit(1);
    }
}

void main() {
    headers.header record = new headers.header("X-Name", "value");
    expect(record.name == "X-Name", "header name field");
    expect(record.value == "value", "header value field");

    headers.multimap map = new headers.multimap();
    map.set("Content-Type", "text/plain");
    expect(map.get("Content-Type") == "text/plain", "get exact");
    expect(map.get("content-type") == "text/plain", "get case-insensitive");
    expect(map.has("Content-Type"), "has present");
    expect(!map.has("X-Missing"), "has missing");
    expect(map.get("X-Missing") == "", "get missing is empty");

    map.add("X-Multi", "one");
    map.add("X-Multi", "two");
    string[] all = map.getAll("X-Multi");
    expect(all.length == 2, "getAll length");
    expect(all[0] == "one" && all[1] == "two", "getAll order");
    expect(map.get("X-Multi") == "one", "get returns first");

    map.set("X-Multi", "only");
    string[] single = map.getAll("X-Multi");
    expect(single.length == 1 && single[0] == "only", "set discards prior");
    map.remove("X-Multi");
    expect(!map.has("X-Multi"), "remove clears");
    expect(map.getAll("X-Multi") == null, "getAll absent is null");

    headers.multimap wire = headers.parse("Content-Type: text/html\r\nX-Count: 3");
    expect(wire.get("Content-Type") == "text/html", "parse content type");
    expect(wire.get("x-count") == "3", "parse lower lookup");

    headers.multimap ordered = new headers.multimap();
    ordered.add("x-a", "1");
    ordered.add("x-b", "2");
    string wireOut = ordered.serialize();
    expect(wireOut == "X-a: 1\r\nX-b: 2\r\n", "serialize format");

    printline("headers-parsing-ok");
}
