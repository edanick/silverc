// Many-calls fixture (C5 / MEMORY.md row 12, INV-19): hundreds of INLINE
// free-call sites against the fixed export tables. Each site resolves
// through the parser's per-OS resolvers and the mini_cg backends' call
// resolvers; with the parse-once caches every lookup is a slice-free
// `.contains` test, whereas the pre-fix `tableHas` sliced the whole table
// per call node. This program must compile with NO unknown-method
// diagnostics and print `many-calls-fast-ok <total>` (total is
// deterministic: native results are only tested, never accumulated).

#on WINDOWS
import * from win32.kernel32;
#on LINUX
import * from linux.libc;
#on MAC
import * from mac.libsystem;
#off

int add(int a, int b) {
    return a + b;
}

