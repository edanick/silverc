// Enum exhaustiveness (coverage check): a switch/match over an
// enum that covers every variant (or carries a wildcard/default) is
// exhaustive. Exit code 0 = exact; the compiler must stay silent for
// these fully-covered forms.

enum direction {
    North,
    South,
    East,
    West
}

string name_of(direction d) {
    // Full dotted coverage: exhaustive, no wildcard needed.
    return match d {
        direction.North => "n";
        direction.South => "s";
        direction.East => "e";
        direction.West => "w";
    };
}

string name_wild(direction d) {
    // Wildcard arm: exhaustive by Silver's match semantics.
    return match d {
        direction.North => "n";
        _ => "other";
    };
}

void main() {
    direction d = direction.North;
    printline(name_of(d));
    printline(name_wild(direction.West));

    // switch with else/default covering the rest.
    switch (d) {
        case direction.North {
            printline("north");
        }
        else {
            printline("not north");
        }
    }

    // switch with full dotted coverage and no default.
    switch (d) {
        case direction.North { printline("n1"); }
        case direction.South { printline("n2"); }
        case direction.East { printline("n3"); }
        case direction.West { printline("n4"); }
    }

    printline("enum exhaustiveness ok");
}
