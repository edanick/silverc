class Counter {
    private prop int count;
    construct () {
        this.count = 0;
    }
    void increment() {
        this.count = this.count + 1;
    }
    int getCount() {
        return this.count;
    }
}
void main() {
    Counter c = new Counter();
    c.increment();
    c.increment();
    c.increment();
    printline("count=" + c.getCount());
}
