// UUID (DOCS/179): generate, v4, v7, parse, nil, fromBytes, toBytes,
// isValid. isValid is called bare (import {isValid}) because qualified
// uuid.isValid access-violates on the self-hosted compiler (documented in
// std/uuid.sr). Exit code 0 = all checks pass.
import {isValid} from uuid;
import * from uuid;

void expect(bool got, string what) {
    if (!got) {
        printline("uuid check failed: " + what);
        exit(1);
    }
}

void main() {
    string generated = uuid.generate();
    expect(generated.length == 36, "generate length");
    expect(generated[8] == '-' && generated[13] == '-', "generate dashes");
    expect(isValid(generated), "generate is valid");

    string v4Value = uuid.v4();
    expect(v4Value.length == 36, "v4 length");
    expect(isValid(v4Value), "v4 is valid");
    expect(v4Value[14] == '4', "v4 version nibble");

    string v7Value = uuid.v7();
    expect(v7Value.length == 36, "v7 length");
    expect(isValid(v7Value), "v7 is valid");

    expect(isValid("636ad8aa-d5f9-409e-9a41-9bf589ee9c63"), "isValid accepts canonical");
    expect(!isValid("not-a-uuid"), "isValid rejects short");
    expect(!isValid("636ad8aa-d5f9-409e-9a41-9bf589ee9c6g"), "isValid rejects non-hex");
    expect(!isValid(""), "isValid rejects empty");

    uuid.uuid parsed = uuid.parse(generated);
    expect(parsed != null, "parse returns instance");
    uuid.uuid nilValue = uuid.nil();
    expect(nilValue != null, "nil returns instance");

    byte[] sixteen = new byte[16];
    for (int i = 0; i < 16; i++) { sixteen[i] = i; }
    uuid.uuid fromBytes = uuid.fromBytes(sixteen);
    expect(fromBytes != null, "fromBytes returns instance");

    uuid.uuid readable = new uuid();
    byte[] bytes = readable.toBytes();
    expect(bytes.length == 16, "toBytes length");

    expect(generated != v4Value, "uuids are random");
    expect(isValid(generated) && isValid(v4Value), "both generated valid");

    printline("uuid-values-ok");
}
