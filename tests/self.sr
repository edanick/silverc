mod export compiler;

import * from fs;

void main() {
    string inputFile = "C:/Users/haya_/OneDrive/Desktop/Code/rust/silver/tests/cd.sr";
    string outputFile = "C:/Users/haya_/OneDrive/Desktop/Code/rust/silver/silverc-debug/tests/test_compiler3.exe";
    string source = file.readString(inputFile);
    printline("read");

    Lexer lexer;
    lexer = new Lexer(source);

    Token[] tokens;
    tokens = lexer.tokenize();

    Parser parser;
    parser = new Parser(tokens);

    Node[] ast;
    ast = parser.parseProgram();

    MiniAsm asm;
    asm = new MiniAsm();

    MiniCg cg;
    cg = new MiniCg(asm);

    cg.genProgram(ast);
    file.writeBytes("C:/Users/haya_/OneDrive/Desktop/Code/rust/silver/silverc-debug/tests/dbg_after_gen.txt", [89, 10]);

    cg.getStringData();

    MiniPe pe;
    pe = new MiniPe();

    int[] codeBytes = asm.getBytes();
    pe.code = codeBytes;
    pe.entryRva = 0x1000 + cg.mainLabelOffset;

    for (int i = 0; i < cg.importDlls.length; i++) {
        pe.addImport(cg.importDlls[i], cg.importFuncs[i]);
    }

    int[] stringData = cg.stringData;

    int rdataRva = pe.computeRdataRva();
    int[] layout = pe.computeLayout(stringData.length);
    int stringsStart = layout[0];
    int[] iatAddrs = cg.computeIatAddresses(layout);
    file.writeBytes("C:/Users/haya_/OneDrive/Desktop/Code/rust/silver/silverc-debug/tests/dbg_after_iat.txt", [90, 10]);

    int[] finalCode = asm.getBytes();
    pe.code = finalCode;

    cg.patchStringRefs(finalCode, stringsStart, rdataRva);
    cg.patchImportRefs(finalCode, iatAddrs, rdataRva);

    int[] peData = pe.build(finalCode, stringData);
    file.writeBytes(outputFile, peData);
    file.writeBytes("C:/Users/haya_/OneDrive/Desktop/Code/rust/silver/silverc-debug/tests/dbg_wrote.txt", [87, 10]);
}

class MiniAsm {
    public prop int[] buf;
    public prop int[] labelPositions;
    public prop int[] relocLabelIds;
    public prop int[] relocOffsets;
    public prop int[] relocIs32;
    public prop int resolved;

    construct () {
        this.buf = [];
        this.labelPositions = [];
        this.relocLabelIds = [];
        this.relocOffsets = [];
        this.relocIs32 = [];
        this.resolved = 0;
    }

    public void emitU8(int b) {
        this.buf.add(b & 0xFF);
    }

    public void emitU16(int v) {
        this.emitU8(v);
        this.emitU8(v >> 8);
    }

    public void emitU32(int v) {
        this.emitU8(v);
        this.emitU8(v >> 8);
        this.emitU8(v >> 16);
        this.emitU8(v >> 24);
    }

    public void emitU64(int64 v) {
        this.emitU32(v & 0xFFFFFFFF);
        this.emitU32((v >> 32) & 0xFFFFFFFF);
    }

    public int[] getBytes() {
        this.resolveRelocs();
        return this.buf;
    }

    public void emitImm64(int reg, int64 imm) {
        this.buf.add(0x48);
        this.buf.add(0xB8 + (reg & 7));
        for (int b = 0; b < 8; b++) {
            this.buf.add((imm >> (b * 8)) & 0xFF);
        }
    }

    public void pushR64(int r) {
        int opcode = 0x50 + (r & 7);
        if (r > 7) { this.emitU8(0x41); }
        this.emitU8(opcode);
    }

    public void popR64(int r) {
        if (r > 7) { this.emitU8(0x41); }
        this.emitU8(0x58 + (r & 7));
    }

    public void movRR64(int dst, int src) {
        int rFlag = dst > 7 ? 1 : 0;
        int sFlag = src > 7 ? 1 : 0;
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x89);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void movRI64(int dst, int64 imm) {
        int dFlag = dst > 7 ? 1 : 0;
        this.emitU8(0x48 | dFlag);
        this.emitU8(0xB8 + (dst & 7));
        int lo = imm & 0xFFFFFFFF;
        this.emitU8(lo);
        this.emitU8(lo >> 8);
        this.emitU8(lo >> 16);
        this.emitU8(lo >> 24);
        int hi = (imm >> 32) & 0xFFFFFFFF;
        this.emitU8(hi);
        this.emitU8(hi >> 8);
        this.emitU8(hi >> 16);
        this.emitU8(hi >> 24);
    }

    public void movRMBase(int r, int base, int disp) {
        int rex = 0x48;
        if (r > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x8B);
        if (base == 5 || base == 13) {
            this.emitU8(0x85 | ((r & 7) << 3) | (base & 7));
            this.emitU32(disp);
        } elif (base == 4 || base == 12) {
            this.emitU8(((r & 7) << 3) | 0x04);
            this.emitU8(0x24);
            if (disp != 0) {
                this.emitU32(disp);
            }
        } else {
            if (disp == 0 && base != 5 && base != 13) {
                this.emitU8(((r & 7) << 3) | (base & 7));
            } elif (disp >= -128 && disp <= 127) {
                this.emitU8(0x40 | ((r & 7) << 3) | (base & 7));
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x80 | ((r & 7) << 3) | (base & 7));
                this.emitU32(disp);
            }
        }
    }

    public void movMBaseR(int base, int r, int disp) {
        int rex = 0x48;
        if (r > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x89);
        if (base == 5 || base == 13) {
            this.emitU8(0x85 | ((r & 7) << 3) | (base & 7));
            this.emitU32(disp);
        } elif (base == 4 || base == 12) {
            this.emitU8(((r & 7) << 3) | 0x04);
            this.emitU8(0x24);
            if (disp != 0) {
                this.emitU32(disp);
            }
        } else {
            if (disp == 0 && base != 5 && base != 13) {
                this.emitU8(((r & 7) << 3) | (base & 7));
            } elif (disp >= -128 && disp <= 127) {
                this.emitU8(0x40 | ((r & 7) << 3) | (base & 7));
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x80 | ((r & 7) << 3) | (base & 7));
                this.emitU32(disp);
            }
        }
    }

    public void subRI32(int r, int imm) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        if (imm >= -128 && imm <= 127) {
            this.emitU8(0x83);
            this.emitU8(0xE8 | (r & 7));
            this.emitU8(imm & 0xFF);
        } else {
            this.emitU8(0x81);
            this.emitU8(0xE8 | (r & 7));
            this.emitU32(imm);
        }
    }

    public void addRI32(int r, int imm) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        if (imm >= -128 && imm <= 127) {
            this.emitU8(0x83);
            this.emitU8(0xC0 | (r & 7));
            this.emitU8(imm & 0xFF);
        } else {
            this.emitU8(0x81);
            this.emitU8(0xC0 | (r & 7));
            this.emitU32(imm);
        }
    }

    public void xorRR64(int dst, int src) {
        int rFlag = dst > 7 ? 1 : 0;
        int sFlag = src > 7 ? 1 : 0;
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x31);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void cmpRI32(int r, int imm) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        if (imm >= -128 && imm <= 127) {
            this.emitU8(0x83);
            this.emitU8(0xF8 | (r & 7));
            this.emitU8(imm & 0xFF);
        } else {
            this.emitU8(0x81);
            this.emitU8(0xF8 | (r & 7));
            this.emitU32(imm);
        }
    }

    public void cmpRR64(int r1, int r2) {
        int rex = 0x48;
        if (r2 > 7) { rex = rex + 4; }
        if (r1 > 7) { rex = rex + 1; }
        this.emitU8(rex);
        this.emitU8(0x39);
        this.emitU8(0xC0 | ((r2 & 7) << 3) | (r1 & 7));
    }

    public void ret() {
        this.emitU8(0xC3);
    }

    public void callR64(int r) {
        if (r > 7) { this.emitU8(0x41); }
        this.emitU8(0xFF);
        this.emitU8(0xD0 | (r & 7));
    }

    public void leaRBase(int dst, int base, int disp) {
        int rex = 0x48;
        if (dst > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x8D);
        if (base == 4 || base == 12) {
            this.emitU8(0x80 | ((dst & 7) << 3) | 0x04);
            this.emitU8(0x24);
            this.emitU32(disp);
        } elif (base == 5 || base == 13) {
            this.emitU8(0x85 | ((dst & 7) << 3) | (base & 7));
            this.emitU32(disp);
        } else {
            if (disp == 0) {
                this.emitU8(((dst & 7) << 3) | (base & 7));
            } elif (disp >= -128 && disp <= 127) {
                this.emitU8(0x40 | ((dst & 7) << 3) | (base & 7));
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x80 | ((dst & 7) << 3) | (base & 7));
                this.emitU32(disp);
            }
        }
    }

    public void addRR64(int dst, int src) {
        int rFlag = dst > 7 ? 1 : 0;
        int sFlag = src > 7 ? 1 : 0;
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x01);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void shlR64Imm(int reg, int imm) {
        int rFlag = reg > 7 ? 1 : 0;
        this.emitU8(0x48 | (rFlag << 2));
        this.emitU8(0xC1);
        this.emitU8(0xE0 | (reg & 7));
        this.emitU8(imm & 0xFF);
    }

    public void subRR64(int dst, int src) {
        int rFlag = dst > 7 ? 1 : 0;
        int sFlag = src > 7 ? 1 : 0;
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x29);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void mulRR64(int src) {
        int sFlag = src > 7 ? 1 : 0;
        if (sFlag != 0) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        this.emitU8(0xF7);
        this.emitU8(0xE0 | (src & 7));
    }

    public void label(string name) {
    }

    public int createLabel() {
        int id = this.labelPositions.length;
        this.labelPositions.add(-1);
        return id;
    }

    public void bindLabel(int id) {
        this.labelPositions[id] = this.buf.length;
    }

    public void addReloc(int labelId, int offset, int is32) {
        this.relocLabelIds.add(labelId);
        this.relocOffsets.add(offset);
        this.relocIs32.add(is32);
    }

    public void jeLabel(int id) {
        this.emitU8(0x0F);
        this.emitU8(0x84);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void jneLabel(int id) {
        this.emitU8(0x0F);
        this.emitU8(0x85);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void jmpLabel(int id) {
        this.emitU8(0xE9);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void jlLabel(int id) {
        this.emitU8(0x0F);
        this.emitU8(0x8C);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void jleLabel(int id) {
        this.emitU8(0x0F);
        this.emitU8(0x8E);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void jgLabel(int id) {
        this.emitU8(0x0F);
        this.emitU8(0x8F);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void jgeLabel(int id) {
        this.emitU8(0x0F);
        this.emitU8(0x8D);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void resolveRelocs() {
        if (this.resolved == 1) { return; }
        this.resolved = 1;
        for (int i = 0; i < this.relocLabelIds.length; i++) {
            int labelId = this.relocLabelIds[i];
            int offset = this.relocOffsets[i];
            int is32 = this.relocIs32[i];
            int target = this.labelPositions[labelId];
            if (is32 == 1) {
                int cur = offset + 4;
                int disp = target - cur;
                this.buf[offset] = disp & 0xFF;
                this.buf[offset + 1] = (disp >> 8) & 0xFF;
                this.buf[offset + 2] = (disp >> 16) & 0xFF;
                this.buf[offset + 3] = (disp >> 24) & 0xFF;
            } else {
                int cur = offset + 1;
                int disp = target - cur;
                this.buf[offset] = disp & 0xFF;
            }
        }
    }

    public void callRel32(int rel32) {
        this.emitU8(0xE8);
        this.emitU32(rel32);
    }
}

class StrEntry {
    public prop string text;
    public prop int dataOffset;

    construct (string text) {
        this.text = text;
        this.dataOffset = 0;
    }
}

class MiniCg {
    public prop MiniAsm asm;
    public prop StrEntry[] strings;
    public prop int[] stringData;
    public prop int mainLabelOffset;
    public prop string[] funcNames;
    public prop int[] funcOffsets;
    public prop int[] localOffsets;
    public prop string[] localNames;
    public prop int stackSize;
    public prop int[] stringPatchOffsets;
    public prop int[] stringPatchIndices;
    public prop int[] importPatchOffsets;
    public prop int[] importPatchDllIndices;
    public prop int[] importPatchFuncIndices;
    public prop string[] importDlls;
    public prop string[] importFuncs;
    public prop int[] loopStartStack;
    public prop int[] loopEndStack;
    public prop int labelCounter;
    public prop int[] stringOffsets;
    public prop string[] funcCallArgTemps;
    public prop int funcCallArgCount;
    public prop int retValOff;
    public prop string[] classNames;
    public prop int[] classFieldStarts;
    public prop int[] classFieldCounts;
    public prop string[] classFieldNames;
    public prop int[] classFieldOffsets;
    public prop string[] classFieldTypes;
    public prop string[] methodClassNames;
    public prop string[] methodNames;
    public prop string currentClassName;
    public prop string[] localTypes;

    construct (MiniAsm asm) {
        this.asm = asm;
        this.strings = [];
        this.stringData = [];
        this.mainLabelOffset = 0;
        this.funcNames = [];
        this.funcOffsets = [];
        this.localOffsets = [];
        this.localNames = [];
        this.stackSize = 0;
        this.stringPatchOffsets = [];
        this.stringPatchIndices = [];
        this.importPatchOffsets = [];
        this.importPatchDllIndices = [];
        this.importPatchFuncIndices = [];
        this.importDlls = [];
        this.importFuncs = [];
        this.loopStartStack = [];
        this.loopEndStack = [];
        this.labelCounter = 0;
        this.stringOffsets = [];
        this.funcCallArgTemps = [];
        this.funcCallArgCount = 0;
        this.retValOff = 0;
        this.classNames = [];
        this.classFieldStarts = [];
        this.classFieldCounts = [];
        this.classFieldNames = [];
        this.classFieldOffsets = [];
        this.classFieldTypes = [];
        this.methodClassNames = [];
        this.methodNames = [];
        this.currentClassName = "";
        this.localTypes = [];
    }

    public void collectClassLayouts(Node[] program) {
        for (int i = 0; i < program.length; i++) {
            Node item = program[i];
            if (item.kind == 102) {
                this.classNames.add(item.name);
                int start = this.classFieldNames.length;
                this.classFieldStarts.add(start);
                int cnt = 0;
                for (int j = 0; j < item.childCount(); j++) {
                    Node member = item.child(j);
                    if (member.kind == 50) {
                        this.classFieldNames.add(member.name);
                        this.classFieldOffsets.add(cnt * 8);
                        this.classFieldTypes.add(member.typeHint);
                        cnt = cnt + 1;
                    }
                }
                this.classFieldCounts.add(cnt);
                for (int j = 0; j < item.childCount(); j++) {
                    Node member = item.child(j);
                    if (member.kind == 100) {
                        this.methodNames.add(member.name);
                        this.methodClassNames.add(item.name);
                    }
                }
            }
        }
    }

    public int findFieldOffset(string className, string fieldName) {
        int start = -1;
        int cnt = 0;
        for (int i = 0; i < this.classNames.length; i++) {
            if (this.strEq(this.classNames[i], className)) {
                start = this.classFieldStarts[i];
                cnt = this.classFieldCounts[i];
            }
        }
        if (start < 0) { return -1; }
        for (int i = 0; i < cnt; i++) {
            if (this.strEq(this.classFieldNames[start + i], fieldName)) {
                return this.classFieldOffsets[start + i];
            }
        }
        return -1;
    }

    public string findFieldType(string className, string fieldName) {
        int start = -1;
        int cnt = 0;
        for (int i = 0; i < this.classNames.length; i++) {
            if (this.strEq(this.classNames[i], className)) {
                start = this.classFieldStarts[i];
                cnt = this.classFieldCounts[i];
            }
        }
        if (start < 0) { return ""; }
        for (int i = 0; i < cnt; i++) {
            if (this.strEq(this.classFieldNames[start + i], fieldName)) {
                return this.classFieldTypes[start + i];
            }
        }
        return "";
    }

    public string getLocalType(string name) {
        for (int i = 0; i < this.localNames.length; i++) {
            if (this.strEq(this.localNames[i], name)) {
                if (i < this.localTypes.length) {
                    return this.localTypes[i];
                }
                return "";
            }
        }
        return "";
    }

    public void setLocalType(string name, string typeName) {
        for (int i = 0; i < this.localNames.length; i++) {
            if (this.strEq(this.localNames[i], name)) {
                while (this.localTypes.length <= i) {
                    this.localTypes.add("");
                }
                this.localTypes[i] = typeName;
                return;
            }
        }
    }

    public string arrayElementType(string arrType) {
        if (arrType.length >= 2) {
            int len = arrType.length;
            string result = "";
            int i = 0;
            while (i + 1 < len) {
                if (arrType[i] == '[' && arrType[i+1] == ']') {
                    return result;
                }
                result = result + arrType[i];
                i = i + 1;
            }
            return result;
        }
        return "";
    }

    public int newLabel() {
        return this.asm.createLabel();
    }

    public int addString(string s) {
        for (int i = 0; i < this.strings.length; i++) {
            if (this.strEq(this.strings[i].text, s)) {
                return i;
            }
        }
        int off = this.stringData.length;
        for (int i = 0; i < s.length; i++) {
            int ch = s[i];
            this.stringData.add(ch);
        }
        this.stringData.add(0);
        StrEntry e;
        e = new StrEntry(s);
        e.dataOffset = off;
        this.strings.add(e);
        return this.strings.length - 1;
    }

    public int[] getStringData() {
        return this.stringData;
    }

    public int findImport(string dll, string name) {
        for (int i = 0; i < this.importDlls.length; i++) {
            if (this.strEq(this.importDlls[i], dll) && this.strEq(this.importFuncs[i], name)) {
                return i;
            }
        }
        this.importDlls.add(dll);
        this.importFuncs.add(name);
        return this.importDlls.length - 1;
    }

    public int addImportPatch(string dll, string name) {
        int idx = this.findImport(dll, name);
        this.importPatchOffsets.add(this.asm.buf.length + 2);
        this.importPatchDllIndices.add(-1);
        this.importPatchFuncIndices.add(idx);
        return idx;
    }

    public bool strEq(string a, string b) {
        if (a.length != b.length) { return false; }
        for (int i = 0; i < a.length; i++) {
            if (a[i] != b[i]) { return false; }
        }
        return true;
    }

    public int findLocal(string name) {
        for (int i = 0; i < this.localNames.length; i++) {
            if (this.strEq(this.localNames[i], name)) {
                return this.localOffsets[i];
            }
        }
        return 0;
    }

    public int allocLocal(string name) {
        this.stackSize += 8;
        int off = -8 * (this.localOffsets.length + 1);
        this.localOffsets.add(off);
        this.localNames.add(name);
        return off;
    }

    public void emitPrologue() {
        this.asm.pushR64(5);
        this.asm.movRR64(5, 4);
        this.asm.subRI32(4, 32);
        this.asm.pushR64(15);
        this.asm.pushR64(13);
        this.asm.pushR64(12);
        this.asm.movRR64(15, 4);
    }

    public void emitEpilogue() {
        this.asm.popR64(12);
        this.asm.popR64(13);
        this.asm.popR64(15);
        this.asm.addRI32(4, this.stackSize);
        this.asm.popR64(5);
        this.asm.ret();
    }

    public int[] computeIatAddresses(int[] layout) {
        int stringsStart = layout[0];
        int numGroups = layout[1];
        int iltTotal = layout[2];
        int[] iatAddrs = [];
        for (int i = 0; i < this.importDlls.length; i++) {
            iatAddrs.add(0);
        }
        string[] uniqueDlls = [];
        int[] groupSizes = [];
        int[] importGroupIdx = [];
        for (int i = 0; i < this.importDlls.length; i++) {
            int gIdx = -1;
            for (int j = 0; j < uniqueDlls.length; j++) {
                if (this.strEq(uniqueDlls[j], this.importDlls[i])) {
                    gIdx = j;
                    break;
                }
            }
            if (gIdx < 0) {
                uniqueDlls.add(this.importDlls[i]);
                groupSizes.add(0);
                gIdx = uniqueDlls.length - 1;
            }
            groupSizes[gIdx] = groupSizes[gIdx] + 1;
            importGroupIdx.add(gIdx);
        }
        int[] posInGroup = [];
        for (int i = 0; i < this.importDlls.length; i++) {
            posInGroup.add(0);
        }
        int[] runningCount = [];
        for (int g = 0; g < uniqueDlls.length; g++) {
            runningCount.add(0);
        }
        for (int i = 0; i < this.importDlls.length; i++) {
            int g = importGroupIdx[i];
            posInGroup[i] = runningCount[g];
            runningCount[g] = runningCount[g] + 1;
        }
        int[] groupStart = [];
        int runningOff = 0;
        for (int g = 0; g < uniqueDlls.length; g++) {
            groupStart.add(runningOff);
            runningOff = runningOff + groupSizes[g] * 8 + 8;
        }
        int descBytes = (numGroups + 1) * 20;
        for (int i = 0; i < this.importDlls.length; i++) {
            int g = importGroupIdx[i];
            iatAddrs[i] = descBytes + iltTotal + groupStart[g] + posInGroup[i] * 8;
        }
        return iatAddrs;
    }

    public void patchImportRefs(int[] code, int[] iatAddrs, int rdataRva) {
        for (int i = 0; i < this.importPatchOffsets.length; i++) {
            int patchPos = this.importPatchOffsets[i];
            int funcIdx = this.importPatchFuncIndices[i];
            int iatOff = iatAddrs[funcIdx];
            int64 addr = 0x140000000 + rdataRva + iatOff;
            code[patchPos] = addr & 0xFF;
            code[patchPos + 1] = (addr >> 8) & 0xFF;
            code[patchPos + 2] = (addr >> 16) & 0xFF;
            code[patchPos + 3] = (addr >> 24) & 0xFF;
            code[patchPos + 4] = (addr >> 32) & 0xFF;
            code[patchPos + 5] = (addr >> 40) & 0xFF;
            code[patchPos + 6] = (addr >> 48) & 0xFF;
            code[patchPos + 7] = (addr >> 56) & 0xFF;
        }
    }

    public void patchStringRefs(int[] code, int stringsStart, int rdataRva) {
        for (int i = 0; i < this.stringPatchOffsets.length; i++) {
            int patchPos = this.stringPatchOffsets[i];
            int strIdx = this.stringPatchIndices[i];
            int dataOff = this.strings[strIdx].dataOffset;
            int64 addr = 0x140000000 + rdataRva + stringsStart + dataOff;
            code[patchPos] = addr & 0xFF;
            code[patchPos + 1] = (addr >> 8) & 0xFF;
            code[patchPos + 2] = (addr >> 16) & 0xFF;
            code[patchPos + 3] = (addr >> 24) & 0xFF;
            code[patchPos + 4] = (addr >> 32) & 0xFF;
            code[patchPos + 5] = (addr >> 40) & 0xFF;
            code[patchPos + 6] = (addr >> 48) & 0xFF;
            code[patchPos + 7] = (addr >> 56) & 0xFF;
        }
    }

