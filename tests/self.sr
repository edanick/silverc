    public void emitFunction(Node func) {
        if (func.name == "main") {
            this.mainLabelOffset = this.asm.buf.length;
        }
        this.funcNames.add(func.name);
        this.funcOffsets.add(this.asm.buf.length);
        this.localOffsets = [];
        this.localNames = [];
        this.stackSize = 0;
        string savedClass = this.currentClassName;
        this.currentClassName = "";
        this.asm.label(func.name);
        this.asm.pushR64(5);
        this.asm.movRR64(5, 4);
        int isMethod = 0;
        for (int i = 0; i < this.methodNames.length; i++) {
            if (this.strEq(this.methodNames[i], func.name)) {
                this.currentClassName = this.methodClassNames[i];
                isMethod = 1;
            }
        }
        if (isMethod == 1) {
            this.allocLocal("this");
        }
        if (func.childCount() > 1) {
            Node body = func.child(1);
            this.allocLocals(body);
            if (this.stackSize > 0) {
                this.asm.subRI32(4, this.stackSize);
            }
            if (isMethod == 1) {
                int thisOff = this.findLocal("this");
                this.asm.movMBaseR(5, 1, thisOff);
            }
            if (body.kind == 16) {
                this.genBlock(body);
            } elif (body.kind == 61) {
                this.genStmt(body);
            }
        } else {
            if (this.stackSize > 0) {
                this.asm.subRI32(4, this.stackSize);
            }
            if (isMethod == 1) {
                int thisOff = this.findLocal("this");
                this.asm.movMBaseR(5, 1, thisOff);
            }
        }
        if (this.stackSize > 0) {
            this.asm.addRI32(4, this.stackSize);
        }
        this.asm.popR64(5);
        this.asm.ret();
        this.currentClassName = savedClass;
    }

    public void allocLocals(Node node) {
    if (node.kind == 50) {
        this.allocLocal(node.name);
        while (this.localTypes.length < this.localNames.length) {
            this.localTypes.add("");
        }
            if (this.localTypes.length > 0) {
                this.localTypes[this.localTypes.length - 1] = node.typeHint;
            }
        }
        for (int i = 0; i < node.childCount(); i++) {
            this.allocLocals(node.child(i));
        }
    }

    public void genBlock(Node block) {
        for (int i = 0; i < block.childCount(); i++) {
            this.genStmt(block.child(i));
        }
    }

    public void genProgram2(Node[] program) {
        for (int i = 0; i < program.length; i++) {
            Node item = program[i];
            if (item.kind == 100) {
                this.emitFunction(item);
            }
        }
    }

    public void genStmt(Node stmt) {
        if (stmt.kind == 61) {
            if (stmt.childCount() > 0) {
                this.genExpr(stmt.child(0));
            }
    } elif (stmt.kind == 50) {
        int off = this.findLocal(stmt.name);
        if (stmt.childCount() > 0) {
            this.genExpr(stmt.child(0));
            if (off != 0) {
                this.asm.movMBaseR(5, 0, off);
            }
        }
    } elif (stmt.kind == 51) {
            if (stmt.childCount() > 0) {
                this.genExpr(stmt.child(0));
            }
        } elif (stmt.kind == 16) {
            this.genBlock(stmt);
    } elif (stmt.kind == 53) {
        int elseLbl = this.newLabel();
        int endLbl = this.newLabel();
        this.genExpr(stmt.child(0));
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(elseLbl);
        if (stmt.childCount() > 1) {
            Node body = stmt.child(1);
            if (body.kind == 16) {
                this.genBlock(body);
            } elif (body.kind == 61) {
                this.genStmt(body);
            } elif (body.kind == 53) {
                this.genStmt(body);
            }
        }
        this.asm.jmpLabel(endLbl);
        this.asm.bindLabel(elseLbl);
        if (stmt.childCount() > 2) {
            Node elseBody = stmt.child(2);
            if (elseBody.kind == 16) {
                this.genBlock(elseBody);
            } elif (elseBody.kind == 61) {
                this.genStmt(elseBody);
            } elif (elseBody.kind == 53) {
                this.genStmt(elseBody);
            }
        }
        this.asm.bindLabel(endLbl);
        } elif (stmt.kind == 54) {
            int startLbl = this.newLabel();
            int endLbl = this.newLabel();
            this.loopStartStack.add(startLbl);
            this.loopEndStack.add(endLbl);
            this.asm.bindLabel(startLbl);
            if (stmt.childCount() > 0) {
                this.genExpr(stmt.child(0));
            }
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(endLbl);
            if (stmt.childCount() > 1) {
                Node body = stmt.child(1);
                if (body.kind == 16) {
                    this.genBlock(body);
                } elif (body.kind == 61) {
                    this.genStmt(body);
                }
            }
            this.asm.jmpLabel(startLbl);
            this.asm.bindLabel(endLbl);
            this.loopStartStack = [];
            this.loopEndStack = [];
        } elif (stmt.kind == 55) {
            int startLbl = this.newLabel();
            int endLbl = this.newLabel();
            this.loopStartStack.add(startLbl);
            this.loopEndStack.add(endLbl);
            this.asm.bindLabel(startLbl);
            if (stmt.childCount() > 2) {
                Node body = stmt.child(2);
                if (body.kind == 16) {
                    this.genBlock(body);
                }
            }
            this.asm.bindLabel(endLbl);
            this.loopStartStack = [];
            this.loopEndStack = [];
        } elif (stmt.kind == 62) {
            if (this.loopEndStack.length > 0) {
                int endLbl = this.loopEndStack[this.loopEndStack.length - 1];
                this.asm.jmpLabel(endLbl);
            }
        } elif (stmt.kind == 63) {
            if (this.loopStartStack.length > 0) {
                int startLbl = this.loopStartStack[this.loopStartStack.length - 1];
                this.asm.jmpLabel(startLbl);
            }
        } elif (stmt.kind == 64) {
            int startLbl = this.newLabel();
            int endLbl = this.newLabel();
            this.loopStartStack.add(startLbl);
            this.loopEndStack.add(endLbl);
            if (stmt.childCount() > 1) {
                this.genExpr(stmt.child(1));
            }
            int iOff = this.findLocal(stmt.child(0).name);
            this.asm.movRI64(0, 0);
            this.asm.movMBaseR(5, 0, iOff);
            this.asm.bindLabel(startLbl);
            this.asm.movRMBase(0, 5, iOff);
            if (stmt.childCount() > 1) {
                int arrOff = this.findLocal("__foreach_arr");
                this.asm.movRMBase(0, 5, iOff);
                this.asm.movRMBase(1, 0, 8);
                this.asm.cmpRR64(0, 1);
                this.asm.jgeLabel(endLbl);
            }
            if (stmt.childCount() > 2) {
                Node body = stmt.child(2);
                if (body.kind == 16) {
                    this.genBlock(body);
                } elif (body.kind == 61) {
                    this.genStmt(body);
                }
            }
            this.asm.movRMBase(0, 5, iOff);
            this.asm.addRI32(0, 1);
            this.asm.movMBaseR(5, 0, iOff);
            this.asm.jmpLabel(startLbl);
            this.asm.bindLabel(endLbl);
            this.loopStartStack = [];
            this.loopEndStack = [];
        }
    }

    public void genExpr(Node expr) {
        int kind = expr.kind;
        if (kind == 0) {
            this.asm.emitImm64(0, expr.intVal);
        } elif (kind == 2) {
            int strIdx = this.addString(expr.strVal);
            int sp = this.asm.buf.length;
            this.asm.emitImm64(0, 0);
            int strPatchPos = sp + 2;
            this.stringPatchOffsets.add(strPatchPos);
            this.stringPatchIndices.add(strIdx);
        } elif (kind == 3) {
            this.asm.emitImm64(0, expr.charVal);
        } elif (kind == 4) {
            if (expr.boolVal) { this.asm.emitImm64(0, 1); } else { this.asm.emitImm64(0, 0); }
        } elif (kind == 5) {
            this.asm.xorRR64(0, 0);
        }
    elif (kind == 6) {
        int off = this.findLocal(expr.name);
        this.asm.movRMBase(0, 5, off);
        } elif (kind == 9 || kind == 10) {
            this.genCall(expr);
        } elif (kind == 23) {
            if (expr.childCount() > 0) {
                this.genExpr(expr.child(0));
            }
        } elif (kind == 7) {
            this.genBinary(expr);
        } elif (kind == 24) {
            this.genArrayIndex(expr);
        } elif (kind == 13) {
            this.genMemberAccess(expr);
        } elif (kind == 65) {
            int elseLbl = this.newLabel();
            int endLbl = this.newLabel();
            this.genExpr(expr.child(0));
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(elseLbl);
            this.genExpr(expr.child(1));
            this.asm.jmpLabel(endLbl);
            this.asm.bindLabel(elseLbl);
            this.genExpr(expr.child(2));
            this.asm.bindLabel(endLbl);
        }
    }

    public void genMemberAccess(Node expr) {
        Node obj = expr.child(0);
        string fieldName = expr.name;
        if (obj.kind == 6 && obj.name == "this") {
            int thisOff = this.findLocal("this");
            int fieldOff = this.findFieldOffset(this.currentClassName, fieldName);
            if (fieldOff < 0) { return; }
            this.asm.movRMBase(0, 5, thisOff);
            this.asm.movRMBase(0, 0, fieldOff);
            return;
        }
        if (obj.kind == 6 && obj.name == "this" && this.currentClassName != "") {
            int thisOff = this.findLocal("this");
            int fieldOff = this.findFieldOffset(this.currentClassName, fieldName);
            if (fieldOff < 0) { return; }
            this.asm.movRMBase(0, 5, thisOff);
            this.asm.movRMBase(0, 0, fieldOff);
            return;
        }
        if (obj.kind == 6) {
            string varType = this.getLocalType(obj.name);
            if (varType != "") {
                this.genExpr(obj);
                string elemType = this.arrayElementType(varType);
                string lookupType = varType;
                if (elemType != "") { lookupType = elemType; }
                int fieldOff = this.findFieldOffset(lookupType, fieldName);
                if (fieldOff >= 0) {
                    this.asm.movRMBase(0, 0, fieldOff);
                }
                return;
            }
        }
        if (obj.kind == 24) {
            Node arrNode = obj.child(0);
            string arrType = this.inferExprType(arrNode);
            this.genArrayIndex(obj);
            string elemType = this.arrayElementType(arrType);
            if (elemType != "") {
                int fieldOff = this.findFieldOffset(elemType, fieldName);
                if (fieldOff >= 0) {
                    this.asm.movRMBase(0, 0, fieldOff);
                }
            }
            return;
        }
        if (obj.kind == 13) {
            this.genMemberAccess(obj);
            string objType = this.inferMemberAccessType(obj);
            int fieldOff = this.findFieldOffset(objType, fieldName);
            if (fieldOff >= 0) {
                this.asm.movRMBase(0, 0, fieldOff);
            }
            return;
        }
        this.genExpr(obj);
    }

    public string inferExprType(Node expr) {
        if (expr.kind == 6) {
            if (expr.name == "this") { return this.currentClassName; }
            return this.getLocalType(expr.name);
        }
        if (expr.kind == 13) {
            return this.inferMemberAccessType(expr);
        }
        if (expr.kind == 24) {
            Node arrNode = expr.child(0);
            string arrType = this.inferExprType(arrNode);
            return this.arrayElementType(arrType);
        }
        return "";
    }

    public string inferMemberAccessType(Node expr) {
        Node obj = expr.child(0);
        string fieldName = expr.name;
        string objType = this.inferExprType(obj);
        string fieldType = this.findFieldType(objType, fieldName);
        return fieldType;
    }

    public int findFieldOffsetInAllClasses(string fieldName) {
        for (int i = 0; i < this.classFieldNames.length; i++) {
            if (this.strEq(this.classFieldNames[i], fieldName)) {
                int off = this.classFieldOffsets[i];
                int unique = 1;
                for (int j = 0; j < this.classFieldNames.length; j++) {
                    if (j != i && this.strEq(this.classFieldNames[j], fieldName)) {
                        unique = 0;
                    }
                }
                if (unique == 1) {
                    return off;
                }
            }
        }
        return -1;
    }

    public void genArrayIndex(Node idx) {
        Node arrNode = idx.child(0);
        Node idxNode = idx.child(1);
        int arrOff = this.findLocal(arrNode.name);
        this.genExpr(idxNode);
        this.asm.shlR64Imm(0, 3);
        this.asm.pushR64(0);
        this.asm.movRMBase(11, 4, arrOff);
        this.asm.popR64(0);
        this.asm.addRR64(11, 0);
        this.asm.movRMBase(0, 11, 0);
    }

    public void genCall(Node call) {
        string name = call.name;
        int isClass = 0;
        for (int i = 0; i < this.classNames.length; i++) {
            if (this.strEq(this.classNames[i], name)) { isClass = 1; }
        }
        if (isClass == 1) {
            this.genNewCall(call);
        } elif (name == "printline" || name == "print") {
            this.genPrintCall(call, name == "printline");
        } elif (name == "strlen") {
            this.genStrlenCall(call);
        } elif (name == "exit") {
            this.genExitCall(call);
        } elif (name == "pushR64" || name == "popR64" || name == "movRR64" || name == "movRI64" || name == "movRMBase" || name == "movMBaseR" || name == "subRI32" || name == "addRI32" || name == "xorRR64" || name == "cmpRI32" || name == "cmpRR64" || name == "ret" || name == "callR64" || name == "leaRBase" || name == "emitU8" || name == "addRR64" || name == "subRR64" || name == "mulRR64" || name == "label" || name == "bindLabel" || name == "jeLabel" || name == "jneLabel" || name == "jmpLabel" || name == "jlLabel" || name == "jleLabel" || name == "jgLabel" || name == "jgeLabel") {
            this.genAsmCall(call);
        } else {
            this.genUserCall(call);
        }
    }

    public void genNewCall(Node call) {
        int size = 16;
        for (int i = 0; i < this.classNames.length; i++) {
            if (this.strEq(this.classNames[i], call.name)) {
                int cnt = this.classFieldCounts[i];
                size = cnt * 8;
                if (size < 16) { size = 16; }
            }
        }
        this.asm.emitImm64(1, size);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.subRI32(4, 32);
        int s4 = 0xDEADBEEFCAFEBAB0;
        this.asm.emitImm64(0, s4);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.addRI32(4, 32);
        int[] argRegs = [1, 2, 8, 9];
        int nargs = call.childCount();
        if (nargs > 3) { nargs = 3; }
        this.asm.pushR64(0);
        for (int i = 0; i < nargs; i++) {
            this.genExpr(call.child(i));
            this.asm.movRR64(argRegs[i + 1], 0);
        }
        this.asm.popR64(1);
        this.asm.pushR64(0);
        this.asm.subRI32(4, 32);
        this.asm.callR64(0);
        this.asm.addRI32(4, 32);
        this.asm.popR64(0);
    }

    public void genAsmCall(Node call) {
        string name = call.name;
        if (name == "ret") {
            this.asm.ret();
            return;
        }
        if (name == "label") {
            string lbl = "";
            if (call.childCount() > 0 && call.child(0).kind == 2) {
                lbl = call.child(0).strVal;
            }
            this.asm.label(lbl);
            return;
        }
        if (name == "bindLabel") {
            int id = 0;
            if (call.childCount() > 0 && call.child(0).kind == 0) {
                id = call.child(0).intVal;
            }
            this.asm.bindLabel(id);
            return;
        }
        int[] args = [];
        for (int i = 0; i < call.childCount(); i++) {
            Node c = call.child(i);
            if (c.kind == 13) { continue; }
            int v = 0;
            if (c.kind == 0) { v = c.intVal; }
            args.add(v);
        }
        if (name == "pushR64") { this.asm.pushR64(args[0]); }
        elif (name == "popR64") { this.asm.popR64(args[0]); }
        elif (name == "movRR64") { this.asm.movRR64(args[0], args[1]); }
        elif (name == "movRI64") {
            int64 v = 0;
            if (call.childCount() > 1 && call.child(1).kind == 0) { v = call.child(1).intVal; }
            this.asm.movRI64(args[0], v);
        }
        elif (name == "movRMBase") { this.asm.movRMBase(args[0], args[1], args[2]); }
        elif (name == "movMBaseR") { this.asm.movMBaseR(args[0], args[1], args[2]); }
        elif (name == "subRI32") { this.asm.subRI32(args[0], args[1]); }
        elif (name == "addRI32") { this.asm.addRI32(args[0], args[1]); }
        elif (name == "xorRR64") { this.asm.xorRR64(args[0], args[1]); }
    elif (name == "cmpRI32") { this.asm.cmpRI32(args[0], args[1]); }
    elif (name == "cmpRR64") { this.asm.cmpRR64(args[0], args[1]); }
    elif (name == "callR64") { this.asm.callR64(args[0]); }
        elif (name == "leaRBase") { this.asm.leaRBase(args[0], args[1], args[2]); }
        elif (name == "emitU8") { this.asm.emitU8(args[0]); }
        elif (name == "addRR64") { this.asm.addRR64(args[0], args[1]); }
        elif (name == "subRR64") { this.asm.subRR64(args[0], args[1]); }
        elif (name == "mulRR64") { this.asm.mulRR64(args[0]); }
        elif (name == "jeLabel") { this.asm.jeLabel(args[0]); }
        elif (name == "jneLabel") { this.asm.jneLabel(args[0]); }
        elif (name == "jmpLabel") { this.asm.jmpLabel(args[0]); }
    elif (name == "jlLabel") { this.asm.jlLabel(args[0]); }
    elif (name == "jleLabel") { this.asm.jleLabel(args[0]); }
    elif (name == "jgLabel") { this.asm.jgLabel(args[0]); }
    elif (name == "jgeLabel") { this.asm.jgeLabel(args[0]); }
    }

    public void genUserCall(Node call) {
        string name = call.name;
        int funcIdx = -1;
        for (int i = 0; i < this.funcNames.length; i++) {
            if (this.strEq(this.funcNames[i], name)) {
                funcIdx = i;
            }
        }
        if (funcIdx >= 0 && funcIdx < this.funcOffsets.length) {
            int targetOff = this.funcOffsets[funcIdx];
            int[] argRegs = [1, 2, 8, 9];
            int nargs = call.childCount();
            if (nargs > 4) { nargs = 4; }
            this.asm.subRI32(4, 32);
            for (int i = 0; i < nargs; i++) {
                this.genExpr(call.child(i));
                this.asm.movRR64(argRegs[i], 0);
            }
            for (int i = 4; i < call.childCount(); i++) {
                this.genExpr(call.child(i));
                this.asm.pushR64(0);
            }
            int callPos = this.asm.buf.length;
            int rel32 = targetOff - (callPos + 5);
            this.asm.callRel32(rel32);
            this.asm.addRI32(4, 32);
            return;
        }
        this.asm.subRI32(4, 32);
        int[] argRegs2 = [1, 2, 8, 9];
        int nargs2 = call.childCount();
        if (nargs2 > 4) { nargs2 = 4; }
        for (int i = 0; i < nargs2; i++) {
            this.genExpr(call.child(i));
            this.asm.movRR64(argRegs2[i], 0);
        }
        for (int i = 4; i < call.childCount(); i++) {
            this.genExpr(call.child(i));
            this.asm.pushR64(0);
        }
        this.asm.callR64(0);
        this.asm.addRI32(4, 32);
        this.asm.movRI64(0, 0);
    }

    public void genBinary(Node bin) {
        if (bin.childCount() < 2) { return; }
        int op = bin.op;
        if (op == 20) {
            this.genAssign(bin);
            return;
        }
        if (op >= 14 && op <= 17) {
            this.genCompoundAssign(bin, op);
            return;
        }
        this.genExpr(bin.child(0));
        this.asm.pushR64(0);
        this.genExpr(bin.child(1));
        this.asm.movRR64(1, 0);
        this.asm.popR64(0);
        if (op == 1) {
            this.asm.addRR64(0, 1);
        } elif (op == 2) {
            this.asm.subRR64(0, 1);
        } elif (op == 3) {
            this.asm.mulRR64(1);
    } elif (op >= 5 && op <= 10) {
        this.asm.cmpRR64(0, 1);
            int t = this.newLabel();
            int e = this.newLabel();
            if (op == 5) { this.asm.jeLabel(t); }
            elif (op == 6) { this.asm.jneLabel(t); }
            elif (op == 7) { this.asm.jlLabel(t); }
            elif (op == 8) { this.asm.jleLabel(t); }
            elif (op == 9) { this.asm.jgLabel(t); }
            elif (op == 10) { this.asm.jgeLabel(t); }
            this.asm.movRI64(0, 0);
            this.asm.jmpLabel(e);
            this.asm.bindLabel(t);
            this.asm.movRI64(0, 1);
            this.asm.bindLabel(e);
        }
    }

    public void genCompoundAssign(Node bin, int op) {
        Node lhs = bin.child(0);
        Node rhs = bin.child(1);
        if (lhs.kind == 6) {
            int off = this.findLocal(lhs.name);
            this.asm.movRMBase(0, 5, off);
            this.asm.pushR64(0);
            this.genExpr(rhs);
            this.asm.movRR64(1, 0);
            this.asm.popR64(0);
            if (op == 14) { this.asm.addRR64(0, 1); }
            elif (op == 15) { this.asm.subRR64(0, 1); }
            elif (op == 16) { this.asm.mulRR64(1); }
            this.asm.movMBaseR(5, 0, off);
            return;
        }
        if (lhs.kind == 24 && lhs.childCount() >= 2) {
            Node arrNode = lhs.child(0);
            Node idxNode = lhs.child(1);
            if (arrNode.kind == 6) {
                int arrOff = this.findLocal(arrNode.name);
                this.genExpr(idxNode);
                this.asm.pushR64(0);
                this.asm.movRMBase(11, 4, arrOff);
                this.asm.popR64(0);
                this.asm.addRR64(11, 0);
                this.asm.movRMBase(0, 11, 0);
                this.asm.pushR64(0);
                this.genExpr(rhs);
                this.asm.movRR64(1, 0);
                this.asm.popR64(0);
                if (op == 14) { this.asm.addRR64(0, 1); }
                elif (op == 15) { this.asm.subRR64(0, 1); }
                elif (op == 16) { this.asm.mulRR64(1); }
                this.asm.movMBaseR(11, 0, 0);
                return;
            }
        }
        if (lhs.kind == 13 && lhs.childCount() >= 1) {
            Node obj = lhs.child(0);
            string fieldName = lhs.name;
            if (obj.kind == 6 && obj.name == "this") {
                int thisOff = this.findLocal("this");
                int fieldOff = this.findFieldOffset(this.currentClassName, fieldName);
                if (fieldOff < 0) { this.genExpr(rhs); return; }
                this.asm.movRMBase(0, 5, thisOff);
                this.asm.movRMBase(0, 0, fieldOff);
                this.asm.pushR64(0);
                this.genExpr(rhs);
                this.asm.movRR64(1, 0);
                this.asm.popR64(0);
                if (op == 14) { this.asm.addRR64(0, 1); }
                elif (op == 15) { this.asm.subRR64(0, 1); }
                elif (op == 16) { this.asm.mulRR64(1); }
                this.asm.movRMBase(10, 5, thisOff);
                this.asm.addRI32(10, fieldOff);
                this.asm.movMBaseR(10, 0, 0);
                return;
            }
        }
        this.genExpr(rhs);
    }

    public void genAssign(Node bin) {
        Node lhs = bin.child(0);
        Node rhs = bin.child(1);
        if (lhs.kind == 6) {
            int off = this.findLocal(lhs.name);
            this.genExpr(rhs);
            this.asm.movMBaseR(5, 0, off);
            return;
        }
        if (lhs.kind == 13 && lhs.childCount() >= 1) {
            Node obj = lhs.child(0);
            string fieldName = lhs.name;
            if (obj.kind == 6 && obj.name == "this") {
                int thisOff = this.findLocal("this");
                int fieldOff = this.findFieldOffset(this.currentClassName, fieldName);
                if (fieldOff < 0) {
                    this.genExpr(rhs);
                    return;
                }
                this.genExpr(rhs);
                this.asm.pushR64(0);
                this.asm.movRMBase(0, 5, thisOff);
                this.asm.addRI32(0, fieldOff);
                this.asm.popR64(1);
                this.asm.movMBaseR(0, 1, 0);
                return;
            }
            if (obj.kind == 6) {
                string varType = this.getLocalType(obj.name);
                int off = this.findLocal(obj.name);
                string lookupType = varType;
                string elemType = this.arrayElementType(varType);
                if (elemType != "") { lookupType = elemType; }
                int fieldOff = this.findFieldOffset(lookupType, fieldName);
                if (fieldOff < 0) {
                    this.genExpr(rhs);
                    return;
                }
                this.genExpr(rhs);
                this.asm.pushR64(0);
                this.asm.movRMBase(0, 5, off);
                this.asm.addRI32(0, fieldOff);
                this.asm.popR64(1);
                this.asm.movMBaseR(0, 1, 0);
                return;
            }
        }
        if (lhs.kind == 24 && lhs.childCount() >= 2) {
            Node arrNode = lhs.child(0);
            Node idxNode = lhs.child(1);
            if (arrNode.kind == 6) {
                int arrOff = this.findLocal(arrNode.name);
                this.genExpr(idxNode);
                this.asm.pushR64(0);
                this.genExpr(rhs);
                this.asm.pushR64(0);
                this.asm.movRMBase(11, 4, arrOff);
                this.asm.popR64(12);
                this.asm.popR64(0);
                this.asm.addRR64(11, 0);
                this.asm.movMBaseR(11, 12, 0);
                this.asm.movRI64(0, 0);
                return;
            }
        }
        this.genExpr(rhs);
    }

    public void addFormatStr(string fmt) {
        int fmtIdx = this.addString(fmt);
        int sp = this.asm.buf.length;
        this.asm.emitImm64(0, 0);
        int fmtPatchPos = sp + 2;
        this.stringPatchOffsets.add(fmtPatchPos);
        this.stringPatchIndices.add(fmtIdx);
        this.asm.movRR64(1, 0);
    }

    public void genPrintCall(Node call, bool newline) {
        if (call.childCount() < 1) { return; }
        Node arg = call.child(0);
        if (arg.kind == 2) {
            string s = arg.strVal;
            if (newline) { s = s + "\n"; }
            int strIdx = this.addString(s);
            int sp = this.asm.buf.length;
            this.asm.emitImm64(0, 0);
            int strPatchPos = sp + 2;
            this.stringPatchOffsets.add(strPatchPos);
            this.stringPatchIndices.add(strIdx);
            this.asm.movRR64(1, 0);
        } else {
            this.genExpr(arg);
            this.asm.pushR64(0);
            if (newline) {
                this.addFormatStr("%lld\n");
            } else {
                this.addFormatStr("%lld");
            }
            this.asm.popR64(2);
        }
        this.addImportPatch("msvcrt.dll", "printf");
        int s1 = 0xDEADBEEFCAFEBAD0;
        this.asm.emitImm64(0, s1);
        this.asm.movRMBase(0, 0, 0);
        this.asm.subRI32(4, 32);
        this.asm.callR64(0);
        this.asm.addRI32(4, 32);
    }

    public void genStringConcat(Node bin) {
        if (bin.childCount() < 2) { return; }
        this.genExpr(bin.child(0));
    }

    public void genStrlenCall(Node call) {
        if (call.childCount() < 1) { return; }
        this.genExpr(call.child(0));
        this.asm.movRR64(1, 0);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.subRI32(4, 32);
        int s2 = 0xDEADBEEFCAFEBAD1;
        this.asm.emitImm64(0, s2);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.addRI32(4, 32);
    }

    public void genExitCall(Node call) {
        if (call.childCount() > 0) {
            this.genExpr(call.child(0));
            this.asm.movRR64(1, 0);
        } else {
            this.asm.xorRR64(1, 1);
        }
        this.addImportPatch("kernel32.dll", "ExitProcess");
        this.asm.subRI32(4, 32);
        int s3 = 0xDEADBEEFCAFEBABE;
        this.asm.emitImm64(0, s3);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.addRI32(4, 32);
    }
}

class PeImport {
    public prop string dll;
    public prop string name;

    construct (string dll, string name) {
        this.dll = dll;
        this.name = name;
    }
}

class PeDllGroup {
    public prop string dll;
    public prop int count;

    construct (string dll) {
        this.dll = dll;
        this.count = 0;
    }
}

class MiniPe {
    public int[] code;
    public int entryRva;
    public PeImport[] imports;

    construct () {
        this.code = [];
        this.entryRva = 0;
        this.imports = [];
    }

    public void addImport(string dll, string name) {
        this.imports.add(new PeImport(dll, name));
    }

    public int computeRdataRva() {
        int FILE_ALIGN = 0x200;
        int SECT_ALIGN = 0x1000;
        int textRva = SECT_ALIGN;
        int textVirt = this.padToAlign(this.code.length, SECT_ALIGN);
        return textRva + textVirt;
    }

    public int[] computeLayout(int stringDataLen) {
        PeDllGroup[] groups = [];
        int[] groupMap = [];
        for (int i = 0; i < this.imports.length; i++) {
            int gIdx = -1;
            for (int j = 0; j < groups.length; j++) {
                if (groups[j].dll == this.imports[i].dll) {
                    gIdx = j;
                    break;
                }
            }
            if (gIdx < 0) {
                groups.add(new PeDllGroup(this.imports[i].dll));
                gIdx = groups.length - 1;
            }
            groups[gIdx].count += 1;
            groupMap.add(gIdx);
        }
        int numGroups = groups.length;
        int descBytes = (numGroups + 1) * 20;
        int iltTotal = 0;
        for (int g = 0; g < numGroups; g++) {
            iltTotal += (groups[g].count + 1) * 8;
        }
        int iatTotal = iltTotal;
        int namesStart = descBytes + iltTotal + iatTotal;
        int hintNamesLen = 0;
        for (int i = 0; i < this.imports.length; i++) {
            hintNamesLen += 2 + this.imports[i].name.length + 1;
        }
        for (int g = 0; g < numGroups; g++) {
            hintNamesLen += groups[g].dll.length + 1;
        }
        int stringsStart = namesStart + 20;
        int[] layout = [];
        layout.add(stringsStart);
        layout.add(numGroups);
        layout.add(iltTotal);
        return layout;
    }

    public int padToAlign(int offset, int align) {
        int m = offset % align;
        if (m != 0) {
            return offset + (align - m);
        }
        return offset;
    }

    public void writeLe32(int[] buf, int offset, int val) {
        buf[offset] = val & 0xFF;
        buf[offset + 1] = (val >> 8) & 0xFF;
        buf[offset + 2] = (val >> 16) & 0xFF;
        buf[offset + 3] = (val >> 24) & 0xFF;
    }

    public void writeLe64(int[] buf, int offset, int64 val) {
        buf[offset] = val & 0xFF;
        buf[offset + 1] = (val >> 8) & 0xFF;
        buf[offset + 2] = (val >> 16) & 0xFF;
        buf[offset + 3] = (val >> 24) & 0xFF;
        buf[offset + 4] = (val >> 32) & 0xFF;
        buf[offset + 5] = (val >> 40) & 0xFF;
        buf[offset + 6] = (val >> 48) & 0xFF;
        buf[offset + 7] = (val >> 56) & 0xFF;
    }

    public int[] build(int[] codeIn, int[] stringData) {
        this.code = codeIn;

        int numGroups = 1;
        int[] iltSizes = [16];
        int iltTotal = 16;
        int iatTotal = 16;
        int[] groupFuncIndices = [[0]];
        int[] hintNameOffsets = [0];
        int[] dllNameOffsets = [9];
        int[] hintNames = [0, 0, 112, 114, 105, 110, 116, 102, 0, 109, 115, 118, 99, 114, 116, 46, 100, 108, 108, 0];
        PeDllGroup[] groups = [new PeDllGroup("X")];
        groups[0].count = 1;
        int[] groupMap = [0];
        int descBytes = (numGroups + 1) * 20;
        int descBytes = (numGroups + 1) * 20;

        int namesStart = descBytes + iltTotal + iatTotal;
        int stringsStart = namesStart + hintNames.length;
        int importDataSize = stringsStart + stringData.length;

        int FILE_ALIGN = 0x200;
        int SECT_ALIGN = 0x1000;
        int headersRawSize = 64 + 4 + 20 + 240 + 2 * 40;
        int headersSize = this.padToAlign(headersRawSize, FILE_ALIGN);

        int textRva = SECT_ALIGN;
        int textVirt = this.padToAlign(this.code.length, SECT_ALIGN);
        int textRaw = this.padToAlign(this.code.length, FILE_ALIGN);
        int textFileOff = headersSize;

        int rdataRva = textRva + textVirt;
        int importVirt = this.padToAlign(importDataSize, SECT_ALIGN);
        int importRaw = this.padToAlign(importDataSize, FILE_ALIGN);
        int rdataFileOff = textFileOff + textRaw;

        int iatSectionStart = descBytes + iltTotal;
        int firstIatRva = rdataRva + iatSectionStart;
        int iatSize = iatTotal;

        int imageSize = this.padToAlign(rdataRva + importVirt, SECT_ALIGN);

        int totalSize = rdataFileOff + importRaw;
        int[] pe = [];
        for (int i = 0; i < totalSize; i++) {
            pe.add(0);
        }

        pe[0] = 0x4D; pe[1] = 0x5A;
        this.writeLe32(pe, 0x3C, 64);

        int p = 64;
        pe[p] = 0x50; pe[p+1] = 0x45; pe[p+2] = 0; pe[p+3] = 0;
        p += 4;
        pe[p] = 0x64; pe[p+1] = 0x86; p += 2;
        pe[p] = 0x02; pe[p+1] = 0; p += 2;
        this.writeLe32(pe, p, 0x42); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        pe[p] = 0xF0; pe[p+1] = 0; p += 2;
        pe[p] = 0x22; pe[p+1] = 0; p += 2;

        pe[p] = 0x0B; pe[p+1] = 0x02; p += 2;
        pe[p] = 14; pe[p+1] = 0; p += 2;
        this.writeLe32(pe, p, textRaw); p += 4;
        this.writeLe32(pe, p, importRaw); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, this.entryRva); p += 4;
        this.writeLe32(pe, p, textRva); p += 4;
        this.writeLe64(pe, p, 0x140000000); p += 8;
        this.writeLe32(pe, p, SECT_ALIGN); p += 4;
        this.writeLe32(pe, p, FILE_ALIGN); p += 4;
        pe[p] = 6; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        pe[p] = 6; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, imageSize); p += 4;
        this.writeLe32(pe, p, headersSize); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        pe[p] = 3; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        this.writeLe64(pe, p, 0x100000); p += 8;
        this.writeLe64(pe, p, 0x1000); p += 8;
        this.writeLe64(pe, p, 0x100000); p += 8;
        this.writeLe64(pe, p, 0x1000); p += 8;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 16); p += 4;

        for (int i = 0; i < 16; i++) {
            if (i == 1) {
                this.writeLe32(pe, p, rdataRva); p += 4;
                this.writeLe32(pe, p, importVirt); p += 4;
            } elif (i == 12) {
                this.writeLe32(pe, p, firstIatRva); p += 4;
                this.writeLe32(pe, p, iatSize); p += 4;
            } else {
                this.writeLe32(pe, p, 0); p += 4;
                this.writeLe32(pe, p, 0); p += 4;
            }
        }

        pe[p] = 0x2E; pe[p+1] = 0x74; pe[p+2] = 0x65; pe[p+3] = 0x78; pe[p+4] = 0x74; pe[p+5] = 0; pe[p+6] = 0; pe[p+7] = 0;
        p += 8;
        this.writeLe32(pe, p, textVirt); p += 4;
        this.writeLe32(pe, p, textRva); p += 4;
        this.writeLe32(pe, p, textRaw); p += 4;
        this.writeLe32(pe, p, textFileOff); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0x60000020); p += 4;

        pe[p] = 0x2E; pe[p+1] = 0x72; pe[p+2] = 0x64; pe[p+3] = 0x61; pe[p+4] = 0x74; pe[p+5] = 0x61; pe[p+6] = 0; pe[p+7] = 0;
        p += 8;
        this.writeLe32(pe, p, importVirt); p += 4;
        this.writeLe32(pe, p, rdataRva); p += 4;
        this.writeLe32(pe, p, importRaw); p += 4;
        this.writeLe32(pe, p, rdataFileOff); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0xC0000040); p += 4;

        for (int i = 0; i < this.code.length; i++) {
            pe[textFileOff + i] = this.code[i];
        }

        int importBase = rdataFileOff;

        int descOff = 0;
        for (int g = 0; g < numGroups; g++) {
            int iltBefore = 0;
            for (int j = 0; j < g; j++) {
                iltBefore += iltSizes[j];
            }
            int iltRva = rdataRva + descBytes + iltBefore;
            int iatBefore = iltTotal;
            for (int j = 0; j < g; j++) {
                iatBefore += iltSizes[j];
            }
            int iatRva = rdataRva + descBytes + iatBefore;
            int dllNameRva = rdataRva + namesStart + dllNameOffsets[g];

            this.writeLe32(pe, importBase + descOff, iltRva);
            this.writeLe32(pe, importBase + descOff + 4, 0);
            this.writeLe32(pe, importBase + descOff + 8, 0);
            this.writeLe32(pe, importBase + descOff + 12, dllNameRva);
            this.writeLe32(pe, importBase + descOff + 16, iatRva);
            descOff += 20;
        }

        int iltOff = descBytes;
        this.writeLe64(pe, importBase + iltOff, rdataRva + namesStart + hintNameOffsets[0]);
        this.writeLe64(pe, importBase + iltOff + 8, 0);

        int iatOff = descBytes + iltTotal;
        this.writeLe64(pe, importBase + iatOff, rdataRva + namesStart + hintNameOffsets[0]);
        this.writeLe64(pe, importBase + iatOff + 8, 0);

        for (int i = 0; i < hintNames.length; i++) {
            pe[importBase + namesStart + i] = hintNames[i];
        }
        for (int i = 0; i < stringData.length; i++) {
            pe[importBase + stringsStart + i] = stringData[i];
        }

        return pe;
    }
}


class Lexer {
    private prop string src;
    private prop int pos;
    private prop int line;
    private prop int col;

    construct (string source) {
        this.src = source;
        this.pos = 0;
        this.line = 1;
        this.col = 1;
    }

    private char? peek() {
        if (this.pos < this.src.length) {
            return this.src[this.pos];
        }
        return null;
    }

    private char? peekNext() {
        if (this.pos + 1 < this.src.length) {
            return this.src[this.pos + 1];
        }
        return null;
    }

    private char? advance() {
        if (this.pos >= this.src.length) { return null; }
        char c = this.src[this.pos];
        this.pos += 1;
        if (c == '\n') {
            this.line += 1;
            this.col = 1;
        } else {
            this.col += 1;
        }
        return c;
    }

    private void skipWhitespace() {
        while (this.pos < this.src.length) {
            char c = this.src[this.pos];
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
                this.advance();
            } else {
                break;
            }
        }
    }

    private void skipLineComment() {
        while (this.pos < this.src.length) {
            char c = this.src[this.pos];
            if (c == '\n') { break; }
            this.advance();
        }
    }

    private bool skipBlockComment() {
        int depth = 1;
        while (this.pos < this.src.length && depth > 0) {
            char c = this.src[this.pos];
            if (c == '/' && this.peekNext() == '*') {
                depth += 1;
                this.advance();
                this.advance();
            } else if (c == '*' && this.peekNext() == '/') {
                depth -= 1;
                this.advance();
                this.advance();
            } else {
                this.advance();
            }
        }
        return depth == 0;
    }

    public Token[] tokenize() {
        Token[] tokens = [];
        while (true) {
            this.skipWhitespace();
            if (this.pos >= this.src.length) {
                tokens.add(new Token(0, "", this.line, this.col));
                break;
            }
        Token? tok = this.nextToken();
        if (tok != null) {
            tokens.add(tok);
        }
        }
        return tokens;
    }

    private Token? nextToken() {
        char c = this.src[this.pos];
        int ln = this.line;
        int cl = this.col;

        if (c == '/' && this.peekNext() != null) {
            char next = this.peekNext();
            if (next == '/') { this.advance(); this.skipLineComment(); return null; }
            if (next == '*') { this.advance(); this.advance(); this.skipBlockComment(); return null; }
        }

        if (c == '"') { this.advance(); return this.readString(); }
        if (c == '\'') { this.advance(); return this.readChar(); }
        if (c.isDigit()) { this.advance(); return this.readNumber(c); }
        if (c.isAlpha() || c == '_') { this.advance(); return this.readIdent(c); }

        this.advance();

        if (c == '(') { return new Token(100, "(", ln, cl); }
        if (c == ')') { return new Token(101, ")", ln, cl); }
        if (c == '{') { return new Token(102, "{", ln, cl); }
        if (c == '}') { return new Token(103, "}", ln, cl); }
        if (c == '[') { return new Token(104, "[", ln, cl); }
        if (c == ']') { return new Token(105, "]", ln, cl); }
        if (c == ';') { return new Token(106, ";", ln, cl); }
        if (c == ',') { return new Token(107, ",", ln, cl); }
        if (c == '.') {
            if (this.peek() == '.' && this.peekNext() != null && this.peekNext() == '.') {
                this.advance(); this.advance();
                return new Token(147, "...", ln, cl);
            }
            if (this.peek() == '.') { this.advance(); return new Token(144, "..", ln, cl); }
            return new Token(108, ".", ln, cl);
        }
        if (c == ':') { return new Token(109, ":", ln, cl); }
        if (c == '+') {
            if (this.peek() == '+') { this.advance(); return new Token(142, "++", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(130, "+=", ln, cl); }
            return new Token(111, "+", ln, cl);
        }
        if (c == '-') {
            if (this.peek() == '-') { this.advance(); return new Token(143, "--", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(131, "-=", ln, cl); }
            if (this.peek() == '>') { this.advance(); return new Token(145, "->", ln, cl); }
            return new Token(112, "-", ln, cl);
        }
        if (c == '*') {
            if (this.peek() == '=') { this.advance(); return new Token(132, "*=", ln, cl); }
            return new Token(113, "*", ln, cl);
        }
        if (c == '/') {
            if (this.peek() == '=') { this.advance(); return new Token(133, "/=", ln, cl); }
            return new Token(114, "/", ln, cl);
        }
        if (c == '%') { return new Token(115, "%", ln, cl); }
        if (c == '&') {
            if (this.peek() == '&') { this.advance(); return new Token(138, "&&", ln, cl); }
            return new Token(116, "&", ln, cl);
        }
        if (c == '|') {
            if (this.peek() == '|') { this.advance(); return new Token(139, "||", ln, cl); }
            return new Token(117, "|", ln, cl);
        }
        if (c == '<') {
            if (this.peek() == '<') { this.advance(); return new Token(140, "<<", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(136, "<=", ln, cl); }
            return new Token(120, "<", ln, cl);
        }
        if (c == '>') {
            if (this.peek() == '>') { this.advance(); return new Token(141, ">>", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(137, ">=", ln, cl); }
            return new Token(121, ">", ln, cl);
        }
        if (c == '=') {
            if (this.peek() == '=') { this.advance(); return new Token(134, "==", ln, cl); }
            if (this.peek() == '>') { this.advance(); return new Token(146, "=>", ln, cl); }
            return new Token(110, "=", ln, cl);
        }
        if (c == '!') {
            if (this.peek() == '=') { this.advance(); return new Token(135, "!=", ln, cl); }
            return new Token(122, "!", ln, cl);
        }
        if (c == '~') { return new Token(119, "~", ln, cl); }
        if (c == '^') { return new Token(118, "^", ln, cl); }
        if (c == '?') { return new Token(123, "?", ln, cl); }
        if (c == '#') { return new Token(125, "#", ln, cl); }

        printline("warn");
        return null;
    }

    private Token readString() {
        int ln = this.line; int cl = this.col;
        string s = "";
        while (this.pos < this.src.length) {
            char ch = this.src[this.pos]; this.advance();
            if (ch == '"') { break; }
            if (ch == '\\') {
                if (this.pos < this.src.length) {
                    char esc = this.src[this.pos]; this.advance();
                    if (esc == 'n') { s += "\n"; }
                    else if (esc == 't') { s += "\t"; }
                    else if (esc == '0') { s += "\0"; }
                    else { s += esc.toString(); }
                }
            } else {
                s += ch.toString();
            }
        }
        Token tok = new Token(3, s, ln, cl);
        tok.strVal = s;
        return tok;
    }

    private Token readChar() {
        int ln = this.line; int cl = this.col;
        char ch = ' ';
        if (this.pos < this.src.length) {
            ch = this.src[this.pos]; this.advance();
            if (ch == '\\' && this.pos < this.src.length) {
                char esc = this.src[this.pos]; this.advance();
                if (esc == 'n') { ch = '\n'; }
                else if (esc == 't') { ch = '\t'; }
                else if (esc == '0') { ch = '\0'; }
                else { ch = esc; }
            }
        }
        if (this.pos < this.src.length && this.src[this.pos] == '\'') {
            this.advance();
        }
        Token tok = new Token(4, ch.toString(), ln, cl);
        tok.charVal = ch;
        return tok;
    }

    private Token readNumber(char first) {
        int ln = this.line; int cl = this.col;
        string s = first.toString();
        bool isFloat = false;
        int base = 10;
        if (first == '0' && this.pos < this.src.length) {
            char next = this.src[this.pos];
            if (next == 'x' || next == 'X') {
                this.advance();
                base = 16;
                s = "";
            }
        }
        while (this.pos < this.src.length) {
            char ch = this.src[this.pos];
            if (ch.isDigit() || ch == '_') {
                s += ch.toString(); this.advance();
            } elif (base == 16 && ((ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F'))) {
                s += ch.toString(); this.advance();
            } elif (ch == '.' && !isFloat) {
                if (this.peek() == '.') { break; }
                isFloat = true; s += "."; this.advance();
            } elif (ch == 'e' || ch == 'E') {
                isFloat = true; s += ch.toString(); this.advance();
                if (this.pos < this.src.length && (this.src[this.pos] == '+' || this.src[this.pos] == '-')) {
                    s += this.src[this.pos].toString(); this.advance();
                }
            } else { break; }
        }
        Token tok = new Token(1, s, ln, cl);
        if (base == 16) {
            tok.intVal = s.toInt64FromBase(16);
        } else {
            tok.intVal = s.toInt64();
        }
        return tok;
    }

    private Token readIdent(char first) {
        int ln = this.line; int cl = this.col;
        string s = first.toString();
        while (this.pos < this.src.length) {
            char ch = this.src[this.pos];
            if (ch.isAlphaNum() || ch == '_') {
                s += ch.toString(); this.advance();
            } else { break; }
        }
        int kind = this.keywordKind(s);
        Token tok = new Token(kind, s, ln, cl);
        if (kind == 7) { tok.strVal = s; }
        return tok;
    }

    private int keywordKind(string s) {
        if (s == "if") { return 10; }
        if (s == "else") { return 11; }
        if (s == "while") { return 12; }
        if (s == "for") { return 13; }
        if (s == "foreach") { return 14; }
        if (s == "return") { return 15; }
        if (s == "match") { return 16; }
        if (s == "void") { return 17; }
        if (s == "int") { return 18; }
        if (s == "int32") { return 19; }
        if (s == "int64") { return 20; }
        if (s == "float") { return 22; }
        if (s == "float64") { return 23; }
        if (s == "bool") { return 25; }
        if (s == "char") { return 26; }
        if (s == "string") { return 27; }
        if (s == "var") { return 28; }
        if (s == "struct") { return 29; }
        if (s == "class") { return 30; }
        if (s == "enum") { return 31; }
        if (s == "def") { return 32; }
        if (s == "new") { return 39; }
        if (s == "const") { return 40; }
        if (s == "true") { return 5; }
        if (s == "false") { return 5; }
        if (s == "null") { return 6; }
        if (s == "import") { return 36; }
        if (s == "from") { return 37; }
        if (s == "as") { return 38; }
        if (s == "mod") { return 35; }
        if (s == "mut") { return 50; }
        if (s == "public") { return 44; }
        if (s == "private") { return 45; }
        if (s == "static") { return 46; }
        if (s == "prop") { return 47; }
        if (s == "construct") { return 48; }
        if (s == "unset") { return 49; }
        if (s == "try") { return 52; }
        if (s == "catch") { return 53; }
        if (s == "found") { return 33; }
        if (s == "collect") { return 34; }
        if (s == "ref") { return 51; }
	if (s == "in") { return 54; }
	if (s == "to") { return 55; }
	if (s == "elif") { return 56; }
	if (s == "break") { return 57; }
	if (s == "continue") { return 58; }
	if (s == "export") { return 59; }
	return 7;
    }
}

class Token {
    public prop int kind;
    public prop string text;
    public prop int line;
    public prop int col;
    public prop int64 intVal;
    public prop float64 floatVal;
    public prop string strVal;
    public prop char charVal;

    construct (int kind, string text, int line, int col) {
        this.kind = kind; this.text = text;
        this.line = line; this.col = col;
        this.intVal = 0; this.floatVal = 0.0;
        this.strVal = ""; this.charVal = ' ';
    }
}

class Parser {
    private prop Token[] tokens;
    private prop int pos;

    construct (Token[] toks) {
        this.tokens = toks;
        this.pos = 0;
    }

    private void pppp() {
        Node n = new Node();
        n.kind = 64;
        this.expect(14);
        this.expect(100);
        Node v = new Node();
        v.kind = 50;
        string vt = this.advance().text;
        while (this.check(104)) { this.advance(); this.expect(105); vt = vt + "[]"; }
        if (this.check(123)) { this.advance(); vt = vt + "?"; }
        v.typeHint = vt;
        v.name = this.advance().text;
        n.children.add(v);
        this.expect(54);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlock());
        return n;
    }

    private Token peek() {
        if (this.pos < this.tokens.length) {
            return this.tokens[this.pos];
        }
        return this.tokens[this.tokens.length - 1];
    }

    private Token advance() {
        Token t = this.tokens[this.pos];
        this.pos = this.pos + 1;
        return t;
    }

    private bool check(int kind) {
        Token t = this.peek();
        int pk = t.kind;
        return pk == kind;
    }

    private Token expect(int kind) {
        if (this.check(kind)) {
            return this.advance();
        }
        Token t = this.peek();
        printline("err");
        exit(1);
        return t;
    }

    public Node[] parseProgram() {
        Node[] items = [];
        while (!this.check(0)) {
            Node? item = this.parseItem();
            if (item != null) {
                items.add(item);
            }
        }
        return items;
    }

	private Node? parseItem() {
		if (this.check(35)) { this.advance(); if (this.check(59)) { this.advance(); } this.advance(); this.expect(106); return null; }
		if (this.check(36)) { return this.parseImport(); }
        if (this.check(40)) { return this.parseConst(); }
        if (this.check(32)) { return this.parseDef(); }
        if (this.check(29)) { return this.parseStruct(); }
        if (this.check(30)) { return this.parseClass(); }
        return this.parseFunction();
    }

    private Node parseImport() {
        Node node = new Node();
        node.kind = 105;
        this.expect(36);
        node.name = this.advance().text;
        if (this.check(37)) {
            this.advance();
            this.advance();
        }
        this.expect(106);
        return node;
    }

    private Node parseConst() {
        Node node = new Node();
        node.kind = 104;
        this.expect(40);
        node.typeHint = this.advance().text;
        node.name = this.advance().text;
        this.expect(110);
        node.children.add(this.parseExpr(0));
        this.expect(106);
        return node;
    }

    private Node parseDef() {
        Node node = new Node();
        this.expect(32);
        node.name = this.advance().text;
        if (this.check(110)) {
            node.kind = 103;
            this.advance();
            this.expect(31);
            this.expect(102);
            while (!this.check(103)) {
                node.children.add(this.parsePattern());
                if (this.check(107)) { this.advance(); }
            }
            this.expect(103);
            this.expect(106);
        } else {
            node.kind = 110;
            this.expect(106);
        }
        return node;
    }

    private Node parseStruct() {
        Node node = new Node();
        node.kind = 101;
        this.expect(29);
        node.name = this.advance().text;
        this.expect(102);
        while (!this.check(103)) {
            Node field = new Node();
            field.typeHint = this.advance().text;
            string fn = this.advance().text;
            field.name = fn;
            field.kind = 0;
            node.children.add(field);
            this.expect(106);
        }
        this.expect(103);
        return node;
    }

    private Node parseClass() {
        Node node = new Node();
        node.kind = 102;
        this.expect(30);
        node.name = this.advance().text;
        if (this.check(109)) {
            this.advance();
            node.parentClass = this.advance().text;
        }
        this.expect(102);
        while (!this.check(103)) {
            Node member = this.parseClassMember();
            if (member != null) { node.children.add(member); }
        }
        this.expect(103);
        return node;
    }

    private Node? parseClassMember() {
        if (this.check(44) || this.check(45)) { this.advance(); }
        if (this.check(46)) { this.advance(); }
        if (this.check(48)) {
            Node ctor = new Node();
            ctor.kind = 100;
            ctor.name = "construct";
            this.advance();
            this.expect(100);
            while (!this.check(101)) {
                Node param = new Node();
                string cpt = this.advance().text;
                while (this.check(104)) { this.advance(); this.expect(105); cpt = cpt + "[]"; }
                if (this.check(123)) { this.advance(); cpt = cpt + "?"; }
                param.typeHint = cpt;
                param.name = this.advance().text;
                ctor.children.add(param);
                if (this.check(107)) { this.advance(); }
            }
            this.expect(101);
            ctor.children.add(this.parseBlock());
            return ctor;
        }
        if (this.check(47)) {
            this.advance();
            Node field = new Node();
            field.kind = 50;
            string ft = this.advance().text;
            while (this.check(104)) { this.advance(); this.expect(105); ft = ft + "[]"; }
            if (this.check(123)) { this.advance(); ft = ft + "?"; }
            field.typeHint = ft;
            field.name = this.advance().text;
            this.expect(106);
            return field;
        }
        if (this.check(28) || this.check(18) || this.check(19) || this.check(20) || this.check(25) || this.check(27) || this.check(22) || this.check(23) || this.check(26) || this.check(7)) {
            int savedPos = this.pos;
            string ft = this.advance().text;
            while (this.check(104)) { this.advance(); this.expect(105); ft = ft + "[]"; }
            if (this.check(123)) { this.advance(); ft = ft + "?"; }
            if (this.check(7) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 106) {
                Node field = new Node();
                field.kind = 50;
                field.typeHint = ft;
                field.name = this.advance().text;
                this.expect(106);
                return field;
            }
            this.pos = savedPos;
        }
        return this.parseFunction();
    }

    private Node parseFunction() {
        Node node = new Node();
        node.kind = 100;
        string retType = this.advance().text;
        while (this.check(104)) { this.advance(); this.expect(105); retType = retType + "[]"; }
        if (this.check(123)) { this.advance(); retType = retType + "?"; }
        node.typeHint = retType;
        node.name = this.advance().text;
        this.expect(100);
        Node params = new Node();
        while (!this.check(101)) {
            Node param = new Node();
            string pt = this.advance().text;
            while (this.check(104)) { this.advance(); this.expect(105); pt = pt + "[]"; }
            if (this.check(123)) { this.advance(); pt = pt + "?"; }
            param.typeHint = pt;
            param.name = this.advance().text;
            params.children.add(param);
            if (this.check(107)) { this.advance(); }
        }
        this.expect(101);
        node.children.add(params);
        if (this.check(141)) {
            this.advance();
            node.children.add(this.parseExpr(0));
        } else {
            node.children.add(this.parseBlock());
        }
        return node;
    }

    private Node parseBlock() {
        Node block = new Node();
        block.kind = 16;
        this.expect(102);
        while (!this.check(103)) {
            block.children.add(this.parseStmt());
        }
        this.expect(103);
        return block;
    }

    private Node parseStmt() {
        if (this.check(7) && this.pos + 1 < this.tokens.length) {
            Token next = this.tokens[this.pos + 1];
            if (next.kind == 7) {
                return this.parseVarDecl();
            }
            if (next.kind == 104 && this.pos + 2 < this.tokens.length && this.tokens[this.pos + 2].kind == 105) {
                return this.parseVarDecl();
            }
            if (next.kind == 123 && this.pos + 2 < this.tokens.length && this.tokens[this.pos + 2].kind == 7) {
                return this.parseVarDecl();
            }
        }
        if (this.check(15)) {
            Node n = new Node(); n.kind = 51;
            this.advance();
            if (!this.check(106)) { n.children.add(this.parseExpr(0)); }
            this.expect(106);
            return n;
        }
        if (this.check(141)) {
            Node n = new Node(); n.kind = 52;
            this.advance();
            n.children.add(this.parseExpr(0));
            this.expect(106);
            return n;
        }
        if (this.check(10)) { return this.parseIf(); }
        if (this.check(12)) { return this.parseWhile(); }
        if (this.check(13)) { return this.parseFor(); }
        if (this.check(14)) { return this.pppp(); }
        if (this.check(57)) { Node n = new Node(); n.kind = 62; this.advance(); this.expect(106); return n; }
        if (this.check(58)) { Node n = new Node(); n.kind = 63; this.advance(); this.expect(106); return n; }
        if (this.check(49)) {
            Node n = new Node(); n.kind = 60;
            this.advance();
            n.name = this.advance().text;
            this.expect(106);
            return n;
        }
        if (this.check(28) || this.check(18) || this.check(19) || this.check(20) || this.check(25) || this.check(27) || this.check(22) || this.check(23) || this.check(26)) {
            return this.parseVarDecl();
        }
        Node exprStmt = new Node(); exprStmt.kind = 61;
        exprStmt.children.add(this.parseExpr(0));
        this.expect(106);
        return exprStmt;
    }

    private Node parseVarDecl() {
        Node n = new Node(); n.kind = 50;
        string typeName = this.advance().text;
        while (this.check(104)) {
            this.advance();
            this.expect(105);
            typeName = typeName + "[]";
        }
        if (this.check(123)) { this.advance(); typeName = typeName + "?"; }
        n.typeHint = typeName;
        if (this.check(50)) { this.advance(); n.isMut = true; }
        n.name = this.advance().text;
        if (this.check(110)) {
            this.advance();
            n.children.add(this.parseExpr(0));
        }
        this.expect(106);
        return n;
    }

    private Node parseIf() {
        Node n = new Node(); n.kind = 53;
        if (this.check(56)) {
            this.advance();
        } else {
            this.expect(10);
        }
        this.expect(100);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlock());
        if (this.check(11)) {
            this.advance();
            if (this.check(10)) {
                n.children.add(this.parseIf());
            } elif (this.check(56)) {
                n.children.add(this.parseIf());
            } else {
                n.children.add(this.parseBlock());
            }
        } elif (this.check(56)) {
            n.children.add(this.parseIf());
        }
        return n;
    }

    private Node parseWhile() {
        Node n = new Node(); n.kind = 54;
        this.expect(12);
        this.expect(100);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlock());
        return n;
    }

    private Node parseFor() {
        Node n = new Node();
        this.expect(13);
        this.expect(100);
        if (this.check(28) || this.check(18) || this.check(19) || this.check(20)) {
            n.kind = 55;
            n.children.add(this.parseVarDecl());
        } else {
            n.kind = 55;
            n.children.add(this.parseStmt());
        }
        n.children.add(this.parseExpr(0));
        this.expect(106);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlock());
        return n;
    }

    private Node parseExpr(int minPrec) {
        Node lhs = this.parsePrefix();
        while (true) {
            if (this.check(100) && lhs.kind == 6) {
                Node call = new Node(); call.kind = 10;
                call.name = lhs.name;
                this.advance();
                while (!this.check(101)) {
                    call.children.add(this.parseExpr(0));
                    if (this.check(107)) { this.advance(); }
                }
                this.expect(101);
                lhs = call;
                continue;
            }
            if (this.check(104)) {
                Node idx = new Node(); idx.kind = 24;
                idx.children.add(lhs);
                this.advance();
                idx.children.add(this.parseExpr(0));
                this.expect(105);
                lhs = idx;
                continue;
            }
            if (this.check(108)) {
                this.advance();
                Token name = this.advance();
                if (this.check(100)) {
                    Node call = new Node(); call.kind = 10;
                    call.name = name.text;
                    call.children.add(lhs);
                    this.advance();
                    while (!this.check(101)) {
                        call.children.add(this.parseExpr(0));
                        if (this.check(107)) { this.advance(); }
                    }
                    this.expect(101);
                    lhs = call;
                } else {
                    Node member = new Node(); member.kind = 13;
                    member.name = name.text;
                    member.children.add(lhs);
                    lhs = member;
                }
                continue;
            }
            if (this.check(142)) {
                this.advance();
                Node add = new Node(); add.kind = 7; add.op = 1;
                Node one = new Node(); one.kind = 0; one.intVal = 1;
                add.children.add(lhs);
                add.children.add(one);
                Node assign = new Node(); assign.kind = 7; assign.op = 20;
                assign.children.add(lhs);
                assign.children.add(add);
                lhs = assign;
                continue;
            }
            if (this.check(143)) {
                this.advance();
                Node sub = new Node(); sub.kind = 7; sub.op = 2;
                Node one = new Node(); one.kind = 0; one.intVal = 1;
                sub.children.add(lhs);
                sub.children.add(one);
                Node assign = new Node(); assign.kind = 7; assign.op = 20;
                assign.children.add(lhs);
                assign.children.add(sub);
                lhs = assign;
                continue;
            }
            if (this.check(123)) {
                this.advance();
                Node thenExpr = this.parseExpr(0);
                this.expect(109);
                Node elseExpr = this.parseExpr(0);
                Node tern = new Node(); tern.kind = 65;
                tern.children.add(lhs);
                tern.children.add(thenExpr);
                tern.children.add(elseExpr);
                lhs = tern;
                continue;
            }
            int prec = this.getPrec(this.peek().kind);
            if (prec < minPrec) { break; }
            int nextMin = prec + 1;
            int op = this.peek().kind;
            this.advance();
            Node rhs = this.parseExpr(nextMin);
            Node bin = new Node(); bin.kind = 7;
            bin.op = this.tokenToOp(op);
            bin.children.add(lhs);
            bin.children.add(rhs);
            lhs = bin;
        }
        return lhs;
    }

    private int tokenToOp(int kind) {
        if (kind == 111) { return 1; }
        if (kind == 112) { return 2; }
        if (kind == 113) { return 3; }
        if (kind == 114) { return 4; }
        if (kind == 115) { return 4; }
        if (kind == 134) { return 5; }
        if (kind == 135) { return 6; }
        if (kind == 120) { return 7; }
        if (kind == 136) { return 8; }
        if (kind == 121) { return 9; }
        if (kind == 137) { return 10; }
        if (kind == 138) { return 11; }
        if (kind == 139) { return 12; }
        if (kind == 110) { return 20; }
        if (kind == 130) { return 14; }
        if (kind == 131) { return 15; }
        if (kind == 132) { return 16; }
        if (kind == 133) { return 17; }
        if (kind == 140) { return 18; }
        if (kind == 141) { return 19; }
        if (kind == 144) { return 20; }
        if (kind == 116) { return 22; }
        if (kind == 117) { return 23; }
        if (kind == 118) { return 24; }
        return 0;
    }

    private int getPrec(int kind) {
        if (kind == 110 || kind == 130 || kind == 131 || kind == 132 || kind == 133) { return 1; }
        if (kind == 139) { return 2; }
        if (kind == 138) { return 3; }
        if (kind == 135 || kind == 134) { return 4; }
        if (kind == 120 || kind == 136 || kind == 121 || kind == 137) { return 5; }
        if (kind == 117) { return 6; }
        if (kind == 116) { return 7; }
        if (kind == 140 || kind == 141) { return 8; }
        if (kind == 111 || kind == 112) { return 9; }
        if (kind == 113 || kind == 114 || kind == 115) { return 10; }
        if (kind == 144) { return 11; }
        return -1;
    }

    private Node parsePrefix() {
        Token t = this.advance();
        Node n = new Node();
        n.line = t.line; n.col = t.col;
        int kind = t.kind;

        if (kind == 1) { n.kind = 0; n.intVal = t.intVal; return n; }
        if (kind == 2) { n.kind = 1; n.floatVal = t.floatVal; return n; }
        if (kind == 3) { n.kind = 2; n.strVal = t.strVal; return n; }
        if (kind == 4) { n.kind = 3; n.charVal = t.charVal; return n; }
        if (kind == 5) {
            n.kind = 4;
            n.boolVal = t.text == "true";
            return n;
        }
        if (kind == 6) { n.kind = 5; return n; }
        if (kind == 7) { n.kind = 6; n.name = t.text; return n; }
        if (kind == 39) {
            Node ctor = new Node(); ctor.kind = 10;
            ctor.name = this.advance().text;
            this.expect(100);
            while (!this.check(101)) {
                ctor.children.add(this.parseExpr(0));
                if (this.check(107)) { this.advance(); }
            }
            this.expect(101);
            return ctor;
        }

        if (kind == 100) { n.kind = 23; n.children.add(this.parseExpr(0)); this.expect(101); return n; }
        if (kind == 102) {
            Node[] children = [];
            while (!this.check(103)) {
                children.add(this.parseExpr(0));
                if (this.check(107)) { this.advance(); }
            }
            this.expect(103);
            n.kind = 19;
            foreach (Node child in children) { n.children.add(child); }
            return n;
        }

        if (kind == 104) {
            n.kind = 19;
            while (!this.check(105)) {
                n.children.add(this.parseExpr(0));
                if (this.check(107)) { this.advance(); }
            }
            this.expect(105);
            return n;
        }

        if (kind == 112) { n.kind = 8; n.op = 0; n.children.add(this.parseExpr(10)); return n; }
        if (kind == 122) { n.kind = 8; n.op = 1; n.children.add(this.parseExpr(10)); return n; }
        if (kind == 116) { n.kind = 8; n.op = 3; n.children.add(this.parseExpr(10)); return n; }

        Node ident = new Node(); ident.kind = 6; ident.name = t.text;
        return ident;
    }

    private Node parsePattern() {
        Node n = new Node();
        Token t = this.advance();
        if (t.kind == 126) { n.name = "_"; return n; }
        if (t.kind == 1) { n.kind = 0; n.intVal = t.intVal; return n; }
        if (t.kind == 7) { n.name = t.text; return n; }
        return n;
    }
}

class Node {
    public prop int kind;
    public prop int64 intVal;
    public prop float64 floatVal;
    public prop string strVal;
    public prop char charVal;
    public prop bool boolVal;
    public prop int op;
    public prop string name;
    public prop string typeHint;
    public prop bool isMut;
    public prop bool isPublic;
    public prop bool isStatic;
    public prop string parentClass;
    public prop Node[] children;
    public prop int line;
    public prop int col;

    construct () {
        this.kind = 0; this.intVal = 0; this.floatVal = 0.0;
        this.strVal = ""; this.charVal = ' '; this.boolVal = false;
        this.op = 0; this.name = ""; this.typeHint = "";
        this.isMut = false; this.isPublic = true; this.isStatic = false;
        this.parentClass = ""; this.children = [];
        this.line = 0; this.col = 0;
    }

    public int childCount() {
        return this.children.length;
    }

    public Node child(int i) {
        if (i >= 0 && i < this.children.length) {
            return this.children[i];
        }
        return new Node();
    }
}
