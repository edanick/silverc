// A string element is a BYTE at base+index, and it is bounded by the
// string's OWN length: a string carries no length header (its length is
// computed with strlen), so the [-8] word an array carries in front of
// its elements means nothing for it.
//
// The read of an index outside the string is refused -- the catchable
// "index out of range" error -- instead of reading past the string's
// bytes, and the store of an index outside the string is refused instead
// of writing outside them. A store inside the string lands on the byte
// the read addresses: the store and the read agree on the address.

bool refusedRead(string s, int index) {
    try {
        char c = s[index];
        printline("the read of s[" + index + "] answered '" + (string)c + "'");
    } catch (Exception e) {
        return true;
    }
    return false;
}

bool refusedStore(string s, int index) {
    try {
        s[index] = 'X';
    } catch (Exception e) {
        return true;
    }
    return false;
}

void main() {
    string s = "abc";

    // The read inside the string answers the byte at that address.
    if (s[0] != 'a' || s[1] != 'b' || s[2] != 'c') {
        printline("FAIL: the string element read does not answer the byte");
        throw "the string element read does not answer the byte";
    }

    // The read past the end of the string is refused.
    if (!refusedRead(s, 5)) {
        printline("FAIL: a read past the end of a string was not refused");
        throw "a read past the end of a string was not refused";
    }

    // The read before the start of the string is refused.
    if (!refusedRead(s, -1)) {
        printline("FAIL: a read before the start of a string was not refused");
        throw "a read before the start of a string was not refused";
    }

    // The store past the end of the string is refused.
    if (!refusedStore(s, 5)) {
        printline("FAIL: a store past the end of a string was not refused");
        throw "a store past the end of a string was not refused";
    }

    // The store before the start of the string is refused.
    if (!refusedStore(s, -1)) {
        printline("FAIL: a store before the start of a string was not refused");
        throw "a store before the start of a string was not refused";
    }

    // The refused stores left the string alone.
    if (s != "abc") {
        printline("FAIL: a refused store changed the string");
        throw "a refused store changed the string";
    }

    // A store inside the string lands on the byte the read addresses.
    s[0] = 'A';
    if (s != "Abc") {
        printline("FAIL: the store did not land inside the string");
        throw "the store did not land inside the string";
    }
    if (s[0] != 'A') {
        printline("FAIL: the store did not land on the byte the read addresses");
        throw "the store did not land on the byte the read addresses";
    }

    printline("ok");
}
