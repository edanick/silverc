// Copy-on-assign for class instances (SPEC 9.2 / D11): a variable
// binding (`Box b = a`) owns its own shallow copy, so writing through
// one does not reach the other. A class value stored INTO a field slot
// keeps sharing its instance (object identity), which the emitter
// back-pointer and handler lists rely on.
class Box {
    public prop int value;
    construct(int v) { this.value = v; }
}

class Holder {
    public prop int[] data;
    construct() { this.data = [1, 2, 3]; }
}

void main() {
    // Variable declaration copy.
    Box a = new Box(1);
    Box b = a;
    b.value = 99;
    if (a.value != 1 || b.value != 99) {
        printline("class decl copy shared");
        throw "copy check failed";
    }

    // Plain assignment copy.
    Box c = new Box(7);
    Box d = new Box(0);
    d = c;
    d.value = 42;
    if (c.value != 7 || d.value != 42) {
        printline("class assign copy shared");
        throw "copy check failed";
    }

    // Field store of an array still copies the array.
    int[] src = [7, 8, 9];
    Holder h = new Holder();
    h.data = src;
    h.data[0] = 42;
    if (src[0] != 7 || h.data[0] != 42) {
        printline("array field store shared");
        throw "copy check failed";
    }

    printline("assigned class is a copy ok");
}
