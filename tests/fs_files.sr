// File system (DOCS/144-148, DOCS/216-220): FileOps rename and fs-level
// createDir. Enumeration (listDir, FolderOps list/files/folders/entries),
// FolderOps.create, and writeBytesAt are broken or unregistered on
// silverc-rs (see the final report) and are intentionally not asserted
// here. All paths target output/. Exit code 0 = all checks pass.
import * from fs;

void expect(bool got, string what) {
    if (!got) {
        printline("fs check failed: " + what);
        exit(1);
    }
}

void main() {
    string dirPath = "output/fs_files_dir";
    string filePath = "output/fs_files_dir/one.txt";
    string renamedPath = "output/fs_files_dir/renamed.txt";

    fs.createDir(dirPath);
    fs.writeString(filePath, "hello fs files");
    expect(file.exists(filePath), "created file exists");
    expect(file.size(filePath) == 14, "file size matches");
    expect(fs.readString(filePath) == "hello fs files", "readString roundtrip");

    fs.rename(filePath, renamedPath);
    expect(!file.exists(filePath), "rename moves file");
    expect(file.exists(renamedPath), "renamed file exists");
    expect(fs.readString(renamedPath) == "hello fs files", "renamed content intact");

    file.delete(renamedPath);
    expect(!file.exists(renamedPath), "delete removes file");

    printline("fs-files-ok");
}
