class StrEntry {
    public prop string text;
    public prop int dataOffset;

    construct (string t) {
        this.text = t;
        this.dataOffset = 0;
    }
}

void main() {
    StrEntry[] arr;
    arr = [];
    StrEntry e;
    e = new StrEntry("hello");
    e.dataOffset = 42;
    arr.add(e);

    print("text=");
    print(arr[0].text);
    print(" dataOffset=");
    printline(arr[0].dataOffset);
}
