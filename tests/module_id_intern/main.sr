// Module-id interning fixture (MEMORY.md §3.2 row 7 / M3, caveat-10
// contract): Node.srcModule is now an interned int id (0 = entry) instead
// of one module-path string per top-level item, and MiniCg compares ids
// (funcModules / funcModuleMatches) instead of strings. This program pins
// the behaviour the ids carry, all of which must resolve byte-identically
// to the pre-fix string build:
// - two modules exporting the same top-level name (`alpha.pick` /
//   `beta.pick`): a module-qualified call binds its own module's body;
// - an inline `mod stats { ... }` block (the parser's item.name arm);
// - a case-variant qualifier (`LLMAI.ping()` for `mod export llmai`): the
//   funcModuleMatches case-insensitive fallback still lands.
mod export alpha;

int pick() {
    return 1;
}

mod export beta;

int pick() {
    return 2;
}

mod export llmai;

int ping() {
    return 7;
}

mod stats {
    int bonus(int v) {
        return v + 100;
    }
}

mod export gamma;

void main() {
    int a = alpha.pick();
    int b = beta.pick();
    int p = LLMAI.ping();
    int s = stats.bonus(5);
    int total = a + b * 10 + p + s;
    if (total != 133) {
        exit(1);
    }
    printline("module-id-ok 133");
}
