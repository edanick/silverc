import json;
import yaml;

void main() {
    string yamlData = "name: Alice\nage: 30\n";
    object parsedYaml = yaml.parse(yamlData);
    printline("name = " + parsedYaml.name);

    string jsonData = "{\"name\": \"Alice\", \"age\": 30}";
    object parsedJson = json.parse(jsonData);
    printline("name = " + parsedJson.name);

    if (parsedJson.name != "Alice") {
        printline("json parse result wrong: " + parsedJson.name);
        exit(1);
    }
}
