import * from fs;

void main() {
    string message = "UTF-8: 你好, café, 😀";
    printline(message);

    // Text APIs preserve UTF-8 bytes by default and do not add a BOM.
    file.writeString("utf8_text_roundtrip.txt", "你好, café, 😀");
    string textRoundtrip = file.readString("utf8_text_roundtrip.txt");

    // Binary APIs preserve the same UTF-8 bytes exactly.
    int[] bytes = [0xE4, 0xBD, 0xA0, 0xE5, 0xA5, 0xBD, 0x2C, 0x20, 0x63, 0x61, 0x66, 0xC3, 0xA9, 0x2C, 0x20, 0xF0, 0x9F, 0x98, 0x80];
    file.writeBytes("utf8_io_roundtrip.txt", bytes);
    string byteRoundtrip = file.readString("utf8_io_roundtrip.txt");

    // Compare every UTF-8 byte, not only a prefix. This is supported by both
    // the native and self-hosting compilers without relying on string equality.
    bool exact = textRoundtrip.length == 19 && byteRoundtrip.length == 19;
    int[] expected = [0xE4, 0xBD, 0xA0, 0xE5, 0xA5, 0xBD, 0x2C, 0x20, 0x63, 0x61, 0x66, 0xC3, 0xA9, 0x2C, 0x20, 0xF0, 0x9F, 0x98, 0x80];
    for (int i = 0; i < 19; i = i + 1) {
        if (textRoundtrip[i] != expected[i] || byteRoundtrip[i] != expected[i]) {
            exact = false;
        }
    }

    if (exact) {
        printline("UTF-8 IO OK");
        exit(0);
    }
    printline("UTF-8 IO FAILED");
    exit(1);
}
