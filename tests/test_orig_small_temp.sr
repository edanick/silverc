mod export compiler;

import * from fs;

void main() {
    string inputFile = "tests/test_orig.sr";
    string outputFile = "test_compiler3.exe";
string source = file.readString(inputFile);
    printline("read");

    Lexer lexer;
    lexer = new Lexer(source);

    Token[] tokens;
    tokens = lexer.tokenize();
    printline("tokens done");
    printline(tokens.length);

    Parser parser;
    parser = new Parser(tokens);

    Node[] ast;
    ast = parser.parseProgram();
    printline("parsed");

    MiniAsm asm;
    asm = new MiniAsm();

    MiniCg cg;
    cg = new MiniCg(asm);

cg.genProgram(ast);
    printline("codegen done");

        cg.getStringData();

    MiniPe pe;
    pe = new MiniPe();

    int[] codeBytes = asm.getBytes();
    printline(codeBytes.length);
    pe.code = codeBytes;
    pe.entryRva = 0x1000 + cg.mainLabelOffset;

    for (int i = 0; i < cg.importDlls.length; i++) {
        pe.addImport(cg.importDlls[i], cg.importFuncs[i]);
    }

int[] stringData = cg.stringData;

        int rdataRva = pe.computeRdataRva();
        int[] layout = pe.computeLayout(stringData.length);
        int stringsStart = layout[0];
        int[] iatAddrs = cg.computeIatAddresses(layout);

        int[] finalCode = asm.getBytes();
    pe.code = finalCode;

    cg.patchForwardCalls(finalCode);

    cg.patchStringRefs(finalCode, stringsStart, rdataRva);
    cg.patchImportRefs(finalCode, iatAddrs, rdataRva);

int[] peData = pe.build(finalCode, stringData);
        printline("pe built");
        printline(peData.length);
        file.writeBytes(outputFile, peData);
        printline("written");
    }

class MiniAsm {
    public prop int[] buf;
    public prop int[] labelPositions;
    public prop int[] relocLabelIds;
    public prop int[] relocOffsets;
    public prop int[] relocIs32;
    public prop int resolved;

    construct () {
        this.buf = [];
        this.labelPositions = [];
        this.relocLabelIds = [];
        this.relocOffsets = [];
        this.relocIs32 = [];
        this.resolved = 0;
    }

    public void emitU8(int b) {
        this.buf.add(b & 0xFF);
    }

    public void emitU16(int v) {
        this.emitU8(v);
        this.emitU8(v >> 8);
    }

    public void emitU32(int v) {
        this.emitU8(v);
        this.emitU8(v >> 8);
        this.emitU8(v >> 16);
        this.emitU8(v >> 24);
    }

    public void emitU64(int64 v) {
        this.emitU32(v & 0xFFFFFFFF);
        this.emitU32((v >> 32) & 0xFFFFFFFF);
    }

    public void emitBytes(int[] data) {
        for (int i = 0; i < data.length; i++) {
            this.emitU8(data[i]);
        }
    }

    public int[] getBytes() {
        this.resolveRelocs();
        return this.buf;
    }

    public void emitImm64(int reg, int64 imm) {
        this.buf.add(0x48);
        this.buf.add(0xB8 + (reg & 7));
        for (int b = 0; b < 8; b++) {
            this.buf.add((imm >> (b * 8)) & 0xFF);
        }
    }

    public void pushR64(int r) {
        int opcode = 0x50 + (r & 7);
        if (r > 7) { this.emitU8(0x41); }
        this.emitU8(opcode);
    }

    public void popR64(int r) {
        if (r > 7) { this.emitU8(0x41); }
        this.emitU8(0x58 + (r & 7));
    }

    public void movRR64(int dst, int src) {
        int rFlag = src > 7 ? 1 : 0;
        int sFlag = dst > 7 ? 1 : 0;
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x89);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void movRI64(int dst, int64 imm) {
        int dFlag = dst > 7 ? 1 : 0;
        this.emitU8(0x48 | dFlag);
        this.emitU8(0xB8 + (dst & 7));
        int lo = imm & 0xFFFFFFFF;
        this.emitU8(lo);
        this.emitU8(lo >> 8);
        this.emitU8(lo >> 16);
        this.emitU8(lo >> 24);
        int hi = (imm >> 32) & 0xFFFFFFFF;
        this.emitU8(hi);
        this.emitU8(hi >> 8);
        this.emitU8(hi >> 16);
        this.emitU8(hi >> 24);
    }

    public void movRMBase(int r, int base, int disp) {
        int rex = 0x48;
        if (r > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x8B);
        if (base == 5 || base == 13) {
            this.emitU8(0x85 | ((r & 7) << 3) | (base & 7));
            this.emitU32(disp);
        } elif (base == 4 || base == 12) {
            if (disp >= -128 && disp <= 127) {
                this.emitU8(0x44 | ((r & 7) << 3));
                this.emitU8(0x24);
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x84 | ((r & 7) << 3));
                this.emitU8(0x24);
                this.emitU32(disp);
            }
        } else {
            if (disp == 0 && base != 5 && base != 13) {
                this.emitU8(((r & 7) << 3) | (base & 7));
            } elif (disp >= -128 && disp <= 127) {
                this.emitU8(0x40 | ((r & 7) << 3) | (base & 7));
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x80 | ((r & 7) << 3) | (base & 7));
                this.emitU32(disp);
            }
        }
    }

    public void movMBaseR(int base, int r, int disp) {
        int rex = 0x48;
        if (r > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x89);
        if (base == 5 || base == 13) {
            this.emitU8(0x85 | ((r & 7) << 3) | (base & 7));
            this.emitU32(disp);
        } elif (base == 4 || base == 12) {
            if (disp >= -128 && disp <= 127) {
                this.emitU8(0x44 | ((r & 7) << 3));
                this.emitU8(0x24);
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x84 | ((r & 7) << 3));
                this.emitU8(0x24);
                this.emitU32(disp);
            }
        } else {
            if (disp == 0 && base != 5 && base != 13) {
                this.emitU8(((r & 7) << 3) | (base & 7));
            } elif (disp >= -128 && disp <= 127) {
                this.emitU8(0x40 | ((r & 7) << 3) | (base & 7));
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x80 | ((r & 7) << 3) | (base & 7));
                this.emitU32(disp);
            }
        }
    }

    public void subRI32(int r, int imm) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        if (imm >= -128 && imm <= 127) {
            this.emitU8(0x83);
            this.emitU8(0xE8 | (r & 7));
            this.emitU8(imm & 0xFF);
        } else {
            this.emitU8(0x81);
            this.emitU8(0xE8 | (r & 7));
            this.emitU32(imm);
        }
    }

    public void addRI32(int r, int imm) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        if (imm >= -128 && imm <= 127) {
            this.emitU8(0x83);
            this.emitU8(0xC0 | (r & 7));
            this.emitU8(imm & 0xFF);
        } else {
            this.emitU8(0x81);
            this.emitU8(0xC0 | (r & 7));
            this.emitU32(imm);
        }
    }

    public void xorRR64(int dst, int src) {
        int rFlag = src > 7 ? 1 : 0;
        int sFlag = dst > 7 ? 1 : 0;
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x31);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void andRImm(int r, int imm) {
        this.emitU8(0x48 | (r > 7 ? 1 : 0));
        if (imm >= -128 && imm <= 127) {
            this.emitU8(0x83);
            this.emitU8(0xE0 | (r & 7));
            this.emitU8(imm & 0xFF);
        } else {
            this.emitU8(0x81);
            this.emitU8(0xE0 | (r & 7));
            this.emitU32(imm);
        }
    }

    public void emitCallSetup(int extraBytes) {
        this.pushR64(13);
        this.movRR64(13, 4);
        this.andRImm(4, -16);
        int total = 32 + extraBytes;
        int alignedTotal = ((total + 15) / 16) * 16;
        this.subRI32(4, alignedTotal);
    }

    public void emitCallTeardown() {
        this.movRR64(4, 13);
        this.popR64(13);
    }

    public void cmpRI32(int r, int imm) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        if (imm >= -128 && imm <= 127) {
            this.emitU8(0x83);
            this.emitU8(0xF8 | (r & 7));
            this.emitU8(imm & 0xFF);
        } else {
            this.emitU8(0x81);
            this.emitU8(0xF8 | (r & 7));
            this.emitU32(imm);
        }
    }

    public void cmpRR64(int r1, int r2) {
        int rex = 0x48;
        if (r2 > 7) { rex = rex + 4; }
        if (r1 > 7) { rex = rex + 1; }
        this.emitU8(rex);
        this.emitU8(0x39);
        this.emitU8(0xC0 | ((r2 & 7) << 3) | (r1 & 7));
    }

    public void ret() {
        this.emitU8(0xC3);
    }

    public void callR64(int r) {
        if (r > 7) { this.emitU8(0x41); }
        this.emitU8(0xFF);
        this.emitU8(0xD0 | (r & 7));
    }

    public void leaRBase(int dst, int base, int disp) {
        int rex = 0x48;
        if (dst > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x8D);
        if (base == 4 || base == 12) {
            this.emitU8(0x80 | ((dst & 7) << 3) | 0x04);
            this.emitU8(0x24);
            this.emitU32(disp);
        } elif (base == 5 || base == 13) {
            this.emitU8(0x85 | ((dst & 7) << 3) | (base & 7));
            this.emitU32(disp);
        } else {
            if (disp == 0) {
                this.emitU8(((dst & 7) << 3) | (base & 7));
            } elif (disp >= -128 && disp <= 127) {
                this.emitU8(0x40 | ((dst & 7) << 3) | (base & 7));
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x80 | ((dst & 7) << 3) | (base & 7));
                this.emitU32(disp);
            }
        }
    }

    public void addRR64(int dst, int src) {
        int rFlag = src > 7 ? 1 : 0;
        int sFlag = dst > 7 ? 1 : 0;
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x01);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void shlR64Imm(int reg, int imm) {
        int rFlag = reg > 7 ? 1 : 0;
        this.emitU8(0x48 | (rFlag << 2));
        this.emitU8(0xC1);
        this.emitU8(0xE0 | (reg & 7));
        this.emitU8(imm & 0xFF);
    }

    public void movByteMBaseIdxR(int base, int index, int src) {
        int rb = base > 7 ? 1 : 0;
        int ri = index > 7 ? 1 : 0;
        int rs = src > 7 ? 1 : 0;
        int rex = 0x40 | (rs << 2) | (ri << 1) | rb;
        this.emitU8(rex);
        this.emitU8(0x88);
        if (base == 5 || base == 13) {
            this.emitU8(0x44 | ((src & 7) << 3));
            this.emitU8(((index & 7) << 3) | (base & 7));
            this.emitU8(0);
        } else {
            this.emitU8(0x04 | ((src & 7) << 3));
            this.emitU8(((index & 7) << 3) | (base & 7));
        }
    }

    public void movRImm32(int dst, int imm) {
        if (dst > 7) { this.emitU8(0x41); }
        this.emitU8(0xB8 + (dst & 7));
        this.emitU32(imm);
    }

    public void movRMBaseDisp8(int r, int base, int disp) {
        int rex = 0x48;
        if (r > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x8B);
        this.emitU8(0x40 | ((r & 7) << 3) | (base & 7));
        this.emitU8(disp & 0xFF);
    }

    public void orRR64(int dst, int src) {
        int rFlag = src > 7 ? 1 : 0;
        int sFlag = dst > 7 ? 1 : 0;
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x09);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void andRR64(int dst, int src) {
        int rFlag = src > 7 ? 1 : 0;
        int sFlag = dst > 7 ? 1 : 0;
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x21);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void imulRR64(int dst, int src) {
        int rFlag = src > 7 ? 1 : 0;
        int sFlag = dst > 7 ? 1 : 0;
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x0F);
        this.emitU8(0xAF);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void syscall() {
        this.emitU8(0x0F);
        this.emitU8(0x05);
    }

    public void cdq() {
        this.emitU8(0x99);
    }

    public void cqo() {
        this.emitU8(0x48);
        this.emitU8(0x99);
    }

    public void idivR64(int r) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        this.emitU8(0xF7);
        this.emitU8(0xF8 | (r & 7));
    }

    public void negR64(int r) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        this.emitU8(0xF7);
        this.emitU8(0xD8 | (r & 7));
    }

    public void incR64(int r) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        this.emitU8(0xFF);
        this.emitU8(0xC0 | (r & 7));
    }

    public void decR64(int r) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        this.emitU8(0xFF);
        this.emitU8(0xC8 | (r & 7));
    }

    public void shlRCl64(int r) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        this.emitU8(0xD3);
        this.emitU8(0xE0 | (r & 7));
    }

    public void shrRCl64(int r) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        this.emitU8(0xD3);
        this.emitU8(0xE8 | (r & 7));
    }

    public void movzxRR64(int dst, int src) {
        int rex = 0x48;
        if (dst > 7) { rex = rex | 0x04; }
        if (src > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x0F);
        this.emitU8(0xB6);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void setCC64(int cc, int r) {
        this.emitU8(0x0F);
        if (cc == 0) { this.emitU8(0x94); }
        elif (cc == 1) { this.emitU8(0x95); }
        elif (cc == 2) { this.emitU8(0x9C); }
        elif (cc == 3) { this.emitU8(0x9D); }
        elif (cc == 4) { this.emitU8(0x9E); }
        elif (cc == 5) { this.emitU8(0x9F); }
        this.emitU8(0xC0 | (r & 7));
    }

    public void jmpR64(int r) {
        if (r > 7) { this.emitU8(0x41); }
        this.emitU8(0xFF);
        this.emitU8(0xE0 | (r & 7));
    }

    public void movRMBaseIdx64(int r, int base, int idx, int scale, int disp) {
        int rex = 0x48;
        if (r > 7) { rex = rex | 0x04; }
        if (idx > 7) { rex = rex | 0x02; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x8B);
        this.emitU8(0x84 | ((r & 7) << 3) | 0x04);
        this.emitU8((scale << 6) | ((idx & 7) << 3) | (base & 7));
        this.emitU32(disp);
    }

    public void movMBaseIdxR64(int base, int idx, int scale, int r, int disp) {
        int rex = 0x48;
        if (r > 7) { rex = rex | 0x04; }
        if (idx > 7) { rex = rex | 0x02; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x89);
        this.emitU8(0x84 | ((r & 7) << 3) | 0x04);
        this.emitU8((scale << 6) | ((idx & 7) << 3) | (base & 7));
        this.emitU32(disp);
    }

    public void nop() {
        this.emitU8(0x90);
    }

    public void int3() {
        this.emitU8(0xCC);
    }

    public void emitPrologue(int stackSize) {
        this.pushR64(5);
        this.movRR64(5, 4);
        if (stackSize > 0) {
            this.subRI32(4, stackSize);
        }
    }

    public void emitEpilogue(int stackSize) {
        if (stackSize > 0) {
            this.addRI32(4, stackSize);
        }
        this.popR64(5);
        this.ret();
    }

    public void subRR64(int dst, int src) {
        int rFlag = src > 7 ? 1 : 0;
        int sFlag = dst > 7 ? 1 : 0;
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x29);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void mulRR64(int src) {
        int sFlag = src > 7 ? 1 : 0;
        if (sFlag != 0) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        this.emitU8(0xF7);
        this.emitU8(0xE0 | (src & 7));
    }

    public void label(string name) {
    }

    public int createLabel() {
        int id = this.labelPositions.length;
        this.labelPositions.add(-1);
        return id;
    }

    public void bindLabel(int id) {
        this.labelPositions[id] = this.buf.length;
    }

    public int getLabelOffset(int id) {
        if (id < this.labelPositions.length && this.labelPositions[id] >= 0) {
            return this.labelPositions[id];
        }
        return 0;
    }

    public void addReloc(int labelId, int offset, int is32) {
        this.relocLabelIds.add(labelId);
        this.relocOffsets.add(offset);
        this.relocIs32.add(is32);
    }

    public void jeLabel(int id) {
        this.emitU8(0x0F);
        this.emitU8(0x84);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void jneLabel(int id) {
        this.emitU8(0x0F);
        this.emitU8(0x85);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void jmpLabel(int id) {
        this.emitU8(0xE9);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void jlLabel(int id) {
        this.emitU8(0x0F);
        this.emitU8(0x8C);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void jleLabel(int id) {
        this.emitU8(0x0F);
        this.emitU8(0x8E);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void jgLabel(int id) {
        this.emitU8(0x0F);
        this.emitU8(0x8F);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void jgeLabel(int id) {
        this.emitU8(0x0F);
        this.emitU8(0x8D);
        this.addReloc(id, this.buf.length, 1);
        this.emitU32(0);
    }

    public void resolveRelocs() {
        if (this.resolved == 1) { return; }
        this.resolved = 1;
        for (int i = 0; i < this.relocLabelIds.length; i++) {
            int labelId = this.relocLabelIds[i];
            int offset = this.relocOffsets[i];
            int is32 = this.relocIs32[i];
            int target = this.labelPositions[labelId];
            if (is32 == 1) {
                int cur = offset + 4;
                int disp = target - cur;
                this.buf[offset] = disp & 0xFF;
                this.buf[offset + 1] = (disp >> 8) & 0xFF;
                this.buf[offset + 2] = (disp >> 16) & 0xFF;
                this.buf[offset + 3] = (disp >> 24) & 0xFF;
            } else {
                int cur = offset + 1;
                int disp = target - cur;
                this.buf[offset] = disp & 0xFF;
            }
        }
    }

    public void resolveRelocations() {
        this.resolveRelocs();
    }

    public void callRel32(int rel32) {
        this.emitU8(0xE8);
        this.emitU32(rel32);
    }
}

class StrEntry {
    public prop string text;
    public prop int dataOffset;

    construct (string text) {
        this.text = text;
        this.dataOffset = 0;
    }
}

class MiniCg {
    public prop MiniAsm asm;
    public prop StrEntry[] strings;
    public prop int[] stringData;
    public prop int mainLabelOffset;
    public prop string[] funcNames;
    public prop int[] funcOffsets;
    public prop int[] localOffsets;
    public prop string[] localNames;
    public prop int stackSize;
    public prop int[] stringPatchOffsets;
    public prop int[] stringPatchIndices;
    public prop int[] importPatchOffsets;
    public prop int[] importPatchDllIndices;
    public prop int[] importPatchFuncIndices;
    public prop string[] importDlls;
    public prop string[] importFuncs;
    public prop int[] loopStartStack;
    public prop int[] loopEndStack;
    public prop int labelCounter;
    public prop int[] stringOffsets;
    public prop string[] funcCallArgTemps;
    public prop int funcCallArgCount;
    public prop int retValOff;
    public prop string[] classNames;
    public prop int[] classFieldStarts;
    public prop int[] classFieldCounts;
    public prop string[] classFieldNames;
    public prop int[] classFieldOffsets;
    public prop string[] classFieldTypes;
    public prop string[] methodClassNames;
    public prop string[] methodNames;
    public prop string currentClassName;
    public prop string[] localTypes;
    public prop int[] forwardCalls;
    public prop string[] forwardCallNames;

    construct (MiniAsm asm) {
        this.asm = asm;
        this.strings = [];
        this.stringData = [];
        this.mainLabelOffset = 0;
        this.funcNames = [];
        this.funcOffsets = [];
        this.localOffsets = [];
        this.localNames = [];
        this.stackSize = 0;
        this.stringPatchOffsets = [];
        this.stringPatchIndices = [];
        this.importPatchOffsets = [];
        this.importPatchDllIndices = [];
        this.importPatchFuncIndices = [];
        this.importDlls = [];
        this.importFuncs = [];
        this.loopStartStack = [];
        this.loopEndStack = [];
        this.labelCounter = 0;
        this.stringOffsets = [];
        this.funcCallArgTemps = [];
        this.funcCallArgCount = 0;
        this.retValOff = 0;
        this.classNames = [];
        this.classFieldStarts = [];
        this.classFieldCounts = [];
        this.classFieldNames = [];
        this.classFieldOffsets = [];
        this.classFieldTypes = [];
        this.methodClassNames = [];
        this.methodNames = [];
        this.currentClassName = "";
        this.localTypes = [];
        this.forwardCalls = [];
        this.forwardCallNames = [];
    }

    public void collectClassLayouts(Node[] program) {
        for (int i = 0; i < program.length; i++) {
            Node item = program[i];
            if (item.kind == 102) {
                this.classNames.add(item.name);
                int start = this.classFieldNames.length;
                this.classFieldStarts.add(start);
                int cnt = 0;
                for (int j = 0; j < item.childCount(); j++) {
                    Node member = item.child(j);
                    if (member.kind == 50) {
                        this.classFieldNames.add(member.name);
                        this.classFieldOffsets.add(cnt * 8);
                        this.classFieldTypes.add(member.typeHint);
                        cnt = cnt + 1;
                    }
                }
                this.classFieldCounts.add(cnt);
                for (int j = 0; j < item.childCount(); j++) {
                    Node member = item.child(j);
                    if (member.kind == 100) {
                        this.methodNames.add(member.name);
                        this.methodClassNames.add(item.name);
                    }
                }
            }
        }
    }

    public int findFieldOffset(string className, string fieldName) {
        int start = -1;
        int cnt = 0;
        for (int i = 0; i < this.classNames.length; i++) {
            if (this.strEq(this.classNames[i], className)) {
                start = this.classFieldStarts[i];
                cnt = this.classFieldCounts[i];
            }
        }
        if (start < 0) { return -1; }
        for (int i = 0; i < cnt; i++) {
            if (this.strEq(this.classFieldNames[start + i], fieldName)) {
                return this.classFieldOffsets[start + i];
            }
        }
        return -1;
    }

    public string findFieldType(string className, string fieldName) {
        int start = -1;
        int cnt = 0;
        for (int i = 0; i < this.classNames.length; i++) {
            if (this.strEq(this.classNames[i], className)) {
                start = this.classFieldStarts[i];
                cnt = this.classFieldCounts[i];
            }
        }
        if (start < 0) { return ""; }
        for (int i = 0; i < cnt; i++) {
            if (this.strEq(this.classFieldNames[start + i], fieldName)) {
                return this.classFieldTypes[start + i];
            }
        }
        return "";
    }

    public string getLocalType(string name) {
        for (int i = 0; i < this.localNames.length; i++) {
            if (this.strEq(this.localNames[i], name)) {
                if (i < this.localTypes.length) {
                    return this.localTypes[i];
                }
                return "";
            }
        }
        return "";
    }

    public void setLocalType(string name, string typeName) {
        for (int i = 0; i < this.localNames.length; i++) {
            if (this.strEq(this.localNames[i], name)) {
                while (this.localTypes.length <= i) {
                    this.localTypes.add("");
                }
                this.localTypes[i] = typeName;
                return;
            }
        }
    }

    public string arrayElementType(string arrType) {
        if (arrType.length >= 2) {
            int len = arrType.length;
            string result = "";
            int i = 0;
            while (i + 1 < len) {
                if (arrType[i] == '[' && arrType[i+1] == ']') {
                    return result;
                }
                result = result + arrType[i];
                i = i + 1;
            }
            return result;
        }
        return "";
    }

    public int newLabel() {
        return this.asm.createLabel();
    }

    public int addString(string s) {
        for (int i = 0; i < this.strings.length; i++) {
            StrEntry se = this.strings[i];
            if (this.strEq(se.text, s)) {
                return i;
            }
        }
        int off = this.stringData.length;
        for (int i = 0; i < s.length; i++) {
            int ch = s[i];
            this.stringData.add(ch);
        }
        this.stringData.add(0);
        StrEntry e;
        e = new StrEntry(s);
        e.dataOffset = off;
        this.strings.add(e);
        return this.strings.length - 1;
    }

    public int[] getStringData() {
        return this.stringData;
    }

    public int findImport(string dll, string name) {
        for (int i = 0; i < this.importDlls.length; i++) {
            if (this.strEq(this.importDlls[i], dll) && this.strEq(this.importFuncs[i], name)) {
                return i;
            }
        }
        this.importDlls.add(dll);
        this.importFuncs.add(name);
        return this.importDlls.length - 1;
    }

    public int addImportPatch(string dll, string name) {
        int idx = this.findImport(dll, name);
        this.importPatchOffsets.add(this.asm.buf.length + 2);
        this.importPatchDllIndices.add(-1);
        this.importPatchFuncIndices.add(idx);
        return idx;
    }

    public bool strEq(string a, string b) {
        if (a.length != b.length) { return false; }
        for (int i = 0; i < a.length; i++) {
            if (a[i] != b[i]) { return false; }
        }
        return true;
    }

    public int findLocal(string name) {
        for (int i = 0; i < this.localNames.length; i++) {
            if (this.strEq(this.localNames[i], name)) {
                return this.localOffsets[i];
            }
        }
        return 0;
    }

    public int allocLocal(string name) {
        this.stackSize += 8;
        int off = -8 * (this.localOffsets.length + 1);
        this.localOffsets.add(off);
        this.localNames.add(name);
        return off;
    }

    public void emitPrologue() {
        this.asm.pushR64(5);
        this.asm.movRR64(5, 4);
        this.asm.subRI32(4, 32);
        this.asm.pushR64(15);
        this.asm.pushR64(13);
        this.asm.pushR64(12);
        this.asm.movRR64(15, 4);
    }

    public void emitEpilogue() {
        this.asm.popR64(12);
        this.asm.popR64(13);
        this.asm.popR64(15);
        this.asm.addRI32(4, this.stackSize);
        this.asm.popR64(5);
        this.asm.ret();
    }

    public int[] computeIatAddresses(int[] layout) {
        int stringsStart = layout[0];
        int numGroups = layout[1];
        int iltTotal = layout[2];
        int[] iatAddrs = [];
        for (int i = 0; i < this.importDlls.length; i++) {
            iatAddrs.add(0);
        }
        string[] uniqueDlls = [];
        int[] groupSizes = [];
        int[] importGroupIdx = [];
        for (int i = 0; i < this.importDlls.length; i++) {
            int gIdx = -1;
            for (int j = 0; j < uniqueDlls.length; j++) {
                if (this.strEq(uniqueDlls[j], this.importDlls[i])) {
                    gIdx = j;
                    break;
                }
            }
            if (gIdx < 0) {
                uniqueDlls.add(this.importDlls[i]);
                groupSizes.add(0);
                gIdx = uniqueDlls.length - 1;
            }
            groupSizes[gIdx] = groupSizes[gIdx] + 1;
            importGroupIdx.add(gIdx);
        }
        int[] posInGroup = [];
        for (int i = 0; i < this.importDlls.length; i++) {
            posInGroup.add(0);
        }
        int[] runningCount = [];
        for (int g = 0; g < uniqueDlls.length; g++) {
            runningCount.add(0);
        }
        for (int i = 0; i < this.importDlls.length; i++) {
            int g = importGroupIdx[i];
            posInGroup[i] = runningCount[g];
            runningCount[g] = runningCount[g] + 1;
        }
        int[] groupStart = [];
        int runningOff = 0;
        for (int g = 0; g < uniqueDlls.length; g++) {
            groupStart.add(runningOff);
            runningOff = runningOff + groupSizes[g] * 8 + 8;
        }
        int descBytes = (numGroups + 1) * 20;
        for (int i = 0; i < this.importDlls.length; i++) {
            int g = importGroupIdx[i];
            iatAddrs[i] = descBytes + iltTotal + groupStart[g] + posInGroup[i] * 8;
        }
        return iatAddrs;
    }

    public void patchImportRefs(int[] code, int[] iatAddrs, int rdataRva) {
        for (int i = 0; i < this.importPatchOffsets.length; i++) {
            int patchPos = this.importPatchOffsets[i];
            int funcIdx = this.importPatchFuncIndices[i];
            int iatOff = iatAddrs[funcIdx];
            int64 addr = 0x140000000 + rdataRva + iatOff;
            code[patchPos] = addr & 0xFF;
            code[patchPos + 1] = (addr >> 8) & 0xFF;
            code[patchPos + 2] = (addr >> 16) & 0xFF;
            code[patchPos + 3] = (addr >> 24) & 0xFF;
            code[patchPos + 4] = (addr >> 32) & 0xFF;
            code[patchPos + 5] = (addr >> 40) & 0xFF;
            code[patchPos + 6] = (addr >> 48) & 0xFF;
            code[patchPos + 7] = (addr >> 56) & 0xFF;
        }
    }

    public void patchStringRefs(int[] code, int stringsStart, int rdataRva) {
        for (int i = 0; i < this.stringPatchOffsets.length; i++) {
            int patchPos = this.stringPatchOffsets[i];
int strIdx = this.stringPatchIndices[i];
        StrEntry se2 = this.strings[strIdx];
        int dataOff = se2.dataOffset;
            int64 addr = 0x140000000 + rdataRva + stringsStart + dataOff;
            code[patchPos] = addr & 0xFF;
            code[patchPos + 1] = (addr >> 8) & 0xFF;
            code[patchPos + 2] = (addr >> 16) & 0xFF;
            code[patchPos + 3] = (addr >> 24) & 0xFF;
            code[patchPos + 4] = (addr >> 32) & 0xFF;
            code[patchPos + 5] = (addr >> 40) & 0xFF;
            code[patchPos + 6] = (addr >> 48) & 0xFF;
            code[patchPos + 7] = (addr >> 56) & 0xFF;
        }
    }

    public void genProgram(Node[] program) {
        this.collectClassLayouts(program);
        for (int i = 0; i < program.length; i++) {
            Node pi = program[i];
            if (pi.kind == 100) {
                this.funcNames.add(pi.name);
                this.funcOffsets.add(-1);
            }
        }
        for (int i = 0; i < program.length; i++) {
            Node pi2 = program[i];
            if (pi2.kind == 102) {
                for (int j = 0; j < pi2.childCount(); j++) {
                    Node member = pi2.child(j);
                    if (member.kind == 100) {
                        this.funcNames.add(member.name);
                        this.funcOffsets.add(-1);
                    }
                }
            }
        }
        for (int i = 0; i < program.length; i++) {
            Node pi3 = program[i];
            if (pi3.kind == 100) {
                this.emitFunction(pi3);
            }
        }
        for (int i = 0; i < program.length; i++) {
            Node pi4 = program[i];
            if (pi4.kind == 102) {
                for (int j = 0; j < pi4.childCount(); j++) {
                    Node member = pi4.child(j);
                    if (member.kind == 100) {
                        this.emitFunction(member);
                    }
                }
            }
        }
    }

    public void patchForwardCalls(int[] code) {
        for (int i = 0; i < this.forwardCalls.length; i++) {
            int patchPos = this.forwardCalls[i];
            string targetName = this.forwardCallNames[i];
            int targetOff = -1;
            for (int j = 0; j < this.funcNames.length; j++) {
                if (this.strEq(this.funcNames[j], targetName)) {
                    targetOff = this.funcOffsets[j];
                }
            }
            if (targetOff >= 0) {
                int rel32 = targetOff - (patchPos + 4);
                code[patchPos] = rel32 & 0xFF;
                code[patchPos + 1] = (rel32 >> 8) & 0xFF;
                code[patchPos + 2] = (rel32 >> 16) & 0xFF;
                code[patchPos + 3] = (rel32 >> 24) & 0xFF;
            }
        }
    }

public void emitFunction(Node func) {
    if (this.strEq(func.name, "main")) {
        this.mainLabelOffset = this.asm.buf.length;
    }
    int emitIdx = -1;
    for (int fi = 0; fi < this.funcNames.length; fi++) {
        if (this.funcOffsets[fi] == -1 && this.strEq(this.funcNames[fi], func.name)) {
            emitIdx = fi;
            break;
        }
    }
    if (emitIdx >= 0) {
        this.funcOffsets[emitIdx] = this.asm.buf.length;
    } else {
        this.funcNames.add(func.name);
        this.funcOffsets.add(this.asm.buf.length);
    }
    this.localOffsets = [];
    this.localNames = [];
    this.stackSize = 0;
    string savedClass = this.currentClassName;
    this.currentClassName = "";
    this.asm.label(func.name);
    this.asm.pushR64(5);
    this.asm.movRR64(5, 4);
        int isMethod = 0;
        for (int i = 0; i < this.methodNames.length; i++) {
            if (this.strEq(this.methodNames[i], func.name)) {
                this.currentClassName = this.methodClassNames[i];
                isMethod = 1;
            }
        }
        if (isMethod == 1) {
            this.allocLocal("this");
        }
        if (func.childCount() > 1) {
            Node body = func.child(1);
            this.allocLocals(body);
            int initialStackSize = this.stackSize;
            int subRspPatchPos = -1;
            this.asm.emitU8(0x48);
            this.asm.emitU8(0x81);
            this.asm.emitU8(0xEC);
            this.asm.emitU32(this.stackSize);
            subRspPatchPos = this.asm.buf.length - 4;
            if (isMethod == 1) {
                int thisOff = this.findLocal("this");
                this.asm.movMBaseR(5, 1, thisOff);
            }
            if (body.kind == 16) {
                this.genBlock(body);
            } elif (body.kind == 61) {
                this.genStmt(body);
            }
            if (this.stackSize != initialStackSize) {
                this.asm.buf[subRspPatchPos] = (this.stackSize) & 0xFF;
                this.asm.buf[subRspPatchPos+1] = (this.stackSize >> 8) & 0xFF;
                this.asm.buf[subRspPatchPos+2] = (this.stackSize >> 16) & 0xFF;
                this.asm.buf[subRspPatchPos+3] = (this.stackSize >> 24) & 0xFF;
            }
            this.asm.addRI32(4, this.stackSize);
        } else {
            if (this.stackSize > 0) {
                this.asm.subRI32(4, this.stackSize);
            }
            if (isMethod == 1) {
                int thisOff = this.findLocal("this");
                this.asm.movMBaseR(5, 1, thisOff);
            }
            if (this.stackSize > 0) {
                this.asm.addRI32(4, this.stackSize);
            }
        }
        this.asm.popR64(5);
        this.asm.ret();
        this.currentClassName = savedClass;
    }

    public void allocLocals(Node node) {
    if (node.kind == 50) {
        this.allocLocal(node.name);
        while (this.localTypes.length < this.localNames.length) {
            this.localTypes.add("");
        }
            if (this.localTypes.length > 0) {
                this.localTypes[this.localTypes.length - 1] = node.typeHint;
            }
        }
        for (int i = 0; i < node.childCount(); i++) {
            this.allocLocals(node.child(i));
        }
    }

    public void genBlock(Node block) {
        for (int i = 0; i < block.childCount(); i++) {
            this.genStmt(block.child(i));
        }
    }

    public void genProgram2(Node[] program) {
        for (int i = 0; i < program.length; i++) {
            Node item = program[i];
            if (item.kind == 100) {
                this.emitFunction(item);
            }
        }
    }

    public void genStmt(Node stmt) {
        if (stmt.kind == 61) {
            if (stmt.childCount() > 0) {
                this.genExpr(stmt.child(0));
            }
    } elif (stmt.kind == 50) {
        int off = this.findLocal(stmt.name);
        if (stmt.childCount() > 0) {
            this.genExpr(stmt.child(0));
            if (off != 0) {
                this.asm.movMBaseR(5, 0, off);
            }
        }
    } elif (stmt.kind == 51) {
            if (stmt.childCount() > 0) {
                this.genExpr(stmt.child(0));
            }
        } elif (stmt.kind == 16) {
            this.genBlock(stmt);
    } elif (stmt.kind == 53) {
        int elseLbl = this.newLabel();
        int endLbl = this.newLabel();
        this.genExpr(stmt.child(0));
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(elseLbl);
        if (stmt.childCount() > 1) {
            Node body = stmt.child(1);
            if (body.kind == 16) {
                this.genBlock(body);
            } elif (body.kind == 61) {
                this.genStmt(body);
            } elif (body.kind == 53) {
                this.genStmt(body);
            }
        }
        this.asm.jmpLabel(endLbl);
        this.asm.bindLabel(elseLbl);
        if (stmt.childCount() > 2) {
            Node elseBody = stmt.child(2);
            if (elseBody.kind == 16) {
                this.genBlock(elseBody);
            } elif (elseBody.kind == 61) {
                this.genStmt(elseBody);
            } elif (elseBody.kind == 53) {
                this.genStmt(elseBody);
            }
        }
        this.asm.bindLabel(endLbl);
        } elif (stmt.kind == 54) {
            int startLbl = this.newLabel();
            int endLbl = this.newLabel();
            this.loopStartStack.add(startLbl);
            this.loopEndStack.add(endLbl);
            this.asm.bindLabel(startLbl);
            if (stmt.childCount() > 0) {
                this.genExpr(stmt.child(0));
            }
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(endLbl);
            if (stmt.childCount() > 1) {
                Node body = stmt.child(1);
                if (body.kind == 16) {
                    this.genBlock(body);
                } elif (body.kind == 61) {
                    this.genStmt(body);
                }
            }
            this.asm.jmpLabel(startLbl);
            this.asm.bindLabel(endLbl);
            this.loopStartStack = [];
            this.loopEndStack = [];
        } elif (stmt.kind == 55) {
            int startLbl = this.newLabel();
            int endLbl = this.newLabel();
            this.loopStartStack.add(startLbl);
            this.loopEndStack.add(endLbl);
            this.asm.bindLabel(startLbl);
            if (stmt.childCount() > 2) {
                Node body = stmt.child(2);
                if (body.kind == 16) {
                    this.genBlock(body);
                }
            }
            this.asm.bindLabel(endLbl);
            this.loopStartStack = [];
            this.loopEndStack = [];
        } elif (stmt.kind == 62) {
            if (this.loopEndStack.length > 0) {
                int endLbl = this.loopEndStack[this.loopEndStack.length - 1];
                this.asm.jmpLabel(endLbl);
            }
        } elif (stmt.kind == 63) {
            if (this.loopStartStack.length > 0) {
                int startLbl = this.loopStartStack[this.loopStartStack.length - 1];
                this.asm.jmpLabel(startLbl);
            }
        } elif (stmt.kind == 64) {
            int startLbl = this.newLabel();
            int endLbl = this.newLabel();
            this.loopStartStack.add(startLbl);
            this.loopEndStack.add(endLbl);
            if (stmt.childCount() > 1) {
                this.genExpr(stmt.child(1));
            }
            int iOff = this.findLocal(stmt.child(0).name);
            this.asm.movRI64(0, 0);
            this.asm.movMBaseR(5, 0, iOff);
            this.asm.bindLabel(startLbl);
            this.asm.movRMBase(0, 5, iOff);
            if (stmt.childCount() > 1) {
                int arrOff = this.findLocal("__foreach_arr");
                this.asm.movRMBase(0, 5, iOff);
                this.asm.movRMBase(1, 0, 8);
                this.asm.cmpRR64(0, 1);
                this.asm.jgeLabel(endLbl);
            }
            if (stmt.childCount() > 2) {
                Node body = stmt.child(2);
                if (body.kind == 16) {
                    this.genBlock(body);
                } elif (body.kind == 61) {
                    this.genStmt(body);
                }
            }
            this.asm.movRMBase(0, 5, iOff);
            this.asm.addRI32(0, 1);
            this.asm.movMBaseR(5, 0, iOff);
            this.asm.jmpLabel(startLbl);
            this.asm.bindLabel(endLbl);
            this.loopStartStack = [];
            this.loopEndStack = [];
        }
    }

    public void genExpr(Node expr) {
        int kind = expr.kind;
        if (kind == 0) {
            this.asm.emitImm64(0, expr.intVal);
        } elif (kind == 2) {
            int strIdx = this.addString(expr.strVal);
            int sp = this.asm.buf.length;
            this.asm.emitImm64(0, 0);
            int strPatchPos = sp + 2;
            this.stringPatchOffsets.add(strPatchPos);
            this.stringPatchIndices.add(strIdx);
        } elif (kind == 3) {
            this.asm.emitImm64(0, expr.charVal);
        } elif (kind == 4) {
            if (expr.boolVal) { this.asm.emitImm64(0, 1); } else { this.asm.emitImm64(0, 0); }
        } elif (kind == 5) {
            this.asm.xorRR64(0, 0);
        }
    elif (kind == 6) {
        int off = this.findLocal(expr.name);
        this.asm.movRMBase(0, 5, off);
        } elif (kind == 9 || kind == 10) {
            this.genCall(expr);
        } elif (kind == 23) {
            if (expr.childCount() > 0) {
                this.genExpr(expr.child(0));
            }
        } elif (kind == 7) {
            this.genBinary(expr);
        } elif (kind == 24) {
            this.genArrayIndex(expr);
        } elif (kind == 13) {
            this.genMemberAccess(expr);
        } elif (kind == 65) {
            int elseLbl = this.newLabel();
            int endLbl = this.newLabel();
            this.genExpr(expr.child(0));
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(elseLbl);
            this.genExpr(expr.child(1));
            this.asm.jmpLabel(endLbl);
            this.asm.bindLabel(elseLbl);
            this.genExpr(expr.child(2));
            this.asm.bindLabel(endLbl);
        }
    }

    public void genMemberAccess(Node expr) {
        Node obj = expr.child(0);
        string fieldName = expr.name;
        if (obj.kind == 6 && this.strEq(obj.name, "this")) {
            int thisOff = this.findLocal("this");
            int fieldOff = this.findFieldOffset(this.currentClassName, fieldName);
            if (fieldOff < 0) { return; }
            this.asm.movRMBase(0, 5, thisOff);
            this.asm.movRMBase(0, 0, fieldOff);
            return;
        }
        if (obj.kind == 6 && this.strEq(obj.name, "this") && !this.strEq(this.currentClassName, "")) {
            int thisOff = this.findLocal("this");
            int fieldOff = this.findFieldOffset(this.currentClassName, fieldName);
            if (fieldOff < 0) { return; }
            this.asm.movRMBase(0, 5, thisOff);
            this.asm.movRMBase(0, 0, fieldOff);
            return;
        }
        if (obj.kind == 6) {
            string varType = this.getLocalType(obj.name);
            if (!this.strEq(varType, "")) {
                this.genExpr(obj);
                string elemType = this.arrayElementType(varType);
                string lookupType = varType;
                if (!this.strEq(elemType, "")) { lookupType = elemType; }
                int fieldOff = this.findFieldOffset(lookupType, fieldName);
                if (fieldOff >= 0) {
                    this.asm.movRMBase(0, 0, fieldOff);
                }
                return;
            }
        }
        if (obj.kind == 24) {
            Node arrNode = obj.child(0);
            string arrType = this.inferExprType(arrNode);
            this.genArrayIndex(obj);
            string elemType = this.arrayElementType(arrType);
            if (!this.strEq(elemType, "")) {
                int fieldOff = this.findFieldOffset(elemType, fieldName);
                if (fieldOff >= 0) {
                    this.asm.movRMBase(0, 0, fieldOff);
                }
            }
            return;
        }
        if (obj.kind == 13) {
            this.genMemberAccess(obj);
            string objType = this.inferMemberAccessType(obj);
            int fieldOff = this.findFieldOffset(objType, fieldName);
            if (fieldOff >= 0) {
                this.asm.movRMBase(0, 0, fieldOff);
            }
            return;
        }
        this.genExpr(obj);
    }

    public string inferExprType(Node expr) {
        if (expr.kind == 6) {
            if (this.strEq(expr.name, "this")) { return this.currentClassName; }
            return this.getLocalType(expr.name);
        }
        if (expr.kind == 13) {
            return this.inferMemberAccessType(expr);
        }
        if (expr.kind == 24) {
            Node arrNode = expr.child(0);
            string arrType = this.inferExprType(arrNode);
            return this.arrayElementType(arrType);
        }
        return "";
    }

    public string inferMemberAccessType(Node expr) {
        Node obj = expr.child(0);
        string fieldName = expr.name;
        string objType = this.inferExprType(obj);
        string fieldType = this.findFieldType(objType, fieldName);
        return fieldType;
    }

    public int findFieldOffsetInAllClasses(string fieldName) {
        for (int i = 0; i < this.classFieldNames.length; i++) {
            if (this.strEq(this.classFieldNames[i], fieldName)) {
                int off = this.classFieldOffsets[i];
                int unique = 1;
                for (int j = 0; j < this.classFieldNames.length; j++) {
                    if (j != i && this.strEq(this.classFieldNames[j], fieldName)) {
                        unique = 0;
                    }
                }
                if (unique == 1) {
                    return off;
                }
            }
        }
        return -1;
    }

    public void genArrayIndex(Node idx) {
        Node arrNode = idx.child(0);
        Node idxNode = idx.child(1);
        if (arrNode.kind == 6) {
            int arrOff = this.findLocal(arrNode.name);
            this.genExpr(idxNode);
            this.asm.shlR64Imm(0, 3);
            this.asm.pushR64(0);
            this.asm.movRMBase(11, 4, arrOff);
            this.asm.popR64(0);
            this.asm.addRR64(11, 0);
            this.asm.movRMBase(0, 11, 0);
        } else {
            this.genExpr(arrNode);
            this.asm.pushR64(0);
            this.genExpr(idxNode);
            this.asm.shlR64Imm(0, 3);
            this.asm.movRR64(11, 0);
            this.asm.popR64(0);
            this.asm.addRR64(0, 11);
            this.asm.movRMBase(0, 0, 0);
        }
    }

    public void genCall(Node call) {
        string name = call.name;
        printline("genCall dispatch");
        printline(name);
        int isClass = 0;
        for (int i = 0; i < this.classNames.length; i++) {
            if (this.strEq(this.classNames[i], name)) { isClass = 1; }
        }
        if (isClass == 1) {
            this.genNewCall(call);
        } elif (this.strEq(name, "printline")) {
            this.genPrintCall(call, 1);
        } elif (this.strEq(name, "print")) {
            this.genPrintCall(call, 0);
        } elif (this.strEq(name, "readString")) {
            this.genReadStringCall(call);
        } elif (this.strEq(name, "readFile")) {
            this.genReadStringCall(call);
        } elif (this.strEq(name, "writeBytes")) {
            this.genWriteBytesCall(call);
        } elif (this.strEq(name, "writeFile")) {
            this.genWriteBytesCall(call);
        } elif (this.strEq(name, "writeString")) {
            this.genWriteBytesCall(call);
        } elif (this.strEq(name, "strlen")) {
            this.genStrlenCall(call);
        } elif (this.strEq(name, "exit")) {
            this.genExitCall(call);
        } elif (this.strEq(name, "pushR64") || this.strEq(name, "popR64") || this.strEq(name, "movRR64") || this.strEq(name, "movRI64") || this.strEq(name, "movRMBase") || this.strEq(name, "movMBaseR") || this.strEq(name, "subRI32") || this.strEq(name, "addRI32") || this.strEq(name, "xorRR64") || this.strEq(name, "cmpRI32") || this.strEq(name, "cmpRR64") || this.strEq(name, "ret") || this.strEq(name, "callR64") || this.strEq(name, "leaRBase") || this.strEq(name, "emitU8") || this.strEq(name, "addRR64") || this.strEq(name, "subRR64") || this.strEq(name, "mulRR64") || this.strEq(name, "label") || this.strEq(name, "bindLabel") || this.strEq(name, "jeLabel") || this.strEq(name, "jneLabel") || this.strEq(name, "jmpLabel") || this.strEq(name, "jlLabel") || this.strEq(name, "jleLabel") || this.strEq(name, "jgLabel") || this.strEq(name, "jgeLabel")) {
            this.genAsmCall(call);
        } else {
            this.genUserCall(call);
        }
    }

public void genNewCall(Node call) {
    int size = 16;
    for (int i = 0; i < this.classNames.length; i++) {
        if (this.strEq(this.classNames[i], call.name)) {
            int cnt = this.classFieldCounts[i];
            size = cnt * 8;
            if (size < 16) { size = 16; }
        }
    }
    this.asm.emitImm64(1, size);
    this.addImportPatch("msvcrt.dll", "malloc");
    int s4 = 0xDEADBEEFCAFEBAB0;
    this.asm.emitImm64(0, s4);
    this.asm.movRMBase(0, 0, 0);
    this.asm.emitCallSetup(0);
    this.asm.callR64(0);
    this.asm.emitCallTeardown();
    int tmpOff = this.allocLocal("__new_tmp");
    this.asm.movMBaseR(5, 0, tmpOff);
    int[] argRegs = [1, 2, 8, 9];
    int nargs = call.childCount();
    int[] argTemps = [];
    for (int i = 0; i < nargs; i++) {
        this.genExpr(call.child(i));
        int t = this.allocLocal("__na");
        this.asm.movMBaseR(5, 0, t);
        argTemps.add(t);
    }
    int ctorIdx = -1;
    for (int i = 0; i < this.funcNames.length; i++) {
        if (this.strEq(this.funcNames[i], "construct")) {
            ctorIdx = i;
        }
    }
    if (ctorIdx >= 0 && ctorIdx < this.funcOffsets.length) {
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, tmpOff);
        for (int i = 0; i < nargs; i++) {
            if (i < 3) {
                this.asm.movRMBase(argRegs[i + 1], 5, argTemps[i]);
            }
        }
        if (this.funcOffsets[ctorIdx] >= 0) {
            int targetOff = this.funcOffsets[ctorIdx];
            int callPos = this.asm.buf.length;
            int rel32 = targetOff - (callPos + 5);
            this.asm.callRel32(rel32);
        } else {
            this.asm.callRel32(0);
            this.forwardCalls.add(this.asm.buf.length - 4);
            this.forwardCallNames.add("construct");
        }
        this.asm.emitCallTeardown();
    }
    this.asm.movRMBase(0, 5, tmpOff);
}

    public void genAsmCall(Node call) {
        string name = call.name;
        if (this.strEq(name, "ret")) {
            this.asm.ret();
            return;
        }
        if (this.strEq(name, "label")) {
            string lbl = "";
            if (call.childCount() > 0 && call.child(0).kind == 2) {
                lbl = call.child(0).strVal;
            }
            this.asm.label(lbl);
            return;
        }
        if (this.strEq(name, "bindLabel")) {
            int id = 0;
            if (call.childCount() > 0 && call.child(0).kind == 0) {
                id = call.child(0).intVal;
            }
            this.asm.bindLabel(id);
            return;
        }
        int[] args = [];
        for (int i = 0; i < call.childCount(); i++) {
            Node c = call.child(i);
            if (c.kind == 13) { continue; }
            int v = 0;
            if (c.kind == 0) { v = c.intVal; }
            args.add(v);
        }
        if (this.strEq(name, "pushR64")) { this.asm.pushR64(args[0]); }
        elif (this.strEq(name, "popR64")) { this.asm.popR64(args[0]); }
        elif (this.strEq(name, "movRR64")) { this.asm.movRR64(args[0], args[1]); }
        elif (this.strEq(name, "movRI64")) {
            int64 v = 0;
            if (call.childCount() > 1 && call.child(1).kind == 0) { v = call.child(1).intVal; }
            this.asm.movRI64(args[0], v);
        }
        elif (this.strEq(name, "movRMBase")) { this.asm.movRMBase(args[0], args[1], args[2]); }
        elif (this.strEq(name, "movMBaseR")) { this.asm.movMBaseR(args[0], args[1], args[2]); }
        elif (this.strEq(name, "subRI32")) { this.asm.subRI32(args[0], args[1]); }
        elif (this.strEq(name, "addRI32")) { this.asm.addRI32(args[0], args[1]); }
        elif (this.strEq(name, "xorRR64")) { this.asm.xorRR64(args[0], args[1]); }
        elif (this.strEq(name, "cmpRI32")) { this.asm.cmpRI32(args[0], args[1]); }
        elif (this.strEq(name, "cmpRR64")) { this.asm.cmpRR64(args[0], args[1]); }
        elif (this.strEq(name, "callR64")) { this.asm.callR64(args[0]); }
        elif (this.strEq(name, "leaRBase")) { this.asm.leaRBase(args[0], args[1], args[2]); }
        elif (this.strEq(name, "emitU8")) { this.asm.emitU8(args[0]); }
        elif (this.strEq(name, "addRR64")) { this.asm.addRR64(args[0], args[1]); }
        elif (this.strEq(name, "subRR64")) { this.asm.subRR64(args[0], args[1]); }
        elif (this.strEq(name, "mulRR64")) { this.asm.mulRR64(args[0]); }
        elif (this.strEq(name, "jeLabel")) { this.asm.jeLabel(args[0]); }
        elif (this.strEq(name, "jneLabel")) { this.asm.jneLabel(args[0]); }
        elif (this.strEq(name, "jmpLabel")) { this.asm.jmpLabel(args[0]); }
        elif (this.strEq(name, "jlLabel")) { this.asm.jlLabel(args[0]); }
        elif (this.strEq(name, "jleLabel")) { this.asm.jleLabel(args[0]); }
        elif (this.strEq(name, "jgLabel")) { this.asm.jgLabel(args[0]); }
        elif (this.strEq(name, "jgeLabel")) { this.asm.jgeLabel(args[0]); }
    }

    public void genUserCall(Node call) {
        string name = call.name;
        int funcIdx = -1;
        for (int i = 0; i < this.funcNames.length; i++) {
            if (this.strEq(this.funcNames[i], name)) {
                funcIdx = i;
            }
        }
        if (funcIdx >= 0 && funcIdx < this.funcOffsets.length) {
            int targetOff = this.funcOffsets[funcIdx];
            int[] argRegs = [1, 2, 8, 9];
            int nargs = call.childCount();
            if (nargs > 4) { nargs = 4; }
            this.asm.emitCallSetup(0);
            for (int i = 0; i < nargs; i++) {
                this.genExpr(call.child(i));
                this.asm.movRR64(argRegs[i], 0);
            }
            for (int i = 4; i < call.childCount(); i++) {
                this.genExpr(call.child(i));
                this.asm.pushR64(0);
            }
            if (targetOff >= 0) {
                int callPos = this.asm.buf.length;
                int rel32 = targetOff - (callPos + 5);
                this.asm.callRel32(rel32);
            } else {
                this.asm.callRel32(0);
                this.forwardCalls.add(this.asm.buf.length - 4);
                this.forwardCallNames.add(name);
            }
            this.asm.emitCallTeardown();
            return;
        }
        this.asm.emitCallSetup(0);
        int[] argRegs2 = [1, 2, 8, 9];
        int nargs2 = call.childCount();
        if (nargs2 > 4) { nargs2 = 4; }
        for (int i = 0; i < nargs2; i++) {
            this.genExpr(call.child(i));
            this.asm.movRR64(argRegs2[i], 0);
        }
        for (int i = 4; i < call.childCount(); i++) {
            this.genExpr(call.child(i));
            this.asm.pushR64(0);
        }
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRI64(0, 0);
    }

    public void genBinary(Node bin) {
        if (bin.childCount() < 2) { return; }
        int op = bin.op;
        if (op == 20) {
            this.genAssign(bin);
            return;
        }
        if (op >= 14 && op <= 17) {
            this.genCompoundAssign(bin, op);
            return;
        }
        this.genExpr(bin.child(0));
        this.asm.pushR64(0);
        this.genExpr(bin.child(1));
        this.asm.movRR64(1, 0);
        this.asm.popR64(0);
        if (op == 1) {
            this.asm.addRR64(0, 1);
        } elif (op == 2) {
            this.asm.subRR64(0, 1);
        } elif (op == 3) {
            this.asm.mulRR64(1);
    } elif (op >= 5 && op <= 10) {
        this.asm.cmpRR64(0, 1);
            int t = this.newLabel();
            int e = this.newLabel();
            if (op == 5) { this.asm.jeLabel(t); }
            elif (op == 6) { this.asm.jneLabel(t); }
            elif (op == 7) { this.asm.jlLabel(t); }
            elif (op == 8) { this.asm.jleLabel(t); }
            elif (op == 9) { this.asm.jgLabel(t); }
            elif (op == 10) { this.asm.jgeLabel(t); }
            this.asm.movRI64(0, 0);
            this.asm.jmpLabel(e);
            this.asm.bindLabel(t);
            this.asm.movRI64(0, 1);
            this.asm.bindLabel(e);
        } elif (op == 11) {
            int f = this.newLabel();
            int ed = this.newLabel();
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(f);
            this.asm.cmpRI32(1, 0);
            this.asm.jeLabel(f);
            this.asm.movRI64(0, 1);
            this.asm.jmpLabel(ed);
            this.asm.bindLabel(f);
            this.asm.movRI64(0, 0);
            this.asm.bindLabel(ed);
        } elif (op == 12) {
            int t = this.newLabel();
            int ed = this.newLabel();
            this.asm.cmpRI32(0, 0);
            this.asm.jneLabel(t);
            this.asm.cmpRI32(1, 0);
            this.asm.jneLabel(t);
            this.asm.movRI64(0, 0);
            this.asm.jmpLabel(ed);
            this.asm.bindLabel(t);
            this.asm.movRI64(0, 1);
            this.asm.bindLabel(ed);
        }
    }

    public void genCompoundAssign(Node bin, int op) {
        Node lhs = bin.child(0);
        Node rhs = bin.child(1);
        if (lhs.kind == 6) {
            int off = this.findLocal(lhs.name);
            this.asm.movRMBase(0, 5, off);
            this.asm.pushR64(0);
            this.genExpr(rhs);
            this.asm.movRR64(1, 0);
            this.asm.popR64(0);
            if (op == 14) { this.asm.addRR64(0, 1); }
            elif (op == 15) { this.asm.subRR64(0, 1); }
            elif (op == 16) { this.asm.mulRR64(1); }
            this.asm.movMBaseR(5, 0, off);
            return;
        }
        if (lhs.kind == 24 && lhs.childCount() >= 2) {
            Node arrNode = lhs.child(0);
            Node idxNode = lhs.child(1);
            if (arrNode.kind == 6) {
                int arrOff = this.findLocal(arrNode.name);
                this.genExpr(idxNode);
                this.asm.pushR64(0);
                this.asm.movRMBase(11, 4, arrOff);
                this.asm.popR64(0);
                this.asm.addRR64(11, 0);
                this.asm.movRMBase(0, 11, 0);
                this.asm.pushR64(0);
                this.genExpr(rhs);
                this.asm.movRR64(1, 0);
                this.asm.popR64(0);
                if (op == 14) { this.asm.addRR64(0, 1); }
                elif (op == 15) { this.asm.subRR64(0, 1); }
                elif (op == 16) { this.asm.mulRR64(1); }
                this.asm.movMBaseR(11, 0, 0);
                return;
            }
        }
        if (lhs.kind == 13 && lhs.childCount() >= 1) {
            Node obj = lhs.child(0);
            string fieldName = lhs.name;
            if (obj.kind == 6 && this.strEq(obj.name, "this")) {
                int thisOff = this.findLocal("this");
                int fieldOff = this.findFieldOffset(this.currentClassName, fieldName);
                if (fieldOff < 0) { this.genExpr(rhs); return; }
                this.asm.movRMBase(0, 5, thisOff);
                this.asm.movRMBase(0, 0, fieldOff);
                this.asm.pushR64(0);
                this.genExpr(rhs);
                this.asm.movRR64(1, 0);
                this.asm.popR64(0);
                if (op == 14) { this.asm.addRR64(0, 1); }
                elif (op == 15) { this.asm.subRR64(0, 1); }
                elif (op == 16) { this.asm.mulRR64(1); }
                this.asm.movRMBase(10, 5, thisOff);
                this.asm.addRI32(10, fieldOff);
                this.asm.movMBaseR(10, 0, 0);
                return;
            }
        }
        this.genExpr(rhs);
    }

    public void genAssign(Node bin) {
        Node lhs = bin.child(0);
        Node rhs = bin.child(1);
        if (lhs.kind == 6) {
            int off = this.findLocal(lhs.name);
            this.genExpr(rhs);
            this.asm.movMBaseR(5, 0, off);
            return;
        }
        if (lhs.kind == 13 && lhs.childCount() >= 1) {
            Node obj = lhs.child(0);
            string fieldName = lhs.name;
            if (obj.kind == 6 && this.strEq(obj.name, "this")) {
                int thisOff = this.findLocal("this");
                int fieldOff = this.findFieldOffset(this.currentClassName, fieldName);
                if (fieldOff < 0) {
                    this.genExpr(rhs);
                    return;
                }
                this.genExpr(rhs);
                this.asm.pushR64(0);
                this.asm.movRMBase(0, 5, thisOff);
                this.asm.addRI32(0, fieldOff);
                this.asm.popR64(1);
                this.asm.movMBaseR(0, 1, 0);
                return;
            }
            if (obj.kind == 6) {
                string varType = this.getLocalType(obj.name);
                int off = this.findLocal(obj.name);
                string lookupType = varType;
                string elemType = this.arrayElementType(varType);
                if (!this.strEq(elemType, "")) { lookupType = elemType; }
                int fieldOff = this.findFieldOffset(lookupType, fieldName);
                if (fieldOff < 0) {
                    this.genExpr(rhs);
                    return;
                }
                this.genExpr(rhs);
                this.asm.pushR64(0);
                this.asm.movRMBase(0, 5, off);
                this.asm.addRI32(0, fieldOff);
                this.asm.popR64(1);
                this.asm.movMBaseR(0, 1, 0);
                return;
            }
        }
        if (lhs.kind == 24 && lhs.childCount() >= 2) {
            Node arrNode = lhs.child(0);
            Node idxNode = lhs.child(1);
            if (arrNode.kind == 6) {
                int arrOff = this.findLocal(arrNode.name);
                this.genExpr(idxNode);
                this.asm.pushR64(0);
                this.genExpr(rhs);
                this.asm.pushR64(0);
                this.asm.movRMBase(11, 4, arrOff);
                this.asm.popR64(12);
                this.asm.popR64(0);
                this.asm.addRR64(11, 0);
                this.asm.movMBaseR(11, 12, 0);
                this.asm.movRI64(0, 0);
                return;
            }
        }
        this.genExpr(rhs);
    }

    public void addFormatStr(string fmt) {
        int fmtIdx = this.addString(fmt);
        int sp = this.asm.buf.length;
        this.asm.emitImm64(0, 0);
        int fmtPatchPos = sp + 2;
        this.stringPatchOffsets.add(fmtPatchPos);
        this.stringPatchIndices.add(fmtIdx);
        this.asm.movRR64(1, 0);
    }

    public void genPrintCall(Node call, bool newline) {
        if (call.childCount() < 1) { return; }
        Node arg = call.child(0);
        if (arg.kind == 2) {
            string s = arg.strVal;
            if (newline) { s = s + "\n"; }
            int strIdx = this.addString(s);
            int sp = this.asm.buf.length;
            this.asm.emitImm64(0, 0);
            int strPatchPos = sp + 2;
            this.stringPatchOffsets.add(strPatchPos);
            this.stringPatchIndices.add(strIdx);
            this.asm.movRR64(1, 0);
        } else {
            this.genExpr(arg);
            this.asm.pushR64(0);
            if (newline) {
                this.addFormatStr("%lld\n");
            } else {
                this.addFormatStr("%lld");
            }
            this.asm.popR64(2);
        }
        this.addImportPatch("msvcrt.dll", "printf");
        int s1 = 0xDEADBEEFCAFEBAD0;
        this.asm.emitImm64(0, s1);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }

    public void genStringConcat(Node bin) {
        if (bin.childCount() < 2) { return; }
        this.genExpr(bin.child(0));
    }

    public void genStrlenCall(Node call) {
        if (call.childCount() < 1) { return; }
        this.genExpr(call.child(0));
        this.asm.movRR64(1, 0);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.emitCallSetup(0);
        int s2 = 0xDEADBEEFCAFEBAD1;
        this.asm.emitImm64(0, s2);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }

    public void genExitCall(Node call) {
        if (call.childCount() > 0) {
            this.genExpr(call.child(0));
            this.asm.movRR64(1, 0);
        } else {
            this.asm.xorRR64(1, 1);
        }
        this.addImportPatch("kernel32.dll", "ExitProcess");
        this.asm.emitCallSetup(0);
        int s3 = 0xDEADBEEFCAFEBABE;
        this.asm.emitImm64(0, s3);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }

    public void genReadStringCall(Node call) {
        if (call.childCount() < 2) { return; }
        this.genExpr(call.child(1));
        int pathOff = this.allocLocal("__rs_path");
        this.asm.movMBaseR(5, 0, pathOff);

        this.asm.emitCallSetup(24);
        this.asm.movRI64(0, 3);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRI64(0, 0x80);
        this.asm.movMBaseR(4, 0, 40);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(4, 0, 48);
        this.asm.movRMBase(1, 5, pathOff);
        this.asm.movRI64(2, 0x80000000);
        this.asm.movRI64(8, 1);
        this.asm.xorRR64(9, 9);
        this.addImportPatch("kernel32.dll", "CreateFileA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int hfileOff = this.allocLocal("__rs_hfile");
        this.asm.movMBaseR(5, 0, hfileOff);

        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hfileOff);
        this.asm.xorRR64(2, 2);
        this.addImportPatch("kernel32.dll", "GetFileSize");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int sizeOff = this.allocLocal("__rs_size");
        this.asm.movMBaseR(5, 0, sizeOff);

        this.asm.emitCallSetup(0);
        this.addImportPatch("kernel32.dll", "GetProcessHeap");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.emitCallSetup(0);
        this.asm.movRR64(1, 0);
        this.asm.xorRR64(2, 2);
        this.asm.movRMBase(8, 5, sizeOff);
        this.asm.addRI32(8, 1);
        this.addImportPatch("kernel32.dll", "HeapAlloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int bufOff = this.allocLocal("__rs_buf");
        this.asm.movMBaseR(5, 0, bufOff);

        int breadOff = this.allocLocal("__rs_bread");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, breadOff);

        this.asm.emitCallSetup(8);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRMBase(1, 5, hfileOff);
        this.asm.movRMBase(2, 5, bufOff);
        this.asm.movRMBase(8, 5, sizeOff);
        this.asm.leaRBase(9, 5, breadOff);
        this.addImportPatch("kernel32.dll", "ReadFile");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hfileOff);
        this.addImportPatch("kernel32.dll", "CloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.movRMBase(0, 5, bufOff);
    }

    public void genWriteBytesCall(Node call) {
        if (call.childCount() < 3) { return; }
        this.genExpr(call.child(1));
        int pathOff = this.allocLocal("__wb_path");
        this.asm.movMBaseR(5, 0, pathOff);

        this.genExpr(call.child(2));
        int dataOff = this.allocLocal("__wb_data");
        this.asm.movMBaseR(5, 0, dataOff);

        this.asm.emitCallSetup(24);
        this.asm.movRI64(0, 2);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRI64(0, 0x80);
        this.asm.movMBaseR(4, 0, 40);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(4, 0, 48);
        this.asm.movRMBase(1, 5, pathOff);
        this.asm.movRI64(2, 0x40000000);
        this.asm.xorRR64(8, 8);
        this.asm.xorRR64(9, 9);
        this.addImportPatch("kernel32.dll", "CreateFileA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int hfileOff = this.allocLocal("__wb_hfile");
        this.asm.movMBaseR(5, 0, hfileOff);

        int sizeOff = this.allocLocal("__wb_size");
        this.asm.movRMBase(0, 5, dataOff);
        this.asm.movRMBase(8, 0, 0);
        this.asm.movMBaseR(5, 8, sizeOff);

        int writtenOff = this.allocLocal("__wb_written");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, writtenOff);

        this.asm.emitCallSetup(8);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRMBase(1, 5, hfileOff);
        this.asm.movRMBase(0, 5, dataOff);
        this.asm.addRI32(0, 16);
        this.asm.movRR64(2, 0);
        this.asm.movRMBase(8, 5, sizeOff);
        this.asm.leaRBase(9, 5, writtenOff);
        this.addImportPatch("kernel32.dll", "WriteFile");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hfileOff);
        this.addImportPatch("kernel32.dll", "CloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }
}

class PeImport {
    public prop string dll;
    public prop string name;

    construct (string dll, string name) {
        this.dll = dll;
        this.name = name;
    }
}

class PeDllGroup {
    public prop string dll;
    public prop int count;

    construct (string dll) {
        this.dll = dll;
        this.count = 0;
    }
}

class MiniPe {
    public int[] code;
    public int entryRva;
    public PeImport[] imports;

    construct () {
        this.code = [];
        this.entryRva = 0;
        this.imports = [];
    }

    public void addImport(string dll, string name) {
        this.imports.add(new PeImport(dll, name));
    }

    public int computeRdataRva() {
        int FILE_ALIGN = 0x200;
        int SECT_ALIGN = 0x1000;
        int textRva = SECT_ALIGN;
        int textVirt = this.padToAlign(this.code.length, SECT_ALIGN);
        return textRva + textVirt;
    }

    public int[] computeLayout(int stringDataLen) {
        PeDllGroup[] groups = [];
        int[] groupMap = [];
        for (int i = 0; i < this.imports.length; i++) {
            string impDll = this.imports[i].dll;
            int gIdx = -1;
            for (int j = 0; j < groups.length; j++) {
                string gDll = groups[j].dll;
                if (gDll == impDll) {
                    gIdx = j;
                    break;
                }
            }
            if (gIdx < 0) {
                groups.add(new PeDllGroup(impDll));
                gIdx = groups.length - 1;
            }
            PeDllGroup grp = groups[gIdx];
            grp.count = grp.count + 1;
            groupMap.add(gIdx);
        }
        int numGroups = groups.length;
        int descBytes = (numGroups + 1) * 20;
        int iltTotal = 0;
        for (int g = 0; g < numGroups; g++) {
            int cnt = groups[g].count;
            iltTotal += (cnt + 1) * 8;
        }
        int iatTotal = iltTotal;
        int namesStart = descBytes + iltTotal + iatTotal;
        int hintNamesLen = 0;
        for (int i = 0; i < this.imports.length; i++) {
            string nm = this.imports[i].name;
            hintNamesLen += 2 + nm.length + 1;
        }
        for (int g = 0; g < numGroups; g++) {
            string gDll2 = groups[g].dll;
            hintNamesLen += gDll2.length + 1;
        }
        int stringsStart = namesStart + hintNamesLen;
        int[] layout = [];
        layout.add(stringsStart);
        layout.add(numGroups);
        layout.add(iltTotal);
        return layout;
    }

    public int padToAlign(int offset, int align) {
        int m = offset % align;
        if (m != 0) {
            return offset + (align - m);
        }
        return offset;
    }

    public void writeLe32(int[] buf, int offset, int val) {
        buf[offset] = val & 0xFF;
        buf[offset + 1] = (val >> 8) & 0xFF;
        buf[offset + 2] = (val >> 16) & 0xFF;
        buf[offset + 3] = (val >> 24) & 0xFF;
    }

    public void writeLe64(int[] buf, int offset, int64 val) {
        buf[offset] = val & 0xFF;
        buf[offset + 1] = (val >> 8) & 0xFF;
        buf[offset + 2] = (val >> 16) & 0xFF;
        buf[offset + 3] = (val >> 24) & 0xFF;
        buf[offset + 4] = (val >> 32) & 0xFF;
        buf[offset + 5] = (val >> 40) & 0xFF;
        buf[offset + 6] = (val >> 48) & 0xFF;
        buf[offset + 7] = (val >> 56) & 0xFF;
    }

public int[] build(int[] codeIn, int[] stringData) {
        this.code = codeIn;

        int numImports = this.imports.length;
        string[] uniqueDlls = [];
        int[] groupSizes = [];
        int[] importGroupIdx = [];
        for (int i = 0; i < numImports; i++) {
            string impDll = this.imports[i].dll;
            int gIdx = -1;
            for (int j = 0; j < uniqueDlls.length; j++) {
                if (uniqueDlls[j] == impDll) {
                    gIdx = j;
                    break;
                }
            }
            if (gIdx < 0) {
                uniqueDlls.add(impDll);
                groupSizes.add(0);
                gIdx = uniqueDlls.length - 1;
            }
            groupSizes[gIdx] = groupSizes[gIdx] + 1;
            importGroupIdx.add(gIdx);
        }
        int numGroups = uniqueDlls.length;
        int[] posInGroup = [];
        int[] runningCount = [];
        for (int g = 0; g < numGroups; g++) {
            runningCount.add(0);
        }
        for (int i = 0; i < numImports; i++) {
            posInGroup.add(0);
        }
        for (int i = 0; i < numImports; i++) {
            int g = importGroupIdx[i];
            posInGroup[i] = runningCount[g];
            runningCount[g] = runningCount[g] + 1;
        }

        int descBytes = (numGroups + 1) * 20;
        int iltTotal = 0;
        int[] iltSizes = [];
        for (int g = 0; g < numGroups; g++) {
            int sz = (groupSizes[g] + 1) * 8;
            iltSizes.add(sz);
            iltTotal += sz;
        }
        int iatTotal = iltTotal;

        int[] hintNameOffsets = [];
        int off = 0;
        for (int i = 0; i < numImports; i++) {
            string nm = this.imports[i].name;
            hintNameOffsets.add(off);
            off += 2 + nm.length + 1;
        }
        int[] dllNameOffsets = [];
        for (int g = 0; g < numGroups; g++) {
            string dll = uniqueDlls[g];
            dllNameOffsets.add(off);
            off += dll.length + 1;
        }

        int[] hintNames = [];
        for (int i = 0; i < numImports; i++) {
            hintNames.add(0);
            hintNames.add(0);
            string nm = this.imports[i].name;
            for (int c = 0; c < nm.length; c++) {
                hintNames.add(nm[c]);
            }
            hintNames.add(0);
        }
        for (int g = 0; g < numGroups; g++) {
            string dll = uniqueDlls[g];
            for (int c = 0; c < dll.length; c++) {
                hintNames.add(dll[c]);
            }
            hintNames.add(0);
        }

        int namesStart = descBytes + iltTotal + iatTotal;
        int stringsStart = namesStart + hintNames.length;
        int importDataSize = stringsStart + stringData.length;

        int FILE_ALIGN = 0x200;
        int SECT_ALIGN = 0x1000;
        int headersRawSize = 64 + 4 + 20 + 240 + 2 * 40;
        int headersSize = this.padToAlign(headersRawSize, FILE_ALIGN);

        int textRva = SECT_ALIGN;
        int textVirt = this.padToAlign(this.code.length, SECT_ALIGN);
        int textRaw = this.padToAlign(this.code.length, FILE_ALIGN);
        int textFileOff = headersSize;

        int rdataRva = textRva + textVirt;
        int importVirt = this.padToAlign(importDataSize, SECT_ALIGN);
        int importRaw = this.padToAlign(importDataSize, FILE_ALIGN);
        int rdataFileOff = textFileOff + textRaw;

        int iatSectionStart = descBytes + iltTotal;
        int[] groupIatStart = [];
        int runOff = 0;
        for (int g = 0; g < numGroups; g++) {
            groupIatStart.add(descBytes + iltTotal + runOff);
            runOff += iltSizes[g];
        }
        int firstIatRva = rdataRva + groupIatStart[0];
        int iatSize = iatTotal;

        int imageSize = this.padToAlign(rdataRva + importVirt, SECT_ALIGN);

        int totalSize = rdataFileOff + importRaw;
        int[] pe = [];
        for (int i = 0; i < totalSize; i++) {
            pe.add(0);
        }

        pe[0] = 0x4D; pe[1] = 0x5A;
        this.writeLe32(pe, 0x3C, 64);

        int p = 64;
        pe[p] = 0x50; pe[p+1] = 0x45; pe[p+2] = 0; pe[p+3] = 0;
        p += 4;
        pe[p] = 0x64; pe[p+1] = 0x86; p += 2;
        pe[p] = 0x02; pe[p+1] = 0; p += 2;
        this.writeLe32(pe, p, 0x42); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        pe[p] = 0xF0; pe[p+1] = 0; p += 2;
        pe[p] = 0x22; pe[p+1] = 0; p += 2;

        pe[p] = 0x0B; pe[p+1] = 0x02; p += 2;
        pe[p] = 14; pe[p+1] = 0; p += 2;
        this.writeLe32(pe, p, textRaw); p += 4;
        this.writeLe32(pe, p, importRaw); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, this.entryRva); p += 4;
        this.writeLe32(pe, p, textRva); p += 4;
        this.writeLe64(pe, p, 0x140000000); p += 8;
        this.writeLe32(pe, p, SECT_ALIGN); p += 4;
        this.writeLe32(pe, p, FILE_ALIGN); p += 4;
        pe[p] = 6; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        pe[p] = 6; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, imageSize); p += 4;
        this.writeLe32(pe, p, headersSize); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        pe[p] = 3; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        this.writeLe64(pe, p, 0x100000); p += 8;
        this.writeLe64(pe, p, 0x1000); p += 8;
        this.writeLe64(pe, p, 0x100000); p += 8;
        this.writeLe64(pe, p, 0x1000); p += 8;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 16); p += 4;

        for (int i = 0; i < 16; i++) {
            if (i == 1) {
                this.writeLe32(pe, p, rdataRva); p += 4;
                this.writeLe32(pe, p, importVirt); p += 4;
            } elif (i == 12) {
                this.writeLe32(pe, p, firstIatRva); p += 4;
                this.writeLe32(pe, p, iatSize); p += 4;
            } else {
                this.writeLe32(pe, p, 0); p += 4;
                this.writeLe32(pe, p, 0); p += 4;
            }
        }

        pe[p] = 0x2E; pe[p+1] = 0x74; pe[p+2] = 0x65; pe[p+3] = 0x78; pe[p+4] = 0x74; pe[p+5] = 0; pe[p+6] = 0; pe[p+7] = 0;
        p += 8;
        this.writeLe32(pe, p, textVirt); p += 4;
        this.writeLe32(pe, p, textRva); p += 4;
        this.writeLe32(pe, p, textRaw); p += 4;
        this.writeLe32(pe, p, textFileOff); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0x60000020); p += 4;

        pe[p] = 0x2E; pe[p+1] = 0x72; pe[p+2] = 0x64; pe[p+3] = 0x61; pe[p+4] = 0x74; pe[p+5] = 0x61; pe[p+6] = 0; pe[p+7] = 0;
        p += 8;
        this.writeLe32(pe, p, importVirt); p += 4;
        this.writeLe32(pe, p, rdataRva); p += 4;
        this.writeLe32(pe, p, importRaw); p += 4;
        this.writeLe32(pe, p, rdataFileOff); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0xC0000040); p += 4;

        for (int i = 0; i < this.code.length; i++) {
            pe[textFileOff + i] = this.code[i];
        }

        int importBase = rdataFileOff;

        int descOff = 0;
        int[] groupIltStart = [];
        int rOff = 0;
        for (int g = 0; g < numGroups; g++) {
            groupIltStart.add(descBytes + rOff);
            rOff += iltSizes[g];
        }
        for (int g = 0; g < numGroups; g++) {
            int iltRva = rdataRva + groupIltStart[g];
            int iatRva = rdataRva + groupIatStart[g];
            int dllNameRva = rdataRva + namesStart + dllNameOffsets[g];

            this.writeLe32(pe, importBase + descOff, iltRva);
            this.writeLe32(pe, importBase + descOff + 4, 0);
            this.writeLe32(pe, importBase + descOff + 8, 0);
            this.writeLe32(pe, importBase + descOff + 12, dllNameRva);
            this.writeLe32(pe, importBase + descOff + 16, iatRva);
            descOff += 20;
        }

        int iltOff = descBytes;
        for (int g = 0; g < numGroups; g++) {
            int gBase = importBase + groupIltStart[g];
            int gIatBase = importBase + groupIatStart[g];
            for (int i = 0; i < numImports; i++) {
                if (importGroupIdx[i] == g) {
                    int entryOff = posInGroup[i] * 8;
                    int hintRva = rdataRva + namesStart + hintNameOffsets[i];
                    this.writeLe64(pe, gBase + entryOff, hintRva);
                    this.writeLe64(pe, gIatBase + entryOff, hintRva);
                }
            }
            int nullOff = groupSizes[g] * 8;
            this.writeLe64(pe, gBase + nullOff, 0);
            this.writeLe64(pe, gIatBase + nullOff, 0);
        }

        for (int i = 0; i < hintNames.length; i++) {
            pe[importBase + namesStart + i] = hintNames[i];
        }
        for (int i = 0; i < stringData.length; i++) {
            pe[importBase + stringsStart + i] = stringData[i];
        }

        return pe;
    }
}


class Lexer {
    private prop string src;
    private prop int pos;
    private prop int line;
    private prop int col;

    construct (string source) {
        this.src = source;
        this.pos = 0;
        this.line = 1;
        this.col = 1;
    }

    private bool strEq(string a, string b) {
        if (a.length != b.length) { return false; }
        for (int i = 0; i < a.length; i++) {
            if (a[i] != b[i]) { return false; }
        }
        return true;
    }

    private char? peek() {
        if (this.pos < this.src.length) {
            char c = this.src[this.pos];
            return c;
        }
        return null;
    }

    private char? peekNext() {
        if (this.pos + 1 < this.src.length) {
            char c2 = this.src[this.pos + 1];
            return c2;
        }
        return null;
    }

    private char? advance() {
        if (this.pos >= this.src.length) { return null; }
        char c = this.src[this.pos];
        this.pos += 1;
        if (c == '\n') {
            this.line += 1;
            this.col = 1;
        } else {
            this.col += 1;
        }
        return c;
    }

    private void skipWhitespace() {
        while (this.pos < this.src.length) {
            char c = this.src[this.pos];
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
                this.advance();
            } else {
                break;
            }
        }
    }

    private void skipLineComment() {
        while (this.pos < this.src.length) {
            char c = this.src[this.pos];
            if (c == '\n') { break; }
            this.advance();
        }
    }

    private bool skipBlockComment() {
        int depth = 1;
        while (this.pos < this.src.length && depth > 0) {
            char c = this.src[this.pos];
            if (c == '/' && this.peekNext() == '*') {
                depth += 1;
                this.advance();
                this.advance();
            } else if (c == '*' && this.peekNext() == '/') {
                depth -= 1;
                this.advance();
                this.advance();
            } else {
                this.advance();
            }
        }
        return depth == 0;
    }

    public Token[] tokenize() {
        Token[] tokens = [];
        while (true) {
            this.skipWhitespace();
            if (this.pos >= this.src.length) {
                tokens.add(new Token(0, "", this.line, this.col));
                break;
            }
        Token? tok = this.nextToken();
        if (tok != null) {
            tokens.add(tok);
        }
        }
        return tokens;
    }

    private Token? nextToken() {
        char c = this.src[this.pos];
        int ln = this.line;
        int cl = this.col;

        if (c == '/' && this.peekNext() != null) {
            char next = this.peekNext();
            if (next == '/') { this.advance(); this.skipLineComment(); return null; }
            if (next == '*') { this.advance(); this.advance(); this.skipBlockComment(); return null; }
        }

        if (c == '"') { this.advance(); return this.readString(); }
        if (c == '\'') { this.advance(); return this.readChar(); }
        if (c.isDigit()) { this.advance(); return this.readNumber(c); }
        if (c.isAlpha() || c == '_') { this.advance(); return this.readIdent(c); }

        this.advance();

        if (c == '(') { return new Token(100, "(", ln, cl); }
        if (c == ')') { return new Token(101, ")", ln, cl); }
        if (c == '{') { return new Token(102, "{", ln, cl); }
        if (c == '}') { return new Token(103, "}", ln, cl); }
        if (c == '[') { return new Token(104, "[", ln, cl); }
        if (c == ']') { return new Token(105, "]", ln, cl); }
        if (c == ';') { return new Token(106, ";", ln, cl); }
        if (c == ',') { return new Token(107, ",", ln, cl); }
        if (c == '.') {
            if (this.peek() == '.' && this.peekNext() != null && this.peekNext() == '.') {
                this.advance(); this.advance();
                return new Token(147, "...", ln, cl);
            }
            if (this.peek() == '.') { this.advance(); return new Token(144, "..", ln, cl); }
            return new Token(108, ".", ln, cl);
        }
        if (c == ':') { return new Token(109, ":", ln, cl); }
        if (c == '+') {
            if (this.peek() == '+') { this.advance(); return new Token(142, "++", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(130, "+=", ln, cl); }
            return new Token(111, "+", ln, cl);
        }
        if (c == '-') {
            if (this.peek() == '-') { this.advance(); return new Token(143, "--", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(131, "-=", ln, cl); }
            if (this.peek() == '>') { this.advance(); return new Token(145, "->", ln, cl); }
            return new Token(112, "-", ln, cl);
        }
        if (c == '*') {
            if (this.peek() == '=') { this.advance(); return new Token(132, "*=", ln, cl); }
            return new Token(113, "*", ln, cl);
        }
        if (c == '/') {
            if (this.peek() == '=') { this.advance(); return new Token(133, "/=", ln, cl); }
            return new Token(114, "/", ln, cl);
        }
        if (c == '%') { return new Token(115, "%", ln, cl); }
        if (c == '&') {
            if (this.peek() == '&') { this.advance(); return new Token(138, "&&", ln, cl); }
            return new Token(116, "&", ln, cl);
        }
        if (c == '|') {
            if (this.peek() == '|') { this.advance(); return new Token(139, "||", ln, cl); }
            return new Token(117, "|", ln, cl);
        }
        if (c == '<') {
            if (this.peek() == '<') { this.advance(); return new Token(140, "<<", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(136, "<=", ln, cl); }
            return new Token(120, "<", ln, cl);
        }
        if (c == '>') {
            if (this.peek() == '>') { this.advance(); return new Token(141, ">>", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(137, ">=", ln, cl); }
            return new Token(121, ">", ln, cl);
        }
        if (c == '=') {
            if (this.peek() == '=') { this.advance(); return new Token(134, "==", ln, cl); }
            if (this.peek() == '>') { this.advance(); return new Token(146, "=>", ln, cl); }
            return new Token(110, "=", ln, cl);
        }
        if (c == '!') {
            if (this.peek() == '=') { this.advance(); return new Token(135, "!=", ln, cl); }
            return new Token(122, "!", ln, cl);
        }
        if (c == '~') { return new Token(119, "~", ln, cl); }
        if (c == '^') { return new Token(118, "^", ln, cl); }
        if (c == '?') { return new Token(123, "?", ln, cl); }
        if (c == '#') { return new Token(125, "#", ln, cl); }

        printline("warn");
        return null;
    }

    private Token readString() {
        int ln = this.line; int cl = this.col;
        string s = "";
        while (this.pos < this.src.length) {
            char ch = this.src[this.pos]; this.advance();
            if (ch == '"') { break; }
            if (ch == '\\') {
                if (this.pos < this.src.length) {
                    char esc = this.src[this.pos]; this.advance();
                    if (esc == 'n') { s += "\n"; }
                    else if (esc == 't') { s += "\t"; }
                    else if (esc == '0') { s += "\0"; }
                    else { s += esc.toString(); }
                }
            } else {
                s += ch.toString();
            }
        }
        Token tok = new Token(3, s, ln, cl);
        tok.strVal = s;
        return tok;
    }

    private Token readChar() {
        int ln = this.line; int cl = this.col;
        char ch = ' ';
        if (this.pos < this.src.length) {
            ch = this.src[this.pos]; this.advance();
            if (ch == '\\' && this.pos < this.src.length) {
                char esc = this.src[this.pos]; this.advance();
                if (esc == 'n') { ch = '\n'; }
                else if (esc == 't') { ch = '\t'; }
                else if (esc == '0') { ch = '\0'; }
                else { ch = esc; }
            }
        }
        if (this.pos < this.src.length && this.src[this.pos] == '\'') {
            this.advance();
        }
        Token tok = new Token(4, ch.toString(), ln, cl);
        tok.charVal = ch;
        return tok;
    }

    private Token readNumber(char first) {
        int ln = this.line; int cl = this.col;
        string s = first.toString();
        bool isFloat = false;
        int base = 10;
        if (first == '0' && this.pos < this.src.length) {
            char next = this.src[this.pos];
            if (next == 'x' || next == 'X') {
                this.advance();
                base = 16;
                s = "";
            }
        }
        while (this.pos < this.src.length) {
            char ch = this.src[this.pos];
            if (ch.isDigit() || ch == '_') {
                s += ch.toString(); this.advance();
            } elif (base == 16 && ((ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F'))) {
                s += ch.toString(); this.advance();
            } elif (ch == '.' && !isFloat) {
                if (this.peek() == '.') { break; }
                isFloat = true; s += "."; this.advance();
            } elif (ch == 'e' || ch == 'E') {
                isFloat = true; s += ch.toString(); this.advance();
if (this.pos < this.src.length) {
                char sign = this.src[this.pos];
                if (sign == '+' || sign == '-') {
                    s += sign.toString(); this.advance();
                }
            }
            } else { break; }
        }
        Token tok = new Token(1, s, ln, cl);
        if (base == 16) {
            tok.intVal = s.toInt64FromBase(16);
        } else {
            tok.intVal = s.toInt64();
        }
        return tok;
    }

    private Token readIdent(char first) {
        int ln = this.line; int cl = this.col;
        string s = first.toString();
        while (this.pos < this.src.length) {
            char ch = this.src[this.pos];
            if (ch.isAlphaNum() || ch == '_') {
                s += ch.toString(); this.advance();
            } else { break; }
        }
        int kind = this.keywordKind(s);
        Token tok = new Token(kind, s, ln, cl);
        if (kind == 7) { tok.strVal = s; }
        return tok;
    }

    private int keywordKind(string s) {
        if (this.strEq(s, "if")) { return 10; }
        if (this.strEq(s, "else")) { return 11; }
        if (this.strEq(s, "while")) { return 12; }
        if (this.strEq(s, "for")) { return 13; }
        if (this.strEq(s, "foreach")) { return 14; }
        if (this.strEq(s, "return")) { return 15; }
        if (this.strEq(s, "match")) { return 16; }
        if (this.strEq(s, "void")) { return 17; }
        if (this.strEq(s, "int")) { return 18; }
        if (this.strEq(s, "int32")) { return 19; }
        if (this.strEq(s, "int64")) { return 20; }
        if (this.strEq(s, "float")) { return 22; }
        if (this.strEq(s, "float64")) { return 23; }
        if (this.strEq(s, "bool")) { return 25; }
        if (this.strEq(s, "char")) { return 26; }
        if (this.strEq(s, "string")) { return 27; }
        if (this.strEq(s, "var")) { return 28; }
        if (this.strEq(s, "struct")) { return 29; }
        if (this.strEq(s, "class")) { return 30; }
        if (this.strEq(s, "enum")) { return 31; }
        if (this.strEq(s, "def")) { return 32; }
        if (this.strEq(s, "new")) { return 39; }
        if (this.strEq(s, "const")) { return 40; }
        if (this.strEq(s, "true")) { return 5; }
        if (this.strEq(s, "false")) { return 5; }
        if (this.strEq(s, "null")) { return 6; }
        if (this.strEq(s, "import")) { return 36; }
        if (this.strEq(s, "from")) { return 37; }
        if (this.strEq(s, "as")) { return 38; }
        if (this.strEq(s, "mod")) { return 35; }
        if (this.strEq(s, "mut")) { return 50; }
        if (this.strEq(s, "public")) { return 44; }
        if (this.strEq(s, "private")) { return 45; }
        if (this.strEq(s, "static")) { return 46; }
        if (this.strEq(s, "prop")) { return 47; }
        if (this.strEq(s, "construct")) { return 48; }
        if (this.strEq(s, "unset")) { return 49; }
        if (this.strEq(s, "try")) { return 52; }
        if (this.strEq(s, "catch")) { return 53; }
        if (this.strEq(s, "found")) { return 33; }
        if (this.strEq(s, "collect")) { return 34; }
        if (this.strEq(s, "ref")) { return 51; }
        if (this.strEq(s, "in")) { return 54; }
        if (this.strEq(s, "to")) { return 55; }
        if (this.strEq(s, "elif")) { return 56; }
        if (this.strEq(s, "break")) { return 57; }
        if (this.strEq(s, "continue")) { return 58; }
        if (this.strEq(s, "export")) { return 59; }
        return 7;
    }
}

class Token {
    public prop int kind;
    public prop string text;
    public prop int line;
    public prop int col;
    public prop int64 intVal;
    public prop float64 floatVal;
    public prop string strVal;
    public prop char charVal;

    construct (int kind, string text, int line, int col) {
        this.kind = kind; this.text = text;
        this.line = line; this.col = col;
        this.intVal = 0; this.floatVal = 0.0;
        this.strVal = ""; this.charVal = ' ';
    }
}

class Parser {
    private prop Token[] tokens;
    private prop int pos;

    construct (Token[] toks) {
        this.tokens = toks;
        this.pos = 0;
    }

    private bool strEq(string a, string b) {
        if (a.length != b.length) { return false; }
        for (int i = 0; i < a.length; i++) {
            if (a[i] != b[i]) { return false; }
        }
        return true;
    }

    private void pppp() {
        Node n = new Node();
        n.kind = 64;
        this.expect(14);
        this.expect(100);
        Node v = new Node();
        v.kind = 50;
        string vt = this.advance().text;
        while (this.check(104)) { this.advance(); this.expect(105); vt = vt + "[]"; }
        if (this.check(123)) { this.advance(); vt = vt + "?"; }
        v.typeHint = vt;
        v.name = this.advance().text;
        n.children.add(v);
        this.expect(54);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlock());
        return n;
    }

    private Token peek() {
        if (this.pos < this.tokens.length) {
            return this.tokens[this.pos];
        }
        return this.tokens[this.tokens.length - 1];
    }

    private Token advance() {
        Token t = this.tokens[this.pos];
        this.pos = this.pos + 1;
        return t;
    }

    private bool check(int kind) {
        Token t = this.peek();
        int pk = t.kind;
        return pk == kind;
    }

    private Token expect(int kind) {
        if (this.check(kind)) {
            return this.advance();
        }
        Token t = this.peek();
        printline("err");
        exit(1);
        return t;
    }

    public Node[] parseProgram() {
        Node[] items = [];
        while (!this.check(0)) {
            int posBefore = this.pos;
            Node? item = this.parseItem();
            if (item != null) {
                items.add(item);
            }
            if (this.pos == posBefore) {
                printline("parse stall at token");
                printline(this.pos);
                break;
            }
        }
        return items;
    }

	private Node? parseItem() {
		if (this.check(35)) { this.advance(); if (this.check(59)) { this.advance(); } this.advance(); this.expect(106); return null; }
		if (this.check(36)) { return this.parseImport(); }
        if (this.check(40)) { return this.parseConst(); }
        if (this.check(32)) { return this.parseDef(); }
        if (this.check(29)) { return this.parseStruct(); }
        if (this.check(30)) { return this.parseClass(); }
        return this.parseFunction();
    }

    private Node parseImport() {
        Node node = new Node();
        node.kind = 105;
        this.expect(36);
        node.name = this.advance().text;
        if (this.check(37)) {
            this.advance();
            this.advance();
        }
        this.expect(106);
        return node;
    }

    private Node parseConst() {
        Node node = new Node();
        node.kind = 104;
        this.expect(40);
        node.typeHint = this.advance().text;
        node.name = this.advance().text;
        this.expect(110);
        node.children.add(this.parseExpr(0));
        this.expect(106);
        return node;
    }

    private Node parseDef() {
        Node node = new Node();
        this.expect(32);
        node.name = this.advance().text;
        if (this.check(110)) {
            node.kind = 103;
            this.advance();
            this.expect(31);
            this.expect(102);
            while (!this.check(103)) {
                node.children.add(this.parsePattern());
                if (this.check(107)) { this.advance(); }
            }
            this.expect(103);
            this.expect(106);
        } else {
            node.kind = 110;
            this.expect(106);
        }
        return node;
    }

    private Node parseStruct() {
        Node node = new Node();
        node.kind = 101;
        this.expect(29);
        node.name = this.advance().text;
        this.expect(102);
        while (!this.check(103)) {
            Node field = new Node();
            field.typeHint = this.advance().text;
            string fn = this.advance().text;
            field.name = fn;
            field.kind = 0;
            node.children.add(field);
            this.expect(106);
        }
        this.expect(103);
        return node;
    }

    private Node parseClass() {
        Node node = new Node();
        node.kind = 102;
        this.expect(30);
        node.name = this.advance().text;
        if (this.check(109)) {
            this.advance();
            node.parentClass = this.advance().text;
        }
        this.expect(102);
        while (!this.check(103)) {
            Node member = this.parseClassMember();
            if (member != null) { node.children.add(member); }
        }
        this.expect(103);
        return node;
    }

    private Node? parseClassMember() {
        if (this.check(44) || this.check(45)) { this.advance(); }
        if (this.check(46)) { this.advance(); }
        if (this.check(48)) {
            Node ctor = new Node();
            ctor.kind = 100;
            ctor.name = "construct";
            this.advance();
            this.expect(100);
            while (!this.check(101)) {
                Node param = new Node();
                string cpt = this.advance().text;
                while (this.check(104)) { this.advance(); this.expect(105); cpt = cpt + "[]"; }
                if (this.check(123)) { this.advance(); cpt = cpt + "?"; }
                param.typeHint = cpt;
                param.name = this.advance().text;
                ctor.children.add(param);
                if (this.check(107)) { this.advance(); }
            }
            this.expect(101);
            ctor.children.add(this.parseBlock());
            return ctor;
        }
        if (this.check(47)) {
            this.advance();
            Node field = new Node();
            field.kind = 50;
            string ft = this.advance().text;
            while (this.check(104)) { this.advance(); this.expect(105); ft = ft + "[]"; }
            if (this.check(123)) { this.advance(); ft = ft + "?"; }
            field.typeHint = ft;
            field.name = this.advance().text;
            this.expect(106);
            return field;
        }
        if (this.check(28) || this.check(18) || this.check(19) || this.check(20) || this.check(25) || this.check(27) || this.check(22) || this.check(23) || this.check(26) || this.check(7)) {
            int savedPos = this.pos;
            string ft = this.advance().text;
            while (this.check(104)) { this.advance(); this.expect(105); ft = ft + "[]"; }
            if (this.check(123)) { this.advance(); ft = ft + "?"; }
            if (this.check(7) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 106) {
                Node field = new Node();
                field.kind = 50;
                field.typeHint = ft;
                field.name = this.advance().text;
                this.expect(106);
                return field;
            }
            this.pos = savedPos;
        }
        return this.parseFunction();
    }

    private Node parseFunction() {
        Node node = new Node();
        node.kind = 100;
        string retType = this.advance().text;
        while (this.check(104)) { this.advance(); this.expect(105); retType = retType + "[]"; }
        if (this.check(123)) { this.advance(); retType = retType + "?"; }
        node.typeHint = retType;
        node.name = this.advance().text;
        this.expect(100);
        Node params = new Node();
        while (!this.check(101)) {
            Node param = new Node();
            string pt = this.advance().text;
            while (this.check(104)) { this.advance(); this.expect(105); pt = pt + "[]"; }
            if (this.check(123)) { this.advance(); pt = pt + "?"; }
            param.typeHint = pt;
            param.name = this.advance().text;
            params.children.add(param);
            if (this.check(107)) { this.advance(); }
        }
        this.expect(101);
        node.children.add(params);
        if (this.check(141)) {
            this.advance();
            node.children.add(this.parseExpr(0));
        } else {
            node.children.add(this.parseBlock());
        }
        return node;
    }

    private Node parseBlock() {
        Node block = new Node();
        block.kind = 16;
        this.expect(102);
        while (!this.check(103)) {
            block.children.add(this.parseStmt());
        }
        this.expect(103);
        return block;
    }

    private Node parseStmt() {
        if (this.check(7) && this.pos + 1 < this.tokens.length) {
            Token next = this.tokens[this.pos + 1];
            if (next.kind == 7) {
                return this.parseVarDecl();
            }
if (next.kind == 104 && this.pos + 2 < this.tokens.length && this.tokens[this.pos + 2].kind == 105) {
                return this.parseVarDecl();
            }
            if (next.kind == 123 && this.pos + 2 < this.tokens.length && this.tokens[this.pos + 2].kind == 7) {
                return this.parseVarDecl();
            }
        }
        if (this.check(15)) {
            Node n = new Node(); n.kind = 51;
            this.advance();
            if (!this.check(106)) { n.children.add(this.parseExpr(0)); }
            this.expect(106);
            return n;
        }
        if (this.check(141)) {
            Node n = new Node(); n.kind = 52;
            this.advance();
            n.children.add(this.parseExpr(0));
            this.expect(106);
            return n;
        }
        if (this.check(10)) { return this.parseIf(); }
        if (this.check(12)) { return this.parseWhile(); }
        if (this.check(13)) { return this.parseFor(); }
        if (this.check(14)) { return this.pppp(); }
        if (this.check(57)) { Node n = new Node(); n.kind = 62; this.advance(); this.expect(106); return n; }
        if (this.check(58)) { Node n = new Node(); n.kind = 63; this.advance(); this.expect(106); return n; }
        if (this.check(49)) {
            Node n = new Node(); n.kind = 60;
            this.advance();
            n.name = this.advance().text;
            this.expect(106);
            return n;
        }
        if (this.check(28) || this.check(18) || this.check(19) || this.check(20) || this.check(25) || this.check(27) || this.check(22) || this.check(23) || this.check(26)) {
            return this.parseVarDecl();
        }
        Node exprStmt = new Node(); exprStmt.kind = 61;
        exprStmt.children.add(this.parseExpr(0));
        this.expect(106);
        return exprStmt;
    }

    private Node parseVarDecl() {
        Node n = new Node(); n.kind = 50;
        string typeName = this.advance().text;
        while (this.check(104)) {
            this.advance();
            this.expect(105);
            typeName = typeName + "[]";
        }
        if (this.check(123)) { this.advance(); typeName = typeName + "?"; }
        n.typeHint = typeName;
        if (this.check(50)) { this.advance(); n.isMut = true; }
        n.name = this.advance().text;
        if (this.check(110)) {
            this.advance();
            n.children.add(this.parseExpr(0));
        }
        this.expect(106);
        return n;
    }

    private Node parseIf() {
        Node n = new Node(); n.kind = 53;
        if (this.check(56)) {
            this.advance();
        } else {
            this.expect(10);
        }
        this.expect(100);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlock());
        if (this.check(11)) {
            this.advance();
            if (this.check(10)) {
                n.children.add(this.parseIf());
            } elif (this.check(56)) {
                n.children.add(this.parseIf());
            } else {
                n.children.add(this.parseBlock());
            }
        } elif (this.check(56)) {
            n.children.add(this.parseIf());
        }
        return n;
    }

    private Node parseWhile() {
        Node n = new Node(); n.kind = 54;
        this.expect(12);
        this.expect(100);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlock());
        return n;
    }

    private Node parseFor() {
        Node n = new Node();
        this.expect(13);
        this.expect(100);
        if (this.check(28) || this.check(18) || this.check(19) || this.check(20)) {
            n.kind = 55;
            n.children.add(this.parseVarDecl());
        } else {
            n.kind = 55;
            n.children.add(this.parseStmt());
        }
        n.children.add(this.parseExpr(0));
        this.expect(106);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlock());
        return n;
    }

    private Node parseExpr(int minPrec) {
        Node lhs = this.parsePrefix();
        while (true) {
            if (this.check(100) && lhs.kind == 6) {
                Node call = new Node(); call.kind = 10;
                call.name = lhs.name;
                this.advance();
                while (!this.check(101)) {
                    call.children.add(this.parseExpr(0));
                    if (this.check(107)) { this.advance(); }
                }
                this.expect(101);
                lhs = call;
                continue;
            }
            if (this.check(104)) {
                Node idx = new Node(); idx.kind = 24;
                idx.children.add(lhs);
                this.advance();
                idx.children.add(this.parseExpr(0));
                this.expect(105);
                lhs = idx;
                continue;
            }
            if (this.check(108)) {
                this.advance();
                Token name = this.advance();
                if (this.check(100)) {
                    Node call = new Node(); call.kind = 10;
                    call.name = name.text;
                    call.children.add(lhs);
                    this.advance();
                    while (!this.check(101)) {
                        call.children.add(this.parseExpr(0));
                        if (this.check(107)) { this.advance(); }
                    }
                    this.expect(101);
                    lhs = call;
                } else {
                    Node member = new Node(); member.kind = 13;
                    member.name = name.text;
                    member.children.add(lhs);
                    lhs = member;
                }
                continue;
            }
            if (this.check(142)) {
                this.advance();
                Node add = new Node(); add.kind = 7; add.op = 1;
                Node one = new Node(); one.kind = 0; one.intVal = 1;
                add.children.add(lhs);
                add.children.add(one);
                Node assign = new Node(); assign.kind = 7; assign.op = 20;
                assign.children.add(lhs);
                assign.children.add(add);
                lhs = assign;
                continue;
            }
            if (this.check(143)) {
                this.advance();
                Node sub = new Node(); sub.kind = 7; sub.op = 2;
                Node one = new Node(); one.kind = 0; one.intVal = 1;
                sub.children.add(lhs);
                sub.children.add(one);
                Node assign = new Node(); assign.kind = 7; assign.op = 20;
                assign.children.add(lhs);
                assign.children.add(sub);
                lhs = assign;
                continue;
            }
            if (this.check(123)) {
                this.advance();
                Node thenExpr = this.parseExpr(0);
                this.expect(109);
                Node elseExpr = this.parseExpr(0);
                Node tern = new Node(); tern.kind = 65;
                tern.children.add(lhs);
                tern.children.add(thenExpr);
                tern.children.add(elseExpr);
                lhs = tern;
                continue;
            }
            int prec = this.getPrec(this.peek().kind);
            if (prec < minPrec) { break; }
            int nextMin = prec + 1;
            int op = this.peek().kind;
            this.advance();
            Node rhs = this.parseExpr(nextMin);
            Node bin = new Node(); bin.kind = 7;
            bin.op = this.tokenToOp(op);
            bin.children.add(lhs);
            bin.children.add(rhs);
            lhs = bin;
        }
        return lhs;
    }

    private int tokenToOp(int kind) {
        if (kind == 111) { return 1; }
        if (kind == 112) { return 2; }
        if (kind == 113) { return 3; }
        if (kind == 114) { return 4; }
        if (kind == 115) { return 4; }
        if (kind == 134) { return 5; }
        if (kind == 135) { return 6; }
        if (kind == 120) { return 7; }
        if (kind == 136) { return 8; }
        if (kind == 121) { return 9; }
        if (kind == 137) { return 10; }
        if (kind == 138) { return 11; }
        if (kind == 139) { return 12; }
        if (kind == 110) { return 20; }
        if (kind == 130) { return 14; }
        if (kind == 131) { return 15; }
        if (kind == 132) { return 16; }
        if (kind == 133) { return 17; }
        if (kind == 140) { return 18; }
        if (kind == 141) { return 19; }
        if (kind == 144) { return 20; }
        if (kind == 116) { return 22; }
        if (kind == 117) { return 23; }
        if (kind == 118) { return 24; }
        return 0;
    }

    private int getPrec(int kind) {
        if (kind == 110 || kind == 130 || kind == 131 || kind == 132 || kind == 133) { return 1; }
        if (kind == 139) { return 2; }
        if (kind == 138) { return 3; }
        if (kind == 135 || kind == 134) { return 4; }
        if (kind == 120 || kind == 136 || kind == 121 || kind == 137) { return 5; }
        if (kind == 117) { return 6; }
        if (kind == 116) { return 7; }
        if (kind == 140 || kind == 141) { return 8; }
        if (kind == 111 || kind == 112) { return 9; }
        if (kind == 113 || kind == 114 || kind == 115) { return 10; }
        if (kind == 144) { return 11; }
        return -1;
    }

    private Node parsePrefix() {
        Token t = this.advance();
        Node n = new Node();
        n.line = t.line; n.col = t.col;
        int kind = t.kind;

        if (kind == 1) { n.kind = 0; n.intVal = t.intVal; return n; }
        if (kind == 2) { n.kind = 1; n.floatVal = t.floatVal; return n; }
        if (kind == 3) { n.kind = 2; n.strVal = t.strVal; return n; }
        if (kind == 4) { n.kind = 3; n.charVal = t.charVal; return n; }
        if (kind == 5) {
            n.kind = 4;
            n.boolVal = this.strEq(t.text, "true");
            return n;
        }
        if (kind == 6) { n.kind = 5; return n; }
        if (kind == 7) { n.kind = 6; n.name = t.text; return n; }
        if (kind == 39) {
            Node ctor = new Node(); ctor.kind = 10;
            ctor.name = this.advance().text;
            this.expect(100);
            while (!this.check(101)) {
                ctor.children.add(this.parseExpr(0));
                if (this.check(107)) { this.advance(); }
            }
            this.expect(101);
            return ctor;
        }

        if (kind == 100) { n.kind = 23; n.children.add(this.parseExpr(0)); this.expect(101); return n; }
        if (kind == 102) {
            Node[] children = [];
            while (!this.check(103)) {
                children.add(this.parseExpr(0));
                if (this.check(107)) { this.advance(); }
            }
            this.expect(103);
            n.kind = 19;
            foreach (Node child in children) { n.children.add(child); }
            return n;
        }

        if (kind == 104) {
            n.kind = 19;
            while (!this.check(105)) {
                n.children.add(this.parseExpr(0));
                if (this.check(107)) { this.advance(); }
            }
            this.expect(105);
            return n;
        }

        if (kind == 112) { n.kind = 8; n.op = 0; n.children.add(this.parseExpr(10)); return n; }
        if (kind == 122) { n.kind = 8; n.op = 1; n.children.add(this.parseExpr(10)); return n; }
        if (kind == 116) { n.kind = 8; n.op = 3; n.children.add(this.parseExpr(10)); return n; }

        Node ident = new Node(); ident.kind = 6; ident.name = t.text;
        return ident;
    }

    private Node parsePattern() {
        Node n = new Node();
        Token t = this.advance();
        if (t.kind == 126) { n.name = "_"; return n; }
        if (t.kind == 1) { n.kind = 0; n.intVal = t.intVal; return n; }
        if (t.kind == 7) { n.name = t.text; return n; }
        return n;
    }
}

class Node {
    public prop int kind;
    public prop int64 intVal;
    public prop float64 floatVal;
    public prop string strVal;
    public prop char charVal;
    public prop bool boolVal;
    public prop int op;
    public prop string name;
    public prop string typeHint;
    public prop bool isMut;
    public prop bool isPublic;
    public prop bool isStatic;
    public prop string parentClass;
    public prop Node[] children;
    public prop int line;
    public prop int col;

    construct () {
        this.kind = 0; this.intVal = 0; this.floatVal = 0.0;
        this.strVal = ""; this.charVal = ' '; this.boolVal = false;
        this.op = 0; this.name = ""; this.typeHint = "";
        this.isMut = false; this.isPublic = true; this.isStatic = false;
        this.parentClass = ""; this.children = [];
        this.line = 0; this.col = 0;
    }

    public int childCount() {
        return this.children.length;
    }

    public Node child(int i) {
        if (i >= 0 && i < this.children.length) {
            return this.children[i];
        }
        return new Node();
    }
}


