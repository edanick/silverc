// Read-only prop resolution: a read-only prop is read everywhere (outside,
// inside the declaring class, through an inherited flattened layout), while
// mutable fields take every store form — plain, compound, inc/dec and
// object-initializer. Exit code 0 = exact.
class Base {
    public read only prop string origin = "base";
    public prop int baseValue;

    construct(int v) {
        baseValue = v;
    }
}

class Derived extends Base {
    public prop int extra;

    construct(int v, int e) {
        super(v);
        extra = e;
    }

    def readOrigin() -> string {
        return origin;
    }
}

void check(bool ok, string label) {
    if (!ok) {
        printline("FAIL " + label);
        exit(1);
    }
}

void main() {
    Derived d = new Derived(5, 7) { extra = 9 };
    check(d.origin == "base", "readonly-read");
    check(d.readOrigin() == "base", "readonly-in-method");
    d.baseValue += 2;
    check(d.baseValue == 7, "compound-store-mutable");
    d.baseValue++;
    check(d.baseValue == 8, "inc-store-mutable");
    check(d.extra == 9, "initializer-store-mutable");
    printline("read-only prop ok");
}
