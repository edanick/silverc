// A closure captures the enclosing function's locals BY VALUE.
//
// A `(void () { ... })` body is its own function, but it may READ the
// locals of the function it was written in: the compiler copies those
// values into the closure when the closure is created and the body reads
// them from there. A named function reference keeps its old meaning (the
// function's address), and a closure body that assigns to an enclosing
// local is refused: the capture is a copy, so the assignment would
// silently land in the copy. Self-hosted-suite mirror of
// silverc-rs/tests/suite/closure_capture.sr.

class holder {
    public string name;

    construct(string name) {
        this.name = name;
    }
}

void namedGreeting() {
    printline("named");
}

void main() {
    // A plain function reference still calls the function.
    void () plain = namedGreeting;
    plain();

    // A captured string reads as text, not as an address.
    string who = "ann";
    void () greet = (void () {
        printline("hi " + who);
    });
    greet();

    // Several captured values, of different kinds.
    int count = 42;
    holder box = new holder("bx");
    void () many = (void () {
        printline("many " + who + " " + count + " " + box.name);
    });
    many();

    // A closure inside a closure: the inner one captures the outer
    // body's local as well.
    void () outer = (void () {
        string inner = "deep";
        void () deep = (void () {
            printline("nested " + who + " " + inner);
        });
        deep();
    });
    outer();

    // The capture happens when the closure is CREATED: a later change
    // of the enclosing local is not seen by the closure.
    string later = "first";
    void () snapshot = (void () {
        printline("snapshot " + later);
    });
    later = "second";
    snapshot();

    // The closure literal called DIRECTLY: the closure value is the
    // callee, so the capture reaches the body the same way.
    string direct = "ann";
    (void () { printline("direct " + direct); })();

    printline("ok");
}
