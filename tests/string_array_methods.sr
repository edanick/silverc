// The array methods that build a NEW array from the receiver: take, skip,
// slice, distinct, chunk and zip (DOCS/89, DOCS/133, DOCS/134, DOCS/135,
// DOCS/136). Every one of them answers a fresh array and leaves the
// receiver untouched. Exit code 0 = exact.

void check(bool ok, string label) {
    if (!ok) {
        printline("FAIL " + label);
        exit(1);
    }
}

void main() {
    int[] a = [1, 2, 3, 4, 5];

    // take(n): the first n elements (DOCS/133).
    int[] taken = a.take(2);
    check(taken.length == 2, "take-length");
    check(taken[0] == 1 && taken[1] == 2, "take-values");
    check(a.take(99).length == 5, "take-clamp");
    check(a.take(0).length == 0, "take-zero");

    // skip(n): the elements from index n onward (DOCS/133).
    int[] skipped = a.skip(3);
    check(skipped.length == 2, "skip-length");
    check(skipped[0] == 4 && skipped[1] == 5, "skip-values");
    check(a.skip(0).length == 5, "skip-zero");
    check(a.skip(99).length == 0, "skip-clamp");

    // slice(start, end): the end index is EXCLUSIVE (DOCS/89).
    int[] sliced = a.slice(1, 3);
    check(sliced.length == 2, "slice-length");
    check(sliced[0] == 2 && sliced[1] == 3, "slice-values");
    check(a.slice(0, 2).length == 2, "slice-head");
    check(a.slice(2, 2).length == 0, "slice-empty");

    // The receiver never changes.
    check(a.length == 5, "receiver-length");
    check(a[0] == 1 && a[4] == 5, "receiver-values");

    // distinct(): the duplicates removed, first occurrence order kept
    // (DOCS/134).
    int[] dupes = [1, 2, 2, 3, 3, 3];
    int[] unique = dupes.distinct();
    check(unique.length == 3, "distinct-length");
    check(unique[0] == 1 && unique[1] == 2 && unique[2] == 3, "distinct-values");

    // chunk(n): the elements grouped n at a time, the last group holds the
    // remainder (DOCS/135).
    int[][] chunks = a.chunk(2);
    check(chunks.length == 3, "chunk-count");
    check(chunks[0].length == 2, "chunk-0-length");
    check(chunks[0][0] == 1 && chunks[0][1] == 2, "chunk-0-values");
    check(chunks[1].length == 2 && chunks[1][0] == 3, "chunk-1-values");
    check(chunks[2].length == 1 && chunks[2][0] == 5, "chunk-last");

    // zip(other): the element-wise pairs, as many as the shorter array
    // (DOCS/136).
    int[] other = [10, 20, 30];
    int[][] pairs = a.zip(other);
    check(pairs.length == 3, "zip-count");
    check(pairs[0].length == 2, "zip-pair-length");
    check(pairs[0][0] == 1 && pairs[0][1] == 10, "zip-pair-0");
    check(pairs[2][0] == 3 && pairs[2][1] == 30, "zip-pair-2");

    // The same methods over string elements.
    string[] words = ["a", "b", "a"];
    check(words.distinct().length == 2, "string-distinct");
    check(words.take(2).length == 2, "string-take");
    check(words.skip(1).length == 2, "string-skip");
    string[][] wordChunks = words.chunk(2);
    check(wordChunks.length == 2, "string-chunk-count");
    check(wordChunks[0].length == 2, "string-chunk-0");
    check(wordChunks[1].length == 1, "string-chunk-1");
    string[] same = ["x", "x"];
    check(same.distinct().length == 1, "string-distinct-same");

    printline("string array methods ok");
}
