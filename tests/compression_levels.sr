// Compression levels (DOCS/260): deflate/gzip are zlib-style 0..9 (0 = stored,
// 1..9 = increasing match-search effort, clamped), zstd is 1..22 (clamped).
// Asserts every level round-trips, higher level is never worse (non-increasing
// output), level 0 (stored) is strictly larger than level 1, and out-of-range
// levels clamp and still round-trip. Runs on the compilers (they execute the
// codecs; the interpreter cannot run these engines).
import { gzip, zstd, deflate } from compression;

bool eq(byte[] a, byte[] e) {
    if (a.length != e.length) { return false; }
    for (int i = 0; i < a.length; i++) { if (a[i] != e[i]) { return false; } }
    return true;
}

void main() {
    byte[] r = [];
    for (int k = 0; k < 200; k++) {
        r.add(65); r.add(66); r.add(67); r.add(65); r.add(66); r.add(90);
    }
    int prev = -1;
    for (int level = 0; level <= 9; level++) {
        byte[] c = deflate.compressWithLevel(r, level);
        if (!eq(deflate.decompress(c), r)) { printline("FAIL dfl rt"); exit(1); }
        if (prev >= 0 && c.length > prev) { printline("FAIL dfl grow"); exit(1); }
        prev = c.length;
    }
    if (!(deflate.compressWithLevel(r, 0).length > deflate.compressWithLevel(r, 1).length)) { printline("FAIL dfl stored>l1"); exit(1); }

    int gprev = -1;
    for (int level = 0; level <= 9; level++) {
        byte[] c = gzip.compressWithLevel(r, level);
        if (!eq(gzip.decompress(c), r)) { printline("FAIL gz rt"); exit(1); }
        if (gprev >= 0 && c.length > gprev) { printline("FAIL gz grow"); exit(1); }
        gprev = c.length;
    }
    if (!(gzip.compressWithLevel(r, 0).length > gzip.compressWithLevel(r, 1).length)) { printline("FAIL gz stored>l1"); exit(1); }
    if (!eq(gzip.decompress(gzip.compressWithLevel(r, -5)), r)) { printline("FAIL gz clamp neg"); exit(1); }
    if (!eq(gzip.decompress(gzip.compressWithLevel(r, 99)), r)) { printline("FAIL gz clamp hi"); exit(1); }

    for (int level = 1; level <= 22; level++) {
        byte[] c = zstd.compressWithLevel(r, level);
        if (!eq(zstd.decompress(c), r)) { printline("FAIL zs rt"); exit(1); }
    }
    if (!eq(zstd.decompress(zstd.compressWithLevel(r, 0)), r)) { printline("FAIL zs clamp lo"); exit(1); }
    if (!eq(zstd.decompress(zstd.compressWithLevel(r, 100)), r)) { printline("FAIL zs clamp hi"); exit(1); }

    if (!eq(deflate.decompress(deflate.compress(r)), r)) { printline("FAIL dfl def"); exit(1); }
    if (!eq(gzip.decompress(gzip.compress(r)), r)) { printline("FAIL gz def"); exit(1); }
    if (!eq(zstd.decompress(zstd.compress(r)), r)) { printline("FAIL zs def"); exit(1); }
    printline("levels-ok");
}
