// Preprocessor path literals (DOCS/257): `*"..."` normalizes separators at
// compile time with backslashes always literal. Expectations branch per
// target OS because the rewritten value differs. Exit code 0 = exact.
void main() {
    string a = *"path/to/file";
    string b = *"path\to\file";
    string c = *"C:\new\file";
    string d = *"mixed\a/b";
    string e = *"";
    #on WINDOWS
    if (a != "path\\to\\file") { printline("FAIL slash"); exit(1); }
    if (b != "path\\to\\file") { printline("FAIL backslash"); exit(1); }
    if (c != "C:\\new\\file") { printline("FAIL backslash-n"); exit(1); }
    if (d != "mixed\\a\\b") { printline("FAIL mixed"); exit(1); }
    if (e != "") { printline("FAIL empty"); exit(1); }
    #else
    if (a != "path/to/file") { printline("FAIL slash"); exit(1); }
    if (b != "path/to/file") { printline("FAIL backslash"); exit(1); }
    if (c != "C:/new/file") { printline("FAIL backslash-n"); exit(1); }
    if (d != "mixed/a/b") { printline("FAIL mixed"); exit(1); }
    if (e != "") { printline("FAIL empty"); exit(1); }
    #off
    printline("paths OK");
}
