// JSON document (DOCS/66): load completes and the file is removed.
// Plain import only. json.load takes a holder object it cannot populate
// (local rebind), so only completion is asserted. All paths target
// output/. Exit code 0 = all checks pass.
import json;

void expect(bool got, string what) {
    if (!got) {
        printline("json check failed: " + what);
        exit(1);
    }
}

void main() {
    string jsonPath = "output/json_files_tmp.json";
    file.writeString(jsonPath, "{\"name\": \"Alice\"}");
    object jsonHolder = {};
    json.load(jsonPath, jsonHolder);
    expect(file.exists(jsonPath), "json load leaves file");
    file.delete(jsonPath);

    printline("json-files-ok");
}
