// A STATIC class field has class-level storage: one value shared by every
// instance, read and written as `ClassName.field`. Before the fix the
// declaration was parsed as an ordinary instance field, so the value was
// never allocated and `Counter.total` answered garbage.
class Counter {
    public static float64 total;
    public static int count = 3;
    public static string label = "hello";
    public int instanceField = 7;

    public void bump() {
        total = total + 1.5;
        count = count + 1;
    }
}

void main() {
    if (Counter.count != 3) {
        printline($"static initializer wrong: {Counter.count}");
        exit(1);
    }
    if (Counter.label != "hello") {
        printline($"static string initializer wrong: {Counter.label}");
        exit(1);
    }
    Counter c = Counter();
    if (c.instanceField != 7) {
        printline($"instance initializer wrong: {c.instanceField}");
        exit(1);
    }
    c.bump();
    if (Counter.count != 4) {
        printline($"static field not written: {Counter.count}");
        exit(1);
    }
    if (Counter.total != 1.5) {
        printline($"static float field wrong: {Counter.total}");
        exit(1);
    }
    // A second instance sees the same shared storage.
    Counter d = Counter();
    d.bump();
    if (Counter.count != 5) {
        printline("static field is not shared between instances");
        exit(1);
    }
    printline("ok");
}
