// Name-check dict-scope fixture (namecheck audit): name membership in
// NcScope / declNames / the field-name set is a dict lookup, not a
// per-use linear scan, and the inherited-field walk visits each ancestor
// once (diamond-safe). This program exercises many program-level
// declarations (declNames), wide function scopes (NcScope), repeated
// member receivers (scope adds per access), bare-field resolution through
// a diamond (Base reached via Left and via Right), and an assignment
// target that is a class field name. It must compile with NO name-check
// diagnostics and print exactly `namecheck-dict-ok 363`.

class Base {
    int total;
    int count;

    construct(int t, int c) {
        this.total = t;
        this.count = c;
    }

    int bump() {
        this.total = this.total + 1;
        this.count = this.count + 1;
        return this.total;
    }

    int read() {
        return this.total + this.count;
    }
}

class Left : Base {
    int lval;

    construct(int t, int c, int l) {
        super(t, c);
        this.lval = l;
    }

    int getL() {
        return this.lval;
    }
}

class Right : Base {
    int rval;

    construct(int t, int c, int r) {
        super(t, c);
        this.rval = r;
    }

    int getR() {
        return this.rval;
    }
}

class Both : Left, Right {
    int bval;

    construct(int t, int c, int l, int r, int b) {
        super(t, c, l);
        this.rval = r;
        this.bval = b;
    }
}

int f1(int x) { return x + 1; }
int f2(int x) { return x + 2; }
int f3(int x) { return x + 3; }
int f4(int x) { return x + 4; }
int f5(int x) { return x + 5; }
int f6(int x) { return x + 6; }
int f7(int x) { return x + 7; }
int f8(int x) { return x + 8; }

int globalBase = 100;

void main() {
    int l1 = 1;
    int l2 = 2;
    int l3 = 3;
    int l4 = 4;
    int l5 = 5;
    int l6 = 6;
    int l7 = 7;
    int l8 = 8;
    int l9 = 9;
    int l10 = 10;
    int l11 = 11;
    int l12 = 12;
    int l13 = 13;
    int l14 = 14;
    int l15 = 15;
    int l16 = 16;
    int l17 = 17;
    int l18 = 18;
    int l19 = 19;
    int l20 = 20;
    int localSum = l1 + l2 + l3 + l4 + l5 + l6 + l7 + l8 + l9 + l10;
    localSum = localSum + l11 + l12 + l13 + l14 + l15 + l16 + l17 + l18 + l19 + l20;
    int fnSum = f1(10) + f2(10) + f3(10) + f4(10) + f5(10) + f6(10) + f7(10) + f8(10);
    Both b = new Both(10, 5, 3, 4, 2);
    int after = b.bump();
    int got = b.read() + b.getL() + b.getR() + b.bval + globalBase - 100;
    int total = localSum + fnSum + after + got;
    printline("namecheck-dict-ok " + (string)total);
}
