class Tok {
    public prop int kind;
    public prop string text;
    public prop int line;
    public prop int col;

    construct (int k, string t, int ln, int c) {
        this.kind = k; this.text = t;
        this.line = ln; this.col = c;
    }
}

void main() {
    Tok t;
    t = new Tok(7, "Foo", 2, 5);

    printline($"2-arg: kind={t.kind} text={t.text}");
    printline($"3-arg: kind={t.kind} text={t.text} line={t.line}");
    printline($"4-arg: kind={t.kind} text={t.text} line={t.line} col={t.col}");

    int a = 1;
    int b = 2;
    int c = 3;
    int d = 4;
    printline($"ints: a={a} b={b} c={c} d={d}");
}
