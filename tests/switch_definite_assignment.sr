// Definite assignment through switch statements (branch-label
// antecedent merge concept): a variable is definitely assigned after a
// switch only when every case body AND the else body assign it. A
// switch without an else keeps the no-match path unassigned.

void main() {
    // All cases plus else assign: definitely assigned afterwards.
    int x;
    switch (2) {
        case 1 { x = 10; }
        case 2 { x = 20; }
        else { x = 30; }
    }
    printline(x);

    // Assigned before the switch, one case reassigns: still assigned.
    int y = 1;
    switch (9) {
        case 1 { y = 100; }
        else { y = 200; }
    }
    printline(y);

    // Compound assignment on an assigned variable reads fine.
    int mut total = 5;
    total += 3;
    total *= 2;
    printline(total);
}
