// Branch checkpoint coverage (C8 regression fixture): every MemoryGuard
// branch join that used to clone the whole live-variable set — if/else,
// nested if/else, while, for, try/catch, switch — runs over a wide live
// set. The program must compile and print the same result with the
// checkpoint implementation as with the old whole-object snapshots.

void main() {
    int a = 1;
    int b = 2;
    int c = 3;
    int d = 4;
    int e = 5;
    int f = 6;
    int g = 7;
    int h = 8;

    if (a > 0) {
        b = 20;
    } else {
        b = 30;
    }

    int i = 0;
    while (i < 10) {
        i += 1;
    }

    int total = 0;
    for (int j = 0; j < 5; j++) {
        total += j;
    }

    try {
        c = c + 1;
    } catch (int err) {
        c = c + 2;
    }

    switch (c) {
        case 4 { d = 40; }
        else { d = 50; }
    }

    if (e > 0) {
        f = 60;
    }

    if (b > 5) {
        if (a > 0) {
            g = 70;
        } else {
            g = 80;
        }
    } else {
        g = 90;
    }

    int sum = a + b + c + d + e + f + g + h + i + total;
    printline("guard-branch-checkpoint-ok " + (string)sum);
}
