// Pipeline handoff fixture (MEMORY.md §3.2, pipeline audit).
// pipeParseUnit used to copy the parser's modExportNames/modExportInternal
// into the PipeParseOut element by element (two whole-collection copies per
// parse, each destination grown via .add so its growth intermediates are
// abandoned). The fix hands the parser's arrays straight to the out record
// (out.modExportNames = p.modExportNames, same ownership-transfer shape as
// out.errors / out.program), so no copy is ever held beside the original.
// This program depends on the handoff being byte-identical: the driver
// name-check seeds declNames from pout.modExportNames and the visibility
// pass pairs each name with its internal flag, so a dropped, reordered or
// mis-paired entry breaks resolution here. The mixed internal flags
// (false, true, true, false in declaration order) pin the parallel arrays
// to the same indices after the move.
mod export alpha;
internal mod export beta;

internal mod stats {
	internal int bonus(int v) {
		return v + 100;
	}
}

mod export gamma;

int compute(int v) {
	return v * 2;
}

void main() {
	int total = stats.bonus(5) + compute(3);
	if (total != 111) {
		exit(1);
	}
	printline("pipeline OK");
}
