import * from fs;

class MiniTok {
    public prop string src;
    public prop int count;
    construct(string s) {
        this.src = s;
        this.count = 0;
    }
    public void scan() {
        int i = 0;
        int words = 0;
        bool inWord = false;
        while (i < this.src.length) {
            char c = this.src[i];
            if (c == ' ' || c == '
' || c == '	') {
                inWord = false;
            } else {
                if (!inWord) {
                    words = words + 1;
                    inWord = true;
                }
            }
            i = i + 1;
        }
        this.count = words;
    }
}

void main() {
    string source = file.readString("simple.sr");
    printline("source: " + source.length + " bytes");
    MiniTok t = new MiniTok(source);
    t.scan();
    printline("words: " + t.count);
    printline("done");
}
