// CSV (DOCS/191): parse, row.get, writer header/row/addLine/stringify,
// save/load through output/. Exit code 0 = all checks pass.
import * from csv;

void expect(bool got, string what) {
    if (!got) {
        printline("csv check failed: " + what);
        exit(1);
    }
}

void main() {
    csv.document doc = csv.parse("name,age\nAlice,30\nBob,25\n");
    expect(doc.headers.length == 2, "parse header length");
    expect(doc.headers[0] == "name" && doc.headers[1] == "age", "parse headers");
    expect(doc.rows.length == 2, "parse row count");
    expect(doc.rows[0].get("name") == "Alice", "row get name");
    expect(doc.rows[0].get("age") == "30", "row get age");
    expect(doc.rows[1].get("name") == "Bob", "second row name");
    expect(doc.rows[0].get("missing") == null, "row missing is null");

    csv.document quoted = csv.parse("a,b\n\"x,y\",2\n");
    expect(quoted.rows[0].get("a") == "x,y", "parse quoted comma");

    csv.writer writer = new csv.writer();
    writer.header(["a", "b"]);
    writer.addLine("1,2");
    writer.addLine("\"x,y\",3");
    string textOut = writer.stringify();
    expect(textOut == "a,b\n1,2\n\"x,y\",3\n", "writer stringify");

    csv.document savedDoc = new csv.document();
    savedDoc.headers = ["a", "b"];
    csv.row r1 = new csv.row(["a", "b"], ["1", "2"]);
    csv.row r2 = new csv.row(["a", "b"], ["x,y", "3"]);
    savedDoc.rows.push(r1);
    savedDoc.rows.push(r2);
    string savePath = "output/csv_document_tmp.csv";
    csv.save(savePath, savedDoc);
    csv.document loaded = csv.load(savePath);
    expect(loaded.headers.length == 2, "load header length");
    expect(loaded.rows.length == 2, "load row count");
    expect(loaded.rows[0].get("a") == "1", "load first cell");
    expect(loaded.rows[1].get("a") == "x,y", "load quoted cell");
    file.delete(savePath);

    printline("csv-document-ok");
}
