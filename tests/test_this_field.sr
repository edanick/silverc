mod export compiler;
import * from fs;

class Holder {
    public prop int[] items;
    public prop int val;
    
    construct() {
        this.items = [1, 2, 3];
        this.val = 42;
    }
    
    public void show() {
        printline(this.val);
        int cnt = this.items.length;
        printline(cnt);
        for (int i = 0; i < cnt; i++) {
            printline(this.items[i]);
        }
    }
}

void main() {
    Holder h = new Holder();
    h.show();
    printline("done");
}
