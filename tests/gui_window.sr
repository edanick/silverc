// GUI windows (DOCS/187, DOCS/244): compile-only, no main, so no window
// is created or shown in a runner. Typechecks the Window getters,
// setters, show/hide/close surface.
import * from gui;

void checkWindowSurface() {
    gui.Window window = new gui.Window("main", "Silver", 800, 600);
    string name = window.getName();
    string title = window.getTitle();
    int width = window.getWidth();
    int height = window.getHeight();
    int handle = window.getHandle();
    bool visible = window.isVisible();
    window.setTitle("New title");
    window.setIcon("output/icon.ico");
    string icon = window.getIcon();
    window.show();
    window.hide();
    window.close();
    if (name == title) { printline((string)width); }
    if (height == handle) { printline(icon); }
    if (visible) { printline("never"); }
}
