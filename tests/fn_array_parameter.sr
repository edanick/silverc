// DOCS/259 G3 -- a parameter may hold an ARRAY of function addresses:
// `void ()[] fns`. The parameter's slot holds an array pointer (not one
// address), so it is an ordinary array parameter and the array machinery
// binds it by reference; the elements are callable in their own right,
// so `fns[i]()` calls through the element's address.
//
// The shape the threads module needs: an array of worker callbacks handed
// to one function that runs them all.

int twice() { return 2; }
int thrice() { return 3; }

// The callback array arrives by reference: the callee sees the caller's
// array, element for element.
int applyAll(void ()[] fns) {
    int acc = 0;
    for (int i = 0; i < fns.length; i++) {
        acc += fns[i]();
    }
    return acc;
}

void main() {
    void ()[] jobs = [];
    jobs.add(twice);
    jobs.add(thrice);
    if (jobs.length != 2) {
        printline("FAIL fn array parameter: the array holds " + jobs.length + " elements, expected 2");
        exit(1);
    }
    int total = applyAll(jobs);
    if (total != 5) {
        printline("FAIL fn array parameter: the callbacks summed to " + total + ", expected 5");
        exit(2);
    }
    printline("fn array parameter ok");
}
