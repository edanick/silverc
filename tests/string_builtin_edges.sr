// The string builtins whose edges used to hang or crash: isBlank on a
// whitespace-only string (DOCS/142), replace with an empty needle
// (DOCS/74), trim with a CHAR argument (DOCS/214) and slugify
// (DOCS/229). Exit code 0 = exact.

void check(bool ok, string label) {
    if (!ok) {
        printline("FAIL " + label);
        exit(1);
    }
}

void main() {
    // isBlank: a whitespace-only string is blank (DOCS/142).
    check("  ".isBlank(), "isBlank-space");
    check("\t\n".isBlank(), "isBlank-tabs");
    check("".isBlank(), "isBlank-empty");
    check(!("a".isBlank()), "isBlank-text");

    // replace with an empty needle replaces nothing (DOCS/74): an empty
    // needle matches everywhere, so it must not rewrite the text.
    check("abc".replace("", "X") == "abc", "replace-empty");
    check("abc".replaceAll("", "X") == "abc", "replaceAll-empty");
    check("abc".replace("b", "B") == "aBc", "replace-needle");

    // trim with a CHAR argument trims that one character (DOCS/214: the
    // argument is the SET of characters to strip).
    check("xxhixx".trim('x') == "hi", "trim-char");
    check("...hello...".trim(".") == "hello", "trim-string");
    check("  hi  ".trim() == "hi", "trim-whitespace");

    // slugify: letters lowercased, digits kept, spaces/hyphens/underscores
    // folded into one hyphen, other characters ignored, a trailing hyphen
    // dropped (DOCS/229).
    check("Date A Live".slugify() == "date-a-live", "slugify");
    check("Hello, World!".slugify() == "hello-world", "slugify-punct");
    check("  lead".slugify() == "lead", "slugify-lead");
    check("trail  ".slugify() == "trail", "slugify-trail");
    check("a__b".slugify() == "a-b", "slugify-double");

    printline("string builtin edges ok");
}
