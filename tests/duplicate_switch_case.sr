// Duplicate case values (warning grade): two arms with the same literal or
// the same dotted enum-variant spelling — the second can never run, the
// first equal value wins. The compile proceeds and the program prints the
// surviving arm. Exit code 0 = exact.
enum Color { Red, Green }

void check(bool ok, string label) {
    if (!ok) {
        printline("FAIL " + label);
        exit(1);
    }
}

void main() {
    int x = 2;
    switch (x) {
        case 2 { check(true, "first-arm"); }
        case 2 { check(false, "second-arm"); }
        else { check(false, "else-arm"); }
    }

    Color c = Color.Green;
    switch (c) {
        case Color.Red { check(false, "red-arm"); }
        case Color.Red { check(false, "red-duplicate"); }
        case Color.Green { check(true, "green-arm"); }
        else { check(false, "color-else"); }
    }

    printline("duplicate case value ok");
}
