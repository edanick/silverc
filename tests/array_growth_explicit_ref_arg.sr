// An array-typed parameter binds by reference: the caller passes the
// ADDRESS of the argument variable's slot, and the callee derefs it
// exactly once. An explicit `&x` argument already IS such an address,
// so it must be forwarded unchanged — wrapping it in the address of a
// value temp would make the callee deref an address as if it were a
// data pointer (garbage).
void fill(string[] s, int n) {
    for (int i = 0; i < n; i++) {
        s.add("v" + i.toString());
    }
}

void main() {
    string[] a = [];
    fill(&a, 3);
    if (a.length != 3) {
        printline("explicit reference lost growth: " + a.length.toString());
        exit(1);
    }
    if (a[0] != "v0" || a[2] != "v2") {
        printline("explicit reference elements wrong: " + a[0] + " " + a[2]);
        exit(1);
    }
    printline("ok");
}
