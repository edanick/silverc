// Copy-on-assign for dicts (SPEC 9.2 / D11): assigning a dict produces
// an independent copy. Writing one binding leaves the other.
void main() {
    dict<string, int> a = {"k": 1};
    dict<string, int> b = a;
    b["k"] = 99;
    if (a["k"] != 1 || b["k"] != 99) {
        printline("dict decl copy shared");
        throw "copy check failed";
    }

    dict<string, int> c = {"x": 7};
    dict<string, int> d = {};
    d = c;
    d["x"] = 42;
    if (c["x"] != 7 || d["x"] != 42) {
        printline("dict assign copy shared");
        throw "copy check failed";
    }

    // Storing an array value into a dict copies the stored value.
    int[] arr = [1, 2, 3];
    dict<string, int[]> store = {};
    store["a"] = arr;
    store["a"][0] = 99;
    if (arr[0] != 1) {
        printline("dict store shared");
        throw "copy check failed";
    }

    printline("assigned dict is a copy ok");
}
