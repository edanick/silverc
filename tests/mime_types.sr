// MIME (DOCS/193): fromExtension, fromFile, fromBytes, toExtension,
// matches, and the public constants. Exit code 0 = all checks pass.
import * from mime;

void expect(bool got, string what) {
    if (!got) {
        printline("mime check failed: " + what);
        exit(1);
    }
}

void main() {
    expect(mime.JSON == "application/json", "mime JSON const");
    expect(mime.XML == "application/xml", "mime XML const");
    expect(mime.BIN == "application/octet-stream", "mime BIN const");
    expect(mime.FORM == "application/x-www-form-urlencoded", "mime FORM const");
    expect(mime.MULTI == "multipart/form-data", "mime MULTI const");

    expect(mime.fromExtension("html") == "text/html", "fromExtension html");
    expect(mime.fromExtension("HTML") == "text/html", "fromExtension upper");
    expect(mime.fromExtension("json") == "application/json", "fromExtension json");
    expect(mime.fromExtension("txt") == "text/plain", "fromExtension txt");
    expect(mime.fromExtension("png") == "image/png", "fromExtension png");
    expect(mime.fromExtension("jpg") == "image/jpeg", "fromExtension jpg");
    expect(mime.fromExtension("jpeg") == "image/jpeg", "fromExtension jpeg");
    expect(mime.fromExtension("pdf") == "application/pdf", "fromExtension pdf");
    expect(mime.fromExtension("zip") == "application/zip", "fromExtension zip");
    expect(mime.fromExtension("csv") == "text/csv", "fromExtension csv");
    expect(mime.fromExtension("unknownxyz") == "application/octet-stream", "fromExtension unknown");

    expect(mime.fromFile("index.html") == "text/html", "fromFile html");
    expect(mime.fromFile("a/b/data.json") == "application/json", "fromFile path");
    expect(mime.fromFile("noextension") == "application/octet-stream", "fromFile no extension");

    byte[] pngMagic = [0x89, 0x50, 0x4E, 0x47];
    expect(mime.fromBytes(pngMagic) == "image/png", "fromBytes png");
    byte[] jpegMagic = [0xFF, 0xD8, 0x00, 0x11];
    expect(mime.fromBytes(jpegMagic) == "image/jpeg", "fromBytes jpeg");
    byte[] gifMagic = [0x47, 0x49, 0x46, 0x38];
    expect(mime.fromBytes(gifMagic) == "image/gif", "fromBytes gif");
    byte[] pdfMagic = [0x25, 0x50, 0x44, 0x46];
    expect(mime.fromBytes(pdfMagic) == "application/pdf", "fromBytes pdf");
    byte[] shortBytes = [1, 2];
    expect(mime.fromBytes(shortBytes) == "application/octet-stream", "fromBytes short");

    expect(mime.toExtension("text/html") == ".html", "toExtension html");
    expect(mime.toExtension("application/json") == ".json", "toExtension json");
    expect(mime.toExtension("image/png") == ".png", "toExtension png");
    expect(mime.toExtension("application/unknown-thing") == ".bin", "toExtension unknown");

    expect(mime.matches("text/html", "text/*"), "matches wildcard");
    expect(mime.matches("text/html", "text/html"), "matches exact");
    expect(!mime.matches("text/html", "image/*"), "matches rejects");

    printline("mime-types-ok");
}
