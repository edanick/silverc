mod export compiler;
import * from fs;

class Box {
    public prop int val;
    
    construct() {
        printline("in ctor");
        this.val = 99;
        printline(this.val);
    }
    
    public void setVal(int v) {
        this.val = v;
    }
    
    public void show() {
        printline(this.val);
    }
}

void main() {
    printline("start");
    Box b = new Box();
    printline("after new");
    b.show();
    b.setVal(42);
    b.show();
    printline("done");
}
