// Datetime duration (DOCS/173): duration days/hours/minutes/seconds/
// millis, DateTime now/utcNow sanity, parse, diff, and time clock
// (now monotonic, sleep, stopwatch). Wall-clock values are bounded, never
// exact. Exit code 0 = all checks pass.
import * from datetime;
import * from time;

void expect(bool got, string what) {
    if (!got) {
        printline("datetime check failed: " + what);
        exit(1);
    }
}

void main() {
    datetime.duration day = new datetime.duration(86400000);
    expect(day.days() == 1, "duration days");
    expect(day.hours() == 24, "duration hours");
    expect(day.minutes() == 1440, "duration minutes");
    expect(day.seconds() == 86400, "duration seconds");
    expect(day.millis() == 86400000, "duration millis");

    datetime.duration mixed = new datetime.duration(3661000);
    expect(mixed.hours() == 1, "mixed hours");
    expect(mixed.minutes() == 61, "mixed minutes");
    expect(mixed.seconds() == 3661, "mixed seconds");

    datetime.DateTime fixed = new datetime.DateTime(2024, 1, 5, 9, 7, 3);
    expect(fixed.year == 2024 && fixed.month == 1 && fixed.day == 5, "fixed date fields");
    expect(fixed.hour == 9 && fixed.minute == 7 && fixed.second == 3, "fixed time fields");
    expect(fixed.unix() == 1704445623, "fixed unix");
    expect(fixed.toUnixTimestamp() == 1704445623, "fixed toUnix");
    expect(fixed.format("%Y-%m-%d %H:%M:%S") == "2024-01-05 09:07:03", "fixed format");

    datetime.DateTime later = new datetime.DateTime(2024, 1, 6, 9, 7, 3);
    expect(later.diff(fixed).millis() == 86400000, "diff one day");

    datetime.DateTime parsed = datetime.parse("2024-01-05 09:07:03", "%Y-%m-%d %H:%M:%S");
    expect(parsed != null, "parse returns instance");
    // NOTE: std/datetime.sr parse() is a stub returning now(); it ignores
    // its input. Field values are intentionally not asserted here.

    datetime.DateTime moment = datetime.now();
    expect(moment.year >= 2020 && moment.year <= 2100, "now year sane");
    expect(moment.month >= 1 && moment.month <= 12, "now month sane");
    datetime.DateTime utc = datetime.utcNow();
    expect(utc.year >= 2020 && utc.year <= 2100, "utcNow year sane");

    float64 first = time.now();
    time.sleep(1);
    float64 second = time.now();
    expect(second >= first, "time now monotonic");

    printline("datetime-duration-ok");
}
