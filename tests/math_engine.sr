// Math engine (DOCS/53-62, DOCS/242): abs, sqrt, floor, ceil, round, ln,
// log, log10, exp, pow, sin, cos, tan, hypot, max, min, sum, eval, PI, E,
// random bounds. Float asserts use exact values or tight tolerances.
// Exit code 0 = all checks pass.
import * from math;

void expect(bool got, string what) {
    if (!got) {
        printline("math check failed: " + what);
        exit(1);
    }
}

void expectNear(float64 got, float64 want, string what) {
    float64 diff = math.abs(got - want);
    if (!(diff < 0.001)) {
        printline("math check failed: " + what);
        exit(1);
    }
}

void main() {
    expect(math.PI > 3.14 && math.PI < 3.15, "PI value");
    expect(math.pi == math.PI, "pi matches PI");
    expect(math.E > 2.71 && math.E < 2.72, "E value");

    expect(math.abs(-5) == 5, "abs int negative");
    expect(math.abs(5) == 5, "abs int positive");
    expect(math.abs(-2.5) == 2.5, "abs float negative");
    expect(math.sqrt(16.0) == 4.0, "sqrt sixteen");
    expect(math.sqrt(0.0) == 0.0, "sqrt zero");
    expect(math.floor(3.7) == 3.0, "floor positive");
    expect(math.floor(-3.2) == -4.0, "floor negative");
    expect(math.ceil(3.2) == 4.0, "ceil positive");
    expect(math.ceil(-3.7) == -3.0, "ceil negative");
    expect(math.round(2.4) == 2.0, "round down");
    expect(math.round(2.6) == 3.0, "round up");
    expect(math.max(3, 7) == 7, "max int");
    expect(math.min(3, 7) == 3, "min int");
    expect(math.max(3.5, 2.5) == 3.5, "max float");
    expect(math.min(3.5, 2.5) == 2.5, "min float");

    expectNear(math.exp(0.0), 1.0, "exp zero");
    expectNear(math.pow(2.0, 10.0), 1024.0, "pow two ten");
    expectNear(math.pow(3.0, 2.0), 9.0, "pow three two");
    expectNear(math.ln(1.0), 0.0, "ln one");
    expectNear(math.log10(1000.0), 3.0, "log10 thousand");
    expectNear(math.log(1000.0), math.ln(1000.0), "log matches ln");
    expectNear(math.sin(0.0), 0.0, "sin zero");
    expectNear(math.cos(0.0), 1.0, "cos zero");
    expectNear(math.tan(0.0), 0.0, "tan zero");
    expectNear(math.hypot(3.0, 4.0), 5.0, "hypot three four");

    int[] ints = [1, 2, 3, 4];
    expect(math.sum(ints) == 10, "sum int");
    float64[] floats = [1.5, 2.5, 1.0];
    expectNear(math.sum(floats), 5.0, "sum float");

    expect(math.eval("1 + 1") == 2, "eval add");
    expect(math.eval("3 * 4") == 12, "eval multiply");
    expect(math.eval("10 - 4") == 6, "eval subtract");

    float64 sample = math.random();
    expect(sample >= 0.0 && sample < 1.0, "random in unit interval");

    printline("math-engine-ok");
}
