import * from fs;

class Point {
    public prop int x;
    public prop int y;
    construct(int px, int py) {
        this.x = px;
        this.y = py;
    }
    public int sum() {
        return this.x + this.y;
    }
}

const int SEVEN = 7;

void main() {
    printline("start");
    Point p = new Point(3, 4);
    printline("sum: " + p.sum());

    int[] nums = [];
    for (int i = 0; i < 5; i = i + 1) {
        nums.add(i * i);
    }
    printline("len: " + nums.length);
    printline("last: " + nums[4]);

    dict<string,string> d = {};
    d["k"] = "v";
    if (d.contains("k")) {
        printline("dict: " + d["k"]);
    } else {
        printline("dict missing");
    }

    printline("const: " + SEVEN);

    string s = "minimal";
    printline("str: " + s);
    printline("strlen: " + s.length);

    file.writeBytes("test_minimal_out.txt", [65, 66, 67]);
    string back = file.readString("test_minimal_out.txt");
    printline("file: " + back);

    printline("done");
}
