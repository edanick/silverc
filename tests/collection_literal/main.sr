string[] items collects items.col;

void main() {
    if (items.length != 12) {
        printline("FAIL count " + (string)items.length);
        exit(1);
    }
    if (items[0] != "row-0000 alpha") {
        printline("FAIL first");
        exit(1);
    }
    if (items[3] != "special \"quoted\" back\\slash") {
        printline("FAIL escape");
        exit(1);
    }
    if (items[11] != "row-0011 lambda") {
        printline("FAIL last");
        exit(1);
    }
    printline("collection-literal-ok");
}
