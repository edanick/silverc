mod export guard;

import node;

// Bootstrap-stage MemoryGuard. The native backend performs its own safety
// analysis while compiling (see MEMORY_GUARD docs); this pass-through keeps
// self-hosted driver builds linked and running. `checked` records that the
// stage ran so callers can observe it.
class MemoryGuard {
    public prop int checked;

    construct () {
        this.checked = 0;
    }

    public void checkProgram(Node[] program) {
        this.checked = 1;
    }
}
