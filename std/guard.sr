mod export guard;

const int GND_INT_LIT = 0;
const int GND_FLOAT_LIT = 1;
const int GND_STRING_LIT = 2;
const int GND_CHAR_LIT = 3;
const int GND_BOOL_LIT = 4;
const int GND_NULL_LIT = 5;
const int GND_IDENT = 6;
const int GND_BINARY = 7;
const int GND_UNARY = 8;
const int GND_CALL = 10;
const int GND_MEMBER = 13;
const int GND_BLOCK = 16;
const int GND_DICT_PAIR = 18;
const int GND_ARRAY_LIT = 19;
const int GND_MATCH_EXPR = 20;
const int GND_MATCH_ARM = 21;
const int GND_PAREN = 23;
const int GND_INDEX = 24;
const int GND_VAR_DECL = 50;
const int GND_RETURN = 51;
const int GND_RETURN_SHORT = 52;
const int GND_IF_STMT = 53;
const int GND_WHILE = 54;
const int GND_FOR_C = 55;
const int GND_TRY_CATCH = 59;
const int GND_UNSET = 60;
const int GND_EXPR_STMT = 61;
const int GND_BREAK = 62;
const int GND_CONTINUE = 63;
const int GND_FOREACH = 64;
const int GND_TERNARY = 65;
const int GND_DICT_LIT = 66;
const int GND_SLICE = 67;
const int GND_THROW = 68;
const int GND_INTERP = 69;
const int GND_TUPLE_LIT = 70;
const int GND_DESTRUCTURE = 71;
const int GND_ADDRESS_OF = 72;
const int GND_ALIAS_DECL = 73;
const int GND_FUNC = 100;
const int GND_STRUCT_DEF = 101;
const int GND_CLASS_DEF = 102;
const int GND_CONST = 104;
const int GND_ENUM_DEF = 105;
const int GND_DEF = 110;
const int GND_TYPE_ALIAS = 111;
const int GND_LAMBDA = 80;

const int GOP_ADD = 1;
const int GOP_SUB = 2;
const int GOP_MUL = 3;
const int GOP_DIV = 4;
const int GOP_EQ = 5;
const int GOP_NEQ = 6;
const int GOP_AND = 11;
const int GOP_OR = 12;
const int GOP_MOD = 13;
const int GOP_ADD_ASSIGN = 14;
const int GOP_SUB_ASSIGN = 15;
const int GOP_MUL_ASSIGN = 16;
const int GOP_DIV_ASSIGN = 17;
const int GOP_SHL = 18;
const int GOP_SHR = 19;
const int GOP_ASSIGN = 20;
const int GOP_BIT_AND = 22;
const int GOP_BIT_OR = 23;
const int GOP_BIT_XOR = 24;
const int GOP_COALESCE = 25;
const int GOP_MOVE = 28;
const int GOP_MOD_ASSIGN = 29;
const int GOP_BIT_AND_ASSIGN = 30;
const int GOP_BIT_OR_ASSIGN = 31;
const int GOP_BIT_XOR_ASSIGN = 32;
const int GOP_SHL_ASSIGN = 33;
const int GOP_SHR_ASSIGN = 34;
const int GOP_COALESCE_ASSIGN = 38;
const int GND_SWITCH = 76;
const int GOP_POST_INC = 35;
const int GOP_POST_DEC = 36;
const int GND_NEW_INIT = 88;

// Null-state tri-state (null-state-flow concept): the null-state of
// evaluating an expression — non-null, maybe-null, or no proof either way.
const int GNN_MAYBE_NULL = 0;
const int GNN_NON_NULL = 1;
const int GNN_UNKNOWN = -1;

class GuardVar {
    public prop string name;
    public prop string typeHint;
    public prop bool isInit;
    public prop bool isAlive;
    public prop bool isOnce;
    public prop bool isNullable;
    public prop bool isFixed;
    public prop bool isAlias;
    public prop bool holdsAddress;
    public prop string aliasOf;
    public prop string addrTarget;
    public prop int line;
    public prop int col;

    construct {
        this.name = "";
        this.typeHint = "";
        this.isInit = false;
        this.isAlive = false;
        this.isOnce = false;
        this.isNullable = false;
        this.isFixed = false;
        this.isAlias = false;
        this.holdsAddress = false;
        this.aliasOf = "";
        this.addrTarget = "";
        this.line = 0;
        this.col = 0;
    }
}

// One flattened class-field entry (member-store resolution): the field's
// name, declared type, and read-only prop flag, in the own-fields-first
// order the flattened layout resolves with.
class GuardField {
    public prop string name;
    public prop string typeHint;
    public prop bool isReadOnly;
    public prop int line;
    public prop int col;

    construct {
        this.name = "";
        this.typeHint = "";
        this.isReadOnly = false;
        this.line = 0;
        this.col = 0;
    }
}

class MemoryGuard {
    private prop GuardVar[] vars;
    private prop int[] scopeEnds;
    private prop string[] globalNames;
    private prop string[] nonNullNames;
    private prop int unwrapDepth;
    private prop string[] typeNames;
    private prop string currentReturnType;
    // Enum variant tables (exhaustiveness coverage concept): parallel
    // arrays — enumNames/enumStarts/enumCounts index into the flat
    // enumVariantNames collected from the parsed GND_ENUM_DEF declarations.
    private prop string[] enumNames;
    private prop int[] enumStarts;
    private prop int[] enumCounts;
    private prop string[] enumVariantNames;
    // Free-function signature tables (argument-type analysis):
    // funcSigNames/funcSigStarts/funcSigCounts index into the flat
    // funcSigParamTypes/funcSigParamNames, collected from top-level
    // GND_FUNC declarations before any body is checked. Member calls never
    // resolve against it (their receiver types are not tracked here) and
    // stay silent.
    private prop string[] funcSigNames;
    private prop int[] funcSigStarts;
    private prop int[] funcSigCounts;
    private prop string[] funcSigParamTypes;
    private prop string[] funcSigParamNames;
    // Assigned-but-never-used tracking (definite-assignment
    // _usedVariables/_writtenVariables concept, warning grade): candidates
    // hold locals declared in the function being checked (parallel
    // name/line/col arrays), usedNames the names read anywhere in it,
    // suppressedNames the excluded ones (redeclared, fixed, fn-typed,
    // shadowing a global). False at module level: module-level
    // declarations are globals and never become candidates.
    private prop string[] candNames;
    private prop int[] candLines;
    private prop int[] candCols;
    private prop string[] usedNames;
    private prop string[] suppressedNames;
    private prop bool unusedTracking;
    // Class table (class-body flow checking + member-store resolution):
    // classNames/classNodes hold every class and struct declaration of the
    // merged program, for flattened field lookups (own fields first, then
    // every ancestor's, first-listed wins) and receiver-type resolution.
    private prop string[] classNames;
    private prop Node[] classNodes;
    // Enclosing class while its methods are deep-checked: "" outside any
    // class. Drives the this-less member idiom (fields resolve bare) and
    // `this`-receiver member-store resolution.
    private prop string currentClass;
    // Loop-nesting depth (loop-scope tracking): `break`/`continue` are
    // legal only above zero. Match, switch and try bodies do not open loop
    // scope; lambda bodies reset it (a generated function cannot target an
    // enclosing loop).
    private prop int loopDepth;
    // Free-function bodies (call-argument null-tolerance): parallel to
    // funcSigNames — the callee's declaration node, inspected for null-safe
    // parameter reads (`??`, `?.`, `== null` guards).
    private prop Node[] funcSigNodes;
    public prop string[] warnings;

    construct {
        this.vars = [];
        this.scopeEnds = [];
        this.globalNames = [];
        this.nonNullNames = [];
        this.unwrapDepth = 0;
        this.typeNames = [];
        this.currentReturnType = "";
        this.enumNames = [];
        this.enumStarts = [];
        this.enumCounts = [];
        this.enumVariantNames = [];
        this.funcSigNames = [];
        this.funcSigStarts = [];
        this.funcSigCounts = [];
        this.funcSigParamTypes = [];
        this.funcSigParamNames = [];
        this.candNames = [];
        this.candLines = [];
        this.candCols = [];
        this.usedNames = [];
        this.suppressedNames = [];
        this.unusedTracking = false;
        this.classNames = [];
        this.classNodes = [];
        this.currentClass = "";
        this.loopDepth = 0;
        this.funcSigNodes = [];
        this.warnings = [];
    }

    private void fail(string exc, int line, int col, string varName, string msg) {
        printline("GuardError: " + exc + " at line " + (string)line + ", column " + (string)col + ": " + varName + ": " + msg);
        exit(1);
    }

    private int findVar(string name) {
        for (int i = this.vars.length - 1; i >= 0; i--) {
            if (this.vars[i].name == name) { return i; }
        }
        return -1;
    }

    private void pushScope() {
        this.scopeEnds.add(this.vars.length);
    }

    private void popScope() {
        if (this.scopeEnds.length == 0) { return; }
        int start = this.scopeEnds[this.scopeEnds.length - 1];
        this.scopeEnds.pop();
        for (int d = start; d < this.vars.length; d++) {
            GuardVar dying = this.vars[d];
            for (int j = 0; j < start; j++) {
                GuardVar outer = this.vars[j];
                if (outer.isAlive && outer.aliasOf.length > 0 && outer.aliasOf == dying.name) {
                    this.fail("UnsetAliasCallException", outer.line, outer.col, outer.name, "alias outlives its target " + dying.name);
                }
                if (outer.isAlive && outer.addrTarget.length > 0 && outer.addrTarget == dying.name) {
                    this.fail("UnsetAliasCallException", outer.line, outer.col, outer.name, "address held by '" + outer.name + "' outlives target '" + dying.name + "'");
                }
            }
        }
        // Truncate in place: rebuilding `kept`/`newSE` arrays per scope exit
        // copied the whole live set on every block end (2-3 array copies per
        // branch node via snapshot above this).
        while (this.vars.length > start) { this.vars.pop(); }
    }

    private GuardVar cloneVar(GuardVar v) {
        GuardVar c = new GuardVar();
        c.name = v.name;
        c.typeHint = v.typeHint;
        c.isInit = v.isInit;
        c.isAlive = v.isAlive;
        c.isOnce = v.isOnce;
        c.isNullable = v.isNullable;
        c.isFixed = v.isFixed;
        c.isAlias = v.isAlias;
        c.holdsAddress = v.holdsAddress;
        c.aliasOf = v.aliasOf;
        c.addrTarget = v.addrTarget;
        c.line = v.line;
        c.col = v.col;
        return c;
    }

    private GuardVar[] snapshot() {
        GuardVar[] out = [];
        for (int i = 0; i < this.vars.length; i++) { out.add(this.cloneVar(this.vars[i])); }
        return out;
    }

    // Same-scope redeclaration: a name already bound in the innermost
    // scope cannot bind again there — the two declarations would share one
    // storage slot and the second is a mistake. Shadowing across scopes
    // stays legal (a nested block, branch arm, or method scope may reuse a
    // name); only the current scope level is judged.
    private void rejectSameScopeRedecl(string name, int line, int col) {
        int start = 0;
        if (this.scopeEnds.length > 0) { start = this.scopeEnds[this.scopeEnds.length - 1]; }
        for (int i = start; i < this.vars.length; i++) {
            if (this.vars[i].name == name) {
                this.fail("DuplicateDefinition", line, col, name, "duplicate variable '" + name + "'");
            }
        }
    }

    private void declareVar(string name, string typeHint, bool init, bool alive, bool onceFlag, bool fixedFlag, bool nullable, bool aliasFlag, int line, int col) {
        this.rejectSameScopeRedecl(name, line, col);
        GuardVar v = new GuardVar();
        v.name = name;
        v.typeHint = typeHint;
        v.isInit = init;
        v.isAlive = alive;
        v.isOnce = onceFlag;
        v.isFixed = fixedFlag;
        v.isNullable = nullable;
        v.isAlias = aliasFlag;
        v.line = line;
        v.col = col;
        // A fresh binding has no null-state proof yet; a stale fact for a
        // shadowing outer name must not survive the declaration
        // (null-state-flow re-initializes the slot on declaration).
        this.dropNonNull(name);
        this.vars.add(v);
    }

    private bool targetAlive(string target) {
        int idx = this.findVar(target);
        if (idx < 0) { return false; }
        return this.vars[idx].isAlive;
    }

    private bool isNullableVar(string name) {
        int idx = this.findVar(name);
        if (idx < 0) { return false; }
        return this.vars[idx].isNullable;
    }

    private void killAliasesOf(string name) {
        for (int i = 0; i < this.vars.length; i++) {
            GuardVar a = this.vars[i];
            if (a.aliasOf.length > 0 && a.aliasOf == name) {
                a.isAlive = false;
                a.isInit = false;
            }
        }
    }

    private bool isNonNullHere(string name) {
        for (int i = 0; i < this.nonNullNames.length; i++) {
            if (this.nonNullNames[i] == name) { return true; }
        }
        return false;
    }

    private bool isGlobalName(string name) {
        for (int i = 0; i < this.globalNames.length; i++) {
            if (this.globalNames[i] == name) { return true; }
        }
        return false;
    }

    // Substring by character loop: string.slice miscompiles computed
    // member args on the bootstrap (STANDARDS §14 exception), so the guard
    // never calls it.
    private string gsSlice(string s, int start, int end) {
        if (start < 0) { start = 0; }
        if (end > s.length) { end = s.length; }
        if (end <= start) { return ""; }
        string r = "";
        for (int i = start; i < end; i++) { r += s[i]; }
        return r;
    }

    private bool isKnownTypeName(string t) {
        for (int i = 0; i < this.typeNames.length; i++) {
            if (this.typeNames[i] == t) { return true; }
        }
        return false;
    }

    private bool isPrimitiveSpelling(string t) {
        return t == "int" || t == "int32" || t == "int64" || t == "uint" || t == "uint64"
            || t == "float" || t == "float64" || t == "double" || t == "bool" || t == "byte"
            || t == "char" || t == "string" || t == "void";
    }

    private int classIndexOf(string name) {
        for (int i = 0; i < this.classNames.length; i++) {
            if (this.classNames[i] == name) { return i; }
        }
        return -1;
    }

    // Flattened instance-field table of a class (member-store resolution):
    // its own fields first, then every ancestor's in listed order — the
    // first declaration of a spelling wins, mirroring the first-listed
    // layout rule. Cycle-guarded so the walk never hangs.
    private GuardField[] classFieldList(string className) {
        GuardField[] out = [];
        string[] visited = [];
        string[] stack = [];
        stack.add(className);
        while (stack.length > 0) {
            string name = stack[stack.length - 1];
            stack.pop();
            if (visited.contains(name)) { continue; }
            visited.add(name);
            int ci = this.classIndexOf(name);
            if (ci < 0) { continue; }
            Node cd = this.classNodes[ci];
            for (int f = 0; f < cd.childCount(); f++) {
                Node m = cd.child(f);
                if (m.kind != GND_VAR_DECL) { continue; }
                bool have = false;
                for (int h = 0; h < out.length; h++) {
                    if (out[h].name == m.name) { have = true; break; }
                }
                if (have) { continue; }
                GuardField gf = new GuardField();
                gf.name = m.name;
                gf.typeHint = m.typeHint;
                gf.isReadOnly = m.isReadOnly;
                gf.line = m.line;
                gf.col = m.col;
                out.add(gf);
            }
            for (int p = 0; p < cd.parentClasses.length; p++) {
                stack.add(cd.parentClasses[p]);
            }
        }
        return out;
    }

    // Read-only flag of one field inside a class's flattened layout (own
    // fields before inherited, first declaration wins). Unknown fields and
    // classes report false — legacy sources assign through never-declared
    // fields, and those member stores stay permissive.
    private bool classFieldReadOnly(string className, string field) {
        if (this.classIndexOf(className) < 0) { return false; }
        GuardField[] flat = this.classFieldList(className);
        for (int i = 0; i < flat.length; i++) {
            if (flat[i].name == field) { return flat[i].isReadOnly; }
        }
        return false;
    }

    // Receiver class of a member store when the receiver is decidable
    // (member-store resolution): `this` inside a deep-checked class, or a
    // local/parameter/field whose declared type names a known class or
    // struct. Everything else resolves dynamically and is never judged.
    private string memberStoreClass(Node obj) {
        if (obj.kind != GND_IDENT) { return ""; }
        if (obj.name == "this" && this.currentClass.length > 0) { return this.currentClass; }
        int idx = this.findVar(obj.name);
        if (idx < 0) { return ""; }
        string t = this.vars[idx].typeHint;
        if (t.length == 0) { return ""; }
        if (this.classIndexOf(t) >= 0) { return t; }
        return "";
    }

    // Member-store check (read-only prop rule): a read-only prop is set
    // exactly once, by its declaration initializer — never by a later
    // store, not from outside and not from the declaring class's own
    // methods. Field existence itself stays permissive on purpose.
    private void checkMemberStore(Node obj, string field, Node at) {
        string cls = this.memberStoreClass(obj);
        if (cls.length == 0) { return; }
        if (this.classFieldReadOnly(cls, field)) {
            this.fail("ReadOnlyPropAssignment", at.line, at.col, field, "cannot assign to read-only prop '" + cls + "." + field + "'");
        }
    }

    // Last dotted segment of a possibly module-qualified spelling
    // (`net.http.Client` -> `Client`); the plain spelling itself otherwise.
    private string lastDottedSegment(string s) {
        int dot = -1;
        for (int i = 0; i < s.length; i++) {
            if (s[i] == '.') { dot = i; }
        }
        if (dot < 0) { return s; }
        return this.gsSlice(s, dot + 1, s.length);
    }

    // Missing-return ("not all code paths return a value" concept,
    // MEMORY_GUARD totality check): a declared return type is judged when it
    // is a real Silver value type — a primitive spelling or any composed
    // shape built on one — or a KNOWN user type. `void`, `var`, fn-pointer
    // types and unknown legacy names (e.g. `fun main()` parses as returning
    // `fun`) are not judged: an unregistered name is not a Silver value type.
    private bool judgedReturnType(string rt) {
        if (rt.length == 0 || rt == "void" || rt == "var" || rt == "void ()") { return false; }
        string base = rt;
        while (base.length > 0) {
            char last = base[base.length - 1];
            if (last == ']' || last == '?' || last == '*' || last == '>') {
                // Strip composed suffixes (array `[]`, nullable `?`, pointer
                // `*`, generic close `>`) down to the base spelling. `<>`
                // generic/union/kvp/tuple shapes stay judged (their bases are
                // real types).
                if (last == ']') {
                    if (base.length < 3 || base[base.length - 2] != '[') { return true; }
                    base = this.gsSlice(base, 0, base.length - 2);
                } else {
                    base = this.gsSlice(base, 0, base.length - 1);
                }
                continue;
            }
            break;
        }
        if (base.length == 0) { return true; }
        if (this.isPrimitiveSpelling(base)) { return true; }
        if (this.isKnownTypeName(base)) { return true; }
        if (rt.indexOf("<") >= 0) { return true; }
        return false;
    }

    // Nullable flow narrowing (condition-true /
    // condition-false concept): names proven NON-NULL when `cond`
    // evaluates to `truth`. Handles both operand orders (`x != null`,
    // `null != x`), parenthesized conditions, `!` negation, and the
    // short-circuit operators' definite branches: `a && b` true proves both
    // sides' true-facts; `a || b` false proves both sides' false-facts.
    // Indefinite branches prove nothing and stay empty.
    private void collectNarrowings(Node cond, bool truth, string[] out) {
        if (cond.kind == GND_PAREN) {
            this.collectNarrowings(cond.child(0), truth, out);
            return;
        }
        if (cond.kind == GND_UNARY && cond.op == 1) {
            this.collectNarrowings(cond.child(0), !truth, out);
            return;
        }
        if (cond.kind == GND_BINARY) {
            if (cond.op == GOP_AND && truth) {
                this.collectNarrowings(cond.child(0), true, out);
                this.collectNarrowings(cond.child(1), true, out);
                return;
            }
            if (cond.op == GOP_OR && !truth) {
                this.collectNarrowings(cond.child(0), false, out);
                this.collectNarrowings(cond.child(1), false, out);
                return;
            }
            if (cond.op == GOP_EQ || cond.op == GOP_NEQ) {
                Node nl = cond.child(0);
                Node nr = cond.child(1);
                string name = "";
                if (nr.kind == GND_NULL_LIT && nl.kind == GND_IDENT) { name = nl.name; }
                if (nl.kind == GND_NULL_LIT && nr.kind == GND_IDENT) { name = nr.name; }
                if (name.length > 0 && this.isNullableVar(name)) {
                    // `x != null` true  -> x non-null.
                    // `x == null` false -> x non-null.
                    bool proven = (cond.op == GOP_NEQ) == truth;
                    if (proven) {
                        bool have = false;
                        for (int i = 0; i < out.length; i++) {
                            if (out[i] == name) { have = true; break; }
                        }
                        if (!have) { out.add(name); }
                    }
                }
            }
        }
    }

    private void addNarrowings(string[] names) {
        for (int i = 0; i < names.length; i++) { this.nonNullNames.add(names[i]); }
    }

    // Any assignment may reintroduce null into a previously narrowed
    // nullable; the flow fact dies here (the assignment replaces the
    // narrowed type).
    private void dropNonNull(string name) {
        string[] kept = [];
        for (int i = 0; i < this.nonNullNames.length; i++) {
            if (this.nonNullNames[i] != name) { kept.add(this.nonNullNames[i]); }
        }
        this.nonNullNames = kept;
    }

    private void dropNarrowings(string[] names) {
        for (int i = 0; i < names.length; i++) { this.dropNonNull(names[i]); }
    }

    // Null-state snapshots (null-state-flow join-point concept): the
    // fact set is copied per branch entry and merged at the convergence —
    // a fact survives only when it holds on every path that completes the
    // construct. Terminal branches never reach the join
    // (Meet(Unreachable, X) = X).
    private string[] snapshotNonNull() {
        string[] out = [];
        for (int i = 0; i < this.nonNullNames.length; i++) { out.add(this.nonNullNames[i]); }
        return out;
    }

    private void addNonNullFact(string name) {
        if (!this.isNonNullHere(name)) { this.nonNullNames.add(name); }
    }

    // Intersection of two fact sets: the Meet at a two-path join.
    private string[] meetNonNull(string[] a, string[] b) {
        string[] out = [];
        for (int i = 0; i < a.length; i++) {
            if (b.contains(a[i])) { out.add(a[i]); }
        }
        return out;
    }

    // A copy of `base` plus `facts` added: the implicit no-else path of an
    // if carries the condition's false-facts on top of the pre-if state.
    private string[] copyWithFacts(string[] base, string[] facts) {
        string[] out = [];
        for (int i = 0; i < base.length; i++) { out.add(base[i]); }
        for (int i = 0; i < facts.length; i++) {
            if (!out.contains(facts[i])) { out.add(facts[i]); }
        }
        return out;
    }

    // Null-state of evaluating `expr` (null-state-flow concept):
    // GNN_NON_NULL — the value is definitely not null; GNN_MAYBE_NULL — it
    // may be null; GNN_UNKNOWN — no proof either way (calls with unknown
    // returns, class values, member reads). A nullable identifier narrowed
    // by the flow proves non-null; a bare nullable does not. Value types
    // (primitives, arrays, dicts) can never hold null. `l ?? r` and
    // `l ??= r` are null only when both sides are, so a non-null right
    // side makes the whole expression non-null.
    private int exprProvesNonNull(Node e) {
        int k = e.kind;
        if (k == GND_NULL_LIT) { return GNN_MAYBE_NULL; }
        if (k == GND_PAREN) { return this.exprProvesNonNull(e.child(0)); }
        if (k == GND_INT_LIT || k == GND_FLOAT_LIT || k == GND_STRING_LIT || k == GND_CHAR_LIT || k == GND_BOOL_LIT) { return GNN_NON_NULL; }
        // `new T(...)`: a kind-10 call marked isStatic — a fresh instance
        // is never null.
        if (k == GND_CALL && e.isStatic) { return GNN_NON_NULL; }
        if (k == GND_IDENT) {
            if (this.isNonNullHere(e.name)) { return GNN_NON_NULL; }
            int idx = this.findVar(e.name);
            if (idx < 0) { return GNN_UNKNOWN; }
            string t = this.vars[idx].typeHint;
            if (t.length == 0 || t == "var" || t == "void" || t == "void ()") { return GNN_UNKNOWN; }
            if (t.endsWith("?")) { return GNN_MAYBE_NULL; }
            if (t.endsWith("[]") || this.isPrimitiveSpelling(t) || this.dictKeyOf(t).length > 0) { return GNN_NON_NULL; }
            return GNN_UNKNOWN;
        }
        if (k == GND_BINARY && (e.op == GOP_COALESCE || e.op == GOP_COALESCE_ASSIGN)) {
            int l = this.exprProvesNonNull(e.child(0));
            int r = this.exprProvesNonNull(e.child(1));
            if (l == GNN_NON_NULL || r == GNN_NON_NULL) { return GNN_NON_NULL; }
            if (l == GNN_MAYBE_NULL && r == GNN_MAYBE_NULL) { return GNN_MAYBE_NULL; }
            return GNN_UNKNOWN;
        }
        return GNN_UNKNOWN;
    }

    // Minimal static type inference for assignability/narrowing checks: a
    // literal's type, a declared variable's typeHint, parens through, `??`
    // yields the right side's type. Everything else is unknown ("") and
    // skips the checks (matching the reference's None inference).
    private string inferStaticType(Node e) {
        int k = e.kind;
        if (k == GND_INT_LIT) { return "int"; }
        if (k == GND_FLOAT_LIT) { return "float"; }
        if (k == GND_STRING_LIT) { return "string"; }
        if (k == GND_CHAR_LIT) { return "char"; }
        if (k == GND_BOOL_LIT) { return "bool"; }
        if (k == GND_NULL_LIT) { return "void"; }
        if (k == GND_PAREN) { return this.inferStaticType(e.child(0)); }
        if (k == GND_IDENT) {
            int idx = this.findVar(e.name);
            if (idx >= 0) { return this.vars[idx].typeHint; }
            return "";
        }
        if (k == GND_BINARY && e.op == GOP_COALESCE) { return this.inferStaticType(e.child(1)); }
        if (k == GND_UNARY) { return this.inferStaticType(e.child(0)); }
        return "";
    }

    private bool isNumericTypeName(string t) {
        return t == "int" || t == "int32" || t == "int64" || t == "uint" || t == "uint64"
            || t == "float" || t == "float64" || t == "double" || t == "byte";
    }

    // Assignability relations (type relations concept, restricted to Silver's
    // shapes): composed types require their components to agree — nullable
    // inner types, array element types, and dict key/value types all
    // recurse. Strings never interchange with numbers or bools in either
    // direction; chars are exempt pending a documented widening rule;
    // numeric alias widths (int/int32/int64, float/float64) keep their
    // historical interchangeability. The quiet core decides; the failing
    // wrapper reports.
    private bool typesCompatibleQuiet(string expected, string actual) {
        if (expected == actual) { return true; }
        // Allow null to be assigned to any nullable type, and non-null
        // values to widen into nullable targets.
        if (expected.endsWith("?")) {
            if (actual == "void") { return true; }
            if (this.gsSlice(expected, 0, expected.length - 1) == actual) { return true; }
        }
        if ((expected == "int" && actual == "int32") || (expected == "int32" && actual == "int")) { return true; }
        if ((expected == "float" && actual == "float64") || (expected == "float64" && actual == "float")) { return true; }
        if ((expected == "int" && actual == "int64") || (expected == "int64" && actual == "int")) { return true; }
        if (expected.endsWith("?") && actual.endsWith("?")) {
            return this.typesCompatibleQuiet(this.gsSlice(expected, 0, expected.length - 1), this.gsSlice(actual, 0, actual.length - 1));
        }
        if (expected.endsWith("[]") && actual.endsWith("[]")) {
            return this.typesCompatibleQuiet(this.gsSlice(expected, 0, expected.length - 2), this.gsSlice(actual, 0, actual.length - 2));
        }
        if (this.dictKeyOf(expected).length > 0 && this.dictKeyOf(actual).length > 0) {
            if (!this.typesCompatibleQuiet(this.dictKeyOf(expected), this.dictKeyOf(actual))) { return false; }
            return this.typesCompatibleQuiet(this.dictValueOf(expected), this.dictValueOf(actual));
        }
        bool stringExpected = expected == "string";
        bool stringActual = actual == "string";
        bool numericExpected = this.isNumericTypeName(expected);
        bool numericActual = this.isNumericTypeName(actual);
        bool boolExpected = expected == "bool";
        bool boolActual = actual == "bool";
        if ((stringExpected && (numericActual || boolActual)) || (stringActual && (numericExpected || boolExpected))) {
            return false;
        }
        return true;
    }

    private void checkTypesCompatible(string expected, string actual, Node at, string varName) {
        if (!this.typesCompatibleQuiet(expected, actual)) {
            this.fail("TypeMismatch", at.line, at.col, varName, "expected '" + expected + "', found '" + actual + "'");
        }
    }

    // Fundamental value class of a type spelling (value-kind relations):
    // every numeric width and char are one numeric class, string and bool
    // their own. Composed and unknown shapes have none and are never judged
    // by class.
    private string fundamentalClass(string t) {
        if (this.isNumericTypeName(t) || t == "char") { return "numeric"; }
        if (t == "string") { return "string"; }
        if (t == "bool") { return "bool"; }
        return "";
    }

    // Assignment-value check (later assignments mirror declaration
    // initializers): a value whose fundamental class cannot fit the target
    // (`int x; ...; x = "hello"`) is an error at the store, not only at the
    // declaration. `char` into `string` keeps the declaration widening;
    // unknown shapes stay permissive.
    private void checkAssignValueType(string target, Node rhs, Node at, string varName) {
        string actual = this.inferStaticType(rhs);
        if (actual.length == 0 || actual == "var" || actual == "void") { return; }
        if (target == "string" && actual == "char") { return; }
        string tc = this.fundamentalClass(target);
        string ac = this.fundamentalClass(actual);
        if (tc.length > 0 && ac.length > 0 && tc != ac) {
            this.fail("TypeMismatch", at.line, at.col, varName, "expected '" + this.gArticle(target) + "', found '" + this.gArticle(actual) + "'");
        }
        this.checkTypesCompatible(target, actual, at, varName);
    }

    // `dict<K, V>` (or bare `<K, V>`) inner key/value text, or "" when the
    // spelling is not a dict type.
    private string dictInner(string t) {
        if (t.startsWith("dict<") && t.endsWith(">")) {
            return this.gsSlice(t, 5, t.length - 1);
        }
        if (t.startsWith("<") && t.endsWith(">") && t.indexOf(",") > 0) {
            return this.gsSlice(t, 1, t.length - 1);
        }
        return "";
    }

    private int dictComma(string inner) {
        int depth = 0;
        for (int i = 0; i < inner.length; i++) {
            char c = inner[i];
            if (c == '<') { depth++; }
            if (c == '>') { depth--; }
            if (c == ',' && depth == 0) { return i; }
        }
        return -1;
    }

    // Key component of a dict type spelling, or "" when not a dict.
    private string dictKeyOf(string t) {
        string inner = this.dictInner(t);
        if (inner.length == 0) { return ""; }
        int comma = this.dictComma(inner);
        if (comma < 0) { return ""; }
        return this.gsSlice(inner, 0, comma).trim();
    }

    // Value component of a dict type spelling, or "" when not a dict.
    private string dictValueOf(string t) {
        string inner = this.dictInner(t);
        if (inner.length == 0) { return ""; }
        int comma = this.dictComma(inner);
        if (comma < 0) { return ""; }
        return this.gsSlice(inner, comma + 1, inner.length).trim();
    }

    // Validate a `return e` / `>> e` / one-line `<< e` expression against
    // the enclosing function's declared return type: a nullable must not
    // flow into a non-nullable return slot without a null check.
    private void checkReturnValue(Node expr, Node at) {
        string rt = this.currentReturnType;
        if (rt.length == 0 || rt == "void" || rt == "var" || rt == "void ()") { return; }
        if (rt.endsWith("?")) { return; }
        Node src = expr;
        while (src.kind == GND_PAREN) { src = src.child(0); }
        if (src.kind != GND_IDENT) { return; }
        if (this.isNonNullHere(src.name)) { return; }
        int idx = this.findVar(src.name);
        if (idx < 0) { return; }
        if (this.vars[idx].isNullable) {
            this.fail("NullValueException", at.line, at.col, src.name, "nullable value " + src.name + " returned without a null check (use ??)");
        }
    }

    private void checkRead(Node n) {
        string name = n.name;
        if (name == "this") { return; }
        // Any value use marks the name read for the assigned-but-never-used
        // report (the only appearance that does not is a plain assignment
        // target).
        this.markLocalUsed(name);
        int idx = this.findVar(name);
        if (idx < 0) { return; }
        GuardVar v = this.vars[idx];
        if (!v.isAlive) {
            this.fail("NonexistenceException", n.line, n.col, name, "variable is dead (moved, unset, or already consumed)");
        }
        if (!v.isInit) {
            this.fail("UnassignedVariableCallException", n.line, n.col, name, "read before it is assigned on all paths");
        }
        if (v.aliasOf.length > 0) {
            if (!this.targetAlive(v.aliasOf)) {
                this.fail("UnsetAliasCallException", n.line, n.col, name, "alias target is dead or out of scope");
            }
        }
        if (v.isOnce) {
            v.isAlive = false;
            v.isInit = false;
        }
    }

    private void checkPeek(Node n) {
        string name = n.name;
        if (name == "this") { return; }
        // An alias declaration reads its target: counts as a use.
        this.markLocalUsed(name);
        int idx = this.findVar(name);
        if (idx < 0) { return; }
        GuardVar v = this.vars[idx];
        if (!v.isAlive) {
            this.fail("NonexistenceException", n.line, n.col, name, "variable is dead (moved, unset, or already consumed)");
        }
        if (!v.isInit) {
            this.fail("UnassignedVariableCallException", n.line, n.col, name, "read before it is assigned on all paths");
        }
    }

    private int checkAddr(Node n) {
        Node op = n.child(0);
        if (op.kind == GND_IDENT) {
            string name = op.name;
            if (name != "this") {
                // Taking an address escapes the value: counts as a use.
                this.markLocalUsed(name);
                int idx = this.findVar(name);
                if (idx >= 0) {
                    GuardVar v = this.vars[idx];
                    if (!v.isAlive) {
                        this.fail("NonexistenceException", op.line, op.col, name, "variable is dead (moved, unset, or already consumed)");
                    }
                    if (!v.isInit) {
                        this.fail("UnassignedVariableCallException", op.line, op.col, name, "read before it is assigned on all paths");
                    }
                    if (!v.isFixed) {
                        this.fail("AddressTypeMistmatchException", op.line, op.col, name, "@ requires a fixed variable");
                    }
                    if (v.isOnce) {
                        v.isAlive = false;
                        v.isInit = false;
                    }
                }
            }
        } else {
            this.fail("AddressTypeMistmatchException", op.line, op.col, "", "@ requires a fixed variable");
        }
        return 1;
    }

    private void killMoveSource(Node src) {
        if (src.kind == GND_IDENT && src.name != "this") {
            // A move reads its source before killing it: counts as a use.
            this.markLocalUsed(src.name);
            int si = this.findVar(src.name);
            if (si >= 0) {
                GuardVar sv = this.vars[si];
                if (!sv.isAlive) {
                    this.fail("NonexistenceException", src.line, src.col, src.name, "moved-from variable is dead");
                }
                if (!sv.isInit) {
                    this.fail("UnassignedVariableCallException", src.line, src.col, src.name, "cannot move an uninitialized variable");
                }
                sv.isAlive = false;
                sv.isInit = false;
                this.killAliasesOf(src.name);
            }
        } else {
            this.checkExpr(src);
        }
    }

    private void checkMove(Node n) {
        Node dest = n.child(0);
        // Null-state of the moved value (null-state-flow assignment
        // propagation), sampled before the target's fact dies in the
        // destination handling below: `x <- nonnull` proves `x` non-null.
        int srcProof = this.exprProvesNonNull(n.child(1));
        if (dest.kind == GND_IDENT && dest.name != "this") {
            int di = this.findVar(dest.name);
            if (di >= 0) {
                this.vars[di].isInit = true;
                this.vars[di].isAlive = true;
                this.dropNonNull(dest.name);
            }
        } else if (dest.kind != GND_IDENT) {
            this.checkExpr(dest);
        }
        this.killMoveSource(n.child(1));
        if (srcProof == GNN_NON_NULL && dest.kind == GND_IDENT && dest.name != "this") {
            this.addNonNullFact(dest.name);
        }
    }

    private void markAddrHolding(GuardVar v, Node init, Node lhs) {
        if (init.kind == GND_ADDRESS_OF) {
            Node op = init.child(0);
            if (op.kind == GND_IDENT) {
                int oi = this.findVar(op.name);
                if (oi >= 0) {
                    GuardVar ov = this.vars[oi];
                    if (v.typeHint.length > 0 && ov.typeHint.length > 0 && v.typeHint != ov.typeHint) {
                        this.fail("AddressTypeMistmatchException", lhs.line, lhs.col, v.name, "type punning of an address (@" + op.name + " is " + ov.typeHint + ", target is " + v.typeHint + ")");
                    }
                    v.holdsAddress = true;
                    v.addrTarget = op.name;
                }
            }
            return;
        }
        if (init.kind == GND_IDENT) {
            int oi = this.findVar(init.name);
            if (oi >= 0 && this.vars[oi].holdsAddress) {
                GuardVar ov = this.vars[oi];
                if (v.typeHint.length > 0 && ov.typeHint.length > 0 && v.typeHint != ov.typeHint) {
                    this.fail("AddressTypeMistmatchException", lhs.line, lhs.col, v.name, "type punning of an address (" + init.name + " is " + ov.typeHint + ", target is " + v.typeHint + ")");
                }
                v.holdsAddress = true;
                v.addrTarget = ov.addrTarget;
            }
        }
    }

    private int checkAssign(Node n) {
        Node lhs = n.child(0);
        Node rhs = n.child(1);
        bool isCompound = n.op != GOP_ASSIGN;
        // Null-state of the assigned value (null-state-flow assignment
        // propagation), sampled before the target's fact dies below: a
        // plain `=` carries the source value verbatim, so a non-null source
        // proves the target non-null. Compound assignments read the old
        // target first (`x += 1` is `x = x + 1`) and gain nothing.
        int rhsProof = this.exprProvesNonNull(rhs);
        if (lhs.kind == GND_IDENT && lhs.name != "this") {
            // Compound assignments read the target before writing
            // (`x += 1` is `x = x + 1`): an uninitialized target is an
            // unassigned read, not a fresh initialization. (`x++`/`x--`
            // take the non-assign path and read the operand directly.)
            if (isCompound) {
                this.markLocalUsed(lhs.name);
                int ci = this.findVar(lhs.name);
                if (ci >= 0 && !this.vars[ci].isInit) {
                    this.fail("UnassignedVariableCallException", lhs.line, lhs.col, lhs.name, "compound assignment reads '" + lhs.name + "' before it is assigned on all paths");
                }
            }
            if (this.isGlobalName(lhs.name) && this.findVar(lhs.name) < 0) {
                // An in-scope binding — a local, a parameter, or an
                // in-scope class field (this-less member idiom) — shadows a
                // same-named global: the assignment targets the inner
                // binding. Only a global with no inner shadow is an invalid
                // target (const reassignment).
                this.fail("InvalidAssignment", lhs.line, lhs.col, lhs.name, "cannot write to a global or const");
            }
            int idx = this.findVar(lhs.name);
            if (idx >= 0) {
                GuardVar v = this.vars[idx];
                if (!v.isAlive) {
                    this.fail("NonexistenceException", lhs.line, lhs.col, lhs.name, "assignment to a dead variable");
                }
                if (v.isAlias && rhs.kind == GND_IDENT) {
                    v.aliasOf = rhs.name;
                    if (!this.targetAlive(rhs.name)) {
                        this.fail("UnsetAliasCallException", lhs.line, lhs.col, v.name, "alias target is dead or out of scope");
                    }
                }
                if (rhs.kind == GND_IDENT && n.op == GOP_ASSIGN && !this.isNonNullHere(rhs.name)) {
                    int ri = this.findVar(rhs.name);
                    if (ri >= 0 && this.vars[ri].isNullable) {
                        if (v.typeHint.length > 0 && !v.typeHint.endsWith("?")) {
                            this.fail("NullValueException", rhs.line, rhs.col, lhs.name, "nullable value " + rhs.name + " used without a null check (use ??)");
                        }
                    }
                }
                // Compound-store target kinds: `+=` concatenates onto a
                // string and pushes onto an array; every other compound
                // operator would compute on the pointer or header bits and
                // corrupt the value.
                if (isCompound && n.op != GOP_ADD_ASSIGN) {
                    string tt = v.typeHint;
                    if (tt == "string" || tt.endsWith("[]")) {
                        this.fail("TypeMismatch", lhs.line, lhs.col, lhs.name, "expected a numeric compound-assignment target, found " + this.gArticle(this.typeDisplayName(tt)));
                    }
                }
                // Assignment-value check (later assignments mirror
                // declaration initializers): a value whose fundamental
                // class cannot fit the typed target is an error at the
                // store. Plain `=` only — compound stores compute on the
                // old value.
                if (n.op == GOP_ASSIGN && v.typeHint.length > 0) {
                    this.checkAssignValueType(v.typeHint, rhs, lhs, lhs.name);
                }
                // Any assignment may reintroduce null into a previously
                // narrowed nullable; the flow fact dies here.
                this.dropNonNull(lhs.name);
                v.isInit = true;
                v.isAlive = true;
                this.markAddrHolding(v, rhs, lhs);
                if (rhsProof == GNN_NON_NULL && !isCompound) {
                    this.addNonNullFact(lhs.name);
                }
            }
        } else if (lhs.kind == GND_MEMBER) {
            this.checkExpr(lhs.child(0));
            // Member-store resolution: a read-only prop is never writable,
            // in any store form (plain, compound, inc/dec).
            this.checkMemberStore(lhs.child(0), lhs.name, lhs);
        } else {
            this.checkExpr(lhs);
        }
        return this.checkExpr(rhs);
    }

    private bool isPrimitive(string t) {
        if (t == "int" || t == "string" || t == "bool" || t == "char" || t == "float" || t == "float64" || t == "int32" || t == "int64" || t == "uint" || t == "double" || t == "void" || t == "var" || t == "byte") { return true; }
        return false;
    }

    private void checkNullableInit(Node node, Node init) {
        if (init.kind == GND_IDENT) {
            int ri = this.findVar(init.name);
            if (ri >= 0 && this.vars[ri].isNullable && !this.isNonNullHere(init.name)) {
                if (node.typeHint.length > 0 && !node.typeHint.endsWith("?")) {
                    this.fail("NullValueException", init.line, init.col, node.name, "nullable value " + init.name + " used without a null check (use ??)");
                }
            }
        }
    }

    private void checkVarDecl(Node n) {
        string name = n.name;
        bool nullable = n.typeHint.endsWith("?");
        bool onceFlag = n.isOnce;
        bool fixedFlag = n.isFixed;
        bool liveFlag = n.isLive;
        this.trackLocalDecl(n);
        if (n.childCount() == 0) {
            bool autoInit = liveFlag || onceFlag || !this.isPrimitive(n.typeHint);
            this.declareVar(name, n.typeHint, autoInit, true, onceFlag, fixedFlag, nullable, false, n.line, n.col);
            return;
        }
        Node init = n.child(0);
        if (init.kind == GND_BINARY && init.op == GOP_MOVE) {
            // Null-state of the moved initializer: `int? x <- nonnull`
            // starts non-null (null-state-flow declaration-state concept).
            int srcProof = this.exprProvesNonNull(init.child(1));
            this.killMoveSource(init.child(1));
            this.declareVar(name, n.typeHint, true, true, onceFlag, fixedFlag, nullable, false, n.line, n.col);
            if (srcProof == GNN_NON_NULL) { this.addNonNullFact(name); }
            return;
        }
        this.checkNullableInit(n, init);
        this.checkExpr(init);
        // Null-state of the initializer, for the declaration fact below
        // (sampled before the fresh binding clears the name's stale fact):
        // `int? x = 5` starts non-null; `int? x = src()` starts maybe-null.
        int initProof = this.exprProvesNonNull(init);
        // Assignability relations: the initializer's inferred type must
        // agree with the declared type's components (nullable inner,
        // array element, dict key/value); strings never interchange with
        // numbers or bools.
        string initType = this.inferStaticType(init);
        if (initType.length > 0 && n.typeHint.length > 0) {
            this.checkTypesCompatible(n.typeHint, initType, n, name);
        }
        GuardVar v = new GuardVar();
        v.name = name;
        v.typeHint = n.typeHint;
        v.isInit = true;
        v.isAlive = true;
        v.isOnce = onceFlag;
        v.isFixed = fixedFlag;
        v.isNullable = nullable;
        v.isAlias = false;
        v.holdsAddress = false;
        v.aliasOf = "";
        v.addrTarget = "";
        v.line = n.line;
        v.col = n.col;
        this.markAddrHolding(v, init, n);
        this.rejectSameScopeRedecl(name, n.line, n.col);
        this.vars.add(v);
        this.dropNonNull(name);
        if (initProof == GNN_NON_NULL) { this.addNonNullFact(name); }
    }

    private void checkAlias(Node n) {
        string aname = n.name;
        bool nullable = n.typeHint.endsWith("?");
        if (n.childCount() >= 2) {
            Node tgt = n.child(1);
            if (tgt.kind == GND_IDENT) {
                this.checkPeek(tgt);
                GuardVar v = new GuardVar();
                v.name = aname;
                v.typeHint = n.typeHint;
                v.isInit = true;
                v.isAlive = true;
                v.isNullable = nullable;
                v.isAlias = true;
                v.aliasOf = tgt.name;
                v.line = n.line;
                v.col = n.col;
                // A fresh alias binding clears a stale fact for a shadowing
                // outer name (the other branches go through declareVar).
                this.dropNonNull(aname);
                this.rejectSameScopeRedecl(aname, n.line, n.col);
                this.vars.add(v);
            } else if (tgt.kind == GND_NULL_LIT) {
                this.declareVar(aname, n.typeHint, true, true, false, false, nullable, true, n.line, n.col);
            } else {
                this.checkExpr(tgt);
                this.declareVar(aname, n.typeHint, true, true, false, false, nullable, true, n.line, n.col);
            }
        } else {
            this.declareVar(aname, n.typeHint, true, true, false, false, nullable, true, n.line, n.col);
        }
    }

    private void checkUnset(Node n) {
        int idx = this.findVar(n.name);
        if (idx >= 0) {
            GuardVar v = this.vars[idx];
            v.isAlive = false;
            v.isInit = false;
            this.killAliasesOf(n.name);
        }
    }

    // Assigned-but-never-used tracking (write/read tracking,
    // warning grade): every identifier read marks the name used — the only
    // appearance that does not is a plain assignment target (compound
    // assignments and `??=` read the target, so they count). The set is
    // name-based: any read of the name anywhere in the function counts,
    // even through shadowing scopes.
    private void markLocalUsed(string name) {
        if (!this.unusedTracking) { return; }
        if (!this.usedNames.contains(name)) { this.usedNames.add(name); }
    }

    private void suppressUnusedLocal(string name) {
        if (!this.suppressedNames.contains(name)) { this.suppressedNames.add(name); }
    }

    // Candidacy for the never-used report: plain locals only. Fixed vars,
    // fn-typed (`void ()`) declarations, names shadowing a global, and
    // redeclared names are suppressed; pattern/loop/catch binders go
    // through declareVar and never become candidates.
    private void trackLocalDecl(Node n) {
        if (!this.unusedTracking) { return; }
        if (this.candNames.contains(n.name) || this.suppressedNames.contains(n.name)) {
            this.suppressUnusedLocal(n.name);
            return;
        }
        if (n.isFixed || n.typeHint == "void" || n.typeHint == "void ()" || this.isGlobalName(n.name)) {
            this.suppressUnusedLocal(n.name);
            return;
        }
        this.candNames.add(n.name);
        this.candLines.add(n.line);
        this.candCols.add(n.col);
    }

    // End-of-function report (warning grade, never fatal): declaration
    // candidates never read on any path of this function, position-sorted
    // for deterministic output.
    private void reportUnusedLocals() {
        if (!this.unusedTracking) { return; }
        int[] order = [];
        for (int i = 0; i < this.candNames.length; i++) {
            if (this.usedNames.contains(this.candNames[i])) { continue; }
            if (this.suppressedNames.contains(this.candNames[i])) { continue; }
            order.add(i);
        }
        for (int a = 0; a < order.length; a++) {
            int best = a;
            for (int b = a + 1; b < order.length; b++) {
                if (this.candLines[order[b]] < this.candLines[order[best]]
                    || (this.candLines[order[b]] == this.candLines[order[best]] && this.candCols[order[b]] < this.candCols[order[best]])) { best = b; }
            }
            int tmp = order[a];
            order[a] = order[best];
            order[best] = tmp;
        }
        for (int a = 0; a < order.length; a++) {
            int i = order[a];
            this.warnings.add("'" + this.candNames[i] + "' is assigned but its value is never used at line " + (string)this.candLines[i] + ", column " + (string)this.candCols[i]);
        }
    }

    private void checkBlock(Node n) {
        this.pushScope();
        this.checkStmtList(n);
        this.popScope();
    }

    // A statement that never completes normally (flow graph
    // unreachable-flag concept): control cannot flow past it to the next
    // statement of the same block. Compound forms count when every path
    // through them terminates.
    private bool stmtIsTerminal(Node s) {
        if (s.kind == GND_RETURN || s.kind == GND_RETURN_SHORT || s.kind == GND_THROW
            || s.kind == GND_BREAK || s.kind == GND_CONTINUE) { return true; }
        if (s.kind == GND_IF_STMT) {
            return s.childCount() >= 3 && this.stmtListIsTerminal(s.child(1)) && this.stmtListIsTerminal(s.child(2));
        }
        if (s.kind == GND_EXPR_STMT && s.childCount() > 0 && s.child(0).kind == GND_MATCH_EXPR) {
            return this.matchIsTerminal(s.child(0));
        }
        if (s.kind == GND_WHILE) {
            return s.child(0).kind == GND_BOOL_LIT && s.child(0).boolVal && !this.stmtListContainsBreak(s.child(1));
        }
        if (s.kind == GND_SWITCH) { return this.switchIsTerminal(s); }
        if (s.kind == GND_TRY_CATCH) {
            if (s.name.length > 0) {
                return this.stmtListIsTerminal(s.child(0)) && this.stmtListIsTerminal(s.child(1));
            }
            // try/finally (no catch): the body either completes or the
            // exception propagates out of the function, so a terminal body
            // keeps control from falling past the statement.
            return this.stmtListIsTerminal(s.child(0));
        }
        return false;
    }

    // A match keeps control from falling past only when it is
    // exhaustive-looking (a `_` arm) and every arm body terminates.
    private bool matchIsTerminal(Node m) {
        if (m.childCount() <= 1) { return false; }
        bool hasWildcard = false;
        for (int i = 1; i < m.childCount(); i++) {
            Node arm = m.child(i);
            if (arm.kind != GND_MATCH_ARM || arm.childCount() == 0) { return false; }
            Node pat = arm.child(0);
            if (pat.kind == GND_IDENT && pat.name == "_") { hasWildcard = true; }
            Node body = arm.child(arm.childCount() - 1);
            if (body.kind != GND_BLOCK) { return false; }
            if (!this.stmtListIsTerminal(body)) { return false; }
        }
        return hasWildcard;
    }

    // Switch node shape: child(0) = subject, then alternating (case value,
    // case body) children; an even child count carries the else body last.
    private bool switchIsTerminal(Node s) {
        int n = s.childCount();
        if (n % 2 != 0) { return false; }
        if (!this.stmtListIsTerminal(s.child(n - 1))) { return false; }
        for (int i = 2; i < n - 1; i += 2) {
            if (!this.stmtListIsTerminal(s.child(i))) { return false; }
        }
        return true;
    }

    private bool stmtListIsTerminal(Node body) {
        if (body.kind == GND_BLOCK) {
            for (int i = 0; i < body.childCount(); i++) {
                if (this.stmtIsTerminal(body.child(i))) { return true; }
            }
            return false;
        }
        return this.stmtIsTerminal(body);
    }

    // Context-aware terminality for the missing-return analysis: an
    // expression-statement call to the builtin `exit` never returns (the
    // process ends), so a body whose last action is `exit(...)` completes
    // every path. Only the builtin counts — a user-declared `exit`
    // function is an ordinary call that returns.
    private bool stmtIsTerminalCtx(Node s) {
        if (s.kind == GND_EXPR_STMT && s.childCount() > 0) {
            Node e = s.child(0);
            if (e.kind == GND_CALL && !e.isMember && e.name == "exit" && !this.isUserFuncName("exit")) {
                return true;
            }
        }
        return this.stmtIsTerminal(s);
    }

    private bool stmtListIsTerminalCtx(Node body) {
        if (body.kind == GND_BLOCK) {
            for (int i = 0; i < body.childCount(); i++) {
                if (this.stmtIsTerminalCtx(body.child(i))) { return true; }
            }
            return false;
        }
        return this.stmtIsTerminalCtx(body);
    }

    private bool isUserFuncName(string name) {
        for (int i = 0; i < this.funcSigNames.length; i++) {
            if (this.funcSigNames[i] == name) { return true; }
        }
        return false;
    }

    private bool stmtListContainsBreak(Node body) {
        if (body.kind == GND_BLOCK) {
            for (int i = 0; i < body.childCount(); i++) {
                if (this.stmtContainsBreak(body.child(i))) { return true; }
            }
            return false;
        }
        return this.stmtContainsBreak(body);
    }

    // Any break anywhere in the body (even nested in another loop) counts as
    // an exit, so the while(true) termination judgment stays conservative.
    private bool stmtContainsBreak(Node s) {
        if (s.kind == GND_BREAK) { return true; }
        if (s.kind == GND_BLOCK) { return this.stmtListContainsBreak(s); }
        if (s.kind == GND_IF_STMT) {
            if (this.stmtListContainsBreak(s.child(1))) { return true; }
            return s.childCount() >= 3 && this.stmtListContainsBreak(s.child(2));
        }
        if (s.kind == GND_WHILE) { return this.stmtListContainsBreak(s.child(1)); }
        if (s.kind == GND_FOR_C) { return this.stmtListContainsBreak(s.child(3)); }
        if (s.kind == GND_FOREACH) { return this.stmtListContainsBreak(s.child(2)); }
        if (s.kind == GND_EXPR_STMT && s.childCount() > 0 && s.child(0).kind == GND_MATCH_EXPR) {
            Node m = s.child(0);
            for (int i = 1; i < m.childCount(); i++) {
                Node arm = m.child(i);
                if (arm.childCount() > 0 && this.stmtListContainsBreak(arm.child(arm.childCount() - 1))) { return true; }
            }
            return false;
        }
        if (s.kind == GND_SWITCH) {
            int n = s.childCount();
            int end = n;
            if (n % 2 == 0) {
                if (this.stmtListContainsBreak(s.child(n - 1))) { return true; }
                end = n - 1;
            }
            for (int i = 2; i < end; i += 2) {
                if (this.stmtListContainsBreak(s.child(i))) { return true; }
            }
            return false;
        }
        if (s.kind == GND_TRY_CATCH) {
            for (int i = 0; i < s.childCount(); i++) {
                if (this.stmtListContainsBreak(s.child(i))) { return true; }
            }
            return false;
        }
        return false;
    }

    // Check one statement list, reporting the first statement that cannot
    // execute because an earlier statement of the same block never completes
    // normally. Unreachability is a warning, not an error: #on/#off
    // preprocessor regions legitimately keep trailing target-specific code
    // after a return, so only the directly terminal forms raise it.
    private void checkStmtList(Node block) {
        bool terminalSeen = false;
        for (int i = 0; i < block.childCount(); i++) {
            Node s = block.child(i);
            if (terminalSeen) {
                this.warnings.add("unreachable code detected at line " + (string)s.line + ", column " + (string)s.col);
                terminalSeen = false;
                this.checkStmt(s);
                continue;
            }
            this.checkStmt(s);
            if (s.kind == GND_RETURN || s.kind == GND_RETURN_SHORT || s.kind == GND_THROW
                || s.kind == GND_BREAK || s.kind == GND_CONTINUE) {
                terminalSeen = true;
            }
        }
    }

    private void checkIf(Node n) {
        Node cond = n.child(0);
        this.checkExpr(cond);
        // Constant-condition reachability (constant-fold
        // concept, warning grade): a literal-false condition makes the
        // then-body dead code. Literal `true` stays silent — guaranteed-run
        // blocks are an ordinary idiom.
        if (cond.kind == GND_BOOL_LIT && !cond.boolVal) {
            this.warnings.add("condition is always false: this body never executes at line " + (string)n.line + ", column " + (string)n.col);
        }
        string[] thenNarrowed = [];
        string[] elseNarrowed = [];
        this.collectNarrowings(cond, true, thenNarrowed);
        this.collectNarrowings(cond, false, elseNarrowed);
        GuardVar[] before = this.snapshot();
        string[] savedNN = this.snapshotNonNull();
        this.pushScope();
        this.addNarrowings(thenNarrowed);
        this.checkStmt(n.child(1));
        string[] thenNN = this.snapshotNonNull();
        bool thenTerminal = this.stmtListIsTerminal(n.child(1));
        this.popScope();
        this.nonNullNames = savedNN;
        GuardVar[] afterThen = this.snapshot();
        this.vars = before;
        GuardVar[] afterElse = [];
        // Join-point merge (null-state-flow `Meet` at branch convergence):
        // a fact survives the if only when it holds on every path that
        // completes it. Terminal branches never reach the join
        // (`Meet(Unreachable, X) = X`), so their states drop out; a missing
        // else joins with the condition's false-facts on the pre-if state.
        string[] joined = [];
        bool haveJoin = false;
        if (!thenTerminal) { joined = thenNN; haveJoin = true; }
        if (n.childCount() >= 3) {
            this.pushScope();
            this.addNarrowings(elseNarrowed);
            this.checkStmt(n.child(2));
            if (!this.stmtListIsTerminal(n.child(2))) {
                string[] elseNN = this.snapshotNonNull();
                if (!haveJoin) { joined = elseNN; haveJoin = true; } else { joined = this.meetNonNull(joined, elseNN); }
            }
            this.popScope();
            this.nonNullNames = savedNN;
            afterElse = this.snapshot();
        } else {
            afterElse = this.snapshot();
            string[] implicitPath = this.copyWithFacts(savedNN, elseNarrowed);
            if (!haveJoin) { joined = implicitPath; haveJoin = true; } else { joined = this.meetNonNull(joined, implicitPath); }
        }
        if (!haveJoin) { joined = savedNN; }
        this.nonNullNames = joined;
        for (int i = 0; i < this.vars.length; i++) {
            GuardVar v = this.vars[i];
            v.isInit = afterThen[i].isInit && afterElse[i].isInit;
            v.isAlive = afterThen[i].isAlive || afterElse[i].isAlive;
            v.holdsAddress = afterThen[i].holdsAddress || afterElse[i].holdsAddress;
        }
    }

    private void checkWhile(Node n) {
        this.checkExpr(n.child(0));
        // Constant-condition reachability: `while (false)` never runs its
        // body — `while (true)` is the intentional-infinite-loop idiom and
        // stays silent.
        if (n.child(0).kind == GND_BOOL_LIT && !n.child(0).boolVal) {
            this.warnings.add("condition is always false: this body never executes at line " + (string)n.line + ", column " + (string)n.col);
        }
        GuardVar[] before = this.snapshot();
        string[] savedNN = this.snapshotNonNull();
        // While the loop runs, the condition holds: nullable conditions
        // like `while (x != null)` narrow `x` inside the body.
        string[] narrowed = [];
        this.collectNarrowings(n.child(0), true, narrowed);
        // Exit facts (null-state-flow loop back-edge concept): every normal
        // exit re-tests the condition and finds it false, so the
        // condition's false-facts (`while (x == null)` -> x non-null after
        // the loop) hold at the join. A `break` exits mid-body without
        // re-testing, so a body containing one forgoes the exit facts.
        string[] exitNarrowed = [];
        if (!this.stmtListContainsBreak(n.child(1))) {
            this.collectNarrowings(n.child(0), false, exitNarrowed);
        }
        this.pushScope();
        this.addNarrowings(narrowed);
        this.loopDepth++;
        this.checkStmt(n.child(1));
        this.loopDepth--;
        string[] bodyNN = this.snapshotNonNull();
        this.popScope();
        // Join: the zero-iteration path contributes the pre-loop state, the
        // >=1-iteration path the body's exit state; both then gain the exit
        // facts (they hold at every condition re-test).
        this.nonNullNames = this.copyWithFacts(this.meetNonNull(savedNN, bodyNN), exitNarrowed);
        this.vars = before;
    }

    private void checkFor(Node n) {
        this.pushScope();
        this.checkStmt(n.child(0));
        GuardVar[] before = this.snapshot();
        this.checkExpr(n.child(1));
        this.pushScope();
        this.loopDepth++;
        this.checkStmt(n.child(3));
        this.loopDepth--;
        string[] bodyNN = this.snapshotNonNull();
        this.popScope();
        this.vars = before;
        // Historical outflow kept deliberately: loop-body null-state flows
        // out of for loops (a guaranteed-run loop's body facts hold after
        // it; joining with the entry state would drop facts such programs
        // rely on).
        this.nonNullNames = bodyNN;
        this.checkExpr(n.child(2));
        this.popScope();
    }

    private void checkForeach(Node n) {
        this.checkExpr(n.child(1));
        // Iterability check: a scalar number or bool cannot be iterated
        // (the loop would read it as a collection header). Strings
        // (chars), arrays, dicts and class values iterate; untyped
        // collections are never judged.
        string ct = this.inferStaticType(n.child(1));
        if (this.isNumericTypeName(ct) || ct == "bool") {
            this.fail("TypeMismatch", n.line, n.col, n.name, "expected an iterable collection, found " + this.gArticle(this.typeDisplayName(ct)));
        }
        this.pushScope();
        Node vd = n.child(0);
        this.declareVar(vd.name, vd.typeHint, true, true, false, false, vd.typeHint.endsWith("?"), false, vd.line, vd.col);
        this.loopDepth++;
        this.checkStmt(n.child(2));
        this.loopDepth--;
        string[] bodyNN = this.snapshotNonNull();
        this.popScope();
        // Like the C-style for: the body's exit state flows out.
        this.nonNullNames = bodyNN;
    }

    private void checkTryCatch(Node n) {
        string[] savedNN = this.snapshotNonNull();
        this.pushScope();
        this.checkStmt(n.child(0));
        bool bodyTerminal = this.stmtListIsTerminal(n.child(0));
        string[] tryNN = this.snapshotNonNull();
        this.popScope();
        this.nonNullNames = savedNN;
        GuardVar[] afterTry = this.snapshot();
        this.vars = afterTry;
        this.pushScope();
        string cv = n.name;
        if (cv.length > 0) {
            this.declareVar(cv, n.typeHint, true, true, false, false, n.typeHint.endsWith("?"), false, n.line, n.col);
        }
        this.checkStmt(n.child(1));
        string[] catchNN = this.snapshotNonNull();
        bool catchTerminal = this.stmtListIsTerminal(n.child(1));
        this.popScope();
        GuardVar[] afterCatch = this.snapshot();
        for (int i = 0; i < this.vars.length; i++) {
            GuardVar v = this.vars[i];
            v.isInit = afterTry[i].isInit && afterCatch[i].isInit;
            v.isAlive = afterTry[i].isAlive || afterCatch[i].isAlive;
            v.holdsAddress = afterTry[i].holdsAddress || afterCatch[i].holdsAddress;
        }
        // Join (null-state-flow try/catch convergence): the statement
        // completes via the body's end or the catch's end; a fact must hold
        // on both. Terminal paths never reach the join.
        if (cv.length > 0) {
            string[] joined = [];
            bool haveJoin = false;
            if (!bodyTerminal) { joined = tryNN; haveJoin = true; }
            if (!catchTerminal) {
                if (!haveJoin) { joined = catchNN; haveJoin = true; } else { joined = this.meetNonNull(joined, catchNN); }
            }
            if (!haveJoin) { joined = savedNN; }
            this.nonNullNames = joined;
        } else {
            // try/finally (no catch): normal completion is the body's end
            // state; an exception leaves the function.
            if (bodyTerminal) { this.nonNullNames = savedNN; } else { this.nonNullNames = tryNN; }
        }
        if (n.hasFinally && n.childCount() >= 3) {
            // Facts set inside the finally body die with it (the join above
            // already decided the statement's exit state).
            string[] preFinally = this.snapshotNonNull();
            this.pushScope();
            this.checkStmt(n.child(2));
            this.popScope();
            this.nonNullNames = preFinally;
        }
    }

    // Switch node shape: child(0) = subject, then alternating (case value,
    // case body) children; an even child count carries the else body last.
    // Definite-assignment merge (branch-label antecedent union concept,
    // mirroring if/else): a variable is initialized after the switch only
    // when it was initialized in the else body AND in every case body;
    // without an else, the no-match path keeps nothing initialized (the
    // reference keeps the no-match path unassigned). Liveness unions across
    // branches plus the pre-switch state, like if-without-else.
    private void checkSwitch(Node n) {
        this.checkExpr(n.child(0));
        this.checkEnumExhaustiveSwitch(n);
        GuardVar[] before = this.snapshot();
        string[] savedNN = this.snapshotNonNull();
        int total = n.childCount();
        bool hasElse = total % 2 == 0;
        int pairEnd = total;
        if (hasElse) { pairEnd = total - 1; }
        // Duplicate case values (warning grade): two arms with the same
        // literal (or same dotted enum variant spelling) — the second can
        // never run, the first equal value wins. Dynamic values are
        // undecidable and stay silent.
        string[] seenCases = [];
        for (int ci = 1; ci < pairEnd; ci += 2) {
            Node cv = n.child(ci);
            string ck = this.caseValueKey(cv);
            if (ck.length == 0) { continue; }
            if (seenCases.contains(ck)) {
                this.warnings.add("duplicate case value '" + this.caseValueRender(cv) + "' can never run at line " + (string)cv.line + ", column " + (string)cv.col);
            } else {
                seenCases.add(ck);
            }
        }
        bool[] initOk = [];
        bool[] aliveAny = [];
        bool[] addrAny = [];
        for (int b = 0; b < this.vars.length; b++) {
            initOk.add(false);
            aliveAny.add(false);
            addrAny.add(false);
        }
        // Join-point merge (null-state-flow Meet): every non-terminal case
        // and else exit state must agree; without an else the no-match
        // path joins with the pre-switch state. Terminal branches never
        // reach the join.
        string[] joined = [];
        bool haveJoin = false;
        if (hasElse) {
            this.vars = before;
            this.pushScope();
            this.checkStmtList(n.child(total - 1));
            if (!this.stmtListIsTerminal(n.child(total - 1))) {
                joined = this.snapshotNonNull();
                haveJoin = true;
            }
            this.popScope();
            this.nonNullNames = savedNN;
            for (int b = 0; b < this.vars.length; b++) {
                initOk[b] = this.vars[b].isInit;
                aliveAny[b] = this.vars[b].isAlive;
                addrAny[b] = this.vars[b].holdsAddress;
            }
        }
        for (int ci = 1; ci < pairEnd; ci += 2) {
            this.vars = before;
            this.nonNullNames = savedNN;
            this.checkExpr(n.child(ci));
            this.pushScope();
            this.checkStmtList(n.child(ci + 1));
            if (!this.stmtListIsTerminal(n.child(ci + 1))) {
                string[] caseNN = this.snapshotNonNull();
                if (!haveJoin) { joined = caseNN; haveJoin = true; } else { joined = this.meetNonNull(joined, caseNN); }
            }
            this.popScope();
            for (int b = 0; b < this.vars.length; b++) {
                initOk[b] = initOk[b] && this.vars[b].isInit;
                if (this.vars[b].isAlive) { aliveAny[b] = true; }
                if (this.vars[b].holdsAddress) { addrAny[b] = true; }
            }
        }
        if (!hasElse) {
            // No-match path: control falls past the switch with the
            // pre-switch state (liveness only; initialization stays
            // unassigned on that path by the merge above).
            if (!haveJoin) { joined = savedNN; haveJoin = true; } else { joined = this.meetNonNull(joined, savedNN); }
            for (int b = 0; b < this.vars.length; b++) {
                if (before[b].isAlive) { aliveAny[b] = true; }
                if (before[b].holdsAddress) { addrAny[b] = true; }
            }
        }
        this.vars = before;
        for (int b = 0; b < this.vars.length; b++) {
            this.vars[b].isInit = initOk[b];
            this.vars[b].isAlive = aliveAny[b];
            this.vars[b].holdsAddress = addrAny[b];
        }
        if (!haveJoin) { joined = savedNN; }
        this.nonNullNames = joined;
    }

    private void checkMatchBody(Node body) {
        if (body.kind == GND_BLOCK) {
            this.pushScope();
            this.checkStmtList(body);
            this.popScope();
        } else {
            this.checkExpr(body);
        }
    }

    private void checkDestructure(Node n) {
        if (n.childCount() < 2) { return; }
        Node init = n.child(n.childCount() - 1);
        this.checkExpr(init);
        for (int i = 0; i < n.childCount() - 1; i++) {
            Node nm = n.child(i);
            this.declareVar(nm.name, "", true, true, false, false, false, false, nm.line, nm.col);
        }
    }

    private bool isArithOp(int op) {
        if (op == GOP_ADD || op == GOP_SUB || op == GOP_MUL || op == GOP_DIV || op == GOP_MOD || op == GOP_SHL || op == GOP_SHR || op == GOP_BIT_AND || op == GOP_BIT_OR || op == GOP_BIT_XOR || op == GOP_AND || op == GOP_OR) { return true; }
        return false;
    }

    private int enumIndexOf(string name) {
        for (int i = 0; i < this.enumNames.length; i++) {
            if (this.enumNames[i] == name) { return i; }
        }
        return -1;
    }

    // The enum type name of a switch/match subject, or "" when the subject
    // is not a known-enum-typed identifier (unknown subjects are never
    // judged — no guessing, no false warnings).
    private string enumTypeOfSubject(Node e) {
        while (e.kind == GND_PAREN) { e = e.child(0); }
        if (e.kind != GND_IDENT) { return ""; }
        int idx = this.findVar(e.name);
        if (idx < 0) { return ""; }
        string t = this.vars[idx].typeHint;
        if (this.enumIndexOf(t) >= 0) { return t; }
        return "";
    }

    // Exhaustiveness warning (coverage check, warning grade) over the
    // collected variant table: only a provably partial enumeration warns —
    // the callers silence the check for wildcards and undecodable covers.
    private void warnEnumNotExhaustive(string en, string[] covered, int line, int col) {
        int ei = this.enumIndexOf(en);
        if (ei < 0) { return; }
        string[] missing = [];
        for (int v = 0; v < this.enumCounts[ei]; v++) {
            string variant = this.enumVariantNames[this.enumStarts[ei] + v];
            if (!covered.contains(variant)) { missing.add(variant); }
        }
        if (missing.length == 0) { return; }
        string list = "";
        for (int m = 0; m < missing.length; m++) {
            if (m > 0) { list += ", "; }
            list += "'" + missing[m] + "'";
        }
        this.warnings.add("switch on enum '" + en + "' does not cover " + list + " at line " + (string)line + ", column " + (string)col);
    }

    // Switch statement exhaustiveness (coverage check): coverage is counted
    // only from dotted `EnumName.Variant` case values; an else/default body
    // covers everything; any undecodable case value silences the check.
    private void checkEnumExhaustiveSwitch(Node n) {
        string en = this.enumTypeOfSubject(n.child(0));
        if (en.length == 0) { return; }
        int total = n.childCount();
        bool hasElse = total % 2 == 0;
        int coverEnd = total;
        if (hasElse) { coverEnd = total - 1; }
        string[] covered = [];
        for (int ci = 1; ci < coverEnd; ci += 2) {
            Node v = n.child(ci);
            if (v.kind == GND_MEMBER && v.childCount() > 0 && v.child(0).kind == GND_IDENT && v.child(0).name == en) {
                if (!covered.contains(v.name)) { covered.add(v.name); }
                continue;
            }
            return;
        }
        if (hasElse) { return; }
        this.warnEnumNotExhaustive(en, covered, n.line, n.col);
    }

    // Match (statement or expression) exhaustiveness (coverage check):
    // dotted `EnumName.Variant` patterns count; a `_` wildcard covers
    // everything; a guarded arm (childCount 3 — its when-clause may not
    // match) and any undecodable pattern silence the check.
    private void checkEnumExhaustiveMatch(Node m) {
        string en = this.enumTypeOfSubject(m.child(0));
        if (en.length == 0) { return; }
        string[] covered = [];
        for (int i = 1; i < m.childCount(); i++) {
            Node arm = m.child(i);
            if (arm.kind != GND_MATCH_ARM || arm.childCount() < 2) { return; }
            if (arm.childCount() >= 3) { return; }
            Node pat = arm.child(0);
            if (pat.kind == 0 && pat.name == "_") { return; }
            if (pat.kind == GND_MEMBER && pat.name.startsWith(en + ".") && pat.name.length > en.length + 1) {
                string variant = this.gsSlice(pat.name, en.length + 1, pat.name.length);
                if (!covered.contains(variant)) { covered.add(variant); }
                continue;
            }
            return;
        }
        this.warnEnumNotExhaustive(en, covered, m.line, m.col);
    }

    // Variant-reference check: `EnumName.Variant` must name a declared
    // variant when the receiver names a known enum that no class or struct
    // shadows — those receivers resolve dynamically and are never judged.
    private void checkEnumVariantRef(string enumName, string variant, Node at) {
        int ei = this.enumIndexOf(enumName);
        if (ei < 0) { return; }
        if (this.classIndexOf(enumName) >= 0) { return; }
        for (int v = 0; v < this.enumCounts[ei]; v++) {
            if (this.enumVariantNames[this.enumStarts[ei] + v] == variant) { return; }
        }
        this.fail("UnknownEnumVariant", at.line, at.col, variant, "enum '" + enumName + "' has no variant '" + variant + "'");
    }

    // Match-pattern variant references: a dotted `EnumName.Variant`
    // pattern carries the full spelling in `name`; an invented variant
    // would match nothing.
    private void checkMatchPatternVariants(Node m) {
        for (int i = 1; i < m.childCount(); i++) {
            Node arm = m.child(i);
            if (arm.kind != GND_MATCH_ARM || arm.childCount() < 2) { continue; }
            Node pat = arm.child(0);
            if (pat.kind != GND_MEMBER) { continue; }
            int dot = -1;
            for (int c = 0; c < pat.name.length; c++) {
                if (pat.name[c] == '.') { dot = c; break; }
            }
            if (dot <= 0) { continue; }
            string en = this.gsSlice(pat.name, 0, dot);
            string vr = this.gsSlice(pat.name, dot + 1, pat.name.length);
            this.checkEnumVariantRef(en, vr, arm);
        }
    }

    // Comparable key for a switch case value or dict literal key
    // (duplicate-value check): literals and dotted `EnumName.Variant`
    // spellings key on their value; anything dynamic (calls, identifiers,
    // expressions) is undecidable and keys to nothing.
    private string caseValueKey(Node v) {
        if (v.kind == GND_INT_LIT) { return "i:" + (string)v.intVal; }
        if (v.kind == GND_FLOAT_LIT) { return "f:" + (string)v.floatVal; }
        if (v.kind == GND_STRING_LIT) { return "s:" + v.strVal; }
        if (v.kind == GND_CHAR_LIT) { return "c:" + (string)v.charVal; }
        if (v.kind == GND_BOOL_LIT) {
            if (v.boolVal) { return "b:1"; }
            return "b:0";
        }
        if (v.kind == GND_MEMBER && v.childCount() > 0 && v.child(0).kind == GND_IDENT) {
            return "e:" + v.child(0).name + "." + v.name;
        }
        if (v.kind == GND_PAREN) { return this.caseValueKey(v.child(0)); }
        return "";
    }

    // Human spelling of a case value or dict key for its warning.
    private string caseValueRender(Node v) {
        if (v.kind == GND_INT_LIT) { return (string)v.intVal; }
        if (v.kind == GND_FLOAT_LIT) { return (string)v.floatVal; }
        if (v.kind == GND_STRING_LIT) { return v.strVal; }
        if (v.kind == GND_CHAR_LIT) { return (string)v.charVal; }
        if (v.kind == GND_BOOL_LIT) {
            if (v.boolVal) { return "true"; }
            return "false";
        }
        if (v.kind == GND_MEMBER && v.childCount() > 0 && v.child(0).kind == GND_IDENT) {
            return v.child(0).name + "." + v.name;
        }
        if (v.kind == GND_PAREN) { return this.caseValueRender(v.child(0)); }
        return "?";
    }

    // "an int" / "a string" — the parser owns the same spelling for its
    // literal-argument diagnostics; the guard cannot import across the
    // std/compiler boundary, so the twin lives here (gsSlice precedent).
    private string gArticle(string typeName) {
        if (typeName.length == 0) { return "a " + typeName; }
        char fc = typeName[0];
        if (fc == 'a' || fc == 'e' || fc == 'i' || fc == 'o') { return "an " + typeName; }
        return "a " + typeName;
    }

    // Human spelling of a type for value-kind diagnostics: primitives keep
    // their name, arrays read "X array", nullables "nullable X", dicts
    // "K-to-V dict"; anything else passes through.
    private string typeDisplayName(string t) {
        if (t.endsWith("[]")) {
            return this.typeDisplayName(this.gsSlice(t, 0, t.length - 2)) + " array";
        }
        if (t.endsWith("?")) {
            return "nullable " + this.typeDisplayName(this.gsSlice(t, 0, t.length - 1));
        }
        string dk = this.dictKeyOf(t);
        if (dk.length > 0) {
            return dk + "-to-" + this.dictValueOf(t) + " dict";
        }
        return t;
    }

    // Argument-level nullable checking on calls (flow null-state check,
    // error grade): a nullable argument may not flow into a non-nullable
    // primitive parameter of a known user function without a null check.
    // It passes when the flow proved the identifier non-null
    // (`if (x != null) f(x)`), when `??` unwrapped it (the inferred type
    // is the inner, non-nullable one), when another overload's
    // nullable/untyped parameter accepts it, or when the callee reads the
    // parameter through a null-safe form anywhere in its body (a `??` /
    // `??=` coalesce on it, an `== null` / `!= null` guard, or a `?.` /
    // `?[` chain over it — call-argument null-tolerance). Composed
    // argument types are assignability-checked against the parameter in
    // their components: array element types, dict key/value types, and
    // nullable inner types must agree. Only free calls to functions whose
    // signatures were collected are judged — member calls and unknown
    // callees stay silent. Before the per-argument relations, the overload
    // set is arity-dispatched: a call whose argument count no collected
    // declaration of the name accepts fails the compile outright.
    private void checkCallArgs(Node n) {
        int argc = n.childCount();
        // A function-typed local or parameter invokes with zero arguments
        // (the stored address is called); a same-named free function must
        // not shadow that invocation into an arity error.
        if (argc == 0) {
            int fidx = this.findVar(n.name);
            if (fidx >= 0 && this.vars[fidx].typeHint == "void ()") { return; }
        }
        string[] argTypes = [];
        bool anyCheckable = false;
        for (int j = 0; j < argc; j++) {
            string t = this.inferStaticType(n.child(j));
            argTypes.add(t);
            if (t.length > 0 && t != "var" && t != "void") { anyCheckable = true; }
        }
        // The signature the argument count selects (last-declared first,
        // default parameters and variadic tails counting): the one whose
        // parameter types name the diagnostics when nothing accepts.
        int selected = -1;
        int lastNamed = -1;
        bool anyArityMatch = false;
        bool anyAccepts = false;
        for (int s = 0; s < this.funcSigNames.length; s++) {
            if (this.funcSigNames[s] != n.name) { continue; }
            lastNamed = s;
            if (!this.sigAcceptsArgc(this.funcSigNodes[s], argc)) { continue; }
            anyArityMatch = true;
            if (selected < 0) { selected = s; }
            if (this.sigAcceptsArgs(s, argc, argTypes, n)) { anyAccepts = true; break; }
        }
        // Arity dispatch over the overload set: the name has collected
        // signatures (lastNamed >= 0), but no declaration's parameter count
        // accepts the call — an argument count no overload takes is a
        // compile error, not a silent pass (the general free-call contract).
        if (lastNamed >= 0 && !anyArityMatch) {
            this.fail("OverloadArity", n.line, n.col, n.name, "no overload of '" + n.name + "' takes " + (string)argc + " argument(s)");
        }
        if (!anyCheckable || anyAccepts) { return; }
        if (selected < 0) { selected = lastNamed; }
        if (selected < 0) { return; }
        // First failing argument of the selected signature, in the same
        // per-argument order the acceptance test uses.
        for (int j = 0; j < argc && j < this.funcSigCounts[selected]; j++) {
            Node arg = n.child(j);
            string actual = argTypes[j];
            if (actual.length == 0 || actual == "var" || actual == "void") { continue; }
            string pname = this.funcSigParamNames[this.funcSigStarts[selected] + j];
            string pt = this.funcSigParamTypes[this.funcSigStarts[selected] + j];
            if (this.argMismatchKind(selected, j, actual) == 1) {
                this.fail("ParamTypeMismatch", arg.line, arg.col, pname, "expected " + this.gArticle(this.typeDisplayName(pt)) + ", got " + this.gArticle(this.typeDisplayName(actual)));
            }
            if (actual.endsWith("?") && this.fundamentalClass(pt).length > 0
                && pt.length > 0 && pt != "var" && !pt.endsWith("?")) {
                bool narrowed = arg.kind == GND_IDENT && this.isNonNullHere(arg.name);
                bool tolerant = this.paramNullTolerant(this.funcSigNodes[selected], pname);
                if (!narrowed && !tolerant) {
                    string inner = this.gsSlice(actual, 0, actual.length - 1);
                    this.fail("ParamTypeMismatch", arg.line, arg.col, pname, "expected " + this.gArticle(pt) + ", got " + this.gArticle("nullable " + inner) + " — nullable value for \"" + pname + "\" parameter of '" + n.name + "' used without a null check (use ??)");
                }
            }
        }
    }

    // Arity acceptance of one signature for `argc` arguments: default
    // parameters make the tail optional, a variadic tail takes the rest.
    private bool sigAcceptsArgc(Node fn, int argc) {
        Node ps = fn.child(0);
        int count = ps.childCount();
        bool variadic = count > 0 && ps.child(count - 1).isVariadic;
        int fixedLen = count;
        if (variadic) { fixedLen = count - 1; }
        int minArgs = 0;
        for (int i = 0; i < fixedLen; i++) {
            if (ps.child(i).childCount() == 0) { minArgs++; }
        }
        if (variadic) { return argc >= minArgs; }
        return argc >= minArgs && argc <= count;
    }

    // Per-signature acceptance of every argument (overload rescue): both
    // the component relations and the nullable-argument rule must hold for
    // every parameter the call reaches (a variadic tail takes the rest
    // unchecked).
    private bool sigAcceptsArgs(int s, int argc, string[] argTypes, Node call) {
        Node ps0 = this.funcSigNodes[s].child(0);
        for (int j = 0; j < argc && j < this.funcSigCounts[s]; j++) {
            if (ps0.child(j).isVariadic) { break; }
            string actual = argTypes[j];
            if (actual.length == 0 || actual == "var" || actual == "void") { continue; }
            string pt = this.funcSigParamTypes[this.funcSigStarts[s] + j];
            // Fundamental-class agreement, then the composed component
            // relations (a string[] argument cannot feed an int[]
            // parameter).
            string pfc = this.fundamentalClass(pt);
            string afc = this.fundamentalClass(actual);
            if (pt == "string" && actual == "char") { continue; }
            if (pfc.length > 0 && afc.length > 0 && pfc != afc) { return false; }
            if (!this.typesCompatibleQuiet(pt, actual)) { return false; }
            // Nullable-argument rule with the body-aware tolerance.
            if (actual.endsWith("?") && pfc.length > 0
                && pt.length > 0 && pt != "var" && !pt.endsWith("?")) {
                Node arg = call.child(j);
                bool narrowed = arg.kind == GND_IDENT && this.isNonNullHere(arg.name);
                bool tolerant = this.paramNullTolerant(this.funcSigNodes[s], this.funcSigParamNames[this.funcSigStarts[s] + j]);
                if (!narrowed && !tolerant) { return false; }
            }
        }
        return true;
    }

    // Which relation fails for argument `j` of signature `s`: 1 = the
    // value-kind components (class or composed mismatch), 0 = only the
    // nullable rule. Mirrors sigAcceptsArgs's order.
    private int argMismatchKind(int s, int j, string actual) {
        string pt = this.funcSigParamTypes[this.funcSigStarts[s] + j];
        string pfc = this.fundamentalClass(pt);
        string afc = this.fundamentalClass(actual);
        if (pt == "string" && actual == "char") { return 0; }
        if (pfc.length > 0 && afc.length > 0 && pfc != afc) { return 1; }
        if (!this.typesCompatibleQuiet(pt, actual)) { return 1; }
        return 0;
    }

    // Call-argument null-tolerance: the callee's body reads `param` through
    // a null-safe form anywhere — a `??` / `??=` whose left side is the
    // parameter, an `== null` / `!= null` guard on it (either order), or a
    // `?.` / `?[` chain over it. Such a callee deliberately accepts null
    // for that parameter. A declaration without a body cannot be judged
    // and is permissive.
    private bool paramNullTolerant(Node fn, string param) {
        if (fn.childCount() < 2) { return true; }
        Node body = fn.child(1);
        if (body.kind == GND_BLOCK) {
            for (int i = 0; i < body.childCount(); i++) {
                if (this.nodeNullTolerant(body.child(i), param)) { return true; }
            }
            return false;
        }
        return this.nodeNullTolerant(body, param);
    }

    // Structural null-safe-use walk over any node tree (statements and
    // expressions share one node model, so one walker covers both).
    private bool nodeNullTolerant(Node n, string param) {
        if (n.kind == GND_BINARY && (n.op == GOP_COALESCE || n.op == GOP_COALESCE_ASSIGN)) {
            if (this.isParamExpr(n.child(0), param)) { return true; }
        }
        // A `?.` / `?[` chain (kind 75) wraps the member/call/index node
        // whose child(0) is the receiver.
        if (n.kind == 75) {
            Node inner = n.child(0);
            if (inner.childCount() > 0 && this.isParamExpr(inner.child(0), param)) { return true; }
        }
        if (n.kind == GND_BINARY && (n.op == GOP_EQ || n.op == GOP_NEQ)) {
            Node nl = n.child(0);
            Node nr = n.child(1);
            if (nl.kind == GND_NULL_LIT && this.isParamExpr(nr, param)) { return true; }
            if (nr.kind == GND_NULL_LIT && this.isParamExpr(nl, param)) { return true; }
        }
        for (int i = 0; i < n.childCount(); i++) {
            if (this.nodeNullTolerant(n.child(i), param)) { return true; }
        }
        return false;
    }

    // `expr` is exactly the identifier `param` (parentheses stripped).
    private bool isParamExpr(Node e, string param) {
        if (e.kind == GND_PAREN) { return this.isParamExpr(e.child(0), param); }
        return e.kind == GND_IDENT && e.name == param;
    }

    private int checkExpr(Node n) {
        int k = n.kind;
        if (k == GND_INT_LIT || k == GND_FLOAT_LIT || k == GND_STRING_LIT || k == GND_CHAR_LIT || k == GND_BOOL_LIT || k == GND_NULL_LIT) { return 0; }
        if (k == GND_IDENT) {
            this.checkRead(n);
            int idx = this.findVar(n.name);
            if (idx >= 0 && this.vars[idx].holdsAddress) { return 1; }
            return 0;
        }
        if (k == GND_BINARY) {
            int op = n.op;
            if (op == GOP_ASSIGN || op == GOP_ADD_ASSIGN || op == GOP_SUB_ASSIGN || op == GOP_MUL_ASSIGN || op == GOP_DIV_ASSIGN
                || op == GOP_MOD_ASSIGN || op == GOP_BIT_AND_ASSIGN || op == GOP_BIT_OR_ASSIGN || op == GOP_BIT_XOR_ASSIGN
                || op == GOP_SHL_ASSIGN || op == GOP_SHR_ASSIGN) { return this.checkAssign(n); }
            if (op == GOP_MOVE) { this.checkMove(n); return 0; }
            if (op == GOP_COALESCE) {
                this.unwrapDepth++;
                this.checkExpr(n.child(0));
                this.unwrapDepth--;
                this.checkExpr(n.child(1));
                return 0;
            }
            if (op == GOP_COALESCE_ASSIGN) {
                // DOCS/273 `lhs ??= rhs`: assigns (and evaluates the RHS)
                // only when the LHS is null, so the target is read — its
                // null state decides. A non-null right side leaves the
                // target non-null on every path (null-state-flow `??=`
                // result state); a maybe-null right side keeps it
                // maybe-null (the fact already died in the target
                // handling below).
                int rhsProof = this.exprProvesNonNull(n.child(1));
                Node lhs = n.child(0);
                if (lhs.kind == GND_IDENT && lhs.name != "this") {
                    this.markLocalUsed(lhs.name);
                    // Same shadowing rule as a plain store: an in-scope
                    // binding (local, parameter, class field) hides a
                    // same-named global.
                    if (this.isGlobalName(lhs.name) && this.findVar(lhs.name) < 0) {
                        this.fail("InvalidAssignment", lhs.line, lhs.col, lhs.name, "cannot write to a global or const");
                    }
                    int idx = this.findVar(lhs.name);
                    if (idx >= 0) {
                        if (!this.vars[idx].isAlive) {
                            this.fail("NonexistenceException", lhs.line, lhs.col, lhs.name, "assignment to a dead variable");
                        }
                        this.dropNonNull(lhs.name);
                        this.vars[idx].isInit = true;
                        this.vars[idx].isAlive = true;
                    }
                    this.checkExpr(n.child(1));
                    if (rhsProof == GNN_NON_NULL) { this.addNonNullFact(lhs.name); }
                    return 0;
                }
                this.checkExpr(lhs);
                this.checkExpr(n.child(1));
                return 0;
            }
            if (op == GOP_EQ || op == GOP_NEQ) {
                Node nl = n.child(0);
                Node nr = n.child(1);
                if (nr.kind == GND_NULL_LIT && nl.kind != GND_NULL_LIT) {
                    this.unwrapDepth++;
                    this.checkExpr(nl);
                    this.unwrapDepth--;
                    this.checkExpr(nr);
                    return 0;
                }
                this.checkExpr(nl);
                this.checkExpr(nr);
                return 0;
            }
            int la = this.checkExpr(n.child(0));
            int ra = this.checkExpr(n.child(1));
            if (this.isArithOp(op)) {
                if (la == 1 || ra == 1) {
                    Node bad = n.child(0);
                    if (ra == 1 && la != 1) { bad = n.child(1); }
                    string bname = "";
                    int bline = n.line;
                    int bcol = n.col;
                    if (bad.kind == GND_ADDRESS_OF) {
                        Node u = bad.child(0);
                        if (u.kind == GND_IDENT) { bname = u.name; bline = u.line; bcol = u.col; }
                    } else if (bad.kind == GND_IDENT) {
                        bname = bad.name;
                        bline = bad.line;
                        bcol = bad.col;
                    }
                    this.fail("AddressTypeMistmatchException", bline, bcol, bname, "address arithmetic is not allowed");
                }
            }
            // Operand-kind check: `+` concatenates when either side is a
            // string, but the remaining arithmetic and bitwise operators
            // have no string meaning — they would compute on the pointer
            // bits. Only a provably-string operand is rejected.
            if (op == GOP_SUB || op == GOP_MUL || op == GOP_DIV || op == GOP_MOD
                || op == GOP_SHL || op == GOP_SHR || op == GOP_BIT_AND || op == GOP_BIT_OR || op == GOP_BIT_XOR) {
                if (this.inferStaticType(n.child(0)) == "string" || this.inferStaticType(n.child(1)) == "string") {
                    this.fail("TypeMismatch", n.line, n.col, "", "expected a numeric operand, found a string");
                }
            }
            // Membership collection check: `x in collection` scans an
            // array (the loop mirrors array indexOf); a provably-scalar
            // right operand (a number, bool, or string variable) cannot be
            // a collection. Untyped collections are never judged.
            if (op == 37) {
                string mct = this.inferStaticType(n.child(1));
                if (mct.length > 0 && mct != "var" && !mct.endsWith("[]")) {
                    this.fail("TypeMismatch", n.line, n.col, "", "expected an array, found " + this.gArticle(this.typeDisplayName(mct)));
                }
            }
            // Inc/dec on a member target is a member store too
            // (`obj.field++` is `obj.field = obj.field + 1`): the same
            // read-only prop rule applies.
            if (op == GOP_POST_INC || op == GOP_POST_DEC) {
                Node lt = n.child(0);
                if (lt.kind == GND_MEMBER) {
                    this.checkMemberStore(lt.child(0), lt.name, lt);
                }
            }
            return 0;
        }
        if (k == GND_UNARY) { this.checkExpr(n.child(0)); return 0; }
        if (k == GND_CALL) {
            for (int i = 0; i < n.childCount(); i++) { this.checkExpr(n.child(i)); }
            // Argument-level nullable checking (flow null-state check): free
            // calls to known user functions only — member calls stay
            // silent (their receiver types are not tracked).
            if (!n.isMember) { this.checkCallArgs(n); }
            return 0;
        }
        if (k == GND_MEMBER) {
            // Variant-reference check: `EnumName.Variant` on a known enum
            // must name a declared variant (covers expression references
            // and switch case values, which are exprs). A same-named class
            // or struct shadows the enum and is never judged.
            if (n.childCount() > 0 && n.child(0).kind == GND_IDENT) {
                this.checkEnumVariantRef(n.child(0).name, n.name, n);
            }
            this.checkExpr(n.child(0));
            return 0;
        }
        if (k == GND_INDEX) {
            this.checkExpr(n.child(0));
            this.checkExpr(n.child(1));
            // Integral-index check: an array element or string char is
            // addressed by an integer. Dict lookups (dict-typed or
            // untyped receivers) take any key shape and are never judged.
            string at = this.inferStaticType(n.child(0));
            if (at == "string" || at.endsWith("[]")) {
                string it = this.inferStaticType(n.child(1));
                if (it == "string" || it == "bool" || it == "float" || it == "float64" || it == "double") {
                    this.fail("TypeMismatch", n.line, n.col, "", "expected an int index, found " + this.gArticle(this.typeDisplayName(it)));
                }
            }
            return 0;
        }
        if (k == GND_SLICE) {
            for (int i = 0; i < n.childCount(); i++) { this.checkExpr(n.child(i)); }
            return 0;
        }
        if (k == GND_NEW_INIT) {
            // Object-initializer stores: children are [ctor args..., init
            // pairs (kind 18: field ident, value)]. A read-only prop takes
            // no initializer store; duplicate fields were rejected at
            // parse time.
            string clsName = this.lastDottedSegment(n.name);
            for (int i = 0; i < n.childCount(); i++) {
                Node c = n.child(i);
                if (c.kind == GND_DICT_PAIR && c.childCount() >= 2) {
                    Node fld = c.child(0);
                    if (fld.kind == GND_IDENT && this.classFieldReadOnly(clsName, fld.name)) {
                        this.fail("ReadOnlyPropAssignment", fld.line, fld.col, fld.name, "cannot assign to read-only prop '" + clsName + "." + fld.name + "'");
                    }
                    this.checkExpr(c.child(1));
                } else {
                    this.checkExpr(c);
                }
            }
            return 0;
        }
        if (k == GND_PAREN) { this.checkExpr(n.child(0)); return 0; }
        if (k == GND_ARRAY_LIT || k == GND_TUPLE_LIT || k == GND_INTERP || k == GND_STRUCT_DEF) {
            for (int i = 0; i < n.childCount(); i++) { this.checkExpr(n.child(i)); }
            return 0;
        }
        if (k == GND_DICT_LIT) {
            // Duplicate literal keys (warning grade): the earlier entry's
            // value is overwritten by the later store. Computed keys are
            // undecidable and stay silent.
            string[] seenKeys = [];
            for (int i = 0; i < n.childCount(); i++) {
                Node pair = n.child(i);
                if (pair.kind != GND_DICT_PAIR || pair.childCount() < 2) { continue; }
                Node key = pair.child(0);
                string ck = this.caseValueKey(key);
                if (ck.length == 0) { continue; }
                if (seenKeys.contains(ck)) {
                    this.warnings.add("duplicate dict key '" + this.caseValueRender(key) + "': the earlier value is overwritten at line " + (string)key.line + ", column " + (string)key.col);
                } else {
                    seenKeys.add(ck);
                }
            }
            for (int i = 0; i < n.childCount(); i++) { this.checkExpr(n.child(i)); }
            return 0;
        }
        if (k == GND_DICT_PAIR) {
            this.checkExpr(n.child(0));
            this.checkExpr(n.child(1));
            return 0;
        }
        if (k == GND_ADDRESS_OF) { return this.checkAddr(n); }
        if (k == 75) {
            // Nullable-conditional ?. provides its own null check, so the
            // receiver is safely unwrapped during the member access.
            this.unwrapDepth++;
            this.checkExpr(n.child(0));
            this.unwrapDepth--;
            return 0;
        }
        if (k == 77) {
            // Spread element `...arr`: the source array is read normally.
            this.checkExpr(n.child(0));
            return 0;
        }
        if (k == GND_MATCH_EXPR) {
            this.checkExpr(n.child(0));
            this.checkEnumExhaustiveMatch(n);
            this.checkMatchPatternVariants(n);
            // Join-point merge (null-state-flow Meet): every non-terminal
            // arm's exit state must agree; without a wildcard arm the
            // no-match fall-through joins with the pre-match state. Each
            // arm is isolated to the pre-match facts so arm-local facts do
            // not leak into a sibling.
            string[] savedNN = this.snapshotNonNull();
            string[] joined = [];
            bool haveJoin = false;
            bool hasWildcard = false;
            for (int i = 1; i < n.childCount(); i++) {
                Node arm = n.child(i);
                if (arm.kind != GND_MATCH_ARM || arm.childCount() < 2) { continue; }
                Node pat = arm.child(0);
                if (pat.kind == 0 && pat.name == "_") { hasWildcard = true; }
                this.nonNullNames = savedNN;
                // A guarded arm carries its when-clause as child(1); the
                // body is always the last child.
                if (arm.childCount() >= 3) { this.checkExpr(arm.child(1)); }
                Node body = arm.child(arm.childCount() - 1);
                this.checkMatchBody(body);
                if (!(body.kind == GND_BLOCK && this.stmtListIsTerminal(body))) {
                    string[] armNN = this.snapshotNonNull();
                    if (!haveJoin) { joined = armNN; haveJoin = true; } else { joined = this.meetNonNull(joined, armNN); }
                }
            }
            if (!hasWildcard) {
                if (!haveJoin) { joined = savedNN; haveJoin = true; } else { joined = this.meetNonNull(joined, savedNN); }
            }
            if (haveJoin) { this.nonNullNames = joined; }
            return 0;
        }
        if (k == GND_LAMBDA) {
            // A lambda body belongs to its own generated function: a
            // `return` inside it must not validate against the enclosing
            // function's return type, and its parameters are fresh locals.
            // Null-state isolation: outer facts stay visible (the
            // generated function may share global names), but facts set
            // inside the lambda body die with it. Loop-scope isolation: a
            // generated function cannot target an enclosing loop, so its
            // loop scope starts empty.
            string[] savedNN = this.snapshotNonNull();
            string savedReturnType = this.currentReturnType;
            int savedLoopDepth = this.loopDepth;
            this.currentReturnType = "";
            this.loopDepth = 0;
            this.pushScope();
            for (int li = 0; li < n.childCount() - 1; li++) {
                Node lp = n.child(li);
                if (lp.kind == GND_IDENT) {
                    this.declareVar(lp.name, "var", true, true, false, false, false, false, lp.line, lp.col);
                }
            }
            if (n.childCount() > 0) {
                Node lbody = n.child(n.childCount() - 1);
                if (lbody.kind == GND_BLOCK) {
                    // A braced lambda body is a statement list: its
                    // statements take the statement path (loop scope,
                    // flow facts) exactly like a named function body — and
                    // share the lambda's parameter scope (no second block
                    // level), like one too.
                    this.checkStmtList(lbody);
                } else {
                    this.checkExpr(lbody);
                }
            }
            this.popScope();
            this.nonNullNames = savedNN;
            this.loopDepth = savedLoopDepth;
            this.currentReturnType = savedReturnType;
            return 0;
        }
        if (k == GND_TERNARY) {
            // `x != null ? x + 1 : 0` narrows the branches like an if/else:
            // the true branch sees the condition's true-facts, the false
            // branch its false-facts. Join: the ternary completes via
            // either branch, so a fact survives only when both branch
            // exits hold it.
            this.checkExpr(n.child(0));
            string[] savedNN = this.snapshotNonNull();
            string[] thenNarrowed = [];
            string[] elseNarrowed = [];
            this.collectNarrowings(n.child(0), true, thenNarrowed);
            this.collectNarrowings(n.child(0), false, elseNarrowed);
            this.addNarrowings(thenNarrowed);
            this.checkExpr(n.child(1));
            string[] thenNN = this.snapshotNonNull();
            this.nonNullNames = savedNN;
            this.addNarrowings(elseNarrowed);
            this.checkExpr(n.child(2));
            string[] elseNN = this.snapshotNonNull();
            this.nonNullNames = this.meetNonNull(thenNN, elseNN);
            return 0;
        }
        // Unhandled shapes (indirect `fn[i]()` calls, anonymous function
        // bodies, struct literals, ...): still walk the children so every
        // identifier read is seen — the never-used report must not miss a
        // use and false-warn.
        for (int i = 0; i < n.childCount(); i++) { this.checkExpr(n.child(i)); }
        return 0;
    }

    private void checkStmt(Node n) {
        int k = n.kind;
        if (k == GND_BLOCK) { this.checkBlock(n); return; }
        if (k == GND_VAR_DECL) { this.checkVarDecl(n); return; }
        if (k == GND_ALIAS_DECL) { this.checkAlias(n); return; }
        if (k == GND_RETURN || k == GND_RETURN_SHORT) {
            if (n.childCount() > 0) {
                this.checkExpr(n.child(0));
                this.checkReturnValue(n.child(0), n);
            }
            return;
        }
        if (k == GND_IF_STMT) { this.checkIf(n); return; }
        if (k == GND_WHILE) { this.checkWhile(n); return; }
        if (k == GND_FOR_C) { this.checkFor(n); return; }
        if (k == GND_FOREACH) { this.checkForeach(n); return; }
        if (k == GND_TRY_CATCH) { this.checkTryCatch(n); return; }
        if (k == GND_SWITCH) { this.checkSwitch(n); return; }
        if (k == GND_UNSET) { this.checkUnset(n); return; }
        if (k == GND_DESTRUCTURE) { this.checkDestructure(n); return; }
        if (k == GND_BREAK) {
            // Loop-scope tracking: with no enclosing loop the statement is
            // a silent no-op in the emitted code.
            if (this.loopDepth == 0) {
                this.fail("LoopControlOutsideLoop", n.line, n.col, "", "break outside a loop");
            }
            return;
        }
        if (k == GND_CONTINUE) {
            if (this.loopDepth == 0) {
                this.fail("LoopControlOutsideLoop", n.line, n.col, "", "continue outside a loop");
            }
            return;
        }
        if (k == GND_THROW) {
            for (int i = 0; i < n.childCount(); i++) { this.checkExpr(n.child(i)); }
            return;
        }
        if (k == GND_EXPR_STMT) {
            if (n.childCount() > 0) { this.checkExpr(n.child(0)); }
            return;
        }
    }

    // Class-body flow checking: the class's flattened fields (own plus
    // inherited, first-listed winning) are declared in an enclosing scope so
    // the this-less member idiom resolves — a bare identifier naming a field
    // IS the field, for reads and assignment targets alike. Each method then
    // checks exactly like a standalone function, with its parameters and
    // locals shadowing same-named fields.
    private void checkClass(Node n) {
        // Duplicate own members: two fields of the same name in one class
        // would share one storage slot; the first-listed one wins and the
        // second is a mistake. (Inherited same-named fields are legal per
        // the first-listed layout rule, so only same-class collisions are
        // judged.)
        for (int a = 0; a < n.childCount(); a++) {
            Node fa = n.child(a);
            if (fa.kind != GND_VAR_DECL) { continue; }
            for (int b = a + 1; b < n.childCount(); b++) {
                Node fb = n.child(b);
                if (fb.kind == GND_VAR_DECL && fb.name == fa.name) {
                    this.fail("DuplicateDefinition", fb.line, fb.col, fb.name, "duplicate field '" + fb.name + "' of class '" + n.name + "'");
                }
            }
        }
        string savedClass = this.currentClass;
        this.currentClass = n.name;
        this.pushScope();
        // Own fields first (they win over inherited same-named slots), then
        // the ancestors'. Fields start initialized: an instance exists only
        // after its constructor laid the slots out.
        GuardField[] flat = this.classFieldList(n.name);
        for (int f = 0; f < flat.length; f++) {
            GuardField gf = flat[f];
            this.declareVar(gf.name, gf.typeHint, true, true, false, false, gf.typeHint.endsWith("?"), false, gf.line, gf.col);
        }
        for (int j = 0; j < n.childCount(); j++) {
            Node m = n.child(j);
            if (m.kind == GND_FUNC) { this.checkFunction(m, true); }
        }
        this.popScope();
        this.currentClass = savedClass;
    }

    // Duplicate variants inside one enum: the second spelling would answer
    // as the first at run time, so it is a duplicate declaration.
    private void checkEnumDef(Node n) {
        for (int a = 0; a < n.childCount(); a++) {
            Node va = n.child(a);
            if (va.kind != 106) { continue; }
            for (int b = a + 1; b < n.childCount(); b++) {
                Node vb = n.child(b);
                if (vb.kind == 106 && vb.name == va.name) {
                    this.fail("DuplicateDefinition", n.line, n.col, vb.name, "duplicate variant '" + vb.name + "' of enum '" + n.name + "'");
                }
            }
        }
    }


    // Deep-check one function body. `inClass` marks a class method: the
    // class's flattened fields stay in scope as an enclosing binding level
    // (the this-less member idiom resolves bare identifiers to fields), so
    // the local state is not reset — the method's own bindings get a fresh
    // scope above them instead. A function's parameters and body share one
    // scope level: a body local of the same name as a parameter redeclares
    // it, not shadows it (parameters and locals share the frame).
    private void checkFunction(Node n, bool inClass) {
        if (inClass) {
            this.pushScope();
        } else {
            this.vars = [];
            this.scopeEnds = [];
            this.pushScope();
        }
        this.nonNullNames = [];
        this.unwrapDepth = 0;
        // Assigned-but-never-used tracking is fresh per function
        // (per-method definite-assignment state): candidates and uses from one
        // body must not bleed into the next.
        this.candNames = [];
        this.candLines = [];
        this.candCols = [];
        this.usedNames = [];
        this.suppressedNames = [];
        bool savedTracking = this.unusedTracking;
        this.unusedTracking = true;
        string savedReturnType = this.currentReturnType;
        this.currentReturnType = n.typeHint;
        Node params = n.child(0);
        for (int i = 0; i < params.childCount(); i++) {
            Node p = params.child(i);
            this.declareVar(p.name, p.typeHint, true, true, false, false, p.typeHint.endsWith("?"), false, p.line, p.col);
        }
        if (n.childCount() >= 2) {
            Node body = n.child(1);
            if (body.kind == GND_BLOCK) {
                // The body's statements live in the parameter scope (no
                // second block level): checkStmtList, not checkBlock.
                this.checkStmtList(body);
            } else {
                // One-line `<< body` function: the expression IS the return
                // value, coerced against the declared return type.
                this.checkExpr(body);
                this.checkReturnValue(body, body);
            }
        }
        this.currentReturnType = savedReturnType;
        // Assigned-but-never-used report (write/read tracking):
        // declaration candidates never read on any path of this function.
        // Warning grade — it never fails the compile.
        this.reportUnusedLocals();
        this.unusedTracking = savedTracking;
        // Missing-return analysis ("not all code paths return a value"
        // concept, MEMORY_GUARD totality check): a function declaring a
        // value return type must return on every path; falling off the end
        // of the body would hand the caller an undefined value. `void`
        // functions (and inference-agnostic `var`) may fall off freely;
        // unknown legacy type names are not judged. A builtin `exit(...)`
        // expression statement never returns (the process ends), so a body
        // whose last action is one completes every path — only the builtin
        // counts; a user-declared `exit` function is an ordinary call.
        if (this.judgedReturnType(n.typeHint)) {
            if (n.childCount() >= 2) {
                Node body = n.child(1);
                if (body.kind == GND_BLOCK && body.childCount() > 0 && !this.stmtListIsTerminalCtx(body)) {
                    this.fail("MissingReturn", n.line, n.col, n.name, "function declaring return type '" + n.typeHint + "' can fall off the end without returning (missing return statement)");
                }
            }
        }
        this.popScope();
    }

    private void checkConst(Node n) {
        if (n.childCount() == 0) {
            this.fail("UnassignedConstDeclarationException", n.line, n.col, n.name, "const must be declared with a value");
        }
    }

    // Import statements share node kind 105 with enum declarations (the
    // parser mints both): an import carries a `from` source in typeHint,
    // the `*` marker, or no children at all, while a real enum carries its
    // variant members as children. The same discriminator the codegen
    // import registrar uses — a misread import would register its module
    // name as a phantom enum and poison variant checks for its members.
    private bool nodeIsImport(Node n) {
        if (n.kind != GND_ENUM_DEF) { return false; }
        return n.typeHint.length > 0 || n.isStatic || n.childCount() == 0;
    }

    private void checkTop(Node n) {
        if (n.kind == GND_FUNC) {
            this.checkFunction(n, false);
        } else if (n.kind == GND_CONST) {
            this.checkConst(n);
        } else if (n.kind == GND_CLASS_DEF) {
            this.checkClass(n);
        } else if (n.kind == GND_ENUM_DEF && !this.nodeIsImport(n)) {
            this.checkEnumDef(n);
        } else if (n.kind == GND_VAR_DECL) {
            this.checkVarDecl(n);
        } else if (n.kind == GND_ALIAS_DECL) {
            this.checkAlias(n);
        } else if (n.kind == GND_BLOCK || n.kind == GND_EXPR_STMT || n.kind == GND_IF_STMT || n.kind == GND_WHILE
            || n.kind == GND_FOR_C || n.kind == GND_FOREACH || n.kind == GND_TRY_CATCH
            || n.kind == GND_UNSET || n.kind == GND_THROW || n.kind == GND_DESTRUCTURE) {
            this.checkStmt(n);
        }
    }

    public void checkProgram(Node[] program) {
        this.warnings = [];
        this.typeNames = [];
        this.currentReturnType = "";
        this.currentClass = "";
        this.loopDepth = 0;
        this.enumNames = [];
        this.enumStarts = [];
        this.enumCounts = [];
        this.enumVariantNames = [];
        this.funcSigNames = [];
        this.funcSigStarts = [];
        this.funcSigCounts = [];
        this.funcSigParamTypes = [];
        this.funcSigParamNames = [];
        this.classNames = [];
        this.classNodes = [];
        this.funcSigNodes = [];
        for (int i = 0; i < program.length; i++) {
            Node n = program[i];
            if (n.kind == GND_CONST) {
                this.globalNames.add(n.name);
            } else if (n.kind == GND_CLASS_DEF) {
                this.typeNames.add(n.name);
                // Class table (class-body flow checking + member-store
                // resolution): every class declaration, for flattened field
                // lookups.
                this.classNames.add(n.name);
                this.classNodes.add(n);
                for (int j = 0; j < n.childCount(); j++) {
                    Node m = n.child(j);
                    if (m.kind == GND_CONST) { this.globalNames.add(m.name); }
                }
            } else if (n.kind == GND_VAR_DECL) {
                this.globalNames.add(n.name);
            } else if (n.kind == GND_STRUCT_DEF || n.kind == GND_ENUM_DEF || n.kind == GND_DEF || n.kind == GND_TYPE_ALIAS) {
                if (this.nodeIsImport(n)) { continue; }
                // Known user type names: class/struct/enum/def/typealias
                // declarations. A bare unknown return-type spelling is not a
                // Silver value type, so missing-return does not judge it.
                this.typeNames.add(n.name);
                // Structs join the class table too: their fields take the
                // same member-store read-only resolution (a method-bearing
                // struct arrives already promoted to a class).
                if (n.kind == GND_STRUCT_DEF) {
                    this.classNames.add(n.name);
                    this.classNodes.add(n);
                }
            }
            // Enum variant table (exhaustiveness coverage): variants hang
            // off the declaration's kind-106 children. Kind-105 import
            // statements never join (nodeIsImport).
            if (n.kind == GND_ENUM_DEF && !this.nodeIsImport(n)) {
                this.enumNames.add(n.name);
                this.enumStarts.add(this.enumVariantNames.length);
                int cnt = 0;
                for (int j = 0; j < n.childCount(); j++) {
                    Node m = n.child(j);
                    if (m.kind == 106) { this.enumVariantNames.add(m.name); cnt++; }
                }
                this.enumCounts.add(cnt);
            }
            // Free-function signature table (argument-type
            // analysis): top-level functions only — member calls never
            // resolve against it and stay silent. The declaration node
            // rides along for the null-tolerance body inspection.
            if (n.kind == GND_FUNC) {
                this.funcSigNames.add(n.name);
                this.funcSigStarts.add(this.funcSigParamTypes.length);
                Node ps = n.child(0);
                for (int j = 0; j < ps.childCount(); j++) {
                    Node p = ps.child(j);
                    this.funcSigParamTypes.add(p.typeHint);
                    this.funcSigParamNames.add(p.name);
                }
                this.funcSigCounts.add(ps.childCount());
                this.funcSigNodes.add(n);
            }
        }
        for (int i = 0; i < program.length; i++) {
            this.checkTop(program[i]);
        }
    }
}
