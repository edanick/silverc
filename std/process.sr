mod export process;

// DOCS -- public `process` module (UNIFIED_CORE_LIBRARY.md §4). This is the
// universal process module -- one module, one OS layer
// (process -> win32.user32 + win32.kernel32).
//
// SHAPE (UNIFIED_CORE_LIBRARY.md §4 rule 6): the raw OS calls live INSIDE the
// public function bodies (Process.getFocusedProcess, run, pipe.write/read)
// behind `#on WINDOWS` regions -- one unified function name, no
// win-prefixed helpers, no wrapper indirection. OS selection is compile-time
// via the preprocessor; the module does not use the runtime `os` check. No
// #else and no LINUX/MAC placeholders -- the other-OS regions get filled on
// their own machines later. For a future non-Windows backend the fallbacks
// follow the module's failure style: getFocusedProcess() returns an
// all-zero/empty Process, run() returns the zero result, pipe.read()
// returns "" and pipe.write() is a silent no-op.
//
// NOT gated on purpose (no DLL behind them): the `result`, `ProcessWindow`
// and `Process` class declarations and constructors, pipe's declarations and
// its flush() stub (no-op body).
//
// PLAIN IMPORTS: user32 + kernel32 are granted through plain full-table
// `import * from win32.<dll>;` regions -- no alias imports. All ten exports
// the module needs are present in BOTH compilers' tables
// (silverc-rs/src/win32.rs and the self-host win32ExportTable):
// GetForegroundWindow/GetWindowTextA/GetWindowThreadProcessId on user32;
// OpenProcess/QueryFullProcessImageNameA/CloseHandle/CreatePipe/
// CreateProcessA/ReadFile/WriteFile on kernel32. On silverc-rs the five
// foreground-process names route through the pre-existing bare-name
// sentinel intercept (codegen.rs -> stdlib::process::gen_process_call,
// runtime-patched to the same DLL exports), CloseHandle/CreatePipe/
// CreateProcessA/ReadFile/WriteFile through the dynamic IAT import path --
// the same DLL calls.
//
// BUFFER IDIOM (cross-compiler proven): NUL-terminated Win32 string data
// (window title, process image path, pipe bytes) uses preallocated writable
// string buffers -- strings lower to dense char buffers on every backend, so
// an index reads one raw byte and a bare call passes the char pointer
// straight across the boundary. Decode loops compare against char(0), never
// the '\0' literal -- BOTH compilers' lexers resolve that escape to the
// digit character '0' (0x30). Struct-free by design: this module needs no
// int[] qword-slot buffers because none of its calls take a struct (run
// passes null for both STARTUPINFO and PROCESS_INFORMATION, see run).
//
// MECHANICS (probed):
// - Process.getFocusedProcess(): null foreground HWND leaves the whole
//   Process zero/empty; OpenProcess failure or a failed image-name query
//   leaves path/filename empty while handle/title/id stay set. The process
//   handle closes right after the query, before the ok check. The filename
//   slash-scan is pure Silver.
// - run(): the CreatePipe/CreateProcessA call shape passes null for every
//   optional argument, including lpProcessInformation -- CreateProcessA
//   requires a real PROCESS_INFORMATION pointer to write, so the call faults
//   the process (0xC0000005) on the self-hosted compiler on success AND
//   failure paths (probed: exit code -1073741819 with a breadcrumb after the
//   call never reached). This is documented behavior, not a regression --
//   the API never returns on any compiler (the failure path crashes before
//   returning, and silverc-rs users cannot even declare the lowercase
//   `result` type outside the module: rs statement parsing only accepts
//   lowercase type names declared in the same file). The spawn-failure
//   result ({exitCode = -1, stderr = "Failed to create process"}) is
//   produced directly on the created == 0 branch.
// - pipe: a dead class -- its handles are private with an empty constructor
//   and no binding API, so write()/read() operate on unbound handles
//   (probed: WriteFile/ReadFile fail on the zero handle, read() returns "").
//   The string crosses the boundary straight from its dense char buffer
//   (the documented string-buffer idiom; same bytes as a byte[] conversion).
//
// LINUX BACKEND (Phase B): fork/execvpe/waitpid + pipe/dup2/read/close from
// linux.libc inside run()'s body, mirroring the WINDOWS pipe/spawn/drain
// shape. The child argv is a Silver string[] with an explicit null
// terminator (argv.add(null)); envp rides null (empty child environment).
// pipe()'s two 32-bit fds unpack from slot 0 (fds[0] low = read end, high
// = write end -- pipe(2) writes ints, not Silver slots). The exit status
// unpacks as (st >> 8) & 0xFF. Unlike the faulting CreateProcessA ladder,
// a missing executable exits the child with 127 and run() returns that
// code with empty stdout instead of faulting. getFocusedProcess() keeps
// the documented all-zero fallback on Linux (no display-server query in
// the libc backend); the pipe class keeps its dead posture (write() is an
// empty no-op and read() returns "" there -- no region needed, matching
// the Windows no-backend stubs per LINUX.md headless rules).
//
// MAC BACKEND (Phase B, code-only -- MAC.md section 10, UNVALIDATED until
// probed on Mac hardware): posix_spawn + waitpid + pipe/read/close from
// mac.libsystem -- NEVER bare fork (fork without exec is deprecated/unsafe
// on macOS: the ObjC runtime is not fork-safe; posix_spawn/posix_spawnp is
// the supported ladder, kill for terminate, pipe for redirection). The
// child's stdout is captured through a posix_spawn file-actions object
// (init + adddup2(pipe-write, 1) + destroy around the spawn); argv carries
// cmd first with an explicit null terminator, envp rides null. A failed
// spawn returns the same zero result the WINDOWS created == 0 branch
// produces (exitCode -1, "Failed to create process"). getFocusedProcess()
// keeps the documented all-zero fallback on macOS (no WindowServer query
// in the libSystem backend); the pipe class keeps its dead posture there
// too (no region needed, matching the Windows/Linux stubs).
//
// DISPATCH NOTE (per compiler, probed): on
// silverc-rs every `Process.getFocusedProcess()` / `process.getFocusedProcess()`
// call is intercepted BEFORE this source body and emitted natively
// (codegen.rs routes both spellings to stdlib::process::gen_focused_process,
// whose object layout contract -- path, filename, id, window -- the class
// below implements exactly), so the static body below is dead code there;
// the self-hosted compiler has no such intercept and executes it. The
// self-hosted driver hand-prepends this file into standalone compiles when
// the user source imports "process" (compiler_driver.sr), and excludes the
// name from disk collection so the prepend never duplicates. Bare
// `run(...)` / `pipe` / `result` calls resolve to this module's globals on
// both compilers -- although on silverc-rs a user file cannot DECLARE a
// lowercase `result`/`pipe` typed variable (rs statement parsing only
// accepts lowercase type names declared in the same file), so the rs
// surface is effectively Process.getFocusedProcess plus the native
// bare-win32 sentinel path.

#on WINDOWS
import * from win32.user32;
import * from win32.kernel32;
#on LINUX
import * from linux.libc;
#on MAC
import * from mac.libsystem;
#off

class result {
    public string stdout;
    public string stderr;
    public int exitCode;
}

class ProcessWindow {
    public int handle;
    public string title;

    construct {
        this.handle = 0;
        this.title = "";
    }
}

class Process {
    public string path;
    public string filename;
    public int id;
    public ProcessWindow window;

    construct {
        this.path = "";
        this.filename = "";
        this.id = 0;
        this.window = new ProcessWindow();
    }

    // Body shape: null foreground HWND leaves the whole Process zero/empty;
    // a failed OpenProcess or image-name query leaves path/filename empty
    // while handle/title/id stay set. The filename slash-scan is pure Silver
    // and stays UNGATED below the region (§4 rule 6); the raw ladder and the
    // buffer decodes tangled with it live in the region.
    public static Process getFocusedProcess() {
        Process result = new Process();
        string fullPath = "";
        #on WINDOWS
        int hwnd = GetForegroundWindow();
        if (hwnd != 0) {
            result.window.handle = hwnd;
            // Writable 512-space title buffer; GetWindowTextA returns the
            // copied length (excluding the NUL it writes), so the decode
            // loop bounds on len and stops at char(0) for safety.
            string titleBuf = "";
            for (int i = 0; i < 512; i++) { titleBuf += " "; }
            int titleLen = GetWindowTextA(hwnd, titleBuf, 512);
            string title = "";
            for (int i = 0; i < titleLen && titleBuf[i] != char(0); i++) { title += char(titleBuf[i]); }
            result.window.title = title;
            int pid = 0;
            GetWindowThreadProcessId(hwnd, &pid);
            result.id = pid;
            int hProcess = OpenProcess(0x1000, 0, pid);
            if (hProcess != 0) {
                // Writable 1024-space path buffer; the length in/out is the
                // int len = 1024 pattern. The process handle closes right
                // after the query, before the ok check.
                string pathBuf = "";
                for (int i = 0; i < 1024; i++) { pathBuf += " "; }
                int len = 1024;
                int ok = QueryFullProcessImageNameA(hProcess, 0, pathBuf, &len);
                CloseHandle(hProcess);
                if (ok != 0) {
                    for (int i = 0; i < len && pathBuf[i] != char(0); i++) { fullPath += char(pathBuf[i]); }
                }
            }
        }
        #off
        result.path = fullPath;
        int lastSlash = -1;
        for (int i = 0; i < fullPath.length; i++) {
            if (fullPath[i] == '\\' || fullPath[i] == '/') { lastSlash = i; }
        }
        if (lastSlash >= 0) {
            result.filename = fullPath[lastSlash + 1..fullPath.length];
        } else {
            result.filename = fullPath;
        }
        return result;
    }
}

class pipe {
    private int hRead;
    private int hWrite;


    public void write(string data) {
        #on WINDOWS
        // Unbound-handle write (dead class, see header): WriteFile fails on
        // the zero handle. The string crosses the boundary as its dense
        // char buffer -- one 8-byte slot per Silver string.
        WriteFile(this.hWrite, data, data.length, null, null);
        #off
    }

    public void flush() { }

    public string read() {
        string out = "";
        #on WINDOWS
        // Unbound-handle read (dead class, see header): a 4096-space buffer
        // and byte-wise decode; ReadFile fails on the zero handle so n
        // stays 0 and "" is returned.
        string buf = "";
        for (int i = 0; i < 4096; i++) { buf += " "; }
        int n = 0;
        ReadFile(this.hRead, buf, 4096, &n, null);
        if (n > 0) {
            for (int i = 0; i < n; i++) { out += char(buf[i]); }
        }
        #off
        return out;
    }
}

public result run(string cmd, string[] args) {
    result res = new result();
    #on WINDOWS
    string fullCmd = cmd;
    for (int i = 0; i < args.length; i++) { fullCmd += " " + args[i]; }
    // CreatePipe defaults, bInheritHandles = 1, and the null-heavy
    // CreateProcessA argument list pass null for every optional argument,
    // including lpProcessInformation -- see the header for the
    // fault-on-every-path consequence. On both branches the pipe handles
    // close before run() returns.
    int hReadOut = 0;
    int hWriteOut = 0;
    CreatePipe(&hReadOut, &hWriteOut, null, 0);
    int created = CreateProcessA(null, fullCmd, null, null, 1, 0, null, null, null, null);
    if (created == 0) {
        CloseHandle(hWriteOut);
        CloseHandle(hReadOut);
        res.exitCode = -1;
        res.stderr = "Failed to create process";
    } else {
        string outBuf = "";
        for (int i = 0; i < 8192; i++) { outBuf += " "; }
        int n = 0;
        string output = "";
        while (ReadFile(hReadOut, outBuf, 8192, &n, null) && n > 0) {
            for (int i = 0; i < n; i++) { output += char(outBuf[i]); }
        }
        CloseHandle(hWriteOut);
        CloseHandle(hReadOut);
        res.stdout = output;
        res.exitCode = 0;
    }
    #on LINUX
    // pipe() + fork() + execvpe() + drain + waitpid(): the same
    // spawn-a-child-and-capture-stdout shape as the WINDOWS ladder. The
    // child's argv carries cmd first (no fullCmd join needed); a failed
    // exec exits 127 instead of faulting the parent.
    int[] fds = new int[2];
    pipe(fds);
    int fr = fds[0] & 0xFFFFFFFF;
    int fw = (fds[0] >> 32) & 0xFFFFFFFF;
    int pid = fork();
    if (pid < 0) {
        close(fr);
        close(fw);
        res.exitCode = -1;
        res.stderr = "Failed to create process";
    } else if (pid == 0) {
        close(fr);
        dup2(fw, 1);
        close(fw);
        string[] argv = [];
        argv.add(cmd);
        for (int i = 0; i < args.length; i++) { argv.add(args[i]); }
        argv.add(null);
        execvpe(cmd, argv, null);
        _exit(127);
    } else {
        close(fw);
        int[] chunk = new int[1024];
        string output = "";
        while (true) {
            int n = read(fr, chunk, 8192);
            if (n <= 0) { break; }
            for (int i = 0; i < n; i++) {
                int b = (chunk[i / 8] >> ((i % 8) * 8)) & 0xFF;
                output += char(b);
            }
        }
        close(fr);
        int st = 0;
        waitpid(pid, &st, 0);
        res.stdout = output;
        res.exitCode = (st >> 8) & 0xFF;
    }
    #on MAC
    // posix_spawn() + drain + waitpid(): the same spawn-a-child-and-
    // capture-stdout shape as the ladders above (fork is deprecated on
    // macOS, so there is no fork/exec branch here). The child's stdout is
    // wired to the pipe through a file-actions object; a failed spawn
    // returns the created == 0 zero result instead of faulting.
    int[] fds = new int[2];
    pipe(fds);
    int fr = fds[0] & 0xFFFFFFFF;
    int fw = (fds[0] >> 32) & 0xFFFFFFFF;
    int actions = 0;
    posix_spawn_file_actions_init(&actions);
    posix_spawn_file_actions_adddup2(&actions, fw, 1);
    string[] argv = [];
    argv.add(cmd);
    for (int i = 0; i < args.length; i++) { argv.add(args[i]); }
    argv.add(null);
    int pid = 0;
    int rc = posix_spawn(&pid, cmd, actions, null, argv, null);
    posix_spawn_file_actions_destroy(&actions);
    close(fw);
    if (rc != 0) {
        close(fr);
        res.exitCode = -1;
        res.stderr = "Failed to create process";
    } else {
        int[] chunk = new int[1024];
        string output = "";
        while (true) {
            int n = read(fr, chunk, 8192);
            if (n <= 0) { break; }
            for (int i = 0; i < n; i++) {
                int b = (chunk[i / 8] >> ((i % 8) * 8)) & 0xFF;
                output += char(b);
            }
        }
        close(fr);
        int st = 0;
        waitpid(pid, &st, 0);
        res.stdout = output;
        res.exitCode = (st >> 8) & 0xFF;
    }
    #off
    return res;
}
