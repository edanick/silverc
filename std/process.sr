mod export process;

class result {
    public string stdout;
    public string stderr;
    public int exitCode;
}

class process {
    private int hProcess;
    private int hStdin;
    private int hStdout;

    construct() { }

    public pipe stdin;
    public pipe stdout;
    public pipe stderr;

    public void wait() {
        WaitForSingleObject(this.hProcess, -1);
    }
}

class pipe {
    private int hRead;
    private int hWrite;

    construct() { }

    public void write(string data) {
        byte[] bytes = data.toBytes();
        WriteFile(this.hWrite, bytes, bytes.length, null, null);
    }

    public void flush() { }

    public string read() {
        byte[] buf[4096];
        int n = 0;
        ReadFile(this.hRead, buf, 4096, &n, null);
        if (n <= 0) { return ""; }
        string result = "";
        for (int i = 0; i < n; i++) { result += char(buf[i]); }
        return result;
    }

    public void onStdout(void callback(string line)) { }
}

public result run(string cmd, string[] args) {
    return run(cmd, args, null);
}

public result run(string cmd, string[] args, object opts) {
    string fullCmd = cmd;
    foreach (string a in args) {
        fullCmd += " " + a;
    }

    string stdinData = "";
    if (opts != null) {
        stdinData = opts.stdin;
    }

    int hReadOut, hWriteOut;
    CreatePipe(&hReadOut, &hWriteOut, null, 0);
    int hReadIn, hWriteIn;
    CreatePipe(&hReadIn, &hWriteIn, null, 0);

    PROCESS_INFORMATION pi;
    STARTUPINFO si;
    si.cb = 68;
    si.dwFlags = 0x100;
    si.hStdOutput = hWriteOut;
    si.hStdError = hWriteOut;
    si.hStdInput = hReadIn;

    int created = CreateProcess(null, fullCmd, null, null, 1, 0, null, null, &si, &pi);
    if (!created) {
        result r = new result();
        r.exitCode = -1;
        r.stderr = "Failed to create process";
        return r;
    }

    if (stdinData.length() > 0) {
        byte[] inBytes = stdinData.toBytes();
        WriteFile(hWriteIn, inBytes, inBytes.length, null, null);
    }
    CloseHandle(hWriteIn);

    WaitForSingleObject(pi.hProcess, 5000);

    byte[] outBuf[8192];
    int n = 0;
    string output = "";
    while (ReadFile(hReadOut, outBuf, 8192, &n, null) && n > 0) {
        for (int i = 0; i < n; i++) { output += char(outBuf[i]); }
    }

    int exitCode = 0;
    GetExitCodeProcess(pi.hProcess, &exitCode);
    CloseHandle(pi.hProcess);
    CloseHandle(pi.hThread);
    CloseHandle(hReadOut);
    CloseHandle(hWriteOut);
    CloseHandle(hReadIn);

    result res = new result();
    res.stdout = output;
    res.exitCode = exitCode;
    return res;
}

public process spawn(string cmd, string[] args) {
    process proc = new process();
    return proc;
}
