import * from win32.kernel32;
import * from win32.user32;

mod export process;

class result {
    public string stdout;
    public string stderr;
    public int exitCode;
}

class ProcessWindow {
    public int handle;
    public string title;

    construct() {
        this.handle = 0;
        this.title = "";
    }
}

class Process {
    public string path;
    public string filename;
    public int id;
    public ProcessWindow window;

    construct() {
        this.path = "";
        this.filename = "";
        this.id = 0;
        this.window = new ProcessWindow();
    }

    public static Process getFocusedProcess() {
        Process result = new Process();
        int hwnd = GetForegroundWindow();
        if (hwnd == 0) { return result; }
        result.window.handle = hwnd;

        byte[] titleBuffer = new byte[512];
        int titleLength = GetWindowTextA(hwnd, titleBuffer, 512);
        string title = "";
        for (int i = 0; i < titleLength; i++) { title += char(titleBuffer[i]); }
        result.window.title = title;

        int pid = 0;
        GetWindowThreadProcessId(hwnd, &pid);
        result.id = pid;

        int hProcess = OpenProcess(0x1000, 0, pid);
        if (hProcess == 0) { return result; }
        byte[] pathBuffer = new byte[1024];
        int pathLength = 1024;
        int ok = QueryFullProcessImageNameA(hProcess, 0, pathBuffer, &pathLength);
        CloseHandle(hProcess);
        if (ok == 0) { return result; }

        string fullPath = "";
        for (int i = 0; i < pathLength; i++) { fullPath += char(pathBuffer[i]); }
        result.path = fullPath;
        int lastSlash = -1;
        for (int i = 0; i < fullPath.length; i++) {
            if (fullPath[i] == '\\' || fullPath[i] == '/') { lastSlash = i; }
        }
        if (lastSlash >= 0) {
            result.filename = fullPath[lastSlash + 1..fullPath.length];
        } else {
            result.filename = fullPath;
        }
        return result;
    }
}

class pipe {
    private int hRead;
    private int hWrite;

    construct() { }

    public void write(string data) {
        byte[] bytes = data.toBytes();
        WriteFile(this.hWrite, bytes, bytes.length, null, null);
    }

    public void flush() { }

    public string read() {
        byte[] buf = new byte[4096];
        int n = 0;
        ReadFile(this.hRead, buf, 4096, &n, null);
        if (n <= 0) { return ""; }
        string result = "";
        for (int i = 0; i < n; i++) { result += char(buf[i]); }
        return result;
    }
}

public result run(string cmd, string[] args) {
    string fullCmd = cmd;
    for (int i = 0; i < args.length; i++) { fullCmd += " " + args[i]; }
    byte[] outBuf = new byte[8192];
    int n = 0;
    int hWriteOut = 0;
    int hReadOut = 0;
    CreatePipe(&hReadOut, &hWriteOut, null, 0);
    int created = CreateProcessA(null, fullCmd, null, null, 1, 0, null, null, null, null);
    if (created == 0) {
        result r = new result();
        r.exitCode = -1;
        r.stderr = "Failed to create process";
        CloseHandle(hWriteOut);
        CloseHandle(hReadOut);
        return r;
    }
    string output = "";
    while (ReadFile(hReadOut, outBuf, 8192, &n, null) && n > 0) {
        for (int i = 0; i < n; i++) { output += char(outBuf[i]); }
    }
    result res = new result();
    res.stdout = output;
    res.exitCode = 0;
    CloseHandle(hWriteOut);
    CloseHandle(hReadOut);
    return res;
}
