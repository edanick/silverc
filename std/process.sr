import * from os;
import * from process_win;

mod export process;

// DOCS -- public `process` module (UNIFIED_CORE_LIBRARY.md Phase 2). This is
// the unified, portable front of the process library. It contains ZERO win32
// imports: every user32/kernel32 call moved into the internal Windows backend
// std/process_win.sr, and every DLL-backed entry below routes through the OS
// gate `if (osType() == OSTypes.WINDOWS)` before touching it (osType() is
// std/os.sr's plain-Silver stand-in -- see that file and std/sysinfo.sr for
// why the gate does not use the native os.type query).
//
// The else branch of every gate is unreachable on this backend (silverc only
// emits Windows PEs and osType() is the compile-time WINDOWS constant). For
// a future non-Windows backend the fallbacks follow the module's failure
// style: getFocusedProcess() returns an all-zero/empty Process, run() returns
// the zero result, pipe.read() returns "" and pipe.write() is a silent no-op.
//
// NOT gated on purpose (no DLL behind them): the `result`, `ProcessWindow`
// and `Process` class declarations and constructors, pipe's declarations and
// its flush() stub (pre-split no-op body, kept verbatim).
//
// DISPATCH NOTE (per compiler, probed, unchanged by this split): on
// silverc-rs every `Process.getFocusedProcess()` / `process.getFocusedProcess()`
// call is intercepted BEFORE this source body and emitted natively
// (codegen.rs routes both spellings to stdlib::process::gen_focused_process,
// whose object layout contract -- path, filename, id, window -- the class
// below preserves exactly), so the static body below is dead code there;
// the self-hosted compiler has no such intercept and executes it. The
// self-hosted driver hand-prepends this file into standalone compiles when
// the user source imports "process" (compiler_driver.sr), and excludes the
// name from disk collection so the prepend never duplicates; the backend it
// now imports (process_win) resolves from std\ through the normal
// collectModule flow. Bare `run(...)` / `pipe` / `result` calls resolve to
// this module's globals on both compilers -- although on silverc-rs a user
// file cannot DECLARE a lowercase `result`/`pipe` typed variable (rs
// statement parsing only accepts lowercase type names declared in the same
// file), so the pre-split rs surface was effectively Process.getFocusedProcess
// plus the native bare-win32 sentinel path; nothing about that surface
// changed.

class result {
    public string stdout;
    public string stderr;
    public int exitCode;
}

class ProcessWindow {
    public int handle;
    public string title;

    construct() {
        this.handle = 0;
        this.title = "";
    }
}

class Process {
    public string path;
    public string filename;
    public int id;
    public ProcessWindow window;

    construct() {
        this.path = "";
        this.filename = "";
        this.id = 0;
        this.window = new ProcessWindow();
    }

    // Pre-split body shape preserved: null foreground HWND leaves the whole
    // Process zero/empty; a failed OpenProcess or image-name query (both
    // surface as "" from processWinImagePath) leaves path/filename empty
    // while handle/title/id stay set. The filename slash-scan is pure Silver
    // and stays here; every DLL touch is behind the gate and the backend.
    public static Process getFocusedProcess() {
        Process result = new Process();
        if (osType() == OSTypes.WINDOWS) {
            int hwnd = processWinForegroundHandle();
            if (hwnd != 0) {
                result.window.handle = hwnd;
                result.window.title = processWinWindowTitle(hwnd);
                result.id = processWinWindowProcessId(hwnd);
                string fullPath = processWinImagePath(result.id);
                result.path = fullPath;
                int lastSlash = -1;
                for (int i = 0; i < fullPath.length; i++) {
                    if (fullPath[i] == '\\' || fullPath[i] == '/') { lastSlash = i; }
                }
                if (lastSlash >= 0) {
                    result.filename = fullPath[lastSlash + 1..fullPath.length];
                } else {
                    result.filename = fullPath;
                }
            }
        }
        return result;
    }
}

class pipe {
    private int hRead;
    private int hWrite;

    construct() { }

    public void write(string data) {
        if (osType() == OSTypes.WINDOWS) {
            processWinPipeWrite(this.hWrite, data);
        }
    }

    public void flush() { }

    public string read() {
        if (osType() == OSTypes.WINDOWS) {
            return processWinPipeRead(this.hRead);
        }
        return "";
    }
}

public result run(string cmd, string[] args) {
    result res = new result();
    if (osType() == OSTypes.WINDOWS) {
        string fullCmd = cmd;
        for (int i = 0; i < args.length; i++) { fullCmd += " " + args[i]; }
        // [status, payload] protocol from the backend: "0" = success with the
        // captured stdout, "1" = spawn failure with the pre-split stderr
        // message. The pre-split exitCode contract is preserved: 0 on
        // success, -1 on spawn failure with stderr = "Failed to create
        // process". The backend's CreateProcessA call keeps the pre-split
        // null lpProcessInformation shape verbatim -- see
        // std/process_win.sr for why that call faults on the self-hosted
        // compiler exactly as it did before the split.
        string[] parts = processWinRunCapture(fullCmd);
        if (parts[0] == "0") {
            res.stdout = parts[1];
            res.exitCode = 0;
        } else {
            res.exitCode = -1;
            res.stderr = parts[1];
        }
    }
    return res;
}
