mod export math;

public const float64 PI = 3.141592653589793;
public const float64 E = 2.718281828459045;

public float64 abs(float64 x) {
    if (x < 0.0) { return -x; }
    return x;
}

public int abs(int x) {
    if (x < 0) { return -x; }
    return x;
}

private float64 fact(int n) {
    float64 r = 1.0;
    for (int i = 2; i <= n; i++) { r *= float64(i); }
    return r;
}

public float64 sin(float64 x) {
    float64 r = 0.0;
    int sign = 1;
    for (int i = 0; i < 15; i++) {
        int n = 2 * i + 1;
        float64 term = pow(x, n) / fact(n);
        if (sign > 0) { r += term; } else { r -= term; }
        sign = -sign;
    }
    return r;
}

public float64 cos(float64 x) {
    float64 r = 0.0;
    int sign = 1;
    for (int i = 0; i < 15; i++) {
        int n = 2 * i;
        float64 term = pow(x, n) / fact(n);
        if (sign > 0) { r += term; } else { r -= term; }
        sign = -sign;
    }
    return r;
}

public float64 tan(float64 x) << sin(x) / cos(x);

public float64 pow(float64 base, float64 exp) {
    if (exp == 0.0) { return 1.0; }
    if (exp == 1.0) { return base; }
    if (exp == 2.0) { return base * base; }
    bool negExp = exp < 0.0;
    if (negExp) { exp = -exp; }
    int e = int(exp);
    float64 frac = exp - float64(e);
    float64 r = 1.0;
    for (int i = 0; i < e; i++) { r *= base; }
    if (frac > 0.0) {
        r *= expHelper(base, frac, 20);
    }
    if (negExp) { r = 1.0 / r; }
    return r;
}

private float64 expHelper(float64 base, float64 exp, int terms) {
    float64 lnBase = ln(base);
    float64 x = lnBase * exp;
    float64 r = 1.0;
    float64 term = 1.0;
    for (int i = 1; i <= terms; i++) {
        term *= x / float64(i);
        r += term;
    }
    return r;
}

public float64 sqrt(float64 x) {
    if (x <= 0.0) { return 0.0; }
    float64 guess = x / 2.0;
    for (int i = 0; i < 50; i++) {
        float64 next = (guess + x / guess) / 2.0;
        if (abs(next - guess) < 1e-15) { break; }
        guess = next;
    }
    return guess;
}

public float64 floor(float64 x) {
    int n = int(x);
    if (float64(n) > x) { return float64(n - 1); }
    return float64(n);
}

public float64 ceil(float64 x) {
    int n = int(x);
    if (float64(n) < x) { return float64(n + 1); }
    return float64(n);
}

public float64 round(float64 x) {
    float64 f = x - floor(x);
    if (f < 0.5) { return floor(x); }
    return ceil(x);
}

public float64 max(float64 a, float64 b) {
    if (a > b) { return a; }
    return b;
}

public float64 min(float64 a, float64 b) {
    if (a < b) { return a; }
    return b;
}

public float64 random() {
    int seed = 42;
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return float64(seed) / 2147483648.0;
}

public float64 ln(float64 x) {
    if (x <= 0.0) { return -1e308; }
    float64 y = (x - 1.0) / (x + 1.0);
    float64 r = 0.0;
    float64 term = y;
    for (int i = 1; i < 100; i += 2) {
        r += term / float64(i);
        if (abs(term / float64(i)) < 1e-15) { break; }
        term *= y * y;
    }
    return 2.0 * r;
}

public float64 log10(float64 x) << ln(x) / 2.302585092994046;

public float64 exp(float64 x) {
    float64 r = 1.0;
    float64 term = 1.0;
    for (int i = 1; i <= 30; i++) {
        term *= x / float64(i);
        r += term;
    }
    return r;
}

public float64 hypot(float64 a, float64 b) << sqrt(a * a + b * b);

public float64 sum(float64[] arr) {
    float64 s = 0.0;
    foreach (float64 v in arr) { s += v; }
    return s;
}