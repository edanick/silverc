mod export math;

// Pure Silver numeric routines. Range reduction keeps intermediate values
// bounded; iterative arithmetic uses explicit floating-point assignments.
// round resolves exact halves toward positive infinity on every backend.
public const float64 PI = 3.141592653589793;
public const float64 pi = 3.141592653589793;
public const float64 E = 2.718281828459045;

private float64 mathInfinity() {
    float64 large = 1e308;
    return large * large;
}

private float64 mathNan() {
    float64 zero = 0.0;
    return zero / zero;
}

public float64 abs(float64 value) {
    if (value == 0.0) { return 0.0; }
    if (value < 0.0) { return -value; }
    return value;
}

public int abs(int value) {
    if (value < 0) { return -value; }
    return value;
}

public float64 sqrt(float64 value) {
    if (!(value >= 0.0)) { return mathNan(); }
    if (value == 0.0 || value > 1.7976931348623157e308) { return value; }
    float64 scale = 1.0;
    while (value > 4.0) { value = value * 0.25; scale = scale * 2.0; }
    while (value < 1.0) { value = value * 4.0; scale = scale * 0.5; }
    float64 guess = 1.0;
    for (int i = 0; i < 9; i++) { guess = 0.5 * (guess + value / guess); }
    return guess * scale;
}

public float64 floor(float64 value) {
    // At and beyond 2^52 every finite double is already integral. Avoid
    // converting these values (or infinities/NaN) to a signed integer.
    if (!(value > -4503599627370496.0 && value < 4503599627370496.0)) { return value; }
    int n = int(value);
    float64 result = float64(n);
    if (result > value) { return result - 1.0; }
    return result;
}

public float64 ceil(float64 value) {
    if (!(value > -4503599627370496.0 && value < 4503599627370496.0)) { return value; }
    int n = int(value);
    float64 result = float64(n);
    if (result < value) { return result + 1.0; }
    return result;
}

public float64 round(float64 value) {
    float64 lower = floor(value);
    if (value - lower < 0.5) { return lower; }
    return ceil(value);
}

public float64 ln(float64 value) {
    if (!(value >= 0.0)) { return mathNan(); }
    if (value == 0.0) { return -mathInfinity(); }
    if (value > 1.7976931348623157e308) { return value; }
    int power = 0;
    while (value > 2.0) { value = value * 0.5; power++; }
    while (value < 1.0) { value = value * 2.0; power--; }
    float64 y = (value - 1.0) / (value + 1.0);
    float64 square = y * y;
    float64 term = y;
    float64 result = y;
    for (int i = 3; i < 61; i += 2) {
        term = term * square;
        result = result + term / float64(i);
    }
    return 2.0 * result + float64(power) * 0.6931471805599453;
}

public float64 log(float64 value) { return ln(value); }
public float64 log10(float64 value) { return ln(value) / 2.302585092994046; }

public float64 exp(float64 value) {
    if (!(value <= mathInfinity() && value >= -mathInfinity())) { return value; }
    if (value > 709.782712893384) { return mathInfinity(); }
    if (value < -745.1332191019411) { return 0.0; }
    float64 quotient = value / 0.6931471805599453;
    if (quotient < 0.0) { quotient = quotient - 0.5; }
    else { quotient = quotient + 0.5; }
    int power = int(quotient);
    float64 remainder = (value - float64(power) * 0.6931471803691238)
        - float64(power) * 0.00000000019082149292705877;
    float64 result = 1.0;
    float64 term = 1.0;
    for (int i = 1; i <= 20; i++) {
        term = term * (remainder / float64(i));
        result = result + term;
    }
    while (power > 0) { result = result * 2.0; power--; }
    while (power < 0) { result = result * 0.5; power++; }
    return result;
}

public float64 pow(float64 base, float64 exponent) {
    if (exponent == 0.0 || base == 1.0) { return 1.0; }
    if (!(base <= mathInfinity() && base >= -mathInfinity() && exponent <= mathInfinity() && exponent >= -mathInfinity())) { return mathNan(); }
    if (exponent > -9223372036854775808.0 && exponent < 9223372036854775807.0) {
        int power = int(exponent);
        if (float64(power) == exponent) {
            if (power < 0) { base = 1.0 / base; power = -power; }
            float64 result = 1.0;
            while (power > 0) {
                if ((power & 1) != 0) { result = result * base; }
                power = power >> 1;
                if (power > 0) { base = base * base; }
            }
            return result;
        }
        if (base < 0.0) {
            if (base < -1.7976931348623157e308) { return exp(exponent * ln(-base)); }
            return mathNan();
        }
    }
    // Exponents beyond the signed integer range are even binary64 integers.
    if (base == -1.0) { return 1.0; }
    if (base < 0.0) { return exp(exponent * ln(-base)); }
    return exp(exponent * ln(base));
}

private float64 mathSineSeries(float64 angle) {
    if (angle == 0.0) { return angle; }
    float64 term = angle;
    float64 result = angle;
    for (int i = 1; i < 14; i++) {
        term = -term * angle * angle / float64((2 * i) * (2 * i + 1));
        result = result + term;
    }
    return result;
}

private float64 mathCosineSeries(float64 angle) {
    float64 term = 1.0;
    float64 result = 1.0;
    for (int i = 1; i < 14; i++) {
        term = -term * angle * angle / float64((2 * i - 1) * (2 * i));
        result = result + term;
    }
    return result;
}

// Reduce to the nearest quadrant and evaluate only in [-pi/4, pi/4].
// Never reconstruct a large angle: that loses tiny remainders near zeros
// and tangent poles. Three split pi/2 terms retain ordinary-input precision;
// 70 base-2^24 limbs of 2/pi cover every finite binary64 exponent.
private float64 mathTrigonometric(float64 value, int operation) {
    if (!(value <= 1.7976931348623157e308 && value >= -1.7976931348623157e308)) { return mathNan(); }
    float64 magnitude = value;
    if (magnitude < 0.0) { magnitude = -magnitude; }
    float64 angle = value;
    int quadrant = 0;
    if (magnitude > 0.7853981633974483) {
        if (magnitude < 1000000.0) {
            int turns = int(floor(value * 0.6366197723675814 + 0.5));
            quadrant = turns & 3;
            angle = ((value - float64(turns) * 1.5707963267341256)
                - float64(turns) * 0.00000000006077100506303966)
                - float64(turns) * 0.0000000000000000000020222662487959506;
        } else {
            int[] digits = [10680707, 7228996, 1387004, 2578385, 16069853, 12639074, 9804092, 4427841, 16666979, 11263675, 12935607, 2387514, 4345298, 14681673, 3074569, 13734428, 16653803, 1880361, 10960616, 8533493, 3062596, 8710556, 7349940, 6258241, 3772886, 3769171, 3798172, 8675211, 12450088, 3874808, 9961438, 366607, 15675153, 9132554, 7151469, 3571407, 2607881, 12013382, 4155038, 6285869, 7677882, 13102053, 15825725, 473591, 9065106, 15363067, 6271263, 9264392, 5636912, 4652155, 7056368, 13614112, 10155062, 1944035, 9527646, 15080200, 6658437, 6231200, 6832269, 16767104, 5075751, 3212806, 1398474, 7579849, 6349435, 12618859, 4703257, 12806093, 14477321, 2786137];
            int exponent = 0;
            while (magnitude >= 2.0) { magnitude = magnitude * 0.5; exponent++; }
            int significand = int(magnitude * 4503599627370496.0);
            int[] parts = [significand & 16777215, (significand >> 24) & 16777215, significand >> 48];
            int[] product = new int[73];
            for (int i = 0; i < 70; i++) {
                for (int j = 0; j < 3; j++) {
                    product[i + j] = product[i + j] + digits[69 - i] * parts[j];
                }
            }
            for (int i = 0; i < 72; i++) {
                product[i + 1] = product[i + 1] + (product[i] >> 24);
                product[i] = product[i] & 16777215;
            }
            int point = 1680 - exponent + 52;
            quadrant = ((product[point / 24] >> (point % 24)) & 1)
                + 2 * ((product[(point + 1) / 24] >> ((point + 1) % 24)) & 1);
            int leading = point - 1;
            float64 fraction = 0.0;
            if (((product[leading / 24] >> (leading % 24)) & 1) != 0) {
                fraction = -0.5;
                quadrant = (quadrant + 1) & 3;
            }
            // Accumulate a signed fraction directly. Subtracting 1 from a
            // rounded positive fraction would destroy near-integer low bits.
            float64 weight = 0.25;
            for (int i = 2; i <= 120; i++) {
                int bit = point - i;
                if (((product[bit / 24] >> (bit % 24)) & 1) != 0) { fraction = fraction + weight; }
                weight = weight * 0.5;
            }
            if (value < 0.0) { fraction = -fraction; quadrant = (0 - quadrant) & 3; }
            angle = fraction * 1.5707963267948966;
        }
    }
    float64 sine = mathSineSeries(angle);
    float64 cosine = mathCosineSeries(angle);
    if (operation == 2) {
        if ((quadrant & 1) != 0) { return -cosine / sine; }
        return sine / cosine;
    }
    if (operation == 0) {
        if (quadrant == 0) { return sine; }
        if (quadrant == 1) { return cosine; }
        if (quadrant == 2) { return -sine; }
        return -cosine;
    }
    if (quadrant == 0) { return cosine; }
    if (quadrant == 1) { return -sine; }
    if (quadrant == 2) { return -cosine; }
    return sine;
}

public float64 sin(float64 value) { return mathTrigonometric(value, 0); }
public float64 cos(float64 value) { return mathTrigonometric(value, 1); }
public float64 tan(float64 value) { return mathTrigonometric(value, 2); }

public float64 hypot(float64 first, float64 second) {
    float64 a = first;
    float64 b = second;
    if (a < 0.0) { a = -a; }
    if (b < 0.0) { b = -b; }
    if (a > 1.7976931348623157e308 || b > 1.7976931348623157e308) { return mathInfinity(); }
    if (a < b) { float64 temp = a; a = b; b = temp; }
    if (a == 0.0) { return b; }
    float64 ratio = b / a;
    return a * sqrt(1.0 + ratio * ratio);
}

public float64 max(float64 first, float64 second) {
    if (first > second) { return first; }
    return second;
}
public float64 min(float64 first, float64 second) {
    if (first < second) { return first; }
    return second;
}
public int max(int first, int second) {
    if (first > second) { return first; }
    return second;
}
public int min(int first, int second) {
    if (first < second) { return first; }
    return second;
}

private class MathRandomState {
    public prop int seed;
    construct { this.seed = 42; }
}
private MathRandomState mathRandomState = new MathRandomState();

public float64 random() {
    mathRandomState.seed = (mathRandomState.seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return float64(mathRandomState.seed) / 2147483648.0;
}

public float64 sum(float64[] values) {
    float64 result = 0.0;
    for (int i = 0; i < values.length; i++) { result = result + values[i]; }
    return result;
}
public int sum(int[] values) {
    int result = 0;
    for (int i = 0; i < values.length; i++) { result = result + values[i]; }
    return result;
}

// math.eval(expression) evaluates a string containing a mathematical
// expression and returns its integer result. The grammar is restricted to
// integer literals, parentheses, unary +/- and the operators
// + - * / % == != < <= > >= with standard Silver precedence. It never
// executes Silver statements or arbitrary code.
//
// Division by zero, malformed input, and integer overflow raise a math
// evaluation exception (throw 1).
class MathEvalParser {
    string src;
    int pos;

    construct(string s) {
        this.src = s;
        this.pos = 0;
    }

    void skipWs() {
        while (this.pos < this.src.length) {
            char c = this.src[this.pos];
            if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
                this.pos++;
            } else {
                break;
            }
        }
    }

    char peek() {
        if (this.pos >= this.src.length) { return ' '; }
        return this.src[this.pos];
    }

    int parseAll() {
        this.skipWs();
        int result = this.parseCompare();
        this.skipWs();
        if (this.pos != this.src.length) { throw 1; }
        return result;
    }

    int parseCompare() {
        int left = this.parseAdd();
        while (true) {
            this.skipWs();
            char c = this.peek();
            if (c == '=' && this.pos + 1 < this.src.length && this.src[this.pos + 1] == '=') {
                this.pos = this.pos + 2;
                int right = this.parseAdd();
                if (left == right) { left = 1; } else { left = 0; }
            } else if (c == '!' && this.pos + 1 < this.src.length && this.src[this.pos + 1] == '=') {
                this.pos = this.pos + 2;
                int right = this.parseAdd();
                if (left != right) { left = 1; } else { left = 0; }
            } else if (c == '<' && this.pos + 1 < this.src.length && this.src[this.pos + 1] == '=') {
                this.pos = this.pos + 2;
                int right = this.parseAdd();
                if (left <= right) { left = 1; } else { left = 0; }
            } else if (c == '>' && this.pos + 1 < this.src.length && this.src[this.pos + 1] == '=') {
                this.pos = this.pos + 2;
                int right = this.parseAdd();
                if (left >= right) { left = 1; } else { left = 0; }
            } else if (c == '<') {
                this.pos++;
                int right = this.parseAdd();
                if (left < right) { left = 1; } else { left = 0; }
            } else if (c == '>') {
                this.pos++;
                int right = this.parseAdd();
                if (left > right) { left = 1; } else { left = 0; }
            } else {
                return left;
            }
        }
    }

    int add(int left, int right) {
        if (right > 0 && left > 9223372036854775807 - right) { throw 1; }
        if (right < 0 && left < (-9223372036854775807 - 1) - right) { throw 1; }
        return left + right;
    }

    int subtract(int left, int right) {
        if (right < 0 && left > 9223372036854775807 + right) { throw 1; }
        if (right > 0 && left < (-9223372036854775807 - 1) + right) { throw 1; }
        return left - right;
    }

    int multiply(int left, int right) {
        int minimum = -9223372036854775807 - 1;
        int maximum = 9223372036854775807;
        if (left > 0) {
            if (right > 0 && left > maximum / right) { throw 1; }
            if (right < 0 && right < minimum / left) { throw 1; }
        } else if (left < 0) {
            if (right > 0 && left < minimum / right) { throw 1; }
            if (right < 0 && left < maximum / right) { throw 1; }
        }
        return left * right;
    }

    int parseAdd() {
        int left = this.parseMul();
        while (true) {
            this.skipWs();
            char c = this.peek();
            if (c == '+') {
                this.pos++;
                int right = this.parseMul();
                left = this.add(left, right);
            } else if (c == '-') {
                this.pos++;
                int right = this.parseMul();
                left = this.subtract(left, right);
            } else {
                return left;
            }
        }
    }

    int parseMul() {
        int left = this.parseUnary();
        while (true) {
            this.skipWs();
            char c = this.peek();
            if (c == '*') {
                this.pos++;
                int right = this.parseUnary();
                left = this.multiply(left, right);
            } else if (c == '/') {
                this.pos++;
                int right = this.parseUnary();
                if (right == 0 || (left == (-9223372036854775807 - 1) && right == -1)) { throw 1; }
                left = left / right;
            } else if (c == '%') {
                this.pos++;
                int right = this.parseUnary();
                if (right == 0) { throw 1; }
                if (right == -1) { left = 0; }
                else { left = left % right; }
            } else {
                return left;
            }
        }
    }

    int parseUnary() {
        this.skipWs();
        char c = this.peek();
        if (c == '-') {
            this.pos++;
            this.skipWs();
            char next = this.peek();
            if (next >= '0' && next <= '9') { return this.parseNumber(true); }
            int value = this.parseUnary();
            if (value == (-9223372036854775807 - 1)) { throw 1; }
            return 0 - value;
        }
        if (c == '+') {
            this.pos++;
            return this.parseUnary();
        }
        return this.parsePrimary();
    }

    int parseNumber(bool negative) {
        int value = 0;
        while (this.pos < this.src.length) {
            char digit = this.src[this.pos];
            if (digit < '0' || digit > '9') { break; }
            int next = digit - '0';
            // Accumulate negative literals negatively so INT64_MIN is valid.
            if (negative) {
                value = this.subtract(this.multiply(value, 10), next);
            } else {
                value = this.add(this.multiply(value, 10), next);
            }
            this.pos++;
        }
        return value;
    }

    int parsePrimary() {
        this.skipWs();
        char c = this.peek();
        if (c == '(') {
            this.pos++;
            int value = this.parseCompare();
            this.skipWs();
            if (this.peek() == ')') {
                this.pos++;
                return value;
            }
            throw 1;
        }
        if (c >= '0' && c <= '9') { return this.parseNumber(false); }
        throw 1;
    }
}

public int eval(string expression) {
    MathEvalParser parser = new MathEvalParser(expression);
    return parser.parseAll();
}
