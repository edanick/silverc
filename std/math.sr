import * from os;
import * from math_win;

mod export math;

// DOCS -- public `math` module (UNIFIED_CORE_LIBRARY.md Phase 2). This is
// the unified, portable front of the math library. It contains ZERO win32
// imports: every implementation body moved verbatim into the internal
// Windows backend std/math_win.sr, and every numeric entry below routes
// through the OS gate `if (osType() == OSTypes.WINDOWS)` before touching it.
//
// The gate uses osType() (std/os.sr) instead of the native `os.type` query
// because the self-hosted backend's builtin `os` dispatch covers only
// os.name/os.version/os.build today -- `os.type` miscompiles there in both
// spellings (property access yields a null string, the call form falls into
// builtin dispatch and returns garbage). osType() is plain Silver: it
// returns the OSTypes.WINDOWS contract value on every implementation without
// needing native support, and it can be switched to the native query once
// mini_cg learns a `type` branch.
//
// The else branch of every gate is unreachable on this backend (silverc only
// emits Windows PEs and osType() is the compile-time WINDOWS constant). For
// a future non-Windows backend the fallback follows the module's numeric
// style: 0.0 for the float entries, 0 for the int abs overload.
//
// VESTIGIAL IMPORT DROPPED: the pre-split file opened with
// `import * from win32.msvcrt;` but never called a CRT function -- every
// body was pure Silver arithmetic. The backend (math_win.sr) therefore
// grants no DLL exports at all, mirroring std/time_win.sr's treatment of
// time.sr's vestigial msvcrt import.
//
// DISPATCH NOTE (per compiler, unchanged by this split): silverc-rs answers
// every qualified `math.<fn>(...)` call with its native builtins before any
// symbol lookup -- codegen.rs lowers a `math.`-prefixed call straight into
// stdlib::math::gen_math_call (msvcrt IAT sentinels for cos/sin/tan/pow/
// sqrt/floor/ceil/round/ln/log10, inline sign-bit clear for abs, rand for
// random, inline compares for max/min, a GP loop for sum, a compile-time
// fold for eval) -- and "math" is in rs's builtin_modules_set, so
// `import * from math;` never resolves to a file and this wrapper (and the
// backend) are never read there. The self-hosted compiler has no math
// intercept at all: "math" is only on the driver's hand-prepend/visibility
// lists (compiler_driver.sr / visibility.sr), the source is collected from
// std/math.sr, and the qualified calls dispatch to these globals, which
// forward into the internal backend behind the gate. Both paths keep the
// user-observable behavior each compiler had before the split.
//
// FLOAT64 PARITY NOTE: the numeric results travel as IEEE-754 bit patterns
// in GP registers end-to-end (see mini_cg float paths / rs codegen float
// handling). The wrapper's `return mathWin<Fn>(...)` forwarders add one
// plain call frame on top of the pre-split qualified call; the value crosses
// it as raw bits exactly like the pre-split intra-module helper calls
// (pow/fact/expHelper) did, so no conversion is introduced on either path.
// The bodies themselves are byte-for-byte lifts, so the self-hosted
// observable results -- including its pre-existing float64 lowering quirks
// (float compound assignment inside loops, the overload tie that sends the
// backend's inner abs calls to the int body, float64 constants printing via
// the int const path) -- are pinned by the A/B probes against the pre-split
// build. The PI/E constants stay here unchanged: they are pure data, never
// reach the backend, and their (pre-existing) self-hosted print behavior is
// part of the pinned surface.
//
// UNGATED ENTRIES (io.sr precedent): tan/log10/hypot are pure delegation to
// this module's own gated primitives (sin/cos, ln, sqrt), so they keep their
// pre-split `<<` one-liner global shapes ungated and inherit the gate
// through those calls -- the exact shape io.sr's input() alias uses for
// readLine. The one-liner shape is load-bearing, not just cosmetic: A/B
// probes showed routing log10 through a regular gated body that forwards
// into a backend mathWinLog10 crosses its argument with sibling calls'
// arguments in the flattened self-hosted aggregate, while the pre-split
// one-liner-over-same-file-functions shape reproduces the pre-split results
// exactly. eval() and the MathEvalParser class are likewise pure Silver --
// integer arithmetic, string indexing and throw only, no backend touch --
// so they keep their pre-split ungated shape too.

public const float64 PI = 3.141592653589793;
public const float64 E = 2.718281828459045;

public float64 abs(float64 x) {
    if (osType() == OSTypes.WINDOWS) {
        return mathWinAbsF64(x);
    }
    return 0.0;
}

public int abs(int x) {
    if (osType() == OSTypes.WINDOWS) {
        return mathWinAbsInt(x);
    }
    return 0;
}

public float64 sin(float64 x) {
    if (osType() == OSTypes.WINDOWS) {
        return mathWinSin(x);
    }
    return 0.0;
}

public float64 cos(float64 x) {
    if (osType() == OSTypes.WINDOWS) {
        return mathWinCos(x);
    }
    return 0.0;
}

public float64 tan(float64 x) << sin(x) / cos(x);

public float64 pow(float64 base, float64 exp) {
    if (osType() == OSTypes.WINDOWS) {
        return mathWinPow(base, exp);
    }
    return 0.0;
}

public float64 sqrt(float64 x) {
    if (osType() == OSTypes.WINDOWS) {
        return mathWinSqrt(x);
    }
    return 0.0;
}

public float64 floor(float64 x) {
    if (osType() == OSTypes.WINDOWS) {
        return mathWinFloor(x);
    }
    return 0.0;
}

public float64 ceil(float64 x) {
    if (osType() == OSTypes.WINDOWS) {
        return mathWinCeil(x);
    }
    return 0.0;
}

public float64 round(float64 x) {
    if (osType() == OSTypes.WINDOWS) {
        return mathWinRound(x);
    }
    return 0.0;
}

public float64 max(float64 a, float64 b) {
    if (osType() == OSTypes.WINDOWS) {
        return mathWinMax(a, b);
    }
    return 0.0;
}

public float64 min(float64 a, float64 b) {
    if (osType() == OSTypes.WINDOWS) {
        return mathWinMin(a, b);
    }
    return 0.0;
}

public float64 random() {
    if (osType() == OSTypes.WINDOWS) {
        return mathWinRandom();
    }
    return 0.0;
}

public float64 ln(float64 x) {
    if (osType() == OSTypes.WINDOWS) {
        return mathWinLn(x);
    }
    return 0.0;
}

public float64 log10(float64 x) << ln(x) / 2.302585092994046;

public float64 exp(float64 x) {
    if (osType() == OSTypes.WINDOWS) {
        return mathWinExp(x);
    }
    return 0.0;
}

public float64 hypot(float64 a, float64 b) << sqrt(a * a + b * b);

public float64 sum(float64[] arr) {
    if (osType() == OSTypes.WINDOWS) {
        return mathWinSum(arr);
    }
    return 0.0;
}

// math.eval(expression) evaluates a string containing a mathematical
// expression and returns its integer result. The grammar is restricted to
// integer literals, parentheses, unary +/- and the operators
// + - * / % == != < <= > >= with standard Silver precedence. It never
// executes Silver statements or arbitrary code.
//
// Division by zero surfaces the native divide-by-zero exception; malformed
// expressions and values that cannot be parsed raise a math evaluation
// exception (throw 1).
class MathEvalParser {
    string src;
    int pos;

    construct(string s) {
        this.src = s;
        this.pos = 0;
    }

    void skipWs() {
        while (this.pos < this.src.length) {
            char c = this.src[this.pos];
            if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
                this.pos = this.pos + 1;
            } else {
                break;
            }
        }
    }

    char peek() {
        if (this.pos >= this.src.length) { return ' '; }
        return this.src[this.pos];
    }

    int parseAll() {
        this.skipWs();
        int result = this.parseCompare();
        this.skipWs();
        if (this.pos != this.src.length) { throw 1; }
        return result;
    }

    int parseCompare() {
        int left = this.parseAdd();
        while (true) {
            this.skipWs();
            char c = this.peek();
            if (c == '=' && this.pos + 1 < this.src.length && this.src[this.pos + 1] == '=') {
                this.pos = this.pos + 2;
                int right = this.parseAdd();
                if (left == right) { left = 1; } else { left = 0; }
            } elif (c == '!' && this.pos + 1 < this.src.length && this.src[this.pos + 1] == '=') {
                this.pos = this.pos + 2;
                int right = this.parseAdd();
                if (left != right) { left = 1; } else { left = 0; }
            } elif (c == '<' && this.pos + 1 < this.src.length && this.src[this.pos + 1] == '=') {
                this.pos = this.pos + 2;
                int right = this.parseAdd();
                if (left <= right) { left = 1; } else { left = 0; }
            } elif (c == '>' && this.pos + 1 < this.src.length && this.src[this.pos + 1] == '=') {
                this.pos = this.pos + 2;
                int right = this.parseAdd();
                if (left >= right) { left = 1; } else { left = 0; }
            } elif (c == '<') {
                this.pos = this.pos + 1;
                int right = this.parseAdd();
                if (left < right) { left = 1; } else { left = 0; }
            } elif (c == '>') {
                this.pos = this.pos + 1;
                int right = this.parseAdd();
                if (left > right) { left = 1; } else { left = 0; }
            } else {
                return left;
            }
        }
    }

    int parseAdd() {
        int left = this.parseMul();
        while (true) {
            this.skipWs();
            char c = this.peek();
            if (c == '+') {
                this.pos = this.pos + 1;
                int right = this.parseMul();
                left = left + right;
            } elif (c == '-') {
                this.pos = this.pos + 1;
                int right = this.parseMul();
                left = left - right;
            } else {
                return left;
            }
        }
    }

    int parseMul() {
        int left = this.parseUnary();
        while (true) {
            this.skipWs();
            char c = this.peek();
            if (c == '*') {
                this.pos = this.pos + 1;
                int right = this.parseUnary();
                left = left * right;
            } elif (c == '/') {
                this.pos = this.pos + 1;
                int right = this.parseUnary();
                left = left / right;
            } elif (c == '%') {
                this.pos = this.pos + 1;
                int right = this.parseUnary();
                left = left % right;
            } else {
                return left;
            }
        }
    }

    int parseUnary() {
        this.skipWs();
        char c = this.peek();
        if (c == '-') {
            this.pos = this.pos + 1;
            return 0 - this.parseUnary();
        }
        if (c == '+') {
            this.pos = this.pos + 1;
            return this.parseUnary();
        }
        return this.parsePrimary();
    }

    int parsePrimary() {
        this.skipWs();
        char c = this.peek();
        if (c == '(') {
            this.pos = this.pos + 1;
            int value = this.parseCompare();
            this.skipWs();
            if (this.peek() == ')') {
                this.pos = this.pos + 1;
                return value;
            }
            throw 1;
        }
        if (c >= '0' && c <= '9') {
            int value = 0;
            while (this.pos < this.src.length) {
                char d = this.src[this.pos];
                if (d >= '0' && d <= '9') {
                    value = value * 10 + (d - '0');
                    this.pos = this.pos + 1;
                } else {
                    break;
                }
            }
            return value;
        }
        throw 1;
    }
}

public int eval(string expression) {
    MathEvalParser parser = new MathEvalParser(expression);
    return parser.parseAll();
}
