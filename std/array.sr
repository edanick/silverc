mod export array;

import * from string;

// Best-match suggestion lookup (Levenshtein): the candidate with the
// smallest edit distance from the needle. A candidate qualifies when it
// differs by one edit, or by two edits with the same first two letters (a
// real typo shape, not merely similar junk). Returns "" when nothing
// qualifies. Argument order is candidates-first: read as "in these,
// find the best match for this".
public string findBestMatch(string[] candidates, string needle) {
    string needleLc = needle.toLower();
    if (needleLc.length == 0) { return ""; }
    string best = "";
    int bestDist = 0;
    for (int i = 0; i < candidates.length; i++) {
        string candLc = candidates[i].toLower();
        if (candLc.length == 0) { continue; }
        int d = string.dissimilarity(needleLc, candLc);
        bool acceptable = false;
        if (d == 1) { acceptable = true; }
        else if (d == 2 && needleLc.length >= 3) {
            if (needleLc[0] == candLc[0] && needleLc[1] == candLc[1]) { acceptable = true; }
        }
        if (acceptable) {
            if (best.length == 0 || d < bestDist) {
                best = candidates[i];
                bestDist = d;
            }
        }
    }
    return best;
}
