// ---------------------------------------------------------------------------
// mouse - Win32 mouse input for the self-hosted Silver compiler.
//
// The universal mouse module -- one module, one OS layer (mouse ->
// win32.user32). The user32 calls (mouse_event, SetCursorPos, GetKeyState)
// live inline in the `#on WINDOWS` regions of the public functions that need
// them, one unified function name per operation, no wrapper indirection, no
// alias imports; OS selection is compile-time via the preprocessor regions,
// so the runtime `os.type` check is not used here.
//
// CURSOR READER DEVIATION (deliberate design decision): the
// readers below call the synthesized bare `GetCursorX()` / `GetCursorY()`
// natives instead of an inline GetCursorPos + packed-buffer decode. There is
// NO source-expressible decode matching both compilers: silverc-rs's
// GetCursorPos lowering ignores the caller's buffer (probed: zeros), while
// the self-hosted compiler's widens the POINT into whole 8-byte slots
// (packed low/high decode impossible). The synthesized names are intercepted
// natively on BOTH compilers (rs stdlib/keyboard.rs gen_cursor_x/y;
// self-host mini_cg.sr's GetCursorX/GetCursorY branches) with
// identical sign-extended real values, and they never reach the PE import
// table.
//
// For a future non-Windows backend the fallbacks follow the module's
// read/write style: the cursor readers return 0, isMouseDown returns false,
// and the state-changing entries (press/hold/release/click/tap/scroll, and
// Cursor.setPosition's Win32 move) become silent no-ops -- the tracked
// cursor locals in Cursor still update so getPosition() stays consistent.
//
// DISPATCH NOTE (per compiler): the qualified
// spellings never reach this source on either compiler. silverc-rs answers
// every `mouse.<fn>()` call with its native builtin before any module source
// is consulted (STDLIB_MODULES carries "mouse"; codegen.rs ->
// stdlib::keyboard::gen_mouse_call covers press/hold/release/click/tap/
// scroll/cursorX/cursorY/getCursorX/getCursorY and the setCursor cousins),
// so the class bodies below are dead code there for qualified calls -- the
// module source is still collected (mouse is not in the rs builtin-modules
// skip list), which is what serves instance-based and free-function calls.
// The self-hosted compiler intercepts exactly the cursor readers
// (`mouse.cursorX()` / `mouse.getCursorX()` / `mouse.cursorY()` /
// `mouse.getCursorY()` -- mini_cg.sr's mouse member-call branches, which
// allocate a stack POINT and call user32!GetCursorPos directly) and lets
// every other `mouse.<fn>()` spelling resolve to the class methods below.
// Instance spellings (`new mouse()`, the module `instance` global) and the
// free functions below execute these bodies on both compilers, with the
// same observable Win32 effects (one
// user32!GetCursorPos per read via the synthesized natives,
// user32!SetCursorPos / user32!mouse_event / user32!GetKeyState for the
// writes).
//
// Not gated on purpose (no DLL behind them): the constant and class
// declarations below, the pure flag helpers mouseDownFlag/mouseUpFlag,
// Cursor.setX/setY/getPosition, mouse.hold/click/tap (pure delegation to
// gated entries), and setCursorX/setCursorY -- those bodies only update the
// tracked Cursor locals (the Win32 move lives in Cursor.setPosition).
//
// LINUX BACKEND (Phase B, XWayland/X11 v1 per LINUX.md §7): XOpenDisplay /
// XQueryPointer / XWarpPointer from linux.x11 plus button synthesis from
// linux.xtst (XTestFakeButtonEvent), mirroring the user32 bodies call for
// call. X button numbers are 1 = left, 2 = middle, 3 = right (the
// mouseButtonToX helper). XQueryPointer takes nine arguments -- all nine
// ride real out-var addresses (never null: a null in a SysV stack-arg slot
// faults the callee on silverc-rs, probed). Every entry opens its own
// display and closes it before returning (stateless v1); a null display
// (no $DISPLAY / headless SSH) takes the documented fallback path: reads
// answer 0/false and writes are silent no-ops, with the tracked Cursor
// locals still updating so getPosition() stays consistent.
//
// MAC BACKEND (Phase B, code-only -- MAC.md section 7/10, DEGRADED until an
// Aqua backend lands and is probed on Mac hardware): every `#on MAC` branch
// below takes the documented headless fallback (reads answer 0/false,
// writes are silent no-ops, the tracked Cursor locals still update) -- the
// same safe fallbacks as the Windows/Linux no-backend stubs, never a stub
// that claims success falsely. The Aqua route is Quartz CGEvent
// (CGEventCreateMouseEvent/CGEventPost/CGWarpMouseCursorPosition) through
// the ONE shared ObjC bridge seam (mac.objc: objc_getClass /
// sel_registerName / objc_msgSend, granted in src/macos.rs); synthesis
// additionally needs the Accessibility TCC grant, and cursor queries the
// Screen Recording grant -- without them the backend must keep degrading
// exactly like these branches. No mac.* import is granted here until the
// Aqua backend lands (nothing below calls it yet). Mirrors
// silverc-rs/std/mouse.sr MAC bodies.
// ---------------------------------------------------------------------------

mod export mouse;

#on WINDOWS
import * from win32.user32;
#off
#on LINUX
import * from linux.x11;
#off
#on LINUX
import * from linux.xtst;
#off

const int MOUSEEVENTF_LEFTDOWN  = 0x0002;
const int MOUSEEVENTF_LEFTUP    = 0x0004;
const int MOUSEEVENTF_RIGHTDOWN = 0x0008;
const int MOUSEEVENTF_RIGHTUP   = 0x0010;
const int MOUSEEVENTF_MIDDLEDOWN = 0x0020;
const int MOUSEEVENTF_MIDDLEUP  = 0x0040;
const int MOUSEEVENTF_WHEEL     = 0x0800;

const int VK_LBUTTON = 0x01;
const int VK_RBUTTON = 0x02;
const int VK_MBUTTON = 0x04;

const int MouseButtons_LEFT   = 1;
const int MouseButtons_RIGHT  = 2;
const int MouseButtons_MIDDLE = 4;

const int ScrollDirections_UP   = 1;
const int ScrollDirections_DOWN = 0;

class Position {
    public int x;
    public int y;

    construct (int xv, int yv) {
        this.x = xv;
        this.y = yv;
    }
}

class MouseButton {
    public int type;
    construct (int t) { this.type = t; }
}

class ScrollDirection {
    public int type;
    construct (int t) { this.type = t; }
}

class Cursor {
    private int xPos;
    private int yPos;

    construct {
        this.xPos = 0;
        this.yPos = 0;
    }

    public int getX() {
        #on WINDOWS
        return GetCursorX();
        #on LINUX
        return queryPointerAxis(0);
        #on MAC
        return 0;
        #off
        return 0;
    }

    public int getY() {
        #on WINDOWS
        return GetCursorY();
        #on LINUX
        return queryPointerAxis(1);
        #on MAC
        return 0;
        #off
        return 0;
    }

    public void setX(int v) { this.xPos = v; }
    public void setY(int v) { this.yPos = v; }

    public Position getPosition() {
        return Position(this.xPos, this.yPos);
    }

    public void setPosition(int newX, int newY) {
        this.xPos = newX;
        this.yPos = newY;
        #on WINDOWS
        SetCursorPos(newX, newY);
        #on LINUX
        int d = XOpenDisplay(null);
        if (d == 0) { return; }
        int root = XDefaultRootWindow(d);
        XWarpPointer(d, 0, root, 0, 0, 0, 0, newX, newY);
        XFlush(d);
        XCloseDisplay(d);
        #on MAC
        // headless: no cursor warp (Quartz CGWarpMouseCursorPosition route
        // is gated); the tracked locals above still update.
        #off
    }
}

int mouseDownFlag(int button) {
    if (button == MouseButtons_RIGHT) { return MOUSEEVENTF_RIGHTDOWN; }
    if (button == MouseButtons_MIDDLE) { return MOUSEEVENTF_MIDDLEDOWN; }
    return MOUSEEVENTF_LEFTDOWN;
}

int mouseUpFlag(int button) {
    if (button == MouseButtons_RIGHT) { return MOUSEEVENTF_RIGHTUP; }
    if (button == MouseButtons_MIDDLE) { return MOUSEEVENTF_MIDDLEUP; }
    return MOUSEEVENTF_LEFTUP;
}

// X button number for a MouseButtons code (1 left, 2 middle, 3 right).
// Pure mapping, ungated.
int mouseButtonToX(int button) {
    if (button == MouseButtons_RIGHT) { return 3; }
    if (button == MouseButtons_MIDDLE) { return 2; }
    return 1;
}

// Live pointer read via XQueryPointer: result 0/1 selects the root X/Y.
// Opens and closes its own display; 0 when no display is reachable.
// LINUX-only helper (the WINDOWS side reads through GetCursorX/GetCursorY).
int queryPointerAxis(int wantY) {
    #on LINUX
    int d = XOpenDisplay(null);
    if (d == 0) { return 0; }
    int root = XDefaultRootWindow(d);
    int rroot = 0;
    int rchild = 0;
    int rx = 0;
    int ry = 0;
    int wx = 0;
    int wy = 0;
    int mask = 0;
    int ok = XQueryPointer(d, root, &rroot, &rchild, &rx, &ry, &wx, &wy, &mask);
    XCloseDisplay(d);
    if (ok == 0) { return 0; }
    if (wantY != 0) { return ry; }
    return rx;
    #off
    return 0;
}

// Button mask bit for a MouseButtons code (Button1/2/3Mask). Pure, ungated.
int mouseMaskBit(int buttonCode) {
    if (buttonCode == MouseButtons_RIGHT) { return 1024; }
    if (buttonCode == MouseButtons_MIDDLE) { return 512; }
    if (buttonCode == MouseButtons_LEFT) { return 256; }
    return 0;
}

class mouse {
    public Cursor cursor;

    construct {
        this.cursor = new Cursor();
    }

    // Active simulation. Win32 expects `mouse_event(0x0002 | button, 0, 0,
    // 0, 0)` for left/down. The 0x0002 flag is shared with right-down at
    // bit 3, so we OR with the constant MouseButtons value to pick a
    // direction.
    public void press(int button) {
        #on WINDOWS
        mouse_event(mouseDownFlag(button), 0, 0, 0, 0);
        #on LINUX
        int d = XOpenDisplay(null);
        if (d == 0) { return; }
        XTestFakeButtonEvent(d, mouseButtonToX(button), 1, 0);
        XFlush(d);
        XCloseDisplay(d);
        #on MAC
        // headless: no button synthesis (Quartz CGEvent route is gated).
        #off
    }

    public void hold(int button) {
        this.press(button);
    }

    public void release(int button) {
        #on WINDOWS
        mouse_event(mouseUpFlag(button), 0, 0, 0, 0);
        #on LINUX
        int d = XOpenDisplay(null);
        if (d == 0) { return; }
        XTestFakeButtonEvent(d, mouseButtonToX(button), 0, 0);
        XFlush(d);
        XCloseDisplay(d);
        #on MAC
        // headless: no button synthesis (Quartz CGEvent route is gated).
        #off
    }

    public void click(int button) {
        this.press(button);
        this.release(button);
    }

    public void tap(int button) {
        this.click(button);
    }

    // scroll(int amount) - positive scrolls down, negative up. The Win32
    // wheel delta unit is WHEEL_DELTA (120) per "click"; we forward raw
    // amounts so user code can pick its own scale (e.g. `mouse.scroll(400)`
    // in the docs is several clicks).
    public void scroll(int amount) {
        #on WINDOWS
        mouse_event(MOUSEEVENTF_WHEEL, 0, 0, amount, 0);
        #on LINUX
        wheelX(amount);
        #on MAC
        // headless: no wheel synthesis (Quartz CGEvent route is gated).
        #off
    }

    // scroll(int amount, ScrollDirection direction)
    // The optional `direction` overrides the sign of `amount`. UP = up,
    // DOWN = down. Per the docs, this avoids needing math.abs on the
    // caller side.
    public void scroll(int amount, ScrollDirection direction) {
        int delta = amount;
        if (direction.type == ScrollDirections_UP) {
            if (delta > 0) { delta = -delta; }
        } else {
            if (delta < 0) { delta = -delta; }
        }
        #on WINDOWS
        mouse_event(MOUSEEVENTF_WHEEL, 0, 0, delta, 0);
        #on LINUX
        wheelX(delta);
        #on MAC
        // headless: no wheel synthesis (Quartz CGEvent route is gated).
        #off
    }

    // Read live cursor X / Y from Win32. The compilers recognise the
    // QUALIFIED spellings (`mouse.cursorX()` etc.) natively -- see the
    // dispatch note above. These bodies keep the instance-based spellings
    // (`instance.cursorX()`, `new mouse()` objects) reading the live
    // position on both compilers.
    public int cursorX() {
        #on WINDOWS
        return GetCursorX();
        #on LINUX
        return queryPointerAxis(0);
        #on MAC
        return 0;
        #off
        return 0;
    }

    public int cursorY() {
        #on WINDOWS
        return GetCursorY();
        #on LINUX
        return queryPointerAxis(1);
        #on MAC
        return 0;
        #off
        return 0;
    }

    public int getCursorX() {
        #on WINDOWS
        return GetCursorX();
        #on LINUX
        return queryPointerAxis(0);
        #on MAC
        return 0;
        #off
        return 0;
    }

    public int getCursorY() {
        #on WINDOWS
        return GetCursorY();
        #on LINUX
        return queryPointerAxis(1);
        #on MAC
        return 0;
        #off
        return 0;
    }
}

// Wheel synthesis via XTest buttons 4 (up) / 5 (down), one click per
// WHEEL_DELTA-ish 120 units (a nonzero remainder still clicks once).
// LINUX-only helper.
void wheelX(int amount) {
    #on LINUX
    int btn = 5;
    int n = amount;
    if (n < 0) { btn = 4; n = -n; }
    n = n / 120;
    if (n == 0 && amount != 0) { n = 1; }
    int d = XOpenDisplay(null);
    if (d == 0) { return; }
    for (int i = 0; i < n; i++) {
        XTestFakeButtonEvent(d, btn, 1, 0);
        XTestFakeButtonEvent(d, btn, 0, 0);
    }
    XFlush(d);
    XCloseDisplay(d);
    #off
}

mouse instance = new mouse();

// Stand-alone positional helpers. The docs show the user accessing
// `mouse.cursor.x`, `mouse.cursor.y`, and writing tuples/arrays to
// `mouse.cursor.position`. Lets a script update position without going
// through the mouse instance's setPosition().
//
// The free `getCursorX()` / `getCursorY()` are the same live read as the
// instance methods on both compilers. `setCursorX` / `setCursorY` remain
// pure tracked-local writers -- the Win32 move lives in Cursor.setPosition.
int getCursorX() {
    #on WINDOWS
    return GetCursorX();
    #on LINUX
    return queryPointerAxis(0);
    #on MAC
    return 0;
    #off
    return 0;
}

int getCursorY() {
    #on WINDOWS
    return GetCursorY();
    #on LINUX
    return queryPointerAxis(1);
    #on MAC
    return 0;
    #off
    return 0;
}

void setCursorX(int v) {
    instance.cursor.setX(v);
}

void setCursorY(int v) {
    instance.cursor.setY(v);
}

// True if the button code (MouseButtons.LEFT/RIGHT/MIDDLE) is currently
// pressed. GetKeyState returns a SHORT whose upper bits are undefined per
// the Win64 ABI; the & 0x8000 mask keeps them out of the result.
bool isMouseDown(int buttonCode) {
    int vk = 0;
    if (buttonCode == MouseButtons_LEFT) { vk = VK_LBUTTON; }
    if (buttonCode == MouseButtons_RIGHT) { vk = VK_RBUTTON; }
    if (buttonCode == MouseButtons_MIDDLE) { vk = VK_MBUTTON; }
    if (vk == 0) { return false; }
    #on WINDOWS
    return (GetKeyState(vk) & 0x8000) != 0;
    #on LINUX
    int bit = mouseMaskBit(buttonCode);
    if (bit == 0) { return false; }
    int d = XOpenDisplay(null);
    if (d == 0) { return false; }
    int root = XDefaultRootWindow(d);
    int rroot = 0;
    int rchild = 0;
    int rx = 0;
    int ry = 0;
    int wx = 0;
    int wy = 0;
    int mask = 0;
    int ok = XQueryPointer(d, root, &rroot, &rchild, &rx, &ry, &wx, &wy, &mask);
    XCloseDisplay(d);
    if (ok == 0) { return false; }
    return (mask & bit) != 0;
    #on MAC
    return false;
    #off
    return false;
}
