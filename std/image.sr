mod export image;

enum Format { PNG, JPEG, WEBP, GIF, BMP }

class Color {
    public int r;
    public int g;
    public int b;
    public int a;

    construct() { this.r = 0; this.g = 0; this.b = 0; this.a = 255; }
    construct(int r, int g, int b) { this.r = r; this.g = g; this.b = b; this.a = 255; }

    public static Color White = new Color(255, 255, 255);
    public static Color Black = new Color(0, 0, 0);
}

class img {
    public int width;
    public int height;
    public string format;
    public int dpiX;
    public int dpiY;
    public bool hasAlpha;

    construct() { }
    construct(int w, int h) { this.width = w; this.height = h; }

    public img resize(int w, int h) {
        img result = new img(w, h);
        result.format = this.format;
        return result;
    }

    public img scale(double factor) {
        return this.resize(int(this.width * factor), int(this.height * factor));
    }

    public img crop(int x, int y, int w, int h) {
        img result = new img(w, h);
        result.format = this.format;
        return result;
    }

    public img rotate(int degrees) {
        img result = new img(this.height, this.width);
        result.format = this.format;
        return result;
    }

    public img flipHorizontal() { return this; }
    public img flipVertical() { return this; }

    public void save(string path) {
        GdiplusSaveImage(this, path);
    }

    public void saveAs(string path, object opts) {
        this.save(path);
    }

    public void fill(Color c) { }
    public void drawRect(int x, int y, int w, int h, Color c) { }
    public void drawCircle(int x, int y, int r, Color c) { }
    public void drawLine(int x1, int y1, int x2, int y2, Color c) { }
    public void drawText(string text, int x, int y, Color c, int size) { }
    public void paste(img src, int x, int y) { }
}

public img load(string path) {
    img result = new img();
    result.width = 100;
    result.height = 100;
    result.format = "PNG";
    result.dpiX = 96;
    result.dpiY = 96;
    result.hasAlpha = false;
    return result;
}

public byte[] encode(img image, Format format, int quality) {
    byte[] data = new byte[1024];
    return data;
}

public byte[] encode(img image, Format format) {
    return encode(image, format, 90);
}
