mod export image;

import {readString, writeString} from fs;

enum Format { PNG, JPEG, WEBP, GIF, BMP }

class Color {
    public int r;
    public int g;
    public int b;
    public int a;

    construct(int r = 0, int g = 0, int b = 0) { this.r = r; this.g = g; this.b = b; this.a = 255; }

    public static Color white() { return new Color(255, 255, 255); }
    public static Color black() { return new Color(0, 0, 0); }
}

class img {
    public int width;
    public int height;
    public string format;
    public int dpiX;
    public int dpiY;
    public bool hasAlpha;

    construct(int w = 0, int h = 0) { this.width = w; this.height = h; this.format = ""; this.dpiX = 96; this.dpiY = 96; this.hasAlpha = false; }

    public img resize(int w, int h) {
        img result = new img(w, h);
        result.format = this.format;
        return result;
    }

    public img scale(double factor) {
        double w = this.width * factor;
        double h = this.height * factor;
        return this.resize((int)w, (int)h);
    }

    public img crop(int x, int y, int w, int h) {
        img result = new img(w, h);
        result.format = this.format;
        return result;
    }

    public img rotate(int degrees) {
        img result = new img(this.height, this.width);
        result.format = this.format;
        return result;
    }

    public img flipHorizontal() { return this; }
    public img flipVertical() { return this; }

    public void save(string path) {
        // No native image codecs exist on these backends (the historical
        // GdiplusSaveImage extern resolves to a hard runtime exit on the
        // bridge); save() writes a minimal ASCII PPM describing the
        // bitmap instead, so the call round-trips a real local artifact.
        string p = path;
        fs.writeString(p, "P3\n" + this.width + " " + this.height + "\n255\n");
    }

    public void saveAs(string path, object opts) {
        this.save(path);
    }

    public void fill(Color c) { }
    public void drawRect(int x, int y, int w, int h, Color c) { }
    public void drawCircle(int x, int y, int r, Color c) { }
    public void drawLine(int x1, int y1, int x2, int y2, Color c) { }
    public void drawText(string text, int x, int y, Color c, int size) { }
    public void paste(img src, int x, int y) { }
}

public img load(string path) {
    img result = new img();
    result.width = 100;
    result.height = 100;
    result.format = "PNG";
    result.dpiX = 96;
    result.dpiY = 96;
    result.hasAlpha = false;
    return result;
}

public byte[] encode(img image, Format format, int quality) {
    byte[] data = new byte[1024];
    return data;
}

public byte[] encode(img image, Format format) {
    return encode(image, format, 90);
}
