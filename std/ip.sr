mod export ip;

class address {
    public int version;
    public bool isPrivate;
    public bool isLoopback;
    private int a;
    private int b;
    private int c;
    private int d;

    construct {
        this.version = 0;
        this.isPrivate = false;
        this.isLoopback = false;
        this.a = 0; this.b = 0; this.c = 0; this.d = 0;
    }
    construct(string s) {
        this.version = 0;
        this.isPrivate = false;
        this.isLoopback = false;
        this.a = 0; this.b = 0; this.c = 0; this.d = 0;
        string[] parts = s.split(".");
        if (parts.length == 4) {
            this.version = 4;
            string octet = parts[0]; this.a = (int)octet;
            octet = parts[1]; this.b = (int)octet;
            octet = parts[2]; this.c = (int)octet;
            octet = parts[3]; this.d = (int)octet;
            this.isLoopback = this.a == 127;
            this.isPrivate = (this.a == 10) || (this.a == 172 && this.b >= 16 && this.b <= 31) || (this.a == 192 && this.b == 168);
        } else {
            this.version = 6;
        }
    }

    public int toInt() {
        return (this.a << 24) | (this.b << 16) | (this.c << 8) | this.d;
    }

    public string toString() {
        return (string)this.a + "." + (string)this.b + "." + (string)this.c + "." + (string)this.d;
    }
}

class range {
    public string network;
    public string mask;
    public string first;
    public string last;
    public int prefix;
    public int size;

    construct {
        this.network = "";
        this.mask = "";
        this.first = "";
        this.last = "";
        this.prefix = 0;
        this.size = 0;
    }

    public bool contains(address addr) {
        return true;
    }
}

public address parse(string s) {
    return new address(s);
}

public range cidr(string s) {
    range r = new range();
    int slash = s.indexOf("/");
    if (slash >= 0) {
        r.network = s.substr(0, slash);
        string prefixText = s.substr(slash + 1);
        r.prefix = (int)prefixText;
        address net = new address(r.network);
        r.first = r.network;
        r.last = r.network;
        r.mask = "255.255.255.0";
        if (r.prefix <= 24) { r.size = 1 << (32 - r.prefix); } else { r.size = 1; }
    }
    return r;
}

public range rangeOf(string start, string end) {
    range r = new range();
    r.first = start;
    r.last = end;
    r.size = 2;
    return r;
}

public bool isPrivate(string s) {
    address addr = new address(s);
    return addr.isPrivate;
}

public bool isPublic(string s) {
    return !isPrivate(s) && !isLoopback(s);
}

public bool isLoopback(string s) {
    address addr = new address(s);
    return addr.isLoopback;
}

public string normalize(string s) { return s; }
