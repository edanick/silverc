mod export events;

class event {
    public string name;
    public object data;

    construct(string name, object data) {
        this.name = name;
        this.data = data;
    }
}

class listener {
    private string eventName;
    private emitter parent;

    construct(string ev, emitter p) {
        this.eventName = ev;
        this.parent = p;
    }

    public void off() {
        this.parent.off(this.eventName);
    }
}

class handler {
    public string name;
    public void () callback;

    construct(string name, void () callback) {
        this.name = name;
        this.callback = callback;
    }
}

class emitter {
    private handler[] handlers;
    private handler[] onceHandlers;
    private void () errorHandler;

    public event currentEvent;
    public string errorEventName;
    public exception errorException;

    construct {
        this.handlers = [];
        this.onceHandlers = [];
    }

    public listener on(string name, void () callback) {
        this.handlers.push(new handler(name, callback));
        return new listener(name, this);
    }

    public void once(string name, void () callback) {
        this.onceHandlers.push(new handler(name, callback));
    }

    public void onAsync(string name, void () callback) {
        this.on(name, callback);
    }

    public void onError(void () callback) {
        this.errorHandler = callback;
    }

    public void emit(string name, object data) {
        this.currentEvent = new event(name, data);
        string[] parts = name.split(".");
        string wildcard = parts[0] + ".*";

        for (int i = 0; i < this.handlers.length; i++) {
            if (this.handlers[i].name == name) {
                try { this.handlers[i].callback(); } catch (exception ex) {
                    if (this.errorHandler != null) {
                        this.errorEventName = name;
                        this.errorException = ex;
                        this.errorHandler();
                    }
                }
            }
        }
        for (int i = 0; i < this.handlers.length; i++) {
            if (this.handlers[i].name == wildcard) {
                try { this.handlers[i].callback(); } catch (exception ex) {
                    if (this.errorHandler != null) {
                        this.errorEventName = name;
                        this.errorException = ex;
                        this.errorHandler();
                    }
                }
            }
        }

        handler[] remaining = [];
        for (int i = 0; i < this.onceHandlers.length; i++) {
            if (this.onceHandlers[i].name == name) {
                try { this.onceHandlers[i].callback(); } catch (exception ex) {
                    if (this.errorHandler != null) {
                        this.errorEventName = name;
                        this.errorException = ex;
                        this.errorHandler();
                    }
                }
            } else {
                remaining.push(this.onceHandlers[i]);
            }
        }
        this.onceHandlers = remaining;
    }

    public void emit(string name, object data, object context) {
        this.emit(name, data);
    }

    public void off(string name) {
        handler[] remaining = [];
        for (int i = 0; i < this.handlers.length; i++) {
            if (this.handlers[i].name != name) {
                remaining.push(this.handlers[i]);
            }
        }
        this.handlers = remaining;
    }
}

public emitter global = new emitter();
