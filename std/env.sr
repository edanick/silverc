mod export env;

// DOCS -- public `env` module. This is the universal, portable
// environment-variable library -- one module, one OS layer (env ->
// win32.kernel32). Every kernel32 call lives inline in the `#on
// WINDOWS` region of the public function that needs it, one unified function
// name per operation, no win-prefixed helpers, no wrapper indirection, no
// alias imports; OS selection is compile-time via the preprocessor regions,
// so the runtime `os.type` check is not used here.
//
// BEHAVIOR NOTES: get() sizes the value with a (key, null, 0) call
// -- 0 means the variable is unset and yields "" -- then fills a heap buffer
// with the value. set() forwards to kernel32!SetEnvironmentVariableA. keys()
// walks the double-NUL-terminated GetEnvironmentStringsA block, keeping the
// "NAME=VALUE" entries' name halves until the block's empty entry terminates
// the walk, then frees the block with FreeEnvironmentStringsA.
//
// DISPATCH NOTE: silverc-rs answers `env.get(...)`
// with its native builtin (stdlib/fs.rs gen_getenv -> GetEnvironmentVariableA)
// before any module source is consulted, and it never collects this file (env
// is in main.rs's builtin_modules_set), so the bodies below are dead code
// there; the self-hosted compiler has no native env.set/env.keys builtins and
// dispatches those calls to these globals (`env.get`/`env.getenv` stays
// natively dispatched by mini_cg's genGetEnvCall). Both
// paths produce the same behavior.
//
// LINUX BACKEND (Phase B): set() forwards to setenv and records the pair
// in a module overlay; get() serves the overlay first, then falls back to
// parsing /proc/self/environ (NUL-separated NAME=VALUE entries, the same
// shape as the GetEnvironmentStringsA block the WINDOWS body walks) with
// open/read/close. The overlay exists because a runtime setenv() writes new
// heap strings /proc/self/environ never shows, while the getenv() pointer
// cannot be read safely from Silver (unbounded C-string reads overrun into
// unmapped memory; bare strlen() is natively intercepted on both compilers
// and never reaches the libc grant). keys() merges both sources. Headless/
// SSH needs nothing special: setenv and /proc work without a desktop
// session or DBus. Separator/case notes do not apply to variable names;
// values keep whatever bytes the OS holds.

#on WINDOWS
import * from win32.kernel32;
#off
#on LINUX
import * from linux.libc;
#off

// Overlay for values set at runtime (see the LINUX BACKEND note): parallel
// key/value lists, later sets overwrite in place (the setenv overwrite=1
// posture). Ungated declarations: plain state, no OS code. Inline
// initializers (no module construct): a module-level construct() body is
// used by fs.sr, but inline `= []` keeps this module construct-free.
string[] ovKeys = [];
string[] ovVals = [];

public string get(string key) {
    #on WINDOWS
    int size = GetEnvironmentVariableA(key, null, 0);
    if (size == 0) { return ""; }
    byte[] buf = new byte[size];
    GetEnvironmentVariableA(key, buf, size);
    string r = "";
    foreach (byte b in buf) { if (b != 0) { r += char(b); } }
    return r;
    #off
    #on LINUX
    int hit = ovIndexOf(key);
    if (hit >= 0) { return ovVals[hit]; }
    return procEnvironValue(key);
    #off
    return "";
}

public void set(string key, string val) {
    #on WINDOWS
    SetEnvironmentVariableA(key, val);
    #off
    #on LINUX
    setenv(key, val, 1);
    int hit = ovIndexOf(key);
    if (hit >= 0) {
        ovVals[hit] = val;
    } else {
        ovKeys.add(key);
        ovVals.add(val);
    }
    #off
}

public string[] keys() {
    #on WINDOWS
    string block = GetEnvironmentStringsA();
    string[] result = [];
    int start = 0;
    for (int i = 0; i < block.length(); i++) {
        if (block[i] == '\0') {
            string entry = block.substr(start, i - start);
            if (entry.length() == 0) { break; }
            int eq = entry.indexOf("=");
            if (eq >= 0) { result.add(entry.substr(0, eq)); }
            start = i + 1;
        }
    }
    FreeEnvironmentStringsA(block);
    return result;
    #off
    #on LINUX
    // NUL bytes cannot ride string concat (they are dropped), so the parse
    // walks the raw read bytes and only materializes NUL-free entry
    // strings; the walk mirrors the WINDOWS block walk entry-for-entry.
    // Overlay keys set at runtime are merged last (a runtime setenv never
    // reaches /proc).
    string[] result = readProcEnvironNames();
    for (int i = 0; i < ovKeys.length; i++) {
        string k = ovKeys[i];
        int seen = 0;
        for (int j = 0; j < result.length; j++) {
            if (result[j] == k) { seen = 1; }
        }
        if (seen == 0) { result.add(k); }
    }
    return result;
    #off
    return [];
}

// Index of key in the runtime overlay, or -1. Pure Silver, ungated.
int ovIndexOf(string key) {
    for (int i = 0; i < ovKeys.length; i++) {
        if (ovKeys[i] == key) { return i; }
    }
    return -1;
}

// Value of key parsed out of /proc/self/environ, or "" when absent or
// unreadable. Bytes are parsed straight out of the read buffers: an entry
// string only ever holds non-NUL bytes, so no NUL crosses a concat.
string procEnvironValue(string key) {
    #on LINUX
    if (key.length == 0) { return ""; }
    string want = key + "=";
    int fd = open("/proc/self/environ", 0, 0);
    if (fd < 0) { return ""; }
    string entry = "";
    string value = "";
    int hit = 0;
    while (true) {
        int[] chunk = new int[512];
        int n = read(fd, chunk, 4096);
        if (n <= 0) { break; }
        for (int i = 0; i < n; i++) {
            int b = (chunk[i / 8] >> ((i % 8) * 8)) & 0xFF;
            if (b == 0) {
                if (entry.length() >= want.length() && entry.substr(0, want.length()) == want) {
                    value = entry.substr(want.length());
                    hit = 1;
                    break;
                }
                entry = "";
            } else {
                entry += char(b);
            }
        }
        if (hit != 0 || n < 4096) { break; }
    }
    close(fd);
    return value;
    #off
    return "";
}

// Reads /proc/self/environ (NUL-separated NAME=VALUE entries) and returns
// the entry NAME halves. Bytes are parsed straight out of the read buffers:
// an entry string only ever holds non-NUL bytes, so no NUL crosses a
// concat. Returns [] when the file cannot be opened.
string[] readProcEnvironNames() {
    #on LINUX
    string[] names = [];
    int fd = open("/proc/self/environ", 0, 0);
    if (fd < 0) { return names; }
    string entry = "";
    while (true) {
        int[] chunk = new int[512];
        int n = read(fd, chunk, 4096);
        if (n <= 0) { break; }
        for (int i = 0; i < n; i++) {
            int b = (chunk[i / 8] >> ((i % 8) * 8)) & 0xFF;
            if (b == 0) {
                if (entry.length() > 0) {
                    int eq = entry.indexOf("=");
                    if (eq >= 0) { names.add(entry.substr(0, eq)); }
                    entry = "";
                }
            } else {
                entry += char(b);
            }
        }
        if (n < 4096) { break; }
    }
    close(fd);
    if (entry.length() > 0) {
        int eq = entry.indexOf("=");
        if (eq >= 0) { names.add(entry.substr(0, eq)); }
    }
    return names;
    #off
    string[] empty = [];
    return empty;
}
