import * from os;
import * from env_win;

mod export env;

// DOCS -- public `env` module (UNIFIED_CORE_LIBRARY.md Phase 2). This is the
// unified, portable front of the environment-variable library. It contains
// ZERO win32 imports: every kernel32 call moved verbatim into the internal
// Windows backend std/env_win.sr, and every DLL-backed entry below routes
// through the OS gate `if (osType() == OSTypes.WINDOWS)` before touching it.
//
// The gate uses osType() (std/os.sr) instead of the native `os.type` query
// because the self-hosted backend's builtin `os` dispatch covers only
// os.name/os.version/os.build today -- `os.type` miscompiles there in both
// spellings (property access yields a null string, the call form falls into
// builtin dispatch and returns garbage). osType() is plain Silver: it
// returns the OSTypes.WINDOWS contract value on every implementation without
// needing native support, and it can be switched to the native query once
// mini_cg learns a `type` branch.
//
// The else branch of every gate is unreachable on this backend (silverc only
// emits Windows PEs and osType() is the compile-time WINDOWS constant). For
// a future non-Windows backend the fallbacks follow this module's existing
// failure style: "" for get (the documented unset-variable result) and an
// empty list for keys, with set a silent no-op.
//
// DISPATCH NOTE (per compiler, unchanged by this split): silverc-rs answers
// `env.get(...)` with its native builtin (stdlib/fs.rs gen_getenv ->
// GetEnvironmentVariableA) before any module source is consulted, and it
// never collects this file (env is in main.rs's builtin_modules_set), so the
// wrapper bodies below are dead code there; the self-hosted compiler has no
// native env.set/env.keys builtins and dispatches those calls to these
// globals, which forward into the internal backend (`env.get`/`env.getenv`
// stays natively dispatched by mini_cg's genGetEnvCall exactly as before).
// Both paths produce the same behavior.

public string get(string key) {
    if (osType() == OSTypes.WINDOWS) {
        return envWinGet(key);
    }
    return "";
}

public void set(string key, string val) {
    if (osType() == OSTypes.WINDOWS) {
        envWinSet(key, val);
    }
}

public string[] keys() {
    if (osType() == OSTypes.WINDOWS) {
        return envWinKeys();
    }
    return [];
}
