import * from win32.kernel32;

mod export env;

public string get(string key) {
    int size = GetEnvironmentVariableA(key, null, 0);
    if (size == 0) { return ""; }
    char buf[size];
    GetEnvironmentVariableA(key, buf, size);
    string r = "";
    foreach (char c in buf) { if (c != '\0') { r += c; } }
    return r;
}

public void set(string key, string val) << SetEnvironmentVariableA(key, val);

public string[] keys() {
    string block = GetEnvironmentStringsA();
    string[] result = [];
    int start = 0;
    for (int i = 0; i < block.length(); i++) {
        if (block[i] == '\0') {
            string entry = block.substr(start, i - start);
            if (entry.length() == 0) { break; }
            int eq = entry.indexOf("=");
            if (eq >= 0) { result.add(entry.substr(0, eq)); }
            start = i + 1;
        }
    }
    FreeEnvironmentStringsA(block);
    return result;
}
