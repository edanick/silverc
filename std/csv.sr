mod export csv;
import {readString, writeString} from fs;

// DOCS -- public `csv` module.
//
// Pure Silver -- no OS code, no preprocessor regions. All storage fields
// are `= []`-initialized inside their constructs (row's former kvp storage
// is two parallel string[] arrays, the same shape sql.sr's row and
// mongo.sr's doc use; http_server.sr's local headermap is the same shape),
// and every plain string[] field gets an explicit `= []`. Uninitialized
// class storage is a latent trap on both compilers: silverc-rs silently
// swallows writes to it and the self-hosted compiler dies inside the
// construct's first store, so the parallel-array shape is mandatory here.
// Field NAMES of the private storages are not public, so the shapes are
// invisible to callers.
//
// API (see each declaration): class row -- construct(string[], string[]),
// get(string) -> string (the matching value, or null when the name is
// absent -- the same contract sql.sr's row gives); class document --
// construct(), public string[] headers, public row[] rows; class writer --
// header(string[]), row(string[]), addLine(string), stringify() -> string;
// free functions parse(string) -> document, load(string) -> document,
// save(string, document). The writer's CSV-quoting rule: quote when the
// value contains a comma, quote, or newline; internal quotes doubled.
//
// LANDMINES SHAPING THE BODIES (all probed, see the sibling modules): the
// `.length` PROPERTY form everywhere (the `.length()` CALL form reads
// garbage on the self-host); string fields/elements copied to locals
// before concatenation (rs stringifies the pointer in expression
// position).
//
// CLASS-NAME/METHOD-NAME COLLISION LANDMINE (probed 2026-09): on the
// SELF-HOSTED compiler, a method whose name equals a class declared in the
// same file is a SILENT NO-OP when invoked -- the body never runs (probed
// standalone: class `row` + `wcopy.row(string[])` -> the push count stayed
// 0 and a printline at the top of the body never appeared; silverc-rs ran
// the same probe correctly). Declaration order does not matter; the class
// being merely declared is enough; single-file AND module-aggregate builds
// are both affected. csv's PUBLIC API contains the collision by design
// (class `row` AND writer.row), so writer.row cannot be fixed from this
// file: on the self-host it is a silent no-op (rows never append;
// stringify() then emits only the header line). On silverc-rs writer.row
// works fully. WORKAROUND so the FILE-level API still works everywhere:
// save() serializes through the collision-free writer.addLine(string)
// (both paths share the private quoteField helper), so save/load round
// trips are byte-identical on BOTH compilers; only a hand-rolled
// writer.row()+stringify() chain is self-host-dead (use save(), or add
// lines via addLine).
class row {
    // Storage as two parallel arrays: one entry per header, inserted in
    // header order. Both arrays are `= []`-initialized in the construct --
    // uninitialized class storage is a latent trap on both compilers (see
    // the module header).
    private string[] names;
    private string[] values;

    construct(string[] headers, string[] values) {
        this.names = [];
        this.values = [];
        for (int i = 0; i < headers.length && i < values.length; i++) {
            this.names.push(headers[i]);
            this.values.push(values[i]);
        }
    }

    // The value stored under `name`, or null when the name is absent (the
    // same contract sql.sr's row gives). save() only queries the
    // document's own headers, so well-formed documents never hit the null.
    public string get(string name) {
        for (int i = 0; i < this.names.length; i++) {
            if (this.names[i] == name) { return this.values[i]; }
        }
        return null;
    }
}

class document {
    public string[] headers;
    public row[] rows;

    construct {
        this.headers = [];
        this.rows = [];
    }
}

class writer {
    private string[] headers;
    private string[] currentRow;
    private string[] rows;

    // All three fields are `= []`-initialized here -- uninitialized class
    // storage is a latent trap on both compilers, and the first
    // this.rows.push() on null storage access-violates. currentRow is
    // private and reserved for future use; it is initialized with the
    // rest.
    construct {
        this.headers = [];
        this.currentRow = [];
        this.rows = [];
    }

    public void header(string[] h) { this.headers = h; }

    // Quote-and-append one CSV line. On the self-host this member is a
    // SILENT NO-OP (its name collides with the class `row` -- see the
    // collision landmine in the module header); silverc-rs runs it fully.
    public void row(string[] values) {
        string line = "";
        for (int i = 0; i < values.length; i++) {
            if (i > 0) { line += ","; }
            string v = values[i];
            line += quoteField(v);
        }
        this.rows.push(line);
    }

    // Appends one already-serialized CSV line -- the collision-free path
    // save() serializes through (see the collision landmine). The line is
    // appended verbatim; callers quote via quoteField first.
    public void addLine(string line) {
        this.rows.push(line);
    }

    public string stringify() {
        string result = "";
        for (int i = 0; i < this.headers.length; i++) {
            if (i > 0) { result += ","; }
            result += this.headers[i];
        }
        result += "\n";
        for (int ri = 0; ri < this.rows.length; ri++) {
            string r = this.rows[ri];
            result += r + "\n";
        }
        return result;
    }
}

public document parse(string raw) {
    document doc = new document();
    string[] lines = raw.split("\n");
    if (lines.length == 0) { return doc; }

    doc.headers = parseLine(lines[0]);
    for (int i = 1; i < lines.length; i++) {
        if (lines[i].trim().length == 0) { continue; }
        string[] values = parseLine(lines[i]);
        doc.rows.push(new row(doc.headers, values));
    }
    return doc;
}

public document load(string path) {
    string content = fs.readString(path);
    return parse(content);
}

// The writer's CSV-quoting rule, extracted verbatim so writer.row and
// save() share one implementation: quote when the value contains a comma,
// quote, or newline; internal quotes doubled.
private string quoteField(string v) {
    if (v.indexOf(",") >= 0 || v.indexOf("\"") >= 0 || v.indexOf("\n") >= 0) {
        return "\"" + v.replace("\"", "\"\"") + "\"";
    }
    return v;
}

public void save(string path, document doc) {
    writer w = new writer();
    w.header(doc.headers);
    foreach (row r in doc.rows) {
        string[] vals = [];
        for (int hi = 0; hi < doc.headers.length; hi++) {
            string h = doc.headers[hi];
            vals.push(r.get(h));
        }
        // Serialized through addLine, not w.row(): the row-name collision
        // makes w.row a silent no-op on the self-host (see the module
        // header) -- save() must work on both compilers.
        string line = "";
        for (int vi = 0; vi < vals.length; vi++) {
            if (vi > 0) { line += ","; }
            string v = vals[vi];
            line += quoteField(v);
        }
        w.addLine(line);
    }
    fs.writeString(path, w.stringify());
}

private string[] parseLine(string line) {
    string[] fields = [];
    string current = "";
    bool inQuotes = false;
    for (int i = 0; i < line.length; i++) {
        char c = line[i];
        if (inQuotes) {
            if (c == '"') {
                if (i + 1 < line.length && line[i + 1] == '"') {
                    current += '"'; i++;
                } else {
                    inQuotes = false;
                }
            } else {
                current += c;
            }
        } else {
            if (c == '"') {
                inQuotes = true;
            } else if (c == ',') {
                fields.push(current);
                current = "";
            } else {
                current += c;
            }
        }
    }
    fields.push(current);
    return fields;
}
