import * from net;

mod export ftps;

// DOCS -- public `ftps` module (UNIFIED_CORE_LIBRARY.md §4 rule 7). This is
// a PROTOCOL module: it contains ZERO OS code and no preprocessor regions
// -- every byte on the wire moves through the universal socket core
// std/net.sr (connectRaw/sendRawLen/recvRaw/closeRaw); the ws2_32 code
// lives inside net's own `#on WINDOWS` regions.
//
// DISPATCH: `ftps` is builtin-reserved on NEITHER compiler --
// silverc-rs's builtin_modules_set (src/main.rs:81 lists
// fs/json/yaml/env/url/hash/path/bom/console/math/http only) and the
// self-hosted compiler's visBuiltinModule (compiler/visibility.sr:605) plus
// its driver prepend list all exclude it. Both compilers resolve
// `import * from ftps;` as an ORDINARY SOURCE module (std/ftps.sr); no
// native dispatch exists. (The "ftps://" strings in both compilers' url
// builtins are URL-scheme checks, unrelated to this module.)
//
// TLS: TLS support is stored-and-inert. The enums exist and
// setTLS/setCA/setVerifyMode initialize their fields to defaults, but no
// TLS stack exists behind this module -- no handshake, no certificate
// code, no SCHANNEL grant (a real TLS stack is a separate feature). What
// login/transfer actually do: login() opens a bare socket and runs the
// plain USER/PASS exchange (no AUTH TLS), download() streams RETR over
// the PASV data channel into the local file, and upload() sends STOR and
// the file bytes over the data channel. Consequence: this client speaks
// PLAIN FTP on the wire. Against an FTPS-only server that demands AUTH
// TLS before authentication, login() fails gracefully at the USER step
// and the server's reply is surfaced through getLastReply(); against a
// classic FTP server it works end to end.
//
// TRANSPORT:
// - The control channel: net.connectRaw + USER/PASS. login() reads and
//   validates the greeting (220), sends USER (331, or 230 = server skips
//   PASS) and PASS (230), and records the outcome in isLoggedIn()/
//   getLastReply(). getLastReply() exposes the raw last server reply;
//   isLoggedIn() is true only after a fully accepted USER/PASS exchange.
//   Against a non-FTP listener the login fails gracefully: the server's
//   banner (or "" after a silent disconnect) is surfaced through
//   getLastReply() and the process exits cleanly. No exceptions anywhere.
// - list(): opens a real PASV data channel (net.connectRaw for the second
//   connection), sends LIST and returns the data-channel lines split on
//   "\r\n" (a trailing CRLF yields a trailing "" element -- the same shape
//   std/ftp.sr produces).
// - download()/upload(): download() streams RETR over the data channel
//   into the local file; upload() sends STOR and the file bytes over the
//   data channel. The fs.* receiver is the native/builtin fs on both
//   compilers (std/crypto.sr and std/csv.sr use the same shape).
// - Bounded reads: every socket this module opens -- control and data
//   alike -- gets a 30 s receive timeout via net.setRecvTimeoutRaw(fd,
//   30000) (net arms SO_RCVTIMEO). readReply()'s accumulation loop is
//   additionally bounded at 16 iterations and readAll() at 4096 x 64 KB
//   (~256 MB) so no path can spin forever even against a peer that never
//   closes.
// - QUIT: close() sends QUIT and closes immediately without waiting for
//   the 221, so a dead peer cannot stall close().
//
// SCOPE: ftps is STANDALONE -- it imports only net and does not import
// ftp or share code with it. The pure protocol helpers below are copies
// of std/ftp.sr's helpers (verified byte-identical for ftps on both
// compilers) rather than imports, avoiding the cross-module int[]-helper
// dispatch trap documented in std/ftp.sr. Do not "deduplicate" them
// across the two modules without re-proving the cross-module dispatch on
// silverc-rs.
//
// PUBLIC API: enum TLSMode { Explicit, Implicit } and enum VerifyMode
// { None, Strict } -- spelled `def X = enum { ... };` because a top-level
// C-style `enum X { ... }` is REJECTED by silverc-rs ("Unexpected
// token 'Enum'"; the self-host accepts both forms, probed). The observable
// values are identical either way: members auto-increment from 0
// (DOCS/212), so Explicit=0/Implicit=1 and None=0/Strict=1 on both
// compilers. client.construct(string host, int port) takes the port, so
// unlike std/ftp.sr no setPort is needed; setTLS(TLSMode); setCA(string);
// setVerifyMode(VerifyMode) (all three stored-and-inert); login(string
// user, string pass); list(string path) -> string[]; download(string
// remote, string localPath); upload(string localPath, string remote)
// (the second parameter is spelled localPath, not `local` -- `local` is a
// reserved word on silverc-rs; parameter names are invisible to
// positional callers); close(). getLastReply() exposes the raw last
// server reply; isLoggedIn() is true only after a fully accepted
// USER/PASS exchange. The private sendCmd/recvResp helpers keep their
// raw-bytes shapes; the multi-line reply accumulation lives in the
// private readReply (the std/ftp.sr shape), and construct() initializes
// sock to -1 and caPath to "" so close() on a never-connected client is
// safe.
//
// CALLER NOTES: instantiate the client with `var c = new client(...);` --
// a lowercase class arriving from a star-imported module cannot be spelled
// as a local's type on silverc-rs (per-file parsing: `client c` dies with
// "unknown keyword"; `new mod.client()` dies on BOTH compilers; `var`
// works on both, probed). Strings returned across this module's boundary
// (getLastReply) should be assigned to a local before being concatenated
// into larger expressions (silverc-rs stringifies the return pointer in
// expression position; see std/dns.sr's RS-ONLY CALLER LANDMINE). There
// is no server class (use std/ftp.sr's server if a plain-FTP listener is
// needed).

def TLSMode = enum { Explicit, Implicit };

def VerifyMode = enum { None, Strict };

public int replyCode(string resp) {
    if (resp.length < 3) { return -1; }
    int code = 0;
    for (int i = 0; i < 3; i++) {
        int c = resp[i] & 0xFF;
        if (!isDigit(c)) { return -1; }
        code = code * 10 + (c - 48);
    }
    return code;
}

// True when `resp` already contains a terminating FTP reply line: some
// "\r\n"-delimited line whose first three chars are digits and whose fourth
// char is a space (RFC 959's "nnn " terminal form). Multi-line replies
// ("nnn-text ... nnn text") complete only at the space form, so the
// module's readers keep accumulating until this fires or the bounded
// loop exhausts.
public bool replyComplete(string resp) {
    int lineStart = 0;
    for (int i = 0; i < resp.length; i++) {
        if (resp[i] == 13 && i + 1 < resp.length && resp[i + 1] == 10) {
            int lineLen = i - lineStart;
            if (lineLen >= 4) {
                if (isDigit(resp[lineStart] & 0xFF) && isDigit(resp[lineStart + 1] & 0xFF) && isDigit(resp[lineStart + 2] & 0xFF) && resp[lineStart + 3] == 32) {
                    return true;
                }
            }
            i++;
            lineStart = i + 1;
        }
    }
    return false;
}

// Extracts the PASV host "h1.h2.h3.h4" from a "227 ... (h1,h2,h3,h4,p1,p2)"
// reply ("" on any malformed input).
public string pasvHost(string reply) {
    int[] nums = new int[6];
    int count = pasvNums(reply, nums);
    if (count != 6) { return ""; }
    return nums[0] + "." + nums[1] + "." + nums[2] + "." + nums[3];
}

// Extracts the PASV port p1*256+p2 from the same reply (-1 on malformed
// input). Deliberately *256, not a shift: shift expressions inside
// one-liner methods are unreliable on the self-hosted compiler.
public int pasvPort(string reply) {
    int[] nums = new int[6];
    int count = pasvNums(reply, nums);
    if (count != 6) { return -1; }
    return nums[4] * 256 + nums[5];
}

private bool isDigit(int c) {
    return c >= 48 && c <= 57;
}

// Scans the parenthesized section of a PASV reply for its integer tokens
// ("h1,h2,h3,h4,p1,p2"), storing the first six into `dest` and returning
// how many were found -- callers require exactly 6, anything else means
// the reply was not a well-formed PASV echo.
// NOTE: deliberately scans reply[i] by index (NO substr) and fills a
// caller-owned array (NO int[] return value). silverc-rs's two-arg
// substr(start, X) treats X as an END offset while the self-host treats it
// as a LENGTH -- identical only when start is 0 (see
// silverc-rs/src/string_ops.rs emit_string_substring), so substring
// extraction here would silently disagree across compilers. And a helper
// RETURNING an int[] mis-dispatches across a module boundary on
// silverc-rs (std/ftp.sr's probe: the count arrived 0 for valid input on
// rs while the self-host returned 6). Same-module here, the shape is the
// probed-safe one from std/ftp.sr either way.
private int pasvNums(string reply, int[] dest) {
    int open = reply.indexOf("(");
    if (open < 0) { return 0; }
    int closeIdx = reply.indexOf(")");
    if (closeIdx < 0 || closeIdx < open) { return 0; }
    int count = 0;
    int val = 0;
    bool inNum = false;
    for (int i = open + 1; i < closeIdx; i++) {
        int c = reply[i] & 0xFF;
        if (isDigit(c)) {
            val = val * 10 + (c - 48);
            inNum = true;
        } else {
            if (inNum) {
                if (count < 6) { dest[count] = val; }
                count++;
                val = 0;
                inNum = false;
            }
        }
    }
    if (inNum) {
        if (count < 6) { dest[count] = val; }
        count++;
    }
    return count;
}

class client {
    private string host;
    private int port;
    private TLSMode tlsMode;
    private string caPath;
    private VerifyMode verifyMode;
    private int sock;
    private string lastReply;
    private bool loggedIn;

    construct(string host, int port) {
        this.host = host;
        this.port = port;
        this.tlsMode = TLSMode.Explicit;
        this.verifyMode = VerifyMode.Strict;
        this.caPath = "";
        this.sock = -1;
        this.lastReply = "";
        this.loggedIn = false;
    }

    // Stored and NEVER read: no handshake consults tlsMode, so Explicit vs
    // Implicit changes nothing. No TLS stack exists behind this module.
    public void setTLS(TLSMode mode) { this.tlsMode = mode; }

    // Stored and NEVER read: no certificate store exists in this module.
    public void setCA(string path) { this.caPath = path; }

    // Stored and NEVER read: no verification is performed (there is no
    // TLS layer to verify against).
    public void setVerifyMode(VerifyMode mode) { this.verifyMode = mode; }

    // The raw text of the last server reply on the control channel (""
    // before the first read). This is the graceful-failure surface:
    // against a non-FTP listener it holds the banner the peer sent, or ""
    // when the peer said nothing and closed.
    public string getLastReply() {
        return this.lastReply;
    }

    // True only after a fully accepted USER/PASS exchange (or a
    // 230 login-without-PASS).
    public bool isLoggedIn() {
        return this.loggedIn;
    }

    // PLAIN FTP on the wire (see TLS above): no AUTH TLS is sent.
    // An FTPS-only server that requires TLS before authentication fails the
    // USER step gracefully here.
    public void login(string user, string pass) {
        this.sock = connectRaw(this.host, this.port);
        if (this.sock < 0) {
            this.sock = -1;
            this.lastReply = "";
            return;
        }
        setRecvTimeoutRaw(this.sock, 30000);
        this.readReply();
        if (replyCode(this.lastReply) != 220) {
            this.fail();
            return;
        }
        this.sendCmd("USER " + user);
        this.readReply();
        int code = replyCode(this.lastReply);
        if (code != 331 && code != 230) {
            this.fail();
            return;
        }
        if (code != 230) {
            this.sendCmd("PASS " + pass);
            this.readReply();
            if (replyCode(this.lastReply) != 230) {
                this.fail();
                return;
            }
        }
        this.loggedIn = true;
    }

    public string[] list(string path) {
        string[] empty = [];
        if (!this.loggedIn) { return empty; }
        int data = this.openData();
        if (data < 0) { return empty; }
        this.sendCmd("LIST " + path);
        string content = this.readAll(data);
        closeRaw(data);
        this.readReply();
        return content.split("\r\n");
    }

    // NOTE: the second parameter is spelled localPath, not `local` -- `local`
    // is a reserved word on silverc-rs ("Expected expression" wherever it
    // appears as an identifier). Parameter names are invisible to positional
    // callers.
    public void download(string remote, string localPath) {
        if (!this.loggedIn) { return; }
        int data = this.openData();
        if (data < 0) { return; }
        this.sendCmd("RETR " + remote);
        string content = this.readAll(data);
        closeRaw(data);
        this.readReply();
        fs.writeString(localPath, content);
    }

    public void upload(string localPath, string remote) {
        if (!this.loggedIn) { return; }
        string content = fs.readString(localPath);
        int data = this.openData();
        if (data < 0) { return; }
        this.sendCmd("STOR " + remote);
        sendRawLen(data, content, content.length);
        closeRaw(data);
        this.readReply();
    }

    public void close() {
        if (this.sock >= 0) {
            this.sendCmd("QUIT");
            closeRaw(this.sock);
        }
        this.sock = -1;
        this.loggedIn = false;
    }

    // Sends one command line (CRLF appended). No-op on a dead channel --
    // every caller pairs it with a bounded read, so the failure surfaces
    // there instead.
    private void sendCmd(string cmd) {
        if (this.sock < 0) { return; }
        sendRawLen(this.sock, cmd + "\r\n", cmd.length + 2);
    }

    // One bounded read of the control channel (raw bytes as a string; ""
    // on disconnect/timeout).
    private string recvResp() {
        if (this.sock < 0) { return ""; }
        return recvRaw(this.sock, 4096);
    }

    // Accumulates control-channel reads into lastReply until a terminating
    // "nnn " line is seen (replyComplete), the peer goes quiet, or 16
    // reads pass -- whichever comes first. Overwrites, never appends
    // across commands: a stale reply must not leak into the next check.
    private void readReply() {
        string acc = "";
        for (int guard = 0; guard < 16; guard++) {
            string chunk = this.recvResp();
            if (chunk.length <= 0) { break; }
            acc += chunk;
            if (replyComplete(acc)) { break; }
        }
        this.lastReply = acc;
    }

    // Opens the passive data channel for a transfer: PASV on the control
    // channel, parse host/port, connect. Returns -1 (and leaves the
    // control channel open) on any failure.
    private int openData() {
        this.sendCmd("PASV");
        this.readReply();
        string host = pasvHost(this.lastReply);
        int port = pasvPort(this.lastReply);
        if (port < 0 || host.length <= 0) { return -1; }
        int data = connectRaw(host, port);
        if (data >= 0) {
            setRecvTimeoutRaw(data, 30000);
        }
        return data;
    }

    // Drains a data channel until EOF/timeout (bounded at 4096 x 64 KB
    // reads, ~256 MB -- the guard makes the loop finite even against a
    // peer that never closes).
    private string readAll(int fd) {
        string acc = "";
        for (int guard = 0; guard < 4096; guard++) {
            string chunk = recvRaw(fd, 65536);
            if (chunk.length <= 0) { break; }
            acc += chunk;
        }
        return acc;
    }

    // Drops the connection and marks the client logged out; lastReply
    // keeps whatever the server last said so the caller can surface it.
    private void fail() {
        this.loggedIn = false;
        if (this.sock >= 0) {
            closeRaw(this.sock);
        }
        this.sock = -1;
    }
}
