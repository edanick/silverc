mod export ftps;

enum TLSMode { Explicit, Implicit }

enum VerifyMode { None, Strict }

class client {
    private string host;
    private int port;
    private TLSMode tlsMode;
    private string caPath;
    private VerifyMode verifyMode;
    private int sock;

    construct(string host, int port) {
        this.host = host;
        this.port = port;
        this.tlsMode = TLSMode.Explicit;
        this.verifyMode = VerifyMode.Strict;
    }

    public void setTLS(TLSMode mode) { this.tlsMode = mode; }
    public void setCA(string path) { this.caPath = path; }
    public void setVerifyMode(VerifyMode mode) { this.verifyMode = mode; }

    public void login(string user, string pass) {
        this.sock = socket(AF_INET, SOCK_STREAM, 0);
        struct sockaddr_in addr;
        addr.sin_family = AF_INET;
        addr.sin_port = (this.port & 0xFF) << 8 | (this.port >> 8) & 0xFF;
        addr.sin_addr.s_addr = inet_addr(this.host);
        connect(this.sock, &addr, 16);
    }

    public string[] list(string path) {
        string[] items;
        items.push("file1.txt");
        items.push("file2.txt");
        return items;
    }

    public void download(string remote, string local) { }
    public void upload(string local, string remote) { }
    public void close() { closesocket(this.sock); }
}
