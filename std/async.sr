mod export async;

#on WINDOWS
import * from win32.kernel32;
#off
#on LINUX
import * from linux.libc;
#off

import {Exception} from exception;

// DOCS -- public `async` module (UNIFIED_CORE_LIBRARY.md §4). This is the
// universal async module -- one module, one OS layer
// (async -> win32.kernel32). The one DLL-backed effect this module exposes
// -- the millisecond wait behind sleep()/timeout(), a kernel32!Sleep --
// lives INSIDE each public function body behind a `#on WINDOWS` region
// (§4 rule 6): one unified function name, no win-prefixed helpers, no
// wrapper indirection. OS selection is compile-time via the preprocessor;
// the module does not use the runtime `os` check. No #else and no LINUX/MAC
// placeholders -- the other-OS regions get filled on their own machines
// later.
//
// PLAIN IMPORT: the kernel32 grant is a plain full-table
// `import * from win32.kernel32;` inside its own region -- no alias
// imports. Sleep is present in BOTH compilers' kernel32 export tables
// (silverc-rs src/win32.rs and the self-hosted compiler/mini_cg.sr kernel32
// tables), so the plain grant resolves without any table change.
//
// DISPATCH (per compiler, probed):
// `async` is a RESERVED KEYWORD token on silverc-rs (token.rs maps "async" =>
// TokenKind::Async) and the parser's module-name position only accepts
// Identifier, so `mod export async;` and `import * from async;` are hard
// parse errors there. Neither compiler reserves `async` as a builtin module
// (silverc-rs main.rs builtin_modules_set and the self-hosted
// parser/visibility tables have no native async dispatch), so no
// per-compiler call interception exists: on the self-hosted compiler, where
// `async` is an ordinary identifier (the lexer's keywordKind table has no
// async entry), every `async.*` call resolves to the collected
// globals/classes of this module. The module is SELF-HOST-ONLY: it does not
// compile on silverc-rs (the keyword rejection above).
//
// WHY THE WAITS DO NOT DELEGATE TO time (deviation, documented): delegation
// is unexpressible on the self-hosted compiler -- a module-qualified call
// `time.sleep(ms)` made from inside a module that defines its OWN `sleep`
// resolves to that local function and recurses into a stack overflow (probed
// with a minimal two-module fixture: `time.now()` from a module with no
// local `now` routes correctly, so the name collision is the trigger). The
// import-alias escape (`import {sleep as timeSleep} from time;`) is
// win32-only on the self-host ("aliased import names (X as Y) are only
// allowed on win32 imports" -- probed). This module therefore owns its
// kernel32!Sleep grant in its own region and calls Sleep(ms) inline -- the
// same shape std/time.sr uses for its own waits.
//
// GRAMMAR NOTES (probe matrix, both compilers): the fn-callback shapes below
// are the closest forms the CURRENT grammar accepts. Fn-typed props do not
// parse on the self-host (`private void callback();` fails with "expected {
// but found ;"), and the C-style `void cb()` parameter on GLOBAL functions
// fails with "expected { but found (" (both probed):
//
// - GLOBAL functions take function-typed parameters ONLY in the DOCS
//   spelling `void () name` (both compilers accept it; the `void name()`
//   spelling is rejected on both -- probed). `run` and `task` use it, and
//   invoking the parameter (`mainFunc()`) is probed end-to-end through the
//   module-qualified call `async.run((void () { ... }))`.
// - CLASS CONSTRUCTORS are the mirror image: the DOCS spelling
//   `construct(void () c)` is rejected on BOTH compilers ("expected { but
//   found c" self-host / "Expected 'identifier' but found 'LeftParen'"
//   silverc-rs), while `construct(void cb())` parses and compiles on the
//   self-host. The task constructor therefore uses that spelling -- the
//   only fn-param form constructors accept.
// - FN-TYPED PROPS do not parse on either compiler (probed), so the callback
//   slot is `private object callback` -- the object-slot idiom std/thread.sr
//   uses; a `void ()` value flows into the object slot unchanged (an 8-byte
//   address on both compilers).
// - OBJECT-SLOT CALL-THROUGH is a SILENT NO-OP on the self-hosted compiler
//   (probed): `this.callback()` compiles, exits 0, and never runs the body --
//   the worst kind of dead. awaitResult() therefore relays the slot through
//   a method fn-parameter (`this.runCallback(this.callback)`, body `c();`),
//   which is probed end-to-end: ctor fn-param -> object prop -> method
//   fn-param -> call-through fires the caller's `(void () { ... })` body.
// - STORING A CALLBACK (task/setJob): a function-typed value cannot be
//   declared as a global/local (bare `object x;` is rejected on the
//   self-host; `object` is a param/prop type only), so the slot lives on the
//   instance. The free function `task(...)` fills it through the public
//   `setJob(void () c)` method because it is the probe-proven route
//   (ctor-param store works only for a direct `new task((void () { ... }))`
//   at the call site).
//   All three working spellings (probed end-to-end, exit 0, body fires):
//       task t = task((void () { ... }));   // free function, BARE name
//       task t = new task((void () { ... })); t.awaitResult();
//   and inside the module, `new task()` + `t.setJob(cb)`.
//
//   QUALIFIED-CALL LANDMINE (self-host, probed -- read before using):
//   `async.task((void () { ... }))` -- the module-QUALIFIED spelling --
//   compiles and returns an object whose plain props read back fine
//   (isDone()/result), but the STORED callback slot is garbage and
//   t.awaitResult() dies with 0xC0000005 (access violation) on the indirect
//   call. The bare spelling `task((void () { ... }))` of the exact same
//   call, against the exact same module, fires the body. A minimal
//   two-module fixture reproduces both sides, so the trigger is the
//   qualified call spelling combined with STORING the fn argument --
//   `async.run((void () { ... }))` is qualified too and works, because run
//   INVOKES the parameter directly instead of storing it. Until the
//   self-host codegen is fixed, call the free function `task` by its bare
//   name (the star import brings it in) or construct with `new task(...)`
//   directly; only qualified calls that STORE the fn argument are affected.
//
// SEMANTICS NOTES: task.result is never assigned
// anywhere -- awaitResult() runs the callback and returns the (empty) result
// string, and `all` collects those empties; making the callback able to
// produce a value needs a string-returning fn type (`string () name`), which
// no compiler supports today, so the gap is documented rather than
// redesigned. task.completed/isDone() are likewise never set -- the fields
// are inert. Both stay so the public surface keeps its names; setJob is the
// one method added beyond the original shape (see STORING A CALLBACK above).
// TimeoutException is declared-but-never-thrown; it is part of the public
// surface.

class task {
    private bool completed;
    private string result;
    private object callback;

    construct() { }
    construct(void cb()) { this.callback = cb; }

    private void runCallback(void () c) {
        c();
    }

    public string awaitResult() {
        this.runCallback(this.callback);
        return this.result;
    }

    public void setJob(void () c) {
        this.callback = c;
    }

    public bool isDone() { return this.completed; }
}

class TimeoutException extends Exception {
    construct(string msg) { super(msg); }
}

class eventLoop {
    public void run() { }
}

public task task(void () cb) {
    task t = new task();
    t.setJob(cb);
    return t;
}

public string[] all(task t1, task t2) {
    string[] results = [];
    results.push(t1.awaitResult());
    results.push(t2.awaitResult());
    return results;
}

public string timeout(string data, int ms) {
    #on WINDOWS
    Sleep(ms);
    #off
    #on LINUX
    if (ms < 0) { return data; }
    int[] ts = new int[2];
    ts[0] = ms / 1000;
    ts[1] = (ms % 1000) * 1000000;
    int[] rem = new int[2];
    nanosleep(ts, rem);
    #off
    return data;
}

public void sleep(int ms) {
    #on WINDOWS
    Sleep(ms);
    #off
    #on LINUX
    if (ms < 0) { return; }
    int[] ts = new int[2];
    ts[0] = ms / 1000;
    ts[1] = (ms % 1000) * 1000000;
    int[] rem = new int[2];
    nanosleep(ts, rem);
    #off
}

public eventLoop getEventLoop() {
    return new eventLoop();
}

public void run(void () mainFunc) {
    mainFunc();
}
