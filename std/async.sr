mod export async;
import {sleep} from time;
import {Exception} from exception;

class task {
    private bool completed;
    private string result;
    private void callback();

    construct() { }
    construct(void cb()) { this.callback = cb; }

    public string awaitResult() {
        this.callback();
        return this.result;
    }

    public bool isDone() { return this.completed; }
}

class TimeoutException extends Exception {
    construct(string msg) { super(msg); }
}

class eventLoop {
    public void run() { }
}

public task task(void cb()) {
    return new task(cb);
}

public string[] all(task t1, task t2) {
    string[] results;
    results.push(t1.awaitResult());
    results.push(t2.awaitResult());
    return results;
}

public string timeout(string data, int ms) {
    time.sleep(ms);
    return data;
}

public void sleep(int ms) {
    time.sleep(ms);
}

public eventLoop getEventLoop() {
    return new eventLoop();
}

public void run(void mainFunc()) {
    mainFunc();
}
