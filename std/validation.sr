mod export validation;

class rules {
    private object ruleDefs;

    construct() { }

    public rules required() { return this; }
    public rules optional() { return this; }
    public rules string() { return this; }
    public rules int() { return this; }
    public rules min(int n) { return this; }
    public rules max(int n) { return this; }
    public rules min(int n, string msg) { return this; }
    public rules email() { return this; }
    public rules url() { return this; }
    public rules ip() { return this; }
    public rules phone() { return this; }
    public rules alpha() { return this; }
    public rules matches(string pat) { return this; }
    public rules in(string[] values) { return this; }
}

class error {
    public string field;
    public string message;
}

class result {
    public bool passed;
    public error[] errors;

    construct() { this.passed = true; }
}

public rules required() { return new rules().required(); }
public rules optional() { return new rules().optional(); }

public result validate(object data, rules r) {
    return new result();
}

public bool email(string val) {
    int at = val.indexOf("@");
    int dot = val.lastIndexOf(".");
    return at > 0 && dot > at && dot < val.length() - 1;
}

public bool url(string val) {
    return val.indexOf("://") > 0;
}

public bool ip(string val) {
    string[] parts = val.split(".");
    if (parts.length() != 4) { return false; }
    foreach (string p in parts) {
        int n = int(p);
        if (n < 0 || n > 255) { return false; }
    }
    return true;
}

public bool phone(string val) {
    return val.length() >= 10;
}

public bool creditCard(string val) {
    return val.length() >= 13 && val.length() <= 19;
}
