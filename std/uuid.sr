#on WINDOWS
import { SystemFunction036 as RtlGenRandom } from win32.advapi32;
#on LINUX
import * from linux.libc;
#on MAC
import * from mac.libsystem;
#off

mod export uuid;

// DOCS -- std `uuid` module. Pure Silver formatting over the advapi32
// CSPRNG. Two interop facts shape the code:
//
// 0. REGION: the aliased CSPRNG grant sits inside an `#on WINDOWS` region
//    (the last win32 import outside a region, folded per
//    UNIFIED_CORE_LIBRARY.md §2/§4 rule 6 + §8.3 item 1). The CSPRNG call
//    sites below also sit in regions; the Linux side reads getrandom(2)
//    through a plain `import * from linux.libc;` (no alias needed: no
//    `getrandom` name in this module) and the macOS side reads
//    arc4random_buf through `import * from mac.libsystem;` (getrandom(2)
//    does not exist on macOS). The pure-Silver formatting/parse
//    helpers are ungated and already portable.
//
// 1. GRANT: calls need an import grant -- both compilers reject an
//    ungated call ("unknown method RtlGenRandom"). The conventional
//    RtlGenRandom name is not a real export -- advapi32 exports it as
//    SystemFunction036 (documented alias), so the grant aliases the real
//    export to the conventional name: the PE import keeps
//    advapi32!SystemFunction036 while the calls below stay readable.
//
// 2. BUFFER LAYOUT: Silver arrays are [cap, len, elem...] with 8-byte
//    elements, so a byte[] crosses a DLL boundary as a QWORD buffer --
//    a byte[] must NOT cross a DLL boundary as a packed buffer (the
//    probed ws posture). A packed byte[16] handed to the CSPRNG
//    puts contiguous 16 bytes in the first two qword slots, so bytes[1]
//    would read the low byte of random byte 8, not byte 1. The CSPRNG
//    instead writes into a packed int[2] (two qwords = 16 wire bytes) and
//    the byte values are unpacked into one-per-slot arrays with shifts --
//    the proven packed-int layout. x64 is little-endian; byte i lives at
//    packed slot i/8, byte position i%8 (shifted low-to-high).
//
// Also: string length is spelled as the `.length` property (the property
// form is the only string-length spelling std sources use; the call form
// reads garbage on the self-host for arrays).
//
// `char(0)` is not used here; `'\0'` would lex as '0' anyway (both
// compilers' lexer quirk, see std/sysinfo.sr).

class uuid {
    public int version;
    public int variant;

    construct { this.version = 4; this.variant = 1; }

    // 16 random bytes via the CSPRNG. The byte[] result holds one byte per
    // element slot (values 0..255 stored into the qword slots -- assignment
    // is safe; only DLL-side CONTIGUOUS packed reads are the trap above).
    public byte[] toBytes() {
        int[] packed = new int[2];
        #on WINDOWS
        RtlGenRandom(packed, 16);
        #on LINUX
        getrandom(packed, 16, 0);
        #on MAC
        arc4random_buf(packed, 16);
        #off
        byte[] bytes = new byte[16];
        for (int i = 0; i < 16; i++) {
            bytes[i] = (packed[i / 8] >> ((i % 8) * 8)) & 0xFF;
        }
        return bytes;
    }
}

public string generate() {
    int[] packed = new int[2];
    #on WINDOWS
    RtlGenRandom(packed, 16);
    #on LINUX
    getrandom(packed, 16, 0);
    #on MAC
    arc4random_buf(packed, 16);
    #off
    int[] b = new int[16];
    for (int i = 0; i < 16; i++) {
        b[i] = (packed[i / 8] >> ((i % 8) * 8)) & 0xFF;
    }
    b[6] = (b[6] & 0x0F) | 0x40;
    b[8] = (b[8] & 0x3F) | 0x80;

    string hex = "0123456789abcdef";
    string result = "";
    for (int i = 0; i < 16; i++) {
        if (i == 4 || i == 6 || i == 8 || i == 10) { result += "-"; }
        result += hex[(b[i] >> 4) & 0x0F];
        result += hex[b[i] & 0x0F];
    }
    return result;
}

public string v4() { return generate(); }

public string v7() { return generate(); }

public uuid parse(string s) {
    return new uuid();
}

public uuid nil() {
    return new uuid();
}

public uuid fromBytes(byte[] bytes) {
    return new uuid();
}

public bool isValid(string s) {
    if (s.length != 36) { return false; }
    for (int i = 0; i < s.length; i++) {
        if (i == 8 || i == 13 || i == 18 || i == 23) {
            if (s[i] != '-') { return false; }
        } else {
            if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f') || (s[i] >= 'A' && s[i] <= 'F'))) {
                return false;
            }
        }
    }
    return true;
}
