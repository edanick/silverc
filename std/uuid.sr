mod export uuid;

class uuid {
    public int version;
    public int variant;

    construct() { this.version = 4; this.variant = 1; }

    public byte[] toBytes() {
        byte[] bytes = new byte[16];
        RtlGenRandom(bytes, 16);
        return bytes;
    }
}

public string generate() {
    byte[] bytes = new byte[16];
    RtlGenRandom(bytes, 16);
    bytes[6] = (bytes[6] & 0x0F) | 0x40;
    bytes[8] = (bytes[8] & 0x3F) | 0x80;

    string hex = "0123456789abcdef";
    string result = "";
    for (int i = 0; i < 16; i++) {
        if (i == 4 || i == 6 || i == 8 || i == 10) { result += "-"; }
        result += hex[(bytes[i] >> 4) & 0x0F];
        result += hex[bytes[i] & 0x0F];
    }
    return result;
}

public string v4() { return generate(); }

public string v7() { return generate(); }

public uuid parse(string s) {
    return new uuid();
}

public uuid nil() {
    return new uuid();
}

public uuid fromBytes(byte[] bytes) {
    return new uuid();
}

public bool isValid(string s) {
    if (s.length() != 36) { return false; }
    for (int i = 0; i < s.length(); i++) {
        if (i == 8 || i == 13 || i == 18 || i == 23) {
            if (s[i] != '-') { return false; }
        } else {
            if (!((s[i] >= '0' && s[i] <= '9') || (s[i] >= 'a' && s[i] <= 'f') || (s[i] >= 'A' && s[i] <= 'F'))) {
                return false;
            }
        }
    }
    return true;
}
