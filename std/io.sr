mod export io;

// DOCS -- public `io` module (see UNIFIED_CORE_LIBRARY.md).
// This is the universal standard-input module: one module, one OS layer
// (io -> win32.kernel32). The raw OS calls live INSIDE the public readLine
// body behind a `#on WINDOWS` ... `#off` region -- one unified function
// name, no win-prefixed helpers, no wrapper indirection. There is no
// `#else` and no LINUX/MAC placeholders in std; the non-Windows regions get
// filled on their own machines later. The preprocessor selects the OS code
// at compile time, so `import * from os;` is not needed here. The kernel32
// grant is a plain `import * from win32.kernel32;`; neither GetStdHandle
// nor ReadFile collides with this module's public API (readLine/input).
//
// BEHAVIOR NOTES: readLine fetches the STD_INPUT_HANDLE pseudo-handle
// (GetStdHandle(-10)) and then reads one byte per kernel32!ReadFile call,
// appending chars until '\n' and stripping '\r'. The byte-at-a-time loop,
// the empty-string-on-invalid-handle early return, and the stop-on-zero-
// bytes-read end-of-stream check define the behavior. The handle lands in a
// local first because nested grant calls as arguments are not a shape the
// backends rely on. Allocations use the codebase-standard idiom
// `byte[] buf = new byte[1];`.
//
// DISPATCH NOTE (per compiler): the self-hosted compiler intercepts plain
// `input` and `readLine` calls with its native genInputCall builtin
// (mini_cg: GetStdHandle(-10) + one ReadFile into a 4096-byte heap buffer)
// before this module's globals are consulted, so the readLine body below is
// reached there only via `io.readLine()` member calls -- the receiver "io"
// is not a builtin-module receiver, so those fall through to this file.
// silverc-rs has no native readLine and its native `input` stub (codegen.rs
// gen_input) only fires when no user-defined `input` is in scope: once
// `import * from io;` resolves, io's own functions win the func_labels
// dispatch. Both paths produce the same behavior.

#on WINDOWS
import * from win32.kernel32;
#off

public string readLine() {
    #on WINDOWS
    int stdin = GetStdHandle(-10);
    if (stdin == -1) { return ""; }
    string result = "";
    byte[] buf = new byte[1];
    int read = 0;
    while (true) {
        bool ok = ReadFile(stdin, buf, 1, &read, null);
        if (!ok || read == 0) { break; }
        char c = char(buf[0]);
        if (c == '\n') { break; }
        if (c == '\r') { continue; }
        result += c;
    }
    return result;
    #off
}

public string input() << readLine();

public string input(string prompt) {
    printline(prompt);
    return readLine();
}
