mod export io;

public string readLine() {
    int stdin = GetStdHandle(-10);
    if (stdin == -1) { return ""; }
    string result = "";
    byte[] buf[1];
    int read = 0;
    while (true) {
        bool ok = ReadFile(stdin, buf, 1, &read, null);
        if (!ok || read == 0) { break; }
        char c = char(buf[0]);
        if (c == '\n') { break; }
        if (c == '\r') { continue; }
        result += c;
    }
    return result;
}

public string input() << readLine();

public string input(string prompt) {
    printline(prompt);
    return readLine();
}
