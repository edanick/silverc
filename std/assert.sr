mod export assert;

public void assert(bool condition) {
    if (!condition) {
        printline("Assertion failed");
        exit(1);
    }
}

public void assertEq(int a, int b) {
    if (a != b) {
        printline("Assertion failed: " + a + " != " + b);
        exit(1);
    }
}

public void assertEqFloat(float64 a, float64 b) {
    if (a != b) {
        printline("Assertion failed: " + a + " != " + b);
        exit(1);
    }
}

public void assertEqStr(string a, string b) {
    if (a != b) {
        printline("Assertion failed: '" + a + "' != '" + b + "'");
        exit(1);
    }
}

public void assertNe(int a, int b) {
    if (a == b) {
        printline("Assertion failed: " + a + " == " + b);
        exit(1);
    }
}