mod export assert;

public void assert(bool condition) {
    if (!condition) {
        printline("Assertion failed at " + %cf + ":" + %cl);
        exit(1);
    }
}

public void assertEq(int a, int b) {
    if (a != b) {
        printline("Assertion failed: " + a + " != " + b + " at " + %cf + ":" + %cl);
        exit(1);
    }
}

public void assertEq(float64 a, float64 b) {
    if (a != b) {
        printline("Assertion failed: " + a + " != " + b + " at " + %cf + ":" + %cl);
        exit(1);
    }
}

public void assertEq(string a, string b) {
    if (a != b) {
        printline("Assertion failed: '" + a + "' != '" + b + "' at " + %cf + ":" + %cl);
        exit(1);
    }
}

public void assertNe(int a, int b) {
    if (a == b) {
        printline("Assertion failed: " + a + " == " + b + " at " + %cf + ":" + %cl);
        exit(1);
    }
}
