mod export os;

// DOCS -- `os` module (UNIFIED_CORE_LIBRARY.md Phase 1).
//
// Platform identity for the unified core library. Silver code asks which OS
// backend it is running with `os.type()`, compared against the `OSTypes`
// enum below; the Windows DLL calls inside the std wrappers are gated by
// `if os.type() == OSTypes.WINDOWS`.
//
// The native half lives in silverc-rs/src/stdlib/os.rs (registered in
// src/stdlib/mod.rs). `os.type`, `os.name` and `os.version` are emitted
// directly as x86-64 code: `os.type()` is the compile-time constant WINDOWS
// (this backend only emits Windows PE executables), `os.name()` is the static
// string "windows", and `os.version()` calls ntdll!RtlGetVersion and formats
// "major.minor.build".
//
// The `OSTypes` variant order is the API contract shared with the native
// constants (OS_TYPE_WINDOWS/LINUX/MACOS/UNKNOWN in stdlib/os.rs); future
// backends must keep these values:
//     WINDOWS = 0, LINUX = 1, MACOS = 2, UNKNOWN = 3

def OSTypes = enum {
    WINDOWS,
    LINUX,
    MACOS,
    UNKNOWN
};

// Self-host/interpreter stand-in for the native `os.type` query. The
// silverc-rs backend answers `os.type()` calls natively (compile-time
// WINDOWS constant in stdlib/os.rs); the self-hosted compiler's builtin
// `os` dispatch only covers os.name/os.version/os.build, so std wrappers
// gate their Windows backends with this plain-Silver helper instead. It
// compiles everywhere Silver compiles and returns the same contract value:
// OSTypes.WINDOWS (0) on this Windows-only backend.
public int osType() {
    return OSTypes.WINDOWS;
}
