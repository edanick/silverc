mod export headers;

// DOCS -- public `headers` module.
//
// Pure Silver -- no OS code, no preprocessor regions. The multimap's
// storage is two parallel `= []`-initialized string[] arrays (the parallel
// string[] row shape, the same shape std/http_server.sr's local headermap
// uses). Each (key, value) pair is one entry; a key added
// N times appears N times. Keys are stored lowered (name.toLower()).
// Uninitialized class storage is a latent trap on both compilers:
// silverc-rs silently swallows early reads and access-violates once the
// storage is used further, and the self-hosted compiler access-violates on
// the FIRST touching operation -- hence the explicit initialization.
//
// API (see each declaration): class header -- public name/value fields,
// construct(string, string); class multimap -- construct(), get(string) ->
// string (first value for the name, "" when absent), getAll(string) ->
// string[] (ALL values for the name in insertion order, null when absent),
// has(string) -> bool, set(string, string) (stores the single new value
// under the name, discarding prior entries), add(string, string) (appends
// one more value for the name), remove(string), serialize() -> string; free
// function parse(string) -> multimap. serialize() emits one
// "Cap: value\r\n" line per value with the first letter of the lowered key
// capitalized.
//
// LANDMINES SHAPING THE BODIES (all probed, see the sibling modules): the
// serialize() bodies use if/else instead of string ternaries (string
// ternaries are landmined on the self-host -- the reason http_server.sr
// writes its own serializer that way); the `.length` PROPERTY form
// everywhere (the `.length()` CALL form reads garbage on the self-host);
// substr only in the dual-correct forms substr(0, n) and single-argument
// tails; string fields copied to locals before concatenation.
//
// DISPATCH (probed): `headers` is builtin-reserved on NEITHER compiler --
// silverc-rs's builtin_modules_set (src/main.rs:81 lists fs/json/yaml/env/
// url/hash/path/bom/console/math/http only) and the self-hosted compiler's
// visBuiltinModule both exclude it. Both compilers resolve
// `import * from headers;` as an ORDINARY SOURCE module from disk
// (std\headers.sr candidates); the module is also excluded from the
// compiler's own aggregate build (silverc.srp). No native dispatch exists,
// so there is no per-compiler call interception to worry about.
//
// §6 UNIFICATION AUDIT (file-49 turn) -- the parallel-array map family:
// cookies.sr's multimap (exact-match keys, get/set only), csv.sr's row.get
// (exact-match, null-on-absent, single-value row TYPE), guard.sr's
// contains-variants (single-array membership / struct-field checks, not
// key->value maps), http_server.sr's headermap, llmai.sr's LlmHeaders
// (fixed slots, not parallel arrays). VERDICT: KEEP SEPARATED -- no member
// shares BOTH storage shape AND key semantics with another: cookie names
// are case-sensitive (RFC 6265) so lowering them would corrupt lookups;
// row.get's null-on-absent and row TYPE differ (unify helpers only, never
// types); guard's scans are membership, not maps; LlmHeaders is fixed
// slots. headermap is the closest twin (same shape, same lowered-key
// contract, same set/add/get/has/serialize) but its getAll returns [] when
// absent while this getAll returns null -- the contract choice plus any
// migration belong to http_server.sr's later turn (file 52; neither getAll
// has a caller today). No exact-match mode was added here: this module is
// EXCLUDED from the build with zero importers, so a mode would be dead
// surface, and cookies.sr is frozen -- migration is impossible in scope.
// Follow-up: the capitalize-first serialize block here is byte-identical
// to headermap's -- candidate for a string.sr home on file 80's turn.

class header {
    public string name;
    public string value;

    construct(string n, string v) { this.name = n; this.value = v; }
}

class multimap {
    // Storage as two parallel arrays -- one entry per (key, value). Both
    // are `= []`-initialized in the construct; uninitialized class storage
    // is a latent trap on both compilers (see the module header).
    private string[] keys;
    private string[] vals;

    construct {
        this.keys = [];
        this.vals = [];
    }

    // The first value stored under `name`, "" when absent.
    public string get(string name) {
        string key = name.toLower();
        for (int i = 0; i < this.keys.length; i++) {
            if (this.keys[i] == key) { return this.vals[i]; }
        }
        return "";
    }

    // Every value stored under `name`, in insertion order; null when the
    // name is absent (callers null-check the result).
    public string[] getAll(string name) {
        string key = name.toLower();
        string[] out = [];
        for (int i = 0; i < this.keys.length; i++) {
            if (this.keys[i] == key) { out.push(this.vals[i]); }
        }
        if (out.length == 0) { return null; }
        return out;
    }

    public bool has(string name) {
        string key = name.toLower();
        for (int i = 0; i < this.keys.length; i++) {
            if (this.keys[i] == key) { return true; }
        }
        return false;
    }

    // Stores the single new value under (the lowered) name, discarding
    // prior entries.
    public void set(string name, string value) {
        string key = name.toLower();
        this.removeKey(key);
        this.keys.push(key);
        this.vals.push(value);
    }

    // Appends one more value for name. get() keeps returning the first
    // inserted value; serialize() emits every value.
    public void add(string name, string value) {
        this.keys.push(name.toLower());
        this.vals.push(value);
    }

    public void remove(string name) {
        this.removeKey(name.toLower());
    }

    private void removeKey(string key) {
        string[] keepKeys = [];
        string[] keepVals = [];
        for (int i = 0; i < this.keys.length; i++) {
            if (this.keys[i] != key) {
                keepKeys.push(this.keys[i]);
                keepVals.push(this.vals[i]);
            }
        }
        this.keys = keepKeys;
        this.vals = keepVals;
    }

    // The serialize format: one "Name: value\r\n" line per entry, in
    // insertion order, with the first letter of the lowered key
    // capitalized; an empty key emits ": value\r\n". Written with if/else
    // rather than a string ternary (see the module header's landmine note).
    public string serialize() {
        string result = "";
        for (int i = 0; i < this.keys.length; i++) {
            string key = this.keys[i];
            string val = this.vals[i];
            string cap = key;
            if (key.length > 0) {
                cap = key.substr(0, 1).toUpper() + key.substr(1);
            }
            result += cap + ": " + val + "\r\n";
        }
        return result;
    }
}

public multimap parse(string raw) {
    multimap m = new multimap();
    string[] lines = raw.split("\r\n");
    for (int li = 0; li < lines.length; li++) {
        string line = lines[li];
        if (line.trim().length == 0) { continue; }
        int colon = line.indexOf(":");
        if (colon < 0) { continue; }
        string name = line.substr(0, colon).trim();
        string value = line.substr(colon + 1).trim();
        m.add(name, value);
    }
    return m;
}
