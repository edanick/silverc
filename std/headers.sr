mod export headers;

class header {
    public string name;
    public string value;

    construct(string n, string v) { this.name = n; this.value = v; }
}

class multimap {
    private kvp<string, string[]> data;

    construct() { }

    public string get(string name) {
        string[] vals = this.data.get(name.toLower());
        if (vals == null || vals.length() == 0) { return ""; }
        return vals[0];
    }

    public string[] getAll(string name) {
        return this.data.get(name.toLower());
    }

    public bool has(string name) {
        return this.data.get(name.toLower()) != null;
    }

    public void set(string name, string value) {
        string[] vals = [value];
        this.data.set(name.toLower(), vals);
    }

    public void add(string name, string value) {
        string[] existing = this.data.get(name.toLower());
        if (existing == null) {
            this.set(name, value);
        } else {
            existing.push(value);
        }
    }

    public void remove(string name) {
        this.data.remove(name.toLower());
    }

    public string serialize() {
        string result = "";
        string[] keys = this.data.keys();
        for (int ki = 0; ki < keys.length(); ki++) {
            string key = keys[ki];
            string[] vals = this.data.get(key);
            for (int vi = 0; vi < vals.length(); vi++) {
                string v = vals[vi];
                string cap = key.length() > 0 ? key.substr(0, 1).toUpper() + key.substr(1) : key;
                result += cap + ": " + v + "\r\n";
            }
        }
        return result;
    }
}

public multimap parse(string raw) {
    multimap m = new multimap();
    string[] lines = raw.split("\r\n");
    for (int li = 0; li < lines.length(); li++) {
        string line = lines[li];
        if (line.trim().length() == 0) { continue; }
        int colon = line.indexOf(":");
        if (colon < 0) { continue; }
        string name = line.substr(0, colon).trim();
        string value = line.substr(colon + 1).trim();
        m.add(name, value);
    }
    return m;
}
