import * from win32.ws2_32;

mod export sql;

class row {
    private kvp<string, string> fields;

    construct() { }

    public string get(string name) { return this.fields.get(name); }
}

class result {
    private row[] rows;
    private int idx;

    construct() { this.idx = 0; }

    public bool hasNext() { return this.idx < this.rows.length(); }
    public row next() { row r = this.rows[this.idx]; this.idx++; return r; }
}

class connection {
    private string connStr;

    construct(string connStr) { this.connStr = connStr; }

    public void execute(string sql) {
        SQLExecDirect(this.connStr, sql);
    }

    public void execute(string sql, object[] params) {
        this.execute(sql);
    }

    public result query(string sql) {
        result r = new result();
        return r;
    }

    public result query(string sql, object[] params) {
        return this.query(sql);
    }

    public void close() { }
}

public connection connect(string connStr) {
    return new connection(connStr);
}
