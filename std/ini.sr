mod export ini;
import {readString, writeString} from fs;

public object parse(string raw) {
    object result = {};
    object currentSection = {};
    string currentSectionName = "";
    bool inSection = false;
    string[] lines = raw.split("\n");
    foreach (string line in lines) {
        line = line.trim();
        // NOTE: no `continue` here on purpose: the bootstrap
        // compiler's continue inside foreach does not skip the
        // rest of the body, so blank/comment lines are guarded
        // positively instead.
        if (line.length > 0 && line[0] != ';' && line[0] != '#') {
            if (line[0] == '[') {
                int end = line.indexOf("]");
                if (end >= 0) {
                    string sectionName = line.substr(1, end - 1);
                    if (inSection) {
                        result[currentSectionName] = currentSection;
                    } else {
                        mergeTopLevel(result, currentSection);
                    }
                    currentSection = {};
                    currentSectionName = sectionName;
                    inSection = true;
                }
            } else {
                int eq = line.indexOf("=");
                if (eq >= 0) {
                    string key = line.substr(0, eq).trim();
                    string val = line.substr(eq + 1).trim();
                    currentSection[key] = val;
                }
            }
        }
    }
    if (inSection) {
        result[currentSectionName] = currentSection;
    } else {
        mergeTopLevel(result, currentSection);
    }
    return result;
}

private void mergeTopLevel(object result, object top) {
    string[] keys = top.keys();
    for (int i = 0; i < keys.length; i++) {
        result[keys[i]] = top[keys[i]];
    }
}

public object load(string path) {
    string content = fs.readString(path);
    return ini.parse(content);
}

private string iniScalarAt(object o, string k) {
    string v = o[k];
    if (v == null) { return ""; }
    return v;
}

private int iniProbeLen(object o) {
    // A read-only header load: the dict count for a table, the first
    // eight bytes of heap text for a string -- never an allocation
    // or iteration, so it cannot hang on string payloads the way
    // .keys() does (garbage-count allocation).
    return o.length;
}

private bool iniIsDictAt(object container, string key) {
    // Discriminate tables from scalars over erased `object` values.
    // A table has a small count AND its payload read as text is the
    // count's low byte followed by NUL (one char matching count
    // mod 256, or empty when the count is a multiple of 256); a
    // string payload read as text is its own content. Single-byte
    // strings are byte-identical to one-entry tables and therefore
    // read as tables (documented std limitation).
    if (container[key] == null) { return false; }
    object inner = container[key];
    int p = iniProbeLen(inner);
    if (p >= 1000000 || p < 0) { return false; }
    string s = iniScalarAt(container, key);
    if (s.length == 1 && int(s[0]) == p % 256) { return true; }
    if (s.length == 0 && p == 0) { return true; }
    return false;
}

private string iniSectionText(object section, string path) {
    string result = "[" + path + "]\n";
    string[] skeys = section.keys();
    for (int j = 0; j < skeys.length; j++) {
        string sk = skeys[j];
        if (!iniIsDictAt(section, sk)) {
            result += sk + "=" + iniScalarAt(section, sk) + "\n";
        }
    }
    for (int j = 0; j < skeys.length; j++) {
        string sk = skeys[j];
        if (iniIsDictAt(section, sk)) {
            object sub = section[sk];
            result += iniSectionText(sub, path + "." + sk);
        }
    }
    result += "\n";
    return result;
}

public string stringify(object data) {
    // INI layout: top-level scalars first (key=value), then one
    // [section] block per table (nested tables recurse into dotted
    // paths; parse's header handling keeps them flat by name).
    // Nested tables read through direct parameter passes (reading
    // container[key] into an `object` local decays it to
    // pointer-as-int, after which .keys() faults).
    string result = "";
    string[] keys = data.keys();
    for (int i = 0; i < keys.length; i++) {
        string key = keys[i];
        if (!iniIsDictAt(data, key)) {
            result += key + "=" + iniScalarAt(data, key) + "\n";
        }
    }
    for (int i = 0; i < keys.length; i++) {
        string key = keys[i];
        if (iniIsDictAt(data, key)) {
            result += iniSectionText(data[key], key);
        }
    }
    return result;
}

public void save(string path, object data) {
    fs.writeString(path, stringify(data));
}
