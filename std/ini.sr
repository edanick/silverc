mod export ini;
import {readString, writeString} from fs;

public object parse(string raw) {
    object result = {};
    object currentSection = result;
    string[] lines = raw.split("\n");
    foreach (string line in lines) {
        line = line.trim();
        if (line.length == 0 || line[0] == ';' || line[0] == '#') { continue; }
        if (line[0] == '[') {
            int end = line.indexOf("]");
            if (end < 0) { continue; }
            string sectionName = line.substr(1, end - 1);
            currentSection = {};
            result[sectionName] = currentSection;
        } else {
            int eq = line.indexOf("=");
            if (eq < 0) { continue; }
            string key = line.substr(0, eq).trim();
            string val = line.substr(eq + 1).trim();
            currentSection[key] = val;
        }
    }
    return result;
}

public object load(string path) {
    string content = fs.readString(path);
    return parse(content);
}

public string stringify(object data) {
    // NOTE: implemented with keys()+index loops, not `foreach (k in dict)`
    // (neither toolchain supports foreach over dicts — stride-16 entries
    // vs the array stride-8 lowering; both faulted on the second key).
    string result = "";
    string[] keys = data.keys();
    for (int i = 0; i < keys.length; i++) {
        string key = keys[i];
        object section = data[key];
        result += "[" + key + "]\n";
        string[] skeys = section.keys();
        for (int j = 0; j < skeys.length; j++) {
            string sk = skeys[j];
            // object-typed values format by static kind (ints exact;
            // string payloads print as pointers — Silver has no runtime
            // type dispatch; see DOCS/275).
            result += sk + "=" + section[sk] + "\n";
        }
        result += "\n";
    }
    return result;
}

public void save(string path, object data) {
    fs.writeString(path, stringify(data));
}
