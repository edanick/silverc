mod export compress;
import {toUtf8, fromUtf8} from encoding;
import {readString, write, writeString} from fs;

public byte[] gzip(byte[] data) {
    int srcLen = data.length;
    int dstLen = srcLen + srcLen / 100 + 64;
    byte[] dst = new byte[dstLen];
    int compressed = RtlCompressBuffer(2, data, srcLen, dst, dstLen, 0, &dstLen);
    if (compressed != 0) { dstLen = srcLen; for (int i = 0; i < srcLen; i++) { dst[i] = data[i]; } }
    byte[] result = new byte[dstLen];
    for (int i = 0; i < dstLen; i++) { result[i] = dst[i]; }
    return result;
}

public byte[] gunzip(byte[] data) {
    int srcLen = data.length;
    int dstLen = srcLen * 4 + 1024;
    byte[] dst = new byte[dstLen];
    int decompressed = RtlDecompressBuffer(2, dst, dstLen, data, srcLen, &dstLen);
    if (decompressed != 0) { return data; }
    byte[] result = new byte[dstLen];
    for (int i = 0; i < dstLen; i++) { result[i] = dst[i]; }
    return result;
}

public void gzipFile(string input, string output) {
    byte[] data = encoding.toUtf8(fs.readString(input));
    byte[] compressed = gzip(data);
    fs.write(output, compressed);
}

public void gunzipFile(string input, string output) {
    byte[] data = fs.read(input);
    byte[] decompressed = gunzip(data);
    fs.writeString(output, encoding.fromUtf8(decompressed));
}

public byte[] zstd(byte[] data) {
    return gzip(data);
}

public byte[] zstd(byte[] data, int level) {
    return gzip(data);
}

public byte[] dezstd(byte[] data) {
    return gunzip(data);
}

public void zstdFile(string input, string output, int level) {
    gzipFile(input, output);
}

public void dezstdFile(string input, string output) {
    gunzipFile(input, output);
}

public byte[] deflate(byte[] data) {
    return gzip(data);
}

public byte[] inflate(byte[] data) {
    return gunzip(data);
}
