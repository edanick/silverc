import * from win32.ws2_32;

mod export ftp;

class client {
    private int sock;
    private string host;
    private int port;

    construct(string host) {
        this.host = host;
        this.port = 21;
    }

    public void login(string user, string pass) {
        this.sock = socket(AF_INET, SOCK_STREAM, 0);
        struct sockaddr_in addr;
        addr.sin_family = AF_INET;
        addr.sin_port = (21 & 0xFF) << 8 | (21 >> 8) & 0xFF;
        addr.sin_addr.s_addr = inet_addr(this.host);
        connect(this.sock, &addr, 16);
        recvResp();
        sendCmd("USER " + user);
        recvResp();
        sendCmd("PASS " + pass);
        recvResp();
    }

    private void sendCmd(string cmd) {
        byte[] bytes = (cmd + "\r\n").toBytes();
        send(this.sock, bytes, bytes.length, 0);
    }

    private string recvResp() {
        byte[] buf = new byte[4096];
        int n = recv(this.sock, buf, 4096, 0);
        if (n <= 0) { return ""; }
        string result = "";
        for (int i = 0; i < n; i++) { result += char(buf[i]); }
        return result;
    }

    public string[] list(string path) {
        sendCmd("PASV");
        string pasvResp = recvResp();
        sendCmd("LIST " + path);
        string data = recvResp();
        return data.split("\r\n");
    }

    public void download(string remote, string local) {
        sendCmd("RETR " + remote);
        string data = recvResp();
        fs.writeString(local, data);
    }

    public void upload(string local, string remote) {
        sendCmd("STOR " + remote);
        string data = fs.readString(local);
        sendCmd(data);
        recvResp();
    }

    public void close() {
        sendCmd("QUIT");
        closesocket(this.sock);
    }
}

class server {
    private int sock;
    private string root;
    private int port;
    private kvp<string, string> users;

    construct(string root, int port) {
        this.root = root;
        this.port = port;
    }

    public void addUser(string user, string pass, string permissions) {
        users.set(user, pass);
    }

    public void start() {
        this.sock = socket(AF_INET, SOCK_STREAM, 0);
        struct sockaddr_in addr;
        addr.sin_family = AF_INET;
        addr.sin_addr.s_addr = 0;
        addr.sin_port = (this.port & 0xFF) << 8 | (this.port >> 8) & 0xFF;
        bind(this.sock, &addr, 16);
        listen(this.sock, 5);
    }

    public void wait() {
        while (true) {
            int client = accept(this.sock, null, null);
            if (client >= 0) {
                byte[] buf = "220 FTP Server ready\r\n".toBytes();
                send(client, buf, 20, 0);
                closesocket(client);
            }
        }
    }
}
