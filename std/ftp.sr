import * from os;
import * from ftp_win;

mod export ftp;

// DOCS -- public `ftp` module (UNIFIED_CORE_LIBRARY.md Phase 2). This is the
// unified, portable front of the FTP library. It contains ZERO win32
// imports: every ws2_32 call moved into the internal Windows backend
// std/ftp_win.sr, and every entry that touches the network routes through
// the OS gate `if (osType() == OSTypes.WINDOWS)` before calling it
// (osType() is std/os.sr's plain-Silver stand-in -- see that file for why
// the gate does not use the native os.type query).
//
// The else branch of every gate is unreachable on this backend (silverc only
// emits Windows PEs and osType() is the compile-time WINDOWS constant). For
// a future non-Windows backend the fallbacks follow the module's failure
// style: login/list/download/upload/close and server start/wait are silent
// no-ops, list() returns [], isLoggedIn() stays false.
//
// DISPATCH (per compiler, probed): `ftp` is builtin-reserved on NEITHER
// compiler -- silverc-rs's builtin_modules_set (src/main.rs:81 lists
// fs/json/yaml/env/url/hash/path/bom/console/math/http only) and the
// self-hosted compiler's visBuiltinModule (compiler/visibility.sr:605) plus
// its driver prepend list all exclude it. Both compilers resolve
// `import * from ftp;` as an ORDINARY SOURCE module (std\ftp.sr); no native
// dispatch exists to preserve.
//
// PRE-SPLIT STATE (probed against this file's git HEAD before the rewrite):
// the old std/ftp.sr NEVER compiled under either compiler. silverc-rs
// reported `struct sockaddr_in addr;` at lines 17/87 ("unknown keyword
// sockaddr_in"), the phantom `(cmd + "\r\n").toBytes()` (line 30), the
// `new byte[4096]` declaration initializer (line 35), and the `fs.`
// receiver on writeString/readString (lines 54/59 -- the builtin file I/O
// namespace is `file.` on silverc-rs), plus brace-cascade errors; the
// self-hosted compiler rejected the same struct lines and cascaded. Every
// body was therefore dead text -- there was NO observable pre-split
// behavior to preserve beyond names, arities and intent.
//
// DEAD -> LIVE (what this split made actually work):
// - The control channel: socket + connect + USER/PASS over ws2_32 with
//   WSAStartup (the pre-split file never initialized winsock), the
//   sockaddr_in image packed into an int[2] qword buffer (`struct` locals
//   and `&addr` are unexpressible), and DLL returns normalized with the
//   two-sided `v < 0 || v > 2147483647` check (the self-host zero-extends
//   SOCKET_ERROR to 4294967295; see std/ftp_win.sr).
// - login(): pre-split it fired five sends/recvs with zero checking and
//   stayed silent about failure. It now reads and validates the greeting
//   (220), USER (331, or 230 = server skips PASS), PASS (230) and records
//   the outcome in isLoggedIn()/getLastReply() (both ADDITIVE -- the
//   pre-split surface had no way to report anything). Against a non-FTP
//   listener the login fails gracefully: the server's banner (or "" after
//   a silent disconnect) is surfaced through getLastReply() and the
//   process exits cleanly. No exceptions are raised anywhere.
// - PASV data channel: the pre-split list() sent PASV, read the reply,
//   then NEVER connected to the data port -- it split the *control*
//   reply text instead. list()/download()/upload() now parse the PASV
//   reply (replyCode/replyComplete/pasvHost/pasvPort, all probed
//   byte-identical on fixed inputs) and open a real second connection.
// - download(): pre-split wrote the CONTROL-channel reply into the local
//   file (the RETR ack, not the file). It now streams the data channel
//   until EOF and writes that. upload(): pre-split read the local file
//   and sent it over the CONTROL channel as if it were a command; it now
//   sends STOR and the file bytes over the data channel (local content is
//   pointer on silverc-rs; see std/dns.sr's note). The fs.* receiver is the
//   native/builtin fs on both compilers (std/crypto.sr and std/csv.sr use
//   the same shape); the `file.` spelling does not parse on silverc-rs.
// - Bounded reads: every socket gets a 30 s SO_RCVTIMEO (std/ftp_win.sr).
//   The pre-split file had no timeout and would have hung on a silent
//   peer; readReply()'s accumulation loop is additionally bounded at 16
//   iterations and readAll() at 4096 x 64 KB (~256 MB) so no path can
//   spin forever.
// - QUIT: close() sends QUIT and closes immediately without waiting for
//   the 221 (pre-split shape -- it never read the reply either), so a dead
//   peer cannot stall close().
//
// NOT INVENTED: the `server` class keeps exactly its pre-split surface
// (addUser/start/wait) and behavior -- wait() accepts connections one at a
// time, sends the pre-split greeting TRUNCATED at 20 of its 22 bytes
// ("220 FTP Server ready" without the CRLF -- the pre-split send length is
// preserved verbatim), and closes the client. It still never authenticates
// (addUser is a no-op: the pre-split body wrote into an uninitialized
// `kvp` field -- a NULL deref had it ever run; the field is gone), never
// serves files, and wait() never returns (pre-split `while (true)` shape;
// never call it from a probe or test: it blocks the process by design).
// There is no single-shot accept, no AUTH/TLS, no EPSV/PORT fallback.
//
// API PRESERVATION (every public name/arity of the pre-split file,
// unchanged): client.construct(string host) -- port fixed at 21, the
// pre-split hard-coded value; a NEW additive setPort(int) exists for
// probes/hosts that need another port (the std/dns.sr setHost precedent);
// login(string user, string pass); list(string path) -> string[];
// download(string remote, string local); upload(string local, string
// remote); close(). server.construct(string root, int port) (root is
// stored and unused, as pre-split); addUser(string user, string pass,
// string permissions); start(); wait(). The private sendCmd/recvResp
// helper names are preserved; recvResp keeps its raw-bytes shape (the
// multi-line reply accumulation lives in the new private readReply).
//
// CALLER NOTES: strings returned across this module's boundary
// (getLastReply) should be assigned to a local before being concatenated
// into larger expressions (silverc-rs stringifies the return pointer in
// expression position; see std/dns.sr's RS-ONLY CALLER LANDMINE). list()
// returns the data-channel lines split on "\r\n", so a trailing CRLF
// yields a trailing "" element -- the same shape the pre-split split()
// produced.

public int replyCode(string resp) {
    if (resp.length < 3) { return -1; }
    int code = 0;
    for (int i = 0; i < 3; i++) {
        int c = resp[i] & 0xFF;
        if (!isDigit(c)) { return -1; }
        code = code * 10 + (c - 48);
    }
    return code;
}

// True when `resp` already contains a terminating FTP reply line: some
// "\r\n"-delimited line whose first three chars are digits and whose fourth
// char is a space (RFC 959's "nnn " terminal form). Multi-line replies
// ("nnn-text ... nnn text") complete only at the space form, so the
// wrapper's readers keep accumulating until this fires or the bounded
// loop exhausts.
public bool replyComplete(string resp) {
    int lineStart = 0;
    for (int i = 0; i < resp.length; i++) {
        if (resp[i] == 13 && i + 1 < resp.length && resp[i + 1] == 10) {
            int lineLen = i - lineStart;
            if (lineLen >= 4) {
                if (isDigit(resp[lineStart] & 0xFF) && isDigit(resp[lineStart + 1] & 0xFF) && isDigit(resp[lineStart + 2] & 0xFF) && resp[lineStart + 3] == 32) {
                    return true;
                }
            }
            i++;
            lineStart = i + 1;
        }
    }
    return false;
}

// Extracts the PASV host "h1.h2.h3.h4" from a "227 ... (h1,h2,h3,h4,p1,p2)"
// reply ("" on any malformed input).
public string pasvHost(string reply) {
    int[] nums = new int[6];
    int count = pasvNums(reply, nums);
    if (count != 6) { return ""; }
    return nums[0] + "." + nums[1] + "." + nums[2] + "." + nums[3];
}

// Extracts the PASV port p1*256+p2 from the same reply (-1 on malformed
// input). Deliberately *256, not a shift: shift expressions inside
// one-liner methods are unreliable on the self-hosted compiler.
public int pasvPort(string reply) {
    int[] nums = new int[6];
    int count = pasvNums(reply, nums);
    if (count != 6) { return -1; }
    return nums[4] * 256 + nums[5];
}

private bool isDigit(int c) {
    return c >= 48 && c <= 57;
}

// Scans the parenthesized section of a PASV reply for its integer tokens
// ("h1,h2,h3,h4,p1,p2"), storing the first six into `dest` and returning
// how many were found -- callers require exactly 6, anything else means
// the reply was not a well-formed PASV echo.
// NOTE: deliberately scans reply[i] by index (NO substr) and fills a
// caller-owned array (NO int[] return value). silverc-rs's two-arg
// substr(start, X) treats X as an END offset while the self-host treats it
// as a LENGTH -- identical only when start is 0 (probed; see
// silverc-rs/src/string_ops.rs emit_string_substring), so substring
// extraction here would silently disagree across compilers. And a helper
// RETURNING an int[] mis-dispatches across the module boundary on
// silverc-rs in this module's probe (count arrives 0 for valid input on
// rs while the self-host returns 6; same isolated code works when the
// module exports nothing else -- reported to the rs agent, not worked
// around by hiding the bug).
private int pasvNums(string reply, int[] dest) {
    int open = reply.indexOf("(");
    if (open < 0) { return 0; }
    int closeIdx = reply.indexOf(")");
    if (closeIdx < 0 || closeIdx < open) { return 0; }
    int count = 0;
    int val = 0;
    bool inNum = false;
    for (int i = open + 1; i < closeIdx; i++) {
        int c = reply[i] & 0xFF;
        if (isDigit(c)) {
            val = val * 10 + (c - 48);
            inNum = true;
        } else {
            if (inNum) {
                if (count < 6) { dest[count] = val; }
                count++;
                val = 0;
                inNum = false;
            }
        }
    }
    if (inNum) {
        if (count < 6) { dest[count] = val; }
        count++;
    }
    return count;
}

class client {
    private int sock;
    private string host;
    private int port;
    private string lastReply;
    private bool loggedIn;

    construct(string host) {
        this.host = host;
        this.port = 21;
        this.sock = -1;
        this.lastReply = "";
        this.loggedIn = false;
    }

    // ADDITIVE (the std/dns.sr setHost precedent): the pre-split client had
    // no way to leave port 21; probes and hosts against non-standard ports
    // set this before login().
    public void setPort(int p) {
        this.port = p;
    }

    // ADDITIVE: the raw text of the last server reply on the control
    // channel ("" before the first read). This is the graceful-failure
    // surface: against a non-FTP listener it holds the banner the peer
    // sent, or "" when the peer said nothing and closed.
    public string getLastReply() {
        return this.lastReply;
    }

    // ADDITIVE: true only after a fully accepted USER/PASS exchange (or a
    // 230 login-without-PASS).
    public bool isLoggedIn() {
        return this.loggedIn;
    }

    public void login(string user, string pass) {
        if (osType() != OSTypes.WINDOWS) { return; }
        this.sock = ftpWinConnect(this.host, this.port);
        if (this.sock < 0) {
            this.sock = -1;
            this.lastReply = "";
            return;
        }
        this.readReply();
        if (replyCode(this.lastReply) != 220) {
            this.fail();
            return;
        }
        this.sendCmd("USER " + user);
        this.readReply();
        int code = replyCode(this.lastReply);
        if (code != 331 && code != 230) {
            this.fail();
            return;
        }
        if (code != 230) {
            this.sendCmd("PASS " + pass);
            this.readReply();
            if (replyCode(this.lastReply) != 230) {
                this.fail();
                return;
            }
        }
        this.loggedIn = true;
    }

    public string[] list(string path) {
        string[] empty = [];
        if (osType() != OSTypes.WINDOWS) { return empty; }
        if (!this.loggedIn) { return empty; }
        int data = this.openData();
        if (data < 0) { return empty; }
        this.sendCmd("LIST " + path);
        string content = this.readAll(data);
        ftpWinClose(data);
        this.readReply();
        return content.split("\r\n");
    }

    // NOTE: the second parameter is spelled localPath, not `local` -- `local`
    // is a reserved word on silverc-rs ("Expected expression" wherever it
    // appears as an identifier; probed), another pre-split landmine (the old
    // signature used it). Parameter names are invisible to positional
    // callers, so the observable API is unchanged.
    public void download(string remote, string localPath) {
        if (osType() != OSTypes.WINDOWS) { return; }
        if (!this.loggedIn) { return; }
        int data = this.openData();
        if (data < 0) { return; }
        this.sendCmd("RETR " + remote);
        string content = this.readAll(data);
        ftpWinClose(data);
        this.readReply();
        fs.writeString(localPath, content);
    }

    public void upload(string localPath, string remote) {
        if (osType() != OSTypes.WINDOWS) { return; }
        if (!this.loggedIn) { return; }
        string content = fs.readString(localPath);
        int data = this.openData();
        if (data < 0) { return; }
        this.sendCmd("STOR " + remote);
        ftpWinSend(data, content, content.length);
        ftpWinClose(data);
        this.readReply();
    }

    public void close() {
        if (this.sock >= 0 && osType() == OSTypes.WINDOWS) {
            this.sendCmd("QUIT");
            ftpWinClose(this.sock);
        }
        this.sock = -1;
        this.loggedIn = false;
    }

    // Sends one command line (CRLF appended). No-op on a dead channel --
    // every caller pairs it with a bounded read, so the failure surfaces
    // there instead.
    private void sendCmd(string cmd) {
        if (this.sock < 0) { return; }
        ftpWinSend(this.sock, cmd + "\r\n", cmd.length + 2);
    }

    // One bounded read of the control channel (raw bytes as a string; ""
    // on disconnect/timeout -- pre-split recvResp shape).
    private string recvResp() {
        if (this.sock < 0) { return ""; }
        return ftpWinReceive(this.sock, 4096);
    }

    // Accumulates control-channel reads into lastReply until a terminating
    // "nnn " line is seen (replyComplete), the peer goes quiet, or 16
    // reads pass -- whichever comes first. Overwrites, never appends
    // across commands: a stale reply must not leak into the next check.
    private void readReply() {
        string acc = "";
        for (int guard = 0; guard < 16; guard++) {
            string chunk = this.recvResp();
            if (chunk.length <= 0) { break; }
            acc += chunk;
            if (replyComplete(acc)) { break; }
        }
        this.lastReply = acc;
    }

    // Opens the passive data channel for a transfer: PASV on the control
    // channel, parse host/port, connect. Returns -1 (and leaves the
    // control channel open) on any failure.
    private int openData() {
        this.sendCmd("PASV");
        this.readReply();
        string host = pasvHost(this.lastReply);
        int port = pasvPort(this.lastReply);
        if (port < 0 || host.length <= 0) { return -1; }
        int data = -1;
        if (osType() == OSTypes.WINDOWS) {
            data = ftpWinConnect(host, port);
        }
        return data;
    }

    // Drains a data channel until EOF/timeout (bounded at 4096 x 64 KB
    // reads, ~256 MB -- the guard makes the loop finite even against a
    // peer that never closes).
    private string readAll(int fd) {
        string acc = "";
        for (int guard = 0; guard < 4096; guard++) {
            string chunk = ftpWinReceive(fd, 65536);
            if (chunk.length <= 0) { break; }
            acc += chunk;
        }
        return acc;
    }

    // Drops the connection and marks the client logged out; lastReply
    // keeps whatever the server last said so the caller can surface it.
    private void fail() {
        this.loggedIn = false;
        if (this.sock >= 0) {
            ftpWinClose(this.sock);
        }
        this.sock = -1;
    }
}

class server {
    private int sock;
    private string root;
    private int port;

    construct(string root, int port) {
        this.root = root;
        this.port = port;
        this.sock = -1;
    }

    // No-op: credentials are recorded nowhere. The pre-split body wrote
    // into an uninitialized `kvp` field (a NULL deref had it ever run) and
    // the server never authenticated nor served files; this split invents
    // none of that. The `permissions` argument stays accepted and ignored
    // (pre-split arity).
    public void addUser(string user, string pass, string permissions) {
    }

    // Binds INADDR_ANY:port and listens (backlog 5, the pre-split value).
    // A failed bind leaves sock -1; wait() then returns immediately.
    public void start() {
        if (osType() == OSTypes.WINDOWS) {
            this.sock = ftpWinListen(this.port);
        }
    }

    // Accept loop with the pre-split shape: per client, send the greeting
    // TRUNCATED at 20 of its 22 bytes ("220 FTP Server ready" without the
    // CRLF -- the pre-split send length preserved verbatim) and close.
    // NEVER RETURNS (pre-split `while (true)`); never call it from a probe
    // or test: it blocks the process by design.
    public void wait() {
        if (osType() != OSTypes.WINDOWS) { return; }
        if (this.sock < 0) { this.start(); }
        if (this.sock < 0) { return; }
        while (true) {
            int clientSock = ftpWinAccept(this.sock);
            if (clientSock >= 0) {
                ftpWinSend(clientSock, "220 FTP Server ready\r\n", 20);
                ftpWinClose(clientSock);
            }
        }
    }
}
