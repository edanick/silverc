import * from net;

mod export pop;

// DOCS -- public `pop` module (UNIFIED_CORE_LIBRARY.md §4). This is the
// universal, portable front of the POP3 library. It is a PROTOCOL module
// and contains ZERO OS code: no win32 imports, no `#on` regions -- every
// byte on the wire is sent through the universal socket core std/net.sr
// (connectRaw/sendRawLen/recvRaw/closeRaw/setRecvTimeoutRaw), whose Windows
// regions hold the ws2_32 calls. This module is pure POP3 protocol logic
// and compiles unchanged on any backend that provides net.
//
// TRANSPORT: login() arms a 30 s SO_RCVTIMEO right after connectRaw
// (net.setRecvTimeoutRaw) and count()/list()/retrieve()/remove()/quit()
// re-arm it on their first socket use -- every socket has a 30 s receive
// timeout. The recv loops themselves (recvLine) call net.recvRaw(fd, 4096)
// and the sender (sendLine) calls net.sendRawLen. net.recvRaw normalizes a
// zero-extended SOCKET_ERROR to 4294967295 (`n <= 0 || n > 2147483647`) and
// then reports "" for `n <= 0` -- recv error and disconnect share the same
// graceful shape.
//
// FAIL-STOP STYLE: a connect failure surfaces as fd -1 and a failed read
// path as an unresponsive channel -- login returns silently, getLastReply()
// stays "" or holds the server's last words, no exceptions anywhere.
//
// DISPATCH: `pop` is builtin-reserved on NEITHER compiler -- silverc-rs's
// builtin_modules_set (src/main.rs:81 lists fs/json/yaml/env/url/hash/path/
// bom/console/math/http only) and the self-hosted compiler's
// visBuiltinModule (compiler/visibility.sr:605 lists fs/json/yaml/llmai/
// LLMAI/os/project/exception/bom/process/notifications/env/url/hash/path/
// console/math/http) plus its driver prepend list all exclude it. Both
// compilers resolve `import * from pop;` as an ORDINARY SOURCE module
// (std/pop.sr); no native dispatch exists. (pop.sr's entry in silverc.srp's
// exclude list only keeps it out of the compiler's own aggregate build --
// the same posture as smtp.sr/ftp.sr; it does not make `pop` a builtin.)
//
// SCOPE: plain-text USER/PASS only -- POP3 USER/PASS needs no base64, which
// also sidesteps the encoding.base64Encode runtime crasher (phantom
// string.toBytes(); see std/smtp.sr's b64Encode note). No AUTH/APOP/STLS
// (APOP is an MD5 scheme and AUTH PLAIN would need base64), no UIDL/TOP/
// RSET/NOOP, no TLS, no server class. message keeps exactly four fields:
// sender/subject/body/raw. Bounded reads: readReply()'s accumulation loop
// is capped at 16 iterations and readMulti() at 16 x 4096 bytes (~64 KB per
// command) so no path can spin forever. RETR reads the full multi-line
// response; byte-stuffed leading dots ("..") inside the body are preserved
// verbatim (no de-stuffing).
//
// PUBLIC API: class message -- public fields sender/subject/body/raw,
// construct(string raw); class client -- construct(string host, int port);
// login(string user, string pass); count() -> int; list() -> string[];
// retrieve(int id) -> message; remove(int id) -> bool; quit();
// isLoggedIn(); getLastReply(); free helpers isOk(resp)/isErr(resp)
// (status-prefix checks), multiLineComplete(resp) (true once the ".\r\n"
// terminator is present), statCount(resp)/statSize(resp) (the two STAT
// numbers, -1 on malformed), headerValue(text, name) (RFC 822 header value,
// "" if absent -- pass "From:"/"Subject:" with the colon) and
// messageBody(retrResp) (text between the header blank line and the
// ".\r\n" terminator) -- all pure. isLoggedIn() is true only after a fully
// accepted greeting + USER + PASS exchange; getLastReply() returns the raw
// text of the last server reply ("" before the first read); remove(int id)
// issues DELE and returns true on +OK (DELE marks a message for deletion at
// QUIT); list() issues LIST and returns the data lines ("id octets"
// strings) split on "\r\n". recvLine is a single bounded read; the
// accumulation lives in the private readReply/readMulti. The private
// lastReply/loggedIn fields and the private
// readReply/readMulti/fail/lineEndFrom/lineEndIndex/terminatorIndex/
// blankLineIndex/sliceRange/statNumber plumbing round out the surface;
// construct() initializes every field (sock to -1, strings to "", loggedIn
// to false), so no member is ever uninitialized. Every public name above is
// keyword-free on both compilers (checked against silverc-rs src/token.rs
// and self-host compiler/lexer.sr).
//
// CALLER NOTES: instantiate the client with `var c = new client(...);` --
// a lowercase class arriving from a star-imported module cannot be spelled
// as a local's type on silverc-rs (per-file parsing: `client c` dies with
// "unknown keyword"; `new mod.client()` dies on BOTH compilers; `var`
// works on both, probed via std/ftps.sr). retrieve() returns a class
// instance across the module boundary: assign it to a `var` and read the
// fields from there (probed byte-identical on both compilers). Strings
// returned across this module's boundary (getLastReply and the free
// helpers) should be assigned to a local before being concatenated into
// larger expressions (silverc-rs stringifies the return pointer in
// expression position; see std/dns.sr's RS-ONLY CALLER LANDMINE). count()
// and retrieve() return 0/empty (never negative) on failure; list() returns
// [] and remove() false.

// True when `resp` starts with POP3's "+OK" success marker. Pure; probeable
// byte-identical on both compilers.
public bool isOk(string resp) {
    if (resp.length < 3) { return false; }
    return resp[0] == 43 && resp[1] == 79 && resp[2] == 75;
}

// True when `resp` starts with POP3's "-ERR" failure marker. Pure; the
// diagnostic mirror of isOk.
public bool isErr(string resp) {
    if (resp.length < 4) { return false; }
    return resp[0] == 45 && resp[1] == 69 && resp[2] == 82 && resp[3] == 82;
}

// True when `resp` already contains POP3's multi-line terminator: the
// "\r\n.\r\n" octet sequence (a CRLF, the lone "." line, a CRLF). LIST and
// RETR responses end this way; the wrapper's multi-line reader keeps
// accumulating until this fires, the peer goes quiet, or the bounded loop
// exhausts. Pure; probeable.
public bool multiLineComplete(string resp) {
    return terminatorIndex(resp) >= 0;
}

// First number of a STAT reply "+OK <count> <octets>" (-1 on malformed).
// Deliberately a digit scan: substr-free and int()-cast-free, so it parses
// identically on both compilers. Pure; probeable.
public int statCount(string resp) {
    return statNumber(resp, 1);
}

// Second number of a STAT reply (the total octet size; -1 on malformed).
// Pure; probeable.
public int statSize(string resp) {
    return statNumber(resp, 2);
}

// Value of an RFC 822 header line inside a RETR response ("" when absent):
// scans line by line, matches `headerName` (pass it WITH the colon, e.g.
// "From:") at a line start, skips one space after the colon and returns the
// rest of that line. No folding support (continuation lines are not joined).
// Pure; probeable.
public string headerValue(string text, string headerName) {
    int nameLen = headerName.length;
    int pos = 0;
    while (pos < text.length) {
        int eol = lineEndFrom(text, pos);
        if (eol < 0) { break; }
        int lineLen = eol - pos;
        if (lineLen > nameLen) {
            bool headMatch = true;
            for (int k = 0; k < nameLen; k++) {
                if (int(text[pos + k]) != int(headerName[k])) { headMatch = false; }
            }
            if (headMatch) {
                int valStart = pos + nameLen;
                if (text[valStart] == 32) { valStart = valStart + 1; }
                return sliceRange(text, valStart, eol);
            }
        }
        pos = eol + 2;
    }
    return "";
}

// Body text of a RETR response: everything between the first blank line
// (the RFC 822 header/body separator) and the "\r\n.\r\n" terminator
// ("" when either is missing). Byte-stuffed ".." lines are preserved
// verbatim. Pure; probeable.
public string messageBody(string retrResp) {
    int blank = blankLineIndex(retrResp);
    if (blank < 0) { return ""; }
    int bodyStart = blank + 4;
    int bodyEnd = retrResp.length;
    int term = terminatorIndex(retrResp);
    if (term >= bodyStart) { bodyEnd = term; }
    if (bodyEnd < bodyStart) { return ""; }
    return sliceRange(retrResp, bodyStart, bodyEnd);
}

class message {
    public string sender;
    public string subject;
    public string body;
    public string raw;

    construct(string raw) { this.raw = raw; }
}

class client {
    private int sock;
    private string host;
    private int port;
    private string lastReply;
    private bool loggedIn;

    construct(string host, int port) {
        this.host = host;
        this.port = port;
        this.sock = -1;
        this.lastReply = "";
        this.loggedIn = false;
    }

    // The raw text of the last server reply on the control channel (""
    // before the first read). This is the graceful-failure surface: against
    // a non-POP3 listener it holds the banner the peer sent, or "" when the
    // peer said nothing and closed.
    public string getLastReply() {
        return this.lastReply;
    }

    // True only after a fully accepted greeting + USER + PASS exchange.
    public bool isLoggedIn() {
        return this.loggedIn;
    }

    // Greeting + USER + PASS flow, every step validated (+OK required).
    // On any mismatch fail() drops the connection and the server's last
    // words stay in getLastReply(). Plain-text USER/PASS only (no base64).
    public void login(string user, string pass) {
        this.sock = net.connectRaw(this.host, this.port);
        if (this.sock < 0) {
            this.sock = -1;
            this.lastReply = "";
            return;
        }
        net.setRecvTimeoutRaw(this.sock, 30000);
        this.readReply();
        if (!isOk(this.lastReply)) {
            this.fail();
            return;
        }
        this.sendLine("USER " + user);
        this.readReply();
        if (!isOk(this.lastReply)) {
            this.fail();
            return;
        }
        this.sendLine("PASS " + pass);
        this.readReply();
        if (!isOk(this.lastReply)) {
            this.fail();
            return;
        }
        this.loggedIn = true;
    }

    // STAT: validated +OK, then the pure statCount() digit scan. Returns 0
    // on any failure or malformed reply.
    public int count() {
        if (!this.loggedIn) { return 0; }
        if (this.sock < 0) { return 0; }
        net.setRecvTimeoutRaw(this.sock, 30000);
        this.sendLine("STAT");
        this.readReply();
        if (!isOk(this.lastReply)) { return 0; }
        int n = statCount(this.lastReply);
        if (n < 0) { return 0; }
        return n;
    }

    // LIST (no argument): the multi-line response's data lines ("id octets"
    // strings), split on "\r\n". Returns [] on any failure.
    public string[] list() {
        string[] empty = [];
        if (!this.loggedIn) { return empty; }
        if (this.sock < 0) { return empty; }
        net.setRecvTimeoutRaw(this.sock, 30000);
        this.sendLine("LIST");
        this.readMulti();
        int term = terminatorIndex(this.lastReply);
        if (term < 0) { return empty; }
        int statusEnd = lineEndIndex(this.lastReply);
        if (statusEnd < 0 || statusEnd + 2 > term) { return empty; }
        string data = sliceRange(this.lastReply, statusEnd + 2, term);
        if (data.length <= 0) { return empty; }
        return data.split("\r\n");
    }

    // RETR: reads the full multi-line response and fills the message's
    // sender/subject/body via the pure helpers (raw keeps the whole
    // response, status line and terminator included). On any failure the
    // message is returned empty (raw "").
    public message retrieve(int id) {
        string raw = "";
        if (this.sock >= 0 && this.loggedIn) {
            net.setRecvTimeoutRaw(this.sock, 30000);
            this.sendLine("RETR " + id);
            this.readMulti();
            if (isOk(this.lastReply)) { raw = this.lastReply; }
        }
        message m = new message(raw);
        m.sender = headerValue(raw, "From:");
        m.subject = headerValue(raw, "Subject:");
        m.body = messageBody(raw);
        return m;
    }

    // DELE: marks `id` for deletion (effective at QUIT per RFC 1939).
    // Returns true on +OK, false on any failure.
    public bool remove(int id) {
        if (!this.loggedIn) { return false; }
        if (this.sock < 0) { return false; }
        net.setRecvTimeoutRaw(this.sock, 30000);
        this.sendLine("DELE " + id);
        this.readReply();
        return isOk(this.lastReply);
    }

    // Sends QUIT and closes immediately without waiting for the +OK, so a
    // dead peer cannot stall quit().
    public void quit() {
        if (this.sock >= 0) {
            this.sendLine("QUIT");
            net.closeRaw(this.sock);
        }
        this.sock = -1;
        this.loggedIn = false;
    }

    // Sends one command line (CRLF appended). No-op on a dead channel --
    // every caller pairs it with a bounded read, so the failure surfaces
    // there instead.
    private void sendLine(string cmd) {
        if (this.sock < 0) { return; }
        net.sendRawLen(this.sock, cmd + "\r\n", cmd.length + 2);
    }

    // One bounded read of the control channel (raw bytes as a string; ""
    // on disconnect/timeout).
    private string recvLine() {
        if (this.sock < 0) { return ""; }
        return net.recvRaw(this.sock, 4096);
    }

    // Accumulates control-channel reads into lastReply until a full status
    // line (the first "\r\n") is seen, the peer goes quiet, or 16 reads
    // pass -- whichever comes first. Overwrites, never appends across
    // commands: a stale reply must not leak into the next check.
    private void readReply() {
        string acc = "";
        for (int guard = 0; guard < 16; guard++) {
            string chunk = this.recvLine();
            if (chunk.length <= 0) { break; }
            acc += chunk;
            if (lineEndIndex(acc) >= 0) { break; }
        }
        this.lastReply = acc;
    }

    // Accumulates control-channel reads into lastReply until the POP3
    // ".\r\n" multi-line terminator is seen (multiLineComplete), the peer
    // goes quiet, or 16 x 4096 bytes (~64 KB) pass -- whichever comes
    // first. Same overwrite semantics as readReply().
    private void readMulti() {
        string acc = "";
        for (int guard = 0; guard < 16; guard++) {
            string chunk = this.recvLine();
            if (chunk.length <= 0) { break; }
            acc += chunk;
            if (terminatorIndex(acc) >= 0) { break; }
        }
        this.lastReply = acc;
    }

    // Drops the connection and marks the client logged out; lastReply
    // keeps whatever the server last said so the caller can surface it.
    private void fail() {
        this.loggedIn = false;
        if (this.sock >= 0) {
            net.closeRaw(this.sock);
        }
        this.sock = -1;
    }
}

// Index of the first "\r\n" at or after `startIdx` (the \r's index; -1 when
// absent). Private plumbing for the line-oriented scans. The parameter is
// spelled startIdx -- `from` is a lexer keyword on both compilers (never a
// parameter name).
private int lineEndFrom(string s, int startIdx) {
    for (int i = startIdx; i + 1 < s.length; i++) {
        if (s[i] == 13 && s[i + 1] == 10) { return i; }
    }
    return -1;
}

private int lineEndIndex(string s) {
    return lineEndFrom(s, 0);
}

// Index of the first "\r\n.\r\n" octet sequence in `s` (the \r's index;
// -1 when absent) -- POP3's multi-line terminator.
private int terminatorIndex(string s) {
    for (int i = 0; i + 4 < s.length; i++) {
        if (s[i] == 13 && s[i + 1] == 10 && s[i + 2] == 46 && s[i + 3] == 13 && s[i + 4] == 10) { return i; }
    }
    return -1;
}

// Index of the first "\r\n\r\n" (the RFC 822 header/body separator; -1 when
// absent).
private int blankLineIndex(string s) {
    for (int i = 0; i + 3 < s.length; i++) {
        if (s[i] == 13 && s[i + 1] == 10 && s[i + 2] == 13 && s[i + 3] == 10) { return i; }
    }
    return -1;
}

// Copies s[start .. end) character by character. Deliberately NOT substr:
// rs's two-arg substr treats X as an END offset while the self-host treats
// it as a LENGTH -- identical only when start is 0 (probed; see
// silverc-rs/src/string_ops.rs emit_string_substring) -- and every caller
// here slices from a nonzero offset.
private string sliceRange(string s, int start, int end) {
    string result = "";
    for (int i = start; i < end; i++) {
        result += s[i];
    }
    return result;
}

// Parses the `which`-th space-separated integer after the "+OK " prefix of
// a STAT reply (which = 1 -> count, 2 -> octets). Returns -1 when the
// number is missing or malformed.
private int statNumber(string resp, int which) {
    int i = 3;
    for (int n = 1; n <= which; n++) {
        while (i < resp.length && resp[i] == 32) { i++; }
        int val = 0;
        bool any = false;
        while (i < resp.length) {
            int c = resp[i] & 0xFF;
            if (c < 48 || c > 57) { break; }
            val = val * 10 + (c - 48);
            i++;
            any = true;
        }
        if (!any) { return -1; }
        if (n == which) { return val; }
    }
    return -1;
}
