mod export console;

// DOCS -- public `console` module. This is the universal, portable console
// library -- one module, one OS layer (console -> win32.kernel32). The
// kernel32 calls live inline in the `#on WINDOWS` region of the public
// function that needs them, one unified function name per operation, no
// win-prefixed helpers, no wrapper indirection, no alias imports; OS
// selection is compile-time via the preprocessor regions, so the runtime
// `os.type` check is not used here.
//
// BEHAVIOR NOTES: the three attribute writers fetch the
// STD_OUTPUT_HANDLE pseudo-handle (GetStdHandle(-11)) and forward the masked
// color to kernel32!SetConsoleTextAttribute -- foreground masks the low
// nibble, background masks and shifts it into the high nibble, reset
// restores the default light-gray-on-black attribute 7. The handle lands in
// a local first because nested grant calls as arguments are not a shape the
// backends rely on. setTitle/getTitle/clear, rgb/bgRgb and the color-tag
// helpers are pure Silver -- ANSI control sequences and string building
// through the print/printline builtins with no DLL backing -- so they are
// NOT gated (ANSI is safe for redirected output).
//
// DISPATCH NOTE: silverc-rs answers console calls
// with its native builtin (src/stdlib/console.rs gen_console_call) before any
// module source is consulted, and it never collects this file (console is in
// main.rs's builtin_modules_set), so the DLL-backed bodies below are dead
// code there -- including the constants, which stdlib::console::constant
// mirrors natively. The self-hosted compiler has no native console-call
// builtins and dispatches those calls to these globals. The `console.title`
// property is the one native sliver on the self-hosted side too: mini_cg
// answers a read with the documented empty-string fallback and rewrites a
// write into a setTitle call that lands on this file. Both paths produce
// the same behavior.

public const int Black = 0;
public const int DarkBlue = 1;
public const int DarkGreen = 2;
public const int DarkCyan = 3;
public const int DarkRed = 4;
public const int DarkMagenta = 5;
public const int DarkYellow = 6;
public const int Gray = 7;
public const int DarkGray = 8;
public const int Blue = 9;
public const int Green = 10;
public const int Cyan = 11;
public const int Red = 12;
public const int Magenta = 13;
public const int Yellow = 14;
public const int White = 15;
public const int BrightGreen = 10;
public const int BrightRed = 12;

public void setForeground(int color) {
    #on WINDOWS
    int h = GetStdHandle(-11);
    SetConsoleTextAttribute(h, color & 0x0F);
    #off
}

public void setBackground(int color) {
    #on WINDOWS
    int h = GetStdHandle(-11);
    SetConsoleTextAttribute(h, (color & 0x0F) << 4);
    #off
}

public void reset() {
    #on WINDOWS
    int h = GetStdHandle(-11);
    SetConsoleTextAttribute(h, 7);
    #off
}

public void foreground(int color) { setForeground(color); }

// Terminal title and clear-screen helpers. ANSI control sequences
// are safe for redirected output and work in Windows Terminal/conhost.
public void setTitle(string value) {
    print("\x1b]0;" + value + "\x07");
}

public string getTitle() {
    // The self-hosted compiler has no portable console-title read primitive;
    // callers still get the documented empty-string fallback on hosts where
    // the native title cannot be queried.
    return "";
}

public void clear() {
    print("\x1b[2J\x1b[H");
}

public void rgb(int r, int g, int b) {
    string seq = "\x1b[38;2;" + r + ";" + g + ";" + b + "m";
    printline(seq);
}

public void bgRgb(int r, int g, int b) {
    string seq = "\x1b[48;2;" + r + ";" + g + ";" + b + "m";
    printline(seq);
}

public string red(string text) { return "\x1b[31m" + text + "\x1b[0m"; }
public string green(string text) { return "\x1b[32m" + text + "\x1b[0m"; }
public string yellow(string text) { return "\x1b[33m" + text + "\x1b[0m"; }
public string blue(string text) { return "\x1b[34m" + text + "\x1b[0m"; }
public string magenta(string text) { return "\x1b[35m" + text + "\x1b[0m"; }
public string cyan(string text) { return "\x1b[36m" + text + "\x1b[0m"; }
public string white(string text) { return "\x1b[37m" + text + "\x1b[0m"; }
public string bold(string text) { return "\x1b[1m" + text + "\x1b[0m"; }
public string dim(string text) { return "\x1b[2m" + text + "\x1b[0m"; }
public string underline(string text) { return "\x1b[4m" + text + "\x1b[0m"; }
