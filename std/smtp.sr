import * from net;

mod export smtp;

// DOCS -- public `smtp` module (UNIFIED_CORE_LIBRARY.md §4). This is the
// universal, portable front of the SMTP library. It is a PROTOCOL module
// and contains ZERO OS code: no win32 imports, no `#on` regions -- every
// byte on the wire is sent through the universal socket core std/net.sr
// (connectRaw/sendRawLen/recvRaw/closeRaw/setRecvTimeoutRaw), whose Windows
// regions hold the ws2_32 calls. This module is pure SMTP protocol logic
// and compiles unchanged on any backend that provides net.
//
// TRANSPORT: login() arms a 30 s SO_RCVTIMEO right after connectRaw
// (net.setRecvTimeoutRaw) and send()/close() re-arm it on their first
// socket use -- every socket has a 30 s receive timeout. The recv loop
// itself (recvResp) calls net.recvRaw(fd, 4096) and the sender
// (sendCmd/send's DATA phase) calls net.sendRawLen. net.recvRaw normalizes
// a zero-extended SOCKET_ERROR to 4294967295 (`n <= 0 || n > 2147483647`)
// and then reports "" for `n <= 0` -- recv error and disconnect share the
// same graceful shape.
//
// FAIL-STOP STYLE: a connect failure surfaces as fd -1 and a failed send
// path as an unresponsive channel -- login returns silently, getLastReply()
// stays "" or holds the server's last words, no exceptions anywhere.
//
// DISPATCH: `smtp` is builtin-reserved on NEITHER compiler -- silverc-rs's
// builtin_modules_set (src/main.rs:81 lists fs/json/yaml/env/url/hash/path/
// bom/console/math/http only) and the self-hosted compiler's
// visBuiltinModule (compiler/visibility.sr:605) plus its driver prepend
// list all exclude it. Both compilers resolve `import * from smtp;` as an
// ORDINARY SOURCE module (std/smtp.sr); no native dispatch exists.
// (smtp.sr's entry in silverc.srp's exclude list only keeps it out of the
// compiler's own aggregate build -- the same posture as ftp.sr/ftps.sr; it
// does not make `smtp` a builtin.)
//
// LOGIN FLOW: greeting (220), EHLO (250, with a HELO fallback for servers
// that reject EHLO), AUTH LOGIN (334), base64 user (334), base64 pass
// (235); every step is read and validated, and the outcome is recorded in
// isLoggedIn()/getLastReply(). The credentials are encoded by the module's
// own b64Encode (see its note: encoding.base64Encode is a runtime crasher).
// Against a non-SMTP listener the login fails gracefully: the server's
// banner (or "" after a silent disconnect) is surfaced through
// getLastReply() and the process exits cleanly. No exceptions anywhere.
//
// SEND FLOW: MAIL FROM 250 -> RCPT TO 250 -> DATA 354 -> message 250, each
// step read and validated. The message (buildMessage) is sent RAW -- it
// already ends with "\r\n.\r\n", so no command CRLF is appended after it.
// Bounded reads: every socket gets a 30 s SO_RCVTIMEO, and readReply()'s
// accumulation loop is additionally capped at 16 iterations so no path can
// spin forever. close() sends QUIT and closes immediately without waiting
// for the 221, so a dead peer cannot stall close().
//
// SCOPE: startTLS() is a stored no-op -- no TLS stack exists behind this
// module (a real STARTTLS upgrade is a separate feature). attach() stores
// its path without effect -- send() never reads `attachments` and no MIME
// multipart exists, so send() emits the plain single-part message. There
// is no server class.
//
// PUBLIC API: class client -- construct(string host, int port);
// startTLS(); login(string user, string pass); setFrom(string addr);
// setTo(string addr); cc(string addr); subject(string s); body(string b);
// html(string h); attach(string path); send(); close(); isLoggedIn();
// getLastReply(); free functions replyCode(resp) (first three digits as
// int, -1 on malformed), replyComplete(resp) (true once a terminating
// "nnn " line is present -- SMTP multi-line replies use the same RFC
// "nnn-text ... nnn space" shape as FTP) and buildMessage(from, to, cc,
// subject, bodyText, isHtml) (assembles the RFC 5322 message exactly as
// send() puts it on the wire, "\r\n.\r\n" terminated -- Cc line only when
// cc is non-empty, text/html vs text/plain by if/else) -- all pure.
// isLoggedIn() is true only after a fully accepted EHLO/HELO + AUTH LOGIN
// exchange (through the 235 acceptance); getLastReply() returns the raw
// text of the last server reply ("" before the first read). recvResp is a
// single bounded read; the multi-line reply accumulation lives in the
// private readReply. The private lastReply/loggedIn fields round out the
// surface; construct() initializes every field (sock to -1, strings to "",
// attachments to []) so no member is ever uninitialized.
//
// NAMING: the setters are setFrom/setTo because `from` and `to` are lexer
// keywords on both compilers (the `import ... from ...` statement uses
// them -- silverc-rs src/token.rs:456/:482, self-host compiler/lexer.sr:
// 684/:711), so `from(addr)`/`to(addr)` cannot be declared anywhere. The
// remaining setter names (cc, subject, body, html, attach) are not
// keywords on either compiler.
//
// CALLER NOTES: instantiate the client with `var c = new client(...);` --
// a lowercase class arriving from a star-imported module cannot be spelled
// as a local's type on silverc-rs (per-file parsing: `client c` dies with
// "unknown keyword"; `new mod.client()` dies on BOTH compilers; `var`
// works on both, probed via std/ftps.sr). Strings returned across this
// module's boundary (getLastReply/buildMessage) should be assigned to a
// local before being concatenated into larger expressions (silverc-rs
// stringifies the return pointer in expression position; see std/dns.sr's
// RS-ONLY CALLER LANDMINE). smtp's own b64Encode is same-module, so
// login() has no cross-module string call at all.

public int replyCode(string resp) {
    if (resp.length < 3) { return -1; }
    int code = 0;
    for (int i = 0; i < 3; i++) {
        int c = resp[i] & 0xFF;
        if (!isDigit(c)) { return -1; }
        code = code * 10 + (c - 48);
    }
    return code;
}

// True when `resp` already contains a terminating SMTP reply line: some
// "\r\n"-delimited line whose first three chars are digits and whose fourth
// char is a space (RFC 5321's "nnn " terminal form). Multi-line replies
// ("nnn-text ... nnn text", e.g. EHLO capability lists) complete only at
// the space form, so the wrapper's readers keep accumulating until this
// fires or the bounded loop exhausts.
public bool replyComplete(string resp) {
    int lineStart = 0;
    for (int i = 0; i < resp.length; i++) {
        if (resp[i] == 13 && i + 1 < resp.length && resp[i + 1] == 10) {
            int lineLen = i - lineStart;
            if (lineLen >= 4) {
                if (isDigit(resp[lineStart] & 0xFF) && isDigit(resp[lineStart + 1] & 0xFF) && isDigit(resp[lineStart + 2] & 0xFF) && resp[lineStart + 3] == 32) {
                    return true;
                }
            }
            i++;
            lineStart = i + 1;
        }
    }
    return false;
}

// Assembles the RFC 5322 message exactly as send() puts it on the wire:
// From/To/optional-Cc/Subject/Content-Type headers, a blank line, the body,
// and the SMTP "\r\n.\r\n" DATA terminator (which is why the caller sends
// the result RAW -- no command CRLF is appended). text/html vs text/plain
// by if/else (string-typed ternaries avoided). Pure; probeable
// byte-identical on both compilers.
public string buildMessage(string fromAddr, string toAddr, string ccAddr, string subject, string bodyText, bool isHtml) {
    string msg = "From: " + fromAddr + "\r\n";
    msg += "To: " + toAddr + "\r\n";
    if (ccAddr.length > 0) { msg += "Cc: " + ccAddr + "\r\n"; }
    msg += "Subject: " + subject + "\r\n";
    if (isHtml) {
        msg += "Content-Type: text/html\r\n\r\n";
    } else {
        msg += "Content-Type: text/plain\r\n\r\n";
    }
    msg += bodyText + "\r\n.\r\n";
    return msg;
}

private bool isDigit(int c) {
    return c >= 48 && c <= 57;
}

// Base64 encoder for the AUTH LOGIN credentials. Pure and probeable.
// Deliberately local to this module rather than a call into std/encoding:
// encoding.base64Encode is a runtime CRASHER on both compilers (probed
// 2026-08: a minimal `encoding.base64Encode("silveruser")` program dies
// 0xC0000005 on silverc-rs and 0xC0000409 on the self-host) because
// encoding.sr builds on the phantom `string.toBytes()` method. This
// implementation indexes the input string directly (strings ARE packed byte
// buffers -- data[i] reads one byte), needing no toBytes() at all.
// Byte-exact RFC 4648 output with '=' padding (probed against the known
// vectors c2lsdmVydXNlcg== / c2lsdmVycGFzcw== on both compilers). The `<<`
// work happens inside this multi-line body only -- one-liner methods with
// shifts are a self-host landmine.
public string b64Encode(string data) {
    string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    int len = data.length;
    string result = "";
    for (int i = 0; i < len; i += 3) {
        int b0 = data[i] & 0xFF;
        int n1 = (b0 >> 2) & 0x3F;
        int n2 = (b0 & 0x03) << 4;
        int n3 = -1;
        int n4 = -1;
        if (i + 1 < len) {
            int b1 = data[i + 1] & 0xFF;
            n2 = n2 | ((b1 >> 4) & 0x0F);
            n3 = (b1 & 0x0F) << 2;
            if (i + 2 < len) {
                int b2 = data[i + 2] & 0xFF;
                n3 = n3 | ((b2 >> 6) & 0x03);
                n4 = b2 & 0x3F;
            }
        }
        result += chars[n1];
        result += chars[n2];
        if (n3 < 0) { result += "="; } else { result += chars[n3]; }
        if (n4 < 0) { result += "="; } else { result += chars[n4]; }
    }
    return result;
}

class client {
    private int sock;
    private string host;
    private int port;
    private string fromAddr;
    private string toAddr;
    private string ccAddr;
    private string subj;
    private string bodyContent;
    private bool isHtml;
    private string[] attachments;
    private string lastReply;
    private bool loggedIn;

    construct(string host, int port) {
        this.host = host;
        this.port = port;
        this.sock = -1;
        this.lastReply = "";
        this.loggedIn = false;
        this.fromAddr = "";
        this.toAddr = "";
        this.ccAddr = "";
        this.subj = "";
        this.bodyContent = "";
        this.isHtml = false;
        this.attachments = [];
    }

    // Stored no-op: no TLS stack exists behind this module, so calling it
    // changes nothing. Kept so the public API stays identical.
    public void startTLS() { }

    // The raw text of the last server reply on the control channel (""
    // before the first read). This is the graceful-failure surface: against
    // a non-SMTP listener it holds the banner the peer sent, or "" when the
    // peer said nothing and closed.
    public string getLastReply() {
        return this.lastReply;
    }

    // True only after a fully accepted greeting + EHLO/HELO + AUTH LOGIN
    // exchange (through the 235 acceptance).
    public bool isLoggedIn() {
        return this.loggedIn;
    }

    // AUTH LOGIN flow: greeting 220, EHLO 250 with a HELO fallback, AUTH
    // LOGIN 334, base64 user 334, base64 pass 235. Every step is read and
    // validated; on any mismatch fail() drops the connection and the
    // server's last words stay in getLastReply().
    public void login(string user, string pass) {
        this.sock = net.connectRaw(this.host, this.port);
        if (this.sock < 0) {
            this.sock = -1;
            this.lastReply = "";
            return;
        }
        net.setRecvTimeoutRaw(this.sock, 30000);
        this.readReply();
        if (replyCode(this.lastReply) != 220) {
            this.fail();
            return;
        }
        this.sendCmd("EHLO " + this.host);
        this.readReply();
        if (replyCode(this.lastReply) != 250) {
            this.sendCmd("HELO " + this.host);
            this.readReply();
            if (replyCode(this.lastReply) != 250) {
                this.fail();
                return;
            }
        }
        this.sendCmd("AUTH LOGIN");
        this.readReply();
        if (replyCode(this.lastReply) != 334) {
            this.fail();
            return;
        }
        string u = b64Encode(user);
        this.sendCmd(u);
        this.readReply();
        if (replyCode(this.lastReply) != 334) {
            this.fail();
            return;
        }
        string p = b64Encode(pass);
        this.sendCmd(p);
        this.readReply();
        if (replyCode(this.lastReply) != 235) {
            this.fail();
            return;
        }
        this.loggedIn = true;
    }

    // `from` is a lexer keyword on both compilers (import statement), so
    // this setter is spelled setFrom -- see NAMING in the header.
    public void setFrom(string addr) { this.fromAddr = addr; }

    // `to` is a lexer keyword on both compilers, so this setter is spelled
    // setTo -- see NAMING in the header.
    public void setTo(string addr) { this.toAddr = addr; }
    public void cc(string addr) { this.ccAddr = addr; }
    public void subject(string s) { this.subj = s; }
    public void body(string b) { this.bodyContent = b; this.isHtml = false; }
    public void html(string h) { this.bodyContent = h; this.isHtml = true; }

    // Stores the path; send() never reads it (no MIME multipart exists, so
    // send() emits the plain single-part message).
    public void attach(string path) { this.attachments.push(path); }

    // MAIL FROM 250 -> RCPT TO 250 -> DATA 354 -> message 250. The message
    // (buildMessage) is sent RAW: it already ends with "\r\n.\r\n", so the
    // one-line-command CRLF must NOT be appended after it. A failed step
    // returns silently; getLastReply() holds the server's last words.
    public void send() {
        if (!this.loggedIn) { return; }
        if (this.sock < 0) { return; }
        net.setRecvTimeoutRaw(this.sock, 30000);
        this.sendCmd("MAIL FROM:<" + this.fromAddr + ">");
        this.readReply();
        if (replyCode(this.lastReply) != 250) { return; }
        this.sendCmd("RCPT TO:<" + this.toAddr + ">");
        this.readReply();
        if (replyCode(this.lastReply) != 250) { return; }
        this.sendCmd("DATA");
        this.readReply();
        if (replyCode(this.lastReply) != 354) { return; }
        string msg = buildMessage(this.fromAddr, this.toAddr, this.ccAddr, this.subj, this.bodyContent, this.isHtml);
        if (this.sock >= 0) {
            net.sendRawLen(this.sock, msg, msg.length);
        }
        this.readReply();
        if (replyCode(this.lastReply) != 250) { return; }
    }

    // Sends QUIT and closes immediately without waiting for the 221, so a
    // dead peer cannot stall close().
    public void close() {
        if (this.sock >= 0) {
            this.sendCmd("QUIT");
            net.closeRaw(this.sock);
        }
        this.sock = -1;
        this.loggedIn = false;
    }

    // Sends one command line (CRLF appended). No-op on a dead channel --
    // every caller pairs it with a bounded read, so the failure surfaces
    // there instead.
    private void sendCmd(string cmd) {
        if (this.sock < 0) { return; }
        net.sendRawLen(this.sock, cmd + "\r\n", cmd.length + 2);
    }

    // One bounded read of the control channel (raw bytes as a string; ""
    // on disconnect/timeout).
    private string recvResp() {
        if (this.sock < 0) { return ""; }
        return net.recvRaw(this.sock, 4096);
    }

    // Accumulates control-channel reads into lastReply until a terminating
    // "nnn " line is seen (replyComplete), the peer goes quiet, or 16
    // reads pass -- whichever comes first. Overwrites, never appends
    // across commands: a stale reply must not leak into the next check.
    private void readReply() {
        string acc = "";
        for (int guard = 0; guard < 16; guard++) {
            string chunk = this.recvResp();
            if (chunk.length <= 0) { break; }
            acc += chunk;
            if (replyComplete(acc)) { break; }
        }
        this.lastReply = acc;
    }

    // Drops the connection and marks the client logged out; lastReply
    // keeps whatever the server last said so the caller can surface it.
    private void fail() {
        this.loggedIn = false;
        if (this.sock >= 0) {
            net.closeRaw(this.sock);
        }
        this.sock = -1;
    }
}
