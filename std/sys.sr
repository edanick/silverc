mod export sys;

#on WINDOWS
import * from win32.kernel32;
#on LINUX
import * from linux.libc;
#on MAC
import * from mac.libsystem;
#off

public void exit(int code) {
    #on WINDOWS
    ExitProcess(code);
    #else
    _exit(code);
    #off
}

public void end(int code) {
    #on WINDOWS
    ExitProcess(code);
    #else
    _exit(code);
    #off
}
