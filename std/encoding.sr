mod export encoding;

public string base64Encode(string data) {
    byte[] bytes = data.toBytes();
    int len = bytes.length;
    int outLen = ((len + 2) / 3) * 4;
    byte[] out = new byte[outLen];
    for (int i = 0; i < len; i += 3) {
        int b = (i < len ? bytes[i] : 0) << 16;
        b |= (i + 1 < len ? bytes[i + 1] : 0) << 8;
        b |= (i + 2 < len ? bytes[i + 2] : 0);
        string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        int idx = i / 3 * 4;
        out[idx] = chars[(b >> 18) & 0x3F];
        out[idx + 1] = chars[(b >> 12) & 0x3F];
        // NOTE: the ternaries are hoisted into decl temps because an
        // assignment-statement rhs `x = c ? a : b` mis-parses on the
        // self-host (the ternary escapes the assignment rhs); decl inits
        // parse it correctly on both compilers.
        int c3 = (i + 1 < len) ? chars[(b >> 6) & 0x3F] : '=';
        out[idx + 2] = c3;
        int c4 = (i + 2 < len) ? chars[b & 0x3F] : '=';
        out[idx + 3] = c4;
    }
    string result = "";
    for (int i = 0; i < outLen; i++) { result += char(out[i]); }
    return result;
}

public string base64Decode(string data) {
    // Single correct RFC 4648 decode for this home (§6): accumulator shape
    // shared with crypto.sr's cryptoBase64Decode — stops at '=' padding,
    // skips bytes outside the alphabet, so invalid input decodes clean
    // instead of emitting garbage bytes. The old block shape OR-ed -1 for
    // non-alphabet bytes and diverged from crypto on such input.
    string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    string result = "";
    int acc = 0;
    int bits = 0;
    for (int i = 0; i < data.length; i++) {
        char c = data[i];
        if (c == '=') { break; }
        // Manual alphabet scan: indexOf(char) lowers to strstr with the
        // char code as a pointer on both compilers, so it can never
        // be used here.
        int code = -1;
        for (int k = 0; k < chars.length; k++) {
            if (chars[k] == c) { code = k; break; }
        }
        if (code < 0) { continue; }
        acc = (acc << 6) | code;
        bits += 6;
        if (bits >= 8) {
            bits -= 8;
            result += char((acc >> bits) & 0xFF);
        }
    }
    return result;
}

public string base64UrlEncode(string data) {
    string b64 = base64Encode(data);
    return b64.replace("+", "-").replace("/", "_").replace("=", "");
}

public string base64UrlDecode(string data) {
    string b64 = data.replace("-", "+").replace("_", "/");
    while (b64.length % 4 > 0) { b64 += "="; }
    return base64Decode(b64);
}

public string hexEncode(string data) {
    byte[] bytes = data.toBytes();
    string hex = "0123456789abcdef";
    string result = "";
    for (int i = 0; i < bytes.length; i++) {
        result += hex[(bytes[i] >> 4) & 0x0F];
        result += hex[bytes[i] & 0x0F];
    }
    return result;
}

public string hexDecode(string data) {
    int len = data.length / 2;
    byte[] out = new byte[len];
    for (int i = 0; i < len; i++) {
        // Direct char indexing: substr's second argument is an END index on
        // silverc-rs but a LENGTH on the self-host, so substr(i*2, 2) is not
        // parity-safe and is avoided here.
        int high = hexVal(data[i * 2]);
        int low = hexVal(data[i * 2 + 1]);
        out[i] = (high << 4) | low;
    }
    string result = "";
    for (int i = 0; i < len; i++) { result += char(out[i]); }
    return result;
}

public byte[] toUtf8(string s) { return s.toBytes(); }
public string fromUtf8(byte[] bytes) {
    string result = "";
    for (int i = 0; i < bytes.length; i++) { result += char(bytes[i]); }
    return result;
}

public int[] toCodePoints(string s) {
    int[] points = [];
    for (int i = 0; i < s.length; i++) { points.push((int)s[i]); }
    return points;
}

public string detect(byte[] bytes) { return "utf-8"; }

public string toHexString(byte[] data) {
    string result = "";
    string hex = "0123456789ABCDEF";
    for (int i = 0; i < data.length; i++) {
        result += hex[(data[i] >> 4) & 0x0F];
        result += hex[data[i] & 0x0F];
    }
    return result;
}

public byte[] fromHexString(string hex) {
    int len = hex.length / 2;
    byte[] out = new byte[len];
    for (int i = 0; i < len; i++) {
        int hi = hex[i * 2];
        int lo = hex[i * 2 + 1];
        out[i] = (hexVal(hi) << 4) | hexVal(lo);
    }
    return out;
}

// Single nibble-value home for hexDecode/fromHexString (§6): one
// case-insensitive hex-char → value mapping, no per-site copies.
private int hexVal(int c) {
    if (c <= '9') { return c - '0'; }
    return (c & 0xDF) - 'A' + 10;
}
