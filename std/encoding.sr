mod export encoding;

public string base64Encode(string data) {
    byte[] bytes = data.toBytes();
    int len = bytes.length;
    int outLen = ((len + 2) / 3) * 4;
    byte[] out = new byte[outLen];
    for (int i = 0; i < len; i += 3) {
        int b = (i < len ? bytes[i] : 0) << 16;
        b |= (i + 1 < len ? bytes[i + 1] : 0) << 8;
        b |= (i + 2 < len ? bytes[i + 2] : 0);
        string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        int idx = i / 3 * 4;
        out[idx] = chars[(b >> 18) & 0x3F];
        out[idx + 1] = chars[(b >> 12) & 0x3F];
        out[idx + 2] = (i + 1 < len) ? chars[(b >> 6) & 0x3F] : '=';
        out[idx + 3] = (i + 2 < len) ? chars[b & 0x3F] : '=';
    }
    string result = "";
    for (int i = 0; i < outLen; i++) { result += char(out[i]); }
    return result;
}

public string base64Decode(string data) {
    string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    int inLen = data.length();
    int outLen = (inLen / 4) * 3;
    if (data[inLen - 1] == '=') { outLen--; }
    if (data[inLen - 2] == '=') { outLen--; }
    byte[] out = new byte[outLen];
    int o = 0;
    for (int i = 0; i < inLen; i += 4) {
        int b = 0;
        for (int j = 0; j < 4; j++) {
            if (i + j < inLen && data[i + j] != '=') {
                b = (b << 6) | chars.indexOf(data[i + j]);
            } else { b <<= 6; }
        }
        if (o < outLen) { out[o++] = (b >> 16) & 0xFF; }
        if (o < outLen) { out[o++] = (b >> 8) & 0xFF; }
        if (o < outLen) { out[o++] = b & 0xFF; }
    }
    string result = "";
    for (int i = 0; i < outLen; i++) { result += char(out[i]); }
    return result;
}

public string base64UrlEncode(string data) {
    string b64 = base64Encode(data);
    return b64.replace("+", "-").replace("/", "_").replace("=", "");
}

public string base64UrlDecode(string data) {
    string b64 = data.replace("-", "+").replace("_", "/");
    while (b64.length() % 4 > 0) { b64 += "="; }
    return base64Decode(b64);
}

public string hexEncode(string data) {
    byte[] bytes = data.toBytes();
    string hex = "0123456789abcdef";
    string result = "";
    for (int i = 0; i < bytes.length; i++) {
        result += hex[(bytes[i] >> 4) & 0x0F];
        result += hex[bytes[i] & 0x0F];
    }
    return result;
}

public string hexDecode(string data) {
    int len = data.length() / 2;
    byte[] out = new byte[len];
    for (int i = 0; i < len; i++) {
        string h = data.substr(i * 2, 2);
        int high = h[0] <= '9' ? h[0] - '0' : (h[0] & 0xDF) - 'A' + 10;
        int low = h[1] <= '9' ? h[1] - '0' : (h[1] & 0xDF) - 'A' + 10;
        out[i] = (high << 4) | low;
    }
    string result = "";
    for (int i = 0; i < len; i++) { result += char(out[i]); }
    return result;
}

public byte[] toUtf8(string s) { return s.toBytes(); }
public string fromUtf8(byte[] bytes) {
    string result = "";
    for (int i = 0; i < bytes.length; i++) { result += char(bytes[i]); }
    return result;
}

public int[] toCodePoints(string s) {
    int[] points;
    for (int i = 0; i < s.length(); i++) { points.push(int(s[i])); }
    return points;
}

public string detect(byte[] bytes) { return "utf-8"; }

public string toHexString(byte[] data) {
    string result = "";
    string hex = "0123456789ABCDEF";
    for (int i = 0; i < data.length; i++) {
        result += hex[(data[i] >> 4) & 0x0F];
        result += hex[data[i] & 0x0F];
    }
    return result;
}

public byte[] fromHexString(string hex) {
    int len = hex.length() / 2;
    byte[] out = new byte[len];
    for (int i = 0; i < len; i++) {
        int high = hex[i * 2] <= '9' ? hex[i * 2] - '0' : (hex[i * 2] & 0xDF) - 'A' + 10;
        int low = hex[i * 2 + 1] <= '9' ? hex[i * 2 + 1] - '0' : (hex[i * 2 + 1] & 0xDF) - 'A' + 10;
        out[i] = (high << 4) | low;
    }
    return out;
}
