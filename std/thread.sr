mod export threads;

// DOCS -- public `threads` module (UNIFIED_CORE_LIBRARY.md v2 canonical
// fold). This is the universal threading module: the former internal Windows
// backend std/thread_win.sr was folded back into this file and deleted.
// There is no thread_win.sr anymore -- one module, one OS layer
// (threads -> win32.kernel32).
//
// CANONICAL SHAPE (v2 rule 6): the raw OS calls live INSIDE the public
// function bodies (Thread.start / Thread.join / sleep) behind `#on WINDOWS`
// regions -- one unified function name, no win-prefixed helpers, no wrapper
// indirection. The osType() runtime gates and the `os` import are gone (the
// preprocessor replaces them); no #else and no LINUX/MAC placeholders -- the
// other-OS regions get filled on their own machines later. For a future
// non-Windows backend the fallbacks follow the module's existing failure
// style: sleep() is a silent no-op, start() leaves the handle at 0 so
// join() is a no-op too, and the spawn path reports failure through the 0
// handle (the Win32 failure convention this module already used).
//
// PLAIN IMPORT: the kernel32 grant is a plain full-table
// `import * from win32.kernel32;` inside its own region -- alias imports are
// removed in v2. TABLE STATUS: Sleep, WaitForSingleObject and CloseHandle
// are tabled on BOTH compilers (silverc-rs/src/win32.rs and the self-host
// win32ExportTable), so the plain grant resolves them directly. CreateThread
// is tabled on NEITHER, and the plain full-table grant resolves calls
// strictly against the tables (silverc-rs win32::resolve scans
// dll_exports first; the self-host win32Allowed checks win32TableHas) -- so
// a CreateThread call through this import would fail to compile, which is
// exactly the dead-spawn posture the pre-fold module documented (below).
//
// DISPATCH (per compiler, probed, unchanged by this fold): `threads` is
// builtin-reserved on NEITHER compiler -- silverc-rs main.rs
// builtin_modules_set and the self-hosted std/project.sr projectBuiltin list
// both exclude it, and neither codegen has any native `threads.*` intercept
// -- so on both compilers every `threads.*` call resolves to the
// globals/classes of this collected module (silverc-rs rewrites the
// module-qualified MethodCall to the bare-name gen_call, genUserCall
// resolves it as a module call). The self-hosted compiler intercepts the
// FIELD read `threads.length` for its own --threads count
// (MiniCg.emitFieldAccess) -- a pre-existing builtin, unrelated to this
// module's API, which defines no `length` member.
//
// DEAD SPAWN MECHANISM (probed, preserved, stays dead -- documented): the
// pre-split std/thread.sr passed its private trampoline to CreateThread as a
// BARE FUNCTION NAME -- `CreateThread(null, 0, threadStart, this, 0, null)`.
// Neither compiler supports function-name-as-value: an identifier that names
// a function lowers to a null/garbage slot (silverc-rs gen_expr falls
// through to `xor eax, eax` = 0; the self-hosted MiniCg loads [rbp+0], the
// saved frame pointer). The pre-split file also used the pre-DOCS/259
// C-style `function void()` syntax, which no longer parses, and sat in
// silverc.srp's exclude list -- so it never compiled anywhere. The fold
// keeps that posture: the spawn entry is unreachable dead text (a spawned
// thread would jump to an invalid address and fault the process -- the
// preserved historical behavior, not a regression), and CreateThread is not
// callable through the plain grant anyway (see PLAIN IMPORT). Every public
// signature keeps its name/arity/return type; the three shapes the language
// cannot express (fn-typed ctor parameters, fn-typed props, arrays of fn
// types -- all probed on both compilers pre-DOCS/259 and since ported) are
// documented at their sites below.
//
// BOUNDED JOIN: join waits with the pre-split -1 (INFINITE) millisecond
// count on the stored handle only; the public join() guards on
// `this.handle != 0` first (pre-split guard, kept), so joining an
// un-started Thread is a no-op and probes over this module can never hang
// through it.

#on WINDOWS
import * from win32.kernel32;
#off

class Thread {
    private prop object fn;
    private prop int handle;

    construct (object fn) {
        this.fn = fn;
        this.handle = 0;
    }

    public void start() {
        #on WINDOWS
        // DEAD SPAWN (see header): the historical shape passed the private
        // trampoline `threadStart` below as a bare function name --
        // `this.handle = CreateThread(null, 0, threadStart, this, 0,
        // null);` -- which both compilers lower to a null/garbage entry
        // slot. It stays dead and UNCOMPILED: CreateThread is in neither
        // compiler's kernel32 export table, so the plain full-table grant
        // rejects the call, and the bare-function-name lowering would fault
        // any spawned thread at the invalid address. Preserved as
        // documented dead mechanism; this region intentionally holds no
        // spawn call.
        #off
    }

    public void join() {
        if (this.handle != 0) {
            #on WINDOWS
            WaitForSingleObject(this.handle, -1);
            CloseHandle(this.handle);
            #off
            this.handle = 0;
        }
    }
}

class ThreadGroup {
    private prop Thread[] threads;

    construct () {
        this.threads = [];
    }

    public void add(Thread t) {
        this.threads.add(t);
    }

    // The pre-split one-liner spelling `public Thread at(int index) <<
    // this.threads[index];` does not parse on the self-hosted compiler:
    // `<<` single-line bodies are supported only for GLOBAL functions
    // (probed -- even a literal-return one-liner method fails with
    // "expected ( but found void" at the next declaration; every std file
    // using one-liner methods sits in silverc.srp's exclude list, so the
    // gap was invisible). Same signature, explicit body:
    public Thread at(int index) {
        return this.threads[index];
    }

    public void startAll() {
        foreach (Thread t in this.threads) { t.start(); }
    }

    public void joinAll() {
        foreach (Thread t in this.threads) { t.join(); }
    }
}

public Thread start(void () fn) {
    Thread t = new Thread(fn);
    t.start();
    return t;
}

public ThreadGroup multi(object[] fns) {
    ThreadGroup g = new ThreadGroup();
    foreach (object fn in fns) {
        g.add(new Thread(fn));
    }
    return g;
}

public void sleep(int ms) {
    #on WINDOWS
    Sleep(ms);
    #off
}

private int threadStart(object param) {
    // DEAD SPAWN trampoline (see header): the historical body was
    // `Thread t = param as Thread; t.fn(); return 0;` and the historical
    // call site passed this trampoline to CreateThread as a bare function
    // name. Neither statement can compile (`as` casts did not parse on
    // either compiler when probed -- silverc-rs reported "Expected
    // expression" at the `as` -- and `t.fn()` needs the fn-typed prop
    // invocation), and the entry slot it was passed in lowered to
    // null/garbage, so its historical work was unreachable anyway. The
    // trampoline keeps its exact pre-split signature; nothing calls it.
    return 0;
}
