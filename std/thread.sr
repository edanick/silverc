mod export threads;

// DOCS -- public `threads` module (UNIFIED_CORE_LIBRARY.md §4). This is the
// universal threading module -- one module, one OS layer
// (threads -> win32.kernel32).
//
// SHAPE (UNIFIED_CORE_LIBRARY.md §4 rule 6): the raw OS calls live INSIDE
// the public function bodies (Thread.start / Thread.join / sleep) behind
// `#on WINDOWS` regions with a shared POSIX `#else` (LINUX/MAC spellings
// identical) -- one unified function name, no win-prefixed helpers, no
// wrapper indirection. OS selection is compile-time via the preprocessor;
// the module does not use the runtime `os` check. The failure style stays
// OS-independent: sleep() is a silent no-op, and a FAILED spawn leaves the
// handle at 0 so join() is a no-op too (the Win32 failure convention).
//
// PLAIN IMPORT: the kernel32 grant is a plain full-table
// `import * from win32.kernel32;` inside its own region -- no alias
// imports. TABLE STATUS: Sleep, WaitForSingleObject, CloseHandle AND
// CreateThread are tabled on BOTH compilers (silverc-rs/src/win32.rs and
// the self-host win32ExportTable -- the self-host's three sites are
// compiler/parser.sr, compiler/mini_cg/windows.sr and the native-call
// classifier in compiler/mini_cg/mini_cg.sr), so the plain grant resolves
// them directly. The plain full-table grant resolves calls strictly
// against the tables (silverc-rs win32::resolve scans dll_exports first;
// the self-host win32Allowed checks win32TableHas).
//
// DISPATCH (per compiler, probed): `threads` is
// builtin-reserved on NEITHER compiler -- silverc-rs main.rs
// builtin_modules_set and the self-hosted std/project.sr projectBuiltin list
// both exclude it, and neither codegen has any native `threads.*` intercept
// -- so on both compilers every `threads.*` call resolves to the
// globals/classes of this collected module (silverc-rs rewrites the
// module-qualified MethodCall to the bare-name gen_call, genUserCall
// resolves it as a module call). The self-hosted compiler intercepts the
// FIELD read `threads.length` for its own --threads count
// (MiniCg.emitFieldAccess) -- a pre-existing builtin, unrelated to this
// module's API, which defines no `length` member.
//
// SPAWN MECHANISM (probed): this module's spawn entry passes its private
// trampoline to CreateThread as a BARE FUNCTION NAME --
// `CreateThread(null, 0, threadStart, this, 0, null)`. Both compilers
// support function-name-as-value: an identifier that names a function
// lowers to the function's address (silverc-rs gen_expr pushes the address
// reloc and patches the placeholder; the self-hosted MiniCg does the same
// through findUserFunctionRef / genFunctionAddressRef / patchFnAddrRefs).
// The language also has the fn-typed constructor parameters, fn-typed props
// and fn-type arrays this API shape calls for (DOCS/259 G1/G2/G3), so the
// spawn is live.
//
// The trampoline's parameter is the Thread itself: the OS hands the pointer
// back in the first argument register (RCX on Win64, RDI on SysV), which is
// exactly where the callee's first parameter lives, so no cast is needed.
//
// BOUNDED JOIN: join waits with a -1 (INFINITE) millisecond count on the
// stored handle only; the public join() guards on `this.handle != 0`
// first, so joining an un-started Thread is a no-op and probes over this
// module can never hang through it.
//
// LINUX BACKEND (Phase B): pthread_create for the spawn, pthread_join for
// join(), nanosleep for sleep(), from linux.libc.
//
// MAC BACKEND (Phase B, code-only -- MAC.md section 10, UNVALIDATED until
// probed on Mac hardware): pthread_create for the spawn, pthread_join for
// join(), nanosleep for sleep() via mac.libsystem -- identical spellings,
// shared through `#else`.

#on WINDOWS
import * from win32.kernel32;
#on LINUX
import * from linux.libc;
#on MAC
import * from mac.libsystem;
#off

class Thread {
    // The callback to run on the new thread. A fn-typed prop holds the
    // callback's address; `this.fn()` calls through it (DOCS/259 G2).
    private prop void () fn;
    private prop int handle;

    construct (void () fn) {
        this.fn = fn;
        this.handle = 0;
    }

    public void start() {
        #on WINDOWS
        // CreateThread(NULL, 0, threadStart, this, 0, NULL): the start
        // routine is the module trampoline below and lpParameter is this
        // Thread, so the trampoline can recover the callback.
        this.handle = CreateThread(null, 0, threadStart, this, 0, null);
        #else
        // pthread_create(&tid, NULL, threadStart, this): same shape, with
        // the thread id written back through the first argument.
        int tid = 0;
        pthread_create(&tid, null, threadStart, this);
        this.handle = tid;
        #off
    }

    public void join() {
        if (this.handle != 0) {
            #on WINDOWS
            WaitForSingleObject(this.handle, -1);
            CloseHandle(this.handle);
            #else
            int ret = 0;
            pthread_join(this.handle, &ret);
            #off
            this.handle = 0;
        }
    }
}

class ThreadGroup {
    private prop Thread[] threads;

    construct {
        this.threads = [];
    }

    public void add(Thread t) {
        this.threads.add(t);
    }

    // The one-liner spelling `public Thread at(int index) <<
    // this.threads[index];` does not parse on the self-hosted compiler:
    // `<<` single-line bodies are supported only for GLOBAL functions
    // (probed -- even a literal-return one-liner method fails with
    // "expected ( but found void" at the next declaration). Same signature,
    // explicit body:
    public Thread at(int index) {
        return this.threads[index];
    }

    public void startAll() {
        foreach (Thread t in this.threads) { t.start(); }
    }

    public void joinAll() {
        foreach (Thread t in this.threads) { t.join(); }
    }
}

public Thread start(void () fn) {
    Thread t = new Thread(fn);
    t.start();
    return t;
}

// `multi` takes an ARRAY OF CALLBACKS -- `void ()[] fns` -- so each entry
// is callable in its own right (DOCS/259 G3: fn-typed arrays store an
// 8-byte address per element). The array parameter is by-reference (arrays
// are reference types), so the callee reads the caller's array in place.
//
// The loop is an INDEX loop, not a `foreach`: a `foreach` binding declares
// its variable's type, and the fn type is not a declarable variable type
// (only a parameter type and a prop type), so `foreach (void () fn in fns)`
// does not parse. The index loop reads the same elements -- `fns[i]` is the
// element's address, and `fns[i]()` calls through it.
public ThreadGroup multi(void ()[] fns) {
    ThreadGroup g = new ThreadGroup();
    for (int i = 0; i < fns.length; i++) {
        g.add(new Thread(fns[i]));
    }
    return g;
}

public void sleep(int ms) {
    #on WINDOWS
    Sleep(ms);
    #else
    if (ms < 0) { return; }
    int[] ts = new int[2];
    ts[0] = ms / 1000;
    ts[1] = (ms % 1000) * 1000000;
    int[] rem = new int[2];
    nanosleep(ts, rem);
    #off
}

// The thread entry point the OS calls. The OS hands the Thread pointer back
// as its single argument -- in the first argument register, which is where
// this callee's first parameter lives -- so the trampoline receives the
// Thread directly and runs the callback. It returns 0 -- the value is the
// thread's exit code, which nothing here reads.
private int threadStart(Thread t) {
    t.fn();
    return 0;
}
