mod export threads;

class Thread {
    private prop function void() fn;
    private prop int handle;

    construct (function void() fn) {
        this.fn = fn;
        this.handle = 0;
    }

    public void start() {
        this.handle = CreateThread(null, 0, threadStart, this, 0, null);
    }

    public void join() {
        if (this.handle != 0) {
            WaitForSingleObject(this.handle, -1);
            CloseHandle(this.handle);
            this.handle = 0;
        }
    }
}

class ThreadGroup {
    private prop Thread[] threads;

    construct () {
        this.threads = [];
    }

    public void add(Thread t) {
        this.threads.add(t);
    }

    public Thread at(int index) << this.threads[index];

    public void startAll() {
        foreach (Thread t in this.threads) { t.start(); }
    }

    public void joinAll() {
        foreach (Thread t in this.threads) { t.join(); }
    }
}

public Thread start(function void() fn) {
    Thread t = new Thread(fn);
    t.start();
    return t;
}

public ThreadGroup multi(function void()[] fns) {
    ThreadGroup g = new ThreadGroup();
    foreach (function void() fn in fns) {
        g.add(new Thread(fn));
    }
    return g;
}

public void sleep(int ms) << Sleep(ms);

private int threadStart(object param) {
    Thread t = param as Thread;
    t.fn();
    return 0;
}
