mod export toml;
import {stringify} from json;
import {readString, writeString} from fs;

public object parse(string raw) {
    object result = {};
    object currentSection = result;
    string[] lines = raw.split("\n");
    foreach (string line in lines) {
        line = line.trim();
        if (line.length() == 0 || line[0] == '#') { continue; }
        if (line[0] == '[') {
            int end = line.indexOf("]");
            if (end < 0) { continue; }
            string sectionName = line.substr(1, end - 1);
            currentSection = {};
            setNested(result, sectionName, currentSection);
        } else {
            int eq = line.indexOf("=");
            if (eq < 0) { continue; }
            string key = line.substr(0, eq).trim();
            string val = line.substr(eq + 1).trim();
            if ((val[0] == '\'' && val[val.length() - 1] == '\'') ||
                (val[0] == '"' && val[val.length() - 1] == '"')) {
                val = val.substr(1, val.length() - 2);
            } else {
                int dot = val.indexOf(".");
                if (dot >= 0) { }
            }
            currentSection[key] = val;
        }
    }
    return result;
}

public object load(string path) {
    string content = fs.readString(path);
    return parse(content);
}

public string stringify(object data) { return json.stringify(data); }

public void save(string path, object data) {
    fs.writeString(path, stringify(data));
}

private void setNested(object obj, string path, object value) {
    int dot = path.indexOf(".");
    if (dot < 0) { obj[path] = value; return; }
    string first = path.substr(0, dot);
    string rest = path.substr(dot + 1);
    if (obj[first] == null) { obj[first] = {}; }
    setNested(obj[first], rest, value);
}
