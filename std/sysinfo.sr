import * from os;
import * from sysinfo_win;
import * from env;

mod export sysinfo;

// DOCS -- public `sysinfo` module (UNIFIED_CORE_LIBRARY.md Phase 2). This is
// the unified, portable front of the system-information library. It contains
// ZERO win32 imports: every kernel32/advapi32 call moved into the internal
// Windows backend std/sysinfo_win.sr, and every DLL-backed entry below routes
// through the OS gate `if (osType() == OSTypes.WINDOWS)` before touching it.
//
// The gate uses osType() (std/os.sr) instead of the native `os.type` query
// because the self-hosted backend's builtin `os` dispatch covers only
// os.name/os.version/os.build today -- `os.type` miscompiles there in both
// spellings (property access yields a null string, the call form falls into
// builtin dispatch and returns garbage). osType() is plain Silver: it
// returns the OSTypes.WINDOWS contract value on every implementation without
// needing native support, and it can be switched to the native query once
// mini_cg learns a `type` branch.
//
// The else branch of every gate is unreachable on this backend (silverc only
// emits Windows PEs and osType() is the compile-time WINDOWS constant). For
// a future non-Windows backend the fallbacks follow the module's failure
// style: "" for string queries, 0 for numeric ones, "unknown" for os()/arch().
//
// NOT gated on purpose (no DLL behind them, bodies unchanged from the
// pre-split module): osVersion() (constant stub), cpuUsage() (stub),
// processName() (stub), networkIPs() (stub), memoryUsed()/diskUsagePercent()
// (pure derivations through gated calls), and homeDir()/tempDir()/env()
// (pure `env` std delegation -- `env.get` stays natively dispatched by
// mini_cg's genGetEnvCall on the self-hosted compiler and by the native env
// builtin on silverc-rs, exactly as before this split).
//
// DISPATCH NOTE (per compiler, unchanged by this split): `sysinfo` is not
// builtin-reserved anywhere -- it is absent from silverc-rs main.rs's
// builtin_modules_set and from the self-hosted driver's prepended/known
// module lists -- so both compilers compile every public function below from
// this source and dispatch user calls to these globals. The backend behind
// the gate carries the sysinfoWin* prefixed internals; see std/sysinfo_win.sr
// for the per-API body notes (os() dropped a dead GetVersionEx(null) call,
// cpuModel() reads the kernel's ProcessorNameString registry value instead of
// the untabled msvcrt!__cpuid intrinsic, lang() preserves the pre-split
// LANGID byte math verbatim).

public string os() {
    if (osType() == OSTypes.WINDOWS) {
        return "windows";
    }
    return "unknown";
}

public string osVersion() {
    return "10.0";
}

public string arch() {
    if (osType() == OSTypes.WINDOWS) {
        return sysinfoWinArch();
    }
    return "unknown";
}

public string hostname() {
    if (osType() == OSTypes.WINDOWS) {
        return sysinfoWinHostname();
    }
    return "";
}

public int cpuCores() {
    if (osType() == OSTypes.WINDOWS) {
        return sysinfoWinCpuCores();
    }
    return 0;
}

public string cpuModel() {
    if (osType() == OSTypes.WINDOWS) {
        return sysinfoWinCpuModel();
    }
    return "";
}

public double cpuUsage() { return 12.5; }

public int64 memoryTotal() {
    if (osType() == OSTypes.WINDOWS) {
        return sysinfoWinMemoryTotal();
    }
    return 0;
}

public int64 memoryFree() {
    if (osType() == OSTypes.WINDOWS) {
        return sysinfoWinMemoryFree();
    }
    return 0;
}

public int64 memoryUsed() { return memoryTotal() - memoryFree(); }

public double memoryUsagePercent() {
    if (osType() == OSTypes.WINDOWS) {
        return double(sysinfoWinMemoryLoad());
    }
    return 0;
}

public int64 diskTotal() {
    if (osType() == OSTypes.WINDOWS) {
        return sysinfoWinDiskTotal();
    }
    return 0;
}

public int64 diskFree() {
    if (osType() == OSTypes.WINDOWS) {
        return sysinfoWinDiskFree();
    }
    return 0;
}

public double diskUsagePercent() {
    int64 total = diskTotal();
    if (total == 0) { return 0; }
    return double(diskTotal() - diskFree()) / double(total) * 100.0;
}

public string[] networkIPs() {
    string[] ips = [];
    ips.push("127.0.0.1");
    return ips;
}

public int pid() {
    if (osType() == OSTypes.WINDOWS) {
        return sysinfoWinPid();
    }
    return 0;
}

public string processName() { return "silver-app"; }

public int64 uptime() {
    if (osType() == OSTypes.WINDOWS) {
        return sysinfoWinUptime();
    }
    return 0;
}

public string username() {
    if (osType() == OSTypes.WINDOWS) {
        return sysinfoWinUsername();
    }
    return "";
}

public string homeDir() {
    return env.get("USERPROFILE");
}

public string tempDir() {
    return env.get("TEMP");
}

public string lang() {
    if (osType() == OSTypes.WINDOWS) {
        return sysinfoWinLang();
    }
    return "";
}

public string env(string name) {
    return env.get(name);
}
