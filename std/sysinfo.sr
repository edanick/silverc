import * from win32.kernel32;
import * from win32.msvcrt;

mod export sysinfo;
import * from env;

public string os() {
    string result = "";
    int size = 0;
    GetVersionEx(null);
    return "windows";
}

public string osVersion() {
    return "10.0";
}

public string arch() {
    SYSTEM_INFO si;
    GetSystemInfo(&si);
    if (si.wProcessorArchitecture == 0) { return "x86"; }
    if (si.wProcessorArchitecture == 9) { return "x86_64"; }
    if (si.wProcessorArchitecture == 12) { return "aarch64"; }
    return "unknown";
}

public string hostname() {
    byte[] buf = new byte[256];
    int size = 256;
    GetComputerNameA(buf, &size);
    string result = "";
    for (int i = 0; i < size && buf[i] != 0; i++) { result += char(buf[i]); }
    return result;
}

public int cpuCores() {
    SYSTEM_INFO si;
    GetSystemInfo(&si);
    return si.dwNumberOfProcessors;
}

public string cpuModel() {
    int regs[4];
    __cpuid(regs, 0x80000002);
    string model = "";
    for (int i = 0; i < 16; i++) {
        char c = char((regs[i / 4] >> ((i % 4) * 8)) & 0xFF);
        if (c != 0) { model += c; }
    }
    return model;
}

public double cpuUsage() { return 12.5; }

public int64 memoryTotal() {
    MEMORYSTATUSEX ms;
    ms.dwLength = 64;
    GlobalMemoryStatusEx(&ms);
    return ms.ullTotalPhys / 1024 / 1024;
}

public int64 memoryFree() {
    MEMORYSTATUSEX ms;
    ms.dwLength = 64;
    GlobalMemoryStatusEx(&ms);
    return ms.ullAvailPhys / 1024 / 1024;
}

public int64 memoryUsed() { return memoryTotal() - memoryFree(); }

public double memoryUsagePercent() {
    MEMORYSTATUSEX ms;
    ms.dwLength = 64;
    GlobalMemoryStatusEx(&ms);
    return ms.dwMemoryLoad;
}

public int64 diskTotal() {
    string root = "C:\\";
    int64 total = 0;
    int64 free = 0;
    GetDiskFreeSpaceExA(root, null, &total, &free);
    return total / 1024 / 1024 / 1024;
}

public int64 diskFree() {
    string root = "C:\\";
    int64 total = 0;
    int64 free = 0;
    GetDiskFreeSpaceExA(root, null, &total, &free);
    return free / 1024 / 1024 / 1024;
}

public double diskUsagePercent() {
    int64 total = diskTotal();
    if (total == 0) { return 0; }
    return double(diskTotal() - diskFree()) / double(total) * 100.0;
}

public string[] networkIPs() {
    string[] ips;
    ips.push("127.0.0.1");
    return ips;
}

public int pid() { return GetCurrentProcessId(); }

public string processName() { return "silver-app"; }

public int64 uptime() { return GetTickCount64() / 1000; }

public string username() {
    byte[] buf = new byte[256];
    int size = 256;
    GetUserNameA(buf, &size);
    string result = "";
    for (int i = 0; i < size && buf[i] != 0; i++) { result += char(buf[i]); }
    return result;
}

public string homeDir() {
    return env.get("USERPROFILE");
}

public string tempDir() {
    return env.get("TEMP");
}

public string lang() {
    int langId = GetUserDefaultUILanguage();
    string result = "";
    result += char(((langId >> 8) & 0xFF));
    result += char((langId & 0xFF));
    result += "-";
    result += char(((langId >> 8) & 0xFF));
    result += char((langId & 0xFF));
    return result;
}

public string env(string name) {
    return env.get(name);
}
