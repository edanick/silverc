import * from env;

mod export sysinfo;

// DOCS -- public `sysinfo` module. This is the universal system-information
// library -- one module, one OS layer (sysinfo -> win32.kernel32 +
// win32.advapi32), no win-named helpers. Each raw OS call lives INSIDE its
// public function's body behind a `#on WINDOWS` ... `#off` region: one
// unified function name, no wrapper indirection, no `#else`, no LINUX/MAC
// placeholders (the non-Windows regions get filled on their own machines
// later). OS selection is compile-time via the preprocessor regions, so the
// runtime `os.type` check is not used here.
//
// IMPORT ORDER NOTE: GetUserNameA's true home is advapi32.dll (kernel32
// does not export it -- an exe importing it from kernel32 dies at load with
// STATUS_ENTRYPOINT_NOT_FOUND), and the compilers' kernel32 tables carry no
// GetUserNameA. advapi32 is imported first as belt-and-suspenders against
// resolve-order dependence; the self-hosted compiler does not depend on the
// order at all (mini_cg's elif chain classifies GetUserNameA as advapi32
// directly).
//
// NOT gated on purpose (no DLL behind them): osVersion() (constant stub),
// cpuUsage() (stub), processName() (stub), networkIPs() (stub),
// memoryUsed()/diskUsagePercent() (pure derivations through gated calls),
// os() (returns "windows" unconditionally -- silverc only emits Windows PEs),
// and homeDir()/tempDir()/env() (pure `env` std delegation). cpuModel()
// reads the kernel's ProcessorNameString registry value. lang() emits the
// high/low LANGID bytes, "-", then the same two bytes again (five chars,
// e.g. "\x09\x04-\x09\x04" for en-US = 0x0409); that quirk is the documented
// API result.
//
// BUFFER IDIOMS (cross-compiler proven): fixed-size Win32 struct queries use
// int[] qword-slot buffers -- Silver arrays store one 8-byte element per
// slot with the variable holding the element-0 address, so the DLL fills
// whole slots and each field is masked/shifted back out (SYSTEM_INFO is 48
// bytes = 6 slots: wProcessorArchitecture is the WORD at offset 0, low half
// of slot 0, and dwNumberOfProcessors the DWORD at offset 32, low half of
// slot 4. MEMORYSTATUSEX is 64 bytes = 8 slots: dwLength primed to 64 at 0,
// dwMemoryLoad at 4 (high half of slot 0), ullTotalPhys at 8 (slot 1),
// ullAvailPhys at 16 (slot 2)). Byte-wise NUL-terminated data (computer
// name, user name, registry string) uses preallocated writable string
// buffers from the private blankBuf() helper: strings lower to dense char
// buffers on every backend, so an index reads one raw byte and a bare call
// passes the char pointer straight across the boundary. The decode loops
// compare each buffer byte against char(0), never the '\0' char literal --
// BOTH compilers' lexers resolve that escape to the digit character '0'
// (0x30), which would truncate every name at its first zero digit.
// GlobalMemoryStatusEx / GetDiskFreeSpaceExA / GetSystemInfo calls are
// deliberately DUPLICATED per function (no helpers) -- one unified public
// function per operation with its OS code inline.
//
// LINUX BACKEND (Phase B): sysconf(_SC_NPROCESSORS_ONLN = 84),
// uname/gethostname/getlogin_r/getpid/clock_gettime/statvfs from linux.libc
// plus /proc text parsing (cpuinfo/meminfo/environ) with open/read/close.
// struct utsname holds 65-byte fields (machine at +260); struct statvfs is
// 112 bytes (f_frsize slot 1, f_blocks slot 2, f_bavail slot 4, all u64).
// Two callouts: (1) the module's `env.get` delegation (homeDir/tempDir/
// lang) CANNOT serve Linux -- silverc-rs answers env.get NATIVELY and its
// native getter faults on Linux (probed SIGSEGV), so the LINUX bodies read
// /proc/self/environ directly with a local parser; (2) lang() returns the
// $LANG value (e.g. "en_US.UTF-8"), not a LANGID quirk -- documented
// difference. os() answers "linux" under LINUX. Separator note: `/`, no
// drive letters (diskTotal/Free stat "/"), case-sensitive.

// Writable string buffer of n bytes (spaces) for NUL-terminated Win32 data.
string blankBuf(int n) {
    string r = "";
    for (int i = 0; i < n; i++) { r = r + " "; }
    return r;
}

#on WINDOWS
import * from win32.advapi32;
import * from win32.kernel32;
#off
#on LINUX
import * from linux.libc;
#off

public string os() {
    #on WINDOWS
    return "windows";
    #off
    #on LINUX
    return "linux";
    #off
    return "";
}

public string osVersion() {
    return "10.0";
}

public string arch() {
    #on WINDOWS
    int[] si = new int[6];
    GetSystemInfo(si);
    int archCode = si[0] & 0xFFFF;
    if (archCode == 0) { return "x86"; }
    if (archCode == 9) { return "x86_64"; }
    if (archCode == 12) { return "aarch64"; }
    return "unknown";
    #off
    #on LINUX
    int[] u = new int[49];
    int rc = uname(u);
    if (rc != 0) { return "unknown"; }
    string machine = utsField(u, 260);
    if (machine == "x86_64") { return "x86_64"; }
    if (machine == "aarch64") { return "aarch64"; }
    if (machine == "i386" || machine == "i686") { return "x86"; }
    return "unknown";
    #off
    return "unknown";
}

public string hostname() {
    #on WINDOWS
    string buf = blankBuf(256);
    int size = 256;
    GetComputerNameA(buf, &size);
    string result = "";
    for (int i = 0; i < size && buf[i] != char(0); i++) { result += char(buf[i]); }
    return result;
    #off
    #on LINUX
    string buf = blankBuf(256);
    int rc = gethostname(buf, 256);
    if (rc != 0) { return ""; }
    string result = "";
    for (int i = 0; i < 256 && buf[i] != char(0); i++) { result += char(buf[i]); }
    return result;
    #off
    return "";
}

public int cpuCores() {
    #on WINDOWS
    int[] si = new int[6];
    GetSystemInfo(si);
    return si[4] & 0xFFFFFFFF;
    #off
    #on LINUX
    return sysconf(84);
    #off
    return 0;
}

public string cpuModel() {
    #on WINDOWS
    int hkey = 0;
    if (RegOpenKeyExA(0x80000002, "HARDWARE\\DESCRIPTION\\System\\CentralProcessor\\0", 0, 0x20019, &hkey) != 0) { return ""; }
    string buf = blankBuf(256);
    int size = 256;
    int ok = RegQueryValueExA(hkey, "ProcessorNameString", null, null, buf, &size);
    RegCloseKey(hkey);
    if (ok != 0) { return ""; }
    string model = "";
    for (int i = 0; i < size && buf[i] != char(0); i++) { model += char(buf[i]); }
    return model;
    #off
    #on LINUX
    return procCpuModel();
    #off
    return "";
}

public double cpuUsage() { return 12.5; }

public int64 memoryTotal() {
    #on WINDOWS
    int[] ms = new int[8];
    ms[0] = 64;
    int ok = GlobalMemoryStatusEx(ms);
    if (ok == 0) { return 0; }
    return ms[1] / 1024 / 1024;
    #off
    #on LINUX
    return procMemValue("MemTotal") / 1024;
    #off
    return 0;
}

public int64 memoryFree() {
    #on WINDOWS
    int[] ms = new int[8];
    ms[0] = 64;
    int ok = GlobalMemoryStatusEx(ms);
    if (ok == 0) { return 0; }
    return ms[2] / 1024 / 1024;
    #off
    #on LINUX
    return procMemValue("MemAvailable") / 1024;
    #off
    return 0;
}

public int64 memoryUsed() { return memoryTotal() - memoryFree(); }

public double memoryUsagePercent() {
    #on WINDOWS
    int[] ms = new int[8];
    ms[0] = 64;
    int ok = GlobalMemoryStatusEx(ms);
    if (ok == 0) { return 0; }
    return double((ms[0] >> 32) & 0xFFFFFFFF);
    #off
    #on LINUX
    int64 total = procMemValue("MemTotal");
    if (total <= 0) { return 0; }
    int64 avail = procMemValue("MemAvailable");
    return double(total - avail) / double(total) * 100.0;
    #off
    return 0;
}

public int64 diskTotal() {
    #on WINDOWS
    int64 totalBytes = 0;
    int64 freeBytes = 0;
    GetDiskFreeSpaceExA("C:\\", null, &totalBytes, &freeBytes);
    return totalBytes / 1024 / 1024 / 1024;
    #off
    #on LINUX
    int[] sv = new int[14];
    int rc = statvfs("/", sv);
    if (rc != 0) { return 0; }
    int64 total = sv[2] * sv[1];
    return total / 1024 / 1024 / 1024;
    #off
    return 0;
}

public int64 diskFree() {
    #on WINDOWS
    int64 totalBytes = 0;
    int64 freeBytes = 0;
    GetDiskFreeSpaceExA("C:\\", null, &totalBytes, &freeBytes);
    return freeBytes / 1024 / 1024 / 1024;
    #off
    #on LINUX
    int[] sv = new int[14];
    int rc = statvfs("/", sv);
    if (rc != 0) { return 0; }
    int64 free = sv[4] * sv[1];
    return free / 1024 / 1024 / 1024;
    #off
    return 0;
}

public double diskUsagePercent() {
    int64 total = diskTotal();
    if (total == 0) { return 0; }
    return double(diskTotal() - diskFree()) / double(total) * 100.0;
}

public string[] networkIPs() {
    string[] ips = [];
    ips.push("127.0.0.1");
    return ips;
}

public int pid() {
    #on WINDOWS
    return GetCurrentProcessId();
    #off
    #on LINUX
    return getpid();
    #off
    return 0;
}

public string processName() { return "silver-app"; }

public int64 uptime() {
    #on WINDOWS
    return GetTickCount64() / 1000;
    #off
    #on LINUX
    int[] ts = new int[2];
    clock_gettime(1, ts);
    int64 sec = ts[0];
    return sec;
    #off
    return 0;
}

public string username() {
    #on WINDOWS
    string buf = blankBuf(256);
    int size = 256;
    GetUserNameA(buf, &size);
    string result = "";
    for (int i = 0; i < size && buf[i] != char(0); i++) { result += char(buf[i]); }
    return result;
    #off
    #on LINUX
    string buf = blankBuf(256);
    int rc = getlogin_r(buf, 256);
    if (rc == 0) {
        string result = "";
        for (int i = 0; i < 256 && buf[i] != char(0); i++) { result += char(buf[i]); }
        if (result.length() > 0) { return result; }
    }
    return sysProcEnvValue("USER");
    #off
    return "";
}

public string homeDir() {
    #on WINDOWS
    return env.get("USERPROFILE");
    #off
    #on LINUX
    return sysProcEnvValue("HOME");
    #off
    return "";
}

public string tempDir() {
    #on WINDOWS
    return env.get("TEMP");
    #off
    #on LINUX
    string t = sysProcEnvValue("TMPDIR");
    if (t.length() == 0) { t = "/tmp"; }
    return t;
    #off
    return "";
}

public string lang() {
    #on WINDOWS
    int langId = GetUserDefaultUILanguage();
    string result = "";
    result += char(((langId >> 8) & 0xFF));
    result += char((langId & 0xFF));
    result += "-";
    result += char(((langId >> 8) & 0xFF));
    result += char((langId & 0xFF));
    return result;
    #off
    #on LINUX
    return sysProcEnvValue("LANG");
    #off
    return "";
}

public string env(string name) {
    #on WINDOWS
    return env.get(name);
    #off
    #on LINUX
    return sysProcEnvValue(name);
    #off
    return "";
}

// -- LINUX-only private helpers (struct decodes + /proc readers) ----------

// One 65-byte NUL-terminated utsname field at byte offset off, decoded
// straight out of the int[] slots (no address arithmetic).
string utsField(int[] u, int off) {
    #on LINUX
    string r = "";
    for (int i = 0; i < 65; i++) {
        int b = (u[(off + i) / 8] >> (((off + i) % 8) * 8)) & 0xFF;
        if (b == 0) { break; }
        r += char(b);
    }
    return r;
    #off
    return "";
}

// Whole text file into a string, 4096 bytes per read. Text files carry no
// NUL bytes, so every byte rides the concat; the n-bound keeps the zeroed
// tail out.
string readProcFile(string path) {
    #on LINUX
    int fd = open(path, 0, 0);
    if (fd < 0) { return ""; }
    string out = "";
    while (true) {
        int[] chunk = new int[512];
        int n = read(fd, chunk, 4096);
        if (n <= 0) { break; }
        for (int i = 0; i < n; i++) {
            int b = (chunk[i / 8] >> ((i % 8) * 8)) & 0xFF;
            out += char(b);
        }
        if (n < 4096) { break; }
    }
    close(fd);
    return out;
    #off
    return "";
}

// Value of key parsed out of /proc/self/environ (mirrors env.sr's reader:
// entries never materialize NULs; "" when absent or unreadable).
string sysProcEnvValue(string key) {
    #on LINUX
    if (key.length == 0) { return ""; }
    string want = key + "=";
    int fd = open("/proc/self/environ", 0, 0);
    if (fd < 0) { return ""; }
    string entry = "";
    string value = "";
    int hit = 0;
    while (true) {
        int[] chunk = new int[512];
        int n = read(fd, chunk, 4096);
        if (n <= 0) { break; }
        for (int i = 0; i < n; i++) {
            int b = (chunk[i / 8] >> ((i % 8) * 8)) & 0xFF;
            if (b == 0) {
                if (entry.length() >= want.length() && entry.substr(0, want.length()) == want) {
                    value = entry.substr(want.length());
                    hit = 1;
                    break;
                }
                entry = "";
            } else {
                entry += char(b);
            }
        }
        if (hit != 0 || n < 4096) { break; }
    }
    close(fd);
    return value;
    #off
    return "";
}

// Number after "Key:" in /proc/meminfo (kilobytes), or 0 when absent.
int64 procMemValue(string key) {
    #on LINUX
    string mem = readProcFile("/proc/meminfo");
    string want = key + ":";
    int at = mem.indexOf(want);
    if (at < 0) { return 0; }
    int p = at + want.length();
    while (p < mem.length() && (mem[p] == ' ' || mem[p] == '\t')) { p++; }
    int64 v = 0;
    while (p < mem.length() && mem[p] >= '0' && mem[p] <= '9') {
        v = v * 10 + int(mem[p]) - 48;
        p++;
    }
    return v;
    #off
    return 0;
}

// "model name" value from /proc/cpuinfo, or "" when absent. NOTE: the
// two-argument indexOf(needle, start) ignores its start on silverc-rs
// (probed: returns the first match from 0), so the parse re-roots with
// substr() and searches the tail with the single-argument form.
string procCpuModel() {
    #on LINUX
    string cpu = readProcFile("/proc/cpuinfo");
    string want = "model name";
    int at = cpu.indexOf(want);
    if (at < 0) { return ""; }
    string tail = cpu.substr(at + want.length());
    int rel = tail.indexOf(":");
    if (rel < 0) { return ""; }
    int start = rel + 1;
    while (start < tail.length() && (tail[start] == ' ' || tail[start] == '\t')) { start++; }
    int end = start;
    while (end < tail.length() && tail[end] != '\n') { end++; }
    return tail.substr(start, end - start);
    #off
    return "";
}
