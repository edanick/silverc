import { GetStdHandle as consoleWinRawStdHandle, SetConsoleTextAttribute as consoleWinRawSetAttr } from win32.kernel32;

internal mod export console_win;

// DOCS -- INTERNAL Windows backend of the public `console` module
// (UNIFIED_CORE_LIBRARY.md Phase 2). Every kernel32 DLL call the console
// module needs lives here and nowhere else: the public wrapper (std/console.sr)
// contains zero win32 imports and reaches this code only behind the OS gate
// `if (osType() == OSTypes.WINDOWS)` (see std/os.sr for why the gate calls
// the plain-Silver osType() stand-in instead of the native os.type query).
//
// Everything in this file is project-internal: the `internal mod export`
// marker plus `internal` on every function keep the backend from leaking to
// user projects (enforced by compiler/visibility.sr on single-file compiles;
// .srp projects compile their whole source set as one project). A user file
// that tries `import * from console_win;` fails with the standard internal-
// visibility error.
//
// KERNEL32 IMPORT ALIASING: the DLL exports are bound through explicit
// `X as Y` import aliases rather than a full-table `import * from
// win32.kernel32;` grant, so only the two functions below are granted, the
// grants answer to the local consoleWin-prefixed names, and the PE import
// keeps the real export (mirrors std/env_win.sr and std/time_win.sr; see
// those files for why one flat compile namespace makes local-name keying the
// safe default). Both exports are present in every win32 grant table this
// repo ships: silverc-rs's src/win32.rs kernel32 list and the self-hosted
// compiler's parser.sr/mini_cg.sr kernel32 lists.
//
// BEHAVIOR NOTES (bodies below are moved verbatim from the pre-split
// console.sr implementations so behavior is unchanged): all three entries
// fetch the STD_OUTPUT_HANDLE pseudo-handle (GetStdHandle(-11), the exact
// constant the pre-split module used) and forward the masked color to
// kernel32!SetConsoleTextAttribute -- foreground masks the low nibble,
// background masks and shifts it into the high nibble, reset restores the
// default light-gray-on-black attribute 7. The handle lands in a local first
// because the flat compile namespace keys DLL grants by local name and nested
// grant calls as arguments are not a shape the backends rely on.

internal void consoleWinSetForeground(int color) {
    int h = consoleWinRawStdHandle(-11);
    consoleWinRawSetAttr(h, color & 0x0F);
}

internal void consoleWinSetBackground(int color) {
    int h = consoleWinRawStdHandle(-11);
    consoleWinRawSetAttr(h, (color & 0x0F) << 4);
}

internal void consoleWinReset() {
    int h = consoleWinRawStdHandle(-11);
    consoleWinRawSetAttr(h, 7);
}
