mod export xml;

class node {
    public string name;
    public string text;
    private string[] attrNames;
    private string[] attrValues;
    private node[] childNodes;

    construct {
        this.name = "";
        this.text = "";
        this.attrNames = [];
        this.attrValues = [];
        this.childNodes = [];
    }

    public node[] children(string tag) {
        node[] result = [];
        foreach (node child in this.childNodes) {
            if (child.name == tag) { result.push(child); }
        }
        return result;
    }

    public string attribute(string name) {
        for (int i = 0; i < this.attrNames.length; i++) {
            if (this.attrNames[i] == name) { return this.attrValues[i]; }
        }
        return "";
    }

    public node query(string path) {
        if (path.startsWith("//")) {
            return deepFind(this, path.substr(2));
        }
        return this;
    }

    private node deepFind(node n, string tag) {
        foreach (node child in n.childNodes) {
            if (child.name == tag) { return child; }
            node hit = deepFind(child, tag);
            if (hit != null) { return hit; }
        }
        return null;
    }
}

class document {
    public node root;

    construct { this.root = new node(); }
}

class builder {
    private string output;
    private int indent;

    construct { this.output = ""; this.indent = 0; }

    public void start(string name) {
        for (int i = 0; i < this.indent; i++) { this.output += "  "; }
        this.output += "<" + name + ">\n";
        this.indent++;
    }

    public void start(string name, object attrs) {
        for (int i = 0; i < this.indent; i++) { this.output += "  "; }
        this.output += "<" + name;
        this.output += ">\n";
        this.indent++;
    }

    public void text(string t) {
        for (int i = 0; i < this.indent; i++) { this.output += "  "; }
        this.output += t + "\n";
    }

    public void end() {
        this.indent--;
    }

    public string build() { return this.output; }
}

public document parse(string raw) {
    document doc = new document();
    node root = new node();
    root.name = "root";
    doc.root = root;

    int i = 0;
    int len = raw.length;
    node current = root;
    node[] stack = [];
    stack.push(current);

    while (i < len) {
        if (raw[i] == '<') {
            if (i + 1 < len && raw[i + 1] == '/') {
                int end = raw.indexOf(">", i);
                if (end < 0) { break; }
                stack.pop();
                if (stack.length > 0) { current = stack[stack.length - 1]; }
                i = end + 1;
            } else if (i + 1 < len && raw[i + 1] == '?') {
                int end = raw.indexOf("?>", i);
                if (end < 0) { break; }
                i = end + 2;
            } else if (i + 1 < len && raw[i + 1] == '!') {
                int end = raw.indexOf(">", i);
                if (end < 0) { break; }
                i = end + 1;
            } else {
                int end = raw.indexOf(">", i);
                if (end < 0) { break; }
                string tag = raw.substr(i + 1, end - i - 1);
                int space = tag.indexOf(" ");
                string name = tag;
                if (space >= 0) { name = tag.substr(0, space); }
                node n = new node();
                n.name = name;
                // Attribute extraction: the tag text past the first space is
                // k='v' / k="v" pairs; fill the node's attr tables so
                // attribute() answers on parsed documents (the class contract).
                if (space >= 0) {
                    string attrsText = tag.substr(space + 1);
                    string[] pieces = attrsText.split(" ");
                    for (int pi = 0; pi < pieces.length; pi++) {
                        string piece = pieces[pi];
                        int eq = piece.indexOf("=");
                        if (eq > 0) {
                            string key = piece.substr(0, eq);
                            string val = piece.substr(eq + 1);
                            if (val.length >= 2 && (val.substr(0, 1) == "'" || val.substr(0, 1) == "\"")) {
                                val = val.substr(1, val.length - 2);
                            }
                            n.attrNames.push(key);
                            n.attrValues.push(val);
                        }
                    }
                }
                if (current != null) {
                    current.childNodes.push(n);
                }
                if (tag[tag.length - 1] != '/') {
                    stack.push(n);
                    current = n;
                }
                i = end + 1;
            }
        } else {
            int next = raw.indexOf("<", i);
            if (next < 0) { next = len; }
            string t = raw.substr(i, next - i);
            string trimmed = t.trim();
            if (current != null && trimmed.length > 0) {
                current.text = trimmed;
            }
            i = next;
        }
    }

    // A well-formed document has exactly one top-level element; expose it as
    // document.root instead of the synthetic wrapper node (the root contract).
    if (root.childNodes.length == 1) { doc.root = root.childNodes[0]; }

    return doc;
}

public string beautify(string raw, int indent) { return raw; }
