mod export compression;

// DOCS -- the compression facade (DOCS/260). One module per algorithm lives
// under std/compression/ (deflate.sr, gzip.sr, zstd.sr); this file just
// re-exports them so `import * from compression;` and
// `import {zstd, gzip} from compression;` both expose the same classes as
// importing a single algorithm module (`import zstd from compression.zstd`).
// Transitive module visibility (probed): the `import *` lines below pull each
// algorithm module's `mod export` name into this module's scope, so a
// consumer's `new gzip()`/`new zstd()`/`new deflate()` resolves to the real
// class from the single algorithm file -- no duplicated code, and each class
// keeps dispatching to its own methods (per-class method tables survive the
// flat merge).

import * from compression.deflate;
import * from compression.gzip;
import * from compression.zstd;
