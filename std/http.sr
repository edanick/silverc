import * from os;
import * from http_win;

mod export http;

// DOCS -- public `http` module (UNIFIED_CORE_LIBRARY.md Phase 2). This is the
// unified, portable front of the HTTP client. It contains ZERO win32
// references: every winhttp.dll call moved into the internal Windows backend
// std/http_win.sr, and every entry below routes through the OS gate
// `if (osType() == OSTypes.WINDOWS)` before touching it. See http_win.sr for
// why the winhttp calls there are bound through `X as Y` import aliases and
// for the behavior notes carried over from the pre-split implementation.
//
// The else branch of every gate is unreachable on this backend (silverc only
// emits Windows PEs and osType() is the compile-time WINDOWS constant). For a
// future non-Windows backend the fallbacks follow the module's existing
// failure style: empty string.
//
// PUBLIC API (unchanged from the pre-split std/http.sr): get(url),
// post(url, body), delete(url). The extractHost/extractPort/extractPath
// helpers were private and moved into the backend under httpWin-prefixed
// names (see http_win.sr).

public string get(string url) {
    if (osType() == OSTypes.WINDOWS) {
        return httpWinGet(url);
    }
    return "";
}

public string post(string url, string body) {
    if (osType() == OSTypes.WINDOWS) {
        return httpWinPost(url, body);
    }
    return "";
}

public string delete(string url) {
    if (osType() == OSTypes.WINDOWS) {
        return httpWinDelete(url);
    }
    return "";
}
