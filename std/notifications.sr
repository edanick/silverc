// Windows toast / tray-balloon notifications.
mod export notifications;

public const int DEFAULT = 0;
public const int SHORT = 1;
public const int LONG = 2;
public const int SILENT = 1;

class Notification {
    string title;
    string body;
    string icon;
    int duration;
    int sound;
    bool silent;
    string group;
    string tag;
    string AppName;
}

class NotificationAction {
    string id;
    string title;
    string arguments;
}

public void show(Notification note) {
    // Canonical parity line printed by every backend (silverc-rs, silverc
    // self-hosted, silveri interpreter) so tests can match on it.
    // After printing, dispatch to the native Windows DLL bridge which lives
    // in silverc-rs and routes through ole32!CoInitializeEx, combase!RoInitialize,
    // combase!WindowsCreateString, combase!RoGetActivationFactory and direct
    // vtable calls into ToastNotificationManager.
    printline("NOTIFY: " + note.title + " | " + note.body);
    try {
        nativeToastShow(note.title, note.body, note.AppName);
    } catch (exception ex) { }
}
