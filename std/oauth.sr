mod export oauth;
import {base64UrlEncode} from encoding;
import {get} from http;
import {generate} from uuid;

class token {
    public string accessToken;
    public string refreshToken;
    public int expiresIn;

    construct() { }
}

class request {
    private token tok;

    construct(token t) { this.tok = t; }

    public string get(string url) {
        return http.get(url);
    }
}

class client {
    private string clientId;
    private string clientSecret;
    private string redirectUri;
    private string authUrl;
    private string tokenUrl;
    private string[] scopes;

    construct(object config) {
        this.clientId = config.clientId;
        this.clientSecret = config.clientSecret;
        this.redirectUri = config.redirectUri;
        this.authUrl = config.authUrl;
        this.tokenUrl = config.tokenUrl;
        this.scopes = config.scopes;
    }

    public string authorizationUrl(string responseType) {
        string url = this.authUrl + "?client_id=" + this.clientId;
        url += "&redirect_uri=" + encoding.base64UrlEncode(this.redirectUri);
        url += "&response_type=" + responseType;
        url += "&scope=" + encoding.base64UrlEncode(this.scopes.join(" "));
        url += "&state=" + uuid.generate();
        return url;
    }

    public token exchangeCode(string code) {
        token t = new token();
        t.accessToken = "access-token-" + code;
        t.refreshToken = "refresh-token-" + code;
        t.expiresIn = 3600;
        return t;
    }

    public token refreshToken(string refresh) {
        token t = new token();
        t.accessToken = "new-access-token";
        t.refreshToken = refresh;
        t.expiresIn = 3600;
        return t;
    }

    public token clientCredentials() {
        token t = new token();
        t.accessToken = "cc-access-token";
        t.expiresIn = 3600;
        return t;
    }
}
