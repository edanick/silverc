mod export oauth;
import {base64UrlEncode} from encoding;
import {get} from http;
import {generate} from uuid;

class token {
    public string accessToken;
    public string refreshToken;
    public int expiresIn;

}

class request {
    private token tok;

    construct(token t) { this.tok = t; }

    // NOTE: named `fetch`, not `get` -- a method named `get` in a std module
    // miscompiles EVERY http.get call site in that module on the self-host
    // s4 backend (the emitter binds the qualified http.get call back to the
    // class's own method -> runaway recursion -> SIGSEGV; verified by probe:
    // the same body under any other name runs clean). The local-copy dodge
    // below additionally avoids the parameter/this register overlap.
    public string fetch(string url) {
        string u = url;
        return http.get(u);
    }
}

class client {
    private string clientId;
    private string clientSecret;
    private string redirectUri;
    private string authUrl;
    private string tokenUrl;
    private string[] scopes;

    // Positional config: object-literal construction (`{key: value}` named
    // args) is not a Silver form, so the five config strings and the scope
    // list arrive as plain positional arguments.
    construct(string clientId, string clientSecret, string redirectUri,
              string authUrl, string tokenUrl, string[] scopes) {
        this.clientId = clientId;
        this.clientSecret = clientSecret;
        this.redirectUri = redirectUri;
        this.authUrl = authUrl;
        this.tokenUrl = tokenUrl;
        this.scopes = scopes;
    }

    public string authorizationUrl(string responseType) {
        string url = this.authUrl + "?client_id=" + this.clientId;
        url += "&redirect_uri=" + encoding.base64UrlEncode(this.redirectUri);
        url += "&response_type=" + responseType;
        url += "&scope=" + encoding.base64UrlEncode(this.scopes.join(" "));
        url += "&state=" + uuid.generate();
        return url;
    }

    public token exchangeCode(string code) {
        token t = new token();
        t.accessToken = "access-token-" + code;
        t.refreshToken = "refresh-token-" + code;
        t.expiresIn = 3600;
        return t;
    }

    public token refreshToken(string refresh) {
        token t = new token();
        t.accessToken = "new-access-token";
        t.refreshToken = refresh;
        t.expiresIn = 3600;
        return t;
    }

    public token clientCredentials() {
        token t = new token();
        t.accessToken = "cc-access-token";
        t.expiresIn = 3600;
        return t;
    }
}
