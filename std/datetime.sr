import * from win32.kernel32;

mod export datetime;

class duration {
    private int64 totalMs;

    construct() { this.totalMs = 0; }
    construct(int64 ms) { this.totalMs = ms; }

    public int64 days() { return this.totalMs / 86400000; }
    public int64 hours() { return this.totalMs / 3600000; }
    public int64 minutes() { return this.totalMs / 60000; }
    public int64 seconds() { return this.totalMs / 1000; }
    public int64 millis() { return this.totalMs; }
}

class now {
    public int year;
    public int month;
    public int day;
    public int hour;
    public int minute;
    public int second;
    public int millisecond;

    construct() {
        SYSTEMTIME st;
        GetLocalTime(&st);
        this.year = st.wYear;
        this.month = st.wMonth;
        this.day = st.wDay;
        this.hour = st.wHour;
        this.minute = st.wMinute;
        this.second = st.wSecond;
        this.millisecond = st.wMilliseconds;
    }

    construct(int y, int m, int d, int h, int mi, int s) {
        this.year = y; this.month = m; this.day = d;
        this.hour = h; this.minute = mi; this.second = s;
    }

    public string format(string fmt) {
        string result = "";
        for (int i = 0; i < fmt.length(); i++) {
            if (fmt[i] == '%' && i + 1 < fmt.length()) {
                char c = fmt[i + 1]; i++;
                if (c == 'Y') { result += this.year.toString(); }
                else if (c == 'm') { result += (this.month < 10 ? "0" : "") + this.month; }
                else if (c == 'd') { result += (this.day < 10 ? "0" : "") + this.day; }
                else if (c == 'H') { result += (this.hour < 10 ? "0" : "") + this.hour; }
                else if (c == 'M') { result += (this.minute < 10 ? "0" : "") + this.minute; }
                else if (c == 'S') { result += (this.second < 10 ? "0" : "") + this.second; }
                else { result += c; }
            } else {
                result += fmt[i];
            }
        }
        return result;
    }

    public int64 unix() {
        SYSTEMTIME st;
        GetSystemTime(&st);
        FILETIME ft;
        SystemTimeToFileTime(&st, &ft);
        int64 epochDiff = 116444736000000000;
        return (ft.dwHighDateTime << 32 | ft.dwLowDateTime - epochDiff) / 10000000;
    }

    public duration operator-(now other) {
        int64 diff = (this.unix() - other.unix()) * 1000;
        return new duration(diff);
    }
}

public now now() {
    return new now();
}

public now utcNow() {
    SYSTEMTIME st;
    GetSystemTime(&st);
    now n = new now();
    n.year = st.wYear; n.month = st.wMonth; n.day = st.wDay;
    n.hour = st.wHour; n.minute = st.wMinute; n.second = st.wSecond;
    return n;
}

public now parse(string s, string fmt) {
    now n = new now();
    return n;
}

public now fromUnix(int64 ts) {
    return new now();
}
