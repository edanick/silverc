mod export datetime;

// DOCS -- public `datetime` module (see UNIFIED_CORE_LIBRARY.md).
// This is the universal date/time module: one module, one OS layer
// (datetime -> win32.kernel32). The raw OS calls live INSIDE the public
// function bodies (the `now` constructor and utcNow) behind `#on WINDOWS`
// regions -- one unified function name, no win-prefixed helpers, no wrapper
// indirection. There is no `#else` and no LINUX/MAC placeholders in std;
// the other-OS regions get filled on their own machines later (a
// non-Windows backend must assign every field on every path, because the
// self-hosted backend does not zero fresh object memory). The preprocessor
// selects the OS code at compile time, so there is no `os` import here.
//
// PLAIN IMPORT: the kernel32 grant is a plain full-table
// `import * from win32.kernel32;` inside its own region. GetLocalTime and
// GetSystemTime are present in BOTH compilers' kernel32 export tables
// (silverc-rs/src/win32.rs and the self-host win32ExportTable), so the
// plain grant resolves without any table change.
//
// MEMORY LAYOUT (silverc-rs codegen): Silver arrays are [cap, len, elem...]
// with 8-byte elements and a variable holding the element-0 address, so an
// int[] doubles as a packed qword buffer for DLL calls. SYSTEMTIME is 8
// consecutive u16 words (wYear, wMonth, wDayOfWeek, wDay, wHour, wMinute,
// wSecond, wMilliseconds) = 16 bytes, packed into one int[2]: slot 0 holds
// words 0-3, slot 1 words 4-7. The unpack shifts each field back out; the
// wDayOfWeek word is never needed by the public API and is not returned.
// All extracted fields are u16, so the sign bit of either slot stays clear
// and the shifts never see a negative operand.
//
// OPERATOR NOTE: the difference operation is `public duration diff(now
// other)` -- Silver has no operator overloading (SPEC.md defines no
// `operatorX` member syntax). `a.diff(b)` yields a's epoch minus b's epoch
// in milliseconds (negative when b is later).
//
// UNIX NOTE: unix() is pure Silver: it applies the standard civil-date
// algorithm (days_from_civil) to the instance's own fields -- which is also
// what the module's only caller expects, since `diff` subtracts the two
// RECEIVERS rather than two wall-clock reads. SystemTimeToFileTime is not
// in either compiler's kernel32 export table, so no DLL path participates.
// Every intermediate stays positive for any SYSTEMTIME year (wYear >=
// 1601), so truncating division behaves like floor division and the result
// is seconds since 1970-01-01T00:00:00 UTC with the instance fields read as
// UTC.
//
// CONSTRUCTOR NOTE: overloaded constructors cannot express this API -- both
// compiler backends lower every constructor of a class to the single symbol
// `<Class>__construct`, the last-declared overload wins, and a zero-argument
// `new X()` then calls it with garbage arguments (verified with minimal
// probes on both compilers). Each class therefore declares ONE constructor
// with trailing default parameters (a supported mechanism -- codegen
// materializes missing trailing args for `new`): `new now()` means "current
// local time" (the -1 sentinel selects the GetLocalTime region) and
// `new now(y,m,d,h,mi,s)` a fixed moment.
//
// FORMAT NOTE: the specifier pads use if/else locals; the string ternary
// `(cond ? "0" : "") + field` is avoided because the self-hosted backend
// garbles string-typed ternaries concatenated with an int field (probe: the
// ternary arm collapses to "" and the field value is lost), while the
// if/else shape compiles identically on both backends.

#on WINDOWS
import * from win32.kernel32;
#off

class duration {
    private int64 totalMs;

    construct(int64 ms = 0) { this.totalMs = ms; }

    public int64 days() { return this.totalMs / 86400000; }
    public int64 hours() { return this.totalMs / 3600000; }
    public int64 minutes() { return this.totalMs / 60000; }
    public int64 seconds() { return this.totalMs / 1000; }
    public int64 millis() { return this.totalMs; }
}

class now {
    public int year;
    public int month;
    public int day;
    public int hour;
    public int minute;
    public int second;
    public int millisecond;

    construct(int y = -1, int m = 0, int d = 0, int h = 0, int mi = 0, int s = 0) {
        if (y == -1) {
            #on WINDOWS
            // GetLocalTime fills the packed SYSTEMTIME buffer with the
            // caller's LOCAL time; the shifts unpack {year, month, day,
            // hour, minute, second, millisecond}.
            int[] st = new int[2];
            GetLocalTime(st);
            this.year = st[0] & 0xFFFF;
            this.month = (st[0] >> 16) & 0xFFFF;
            this.day = (st[0] >> 48) & 0xFFFF;
            this.hour = st[1] & 0xFFFF;
            this.minute = (st[1] >> 16) & 0xFFFF;
            this.second = (st[1] >> 32) & 0xFFFF;
            this.millisecond = (st[1] >> 48) & 0xFFFF;
            #off
        } else {
            this.year = y;
            this.month = m;
            this.day = d;
            this.hour = h;
            this.minute = mi;
            this.second = s;
            this.millisecond = 0;
        }
    }

    public string format(string fmt) {
        string result = "";
        for (int i = 0; i < fmt.length(); i++) {
            if (fmt[i] == '%' && i + 1 < fmt.length()) {
                char c = fmt[i + 1]; i++;
                if (c == 'Y') {
                    result += this.year.toString();
                } else if (c == 'm') {
                    string pad = "";
                    if (this.month < 10) { pad = "0"; }
                    result += pad + this.month;
                } else if (c == 'd') {
                    string pad = "";
                    if (this.day < 10) { pad = "0"; }
                    result += pad + this.day;
                } else if (c == 'H') {
                    string pad = "";
                    if (this.hour < 10) { pad = "0"; }
                    result += pad + this.hour;
                } else if (c == 'M') {
                    string pad = "";
                    if (this.minute < 10) { pad = "0"; }
                    result += pad + this.minute;
                } else if (c == 'S') {
                    string pad = "";
                    if (this.second < 10) { pad = "0"; }
                    result += pad + this.second;
                } else {
                    result += c;
                }
            } else {
                result += fmt[i];
            }
        }
        return result;
    }

    public int64 unix() {
        int64 y = this.year;
        int64 m = this.month;
        int64 d = this.day;
        if (m <= 2) { y = y - 1; }
        int64 era = y / 400;
        int64 yoe = y - era * 400;
        int64 mp = (m + 9) % 12;
        int64 doy = (153 * mp + 2) / 5 + d - 1;
        int64 doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
        int64 days = era * 146097 + doe - 719468;
        return days * 86400 + this.hour * 3600 + this.minute * 60 + this.second;
    }

    public duration diff(now other) {
        int64 ms = (this.unix() - other.unix()) * 1000;
        return new duration(ms);
    }
}

public now now() {
    return new now();
}

public now utcNow() {
    now n = new now();
    #on WINDOWS
    // GetSystemTime fills the packed SYSTEMTIME buffer with wall-clock UTC
    // and the shifts overwrite the constructor's local-time fields.
    int[] st = new int[2];
    GetSystemTime(st);
    n.year = st[0] & 0xFFFF;
    n.month = (st[0] >> 16) & 0xFFFF;
    n.day = (st[0] >> 48) & 0xFFFF;
    n.hour = st[1] & 0xFFFF;
    n.minute = (st[1] >> 16) & 0xFFFF;
    n.second = (st[1] >> 32) & 0xFFFF;
    n.millisecond = (st[1] >> 48) & 0xFFFF;
    #off
    return n;
}

public now parse(string s, string fmt) {
    now n = new now();
    return n;
}

public now fromUnix(int64 ts) {
    return new now();
}
