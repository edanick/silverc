
mod export system_tray;

// DOCS -- System Tray Icon.
//
// The `TrayIcon` class wraps shell32!Shell_NotifyIconA (NIM_ADD / NIM_MODIFY /
// NIM_DELETE).  silverc-rs emits the real Win32 sequence for the
// trayAdd/traySetTooltip/trayDelete/trayRemove bridge functions; the
// self-hosted backend links them as no-ops so this class runs anywhere.
//
//     TrayIcon tray = new TrayIcon("silver-app", "assets/app.ico");
//     tray.setTooltip("Silver App");
//     tray.show();
//     ...
//     tray.dispose();
//
// `handle` is the opaque native HWND of the hidden helper window (0 once the
// icon has been disposed, or when the current backend is a no-op).
//
// This is the unified, portable front of the tray library. It contains ZERO
// win32 imports and ZERO DLL grants: every native touch below is a
// compiler-synthesized bare bridge (trayAdd/traySetTooltip/trayDelete/
// trayRemove/traySetMenu/trayRunLoop/trayPollMenu/trayPollClick), dispatched
// BY NAME from any module on both compilers, so there are no win32.*
// grants to isolate and no backend file to carry them. Every bridge call
// sits inside a `#on WINDOWS ... #off` preprocessor region (the preprocessor
// replaces the old osType() runtime gates -- see UNIFIED_CORE_LIBRARY.md);
// on Windows builds the calls are bit-identical to the old gated ones.
//
// DISPATCH (per compiler; THIS IS WHY THE
// BARE BRIDGE CALLS BELOW ARE SAFE -- preserve exactly):
//
// - silverc-rs: `system_tray` is NOT builtin-reserved (src/main.rs:81
//   builtin_modules_set lists fs/json/yaml/env/url/hash/path/bom/console/
//   math/http only), so this source is collected from disk whenever
//   resolution lands on it. The eight bare bridge names are intercepted in
//   src/codegen.rs (~lines 8304-8335) from ANY module -- there is no
//   module-scoped dispatch -- and lowered by src/stdlib/system_tray.rs into
//   the real Win32 sequence: shell32!Shell_NotifyIconA (NIM_ADD /
//   NIM_MODIFY / NIM_DELETE with a NOTIFYICONDATAA), a generated tray
//   WndProc (WM_DESTROY -> PostQuitMessage, WM_APP+1 left-click counting,
//   right-click popup menu), and the hidden "SilverTrayWindow" helper window.
//   The user32 menu/click imports
//   (CreatePopupMenu, AppendMenuA, TrackPopupMenu, DestroyMenu,
//   SetForegroundWindow, GetCursorPos, PostMessageA) are registered by the
//   compiler itself (stdlib/system_tray.rs emit_tray_imports, IAT indices
//   107..=113) alongside the notification imports -- no win32.*
//   Silver grant exists or is needed anywhere in this module.
//
// - self-hosted silverc: `system_tray` is NOT builtin-reserved either
//   (std/project.sr projectBuiltin and compiler/visibility.sr
//   visBuiltinModule do not list it) and NOT on compiler_driver.sr's
//   hand-prepend list (only llmai/exception/bom/process/notifications are),
//   so this source is collected as an ORDINARY source module from disk (the
//   findModulePath "std\" candidate; compiler/visibility.sr sees the same
//   path via visFindModulePath). compiler/parser.sr:748-751 whitelists the
//   eight bare names as callable native helpers and compiler/mini_cg.sr
//   :7049-7058 lowers them to no-ops returning 0, so the class links and
//   runs without a native tray shell.
//
// - silveri: whole-module
//   behavior is the interpreter's own concern; this file is not read there.
//
// REGIONS: every bridge call sits inside `#on WINDOWS ... #off` (the
// preprocessor replaces the old osType() runtime gates). The non-Windows
// side is unreachable today (silverc only emits Windows PEs); for a future
// non-Windows backend the class degrades to a headless state record: the
// constructor leaves `handle` 0, show/hide still maintain the `shown` flag,
// setTooltip/setMenu still record the requested strings, and every bridge
// call is skipped -- the same no-DLL-touch posture as std/gui.sr.
//
// LINUX POSTURE (Phase B, per LINUX.md §7): stock GNOME has no tray, so
// this module keeps the headless-record behavior there -- no `#on LINUX`
// regions are needed (every fallback above already yields it). Order of
// preference when a tray backend lands: (a) org.kde.StatusNotifierItem
// where an AppIndicator extension serves it; (b) a user-visible
// notification on tray-shaped events; (c) this documented no-op. The
// trayAdd/traySetTooltip/... bridges stay Windows-only by design (like
// win32.registry): user code needing a real tray is Windows-targeted
// code (`--os WINDOWS`). Headless/SSH degrades exactly like the Windows
// no-backend stubs (handle 0, pollClick 0, pollMenu "").
//
// MAC POSTURE (Phase B, code-only -- MAC.md section 7/10, DEGRADED until an
// Aqua backend lands and is probed on Mac hardware): every `#on MAC` branch
// below keeps the same headless-record behavior (handle 0, shown/tooltip/
// menu recorded, pollClick 0, pollMenu "") -- the same safe fallbacks as
// the Windows/Linux no-backend stubs, never a stub that claims success
// falsely. The Aqua route is NSStatusItem (the native menu-bar item;
// macOS HAS a tray equivalent, unlike stock GNOME) through the ONE shared
// ObjC bridge seam (mac.objc: objc_getClass / sel_registerName /
// objc_msgSend, granted in src/macos.rs); headless/SSH (no WindowServer)
// keeps this record posture permanently. The trayAdd/... bridges stay
// Windows-only by design like win32.registry; no mac.* import is granted
// here until the Aqua backend lands (nothing below calls it yet). Mirrors
// silverc-rs/std/system_tray.sr MAC bodies.
//
// COPY DIVERGENCE (documented; both sides intentional, neither broken):
// silverc-rs\std\system_tray.sr is a SEPARATE rs-side copy of this module
// for the sibling-checkout std/ resolution (rs exe-ancestor candidates land
// on silverc-rs\std\ first when the compiler runs rooted in that checkout).
// It opens with `import * from win32.user32;` (vestigial -- the bare bridges
// are name-intercepted before any win32 grant resolution, so the grant
// carries nothing the bridges need) and calls the same eight bare bridges
// ungated. Both copies expose the identical public API below and both
// compile under both compilers. This file is the copy the self-host collects
// (and the one rs collects when resolution lands on silverc\std, e.g.
// cwd = silverc\).
//
// API SURFACE (every public name, unchanged):
// class TrayMenuItem (title/id construct, getTitle, getId); class TrayIcon
// (name/icon construct, getName, getIcon, getTooltip, getHandle, isShown,
// setTooltip, show, hide, dispose, setMenu, getMenu, run, pollClick,
// pollMenu). The classes stay defined IN this wrapper because user code
// bare-news them here (cross-module instances are a probed rs landmine).
// No additions: the onClick/onMenu callback design lives only in the design
// doc and is not invented here (anon-fn closure capture is a
// documented compiler landmine).
//
// DEAD VS LIVE (per compiler):
// - silverc-rs: the whole class is LIVE -- the bridge performs a real
//   add + tooltip-modify + menu-register + hide/show + dispose cycle
//   (fire-and-forget, auto-cleaned via trayRemove; run() blocks on this
//   backend: a GetMessageA pump until WM_QUIT or a pending tray event).
// - self-hosted silverc: the bridges are NO-OPS by design
//   (mini_cg.sr:7049-7058) -- the class is a headless state record there:
//   handle stays 0, pollClick/pollMenu answer 0/"".
// - The pure getters and the TrayMenuItem class are field-only and behave
//   identically on both.

class TrayMenuItem {
    private string title;
    private string id;

    construct(string title, string id) {
        this.title = title;
        this.id = id;
    }

    public string getTitle() { return this.title; }
    public string getId() { return this.id; }
}

class TrayIcon {
    private string name;
    private string icon;
    private string tooltip;
    private int handle;
    private bool shown;
    private TrayMenuItem[] menu;

    construct(string name, string icon) {
        this.name = name;
        this.icon = icon;
        this.tooltip = name;
        this.handle = 0;
        this.shown = true;
        this.menu = [];
        #on WINDOWS
        this.handle = trayAdd(name, icon);
        #on MAC
        // headless record: handle stays 0 (NSStatusItem route is gated).
        #off
        // Non-Windows fallback: no tray backend yet, `handle` stays 0
        // ("no icon") and every method below guards on it.
    }

    public string getName() { return this.name; }
    public string getIcon() { return this.icon; }
    public string getTooltip() { return this.tooltip; }
    public int getHandle() { return this.handle; }
    public bool isShown() { return this.shown; }

    public void setTooltip(string t) {
        this.tooltip = t;
        #on WINDOWS
        if (this.shown && this.handle != 0) { traySetTooltip(this.handle, t); }
        #on MAC
        // headless record: the tooltip string above is the whole effect.
        #off
    }

    public void show() {
        if (!this.shown) {
            #on WINDOWS
            this.handle = trayAdd(this.tooltip, this.icon);
            #on MAC
            // headless record: `shown` below is the whole effect.
            #off
            this.shown = true;
        }
    }

    public void hide() {
        #on WINDOWS
        if (this.shown && this.handle != 0) { trayDelete(this.handle); }
        #on MAC
        // headless record: `shown` below is the whole effect.
        #off
        this.shown = false;
    }

    public void dispose() {
        #on WINDOWS
        if (this.handle != 0) { trayRemove(this.handle); }
        #on MAC
        // headless record: the resets below are the whole effect.
        #off
        this.handle = 0;
        this.shown = false;
    }

    // Register the context-menu items with the native tray window.  The
    // titles are joined with '\n' and stored in a native buffer; the tray
    // WndProc renders them as a popup menu on right-click.  (The self-host
    // bridge is a no-op, so the call is harmless there and the items are
    // retained for the getMenu/pollMenu API surface.)
    public void setMenu(TrayMenuItem[] items) {
        this.menu = items;
        string titles = "";
        for (int i = 0; i < items.length; i++) {
            if (i > 0) { titles += "\n"; }
            titles += items[i].getTitle();
        }
        #on WINDOWS
        if (this.handle != 0) { traySetMenu(this.handle, titles); }
        #on MAC
        // headless record: the retained menu above is the whole effect.
        #off
    }

    public TrayMenuItem[] getMenu() { return this.menu; }

    // Pump the message queue until a tray event or WM_QUIT.  BLOCKS on the
    // live silverc-rs backend (GetMessageA pump) -- callers re-enter to
    // poll; no-op on the self-host.
    public void run() {
        #on WINDOWS
        trayRunLoop();
        #on MAC
        // headless record: no message pump (NSStatusItem route is gated).
        #off
    }

    // Number of left-clicks since the last poll (resets the counter).
    public int pollClick() {
        #on WINDOWS
        return trayPollClick();
        #on MAC
        return 0;
        #off
        return 0;
    }

    // The `id` of the last selected menu item ("" when none / dismissed).
    public string pollMenu() {
        #on WINDOWS
        int cmd = trayPollMenu();
        if (cmd >= 1 && cmd <= this.menu.length) {
            TrayMenuItem item = this.menu[cmd - 1];
            return item.getId();
        }
        #on MAC
        return "";
        #off
        return "";
    }
}
