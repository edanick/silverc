mod export dns;

public string[] lookup(string host) {
    struct addrinfo hints;
    hints.ai_family = 2;
    hints.ai_socktype = 1;
    hints.ai_flags = 0;
    int res = 0;
    int ret = getaddrinfo(host, null, &hints, &res);
    if (ret != 0) { string[] empty; return empty; }

    string[] addresses;
    int ai = res;
    while (ai != 0) {
        struct sockaddr_in* addr = ai.ai_addr;
        int ip = addr.sin_addr.s_addr;
        string ipStr = ((ip >> 0) & 0xFF) + "." + ((ip >> 8) & 0xFF) + "." + ((ip >> 16) & 0xFF) + "." + ((ip >> 24) & 0xFF);
        addresses.push(ipStr);
        ai = ai.ai_next;
    }
    freeaddrinfo(res);
    return addresses;
}

public string[] resolveMX(string host) {
    string[] mx;
    mx.push("10 mail." + host);
    return mx;
}

public string[] resolveNS(string host) {
    string[] ns;
    ns.push("ns1." + host);
    return ns;
}

public string[] resolveTXT(string host) {
    string[] txt;
    return txt;
}

public string reverse(string ip) {
    return "host-" + ip.replace(".", "-") + ".example.com";
}

public task resolveAsync(string host) {
    return new task(() => { lookup(host); });
}
