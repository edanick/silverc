import * from net;

mod export dns;

// DOCS -- public `dns` module (UNIFIED_CORE_LIBRARY.md §4 rule 6, the
// CANONICAL FOLD SHAPE). This is a PROTOCOL module: it carries ZERO OS code
// and NO `#on` regions -- name resolution routes through the public
// `net.lookup(host, family)` primitive of the universal `net` socket core
// module (getaddrinfo is a ws2_32 call and lives in net.sr's regions; the
// old std/dns_win.sr backend is deleted). No win32 imports, no win-prefixed
// helpers, no osType() gates.
//
// DISPATCH (per compiler, probed): `dns` is builtin-reserved on NEITHER
// compiler -- silverc-rs's builtin_modules_set (src/main.rs:81 lists
// fs/json/yaml/env/url/hash/path/bom/console/math/http only) and the
// self-hosted compiler's visBuiltinModule (compiler/visibility.sr:605) plus
// its driver prepend list all exclude it. Both compilers resolve
// `import * from dns;` as an ORDINARY SOURCE module (std\dns.sr); no native
// dispatch exists to preserve.
//
// LOOKUP ROUTING (probed): cross-module call dispatch is by BARE NAME +
// arity -- module qualifiers are dropped and the LAST declaration accepting
// the argument count wins (silverc-rs codegen.rs resolve_overload_symbol;
// self-host mini_cg.sr selectOverloadIdx). dns's own public
// `lookup(string)` would therefore intercept a one-argument
// `net.lookup(host)` call and recurse forever, so net.lookup carries a
// trailing defaulted `family` parameter and THIS module calls the
// two-argument shape `net.lookup(host, 2)` that only net's declaration
// accepts (see net.sr's name-resolution section). net.lookup returns []
// on any failure -- dns.lookup keeps that shape verbatim.
//
// PRE-SPLIT STATE (carried from the fold record): the pre-split dns.sr
// NEVER compiled under either compiler, so no observable pre-fold behavior
// exists beyond names, arities, return types and intent. The
// empty-literal decl-init idiom (`string[] x = [];` before push) is kept
// everywhere: an uninitialized `string[] mx;` + push is a NULL-array
// access violation at runtime on silverc-rs (probed).
//
// RS-ONLY CALLER LANDMINE (probed, pre-existing silverc-rs codegen bug):
// a CROSS-MODULE string-returning call used directly inside an expression
// stringifies the raw return pointer, e.g.
// `print("ip: " + dns.reverse(ip))` prints a decimal address. Assign the
// result to a local first:
// `string r = dns.reverse(ip); print("ip: " + r);`
//
// API PRESERVATION (every public name/arity/return type, unchanged):
// - lookup: getaddrinfo-backed via net.lookup (AF_INET + SOCK_STREAM
//   hints, dotted-quad rendering verbatim from the pre-split expression,
//   [] on failure).
// - resolveMX/resolveNS/resolveTXT/reverse: pure-Silver pre-split stubs,
//   kept BYTE-IDENTICAL ("10 mail."+host / "ns1."+host / [] /
//   "host-"+ip.replace(".","-")+".example.com"). They touch no sockets.
// - resolveAsync + the local `task` class: the pre-split body
//   `return new task(() => { lookup(host); });` is doubly unexpressible --
//   `=>` lambdas are a parse error on both compilers, and the suite-proven
//   `(void () { ... })` spelling does NOT capture enclosing locals (probed:
//   "Undefined variable" on both compilers for a minimal capture fixture),
//   so a callback job could never read `host`. The pre-split file also
//   never imported the async module, so its `task` type was unresolved dead
//   text on both compilers; importing async is not an option (silverc-rs
//   lexes `async` as a keyword -- see std/async.sr's DISPATCH note -- so
//   `import * from async;` cannot compile there). The module therefore
//   defines a minimal local `task` class (the async.sr class shape: inert
//   until awaited) that STORES the host and performs the lookup at
//   awaitResult() time -- the closest expression of the pre-split intent
//   ("a task that looks up host"), probed end-to-end (resolveAsync then
//   awaitResult fires the lookup). The setHost method is ADDITIVE.
//   CLASS-SHADOW NOTE (same posture as ws.socket/net.socket above): a
//   program importing BOTH dns and async sees two `class task`
//   declarations; async's is registered first, dns's wins. No such
//   combination ever worked pre-fold -- neither module compiled -- and on
//   silverc-rs the async module cannot be imported at all. awaitResult()
//   returns "" (the async task.result was never assigned; async.sr
//   documents the same inert-shape posture).

public string[] lookup(string host) {
    return net.lookup(host, 2);
}

public string[] resolveMX(string host) {
    string[] mx = [];
    mx.push("10 mail." + host);
    return mx;
}

public string[] resolveNS(string host) {
    string[] ns = [];
    ns.push("ns1." + host);
    return ns;
}

public string[] resolveTXT(string host) {
    string[] txt = [];
    return txt;
}

public string reverse(string ip) {
    return "host-" + ip.replace(".", "-") + ".example.com";
}

class task {
    private string host;

    construct() { }

    public void setHost(string h) {
        this.host = h;
    }

    // Runs the lookup this task was created for (the pre-split job was
    // `lookup(host)`) and returns "" -- the async task result shape
    // (async.sr: task.result is never assigned).
    public string awaitResult() {
        net.lookup(this.host, 2);
        return "";
    }
}

public task resolveAsync(string host) {
    task t = new task();
    t.setHost(host);
    return t;
}
