import * from net;

mod export imap;

// DOCS -- public `imap` module (UNIFIED_CORE_LIBRARY.md §4). This is the
// portable front of the IMAP4rev1 library. It contains ZERO OS code: no
// win32 imports, no `#on` regions -- every byte on the wire is sent through
// the universal socket core std/net.sr
// (connectRaw/sendRawLen/recvRaw/closeRaw/setRecvTimeoutRaw), whose
// Windows regions hold the ws2_32 calls. This module is pure IMAP protocol
// logic and compiles unchanged on any backend that provides net.
//
// TRANSPORT: everything rides net. connectRaw dials, setRecvTimeoutRaw
// arms a 30 s receive timeout right after the connect -- login() arms it
// immediately after connectRaw (net.setRecvTimeoutRaw, 30000 ms) and
// select()/search()/fetch()/list()/logout() re-arm it on their first
// socket use, so every socket carries a 30 s receive timeout bound. The
// recv loop itself (recvResp) calls net.recvRaw(fd, 4096) and the sender
// (cmd) calls net.sendRawLen with exact byte counts. The receive path
// returns "" on both recv error and zero-length reads: recvRaw normalizes
// the DLL return first, then reports "" for `n <= 0`.
//
// DISPATCH: `imap` is builtin-reserved on NEITHER compiler --
// silverc-rs's builtin_modules_set (src/main.rs:81 lists
// fs/json/yaml/env/url/hash/path/bom/console/math/http only) and the
// self-hosted compiler's visBuiltinModule (compiler/visibility.sr:605
// lists fs/json/yaml/llmai/LLMAI/os/project/exception/bom/process/
// notifications/env/url/hash/path/console/math/http) plus its driver
// prepend list all exclude it. Both compilers resolve
// `import * from imap;` as an ORDINARY SOURCE module (std/imap.sr); there
// is no native dispatch for it. (imap.sr's entry in silverc.srp's exclude
// list only keeps it out of the compiler's own aggregate build -- the same
// posture as smtp.sr/pop.sr; it does not make `imap` a builtin.)
//
// WIRE BEHAVIOR:
// - The control channel: socket + connect over ws2_32 with WSAStartup
//   inside net.sr's Windows regions, the sockaddr_in image packed into an
//   int[2] qword buffer, and DLL returns normalized with the two-sided
//   `v < 0 || v > 2147483647` check (the self-host zero-extends
//   SOCKET_ERROR to 4294967295).
// - The tag discipline: IMAP is tag-based -- a command is `<tag> ARGS` and
//   its completion is the line starting with that tag (`<tag> OK|NO|BAD
//   ...`); untagged `* ...` lines interleave and must never be mistaken for
//   the completion. Tags are the decimal counter produced by the pure
//   nextTag() helper (probeable). readTagged() accumulates reads until the
//   CURRENT tag's line shows a status (replyStatus), the peer goes quiet,
//   or 16 x 4096 bytes (~64 KB) pass -- whichever comes first; a stale
//   reply cannot leak into the next command (each read overwrites
//   lastReply).
// - login(): reads and validates the greeting (`* OK` or `* PREAUTH` --
//   greetingOk()), sends LOGIN and requires the tagged OK, and records the
//   outcome in isLoggedIn()/getLastReply(). Plain-text LOGIN only: the
//   LOGIN command needs no base64, so the encoding.base64Encode runtime
//   crasher (phantom string.toBytes(), 0xC0000005 rs / 0xC0000409
//   self-host -- see std/smtp.sr's b64Encode note) is avoided entirely; no
//   b64 is carried and the encoding import does not exist here. Against a
//   non-IMAP listener the login fails gracefully: the peer's junk (or ""
//   after a silent disconnect) is surfaced through getLastReply() and the
//   process exits cleanly. No exceptions anywhere.
// - select(): waits for the tagged completion (untagged `* n EXISTS` etc.
//   interleave first) and leaves the reply in getLastReply(); a NO/BAD
//   keeps the session open (state unchanged).
// - search(): requires the tagged OK and parses the `* SEARCH` untagged
//   line with the pure searchIds() digit scan (probeable, substr-free); a
//   malformed or failed reply returns [] (ids never from a dead read).
// - fetch(): requires the tagged OK, keeps the whole response in raw, and
//   fills fromAddr/subject/body via the pure literalText()/
//   messageBody()/headerValue() helpers: IMAP delivers the message as an
//   RFC 3501 `{n}` literal (`* 1 FETCH (RFC822 {n}` + n raw bytes + `)`),
//   literalText() extracts those n bytes, headerValue() the From:/Subject:
//   headers, messageBody() the text after the header blank line.
// - logout(): sends LOGOUT, reads one bounded tagged reply for `* BYE` +
//   tagged OK, then closes. Every step is bounded, so a dead peer cannot
//   stall logout().
// - Bounded reads: every socket gets a 30 s SO_RCVTIMEO
//   (net.setRecvTimeoutRaw, armed at connect and re-armed on each command
//   entry). readGreeting() is bounded at 16 reads (until the first
//   complete CRLF line) and readTagged() at 16 x 4096 bytes (~64 KB per
//   command), so no path can spin forever.
//
// SCOPE: no AUTHENTICATE/STARTTLS/TLS (plain-text LOGIN only; AUTH PLAIN
// would need base64 -- the encoding crasher); no APPEND/STORE/EXPUNGE/
// COPY/STATUS/NOOP/CAPABILITY/SUBSCRIBE; no mailbox create/delete/rename
// (select() is the mailbox surface and list() is the LIST the task's
// IMAP4rev1 protocol set names, nothing beyond it); no EXAMINE; fetch()
// sends `FETCH n (RFC822)` text (RFC822 is the RFC 3501 legacy alias of
// BODY[]); message has exactly four fields -- no uid/flags/size/seqNum
// fields; search() takes a single `criteria` string (no seq-set builder,
// no charset argument).
//
// PUBLIC API: class message -- public fields fromAddr/subject/body/raw,
// construct(string raw); class client -- construct(string host, int port);
// login(string user, string pass); select(string mailbox);
// search(string criteria) -> int[]; fetch(int id) -> message; logout().
// The private cmd/recvResp helpers: cmd keeps the send-tag-increment-
// return-full-line shape; recvResp is the raw-bytes single bounded read;
// the accumulation lives in the private readGreeting/readTagged. Every
// public name (message, client, login, select, search, fetch, logout, and
// the message fields fromAddr/subject/body/raw) is keyword-free on both
// compilers -- checked against silverc-rs src/token.rs and self-host
// compiler/lexer.sr (`from`/`to`/`match` are keywords on both and appear
// nowhere here).
// getLastReply(): the raw text of the last server reply ("" before the
// first read -- the graceful-failure surface). isLoggedIn(): true only
// after an accepted greeting + tagged OK LOGIN. list(): issues
// `LIST "" "*"` and returns the raw untagged `* LIST ...` lines, whole
// lines as strings -- [] on any failure (the task's IMAP4rev1 protocol set
// names LIST). Free pure helpers -- nextTag(n) (the decimal tag string),
// greetingOk(resp) (true iff the first line is `* OK` or `* PREAUTH`),
// replyStatus(resp, tag) ("OK"/"NO"/"BAD" for the tagged reply line, ""
// when the tag's line is absent or its word is not a status), replyOk
// (resp, tag) (replyStatus is "OK" -- spelled as a char scan: the module
// contains NO string == comparisons, the self-host relies on strEq-style
// char scans), searchIds(resp) (the ids of the `* SEARCH` untagged line,
// digit-scanned), literalText(resp) (the bytes of the first `{n}`
// CRLF-bounded literal), messageBody(resp) (the text after the literal's
// first blank line) and headerValue(text, name) (RFC 822 header value, ""
// if absent -- pass "From:"/"Subject:" with the colon) are pure and
// probeable. Module-internal: the private lastReply/loggedIn fields, the
// private readGreeting/readTagged/fail plumbing, the private lineEndFrom/
// blankLineIndex/sliceRange scan helpers, and construct()'s full field
// initialization (sock to -1, strings to "", loggedIn to false), so
// logout() never touches an uninitialized handle.
//
// CALLER NOTES: instantiate the client with `var c = new client(...);` --
// a lowercase class arriving from a star-imported module cannot be spelled
// as a local's type on silverc-rs (per-file parsing: `client c` dies with
// "unknown keyword"; `new mod.client()` dies on BOTH compilers; `var`
// works on both; the same `var` pattern works in std/ftps.sr). fetch()
// returns a class instance across the module boundary: assign it to a
// `var` and read the fields from there (byte-identical on both compilers;
// the same pattern as the pop retrieve() caller). Strings returned across
// this module's boundary (getLastReply and the free helpers) should be
// assigned to a local before
// being concatenated into larger expressions (silverc-rs stringifies the
// return pointer in expression position; see std/dns.sr's RS-ONLY CALLER
// LANDMINE). The same applies to ELEMENTS of this module's cross-module
// string[] return, client.list(): `printline("x=" + arr[i])`
// prints raw heap pointers on silverc-rs while the self-host prints the
// text -- `string s = arr[i]; printline("x=" + s);` is byte-identical on
// both. search() returns [] and list() returns [] (never null) on
// failure; fetch() returns a message with raw "" on failure; login()/
// select()/logout() are silent. The module compares server text with
// char/int scans only -- no string == -- and callers wanting to test
// replies should reuse replyStatus/replyOk rather than spelling ==.

// Decimal tag string for the n-th command (`1`, `2`, ...). Tags are
// client-chosen atoms; decimal tags are valid and match nothing untagged.
public string nextTag(int n) {
    return n.toString();
}

// True when the first line of `resp` is an IMAP4rev1 greeting: `* OK ...`
// or `* PREAUTH ...` (BYE greetings are refused). Pure; probeable
// byte-identical on both compilers.
public bool greetingOk(string resp) {
    if (resp.length < 4) { return false; }
    if (resp[0] != 42 || resp[1] != 32) { return false; }
    int we = 2;
    while (we < resp.length && resp[we] != 32 && resp[we] != 13) { we++; }
    int wlen = we - 2;
    if (wlen == 2 && resp[2] == 79 && resp[3] == 75) { return true; }
    if (wlen == 7 && resp[2] == 80 && resp[3] == 82 && resp[4] == 69 && resp[5] == 65 && resp[6] == 85 && resp[7] == 84 && resp[8] == 72) { return true; }
    return false;
}

// Status word of `tag`'s tagged reply line inside `resp`: "OK", "NO" or
// "BAD" -- "" when no line starts with `tag` + space or its word is not a
// status (e.g. only untagged `* ...` lines arrived yet; readTagged keeps
// accumulating until this is non-empty). Pure; probeable.
public string replyStatus(string resp, string tag) {
    int tlen = tag.length;
    int pos = 0;
    while (pos < resp.length) {
        int eol = lineEndFrom(resp, pos);
        int lineEnd = resp.length;
        if (eol >= 0) { lineEnd = eol; }
        if (lineEnd - pos > tlen) {
            bool tagMatch = true;
            for (int k = 0; k < tlen; k++) {
                if (int(resp[pos + k]) != int(tag[k])) { tagMatch = false; }
            }
            if (tagMatch && resp[pos + tlen] == 32) {
                int ws = pos + tlen + 1;
                int we = ws;
                while (we < lineEnd && resp[we] != 32) { we++; }
                int wlen = we - ws;
                if (wlen == 2 && resp[ws] == 79 && resp[ws + 1] == 75) { return "OK"; }
                if (wlen == 2 && resp[ws] == 78 && resp[ws + 1] == 79) { return "NO"; }
                if (wlen == 3 && resp[ws] == 66 && resp[ws + 1] == 65 && resp[ws + 2] == 68) { return "BAD"; }
            }
        }
        if (eol < 0) { break; }
        pos = eol + 2;
    }
    return "";
}

// True when `tag`'s tagged reply says OK. Pure; probeable. Spelled as a
// char scan -- the module contains NO string == comparisons.
public bool replyOk(string resp, string tag) {
    string st = replyStatus(resp, tag);
    if (st.length != 2) { return false; }
    return st[0] == 79 && st[1] == 75;
}

// The ids of the `* SEARCH` untagged line in `resp` (digit-scanned, [] when
// the line is absent or carries no ids). Pure; probeable.
public int[] searchIds(string resp) {
    int[] ids = [];
    int pos = 0;
    while (pos < resp.length) {
        int eol = lineEndFrom(resp, pos);
        int lineEnd = resp.length;
        if (eol >= 0) { lineEnd = eol; }
        if (lineEnd - pos >= 8 && resp[pos] == 42 && resp[pos + 1] == 32
            && resp[pos + 2] == 83 && resp[pos + 3] == 69 && resp[pos + 4] == 65
            && resp[pos + 5] == 82 && resp[pos + 6] == 67 && resp[pos + 7] == 72) {
            int i = pos + 8;
            while (i < lineEnd) {
                while (i < lineEnd && resp[i] == 32) { i++; }
                int val = 0;
                bool any = false;
                while (i < lineEnd) {
                    int c = resp[i] & 0xFF;
                    if (c < 48 || c > 57) { break; }
                    val = val * 10 + (c - 48);
                    i++;
                    any = true;
                }
                if (any) { ids.push(val); }
                while (i < lineEnd && resp[i] != 32) { i++; }
            }
        }
        if (eol < 0) { break; }
        pos = eol + 2;
    }
    return ids;
}

// Bytes of the first RFC 3501 literal in `resp`: the `{n}\r\n` marker's n
// raw bytes ("" when no literal is present or the marker is malformed).
// The byte count is authoritative -- no terminator guessing. Pure;
// probeable.
public string literalText(string resp) {
    for (int i = 0; i < resp.length; i++) {
        if (resp[i] == 123) {
            int j = i + 1;
            int val = 0;
            bool any = false;
            while (j < resp.length) {
                int c = resp[j] & 0xFF;
                if (c < 48 || c > 57) { break; }
                val = val * 10 + (c - 48);
                j++;
                any = true;
            }
            if (any && j + 2 < resp.length && resp[j] == 125 && resp[j + 1] == 13 && resp[j + 2] == 10) {
                int start = j + 3;
                int end = start + val;
                if (end > resp.length) { end = resp.length; }
                if (end < start) { return ""; }
                return sliceRange(resp, start, end);
            }
        }
    }
    return "";
}

// Body text of a FETCH response's message: everything after the first blank
// line (the RFC 822 header/body separator) of the `{n}` literal ("" when
// either is missing). Pure; probeable.
public string messageBody(string fetchResp) {
    string lit = literalText(fetchResp);
    if (lit.length <= 0) { return ""; }
    int blank = blankLineIndex(lit);
    if (blank < 0) { return ""; }
    return sliceRange(lit, blank + 4, lit.length);
}

// Value of an RFC 822 header line inside a FETCH literal ("" when absent):
// scans line by line, matches `headerName` (pass it WITH the colon, e.g.
// "From:") at a line start, skips one space after the colon and returns the
// rest of that line. No folding support (continuation lines are not
// joined). Pure; probeable.
public string headerValue(string text, string headerName) {
    int nameLen = headerName.length;
    int pos = 0;
    while (pos < text.length) {
        int eol = lineEndFrom(text, pos);
        if (eol < 0) { break; }
        int lineLen = eol - pos;
        if (lineLen > nameLen) {
            bool headMatch = true;
            for (int k = 0; k < nameLen; k++) {
                if (int(text[pos + k]) != int(headerName[k])) { headMatch = false; }
            }
            if (headMatch) {
                int valStart = pos + nameLen;
                if (text[valStart] == 32) { valStart = valStart + 1; }
                return sliceRange(text, valStart, eol);
            }
        }
        pos = eol + 2;
    }
    return "";
}

class message {
    public string fromAddr;
    public string subject;
    public string body;
    public string raw;

    construct(string raw) { this.raw = raw; }
}

class client {
    private int sock;
    private string host;
    private int port;
    private int tag;
    private string lastReply;
    private bool loggedIn;

    construct(string host, int port) {
        this.host = host;
        this.port = port;
        this.tag = 1;
        this.sock = -1;
        this.lastReply = "";
        this.loggedIn = false;
    }

    // The raw text of the last server reply on the control channel (""
    // before the first read). This is the graceful-failure surface:
    // against a non-IMAP listener it holds the junk the peer sent, or ""
    // when the peer said nothing and closed.
    public string getLastReply() {
        return this.lastReply;
    }

    // True only after an accepted greeting (`* OK`/`* PREAUTH`) plus a
    // tagged-OK LOGIN.
    public bool isLoggedIn() {
        return this.loggedIn;
    }

    // Greeting + LOGIN flow, every step validated: `* OK`/`* PREAUTH`
    // greeting, then the tagged LOGIN reply must be OK. On any mismatch
    // fail() drops the connection and the peer's last words stay in
    // getLastReply(). Plain-text LOGIN only (no base64 -- see SCOPE).
    public void login(string user, string pass) {
        this.sock = net.connectRaw(this.host, this.port);
        if (this.sock < 0) {
            this.sock = -1;
            this.lastReply = "";
            return;
        }
        net.setRecvTimeoutRaw(this.sock, 30000);
        this.readGreeting();
        if (!greetingOk(this.lastReply)) {
            this.fail();
            return;
        }
        this.cmd("LOGIN " + user + " " + pass);
        this.readTagged();
        if (!replyOk(this.lastReply, nextTag(this.tag - 1))) {
            this.fail();
            return;
        }
        this.loggedIn = true;
    }

    // SELECT: waits for the tagged completion (untagged `* n EXISTS` etc.
    // interleave first) and leaves the reply in getLastReply(). Silent on
    // any failure; the session stays open on NO/BAD.
    public void select(string mailbox) {
        if (!this.loggedIn) { return; }
        net.setRecvTimeoutRaw(this.sock, 30000);
        this.cmd("SELECT " + mailbox);
        this.readTagged();
    }

    // SEARCH: requires the tagged OK, then the pure searchIds() scan of the
    // `* SEARCH` untagged line. Returns [] on any failure, malformed reply,
    // or an empty `* SEARCH` (the safe shape -- ids never come from a dead
    // read).
    public int[] search(string criteria) {
        int[] empty = [];
        if (!this.loggedIn) { return empty; }
        net.setRecvTimeoutRaw(this.sock, 30000);
        this.cmd("SEARCH " + criteria);
        this.readTagged();
        if (!replyOk(this.lastReply, nextTag(this.tag - 1))) { return empty; }
        return searchIds(this.lastReply);
    }

    // FETCH n (RFC822): requires the tagged OK, keeps the whole response
    // (status line, `{n}` literal and terminator included) in raw, and
    // fills fromAddr/subject/body via the pure helpers. On any failure the
    // message is returned empty (raw "").
    public message fetch(int id) {
        string raw = "";
        if (this.loggedIn && this.sock >= 0) {
            net.setRecvTimeoutRaw(this.sock, 30000);
            this.cmd("FETCH " + id.toString() + " (RFC822)");
            this.readTagged();
            if (replyOk(this.lastReply, nextTag(this.tag - 1))) { raw = this.lastReply; }
        }
        message m = new message(raw);
        string lit = literalText(raw);
        m.fromAddr = headerValue(lit, "From:");
        m.subject = headerValue(lit, "Subject:");
        m.body = messageBody(raw);
        return m;
    }

    // LIST "" "*": the raw untagged `* LIST ...` lines of the response
    // (mailboxes, one per string). Returns [] on any failure.
    public string[] list() {
        string[] empty = [];
        if (!this.loggedIn) { return empty; }
        char qc = char(34);
        string q = qc.toString();
        net.setRecvTimeoutRaw(this.sock, 30000);
        this.cmd("LIST " + q + q + " " + q + "*");
        this.readTagged();
        if (!replyOk(this.lastReply, nextTag(this.tag - 1))) { return empty; }
        return listLines(this.lastReply);
    }

    // LOGOUT: sends LOGOUT, reads the bounded tagged reply (`* BYE` then
    // tagged OK -- the status is not required) and closes. Every step is
    // bounded, so a dead peer cannot stall logout().
    public void logout() {
        if (this.sock >= 0) {
            net.setRecvTimeoutRaw(this.sock, 30000);
            this.cmd("LOGOUT");
            this.readTagged();
            net.closeRaw(this.sock);
        }
        this.sock = -1;
        this.loggedIn = false;
    }

    // Sends one tagged command line: `<tag> <c>\r\n`, tag incremented after
    // the send -- send, tag++, return the full line. No-op on a dead
    // channel -- every caller pairs it with a bounded read, so the failure
    // surfaces there instead.
    private string cmd(string c) {
        string full = nextTag(this.tag) + " " + c + "\r\n";
        if (this.sock >= 0) { net.sendRawLen(this.sock, full, full.length); }
        this.tag++;
        return full;
    }

    // One bounded read of the control channel (raw bytes as a string; ""
    // on disconnect/timeout).
    private string recvResp() {
        if (this.sock < 0) { return ""; }
        return net.recvRaw(this.sock, 4096);
    }

    // Accumulates control-channel reads into lastReply until the first
    // complete CRLF line (the greeting) is seen, the peer goes quiet, or 16
    // reads pass -- whichever comes first. Overwrites, never appends across
    // commands: a stale reply must not leak into the next check.
    private void readGreeting() {
        string acc = "";
        for (int guard = 0; guard < 16; guard++) {
            string chunk = this.recvResp();
            if (chunk.length <= 0) { break; }
            acc += chunk;
            if (lineEndFrom(acc, 0) >= 0) { break; }
        }
        this.lastReply = acc;
    }

    // Accumulates control-channel reads into lastReply until the CURRENT
    // command's tag (nextTag(this.tag - 1); cmd() already incremented) has
    // a tagged status line, the peer goes quiet, or 16 x 4096 bytes
    // (~64 KB) pass -- whichever comes first. Untagged `* ...` lines
    // interleaved before the tagged line are part of the same reply. Same
    // overwrite semantics as readGreeting().
    private void readTagged() {
        string want = nextTag(this.tag - 1);
        string acc = "";
        for (int guard = 0; guard < 16; guard++) {
            string chunk = this.recvResp();
            if (chunk.length <= 0) { break; }
            acc += chunk;
            string st = replyStatus(acc, want);
            if (st.length > 0) { break; }
        }
        this.lastReply = acc;
    }

    // Drops the connection and marks the client logged out; lastReply
    // keeps whatever the peer last said so the caller can surface it.
    private void fail() {
        this.loggedIn = false;
        if (this.sock >= 0) {
            net.closeRaw(this.sock);
        }
        this.sock = -1;
    }
}

// The raw untagged `* LIST ...` lines of a LIST response (one line per
// string, CRLF stripped). Pure; probeable; list()'s parser.
public string[] listLines(string resp) {
    string[] lines = [];
    int pos = 0;
    while (pos < resp.length) {
        int eol = lineEndFrom(resp, pos);
        int lineEnd = resp.length;
        if (eol >= 0) { lineEnd = eol; }
        if (lineEnd - pos >= 7 && resp[pos] == 42 && resp[pos + 1] == 32
            && resp[pos + 2] == 76 && resp[pos + 3] == 73 && resp[pos + 4] == 83
            && resp[pos + 5] == 84 && resp[pos + 6] == 32) {
            lines.push(sliceRange(resp, pos, lineEnd));
        }
        if (eol < 0) { break; }
        pos = eol + 2;
    }
    return lines;
}

// Index of the first "\r\n" at or after `startIdx` (the \r's index; -1 when
// absent). Private plumbing for the line-oriented scans. The parameter is
// spelled startIdx -- `from` is a lexer keyword on both compilers (the
// smtp/ftp RENAMED MEMBERS landmine; never a parameter name either).
private int lineEndFrom(string s, int startIdx) {
    for (int i = startIdx; i + 1 < s.length; i++) {
        if (s[i] == 13 && s[i + 1] == 10) { return i; }
    }
    return -1;
}

// Index of the first "\r\n\r\n" (the RFC 822 header/body separator; -1 when
// absent).
private int blankLineIndex(string s) {
    for (int i = 0; i + 3 < s.length; i++) {
        if (s[i] == 13 && s[i + 1] == 10 && s[i + 2] == 13 && s[i + 3] == 10) { return i; }
    }
    return -1;
}

// Copies s[start .. end) character by character. Deliberately NOT substr:
// rs's two-arg substr treats X as an END offset while the self-host treats
// it as a LENGTH -- identical only when start is 0 (see
// silverc-rs/src/string_ops.rs emit_string_substring) -- and every caller
// here slices from a nonzero offset.
private string sliceRange(string s, int start, int end) {
    string result = "";
    for (int i = start; i < end; i++) {
        result += s[i];
    }
    return result;
}
