import * from os;
import * from imap_win;

mod export imap;

// DOCS -- public `imap` module (UNIFIED_CORE_LIBRARY.md Phase 2). This is the
// unified, portable front of the IMAP4rev1 library. It contains ZERO win32
// imports: every ws2_32 call moved into the internal Windows backend
// std/imap_win.sr, and every entry that touches the network routes through
// the OS gate `if (osType() == OSTypes.WINDOWS)` before calling it
// (osType() is std/os.sr's plain-Silver stand-in -- see that file for why
// the gate does not use the native os.type query).
//
// The else side of every gate is unreachable on this backend (silverc only
// emits Windows PEs and osType() is the compile-time WINDOWS constant). For
// a future non-Windows backend the fallbacks follow the module's failure
// style: login/select/logout/list are silent no-ops, search() returns [],
// fetch() returns an empty message, isLoggedIn() stays false, getLastReply()
// stays "".
//
// DISPATCH (per compiler, probed): `imap` is builtin-reserved on NEITHER
// compiler -- silverc-rs's builtin_modules_set (src/main.rs:81 lists
// fs/json/yaml/env/url/hash/path/bom/console/math/http only) and the
// self-hosted compiler's visBuiltinModule (compiler/visibility.sr:605 lists
// fs/json/yaml/llmai/LLMAI/os/project/exception/bom/process/notifications/
// env/url/hash/path/console/math/http) plus its driver prepend list all
// exclude it. Both compilers resolve `import * from imap;` as an ORDINARY
// SOURCE module (std/imap.sr); no native dispatch exists to preserve.
// (imap.sr's entry in silverc.srp's exclude list only keeps it out of the
// compiler's own aggregate build -- the same posture as smtp.sr/pop.sr; it
// does not make `imap` a builtin. imap_win.sr is NOT excluded: its imapWin*
// names collide with nothing in the aggregate namespace, exactly like
// pop_win.sr/smtp_win.sr.)
//
// PRE-SPLIT STATE (probed 2026-08 against this file's git HEAD copy, fresh
// -o names on both compilers): the old std/imap.sr NEVER compiled under
// either compiler. silverc-rs died with "28:9: Expected expression",
// "unknown keyword sockaddr_in at line 28, column 16" and "unknown keyword
// addr at line 28, column 28" (the line-28 `struct sockaddr_in addr;`
// phantom), exit 1; the self-hosted compiler died with the same unknown
// keywords plus a "you forgot to put a semicolon" cascade, all line 28,
// exit 1. The parser never reached the later phantoms, but they were
// equally dead: `string full = this.tag + " " + c + "\r\n"` rides the
// string+int concat shape (no compiler source relies on it), `full.toBytes()`
// is the phantom string method (the encoding.base64Encode crasher class --
// see std/smtp.sr's b64Encode note), `new byte[4096]` is the byte[]
// declaration-initializer landmine, `int[] ids;` is declared WITHOUT an
// initializer and then pushed into (a NULL-array deref had it ever run),
// `int(p)` casts split substrings, `resp.substr(start)` rides the rs
// substr(start,X)=(start,END) vs self-host (start,LENGTH) disagreement, and
// recvResp()'s `char(buf[i])` scan over a recv buffer never executed.
// `AF_INET`/`SOCK_STREAM` resolve to nothing (neither name is in either
// compiler's ws2_32 export table) and winsock was never initialized. Every
// body was therefore dead text -- there was NO observable pre-split behavior
// to preserve beyond names, arities and intent.
//
// DEAD -> LIVE (what this split made actually work, mirroring the
// std/pop.sr / std/smtp.sr splits):
// - The control channel: socket + connect over ws2_32 with WSAStartup (the
//   pre-split file never initialized winsock), the sockaddr_in image packed
//   into an int[2] qword buffer, and DLL returns normalized with the
//   two-sided `v < 0 || v > 2147483647` check (the self-host zero-extends
//   SOCKET_ERROR to 4294967295; see std/imap_win.sr).
// - The tag discipline: IMAP is tag-based -- a command is `<tag> ARGS` and
//   its completion is the line starting with that tag (`<tag> OK|NO|BAD
//   ...`); untagged `* ...` lines interleave and must never be mistaken for
//   the completion. Tags are the decimal counter the pre-split body
//   intended (`this.tag + " "`), produced by the pure nextTag() helper
//   (probeable). readTagged() accumulates reads until the CURRENT tag's
//   line shows a status (replyStatus), the peer goes quiet, or 16 x 4096
//   bytes (~64 KB) pass -- whichever comes first; a stale reply cannot leak
//   into the next command (each read overwrites lastReply).
// - login(): pre-split it fired two unchecked send/recv pairs and stayed
//   silent about failure. It now reads and validates the greeting
//   (`* OK` or `* PREAUTH` -- greetingOk()), sends LOGIN and requires the
//   tagged OK, and records the outcome in isLoggedIn()/getLastReply()
//   (both ADDITIVE -- the pre-split surface had no way to report anything;
//   same additions as std/pop.sr/std/smtp.sr). Plain-text LOGIN only:
//   the LOGIN command needs no base64, so the encoding.base64Encode runtime
//   crasher (phantom string.toBytes(), 0xC0000005 rs / 0xC0000409 self-host
//   -- see std/smtp.sr's b64Encode note) is avoided entirely; no b64 was
//   carried and the encoding import never existed here. Against a
//   non-IMAP listener the login fails gracefully: the peer's junk (or ""
//   after a silent disconnect) is surfaced through getLastReply() and the
//   process exits cleanly. No exceptions anywhere.
// - select(): pre-split it sent SELECT and read one buffer blindly. It now
//   waits for the tagged completion (untagged `* n EXISTS` etc. interleave
//   first) and leaves the reply in getLastReply(); a NO/BAD keeps the
//   session open (state unchanged), mirroring the pre-split void shape.
// - search(): pre-split it parsed the reply with indexOf("SEARCH") +
//   substr + int() casts of split parts (the substr landmine). It now
//   requires the tagged OK and parses the `* SEARCH` untagged line with the
//   pure searchIds() digit scan (probeable, substr-free); a malformed or
//   failed reply returns [] (ids never from a dead read).
// - fetch(): pre-split it wrapped ONE reply buffer in a message and never
//   populated fromAddr/subject/body. It now requires the tagged OK, keeps
//   the whole response in raw, and fills fromAddr/subject/body via the pure
//   literalText()/messageBody()/headerValue() helpers: IMAP delivers the
//   message as an RFC 3501 `{n}` literal (`* 1 FETCH (RFC822 {n}` + n raw
//   bytes + `)`), literalText() extracts those n bytes, headerValue() the
//   From:/Subject: headers, messageBody() the text after the header blank
//   line (the pre-split fields existed but were never populated -- dead).
// - logout(): pre-split it sent LOGOUT, read once and closed. The shape is
//   preserved (send, one bounded tagged read for `* BYE` + tagged OK, then
//   close) but every step is bounded, so a dead peer cannot stall logout().
// - Bounded reads: every socket gets a 30 s SO_RCVTIMEO (std/imap_win.sr).
//   The pre-split file had no timeout and would have hung on a silent peer;
//   readGreeting() is bounded at 16 reads (until the first complete CRLF
//   line) and readTagged() at 16 x 4096 bytes (~64 KB per command), so no
//   path can spin forever.
//
// NOT INVENTED: no AUTHENTICATE/STARTTLS/TLS (the pre-split intent was
// plain-text LOGIN; AUTH PLAIN would need base64 -- the encoding crasher --
// so nothing was invented); no APPEND/STORE/EXPUNGE/COPY/STATUS/NOOP/
// CAPABILITY/SUBSCRIBE; no mailbox create/delete/rename (select() is the
// pre-split mailbox surface and list() -- see ADDITIVE -- is the LIST the
// task's IMAP4rev1 protocol set names, nothing beyond it); no EXAMINE;
// fetch() keeps the pre-split `FETCH n (RFC822)` text (RFC822 is the
// RFC 3501 legacy alias of BODY[], which is what the pre-split body named);
// message keeps exactly its pre-split four fields -- no uid/flags/size/
// seqNum fields were added; search() keeps its pre-split single `criteria`
// string (no seq-set builder, no charset argument).
//
// API PRESERVATION (every public name/arity of the pre-split file,
// unchanged): class message -- public fields fromAddr/subject/body/raw,
// construct(string raw); class client -- construct(string host, int port);
// login(string user, string pass); select(string mailbox);
// search(string criteria) -> int[]; fetch(int id) -> message; logout().
// The private cmd/recvResp helper names are preserved (cmd keeps its
// send-tag-increment-return-full-line shape; recvResp keeps its raw-bytes
// shape -- one bounded read; the accumulation lives in the new private
// readGreeting/readTagged, the std/pop.sr shape). NO RENAMES were needed
// (unlike smtp's from/to setters): every pre-split name (message, client,
// login, select, search, fetch, logout, cmd, recvResp, and the message
// fields fromAddr/subject/body/raw) is keyword-free on both compilers --
// checked against silverc-rs src/token.rs and self-host compiler/lexer.sr
// (`from`/`to`/`match` are keywords on both and appear nowhere here).
// ADDITIVE (the std/pop.sr/std/smtp.sr precedent, documented):
// client.getLastReply() returns the raw text of the last server reply (""
// before the first read -- the graceful-failure surface);
// client.isLoggedIn() is true only after an accepted greeting + tagged OK
// LOGIN; client.list() issues `LIST "" "*"` and returns the raw untagged
// `* LIST ...` lines split on nothing (whole lines as strings) -- [] on any
// failure (the task's IMAP4rev1 protocol set names LIST; the pre-split
// surface had no mailbox listing entry); free pure helpers -- nextTag(n)
// (the decimal tag string; tag generation made probeable), greetingOk(resp)
// (true iff the first line is `* OK` or `* PREAUTH`), replyStatus(resp,
// tag) ("OK"/"NO"/"BAD" for the tagged reply line, "" when the tag's line
// is absent or its word is not a status), replyOk(resp, tag) (replyStatus
// is "OK" -- spelled as a char scan: the module contains NO string ==
// comparisons, the self-host relies on strEq-style char scans), searchIds
// (resp) (the ids of the `* SEARCH` untagged line, digit-scanned),
// literalText(resp) (the bytes of the first `{n}` CRLF-bounded literal),
// messageBody(resp) (the text after the literal's first blank line) and
// headerValue(text, name) (RFC 822 header value, "" if absent -- pass
// "From:"/"Subject:" with the colon) are pure and probeable. Also additive
// and invisible: the private lastReply/loggedIn fields, the private
// readGreeting/readTagged/fail plumbing, the private lineEndFrom/
// blankLineIndex/sliceRange scan helpers, and construct() now initializes
// every field (sock to -1, strings to "", loggedIn to false) -- the
// pre-split construct set only host/port/tag, so logout()'s closesocket
// would have derefed an uninitialized handle had the file ever run.
//
// CALLER NOTES: instantiate the client with `var c = new client(...);` --
// a lowercase class arriving from a star-imported module cannot be spelled
// as a local's type on silverc-rs (per-file parsing: `client c` dies with
// "unknown keyword"; `new mod.client()` dies on BOTH compilers; `var`
// works on both, probed via std/ftps.sr). fetch() returns a class instance
// across the module boundary: assign it to a `var` and read the fields
// from there (probed byte-identical on both compilers via the pop
// retrieve() precedent). Strings returned across this module's boundary
// (getLastReply and the free helpers) should be assigned to a local before
// being concatenated into larger expressions (silverc-rs stringifies the
// return pointer in expression position; see std/dns.sr's RS-ONLY CALLER
// LANDMINE). The same applies to ELEMENTS of this module's cross-module
// string[] return, client.list(): probed 2026-08, `printline("x=" + arr[i])`
// printed raw heap pointers on silverc-rs while the self-host printed the
// text -- `string s = arr[i]; printline("x=" + s);` is byte-identical on
// both. search() returns [] and list() returns [] (never null) on
// failure; fetch() returns a message with raw "" on failure; login()/
// select()/logout() are silent. The module compares server text with
// char/int scans only -- no string == -- and callers wanting to test
// replies should reuse replyStatus/replyOk rather than spelling ==.

// Decimal tag string for the n-th command (`1`, `2`, ... -- the pre-split
// `this.tag + " "` intent, made pure and probeable). Tags are client-chosen
// atoms; decimal tags are valid and match nothing untagged.
public string nextTag(int n) {
    return n.toString();
}

// True when the first line of `resp` is an IMAP4rev1 greeting: `* OK ...`
// or `* PREAUTH ...` (BYE greetings are refused). Pure; probeable
// byte-identical on both compilers.
public bool greetingOk(string resp) {
    if (resp.length < 4) { return false; }
    if (resp[0] != 42 || resp[1] != 32) { return false; }
    int we = 2;
    while (we < resp.length && resp[we] != 32 && resp[we] != 13) { we++; }
    int wlen = we - 2;
    if (wlen == 2 && resp[2] == 79 && resp[3] == 75) { return true; }
    if (wlen == 7 && resp[2] == 80 && resp[3] == 82 && resp[4] == 69 && resp[5] == 65 && resp[6] == 85 && resp[7] == 84 && resp[8] == 72) { return true; }
    return false;
}

// Status word of `tag`'s tagged reply line inside `resp`: "OK", "NO" or
// "BAD" -- "" when no line starts with `tag` + space or its word is not a
// status (e.g. only untagged `* ...` lines arrived yet; readTagged keeps
// accumulating until this is non-empty). Pure; probeable.
public string replyStatus(string resp, string tag) {
    int tlen = tag.length;
    int pos = 0;
    while (pos < resp.length) {
        int eol = lineEndFrom(resp, pos);
        int lineEnd = resp.length;
        if (eol >= 0) { lineEnd = eol; }
        if (lineEnd - pos > tlen) {
            bool tagMatch = true;
            for (int k = 0; k < tlen; k++) {
                if (int(resp[pos + k]) != int(tag[k])) { tagMatch = false; }
            }
            if (tagMatch && resp[pos + tlen] == 32) {
                int ws = pos + tlen + 1;
                int we = ws;
                while (we < lineEnd && resp[we] != 32) { we++; }
                int wlen = we - ws;
                if (wlen == 2 && resp[ws] == 79 && resp[ws + 1] == 75) { return "OK"; }
                if (wlen == 2 && resp[ws] == 78 && resp[ws + 1] == 79) { return "NO"; }
                if (wlen == 3 && resp[ws] == 66 && resp[ws + 1] == 65 && resp[ws + 2] == 68) { return "BAD"; }
            }
        }
        if (eol < 0) { break; }
        pos = eol + 2;
    }
    return "";
}

// True when `tag`'s tagged reply says OK. Pure; probeable. Spelled as a
// char scan -- the module contains NO string == comparisons.
public bool replyOk(string resp, string tag) {
    string st = replyStatus(resp, tag);
    if (st.length != 2) { return false; }
    return st[0] == 79 && st[1] == 75;
}

// The ids of the `* SEARCH` untagged line in `resp` (digit-scanned, [] when
// the line is absent or carries no ids). Pure; probeable. Replaces the
// pre-split indexOf/substr/int()-cast parse (see DEAD -> LIVE).
public int[] searchIds(string resp) {
    int[] ids = [];
    int pos = 0;
    while (pos < resp.length) {
        int eol = lineEndFrom(resp, pos);
        int lineEnd = resp.length;
        if (eol >= 0) { lineEnd = eol; }
        if (lineEnd - pos >= 8 && resp[pos] == 42 && resp[pos + 1] == 32
            && resp[pos + 2] == 83 && resp[pos + 3] == 69 && resp[pos + 4] == 65
            && resp[pos + 5] == 82 && resp[pos + 6] == 67 && resp[pos + 7] == 72) {
            int i = pos + 8;
            while (i < lineEnd) {
                while (i < lineEnd && resp[i] == 32) { i++; }
                int val = 0;
                bool any = false;
                while (i < lineEnd) {
                    int c = resp[i] & 0xFF;
                    if (c < 48 || c > 57) { break; }
                    val = val * 10 + (c - 48);
                    i++;
                    any = true;
                }
                if (any) { ids.push(val); }
                while (i < lineEnd && resp[i] != 32) { i++; }
            }
        }
        if (eol < 0) { break; }
        pos = eol + 2;
    }
    return ids;
}

// Bytes of the first RFC 3501 literal in `resp`: the `{n}\r\n` marker's n
// raw bytes ("" when no literal is present or the marker is malformed).
// The byte count is authoritative -- no terminator guessing. Pure;
// probeable. ADDITIVE (the pre-split fetch never populated the message
// fields).
public string literalText(string resp) {
    for (int i = 0; i < resp.length; i++) {
        if (resp[i] == 123) {
            int j = i + 1;
            int val = 0;
            bool any = false;
            while (j < resp.length) {
                int c = resp[j] & 0xFF;
                if (c < 48 || c > 57) { break; }
                val = val * 10 + (c - 48);
                j++;
                any = true;
            }
            if (any && j + 2 < resp.length && resp[j] == 125 && resp[j + 1] == 13 && resp[j + 2] == 10) {
                int start = j + 3;
                int end = start + val;
                if (end > resp.length) { end = resp.length; }
                if (end < start) { return ""; }
                return sliceRange(resp, start, end);
            }
        }
    }
    return "";
}

// Body text of a FETCH response's message: everything after the first blank
// line (the RFC 822 header/body separator) of the `{n}` literal ("" when
// either is missing). Pure; probeable. ADDITIVE (the pre-split body field
// existed but was never populated).
public string messageBody(string fetchResp) {
    string lit = literalText(fetchResp);
    if (lit.length <= 0) { return ""; }
    int blank = blankLineIndex(lit);
    if (blank < 0) { return ""; }
    return sliceRange(lit, blank + 4, lit.length);
}

// Value of an RFC 822 header line inside a FETCH literal ("" when absent):
// scans line by line, matches `headerName` (pass it WITH the colon, e.g.
// "From:") at a line start, skips one space after the colon and returns the
// rest of that line. No folding support (continuation lines are not
// joined). Pure; probeable. ADDITIVE (the pre-split fromAddr/subject fields
// existed but were never populated).
public string headerValue(string text, string headerName) {
    int nameLen = headerName.length;
    int pos = 0;
    while (pos < text.length) {
        int eol = lineEndFrom(text, pos);
        if (eol < 0) { break; }
        int lineLen = eol - pos;
        if (lineLen > nameLen) {
            bool headMatch = true;
            for (int k = 0; k < nameLen; k++) {
                if (int(text[pos + k]) != int(headerName[k])) { headMatch = false; }
            }
            if (headMatch) {
                int valStart = pos + nameLen;
                if (text[valStart] == 32) { valStart = valStart + 1; }
                return sliceRange(text, valStart, eol);
            }
        }
        pos = eol + 2;
    }
    return "";
}

class message {
    public string fromAddr;
    public string subject;
    public string body;
    public string raw;

    construct(string raw) { this.raw = raw; }
}

class client {
    private int sock;
    private string host;
    private int port;
    private int tag;
    private string lastReply;
    private bool loggedIn;

    construct(string host, int port) {
        this.host = host;
        this.port = port;
        this.tag = 1;
        this.sock = -1;
        this.lastReply = "";
        this.loggedIn = false;
    }

    // ADDITIVE (the std/pop.sr/std/smtp.sr precedent): the raw text of the
    // last server reply on the control channel ("" before the first read).
    // This is the graceful-failure surface: against a non-IMAP listener it
    // holds the junk the peer sent, or "" when the peer said nothing and
    // closed.
    public string getLastReply() {
        return this.lastReply;
    }

    // ADDITIVE: true only after an accepted greeting (`* OK`/`* PREAUTH`)
    // plus a tagged-OK LOGIN.
    public bool isLoggedIn() {
        return this.loggedIn;
    }

    // Greeting + LOGIN flow, every step validated: `* OK`/`* PREAUTH`
    // greeting, then the tagged LOGIN reply must be OK. On any mismatch
    // fail() drops the connection and the peer's last words stay in
    // getLastReply(). Plain-text LOGIN only (no base64 -- see DEAD -> LIVE).
    public void login(string user, string pass) {
        if (osType() != OSTypes.WINDOWS) { return; }
        this.sock = imapWinConnect(this.host, this.port);
        if (this.sock < 0) {
            this.sock = -1;
            this.lastReply = "";
            return;
        }
        this.readGreeting();
        if (!greetingOk(this.lastReply)) {
            this.fail();
            return;
        }
        this.cmd("LOGIN " + user + " " + pass);
        this.readTagged();
        if (!replyOk(this.lastReply, nextTag(this.tag - 1))) {
            this.fail();
            return;
        }
        this.loggedIn = true;
    }

    // SELECT: waits for the tagged completion (untagged `* n EXISTS` etc.
    // interleave first) and leaves the reply in getLastReply(). Silent on
    // any failure (the pre-split void shape); the session stays open on
    // NO/BAD.
    public void select(string mailbox) {
        if (osType() != OSTypes.WINDOWS) { return; }
        if (!this.loggedIn) { return; }
        this.cmd("SELECT " + mailbox);
        this.readTagged();
    }

    // SEARCH: requires the tagged OK, then the pure searchIds() scan of the
    // `* SEARCH` untagged line. Returns [] on any failure, malformed reply,
    // or an empty `* SEARCH` (the safe shape -- ids never come from a dead
    // read).
    public int[] search(string criteria) {
        int[] empty = [];
        if (osType() != OSTypes.WINDOWS) { return empty; }
        if (!this.loggedIn) { return empty; }
        this.cmd("SEARCH " + criteria);
        this.readTagged();
        if (!replyOk(this.lastReply, nextTag(this.tag - 1))) { return empty; }
        return searchIds(this.lastReply);
    }

    // FETCH n (RFC822): requires the tagged OK, keeps the whole response
    // (status line, `{n}` literal and terminator included) in raw, and
    // fills fromAddr/subject/body via the pure helpers. On any failure the
    // message is returned empty (raw "" -- the pre-split shape on a dead
    // read, since its recvResp() returned "" which fed construct).
    public message fetch(int id) {
        string raw = "";
        if (osType() == OSTypes.WINDOWS && this.loggedIn) {
            this.cmd("FETCH " + id.toString() + " (RFC822)");
            this.readTagged();
            if (replyOk(this.lastReply, nextTag(this.tag - 1))) { raw = this.lastReply; }
        }
        message m = new message(raw);
        string lit = literalText(raw);
        m.fromAddr = headerValue(lit, "From:");
        m.subject = headerValue(lit, "Subject:");
        m.body = messageBody(raw);
        return m;
    }

    // LIST "" "*": the raw untagged `* LIST ...` lines of the response
    // (mailboxes, one per string). Returns [] on any failure. ADDITIVE (the
    // task's IMAP4rev1 protocol set names LIST; the std/pop.sr additive
    // list() precedent).
    public string[] list() {
        string[] empty = [];
        if (osType() != OSTypes.WINDOWS) { return empty; }
        if (!this.loggedIn) { return empty; }
        char qc = char(34);
        string q = qc.toString();
        this.cmd("LIST " + q + q + " " + q + "*");
        this.readTagged();
        if (!replyOk(this.lastReply, nextTag(this.tag - 1))) { return empty; }
        return listLines(this.lastReply);
    }

    // LOGOUT: sends LOGOUT, reads the bounded tagged reply (`* BYE` then
    // tagged OK -- the status is not required) and closes. Every step is
    // bounded, so a dead peer cannot stall logout() (the pre-split shape --
    // send, read, closesocket -- preserved; the pre-split read just never
    // ran, the file never compiled).
    public void logout() {
        if (this.sock >= 0 && osType() == OSTypes.WINDOWS) {
            this.cmd("LOGOUT");
            this.readTagged();
            imapWinClose(this.sock);
        }
        this.sock = -1;
        this.loggedIn = false;
    }

    // Sends one tagged command line: `<tag> <c>\r\n`, tag incremented after
    // the send (the pre-split cmd shape -- send, tag++, return the full
    // line). No-op on a dead channel -- every caller pairs it with a
    // bounded read, so the failure surfaces there instead.
    private string cmd(string c) {
        string full = nextTag(this.tag) + " " + c + "\r\n";
        if (this.sock >= 0) { imapWinSend(this.sock, full, full.length); }
        this.tag++;
        return full;
    }

    // One bounded read of the control channel (raw bytes as a string; ""
    // on disconnect/timeout -- pre-split recvResp shape).
    private string recvResp() {
        if (this.sock < 0) { return ""; }
        return imapWinReceive(this.sock, 4096);
    }

    // Accumulates control-channel reads into lastReply until the first
    // complete CRLF line (the greeting) is seen, the peer goes quiet, or 16
    // reads pass -- whichever comes first. Overwrites, never appends across
    // commands: a stale reply must not leak into the next check.
    private void readGreeting() {
        string acc = "";
        for (int guard = 0; guard < 16; guard++) {
            string chunk = this.recvResp();
            if (chunk.length <= 0) { break; }
            acc += chunk;
            if (lineEndFrom(acc, 0) >= 0) { break; }
        }
        this.lastReply = acc;
    }

    // Accumulates control-channel reads into lastReply until the CURRENT
    // command's tag (nextTag(this.tag - 1); cmd() already incremented) has
    // a tagged status line, the peer goes quiet, or 16 x 4096 bytes
    // (~64 KB) pass -- whichever comes first. Untagged `* ...` lines
    // interleaved before the tagged line are part of the same reply. Same
    // overwrite semantics as readGreeting().
    private void readTagged() {
        string want = nextTag(this.tag - 1);
        string acc = "";
        for (int guard = 0; guard < 16; guard++) {
            string chunk = this.recvResp();
            if (chunk.length <= 0) { break; }
            acc += chunk;
            string st = replyStatus(acc, want);
            if (st.length > 0) { break; }
        }
        this.lastReply = acc;
    }

    // Drops the connection and marks the client logged out; lastReply
    // keeps whatever the peer last said so the caller can surface it.
    private void fail() {
        this.loggedIn = false;
        if (this.sock >= 0) {
            imapWinClose(this.sock);
        }
        this.sock = -1;
    }
}

// The raw untagged `* LIST ...` lines of a LIST response (one line per
// string, CRLF stripped). Pure; probeable. ADDITIVE (list()'s parser --
// the pre-split surface had no mailbox listing).
public string[] listLines(string resp) {
    string[] lines = [];
    int pos = 0;
    while (pos < resp.length) {
        int eol = lineEndFrom(resp, pos);
        int lineEnd = resp.length;
        if (eol >= 0) { lineEnd = eol; }
        if (lineEnd - pos >= 7 && resp[pos] == 42 && resp[pos + 1] == 32
            && resp[pos + 2] == 76 && resp[pos + 3] == 73 && resp[pos + 4] == 83
            && resp[pos + 5] == 84 && resp[pos + 6] == 32) {
            lines.push(sliceRange(resp, pos, lineEnd));
        }
        if (eol < 0) { break; }
        pos = eol + 2;
    }
    return lines;
}

// Index of the first "\r\n" at or after `startIdx` (the \r's index; -1 when
// absent). Private plumbing for the line-oriented scans. The parameter is
// spelled startIdx -- `from` is a lexer keyword on both compilers (the
// smtp/ftp RENAMED MEMBERS landmine; never a parameter name either).
private int lineEndFrom(string s, int startIdx) {
    for (int i = startIdx; i + 1 < s.length; i++) {
        if (s[i] == 13 && s[i + 1] == 10) { return i; }
    }
    return -1;
}

// Index of the first "\r\n\r\n" (the RFC 822 header/body separator; -1 when
// absent).
private int blankLineIndex(string s) {
    for (int i = 0; i + 3 < s.length; i++) {
        if (s[i] == 13 && s[i + 1] == 10 && s[i + 2] == 13 && s[i + 3] == 10) { return i; }
    }
    return -1;
}

// Copies s[start .. end) character by character. Deliberately NOT substr:
// rs's two-arg substr treats X as an END offset while the self-host treats
// it as a LENGTH -- identical only when start is 0 (probed; see
// silverc-rs/src/string_ops.rs emit_string_substring) -- and every caller
// here slices from a nonzero offset.
private string sliceRange(string s, int start, int end) {
    string result = "";
    for (int i = start; i < end; i++) {
        result += s[i];
    }
    return result;
}
