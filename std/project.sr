mod export project;

// DOCS -- public `project` module.
//
// Pure Silver -- no OS code, no preprocessor regions. Probed facts:
//
// - The file imports only fs/string/progress/preprocess modules and never
//   calls a DLL export (the bodies use only the string module helpers
//   projectFind/projectSlice/projectTrim, fs builtins,
//   ProgressReporter, and the printline/exit builtins), so importing it
//   forces no DLL into a user PE's import table. In the self-hosted
//   aggregate the only CRT caller in the whole compile set is
//   compiler/resource.sr (memset), which carries its own
//   `import * from win32.msvcrt;` line.
// - Every operation the module performs is either pure string/array
//   computation (manifest parsing, path joining, .qs bundle decoding,
//   minification) or routed through the unified std/builtins:
//   file.readString/writeString/exists and folder.getFiles/getFolders (fs
//   builtins) plus ProgressReporter (compiler/progress.sr). There is no
//   direct DLL call, so no OS dispatch belongs in this module.
//
// DISPATCH (per compiler, probed): `project` is dispatch-symmetric but NOT
// an ordinary source module on the self-host side:
// - silverc-rs: builtin_modules_set (src/main.rs) lists fs/json/yaml/env/
//   url/hash/path/bom/console/math/http only -- `project` is NOT
//   builtin-reserved, so `import * from project;` resolves as an ORDINARY
//   SOURCE module from disk (cwd-sensitive std\ candidates, silverc.srp
//   `sources` walk).
// - self-hosted silverc: visibility.sr visBuiltinModule lists "project",
//   and the driver's findModulePath returns "" for it (baked into
//   silverc.exe itself; standalone .sr user imports do not re-resolve from
//   disk), while .srp builds go through projectBuildSource/projectSourcePath,
//   which resolves "project" from the manifest's sourceDirs (projectBuiltin
//   does not list it).
// - silveri has its own copy at silveri/src/project.sr.

import * from fs;
import * from string;
import * from progress;
import * from preprocess;

// DOCS/260 — filter one source file through the `#on`/`#else`/`#off`
// preprocessor. A region error prints to stderr and aborts with status 1
// (matching silverc-rs), so malformed regions can never reach the parser.
string preprocessOrProjectFail(string src) {
    string[] ppErrs = [];
    string target = ppTargetOs();
    string out = ppPreprocess(src, target, ppErrs);
    if (ppErrs.length > 0) {
        for (int peI = 0; peI < ppErrs.length; peI++) {
            eprintln(ppErrs[peI]);
        }
        exit(1);
    }
    return out;
}

bool projectHasSuffix(string path, string suffix) {
    if (path.length < suffix.length) { return false; }
    int start = path.length - suffix.length;
    for (int i = 0; i < suffix.length; i = i + 1) {
        int suffixIndex = start + i;
        if (path[suffixIndex] != suffix[i]) { return false; }
    }
    return true;
}

string projectManifestValue(string manifest, string key) {
    // Keep this helper to one projectFind call. The self-hosted stage-2
    // backend has a bad lowering edge case when the same string helper is
    // called repeatedly in one function; the remaining scan is local and
    // preserves the multiline .srp format used by the Rust loader.
    int keyPos = projectFind(manifest, key, 0);
    if (keyPos < 0) { return ""; }
    int colon = keyPos + key.length;
    while (colon < manifest.length && manifest[colon] != ':') {
        colon = colon + 1;
    }
    if (colon >= manifest.length) { return ""; }
    int quote = colon + 1;
    while (quote < manifest.length && manifest[quote] != '\"') {
        quote = quote + 1;
    }
    if (quote >= manifest.length) { return ""; }
    int end = quote + 1;
    while (end < manifest.length && manifest[end] != '\"') {
        end = end + 1;
    }
    string result = "";
    for (int i = quote + 1; i < end; i = i + 1) {
        result = result + manifest[i];
    }
    return result;
}

string projectDirname(string path) {
    int last = -1;
    for (int i = 0; i < path.length; i = i + 1) {
        if (path[i] == '/' || path[i] == '\\') { last = i; }
    }
    if (last < 0) { return "."; }
    return projectSlice(path, 0, last);
}

string projectJoin(string root, string path) {
    if (root == ".") { return path; }
    if (path.length > 0 && (path[0] == '/' || path[0] == '\\')) {
        return root + path;
    }
    #on LINUX
    return root + "/" + path;
    #on MAC
    return root + "/" + path;
    #off
    return root + "\\" + path;
}

string[] projectManifestSources(string manifest) {
    string[] result = [];
    int keyPos = projectFind(manifest, "sources", 0);
    if (keyPos < 0) { return result; }
    int cursor = keyPos;
    while (cursor < manifest.length && manifest[cursor] != '[') {
        cursor = cursor + 1;
    }
    if (cursor >= manifest.length) { return result; }
    cursor = cursor + 1;
    while (cursor < manifest.length && manifest[cursor] != ']') {
        while (cursor < manifest.length && manifest[cursor] != '"' && manifest[cursor] != ']') {
            cursor = cursor + 1;
        }
        if (cursor >= manifest.length || manifest[cursor] == ']') { break; }
        int start = cursor + 1;
        cursor = start;
        while (cursor < manifest.length && manifest[cursor] != '"') {
            cursor = cursor + 1;
        }
        if (cursor <= manifest.length) {
            result.add(projectSlice(manifest, start, cursor));
        }
        cursor = cursor + 1;
    }
    return result;
}

string[] projectManifestImports(string manifest) {
    // Mirrors projectManifestSources but reads the `imports` array (`.qs`
    // libraries made available to the project). One projectFind call keeps
    // the self-hosted stage-2 lowering well-behaved.
    string[] result = [];
    int keyPos = projectFind(manifest, "imports", 0);
    if (keyPos < 0) { return result; }
    int cursor = keyPos;
    while (cursor < manifest.length && manifest[cursor] != '[') {
        cursor = cursor + 1;
    }
    if (cursor >= manifest.length) { return result; }
    cursor = cursor + 1;
    while (cursor < manifest.length && manifest[cursor] != ']') {
        while (cursor < manifest.length && manifest[cursor] != '"' && manifest[cursor] != ']') {
            cursor = cursor + 1;
        }
        if (cursor >= manifest.length || manifest[cursor] == ']') { break; }
        int start = cursor + 1;
        cursor = start;
        while (cursor < manifest.length && manifest[cursor] != '"') {
            cursor = cursor + 1;
        }
        if (cursor <= manifest.length) {
            result.add(projectSlice(manifest, start, cursor));
        }
        cursor = cursor + 1;
    }
    return result;
}

string[] projectManifestExcludes(string manifest) {
    // Mirrors projectManifestSources but reads the `exclude` array. One
    // projectFind call keeps the self-hosted stage-2 lowering well-behaved.
    string[] result = [];
    int keyPos = projectFind(manifest, "exclude", 0);
    if (keyPos < 0) { return result; }
    int cursor = keyPos;
    while (cursor < manifest.length && manifest[cursor] != '[') {
        cursor = cursor + 1;
    }
    if (cursor >= manifest.length) { return result; }
    cursor = cursor + 1;
    while (cursor < manifest.length && manifest[cursor] != ']') {
        while (cursor < manifest.length && manifest[cursor] != '"' && manifest[cursor] != ']') {
            cursor = cursor + 1;
        }
        if (cursor >= manifest.length || manifest[cursor] == ']') { break; }
        int start = cursor + 1;
        cursor = start;
        while (cursor < manifest.length && manifest[cursor] != '"') {
            cursor = cursor + 1;
        }
        if (cursor <= manifest.length) {
            result.add(projectSlice(manifest, start, cursor));
        }
        cursor = cursor + 1;
    }
    return result;
}

bool projectIsExcluded(string rel, string[] excludes) {
    // A relative path is excluded when it equals a listed path, or when it
    // lives beneath a listed directory. Both separators are accepted so a
    // manifest may use forward slashes while the walk produces backslashes.
    for (int i = 0; i < excludes.length; i = i + 1) {
        string pat = excludes[i];
        if (rel.length < pat.length) { continue; }
        bool hit = true;
        for (int j = 0; j < pat.length; j = j + 1) {
            if (pat[j] != rel[j]) {
                if (pat[j] == '/') {
                    if (rel[j] != '\\') { hit = false; }
                } elif (pat[j] == '\\') {
                    if (rel[j] != '/') { hit = false; }
                } else {
                    hit = false;
                }
            }
        }
        if (hit) {
            if (rel.length == pat.length) { return true; }
            char sep = rel[pat.length];
            if (sep == '\\') { return true; }
            if (sep == '/') { return true; }
        }
    }
    return false;
}

// The self-hosted stage-2 backend has a code-generation edge case when the
// same mutable array is passed into helper functions and grown there: the
// caller's length slot is not refreshed, silently truncating growth at 8
// elements. These helpers therefore build and return fresh arrays (every
// `.add` call targets a local), and the caller dedups into its own locals.
string[] projectWalk(string root, string relDir, string[] excludes) {
    string[] result = [];
    string dir = root;
    if (relDir.length > 0) { dir = projectJoin(root, relDir); }
    string[] names = folder.getFiles(dir);
    for (int i = 0; i < names.length; i = i + 1) {
        string name = names[i];
        string rel = name;
        #on WINDOWS
        if (relDir.length > 0) { rel = relDir + "\\" + name; }
        #else
        if (relDir.length > 0) { rel = relDir + "/" + name; }
        #off
        if (!projectHasSuffix(rel, ".sr")) { continue; }
        if (projectIsExcluded(rel, excludes)) { continue; }
        result.add(projectJoin(root, rel));
    }
    string[] subdirs = folder.getFolders(dir);
    for (int k = 0; k < subdirs.length; k = k + 1) {
        string subname = subdirs[k];
        string subrel = subname;
        #on WINDOWS
        if (relDir.length > 0) { subrel = relDir + "\\" + subname; }
        #else
        if (relDir.length > 0) { subrel = relDir + "/" + subname; }
        #off
        if (projectIsExcluded(subrel, excludes)) { continue; }
        string[] sub = projectWalk(root, subrel, excludes);
        for (int m = 0; m < sub.length; m = m + 1) {
            result.add(sub[m]);
        }
    }
    return result;
}

string[] projectAddEntry(string root, string entry, string[] excludes) {
    string[] result = [];
    if (projectHasSuffix(entry, ".sr")) {
        if (projectIsExcluded(entry, excludes)) { return result; }
        result.add(projectJoin(root, entry));
        return result;
    }
    return projectWalk(root, entry, excludes);
}

// Nested module resolution (flat-first): mirrors silverc-rs
// push_module_candidates. `name` with dots maps to a nested path
// (`mini_cg.windows` -> `mini_cg/windows.sr`); `sep` is the target's
// separator ("/" on LINUX, "\\" on WINDOWS).
string projectDottedPath(string name, string sep) {
    string out = "";
    for (int i = 0; i < name.length; i++) {
        if (name[i] == '.') { out = out + sep; }
        else { out = out + name[i]; }
    }
    return out;
}

string projectSourcePath(string root, string[] sourceDirs, string moduleName) {
    for (int i = 0; i < sourceDirs.length; i = i + 1) {
        string sourceDir = sourceDirs[i];
        string candidate = "";
        if (projectHasSuffix(sourceDir, ".sr")) {
            if (sourceDir == moduleName + ".sr") {
                candidate = projectJoin(root, sourceDir);
            }
        } else {
            #on WINDOWS
            candidate = projectJoin(root, sourceDir + "\\" + moduleName + ".sr");
            #else
            candidate = projectJoin(root, sourceDir + "/" + moduleName + ".sr");
            #off
        }
        if (candidate != "" && file.exists(candidate)) {
            return candidate;
        }
        if (!projectHasSuffix(sourceDir, ".sr")) {
            // Dotted nested layout (`a.b` -> `a/b.sr`): probed only when
            // the flat `<module>.sr` above missed, so every existing import
            // resolves byte-identically.
            if (projectFind(moduleName, ".", 0) >= 0) {
                string dotted = "";
                #on WINDOWS
                dotted = projectJoin(root, sourceDir + "\\" + projectDottedPath(moduleName, "\\") + ".sr");
                #else
                dotted = projectJoin(root, sourceDir + "/" + projectDottedPath(moduleName, "/") + ".sr");
                #off
                if (dotted != "" && file.exists(dotted)) {
                    return dotted;
                }
            }
            // Package convention (`<name>` -> `<name>/<name>.sr`): last.
            string packaged = "";
            #on WINDOWS
            packaged = projectJoin(root, sourceDir + "\\" + moduleName + "\\" + moduleName + ".sr");
            #else
            packaged = projectJoin(root, sourceDir + "/" + moduleName + "/" + moduleName + ".sr");
            #off
            if (packaged != "" && file.exists(packaged)) {
                return packaged;
            }
        }
    }
    return "";
}

bool projectBuiltin(string name) {
    return name == "fs" || name == "json" || name == "yaml"
        || name == "llmai" || name == "LLMAI"
        || name == "os";
}

string projectImportModule(string statement) {
    int i = 0;
    while (i < statement.length && (statement[i] == ' ' || statement[i] == '\t' || statement[i] == '\r' || statement[i] == '\n')) {
        i = i + 1;
    }
    int fromPos = projectFind(statement, "from", i);
    if (i < statement.length && (statement[i] == '*' || statement[i] == '{')) {
        if (fromPos < 0) { return ""; }
        i = fromPos + 4;
    }
    while (i < statement.length && (statement[i] == ' ' || statement[i] == '\t' || statement[i] == '\r' || statement[i] == '\n')) {
        i = i + 1;
    }
    int start = i;
    while (i < statement.length && ((statement[i] >= 'a' && statement[i] <= 'z') || (statement[i] >= 'A' && statement[i] <= 'Z') || (statement[i] >= '0' && statement[i] <= '9') || statement[i] == '_' || statement[i] == '.')) {
        i = i + 1;
    }
    return projectSlice(statement, start, i);
}

bool projectVisited(string[] visited, string path) {
    for (int i = 0; i < visited.length; i = i + 1) {
        if (visited[i] == path) { return true; }
    }
    return false;
}

// ---------------------------------------------------------------------------
// Custom native modules (DOCS/261, `.srp` `nativeModules` array).
//
// A project declares its own native modules for OS libraries the compiler
// does not know about: `"nativeModules": [ { "module": "m",
// "windows": "a.dll", "linux": "liba.so.1" } ]` (+ optional shared
// `"exports": [...]` enabling `import *`, optional `"windowsExports"` /
// `"linuxExports"` per-target overrides; one-OS entries allowed; same file
// both sides allowed; several modules may share one file). Field names are
// case-insensitive, unknown keys ignored, absent key = no change.
//
// Pure Silver, no OS code, no preprocessor regions. Growth rides the
// ProjectVisited pattern (class property arrays mutated through methods),
// never bare `string[]` params grown inside helpers (stage-2 truncates those
// at 8 elements).
// ---------------------------------------------------------------------------

string nativeLower(string s) {
    string out = "";
    for (int i = 0; i < s.length; i++) {
        char c = s[i];
        if (c >= 'A' && c <= 'Z') { out = out + char(c + 32); }
        else { out = out + c; }
    }
    return out;
}

int nativeFindUnquoted(string text, char needle, int start) {
    int inQuote = 0;
    for (int i = start; i < text.length; i++) {
        char c = text[i];
        if (inQuote == 1) {
            if (c == '\\' && i + 1 < text.length) { i++; continue; }
            if (c == '"') { inQuote = 0; }
            continue;
        }
        if (inQuote == 2) {
            if (c == '\\' && i + 1 < text.length) { i++; continue; }
            if (c == '\'') { inQuote = 0; }
            continue;
        }
        if (c == '"') { inQuote = 1; continue; }
        if (c == '\'') { inQuote = 2; continue; }
        if (c == needle) { return i; }
    }
    return -1;
}

int nativeMatchBracket(string text, int openPos) {
    int depth = 0;
    int inQuote = 0;
    for (int i = openPos; i < text.length; i++) {
        char c = text[i];
        if (inQuote == 1) {
            if (c == '\\' && i + 1 < text.length) { i++; continue; }
            if (c == '"') { inQuote = 0; }
            continue;
        }
        if (inQuote == 2) {
            if (c == '\\' && i + 1 < text.length) { i++; continue; }
            if (c == '\'') { inQuote = 0; }
            continue;
        }
        if (c == '"') { inQuote = 1; continue; }
        if (c == '\'') { inQuote = 2; continue; }
        if (c == '[') { depth++; continue; }
        if (c == ']') {
            depth--;
            if (depth == 0) { return i; }
        }
    }
    return -1;
}

int nativeMatchBrace(string text, int openPos) {
    int depth = 0;
    int inQuote = 0;
    for (int i = openPos; i < text.length; i++) {
        char c = text[i];
        if (inQuote == 1) {
            if (c == '\\' && i + 1 < text.length) { i++; continue; }
            if (c == '"') { inQuote = 0; }
            continue;
        }
        if (inQuote == 2) {
            if (c == '\\' && i + 1 < text.length) { i++; continue; }
            if (c == '\'') { inQuote = 0; }
            continue;
        }
        if (c == '"') { inQuote = 1; continue; }
        if (c == '\'') { inQuote = 2; continue; }
        if (c == '{') { depth++; continue; }
        if (c == '}') {
            depth--;
            if (depth == 0) { return i; }
        }
    }
    return -1;
}

string nativeUnquoteTrim(string v) {
    string t = projectTrim(v);
    if (t.length >= 2) {
        char f = t[0];
        char l = t[t.length - 1];
        if ((f == '"' && l == '"') || (f == '\'' && l == '\'')) {
            string inner = projectSlice(t, 1, t.length - 1);
            string out = "";
            for (int i = 0; i < inner.length; i++) {
                char c = inner[i];
                if (c == '\\' && i + 1 < inner.length) {
                    out = out + inner[i + 1];
                    i++;
                    continue;
                }
                out = out + c;
            }
            return out;
        }
    }
    return t;
}

string[] nativeSplitExports(string inner) {
    string[] out = [];
    string cur = "";
    int inQuote = 0;
    char q = '"';
    for (int i = 0; i < inner.length; i++) {
        char c = inner[i];
        if (inQuote == 1) {
            if (c == '\\' && i + 1 < inner.length) {
                cur = cur + inner[i + 1];
                i++;
                continue;
            }
            if (c == q) { inQuote = 0; continue; }
            cur = cur + c;
            continue;
        }
        if (c == '"' || c == '\'') {
            inQuote = 1;
            q = c;
            continue;
        }
        if (c == ',') {
            string name = projectTrim(cur);
            if (name.length > 0) { out.add(name); }
            cur = "";
            continue;
        }
        cur = cur + c;
    }
    string last = projectTrim(cur);
    if (last.length > 0) { out.add(last); }
    return out;
}

string nativeJoinExports(string[] parts) {
    string out = "";
    for (int i = 0; i < parts.length; i++) {
        if (i > 0) { out = out + " "; }
        out = out + parts[i];
    }
    return out;
}

class NativeModules {
    public prop string[] names;
    public prop string[] winFiles;
    public prop string[] linFiles;
    public prop string[] exportsJoined;
    public prop string[] winExpJoined;
    public prop string[] linExpJoined;
    public prop bool[] hasWinExp;
    public prop bool[] hasLinExp;

    construct {
        this.names = [];
        this.winFiles = [];
        this.linFiles = [];
        this.exportsJoined = [];
        this.winExpJoined = [];
        this.linExpJoined = [];
        this.hasWinExp = [];
        this.hasLinExp = [];
    }

    public int find(string name) {
        for (int i = 0; i < this.names.length; i++) {
            if (this.names[i] == name) { return i; }
        }
        return -1;
    }

    public bool declared(string name) {
        int idx = this.find(name);
        if (idx < 0) { return false; }
        return this.winFiles[idx].length > 0 || this.linFiles[idx].length > 0;
    }

    public bool isEmpty() {
        for (int i = 0; i < this.names.length; i++) {
            if (this.winFiles[i].length > 0 || this.linFiles[i].length > 0) { return false; }
        }
        return true;
    }

    public void storeMerged(string name, string win, string lin, string exps, bool hasExps, string winExps, bool hasWin, string linExps, bool hasLin) {
        int idx = this.find(name);
        if (idx < 0) {
            this.names.add(name);
            this.winFiles.add(win);
            this.linFiles.add(lin);
            this.exportsJoined.add(exps);
            this.winExpJoined.add(winExps);
            this.linExpJoined.add(linExps);
            this.hasWinExp.add(hasWin);
            this.hasLinExp.add(hasLin);
            return;
        }
        if (win.length > 0) { this.winFiles[idx] = win; }
        if (lin.length > 0) { this.linFiles[idx] = lin; }
        if (hasExps) { this.exportsJoined[idx] = exps; }
        if (hasWin) {
            this.winExpJoined[idx] = winExps;
            this.hasWinExp[idx] = true;
        }
        if (hasLin) {
            this.linExpJoined[idx] = linExps;
            this.hasLinExp[idx] = true;
        }
    }

    public string winFile(string name) {
        int idx = this.find(name);
        if (idx < 0) { return ""; }
        return this.winFiles[idx];
    }

    public string linFile(string name) {
        int idx = this.find(name);
        if (idx < 0) { return ""; }
        return this.linFiles[idx];
    }

    public string fileFor(string name, string targetOs) {
        int idx = this.find(name);
        if (idx < 0) { return ""; }
        if (targetOs == "LINUX") { return this.linFiles[idx]; }
        return this.winFiles[idx];
    }

    public string exportsFor(string name, string targetOs) {
        int idx = this.find(name);
        if (idx < 0) { return ""; }
        if (targetOs == "LINUX") {
            if (this.hasLinExp[idx]) { return this.linExpJoined[idx]; }
        } else {
            if (this.hasWinExp[idx]) { return this.winExpJoined[idx]; }
        }
        return this.exportsJoined[idx];
    }

    public bool starAllowed(string name, string targetOs) {
        string exps = this.exportsFor(name, targetOs);
        for (int i = 0; i < exps.length; i++) {
            if (exps[i] != ' ' && exps[i] != '\t' && exps[i] != '\r' && exps[i] != '\n') { return true; }
        }
        return false;
    }
}

NativeModules projectParseNativeModules(string manifest) {
    NativeModules nm = new NativeModules();
    string low = nativeLower(manifest);
    int keyPos = projectFind(low, "nativemodules", 0);
    if (keyPos < 0) { return nm; }
    int open = nativeFindUnquoted(manifest, '[', keyPos);
    if (open < 0) { return nm; }
    int close = nativeMatchBracket(manifest, open);
    if (close < 0) { return nm; }
    string inner = projectSlice(manifest, open + 1, close);
    int pos = 0;
    while (true) {
        int objOpen = nativeFindUnquoted(inner, '{', pos);
        if (objOpen < 0) { break; }
        int objClose = nativeMatchBrace(inner, objOpen);
        if (objClose < 0) { break; }
        string body = projectSlice(inner, objOpen + 1, objClose);
        string modName = "";
        string winFile = "";
        string linFile = "";
        string expsJoined = "";
        string winExpsJoined = "";
        string linExpsJoined = "";
        bool hasExps = false;
        bool hasWin = false;
        bool hasLin = false;
        int p = 0;
        while (p < body.length) {
            while (p < body.length && (body[p] == ' ' || body[p] == '\t' || body[p] == '\r' || body[p] == '\n' || body[p] == ',' || body[p] == '{' || body[p] == '}')) { p++; }
            if (p >= body.length) { break; }
            string key = "";
            if (body[p] == '"' || body[p] == '\'') {
                char qc = body[p];
                p++;
                string kacc = "";
                while (p < body.length && body[p] != qc) {
                    if (body[p] == '\\' && p + 1 < body.length) {
                        kacc = kacc + body[p + 1];
                        p = p + 2;
                        continue;
                    }
                    kacc = kacc + body[p];
                    p++;
                }
                if (p < body.length) { p++; }
                key = kacc;
            } else {
                string kacc2 = "";
                while (p < body.length && body[p] != ':' && body[p] != ' ' && body[p] != '\t' && body[p] != '\r' && body[p] != '\n' && body[p] != '{' && body[p] != '}' && body[p] != ',') {
                    kacc2 = kacc2 + body[p];
                    p++;
                }
                key = kacc2;
            }
            while (p < body.length && body[p] != ':') {
                if (body[p] == ',' || body[p] == '}' || body[p] == '{') { break; }
                p++;
            }
            if (p >= body.length || body[p] != ':') { continue; }
            p++;
            while (p < body.length && (body[p] == ' ' || body[p] == '\t' || body[p] == '\r' || body[p] == '\n')) { p++; }
            if (p >= body.length) { break; }
            string val = "";
            bool isArr = false;
            string arrInner = "";
            if (body[p] == '[') {
                int aClose = nativeMatchBracket(body, p);
                if (aClose < 0) { p++; continue; }
                arrInner = projectSlice(body, p + 1, aClose);
                isArr = true;
                p = aClose + 1;
            } elif (body[p] == '"' || body[p] == '\'') {
                char vc = body[p];
                p++;
                string vacc = "";
                while (p < body.length && body[p] != vc) {
                    if (body[p] == '\\' && p + 1 < body.length) {
                        vacc = vacc + body[p + 1];
                        p = p + 2;
                        continue;
                    }
                    vacc = vacc + body[p];
                    p++;
                }
                if (p < body.length) { p++; }
                val = vacc;
            } else {
                string vacc2 = "";
                while (p < body.length && body[p] != ',' && body[p] != '}' && body[p] != '\n') {
                    vacc2 = vacc2 + body[p];
                    p++;
                }
                val = projectTrim(vacc2);
            }
            string lkey = nativeLower(key);
            if (lkey == "module") {
                if (!isArr) {
                    string m = projectTrim(val);
                    if (m.length > 0) { modName = m; }
                }
            } elif (lkey == "windows") {
                if (!isArr && val.length > 0) { winFile = val; }
            } elif (lkey == "linux") {
                if (!isArr && val.length > 0) { linFile = val; }
            } elif (lkey == "exports") {
                hasExps = true;
                if (isArr) {
                    string[] lst = nativeSplitExports(arrInner);
                    expsJoined = nativeJoinExports(lst);
                } else {
                    expsJoined = projectTrim(val);
                }
            } elif (lkey == "windowsexports") {
                hasWin = true;
                if (isArr) {
                    string[] lst2 = nativeSplitExports(arrInner);
                    winExpsJoined = nativeJoinExports(lst2);
                } else {
                    winExpsJoined = projectTrim(val);
                }
            } elif (lkey == "linuxexports") {
                hasLin = true;
                if (isArr) {
                    string[] lst3 = nativeSplitExports(arrInner);
                    linExpsJoined = nativeJoinExports(lst3);
                } else {
                    linExpsJoined = projectTrim(val);
                }
            } else {
                // unknown keys ignored
            }
        }
        if (modName.length > 0) {
            nm.storeMerged(modName, winFile, linFile, expsJoined, hasExps, winExpsJoined, hasWin, linExpsJoined, hasLin);
        }
        pos = objClose + 1;
    }
    return nm;
}

string nativeUndeclaredMsg(string source) {
    string short = source;
    int dot = -1;
    for (int i = 0; i < source.length; i++) {
        if (source[i] == '.') { dot = i; }
    }
    if (dot >= 0 && dot + 1 < source.length) { short = projectSlice(source, dot + 1, source.length); }
    return "unknown native module \"" + source + "\"; declare it in your .srp with \"nativeModules\": [ { \"module\": \"" + short + "\", \"windows\": \"<dll>\", \"linux\": \"<lib>\" } ]";
}

string nativeStarMsg(string source) {
    return "whole-module import of custom native module \"" + source + "\" is not supported; use single-export grants: import { FuncName } from \"" + source + "\";";
}

string nativeSideError(NativeModules nm, string module, string targetOs) {
    if (targetOs == "LINUX") {
        string have = nm.winFile(module);
        string extra = "";
        if (have.length > 0) { extra = " (entry declares \"windows\": \"" + have + "\" only)"; }
        return "custom native module \"" + module + "\" has no library for LINUX targets" + extra + "; add \"linux\": \"<lib>\" to its \"nativeModules\" entry";
    }
    string side = "WINDOWS";
    if (targetOs == "MAC") { side = "MAC (which use the \"windows\" file)"; }
    string have2 = nm.linFile(module);
    string extra2 = "";
    if (have2.length > 0) { extra2 = " (entry declares \"linux\": \"" + have2 + "\" only)"; }
    return "custom native module \"" + module + "\" has no library for " + side + " targets" + extra2 + "; add \"windows\": \"<dll>\" to its \"nativeModules\" entry";
}

bool projectIsStdModule(string name) {
    if (name == "math") { return true; }
    if (name == "fs") { return true; }
    if (name == "file") { return true; }
    if (name == "folder") { return true; }
    if (name == "json") { return true; }
    if (name == "http") { return true; }
    if (name == "llmai") { return true; }
    if (name == "LLMAI") { return true; }
    if (name == "env") { return true; }
    if (name == "url") { return true; }
    if (name == "hash") { return true; }
    if (name == "path") { return true; }
    if (name == "keyboard") { return true; }
    if (name == "mouse") { return true; }
    if (name == "bom") { return true; }
    if (name == "binary_metadata") { return true; }
    if (name == "process") { return true; }
    if (name == "console") { return true; }
    if (name == "gui") { return true; }
    if (name == "registry") { return true; }
    if (name == "os") { return true; }
    return false;
}

string[] projectQsStems(string content) {
    string[] out = [];
    if (!projectQsBundle(content)) { return out; }
    int pos = 6;
    pos = pos + 4;
    int metaLen = projectQsU32(content, pos);
    pos = pos + 4 + metaLen;
    int count = projectQsU32(content, pos);
    pos = pos + 4;
    for (int i = 0; i < count; i++) {
        int nameLen = projectQsU32(content, pos);
        pos = pos + 4;
        string filename = projectSlice(content, pos, pos + nameLen);
        pos = pos + nameLen;
        int srcLen = projectQsU32(content, pos);
        pos = pos + 4 + srcLen;
        int last = -1;
        for (int k = 0; k < filename.length; k++) {
            if (filename[k] == '/' || filename[k] == '\\') { last = k; }
        }
        string base = filename;
        if (last >= 0) { base = projectSlice(filename, last + 1, filename.length); }
        int dot = -1;
        for (int j = base.length - 1; j >= 0; j--) {
            if (base[j] == '.') { dot = j; break; }
        }
        string stem = base;
        if (dot > 0) { stem = projectSlice(base, 0, dot); }
        if (stem.length > 0) { out.add(stem); }
    }
    return out;
}

// ---------------------------------------------------------------------------
// QuickSilver (.qs) library bundles (DOCS/226). A `.qs` file is a binary
// container: magic "QSLIB2", then fixed 4-byte base-255 big-endian u32
// lengths (each byte holds a digit in 1..=255, digit = byte - 1), then
// payloads. Because every digit byte is >= 1 the file is NUL-free, which is
// required for the strlen-based string primitives of the compiled runtime.
// Layout: magic | flags | meta_len | metadata (5 '\n'-joined lines: version,
// description, author, Silver version, copyright) | module_count | then per
// module: name_len, filename, src_len, minified source.
// ---------------------------------------------------------------------------

bool projectQsBundle(string content) {
    if (content.length < 6) { return false; }
    return content[0] == 'Q' && content[1] == 'S' && content[2] == 'L'
        && content[3] == 'I' && content[4] == 'B' && content[5] == '2';
}

// Read a fixed 4-byte base-255 big-endian u32 at pos (digit = byte - 1).
int projectQsU32(string content, int pos) {
    int v = 0;
    for (int i = 0; i < 4; i = i + 1) {
        v = v * 255 + (content[pos + i] - 1);
    }
    return v;
}

// The bundle writer emits every byte as an int in 1..=255 (base-255 digits,
// so the file is NUL-free). The compiler writes it with file.writeBytes,
// which masks each element to its low byte, so byte values are exact.
// Helpers that append to a caller array are deliberately avoided: the
// stage-2 backend truncates caller arrays grown inside helpers at 8
// elements, so all growth happens inline in the caller below.

// Extract the minified module sources of a `.qs` bundle, in order. Returns an
// empty array when the content is not a bundle.
string[] projectQsSources(string content) {
    string[] result = [];
    if (!projectQsBundle(content)) { return result; }
    int pos = 6;
    pos = pos + 4;              // flags (reserved)
    int metaLen = projectQsU32(content, pos);
    pos = pos + 4 + metaLen;    // metadata payload
    int count = projectQsU32(content, pos);
    pos = pos + 4;
    for (int i = 0; i < count; i = i + 1) {
        int nameLen = projectQsU32(content, pos);
        pos = pos + 4 + nameLen;
        int srcLen = projectQsU32(content, pos);
        pos = pos + 4;
        result.add(projectSlice(content, pos, pos + srcLen));
        pos = pos + srcLen;
    }
    return result;
}

bool projectQsWord(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

// Strip whitespace and comments from Silver source, keeping it lexable:
// whitespace runs become a single space and a space is kept only where two
// word tokens would merge. String, interpolation-string and char literals are
// preserved verbatim.
string projectMinify(string source) {
    string out = "";
    bool pendingSpace = false;
    int i = 0;
    while (i < source.length) {
        char c = source[i];
        if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
            pendingSpace = true;
            i = i + 1;
            continue;
        }
        if (c == '/' && i + 1 < source.length && source[i + 1] == '/') {
            pendingSpace = true;
            i = i + 2;
            while (i < source.length && source[i] != '\n') { i = i + 1; }
            continue;
        }
        if (c == '/' && i + 1 < source.length && source[i + 1] == '*') {
            pendingSpace = true;
            i = i + 2;
            int depth = 1;
            while (i < source.length && depth > 0) {
                if (i + 1 < source.length && source[i] == '/' && source[i + 1] == '*') {
                    depth = depth + 1;
                    i = i + 2;
                } elif (i + 1 < source.length && source[i] == '*' && source[i + 1] == '/') {
                    depth = depth - 1;
                    i = i + 2;
                } else {
                    i = i + 1;
                }
            }
            continue;
        }
        if (c == '$' && i + 1 < source.length && source[i + 1] == '"') {
            if (pendingSpace && out.length > 0 && projectQsWord(out[out.length - 1])) {
                out = out + " ";
            }
            pendingSpace = false;
            out = out + '$';
            out = out + '"';
            i = i + 2;
            int braceDepth = 0;
            while (i < source.length) {
                char cc = source[i];
                if (cc == '"' && braceDepth == 0) {
                    out = out + cc;
                    i = i + 1;
                    break;
                }
                if (cc == '{') { braceDepth = braceDepth + 1; }
                elif (cc == '}' && braceDepth > 0) { braceDepth = braceDepth - 1; }
                elif (cc == '\\' && i + 1 < source.length) {
                    out = out + cc;
                    out = out + source[i + 1];
                    i = i + 2;
                    continue;
                }
                out = out + cc;
                i = i + 1;
            }
            continue;
        }
        if (c == '"') {
            if (pendingSpace && out.length > 0 && projectQsWord(out[out.length - 1])) {
                out = out + " ";
            }
            pendingSpace = false;
            out = out + c;
            i = i + 1;
            while (i < source.length) {
                char cc = source[i];
                if (cc == '"') {
                    out = out + cc;
                    i = i + 1;
                    break;
                }
                if (cc == '\\' && i + 1 < source.length) {
                    out = out + cc;
                    out = out + source[i + 1];
                    i = i + 2;
                    continue;
                }
                out = out + cc;
                i = i + 1;
            }
            continue;
        }
        if (c == '\'') {
            if (pendingSpace && out.length > 0 && projectQsWord(out[out.length - 1])) {
                out = out + " ";
            }
            pendingSpace = false;
            out = out + c;
            i = i + 1;
            while (i < source.length) {
                char cc = source[i];
                if (cc == '\'') {
                    out = out + cc;
                    i = i + 1;
                    break;
                }
                if (cc == '\\' && i + 1 < source.length) {
                    out = out + cc;
                    out = out + source[i + 1];
                    i = i + 2;
                    continue;
                }
                out = out + cc;
                i = i + 1;
            }
            continue;
        }
        if (pendingSpace && out.length > 0 && projectQsWord(out[out.length - 1]) && projectQsWord(c)) {
            out = out + " ";
        }
        pendingSpace = false;
        out = out + c;
        i = i + 1;
    }
    return out;
}

// `root\src\Auth.sr` -> `src/Auth.sr` (forward slashes, no root prefix).
string projectRelativePath(string root, string path) {
    if (root == ".") { return path; }
    string prefix = root + "\\";
    if (path.length > prefix.length) {
        bool matched = true;
        for (int i = 0; i < prefix.length; i = i + 1) {
            if (path[i] != prefix[i]) { matched = false; }
        }
        if (matched) {
            string result = "";
            for (int i = prefix.length; i < path.length; i = i + 1) {
                if (path[i] == '\\') { result = result + '/'; }
                else { result = result + path[i]; }
            }
            return result;
        }
    }
    return path;
}

string projectStripDirectivesCustom(string source, NativeModules nm) {
    // Same linear parts+join shape as projectStripDirectives (see its OOM
    // note), plus DOCS/261: keep declared bare custom lines
    // (`import { f } from gfx;`, `import * from starmod;`) beside the
    // win32/linux ones — they carry the custom grants codegen must see.
    // Undeclared bare lines stay dropped (Silver imports were already
    // collected; missing files report through the normal paths).
    string[] parts = [];
    int cursor = 0;
    while (cursor < source.length) {
        int end = cursor;
        while (end < source.length && source[end] != '\n') { end++; }
        string line = projectSlice(source, cursor, end);
        string trimmed = projectTrim(line);
        bool skip = false;
        if (trimmed.length >= 10 && projectSlice(trimmed, 0, 10) == "mod export") { skip = true; }
        bool isWin32Import = trimmed.length >= 6 && projectSlice(trimmed, 0, 6) == "import" && projectFind(trimmed, "win32", 0) >= 0;
        bool isLinuxImport = trimmed.length >= 6 && projectSlice(trimmed, 0, 6) == "import" && projectFind(trimmed, "linux", 0) >= 0;
        if (trimmed.length >= 6 && projectSlice(trimmed, 0, 6) == "import" && !isWin32Import && !isLinuxImport) {
            bool keepCustom = false;
            int impPos = projectFind(trimmed, "import", 0);
            int semiPos = projectFind(trimmed, ";", 0);
            if (impPos >= 0) {
                int semiEnd = semiPos;
                if (semiEnd < 0) { semiEnd = trimmed.length; }
                string stmt = projectSlice(trimmed, impPos + 6, semiEnd);
                if (projectFind(stmt, "from", 0) >= 0) {
                    string mod = projectImportModule(stmt);
                    if (mod.length > 0 && !projectIsStdModule(mod) && !projectBuiltin(mod) && nm.declared(mod)) { keepCustom = true; }
                }
            }
            if (!keepCustom) { skip = true; }
        }
        if (!skip) { parts.add(line); }
        if (end < source.length) { parts.add("\n"); }
        cursor = end + 1;
    }
    return parts.join("");
}

string projectStripDirectives(string source) {
    // Linear accumulation: one small part per line joined once at the end.
    // Per-line `result = result + line` was quadratic in retained garbage
    // (the runtime never frees the abandoned buffers) and blew past 10GB on
    // the self-hosted build aggregate (~30K lines), OOM-killing the host.
    string[] parts = [];
    int cursor = 0;
    while (cursor < source.length) {
        int end = cursor;
        while (end < source.length && source[end] != '\n') { end++; }
        string line = projectSlice(source, cursor, end);
        string trimmed = projectTrim(line);
        bool skip = false;
        if (trimmed.length >= 10 && projectSlice(trimmed, 0, 10) == "mod export") { skip = true; }
        // DOCS/213 -- keep `import ... from win32...;` lines: they carry the
        // native DLL module grants the codegen must see. LINUX.md Phase B:
        // keep `import ... from linux...;` lines beside them: they carry
        // the native Linux lib grants (linux.libc/x11/xtst) the same way.
        bool isWin32Import = trimmed.length >= 6 && projectSlice(trimmed, 0, 6) == "import" && projectFind(trimmed, "win32", 0) >= 0;
        bool isLinuxImport = trimmed.length >= 6 && projectSlice(trimmed, 0, 6) == "import" && projectFind(trimmed, "linux", 0) >= 0;
        if (trimmed.length >= 6 && projectSlice(trimmed, 0, 6) == "import" && !isWin32Import && !isLinuxImport) { skip = true; }
        if (!skip) { parts.add(line); }
        if (end < source.length) { parts.add("\n"); }
        cursor = end + 1;
    }
    return parts.join("");
}

// Cache-marker comment line (--cache-bytecode): the driver splits the
// aggregate back into per-file chunks along these lines.
string projectCacheMarker(string path) {
    string norm = "";
    for (int i = 0; i < path.length; i++) {
        if (path[i] == '\\') { norm = norm + '/'; }
        else { norm = norm + path[i]; }
    }
    return "//@@SILVER_FILE@@ " + norm + "\n";
}

// Visited-path tracker for project source collection.
//
// The self-hosted stage-2 backend has a code-generation edge case where a
// mutable array passed into a helper and grown there leaves the caller's
// length slot stale (silently truncating growth at 8 elements), which broke
// module dedup in `projectCollect`/`projectCountCollect` and re-collected the
// same files over and over. Class property arrays grow correctly, so the
// visited set is held in an object and mutated through methods instead of
// being passed as a bare `string[]` parameter.
class ProjectVisited {
    public prop string[] paths;

    construct {
        this.paths = [];
    }

    public void add(string p) {
        this.paths.add(p);
    }

    public bool contains(string p) {
        for (int i = 0; i < this.paths.length; i = i + 1) {
            if (this.paths[i] == p) { return true; }
        }
        return false;
    }
}

string projectCollect(string path, string root, string[] sourceDirs, ProjectVisited visited, bool emitMarkers, ProgressReporter progress) {
    if (visited.contains(path)) { return ""; }
    visited.add(path);
    // DOCS/260 — filter each project source BEFORE its imports are scanned
    // and its text joins the aggregate, so every file's `#on` regions resolve
    // independently and non-matching regions never reach the parser.
    string rawSource = file.readString(path);
    string source = preprocessOrProjectFail(rawSource);
    string result = "";
    int cursor = 0;
    while (cursor < source.length) {
        int importPos = projectFind(source, "import", cursor);
        if (importPos < 0) { break; }
        int semi = projectFind(source, ";", importPos + 6);
        if (semi < 0) { break; }
        string statement = projectSlice(source, importPos + 6, semi);
        string moduleName = projectImportModule(statement);
        if (moduleName.length > 0 && !projectBuiltin(moduleName)) {
            string importPath = projectSourcePath(root, sourceDirs, moduleName);
            if (importPath != "") {
                result = result + projectCollect(importPath, root, sourceDirs, visited, emitMarkers, progress) + "\n";
            }
        }
        cursor = semi + 1;
    }
    string marker = "";
    if (emitMarkers) { marker = projectCacheMarker(path); }
    if (progress != null) { progress.moduleDone(path); }
    return result + marker + source + "\n";
}

// Count how many project source files `projectCollect` would collect for the
// given entry (1 for the entry plus its transitive imports). Mirrors
// `projectCollect`'s resolution logic exactly so the total is precise.
int projectCountCollect(string path, string root, string[] sourceDirs, ProjectVisited visited) {
    if (visited.contains(path)) { return 0; }
    visited.add(path);
    // DOCS/260 — mirror projectCollect's filter so counts stay in lockstep
    // (a region error aborts during collection, before the aggregate builds).
    string rawSource = file.readString(path);
    string source = preprocessOrProjectFail(rawSource);
    int sub = 0;
    int cursor = 0;
    while (cursor < source.length) {
        int importPos = projectFind(source, "import", cursor);
        if (importPos < 0) { break; }
        int semi = projectFind(source, ";", importPos + 6);
        if (semi < 0) { break; }
        string statement = projectSlice(source, importPos + 6, semi);
        string moduleName = projectImportModule(statement);
        if (moduleName.length > 0 && !projectBuiltin(moduleName)) {
            string importPath = projectSourcePath(root, sourceDirs, moduleName);
            if (importPath != "") {
                sub = sub + projectCountCollect(importPath, root, sourceDirs, visited);
            }
        }
        cursor = semi + 1;
    }
    return 1 + sub;
}

string projectCollectionEscape(string value) {
    string result = "";
    for (int i = 0; i < value.length; i = i + 1) {
        char c = value[i];
        if (c == '\\') { result = result + "\\\\"; }
        elif (c == '"') { result = result + "\\\""; }
        elif (c == '\t') { result = result + "\\t"; }
        else { result = result + c; }
    }
    return result;
}

string projectCollectionLiteral(string path) {
    string content = file.readString(path);
    string result = "[";
    bool first = true;
    int start = 0;
    for (int i = 0; i <= content.length; i = i + 1) {
        bool atEnd = i == content.length;
        bool atLineEnd = false;
        if (!atEnd && content[i] == '\n') { atLineEnd = true; }
        if (atEnd || atLineEnd) {
            if (!atEnd || start < i) {
                int end = i;
                if (end > start && content[end - 1] == '\r') { end = end - 1; }
                string value = projectSlice(content, start, end);
                if (!first) { result = result + ", "; }
                first = false;
                result = result + "\"" + projectCollectionEscape(value) + "\"";
            }
            start = i + 1;
        }
    }
    return result + "]";
}

void projectCollectionFail(string path, int line) {
    printline("UnknownCollectionException: unknown collection was tried to be collected \"" + path + "\" at line " + line.toString());
    exit(1);
}

// True when the source contains a line whose `collects` occurrence passes
// the same comment/string-literal guards the expansion pass applies. The
// self-hosted bootstrap's own sources mention `collects` inside string
// literals (project.sr itself), so a bare substring scan would wrongly take
// the per-line aggregate-rebuild path and leak its way out of memory on
// large projects.
bool projectHasRealCollectDecl(string source) {
    int cursor = 0;
    while (cursor < source.length) {
        int end = cursor;
        while (end < source.length && source[end] != '\n') { end = end + 1; }
        string text = projectSlice(source, cursor, end);
        int marker = projectFind(text, "collects", 0);
        if (marker >= 0) {
            int comment = projectFind(text, "//", 0);
            int quote = projectFind(text, "\"", 0);
            if ((comment < 0 || comment > marker) && (quote < 0 || quote > marker)) {
                return true;
            }
        }
        cursor = end + 1;
    }
    return false;
}

string projectExpandCollections(string source, string root, string collections) {
    // Most projects do not declare collections. Avoid rebuilding a large
    // aggregate source one character at a time when there is nothing to
    // expand; this also keeps the self-hosted bootstrap within its array
    // growth limits.
    if (collections.length == 0) {
        // A declaration always uses the word as a standalone operator between
        // the array variable and its .col path. Comments and string literals
        // may mention `collects`; they must not force a full aggregate scan.
        if (!projectHasRealCollectDecl(source)) { return source; }
    }
    int markerLen = 8;
    string result = "";
    int cursor = 0;
    int line = 1;
    while (cursor < source.length) {
        int end = cursor;
        while (end < source.length && source[end] != '\n') { end = end + 1; }
        string text = projectSlice(source, cursor, end);
        int marker = projectFind(text, "collects", 0);
        int comment = projectFind(text, "//", 0);
        int quote = projectFind(text, "\"", 0);
        // Do not interpret the literal "collects" used by project helper
        // implementations as a collection declaration.
        if (marker >= 0 && (comment < 0 || comment > marker) && (quote < 0 || quote > marker)) {
            string prefix = projectTrim(projectSlice(text, 0, marker));
            int split = prefix.length - 1;
            while (split >= 0 && (prefix[split] != ' ' && prefix[split] != '\t')) { split = split - 1; }
            if (split < 0 || projectTrim(projectSlice(prefix, 0, split)) != "string[]") {
                projectCollectionFail("invalid declaration", line);
            }
            string path = projectTrim(projectSlice(text, marker + markerLen, text.length));
            int semi = projectFind(path, ";", 0);
            if (semi < 0) {
                projectCollectionFail("missing .col path", line);
            }
            path = projectTrim(projectSlice(path, 0, semi));
            if (collections.length == 0 || path.length == 0 || !projectHasSuffix(path, ".col") || projectFind(path, "..", 0) >= 0) {
                projectCollectionFail(path, line);
            }
            if (path[0] == '/' || path[0] == '\\') {
                projectCollectionFail(path, line);
            }
            string fullPath = projectJoin(root, collections + "\\" + path);
            if (!file.exists(fullPath)) {
                projectCollectionFail(path, line);
            }
            result = result + prefix + " = " + projectCollectionLiteral(fullPath) + projectSlice(path, semi, path.length);
        } else {
            result = result + text;
        }
        if (end < source.length) { result = result + '\n'; }
        cursor = end + 1;
        line = line + 1;
    }
    return result;
}

string projectBuildSource(string projectPath, bool emitMarkers) {
    string manifest = file.readString(projectPath);
    string root = projectDirname(projectPath);
    string entry = projectManifestValue(manifest, "entry");
    string[] sources = projectManifestSources(manifest);
    string[] excludes = projectManifestExcludes(manifest);
    string collections = projectManifestValue(manifest, "collections");

    string entryPath = projectJoin(root, entry);
    // Progress (STDERR): pre-count the module files (entry + transitive
    // imports) so the lines show an exact `[processed/total]` and a real ETA.
    ProjectVisited countVisited = new ProjectVisited();
    int moduleCount = projectCountCollect(entryPath, root, sources, countVisited);
    ProgressReporter progress = new ProgressReporter(moduleCount);
    ProjectVisited visited = new ProjectVisited();
    string collected = projectCollect(entryPath, root, sources, visited, emitMarkers, progress);
    progress.finish();
    NativeModules nmBuild = projectParseNativeModules(manifest);
    string body = projectStripDirectivesCustom(collected, nmBuild);

    // `.qs` libraries listed under `imports` are not auto-imported; declaring
    // one only makes it available. Extract each module's source from the
    // bundle and compile it alongside the project sources so that
    // `import * from X;` statements in the code resolve to the library.
    string[] imports = projectManifestImports(manifest);
    string[] allBundleStems = [];
    for (int qi = 0; qi < imports.length; qi++) {
        string qsPath0 = projectJoin(root, imports[qi]);
        string qsContent0 = file.readString(qsPath0);
        if (qsContent0.length > 0) {
            string[] stems0 = projectQsStems(qsContent0);
            for (int sj = 0; sj < stems0.length; sj++) {
                allBundleStems.add(stems0[sj]);
            }
        }
    }
    for (int ki = 0; ki < imports.length; ki++) {
        string qsPath = projectJoin(root, imports[ki]);
        string qsContent = file.readString(qsPath);
        if (qsContent.length > 0) {
            string[] libSources = projectQsSources(qsContent);
            for (int si = 0; si < libSources.length; si++) {
                // DOCS/261 v1: a bundle needing an undeclared custom module
                // fails naming the declaration. Bare sources naming project
                // files, sibling bundle modules, or std modules are Silver
                // (dropped downstream); declared customs are kept for the
                // target-side verification in parser/codegen.
                string libSrc = libSources[si];
                int cur = 0;
                while (cur < libSrc.length) {
                    int impPos = projectFind(libSrc, "import", cur);
                    if (impPos < 0) { break; }
                    int semi = projectFind(libSrc, ";", impPos + 6);
                    if (semi < 0) { break; }
                    string stmt = projectSlice(libSrc, impPos + 6, semi);
                    string mod = projectImportModule(stmt);
                    if (mod.length > 0) {
                        bool isPref = false;
                        if (mod.length >= 5 && projectSlice(mod, 0, 5) == "win32") { isPref = true; }
                        if (mod.length >= 5 && projectSlice(mod, 0, 5) == "linux") { isPref = true; }
                        if (!isPref && projectFind(stmt, "from", 0) >= 0) {
                            string ipath = projectSourcePath(root, sources, mod);
                            bool silver = false;
                            if (ipath != "") { silver = true; }
                            if (!silver) {
                                for (int bi = 0; bi < allBundleStems.length; bi++) {
                                    if (allBundleStems[bi] == mod) { silver = true; break; }
                                }
                            }
                            if (!silver && (projectIsStdModule(mod) || projectBuiltin(mod))) { silver = true; }
                            if (!silver && !nmBuild.declared(mod)) {
                                printline("Error: " + nativeUndeclaredMsg(mod));
                                exit(1);
                            }
                        }
                    }
                    cur = semi + 1;
                }
                body = body + libSources[si] + "\n";
            }
        }
    }

    body = projectExpandCollections(body, root, collections);
    file.writeString("project_dump.txt", body);

    string metadata = "";
    string name = projectManifestValue(manifest, "name");
    string version = projectManifestValue(manifest, "version");
    string license = projectManifestValue(manifest, "license");
    if (name != "") { metadata = metadata + "const string APP_NAME = \"" + name + "\";\n"; }
    if (version != "") { metadata = metadata + "const string APP_VERSION = \"" + version + "\";\n"; }
    if (license != "") { metadata = metadata + "const string APP_LICENSE = \"" + license + "\";\n"; }
    metadata = metadata + "const string LANG_VERSION = \"0.7.1\";\n";
    metadata = metadata + "const string APP_COPYRIGHT = \"Edan M. © 2025\";\n";
    // DOCS/253 -- expose the project type so Silver code can branch on it.
    // A missing `type` (or the legacy `exe` spelling) means `console`.
    string ptype = projectManifestValue(manifest, "type");
    if (ptype == "" || ptype == "exe") { ptype = "console"; }
    metadata = metadata + "const string APP_TYPE = \"" + ptype + "\";\n";
    return metadata + body;
}

// Build a QuickSilver (.qs) library bundle (DOCS/226) for a `quicksilver`
// project: every project source is minified and packed, with the library
// metadata (version, description, author, Silver version, copyright) header.
// Returns the bundle as an int[] of bytes; the caller writes it in place of
// an executable with file.writeBytes (byte values 1..=255, never NUL).
int[] projectBuildBundle(string projectPath) {
    string manifest = file.readString(projectPath);
    string root = projectDirname(projectPath);
    string entry = projectManifestValue(manifest, "entry");
    string[] sources = projectManifestSources(manifest);
    string[] excludes = projectManifestExcludes(manifest);
    string collections = projectManifestValue(manifest, "collections");

    string[] files = [];
    string[] visited = [];
    string entryPath = "";
    for (int ei = 0; ei < entry.length; ei = ei + 1) {
        if (entry[ei] == '/') { entryPath = entryPath + '\\'; }
        else { entryPath = entryPath + entry[ei]; }
    }
    entryPath = projectJoin(root, entryPath);
    if (!projectVisited(visited, entryPath)) {
        visited.add(entryPath);
        files.add(entryPath);
    }

    if (sources.length > 0) {
        for (int i = 0; i < sources.length; i = i + 1) {
            string[] got = projectAddEntry(root, sources[i], excludes);
            for (int k = 0; k < got.length; k = k + 1) {
                string p = got[k];
                if (!projectVisited(visited, p)) {
                    visited.add(p);
                    files.add(p);
                }
            }
        }
    } else {
        string[] got = projectWalk(root, "", excludes);
        for (int k = 0; k < got.length; k = k + 1) {
            string p = got[k];
            if (!projectVisited(visited, p)) {
                visited.add(p);
                files.add(p);
            }
        }
    }

    string version = projectManifestValue(manifest, "version");
    string description = projectManifestValue(manifest, "description");
    string author = projectManifestValue(manifest, "author");
    string copyright = projectManifestValue(manifest, "copyright");

    // Every byte of the bundle is an int in 1..=255; file.writeBytes masks
    // each to its low byte. `c - 'a' + 97` is the ASCII code of any char
    // (algebraically charcode - 97 + 97 = charcode).
    int[] bundle = [];
    bundle.add('Q' - 'a' + 97);
    bundle.add('S' - 'a' + 97);
    bundle.add('L' - 'a' + 97);
    bundle.add('I' - 'a' + 97);
    bundle.add('B' - 'a' + 97);
    bundle.add('2' - 'a' + 97);
    bundle.add(1); bundle.add(1); bundle.add(1); bundle.add(1);  // flags (reserved)
    string metaText = version + "\n" + description + "\n" + author + "\n0.7.1\n" + copyright;
    bundle.add((metaText.length / 16581375) + 1);
    bundle.add(((metaText.length / 65025) % 255) + 1);
    bundle.add(((metaText.length / 255) % 255) + 1);
    bundle.add((metaText.length % 255) + 1);
    for (int ti = 0; ti < metaText.length; ti = ti + 1) { bundle.add(metaText[ti] - 'a' + 97); }
    bundle.add((files.length / 16581375) + 1);
    bundle.add(((files.length / 65025) % 255) + 1);
    bundle.add(((files.length / 255) % 255) + 1);
    bundle.add((files.length % 255) + 1);
    for (int k = 0; k < files.length; k = k + 1) {
        string filename = projectRelativePath(root, files[k]);
        string expanded = projectExpandCollections(file.readString(files[k]), root, collections);
        string minified = projectMinify(expanded);
        bundle.add((filename.length / 16581375) + 1);
        bundle.add(((filename.length / 65025) % 255) + 1);
        bundle.add(((filename.length / 255) % 255) + 1);
        bundle.add((filename.length % 255) + 1);
        for (int fi = 0; fi < filename.length; fi = fi + 1) { bundle.add(filename[fi] - 'a' + 97); }
        bundle.add((minified.length / 16581375) + 1);
        bundle.add(((minified.length / 65025) % 255) + 1);
        bundle.add(((minified.length / 255) % 255) + 1);
        bundle.add((minified.length % 255) + 1);
        for (int si = 0; si < minified.length; si = si + 1) { bundle.add(minified[si] - 'a' + 97); }
    }
    return bundle;
}
