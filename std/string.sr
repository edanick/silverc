mod export string;

bool isAlpha(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

bool isAlphaNum(char c) {
    return isAlpha(c) || (c >= '0' && c <= '9');
}

string charToString(char c) {
    return c.toString();
}

public bool cliArgEq(string a, string b) {
    if (a.length != b.length) { return false; }
    for (int i = 0; i < a.length; i = i + 1) {
        if (a[i] != b[i]) { return false; }
    }
    return true;
}

int projectFind(string text, string needle, int start) {
    if (needle.length == 0) { return start; }
    int limit = text.length - needle.length;
    for (int i = start; i <= limit; i = i + 1) {
        bool same = true;
        for (int j = 0; j < needle.length; j = j + 1) {
            int needleIndex = i + j;
            if (text[needleIndex] != needle[j]) { same = false; }
        }
        if (same) { return i; }
    }
    return -1;
}

string projectSlice(string text, int start, int end) {
    string result = "";
    int a = start;
    if (a < 0) { a = 0; }
    int b = end;
    if (b > text.length) { b = text.length; }
    for (int i = a; i < b; i = i + 1) {
        result = result + text[i];
    }
    return result;
}

string projectTrim(string text) {
    int start = 0;
    int end = text.length;
    while (start < end && (text[start] == ' ' || text[start] == '\t' || text[start] == '\r' || text[start] == '\n')) {
        start = start + 1;
    }
    while (end > start && (text[end - 1] == ' ' || text[end - 1] == '\t' || text[end - 1] == '\r' || text[end - 1] == '\n')) {
        end = end - 1;
    }
    return projectSlice(text, start, end);
}

public string pad(string text, int count, string fill) {
    if (count <= 0 || fill.length == 0) { return text; }
    string unit = fill[0].toString();
    string left = "";
    string right = "";
    for (int i = 0; i < count; i = i + 1) { left = left + unit; right = right + unit; }
    return left + text + right;
}

public string padLeft(string text, int count, string fill) {
    if (count <= 0 || fill.length == 0) { return text; }
    string unit = fill[0].toString();
    string result = "";
    for (int i = 0; i < count; i = i + 1) { result = result + unit; }
    return result + text;
}

public string padRight(string text, int count, string fill) {
    if (count <= 0 || fill.length == 0) { return text; }
    string unit = fill[0].toString();
    string result = text;
    for (int i = 0; i < count; i = i + 1) { result = result + unit; }
    return result;
}

public string slugify(string text) {
    string result = "";
    for (int i = 0; i < text.length; i = i + 1) {
        char c = text[i];
        if (c >= 'a' && c <= 'z') { result = result + c; }
        elif (c >= 'A' && c <= 'Z') { result = result + char(c + 32); }
        elif (c >= '0' && c <= '9') { result = result + c; }
        elif (c == ' ' || c == '-' || c == '_') {
            if (result.length > 0 && result[result.length - 1] != '-') { result = result + "-"; }
        }
    }
    if (result.length > 0 && result[result.length - 1] == '-') {
        result = result.slice(0..result.length - 1);
    }
    return result;
}
