mod export string;

bool isAlpha(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

bool isAlphaNum(char c) {
    return isAlpha(c) || (c >= '0' && c <= '9');
}

string charToString(char c) {
    return c.toString();
}

enum StringCase {
    SENSITIVE,
    INSENSITIVE
}

// Unified case-aware string comparison. `==` stays the single blessed
// spelling for case-sensitive equality (`a == b`); reach for
// `string.equals(a, b, StringCase.INSENSITIVE)` only when ASCII
// case-insensitive matching is required (CLI `--os` values, module-name
// prefix checks). Case-sensitive mode simply delegates to `==`.
public bool equals(string a, string b, int sc) {
    // `sc == 1` covers raw-int callers (and the compilers, where the enum
    // IS the int); the enum disjunct covers interpreter enum values.
    if (sc == 1 || sc == StringCase.INSENSITIVE) {
        if (a.length != b.length) { return false; }
        for (int i = 0; i < a.length; i++) {
            int ca = a[i];
            int cb = b[i];
            if (ca >= 'A' && ca <= 'Z') { ca += 32; }
            if (cb >= 'A' && cb <= 'Z') { cb += 32; }
            if (ca != cb) { return false; }
        }
        return true;
    }
    return a == b;
}

int projectFind(string text, string needle, int start) {
    if (needle.length == 0) { return start; }
    int limit = text.length - needle.length;
    for (int i = start; i <= limit; i++) {
        bool same = true;
        for (int j = 0; j < needle.length; j++) {
            int needleIndex = i + j;
            if (text[needleIndex] != needle[j]) { same = false; }
        }
        if (same) { return i; }
    }
    return -1;
}

string projectSlice(string text, int start, int end) {
    string result = "";
    int a = start;
    if (a < 0) { a = 0; }
    int b = end;
    if (b > text.length) { b = text.length; }
    for (int i = a; i < b; i++) {
        result += text[i];
    }
    return result;
}

string projectTrim(string text) {
    int start = 0;
    int end = text.length;
    while (start < end && (text[start] == ' ' || text[start] == '\t' || text[start] == '\r' || text[start] == '\n')) {
        start++;
    }
    while (end > start && (text[end - 1] == ' ' || text[end - 1] == '\t' || text[end - 1] == '\r' || text[end - 1] == '\n')) {
        end--;
    }
    return projectSlice(text, start, end);
}

public string pad(string text, int count, string fill) {
    if (count <= 0 || fill.length == 0) { return text; }
    string unit = fill[0].toString();
    string left = "";
    string right = "";
    for (int i = 0; i < count; i++) { left += unit; right += unit; }
    return left + text + right;
}

public string padLeft(string text, int count, string fill) {
    if (count <= 0 || fill.length == 0) { return text; }
    string unit = fill[0].toString();
    string result = "";
    for (int i = 0; i < count; i++) { result += unit; }
    return result + text;
}

public string padRight(string text, int count, string fill) {
    if (count <= 0 || fill.length == 0) { return text; }
    string unit = fill[0].toString();
    string result = text;
    for (int i = 0; i < count; i++) { result += unit; }
    return result;
}

public string slugify(string text) {
    string result = "";
    for (int i = 0; i < text.length; i++) {
        char c = text[i];
        if (c >= 'a' && c <= 'z') { result += c; }
        elif (c >= 'A' && c <= 'Z') { result += char(c + 32); }
        elif (c >= '0' && c <= '9') { result += c; }
        elif (c == ' ' || c == '-' || c == '_') {
            if (result.length > 0 && result[result.length - 1] != '-') { result += "-"; }
        }
    }
    if (result.length > 0 && result[result.length - 1] == '-') {
        // substring(start, len): the `s.slice(a..b)` Range-method form passes
        // an int[] and always yields "", so use the (start, length) primitive.
        result = result.substring(0, result.length - 1);
    }
    return result;
}
