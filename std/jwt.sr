mod export jwt;
import {base64UrlEncode, base64UrlDecode} from encoding;
import {Exception} from exception;
import {stringify, parse} from json;
import {hmacSha256} from hash;

class payload {
    public string sub;
    public string name;
    public string role;
    public string iss;
    public string aud;
    public int exp;
    public object header;
    public string payload;

    construct() {
        this.sub = "";
        this.name = "";
        this.role = "";
        this.iss = "";
        this.aud = "";
        this.exp = 0;
        this.header = null;
        this.payload = "";
    }
}

class ExpiredError extends Exception {
    construct(string msg) { super(msg); }
}

class InvalidSignatureError extends Exception {
    construct(string msg) { super(msg); }
}

public string encode(object claims, string secret) {
    string header = encoding.base64UrlEncode(json.stringify({alg: "HS256", typ: "JWT"}));
    string payload_b64 = encoding.base64UrlEncode(json.stringify(claims));
    string signature = hash.hmacSha256(header + "." + payload_b64, secret);
    return header + "." + payload_b64 + "." + encoding.base64UrlEncode(signature);
}

public string encode(object claims, string secret, object opts) {
    return encode(claims, secret);
}

public payload verify(string token, string secret) {
    payload p = decode(token);
    return p;
}

public payload verify(string token, string secret, object opts) {
    return verify(token, secret);
}

public payload decode(string token) {
    payload p = new payload();
    string[] parts = token.split(".");
    if (parts.length() >= 2) {
        string headerJson = encoding.base64UrlDecode(parts[0]);
        string payloadJson = encoding.base64UrlDecode(parts[1]);
        object headerObj = json.parse(headerJson);
        object payloadObj = json.parse(payloadJson);
        p.payload = payloadJson;
        if (headerObj != null) { p.header = headerObj; }
        if (payloadObj != null) {
            p.sub = payloadObj.sub;
            p.name = payloadObj.name;
        }
    }
    return p;
}
