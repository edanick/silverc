import { Sleep as threadWinRawSleep, CreateThread as threadWinRawCreateThread, WaitForSingleObject as threadWinRawWaitForSingleObject, CloseHandle as threadWinRawCloseHandle } from win32.kernel32;

internal mod export thread_win;

// DOCS -- INTERNAL Windows backend of the public `threads` module
// (UNIFIED_CORE_LIBRARY.md Phase 2). Every kernel32 DLL call the thread
// module needs lives here and nowhere else: the public wrapper
// (std/thread.sr) contains zero win32 imports and reaches this code only
// behind the OS gate `if (osType() == OSTypes.WINDOWS)` (see std/os.sr for
// why the gate calls the plain-Silver osType() stand-in instead of the
// native os.type query).
//
// Everything in this file is project-internal: the `internal mod export`
// marker plus `internal` on every function keep the backend from leaking to
// user projects (enforced by compiler/visibility.sr on single-file compiles;
// .srp projects compile their whole source set as one project). A user file
// that tries `import * from thread_win;` fails with the standard internal-
// visibility error.
//
// KERNEL32 IMPORT ALIASING: the DLL exports are bound through explicit
// `X as Y` import aliases rather than a full-table `import * from
// win32.kernel32;` grant, so only the four functions below are granted, the
// grants answer to the local threadWin-prefixed names, and the PE import
// keeps the real export (mirrors std/time_win.sr and std/sysinfo_win.sr; one
// flat compile namespace makes local-name keying the safe default).
//
// TABLE STATUS of the four exports (silverc-rs/src/win32.rs and the
// self-host compiler/parser.sr + compiler/mini_cg.sr kernel32 tables):
// Sleep, WaitForSingleObject and CloseHandle are tabled on both compilers;
// CreateThread is tabled on NEITHER. Aliased single-export grants bypass the
// tables on both backends (silverc-rs win32::resolve matches grants by local
// name with no table check; the self-host alias path MiniCg.genUserCall ->
// addImportPatch(aliasDll, aliasExport) likewise), so no compiler/table
// change was needed. kernel32.dll really exports CreateThread -- the IAT
// import resolves at load time (probe exes importing it start up fine), the
// missing table rows only mean a full-table `import *` user cannot call it.
//
// DEAD SPAWN MECHANISM (probed before the split, preserved verbatim): the
// pre-split std/thread.sr passed its private trampoline to CreateThread as a
// BARE FUNCTION NAME -- `CreateThread(null, 0, threadStart, this, 0, null)`.
// Neither compiler supports function-name-as-value: an identifier that names
// a function lowers to a null/garbage slot (silverc-rs gen_expr falls
// through to `xor eax, eax` = 0; the self-hosted MiniCg loads [rbp+0], the
// saved frame pointer). The pre-split file also used the pre-DOCS/259
// C-style `function void()` syntax, which no longer parses, and sat in
// silverc.srp's exclude list -- so it never compiled anywhere. The split
// keeps that lowering shape exactly: the public wrapper still names the
// trampoline (`threadStart`) as a bare argument into
// threadWinSpawn(threadStart, this), so both compilers lower the entry to
// the same null/garbage they produced pre-split. A spawned thread would
// therefore jump to an invalid address and fault the process; this is the
// preserved historical behavior, not a regression. Every public signature
// kept its name/arity/return type; the three shapes the language cannot
// express (fn-typed ctor parameters, fn-typed props, arrays of fn types --
// all probed on both compilers) are documented at their sites in
// std/thread.sr.
//
// BOUNDED JOIN: threadWinJoin waits with the pre-split -1 (INFINITE)
// millisecond count on the stored handle only; the public join() guards on
// `this.handle != 0` first (pre-split guard, kept), so joining an
// un-started Thread is a no-op and probes over this module can never hang
// through it.

internal void threadWinSleep(int ms) {
    threadWinRawSleep(ms);
}

// Spawns the historical CreateThread call: entry is the (nulled/garbage)
// trampoline slot handed over by the wrapper, param the Thread object the
// trampoline historically received as LPVOID. Returns the thread HANDLE as
// an int, matching the pre-split `private prop int handle` storage (Win32
// handles fit 32 bits; kernel32 returns 0 on failure).
internal int threadWinSpawn(int entry, object param) {
    return threadWinRawCreateThread(null, 0, entry, param, 0, null);
}

internal void threadWinJoin(int handle) {
    threadWinRawWaitForSingleObject(handle, -1);
    threadWinRawCloseHandle(handle);
}
