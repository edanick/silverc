import * from win32.kernel32;

internal mod export fs_win;

// DOCS -- INTERNAL Windows backend of the public `fs` module
// (UNIFIED_CORE_LIBRARY.md Phase 2). Every kernel32 DLL call the fs module
// needs lives here and nowhere else: the public wrapper (std/fs.sr) contains
// zero win32 imports and reaches this code only behind the OS gate
// `if (osType() == OSTypes.WINDOWS)` (see std/os.sr for why the gate calls
// the plain-Silver osType() stand-in instead of the native os.type query).
//
// Everything in this file is project-internal: the `internal mod export`
// marker plus `internal` on every function keep the backend from leaking to
// user projects (enforced by compiler/visibility.sr on single-file compiles;
// .srp projects compile their whole source set as one project). A user file
// that tries `import * from fs_win;` fails with the standard internal-
// visibility error.
//
// The bodies below are moved from the pre-split fs.sr implementations so
// behavior is unchanged -- including FolderOps.list's FindFirstFileA
// enumeration quirk (the handle-based loop never copies the WIN32_FIND_DATA
// name, so each entry contributes ""). One mechanical adjustment: the old
// `byte[] buf[size];` fixed-declaration became `byte[] buf = new byte[size];`
// (the codebase-standard allocation idiom) because the fixed-declaration
// form does not survive the visibility pass's standalone parse of this
// module, which every direct `import * from fs_win;` triggers. Function
// names carry the fsWin prefix so the flattened self-hosted compilation
// (which merges all prepended stdlib sources into one namespace) never
// collides with another std module.

internal int fsWinGetAttrs(string path) {
    return GetFileAttributesA(path);
}

internal string fsWinReadString(string path) {
    int h = CreateFileA(path, 0x80000000, 3, null, 3, 0x80, 0);
    if (h == -1) { return ""; }
    int size = GetFileSize(h, null);
    byte[] buf = new byte[size];
    int read = 0;
    ReadFile(h, buf, size, &read, null);
    CloseHandle(h);
    string result = "";
    foreach (byte b in buf) { result += char(b); }
    return result;
}

internal byte[] fsWinRead(string path) {
    int h = CreateFileA(path, 0x80000000, 3, null, 3, 0x80, 0);
    if (h == -1) { return []; }
    int size = GetFileSize(h, null);
    byte[] buf = new byte[size];
    int read = 0;
    ReadFile(h, buf, size, &read, null);
    CloseHandle(h);
    return buf;
}

internal void fsWinWriteString(string path, string content) {
    int h = CreateFileA(path, 0x40000000, 0, null, 2, 0x80, 0);
    if (h == -1) { return; }
    byte[] buf = content.toBytes();
    int wrote = 0;
    WriteFile(h, buf, buf.length, &wrote, null);
    CloseHandle(h);
}

internal void fsWinWrite(string path, byte[] data) {
    int h = CreateFileA(path, 0x40000000, 0, null, 2, 0x80, 0);
    if (h == -1) { return; }
    int wrote = 0;
    WriteFile(h, data, data.length, &wrote, null);
    CloseHandle(h);
}

internal bool fsWinExists(string path) {
    return GetFileAttributesA(path) != -1;
}

internal void fsWinDelete(string path) {
    DeleteFileA(path);
}

internal void fsWinRename(string oldPath, string newPath) {
    MoveFileA(oldPath, newPath);
}

internal string[] fsWinListDir(string path) {
    string sp = path + "\\*";
    int h = FindFirstFileA(sp, null);
    if (h == -1) { return []; }
    string[] names = [];
    bool cont = true;
    while (cont) {
        string name = "";
        if (name != "." && name != "..") { names.add(name); }
        cont = FindNextFileA(h, null);
    }
    FindClose(h);
    return names;
}

internal void fsWinCreateDir(string path) {
    CreateDirectoryA(path, null);
}
