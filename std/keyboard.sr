// ---------------------------------------------------------------------------
// keyboard - Win32 keyboard input for the self-hosted Silver compiler.
//
// The universal keyboard module -- one module, one OS layer (keyboard ->
// win32.user32). The user32 calls (keybd_event, VkKeyScanA, GetKeyState)
// live inline in the `#on WINDOWS` regions of the public functions that need
// them, one unified function name per operation, no wrapper indirection, no
// alias imports; OS selection is compile-time via the preprocessor regions,
// so the runtime `os.type` check is not used here. The module carries no
// ws2_32 import either -- grants without call sites resolve to nothing on
// both compilers, so only user32 is granted.
//
// For a future non-Windows backend the fallbacks follow the module's
// read/write style: the state-changing entries (press/hold/release/send/
// type) become silent no-ops, isDown returns false, and nameToVk (hence vk)
// resolves through the pure keyNameToVk name table only -- its user32
// VkKeyScanA fallback is gated too, so unknown names report 0 instead of
// touching a DLL. The VK_* constants and keyNameToVk are pure and stay
// ungated.
//
// DISPATCH NOTE (per compiler): the qualified
// spellings never reach this source on silverc-rs. It answers every
// `keyboard.<fn>()` call with its native builtin before any module source is
// consulted (STDLIB_MODULES carries "keyboard" in src/stdlib/mod.rs;
// codegen.rs dispatches member calls on the bare `keyboard` identifier, so
// gen_call("keyboard.press") hits stdlib::is_stdlib_call ->
// stdlib::keyboard::gen_keyboard_call, which natively covers press/down/
// hold, release/up, send/type, isDown, vk/vkFor/vkForKey, setCursor/
// setCursorImage, clipCursor and getClipCursor -- other spellings warn).
// This source is still collected there (keyboard is NOT in rs's
// builtin-modules skip list, main.rs builtin_modules_set), which is what
// serves unqualified free-function calls and instance spellings. The
// self-hosted compiler has no keyboard-specific native dispatch at all:
// keyboard is not builtin-reserved (std/project.sr projectBuiltin) and not
// on the driver's hand-prepend/exclude lists, so this module's source is
// collected and every `keyboard.<fn>()` spelling resolves to the functions
// below; the bare user32 names inside them are classified by mini_cg.sr's
// keyboard elif (user32.dll) and lowered through the direct-IAT path.
//
// TESTING NOTE: press/hold/release/send/type inject real keystrokes into
// the user's session when run, so they are verified compile-only; the
// read-only surface (isDown, vk, keyNameToVk, nameToVk, the VK_* constants)
// is probe-safe.
//
// LINUX BACKEND (Phase B, XWayland/X11 v1 per LINUX.md §7): key synthesis
// via linux.xtst (XTestFakeKeyEvent) and state via linux.x11
// (XStringToKeysym/XKeysymToKeycode/XQueryKeymap), mirroring the user32
// bodies. The vk() table stays PURE (Windows numbers everywhere, per
// contract): the Linux path does NOT drive X off vk codes. Instead the
// string forms resolve the Silver key NAME to an X keysym name with the
// pure keyNameToX table below (single chars pass through, with X aliases
// for space/tab/enter/punctuation and the word keys), then
// XStringToKeysym/XKeysymToKeycode yield the server keycode. The int
// forms (press(int)/isDown(int)) carry X keycodes straight through on
// Linux (documented escape hatch -- pass server codes, not vk() codes).
// A null display (headless SSH) degrades to silent no-op / false, and
// unknown names resolve to NoSymbol and are skipped. nameToVk keeps its
// pure table + gated VkKeyScanA fallback (unknown -> 0 on Linux already).
//
// MAC BACKEND (Phase B, code-only -- MAC.md section 7/10, DEGRADED until an
// Aqua backend lands and is probed on Mac hardware): every `#on MAC` branch
// below degrades exactly like the Windows/Linux no-backend stubs (writes
// are silent no-ops, isDown returns false, nameToVk resolves through the
// pure keyNameToVk table only with unknown names reporting 0) -- never a
// stub that claims success falsely. The Aqua route is Quartz CGEvent
// (CGEventCreateKeyboardEvent/CGEventPost) through the ONE shared ObjC
// bridge seam (mac.objc: objc_getClass / sel_registerName / objc_msgSend,
// granted in src/macos.rs); synthesis needs the Accessibility TCC grant,
// without which the backend must keep degrading like these branches. The
// vk() table stays PURE (shared, ungated). No mac.* import is granted here
// until the Aqua backend lands (nothing below calls it yet). Mirrors
// silverc-rs/std/keyboard.sr MAC bodies.
// ---------------------------------------------------------------------------

mod export keyboard;

#on WINDOWS
import * from win32.user32;
#off
#on LINUX
import * from linux.x11;
#off
#on LINUX
import * from linux.xtst;
#off

// ---------------------------------------------------------------------------
// VK_* constants matching Win32 virtual-key codes used by user32.
// ---------------------------------------------------------------------------

const int VK_LBUTTON = 0x01;
const int VK_RBUTTON = 0x02;
const int VK_CANCEL = 0x03;
const int VK_BACKSPACE = 0x08;
const int VK_TAB = 0x09;
const int VK_CLEAR = 0x0C;
const int VK_RETURN = 0x0D;
const int VK_SHIFT = 0x10;
const int VK_CONTROL = 0x11;
const int VK_MENU = 0x12;
const int VK_PAUSE = 0x13;
const int VK_CAPITAL = 0x14;
const int VK_ESCAPE = 0x1B;
const int VK_SPACE = 0x20;
const int VK_PRIOR = 0x21;
const int VK_NEXT = 0x22;
const int VK_END = 0x23;
const int VK_HOME = 0x24;
const int VK_LEFT = 0x25;
const int VK_UP = 0x26;
const int VK_RIGHT = 0x27;
const int VK_DOWN = 0x28;
const int VK_INSERT = 0x2D;
const int VK_DELETE = 0x2E;
const int VK_LWIN = 0x5B;
const int VK_NUMLOCK = 0x90;
const int VK_SCROLL = 0x91;
const int VK_F1  = 0x70; const int VK_F2  = 0x71; const int VK_F3  = 0x72;
const int VK_F4  = 0x73; const int VK_F5  = 0x74; const int VK_F6  = 0x75;
const int VK_F7  = 0x76; const int VK_F8  = 0x77; const int VK_F9  = 0x78;
const int VK_F10 = 0x79; const int VK_F11 = 0x7A; const int VK_F12 = 0x7B;

const int KEYEVENTF_KEYUP = 0x0002;

// ---------------------------------------------------------------------------
// keyNameToVk: shortcuts for the common KeyCode names, then a string-eq
// fallback. We don't try stringIndex->int conversion in the silverc-rs
// path, so single-char handling matches against literal strings.
// Pure table -- no DLL behind it, so it stays ungated.
// ---------------------------------------------------------------------------

int keyNameToVk(string name) {
    if (name.length == 0) { return 0; }
    if (name == "a" || name == "A") { return 0x41; }
    if (name == "b" || name == "B") { return 0x42; }
    if (name == "c" || name == "C") { return 0x43; }
    if (name == "d" || name == "D") { return 0x44; }
    if (name == "e" || name == "E") { return 0x45; }
    if (name == "f" || name == "F") { return 0x46; }
    if (name == "g" || name == "G") { return 0x47; }
    if (name == "h" || name == "H") { return 0x48; }
    if (name == "i" || name == "I") { return 0x49; }
    if (name == "j" || name == "J") { return 0x4A; }
    if (name == "k" || name == "K") { return 0x4B; }
    if (name == "l" || name == "L") { return 0x4C; }
    if (name == "m" || name == "M") { return 0x4D; }
    if (name == "n" || name == "N") { return 0x4E; }
    if (name == "o" || name == "O") { return 0x4F; }
    if (name == "p" || name == "P") { return 0x50; }
    if (name == "q" || name == "Q") { return 0x51; }
    if (name == "r" || name == "R") { return 0x52; }
    if (name == "s" || name == "S") { return 0x53; }
    if (name == "t" || name == "T") { return 0x54; }
    if (name == "u" || name == "U") { return 0x55; }
    if (name == "v" || name == "V") { return 0x56; }
    if (name == "w" || name == "W") { return 0x57; }
    if (name == "x" || name == "X") { return 0x58; }
    if (name == "y" || name == "Y") { return 0x59; }
    if (name == "z" || name == "Z") { return 0x5A; }
    if (name == "0" || name == "_0") { return 0x30; }
    if (name == "1" || name == "_1") { return 0x31; }
    if (name == "2" || name == "_2") { return 0x32; }
    if (name == "3" || name == "_3") { return 0x33; }
    if (name == "4" || name == "_4") { return 0x34; }
    if (name == "5" || name == "_5") { return 0x35; }
    if (name == "6" || name == "_6") { return 0x36; }
    if (name == "7" || name == "_7") { return 0x37; }
    if (name == "8" || name == "_8") { return 0x38; }
    if (name == "9" || name == "_9") { return 0x39; }
    if (name == " " ) { return VK_SPACE; }
    if (name == "\t") { return VK_TAB; }
    if (name == "\n" || name == "\r") { return VK_RETURN; }
    if (name == "," ) { return 188; }
    if (name == "." ) { return 190; }
    if (name == "/" ) { return 191; }
    if (name == ";" ) { return 186; }
    if (name == "'" ) { return 222; }
    if (name == "[" ) { return 219; }
    if (name == "]" ) { return 221; }
    if (name == "\\") { return 220; }
    if (name == "-" ) { return 189; }
    if (name == "=" ) { return 187; }
    if (name == "`" ) { return 192; }
    if (name == "TAB")       { return VK_TAB; }
    if (name == "ESC" || name == "ESCAPE") { return VK_ESCAPE; }
    if (name == "ENTER" || name == "RETURN") { return VK_RETURN; }
    if (name == "SPACE")   { return VK_SPACE; }
    if (name == "BACKSPACE")    { return VK_BACKSPACE; }
    if (name == "DELETE" || name == "DEL") { return VK_DELETE; }
    if (name == "INSERT")       { return VK_INSERT; }
    if (name == "HOME")         { return VK_HOME; }
    if (name == "END")          { return VK_END; }
    if (name == "PAGEUP"  || name == "PRIOR")  { return VK_PRIOR; }
    if (name == "PAGEDOWN" || name == "NEXT") { return VK_NEXT; }
    if (name == "LEFT") { return VK_LEFT; }
    if (name == "UP")   { return VK_UP; }
    if (name == "RIGHT") { return VK_RIGHT; }
    if (name == "DOWN") { return VK_DOWN; }
    if (name == "SHIFT")  { return VK_SHIFT; }
    if (name == "CTRL"   || name == "CONTROL") { return VK_CONTROL; }
    if (name == "ALT"    || name == "MENU")    { return VK_MENU; }
    if (name == "WIN_KEY" || name == "WIN")    { return VK_LWIN; }
    if (name == "CAPS_LOCK"   || name == "CAPS")    { return VK_CAPITAL; }
    if (name == "NUM_LOCK"    || name == "NUM")     { return VK_NUMLOCK; }
    if (name == "SCROLL_LOCK" || name == "SCROLL") { return VK_SCROLL; }
    if (name == "F1") { return VK_F1; }
    if (name == "F2") { return VK_F2; }
    if (name == "F3") { return VK_F3; }
    if (name == "F4") { return VK_F4; }
    if (name == "F5") { return VK_F5; }
    if (name == "F6") { return VK_F6; }
    if (name == "F7") { return VK_F7; }
    if (name == "F8") { return VK_F8; }
    if (name == "F9") { return VK_F9; }
    if (name == "F10") { return VK_F10; }
    if (name == "F11") { return VK_F11; }
    if (name == "F12") { return VK_F12; }
    return 0;
}

// The VkKeyScanA fallback is the only DLL-backed part of nameToVk; the pure
// name table above still answers on a future non-Windows backend, unknown
// names report 0 there.
int nameToVk(string name) {
    int vk = keyNameToVk(name);
    if (vk != 0) { return vk; }
    #on WINDOWS
    // Fallback: a single cstring is enough for VkKeyScanA.
    int scan = VkKeyScanA(name);
    if (scan == -1) { return 0; }
    return scan & 0xFF;
    #off
    return 0;
}

// Silver key name -> X keysym name for XStringToKeysym (LINUX.md §7 v1).
// Pure table, ungated. Single printable chars pass through ("a", "A",
// "1"); X-side aliases cover the rest. Unknown names yield "" (the
// callers treat that as NoSymbol and skip).
string keyNameToX(string name) {
    if (name.length == 0) { return ""; }
    if (name.length() == 1) {
        if (name == " ") { return "space"; }
        if (name == ",") { return "comma"; }
        if (name == ".") { return "period"; }
        if (name == "/") { return "slash"; }
        if (name == ";") { return "semicolon"; }
        if (name == "'") { return "apostrophe"; }
        if (name == "[") { return "bracketleft"; }
        if (name == "]") { return "bracketright"; }
        if (name == "\\") { return "backslash"; }
        if (name == "-") { return "minus"; }
        if (name == "=") { return "equal"; }
        if (name == "`") { return "grave"; }
        return name;
    }
    if (name == "TAB") { return "Tab"; }
    if (name == "ESC" || name == "ESCAPE") { return "Escape"; }
    if (name == "ENTER" || name == "RETURN") { return "Return"; }
    if (name == "SPACE") { return "space"; }
    if (name == "BACKSPACE") { return "BackSpace"; }
    if (name == "DELETE" || name == "DEL") { return "Delete"; }
    if (name == "INSERT") { return "Insert"; }
    if (name == "HOME") { return "Home"; }
    if (name == "END") { return "End"; }
    if (name == "PAGEUP" || name == "PRIOR") { return "Prior"; }
    if (name == "PAGEDOWN" || name == "NEXT") { return "Next"; }
    if (name == "LEFT") { return "Left"; }
    if (name == "UP") { return "Up"; }
    if (name == "RIGHT") { return "Right"; }
    if (name == "DOWN") { return "Down"; }
    if (name == "SHIFT") { return "Shift_L"; }
    if (name == "CTRL" || name == "CONTROL") { return "Control_L"; }
    if (name == "ALT" || name == "MENU") { return "Alt_L"; }
    if (name == "WIN_KEY" || name == "WIN") { return "Super_L"; }
    if (name == "CAPS_LOCK" || name == "CAPS") { return "Caps_Lock"; }
    if (name == "NUM_LOCK" || name == "NUM") { return "Num_Lock"; }
    if (name == "SCROLL_LOCK" || name == "SCROLL") { return "Scroll_Lock"; }
    if (name.length() == 2 && name[0] == 'F') { return name; }
    if (name.length() == 3 && name[0] == 'F') { return name; }
    if (name.length() == 2 && name[0] == '_') { return name.substr(1, 1); }
    return "";
}

// Synthesize one keysym press (isDown != 0) or release through XTest.
// LINUX-only helper; unknown names and missing displays are silent no-ops.
void pressKeysym(string xname, int isDown) {
    #on LINUX
    if (xname.length() == 0) { return; }
    int d = XOpenDisplay(null);
    if (d == 0) { return; }
    int ks = XStringToKeysym(xname);
    if (ks == 0) { XCloseDisplay(d); return; }
    int code = XKeysymToKeycode(d, ks);
    if (code == 0) { XCloseDisplay(d); return; }
    XTestFakeKeyEvent(d, code, isDown, 0);
    XFlush(d);
    XCloseDisplay(d);
    #off
}

// True when the X keycode's bit is set in the server keymap.
// LINUX-only helper.
bool queryKeycodeBit(int code) {
    #on LINUX
    if (code < 8 || code > 255) { return false; }
    int d = XOpenDisplay(null);
    if (d == 0) { return false; }
    int[] keys = new int[4];
    XQueryKeymap(d, keys);
    XCloseDisplay(d);
    int byteOff = code / 8;
    int byteVal = (keys[byteOff / 8] >> ((byteOff % 8) * 8)) & 0xFF;
    int bit = code % 8;
    return ((byteVal >> bit) & 1) != 0;
    #off
    return false;
}

// queryKeycodeBit for a Silver key name (NoSymbol -> false).
// LINUX-only helper.
bool queryKeycodeBitFor(string keyName) {
    #on LINUX
    string xname = keyNameToX(keyName);
    if (xname.length() == 0) { return false; }
    int d = XOpenDisplay(null);
    if (d == 0) { return false; }
    int ks = XStringToKeysym(xname);
    if (ks == 0) { XCloseDisplay(d); return false; }
    int code = XKeysymToKeycode(d, ks);
    XCloseDisplay(d);
    if (code == 0) { return false; }
    return queryKeycodeBit(code);
    #off
    return false;
}

// ---------------------------------------------------------------------------
// Core press / release helpers (no private qualifier - silverc-rs parser
// doesn't recognize `private`). On a future non-Windows backend these are
// silent no-ops.
// ---------------------------------------------------------------------------

void press(string keyName) {
    int vk = nameToVk(keyName);
    #on WINDOWS
    keybd_event(vk, 0, 0, 0);
    #on LINUX
    pressKeysym(keyNameToX(keyName), 1);
    #on MAC
    // headless: no key synthesis (Quartz CGEvent route is gated).
    #off
}

void press(int vk) {
    #on WINDOWS
    keybd_event(vk, 0, 0, 0);
    #on LINUX
    int d = XOpenDisplay(null);
    if (d == 0) { return; }
    XTestFakeKeyEvent(d, vk, 1, 0);
    XFlush(d);
    XCloseDisplay(d);
    #on MAC
    // headless: no key synthesis (Quartz CGEvent route is gated).
    #off
}

void release(string keyName) {
    int vk = nameToVk(keyName);
    #on WINDOWS
    keybd_event(vk, 0, KEYEVENTF_KEYUP, 0);
    #on LINUX
    pressKeysym(keyNameToX(keyName), 0);
    #on MAC
    // headless: no key synthesis (Quartz CGEvent route is gated).
    #off
}

void release(int vk) {
    #on WINDOWS
    keybd_event(vk, 0, KEYEVENTF_KEYUP, 0);
    #on LINUX
    int d = XOpenDisplay(null);
    if (d == 0) { return; }
    XTestFakeKeyEvent(d, vk, 0, 0);
    XFlush(d);
    XCloseDisplay(d);
    #on MAC
    // headless: no key synthesis (Quartz CGEvent route is gated).
    #off
}

void hold(string keyName) { press(keyName); }

void hold(int vk)         { press(vk); }

void send(string text) {
    for (int i = 0; i < text.length; i++) {
        string one = text[i]; // char -> string for VkKeyScanA fallback
        int vk = nameToVk(one);
        if (vk == 0) {
            #on WINDOWS
            int scan = VkKeyScanA(one);
            vk = scan & 0xFF;
            #on MAC
            // headless: no scan fallback; unknown names stay 0 and the
            // key events below are skipped the same way.
            #off
        }
        #on WINDOWS
        keybd_event(vk, 0, 0, 0);
        keybd_event(vk, 0, KEYEVENTF_KEYUP, 0);
        #on LINUX
        pressKeysym(keyNameToX(one), 1);
        pressKeysym(keyNameToX(one), 0);
        #on MAC
        // headless: no key synthesis (Quartz CGEvent route is gated).
        #off
    }
}

void type(string text) { send(text); }

bool isDown(string keyName) {
    int vk = nameToVk(keyName);
    if (vk == 0) { return false; }
    #on WINDOWS
    return (GetKeyState(vk) & 0x8000) != 0;
    #on LINUX
    return queryKeycodeBitFor(keyNameToX(keyName));
    #on MAC
    return false;
    #off
    return false;
}

bool isDown(int vk) {
    #on WINDOWS
    return (GetKeyState(vk) & 0x8000) != 0;
    #on LINUX
    return queryKeycodeBit(vk);
    #on MAC
    return false;
    #off
    return false;
}

int vk(string keyName) {
    return nameToVk(keyName);
}
