mod export time;

// DOCS -- public `time` module (see UNIFIED_CORE_LIBRARY.md).
// This is the universal timing module: one module, one OS layer
// (time -> win32.kernel32). The raw OS calls live INSIDE each public
// function body behind a `#on WINDOWS` region -- one unified function name,
// no win-prefixed helpers, no wrapper indirection. There is no `#else` and
// no LINUX/MAC placeholders in std; the other-OS regions get filled on
// their own machines later. The preprocessor selects the OS code at compile
// time, so there is no `os` import here (the runtime `os.type` check is a
// user-facing feature).
//
// PLAIN IMPORT: the kernel32 grant is a plain full-table
// `import * from win32.kernel32;` inside its own region. Sleep,
// QueryPerformanceCounter and QueryPerformanceFrequency are present in BOTH
// compilers' kernel32 export tables (silverc-rs/src/win32.rs and the
// self-host win32ExportTable), so the plain grant resolves without any
// table change. The QPC int64 out-param pattern (`&int64`) feeds each
// 64-bit counter by address; now() derives milliseconds as
// (count / freq * 1000.0).
//
// DISPATCH NOTE (per compiler): silverc-rs answers bare `sleep(...)` /
// `now(...)` calls with native builtins (SENTINEL_SLEEP and the gen_now
// emitter) -- but gen_call consults func_labels FIRST, so with this module
// collected (its functions registered) the bodies below run and hit the
// same kernel32 exports; the self-hosted compiler has no such builtins and
// dispatches `time.*` to these globals directly. Both paths produce the
// same behavior. The sleep pair keeps the public API's exact int and uint
// overloads instead of funnelling both through one typed parameter --
// kernel32!Sleep takes the millisecond count either way.
//
// STOPWATCH (DOCS/259 -- anonymous function parameters): the receiver
// declares a function-typed parameter `void () job` -- an 8-byte address
// slot -- and invoking `job()` runs the caller's `(void () { ... })` body
// bracketed by two now() readings. The DOCS/259 shape reference:
//
//     time.stopwatch((void () {
//         printline("working...");
//         ...
//     }));
//
// LINUX BACKEND (Phase B): clock_gettime(CLOCK_MONOTONIC = 1) from
// linux.libc for now() (milliseconds as float64, same unit as the QPC
// ratio); nanosleep for the sleep pair (milliseconds split into whole
// seconds + nanoseconds in a two-slot timespec int[2]). Negative sleeps
// return at once (nanosleep rejects them; the clamp keeps the call safe).
// stopwatch() is pure Silver over now() and needs no region.
//
// MAC BACKEND (Phase B, code-only -- MAC.md section 10, UNVALIDATED until
// probed on Mac hardware): clock_gettime(CLOCK_MONOTONIC = 6 on Darwin,
// NOT 1 -- <time.h>, re-derived, never copied) + nanosleep via
// mac.libsystem. The timespec int[2] shape is the same (Darwin timespec is
// tv_sec/time_t + tv_nsec/long = 16 bytes, like Linux x86-64).

#on WINDOWS
import * from win32.kernel32;
#on LINUX
import * from linux.libc;
#on MAC
import * from mac.libsystem;
#off

public void stopwatch(void () job) {
    float64 start = now();
    job();
    printline("took " + (now() - start) + " ticks");
}

public void sleep(int ms) {
    #on WINDOWS
    Sleep(ms);
    #else
    if (ms < 0) { return; }
    int[] ts = new int[2];
    ts[0] = ms / 1000;
    ts[1] = (ms % 1000) * 1000000;
    int[] rem = new int[2];
    nanosleep(ts, rem);
    #off
}

public void sleep(uint ms) {
    #on WINDOWS
    Sleep(ms);
    #else
    int[] ts = new int[2];
    ts[0] = ms / 1000;
    ts[1] = (ms % 1000) * 1000000;
    int[] rem = new int[2];
    nanosleep(ts, rem);
    #off
}

public float64 now() {
    #on WINDOWS
    int64 freq = 0;
    int64 count = 0;
    QueryPerformanceFrequency(&freq);
    QueryPerformanceCounter(&count);
    return float64(count) / float64(freq) * 1000.0;
    #on LINUX
    int[] ts = new int[2];
    clock_gettime(1, ts);
    int64 sec = ts[0];
    int64 nsec = ts[1];
    return float64(sec) * 1000.0 + float64(nsec) / 1000000.0;
    #on MAC
    int[] ts = new int[2];
    clock_gettime(6, ts);
    int64 sec = ts[0];
    int64 nsec = ts[1];
    return float64(sec) * 1000.0 + float64(nsec) / 1000000.0;
    #off
}
