mod export time;

public void sleep(int ms) << Sleep(ms);

public void sleep(uint ms) << Sleep(ms);

public float64 now() {
    int64 freq = 0;
    int64 count = 0;
    QueryPerformanceFrequency(&freq);
    QueryPerformanceCounter(&count);
    return float64(count) / float64(freq) * 1000.0;
}

public float64 stopwatch(function void() fn) {
    float64 start = now();
    fn();
    float64 end = now();
    return end - start;
}
