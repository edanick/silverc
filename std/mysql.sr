import * from win32.ws2_32;

mod export mysql;

class row {
    private kvp<string, string> data;

    construct() { }

    public string get(string name) { return this.data.get(name); }
}

class result {
    private row[] rows;

    construct() { }
}

class connection {
    private string host;
    private string user;
    private string pass;
    private string db;

    construct(string host, string user, string pass, string db) {
        this.host = host; this.user = user; this.pass = pass; this.db = db;
    }

    public result query(string sql) {
        return new result();
    }

    public result query(string sql, object[] params) {
        return this.query(sql);
    }

    public int insert(string sql, object[] params) { return 1; }

    public void close() { }
}

public connection connect(string host, string user, string pass, string db) {
    return new connection(host, user, pass, db);
}
