import { socket as rawSocket, connect as rawConnect, listen as rawListen, bind, accept, recv, send, closesocket, inet_addr, WSAStartup } from win32.ws2_32;

internal mod export ws_win;

// DOCS -- INTERNAL Windows backend of the public `ws` module
// (UNIFIED_CORE_LIBRARY.md Phase 2). Every ws2_32 DLL call the ws module
// needs lives here and nowhere else: the public wrapper (std/ws.sr) contains
// zero win32 imports and reaches this code only behind the OS gate
// `if (osType() == OSTypes.WINDOWS)`. See std/os.sr for why the gate calls
// the plain-Silver osType() stand-in instead of the native os.type query.
//
// Everything in this file is project-internal: the `internal mod export`
// marker plus `internal` on every function keep the backend from leaking to
// user projects. A user file that tries `import * from ws_win;` fails with
// the standard internal-visibility error on both compilers (probed).
//
// WINSOCK IMPORT ALIASING: the ws public API exports the class `socket` and
// the free function `connect`, which share their names with ws2_32 exports.
// In one flat compile namespace a user-defined symbol wins resolution over a
// DLL export, so the raw calls below reach the DLL through `X as Y` import
// aliases (`socket as rawSocket`, `connect as rawConnect`, `listen as
// rawListen`) -- the exact pattern std/net_win.sr established. The remaining
// grants (bind/accept/recv/send/closesocket/inet_addr/WSAStartup) collide
// with nothing in the ws API and keep their real export names.
//
// MEMORY LAYOUT (identical to std/net_win.sr, probed there): Silver arrays
// are [cap, len, elem...] with 8-byte elements, so an int[] doubles as a
// packed qword buffer for DLL calls. `sockaddr_in` (16 bytes) is packed into
// one int[2]; `byte[]` must NOT cross a DLL boundary as a packed buffer (its
// slots are qwords too), so send packs payloads into an int[] and receive
// unpacks recv's bytes out of an int[] with shifts. Strings ARE packed byte
// buffers: data[i] reads one byte.
//
// WSAStartup: issued before each socket creation; it is reference-counted,
// so the repeated calls are harmless (the pre-split ws.sr never called it at
// all -- winsock stayed uninitialized and every socket() would fail).
//
// DLL RETURN NORMALIZATION (probed, applies to every ws2_32 call below): the
// self-hosted compiler ZERO-EXTENDS 32-bit DLL int returns, so SOCKET_ERROR
// (-1) arrives as 4294967295; silverc-rs sign-extends it to -1. A plain
// `v < 0` check therefore misses the failure on the self-host and the code
// would run on with a dead socket (this crashed probes immediately and
// deterministically). Every ws2_32 return that can be SOCKET_ERROR is hence
// normalized with the two-sided check `v < 0 || v > 2147483647`, which is
// correct on both compilers and cannot misfire: valid SOCKET handles are
// small positive values far below 2^31. std/net_win.sr has the same latent
// gap (its `v < 0` checks only); its probes never exercised a failing DLL
// return, so it went unnoticed there -- the dns/ftp splits must copy the
// two-sided form for getaddrinfo/bind/connect/recv/accept/send results.
//
// SCOPE: this backend is TRANSPORT ONLY. The WebSocket frame encode/decode
// lives in the public wrapper (std/ws.sr socket.encodeFrame/decodeFrame)
// because it is pure Silver with no DLL ops -- backends exist only where real
// DLL-backed operations exist. This file compiles standalone (primitives
// only, no wrapper-class references).

internal int wsWinStartup() {
    byte[] wsa = new byte[408];
    return WSAStartup(0x0202, wsa);
}

// Packs family/port/addr into the sockaddr_in image (two qwords). `ip` is
// the network-order u32 that inet_addr returns; 0 means INADDR_ANY.
internal void wsWinFillSockaddr(int[] sa, int port, int ip) {
    int pHi = (port >> 8) & 0xFF;
    int pLo = port & 0xFF;
    sa[0] = 2 | (pHi << 16) | (pLo << 24) | ((ip & 0xFFFFFFFF) << 32);
    sa[1] = 0;
}

internal int wsWinConnect(string host, int port) {
    wsWinStartup();
    int sock = rawSocket(2, 1, 0);
    if (sock < 0 || sock > 2147483647) { return -1; }
    int ip = inet_addr(host);
    int[] sa = new int[2];
    wsWinFillSockaddr(sa, port, ip);
    int rc = rawConnect(sock, sa, 16);
    if (rc < 0 || rc > 2147483647) {
        closesocket(sock);
        return -1;
    }
    return sock;
}

internal int wsWinListen(int port) {
    wsWinStartup();
    int sock = rawSocket(2, 1, 0);
    if (sock < 0 || sock > 2147483647) { return -1; }
    int[] sa = new int[2];
    wsWinFillSockaddr(sa, port, 0);
    int rc = bind(sock, sa, 16);
    if (rc < 0 || rc > 2147483647) {
        closesocket(sock);
        return -1;
    }
    rawListen(sock, 10);
    return sock;
}

// Returns the accepted raw socket handle, or -1 on failure (normalized per
// the DLL-return note above).
internal int wsWinAccept(int fd) {
    int client = accept(fd, null, null);
    if (client < 0 || client > 2147483647) { return -1; }
    return client;
}

// Sends a string payload: packed byte-for-byte into int[] qword slots before
// the send() call (byte[] must not cross the DLL boundary packed). The send
// result (byte count or SOCKET_ERROR) is deliberately ignored -- the public
// send() is void, as it was pre-split.
internal void wsWinSendString(int fd, string data) {
    int len = data.length;
    if (len <= 0) { return; }
    int slots = (len + 7) / 8;
    int[] packedBuf = new int[slots];
    for (int i = 0; i < len; i++) {
        int b = int(data[i]);
        packedBuf[i / 8] = packedBuf[i / 8] | ((b & 0xFF) << ((i % 8) * 8));
    }
    send(fd, packedBuf, len, 0);
}

// Sends a byte[] payload (a WebSocket frame produced by the wrapper's
// encodeFrame): same int[] qword packing as wsWinSendString.
internal void wsWinSendBytes(int fd, byte[] bytes) {
    int len = bytes.length;
    if (len <= 0) { return; }
    int slots = (len + 7) / 8;
    int[] packedBuf = new int[slots];
    for (int i = 0; i < len; i++) {
        int b = bytes[i] & 0xFF;
        packedBuf[i / 8] = packedBuf[i / 8] | (b << ((i % 8) * 8));
    }
    send(fd, packedBuf, len, 0);
}

// Receives up to maxLen raw bytes; returns them as a string (the caller --
// socket.receive / socket.onMessage / connect's handshake read -- decodes
// WebSocket framing on top). Returns "" on disconnect, error, or a
// zero-extended SOCKET_ERROR (see the DLL-return note above).
internal string wsWinReceive(int fd, int maxLen) {
    if (maxLen <= 0) { return ""; }
    int slots = (maxLen + 7) / 8;
    int[] buf = new int[slots];
    int n = recv(fd, buf, maxLen, 0);
    if (n <= 0 || n > 2147483647) { return ""; }
    string result = "";
    for (int i = 0; i < n; i++) {
        int b = (buf[i / 8] >> ((i % 8) * 8)) & 0xFF;
        char c = char(b);
        result += c.toString();
    }
    return result;
}

internal void wsWinClose(int fd) {
    closesocket(fd);
}
