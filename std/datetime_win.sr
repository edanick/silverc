import { GetLocalTime as datetimeWinRawGetLocalTime, GetSystemTime as datetimeWinRawGetSystemTime } from win32.kernel32;

internal mod export datetime_win;

// DOCS -- INTERNAL Windows backend of the public `datetime` module
// (UNIFIED_CORE_LIBRARY.md Phase 2). Every kernel32 DLL call the datetime
// module needs lives here and nowhere else: the public wrapper
// (std/datetime.sr) contains zero win32 imports and reaches this code only
// behind the OS gate `if (osType() == OSTypes.WINDOWS)` (see std/os.sr for
// why the gate calls the plain-Silver osType() stand-in instead of the
// native os.type query).
//
// Everything in this file is project-internal: the `internal mod export`
// marker plus `internal` on every function keep the backend from leaking to
// user projects (enforced by compiler/visibility.sr on single-file compiles;
// .srp projects compile their whole source set as one project). A user file
// that tries `import * from datetime_win;` fails with the standard internal-
// visibility error.
//
// KERNEL32 IMPORT ALIASING: the DLL exports are bound through explicit
// `X as Y` import aliases rather than a full-table `import * from
// win32.kernel32;` grant, so only the two functions below are granted, the
// grants answer to the local datetimeWin-prefixed names, and the PE import
// keeps the real export (mirrors std/time_win.sr and std/net_win.sr). Only
// exports present in BOTH compilers' kernel32 tables are granted
// (silverc-rs/src/win32.rs and compiler/parser.sr): GetLocalTime and
// GetSystemTime. SystemTimeToFileTime exists in neither table, so the epoch
// conversion the pre-split unix() sketched is done in pure Silver inside the
// public wrapper instead (that body never compiled anywhere, so no runtime
// behavior is lost).
//
// MEMORY LAYOUT (silverc-rs codegen): Silver arrays are [cap, len, elem...]
// with 8-byte elements and a variable holding the element-0 address, so an
// int[] doubles as a packed qword buffer for DLL calls (same idiom as
// std/net_win.sr's sockaddr packing). SYSTEMTIME is 8 consecutive u16 words
// (wYear, wMonth, wDayOfWeek, wDay, wHour, wMinute, wSecond, wMilliseconds)
// = 16 bytes, packed into one int[2]: slot 0 holds words 0-3, slot 1 words
// 4-7. datetimeWinUnpackFields shifts each field back out; the wDayOfWeek
// word is never needed by the public API and is not returned. All extracted
// fields are u16, so the sign bit of either slot stays clear and the shifts
// never see a negative operand.

internal int[] datetimeWinUnpackFields(int[] st) {
    int[] f = new int[7];
    f[0] = st[0] & 0xFFFF;
    f[1] = (st[0] >> 16) & 0xFFFF;
    f[2] = (st[0] >> 48) & 0xFFFF;
    f[3] = st[1] & 0xFFFF;
    f[4] = (st[1] >> 16) & 0xFFFF;
    f[5] = (st[1] >> 32) & 0xFFFF;
    f[6] = (st[1] >> 48) & 0xFFFF;
    return f;
}

// Fills a SYSTEMTIME image with the caller's LOCAL time and returns
// {year, month, day, hour, minute, second, millisecond}.
internal int[] datetimeWinLocalFields() {
    int[] st = new int[2];
    datetimeWinRawGetLocalTime(st);
    return datetimeWinUnpackFields(st);
}

// Same field vector as datetimeWinLocalFields, sourced from GetSystemTime
// (wall-clock UTC).
internal int[] datetimeWinUtcFields() {
    int[] st = new int[2];
    datetimeWinRawGetSystemTime(st);
    return datetimeWinUnpackFields(st);
}
