mod export regex;

class match {
    private kvp<string, string> groups;

    construct() { }

    public string group(string name) { return groups.get(name); }
}

class pattern {
    private string raw;

    construct(string raw) { this.raw = raw; }

    public bool test(string input) {
        return simpleMatch(this.raw, input);
    }

    public string match(string input) {
        string m = findMatch(this.raw, input);
        return m;
    }

    public string[] findAll(string input) {
        string[] results;
        string remaining = input;
        while (true) {
            string m = findMatch(this.raw, remaining);
            if (m == "") { break; }
            results.push(m);
            int idx = remaining.indexOf(m);
            if (idx < 0) { break; }
            remaining = remaining.substr(idx + m.length());
        }
        return results;
    }

    public string replace(string input, string replacement) {
        string result = "";
        string remaining = input;
        while (true) {
            string m = findMatch(this.raw, remaining);
            if (m == "") { result += remaining; break; }
            int idx = remaining.indexOf(m);
            result += remaining.substr(0, idx) + replacement;
            remaining = remaining.substr(idx + m.length());
        }
        return result;
    }
}

public pattern compile(string raw) { return new pattern(raw); }

public string[] split(string input, string delim) {
    return input.split(delim);
}

private bool simpleMatch(string pat, string input) {
    int textI = 0;
    int patI = 0;
    int textLen = input.length();
    int patLen = pat.length();
    int textStar = -1;
    int patStar = -1;

    while (textI < textLen) {
        if (patI < patLen && (pat[patI] == input[textI] || pat[patI] == '.')) {
            textI++; patI++;
        } else if (patI < patLen && pat[patI] == '*') {
            textStar = textI; patStar = patI; patI++;
        } else if (patI < patLen && pat[patI] == '+') {
            textStar = textI + 1; patStar = patI; patI++;
        } else if (patI < patLen && pat[patI] == '?') {
            textI++; patI++;
        } else if (patStar >= 0) {
            textStar++; textI = textStar; patI = patStar + 1;
        } else {
            return false;
        }
    }
    while (patI < patLen && pat[patI] == '*') { patI++; }
    return patI == patLen;
}

private string findMatch(string pat, string input) {
    for (int start = 0; start < input.length(); start++) {
        string sub = input.substr(start);
        if (simpleMatch(pat, sub)) {
            int end = start;
            string result = "";
            for (int i = 0; i < sub.length() && simpleMatch(pat, sub.substr(0, i + 1)); i++) {
                result = sub.substr(0, i + 1);
            }
            return result;
        }
    }
    return "";
}
