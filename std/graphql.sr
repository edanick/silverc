mod export graphql;
import * from time;

// DOCS -- public `graphql` module.
//
// Pure Silver -- no OS code, no preprocessor regions. Probed facts behind
// that shape:
//
// - The module imports only `time`; nothing here calls a DLL export, so no
//   win32 import is needed and msvcrt.dll is not forced into user PEs just
//   for importing this module.
// - There is NO HTTP path: the module never imports `http`, `net`, or any
//   win32.* module, opens no sockets, and performs no network I/O of any
//   kind. client.query()/client.mutate() are stubs that allocate an empty
//   `result` and return it (query() fills `data` with the constant object
//   literal `{users: {}, user: {}}`; mutate() leaves `data` untouched).
//   The `url` field is stored and never read; the header()/
//   schema.type()/server.start() bodies are empty. In short the module is
//   shape-only, like std/async.sr; the stub bodies are intentional and are
//   not silently redesigned into a real client.
//
// DISPATCH (per compiler, probed): `graphql` is NOT builtin-reserved on
// either compiler. silverc-rs's builtin_modules_set (src/main.rs) lists
// fs/json/yaml/env/url/hash/path/bom/console/math/http only, and the
// self-hosted compiler neither hand-prepends graphql (its compiler_driver
// prepend list is llmai/exception/bom/process/... only) nor treats it as
// builtin (visibility.sr visBuiltinModule). Both compilers resolve
// `import * from graphql;` as an ORDINARY SOURCE module from disk
// (std\graphql.sr candidates). Nothing here shadows a native dispatch, so
// no per-compiler call interception applies.
//
// CALLBACK GRAMMAR: schema.query declares its callback parameter in the
// DOCS/259 spelling
//
//     schema.query(string name, void () callback)
//
// -- the only function-typed parameter shape the compilers accept
// (silverc-rs's parser hard-rejects anything but `void () name`:
// "function-typed parameters support only `void () name`; other shapes are
// not supported yet"), and the C-style `void callback(args, ctx)` spelling
// is a parse error on both compilers. The callback is never invoked by the
// (empty) body.
//
// STUB PARTS (documented, intentional):
// - schema.type/schema.query bodies are empty; the constants Int/String/
//   Float/Boolean are declared but referenced by nothing.
// - server.start() is an empty stub; server.wait() loops `time.sleep(1000)`
//   forever -- the same never-returning shape std/ws.sr's wait() has. It is
//   part of the public surface, but never call it from a probe or test: it
//   blocks the process by design.
// - client.query()/mutate() make NO network call (see above), so probes are
//   pure and need no network bounding.
//
// QUALIFIED-CALL LANDMINE (self-host, see std/async.sr): wait() calls
// `time.sleep(1000)` -- a module-qualified call. That form recurses into a
// stack overflow only when the CURRENT module also defines the name; graphql
// defines no `sleep` of its own, so the qualified call routes to the time
// module correctly (the ws.sr wait() uses the identical pattern).
//
// IMPORT SPELLING: the module imports time with the portable star form
// `import * from time;`. The braced form is UNUSABLE here: silverc-rs's
// import resolution treats every braced name as a module candidate
// (src/main.rs maps named imports to per-name filesystem resolution), so it
// hunts for a module literally named "sleep" and fails with
// "unknown module \"sleep\"" (probed; `time` is not on rs's builtin list,
// so the statement is never routed to the time module). graphql never calls
// a bare `sleep(...)` anyway; wait() uses the module-qualified call.

public const int Int = 1;
public const int String = 2;
public const int Float = 3;
public const int Boolean = 4;

class args {
    public string get(string name) { return ""; }
}

class ctx {
    public object request;
}

class node {
    public string id;
    public string name;
    public string email;
}

class result {
    public object data;
}

class schema {
    public void type(string name, object fields) { }
    public void query(string name, void () callback) { }
}

class client {
    private string url;

    construct(string url) { this.url = url; }

    public void header(string name, string value) { }

    public result query(string q) {
        result r = new result();
        r.data = {users: {}, user: {}};
        return r;
    }

    public result mutate(string q, object variables) {
        result r = new result();
        return r;
    }
}

class server {
    construct(schema s, int port) { }
    public void start() { }
    public void wait() { while (true) { time.sleep(1000); } }
}
