mod export mime;

public const string JSON = "application/json";
public const string XML = "application/xml";
public const string BIN = "application/octet-stream";
public const string FORM = "application/x-www-form-urlencoded";
public const string MULTI = "multipart/form-data";

private kvp<string, string> extensions;

public string fromExtension(string ext) {
    ext = ext.toLower();
    if (ext == "html" || ext == "htm") { return "text/html"; }
    if (ext == "css") { return "text/css"; }
    if (ext == "js") { return "application/javascript"; }
    if (ext == "json") { return JSON; }
    if (ext == "xml") { return XML; }
    if (ext == "txt") { return "text/plain"; }
    if (ext == "png") { return "image/png"; }
    if (ext == "jpg" || ext == "jpeg") { return "image/jpeg"; }
    if (ext == "gif") { return "image/gif"; }
    if (ext == "svg") { return "image/svg+xml"; }
    if (ext == "ico") { return "image/x-icon"; }
    if (ext == "pdf") { return "application/pdf"; }
    if (ext == "zip") { return "application/zip"; }
    if (ext == "gz") { return "application/gzip"; }
    if (ext == "tar") { return "application/x-tar"; }
    if (ext == "mp3") { return "audio/mpeg"; }
    if (ext == "mp4") { return "video/mp4"; }
    if (ext == "webp") { return "image/webp"; }
    if (ext == "woff") { return "font/woff"; }
    if (ext == "woff2") { return "font/woff2"; }
    if (ext == "ttf") { return "font/ttf"; }
    if (ext == "otf") { return "font/otf"; }
    if (ext == "csv") { return "text/csv"; }
    if (ext == "yaml" || ext == "yml") { return "text/yaml"; }
    if (ext == "toml") { return "text/toml"; }
    if (ext == "md") { return "text/markdown"; }
    if (ext == "wasm") { return "application/wasm"; }
    return BIN;
}

public string fromFile(string filename) {
    int dot = filename.lastIndexOf(".");
    if (dot < 0) { return BIN; }
    return fromExtension(filename.substr(dot + 1));
}

public string fromBytes(byte[] bytes) {
    if (bytes.length < 4) { return BIN; }
    if (bytes[0] == 0x89 && bytes[1] == 0x50 && bytes[2] == 0x4E && bytes[3] == 0x47) { return "image/png"; }
    if (bytes[0] == 0xFF && bytes[1] == 0xD8) { return "image/jpeg"; }
    if (bytes[0] == 0x47 && bytes[1] == 0x49 && bytes[2] == 0x46) { return "image/gif"; }
    if (bytes[0] == 0x25 && bytes[1] == 0x50 && bytes[2] == 0x44 && bytes[3] == 0x46) { return "application/pdf"; }
    if (bytes[0] == 0x50 && bytes[1] == 0x4B) { return "application/zip"; }
    if (bytes[0] == 0x52 && bytes[1] == 0x49 && bytes[2] == 0x46 && bytes[3] == 0x46) { return "image/webp"; }
    return BIN;
}

public string toExtension(string mime) {
    if (mime == "text/html") { return ".html"; }
    if (mime == "text/css") { return ".css"; }
    if (mime == "application/javascript") { return ".js"; }
    if (mime == JSON) { return ".json"; }
    if (mime == XML) { return ".xml"; }
    if (mime == "text/plain") { return ".txt"; }
    if (mime == "image/png") { return ".png"; }
    if (mime == "image/jpeg") { return ".jpg"; }
    if (mime == "image/gif") { return ".gif"; }
    if (mime == "image/svg+xml") { return ".svg"; }
    if (mime == "application/pdf") { return ".pdf"; }
    if (mime == "text/csv") { return ".csv"; }
    return ".bin";
}

public bool matches(string mime, string pattern) {
    if (pattern.indexOf("*") >= 0) {
        string prefix = pattern.substr(0, pattern.indexOf("*"));
        return mime.indexOf(prefix) == 0;
    }
    return mime == pattern;
}
