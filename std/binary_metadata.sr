// Read-only metadata from an existing Windows PE executable or DLL.
// See DOCS/251.
mod export binary_metadata;

class BinaryMetadataException {
    public prop string message;
    public prop int line;
    public prop int column;
    public prop string reason;

    construct(string msg) {
        this.message = msg;
        this.line = 0;
        this.column = 0;
        this.reason = msg;
    }
}

class BinaryMetadata {
    public prop string language;
    public prop string version;
    public prop string fileVersion;
    public prop string description;
    public prop string company;
    public prop string copyright;
    public prop string product;
    public prop string productVersion;
    public prop string originalFilename;
    public prop string internalName;

    construct() {
        this.language = "";
        this.version = "";
        this.fileVersion = "";
        this.description = "";
        this.company = "";
        this.copyright = "";
        this.product = "";
        this.productVersion = "";
        this.originalFilename = "";
        this.internalName = "";
    }

    // getMetadata reads VERSIONINFO from an .exe or .dll. The native bridge
    // returns an empty status for missing files, unsupported images, malformed
    // resources, or images without VERSIONINFO; expose those failures as the
    // documented typed exception instead of returning a partial object.
    public static BinaryMetadata getMetadata(string path) {
        if (__binaryMetadataStatus(path) == 0) {
            throw new BinaryMetadataException("binary metadata unavailable for '" + path + "'");
        }

        BinaryMetadata result = new BinaryMetadata();
        result.language = __binaryMetadataField(path, "language");
        result.version = __binaryMetadataField(path, "ProductVersion");
        result.fileVersion = __binaryMetadataField(path, "FileVersion");
        result.description = __binaryMetadataField(path, "FileDescription");
        result.company = __binaryMetadataField(path, "CompanyName");
        result.copyright = __binaryMetadataField(path, "LegalCopyright");
        result.product = __binaryMetadataField(path, "ProductName");
        result.productVersion = __binaryMetadataField(path, "ProductVersion");
        result.originalFilename = __binaryMetadataField(path, "OriginalFilename");
        result.internalName = __binaryMetadataField(path, "InternalName");
        return result;
    }
}
