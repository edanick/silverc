#on WINDOWS
import * from win32.ws2_32;
import { connect as dllConnect, listen as dllListen } from win32.ws2_32;
import { memcpy } from win32.msvcrt;
#on LINUX
import * from linux.libc;
import { connect as dllConnect, listen as dllListen } from linux.libc;
#on MAC
import * from mac.libsystem;
import { connect as dllConnect, listen as dllListen } from mac.libsystem;
#off

mod export net;

// DOCS -- public `net` module. This is the universal TCP socket core
// module: client, server, and the raw-handle primitives the protocol
// modules (ssh, ftp, ws, smtp, ...) build on. Every OS-divergent call lives
// inline in the `#on WINDOWS` region of the function that needs it;
// functions whose WINDOWS and non-Windows bodies are identical are
// region-free passthroughs delegating to the region-holding function.
// One unified function name per operation, no win-prefixed helpers,
// no wrapper indirection.
//
// NAME-COLLISION FINDING (probed on both compilers): the module's own public
// free functions `connect(string, int)` and `listen(int)` share their names
// with the ws2_32 exports `connect`/`listen`, and user-defined symbols win
// resolution over DLL exports in the flat namespace. A bare
// `connect(sock, sa, 16)` inside a region body therefore re-enters the
// module function -- the arity dispatch finds no 2-argument user overload
// and the self-hosted compiler's guard rejects the call outright
// ("no overload of 'connect' takes 3 argument(s)"), so the raw export was
// UNREACHABLE by its real name inside this module -- a compiler-level
// finding that made this module uncompilable by the self-hosted compiler.
//
// THE FIX (import aliasing): the two colliding exports are imported under
// local names `dllConnect` / `dllListen` (the `X as Y` import-alias form,
// already used by fs.sr for `rename as renameFile`), and the raw call sites
// use those aliases. The DLL export is reached under a name that no user
// declaration in this module claims, so the arity dispatch is unambiguous on
// every compiler and the guard no longer sees a bogus overload. Every OTHER
// export used here
// (WSAStartup, socket, bind, accept, recv, send, closesocket, inet_addr)
// shares its name with no free function in this module, so the bare calls
// reach the DLL directly (class names do not block: `socket(2,1,0)` resolves
// to ws2_32 even though `class socket` exists -- probed).
//
// MEMORY LAYOUT (silverc-rs codegen): Silver arrays are [cap, len, elem...]
// with 8-byte elements and a variable holding the element-0 address, so an
// int[] doubles as a packed qword buffer for DLL calls. `sockaddr_in` (16
// bytes: family u16, port u16 big-endian, IPv4 u32, 8 zero bytes) is packed
// into one int[2]: qword 0 = family | port<<16 | addr<<32, qword 1 = 0.
// `byte[]` must NOT cross a DLL boundary as a packed buffer -- its slots are
// qwords -- so the receive path unpacks recv's bytes out of an int[] with
// shifts and the send paths pack the payload into an int[] the same way.
// Strings ARE packed byte buffers: data[i] reads one byte.
//
// WSAStartup is reference-counted, so issuing it before each socket creation
// is harmless. The two-sided 32-bit normalization (`v < 0 || v >
// 2147483647`) guards the inet_addr result: self-host zero-extends, rs
// sign-extends.
//
// LINUX BACKEND (Phase B): POSIX sockets from linux.libc, mirroring the
// `#on WINDOWS` bodies statement-for-statement. The OS shape is
// near-identical: socket/connect/bind/listen/accept/send/recv map 1:1,
// SOCKET_ERROR is -1 on both (no zero-extend divergence on Linux -- the
// normalization lines are kept verbatim anyway), and sockaddr_in packs
// exactly like the header's int[2] layout. Deliberate divergences:
// - No WSAStartup anywhere (no-op on Linux; the calls simply vanish).
// - closesocket -> close (one close(2) for sockets and files alike).
// - inet_addr -> parseDotted (pure-Silver dotted-quad parse below; same
//   network-order u32 contract, -1 on malformed input).
// - setRecvTimeoutRaw speaks Linux sockopt: SOL_SOCKET = 1 (not 0xFFFF),
//   SO_RCVTIMEO = 21 (not 0x1006), and the value is a struct timeval
//   {sec, usec} (16 bytes = int[2]) instead of a millisecond DWORD.
// - getaddrinfo/freeaddrinfo keep their shape, with one layout fix:
//   Windows ADDRINFOA keeps the 32-bit field order (ai_canonname at 24,
//   ai_addr at 32 = node slot 4), while Linux struct addrinfo packs the
//   pointers in declaration order (ai_addr at 24 = node slot 3,
//   ai_canonname at 32, ai_next at 40 = node slot 5 on both). The Linux
//   walk therefore reads saPtr from nodeBuf[3] (not [4]); the IPv4 word
//   inside the sockaddr is at sa slot 0 high half on both.
//
// MAC BACKEND (Phase B, code-only -- MAC.md section 10, UNVALIDATED until
// probed on Mac hardware): POSIX sockets via mac.libsystem -- the closest
// thing to a freebie in the port (MAC.md section 4). Same-name calls
// (socket/connect/bind/listen/accept/send/recv/close/getaddrinfo) ride the
// LINUX bodies through `#else`; SOCKET_ERROR = -1 likewise. Deliberate
// divergences, re-derived from macOS headers (never copied):
// - AF_INET = 2, SOCK_STREAM = 1: the same values on Darwin (safe).
// - setRecvTimeoutRaw speaks Darwin sockopt: SOL_SOCKET = 0xFFFF,
//   SO_RCVTIMEO = 0x1006 (NOT Linux's 1/21), value = struct timeval
//   {sec, usec} 16 bytes = int[2] (Darwin tv_sec is 8 bytes, tv_usec
//   4 + 4 pad -- the int[2] pack shape still holds for small values).
// - lookup() reads Darwin struct addrinfo: ai_addr at offset 32 = node
//   slot 4 (like Windows, NOT Linux's slot 3 -- Darwin keeps canonname at
//   24, ai_addr at 32, ai_next at 40).
// - No WSAStartup anywhere; closesocket -> close; inet_addr ->
//   parseDotted (pure, shared).
//
// BEHAVIOR NOTES: tls_client's connect() opens a plain TCP socket and
// stores it as the context (EncryptMessage/DecryptMessage are
// unimplemented in every compiler; setCA/setCert store their paths).
// listener.listen's backlog is hard-coded at 10, the value bindListen
// passes to the ws2_32 listen(sock, 10) call.

class socket {
    private int fd;

    construct(int fd) { this.fd = fd; }

    public void send(string data) {
        sendRaw(this.fd, data);
    }

    public string receive(int maxLen) {
        return recvRaw(this.fd, maxLen);
    }

    public void close() {
        closeRaw(this.fd);
    }

    public int handle() {
        return this.fd;
    }
}

class listener {
    private int fd;

    construct(int fd) { this.fd = fd; }

    public socket accept() {
        int client = acceptRaw(this.fd);
        if (client < 0) { return null; }
        return new socket(client);
    }

    public void close() {
        closeRaw(this.fd);
    }

    public int handle() {
        return this.fd;
    }
}

class tls_client {
    private string host;
    private int port;
    private string caPath;
    private string certPath;
    private int context;

    construct(string host, int port) {
        this.host = host;
        this.port = port;
        this.context = -1;
    }

    public void setCA(string path) { this.caPath = path; }
    public void setCert(string path) { this.certPath = path; }

    public bool connect() {
        int sock = connectRaw(this.host, this.port);
        if (sock < 0) { return false; }
        this.context = sock;
        return true;
    }

    public void send(string data) {
        sendRaw(this.context, data);
    }

    public string receive() {
        return recvRaw(this.context, 8192);
    }

    public void close() {
        closeRaw(this.context);
    }
}

// Public API: connects to host:port and returns a socket object (null on
// failure). host is a dotted IPv4 string (inet_addr parses it).
public socket connect(string host, int port) {
    int sock = connectRaw(host, port);
    if (sock < 0) { return null; }
    return new socket(sock);
}

// Public API: binds INADDR_ANY:port, listens (backlog 10) and returns a
// listener object (null on failure).
public listener listen(int port) {
    int sock = listenRaw(port);
    if (sock < 0) { return null; }
    return new listener(sock);
}

// ---- raw-handle primitives (protocol modules build on these) -------------
// They take/return raw socket descriptor ints so a protocol module can drive
// a connection without holding net objects. Each is the single home of the
// OS code for its operation: the bodies call the ws2_32 exports bare (reach-
// ability per the header finding) or route through the two private bodies.

// Creates a TCP socket and connects it to host:port. Returns the raw socket
// descriptor, or -1 on failure.
public int connectRaw(string host, int port) {
    return openTcp(host, port);
}

// Creates a TCP socket and binds it to INADDR_ANY:port without listening.
// Returns the raw socket descriptor, or -1 on failure.
public int bindRaw(int port) {
    #on WINDOWS
    byte[] wsa = new byte[408];
    WSAStartup(0x0202, wsa);
    int sock = socket(2, 1, 0);
    if (sock < 0) { return -1; }
    int pHi = (port >> 8) & 0xFF;
    int pLo = port & 0xFF;
    int[] sa = new int[2];
    sa[0] = 2 | (pHi << 16) | (pLo << 24);
    sa[1] = 0;
    int b = bind(sock, sa, 16);
    if (b < 0 || b > 2147483647) {
        closesocket(sock);
        return -1;
    }
    return sock;
    #else
    int sock = socket(2, 1, 0);
    if (sock < 0) { return -1; }
    int pHi = (port >> 8) & 0xFF;
    int pLo = port & 0xFF;
    int[] sa = new int[2];
    sa[0] = 2 | (pHi << 16) | (pLo << 24);
    sa[1] = 0;
    int b = bind(sock, sa, 16);
    if (b < 0 || b > 2147483647) {
        close(sock);
        return -1;
    }
    return sock;
    #off
    return -1;
}

// Creates a TCP socket, binds it to INADDR_ANY:port and listens (backlog 10).
// Returns the raw listening descriptor, or -1 on failure.
public int listenRaw(int port) {
    return bindListen(port);
}

// Blocks until a client connects to the listening descriptor. Returns the raw
// client descriptor, or -1 on failure.
public int acceptRaw(int fd) {
    int client = accept(fd, null, null);
    if (client > 2147483647) { client -= 4294967296; }
    return client;
}

// Sends the string's bytes on the raw descriptor (packed into an int[]
// qword buffer; byte[] must not cross a DLL boundary). No-op on len <= 0.
//
// SEND-ALL (data integrity): a single send() may accept FEWER bytes than
// requested (the kernel buffer filled up). The old one-shot send() silently
// dropped the tail -- a truncated packet on the wire. This loops until the
// whole payload is handed to the kernel, and returns the number of bytes
// accepted (-1 on a hard error, 0 for an empty payload).
public int sendRaw(int fd, string data) {
    int len = data.length;
    if (len <= 0) { return 0; }
    int slots = (len + 7) / 8;
    int[] packedBuf = new int[slots];
    for (int i = 0; i < len; i++) {
        int b = int(data[i]);
        packedBuf[i / 8] = packedBuf[i / 8] | ((b & 0xFF) << ((i % 8) * 8));
    }
    return sendAllRaw(fd, packedBuf, len);
}

// Sends a byte[] payload on the raw descriptor: every byte is packed into an
// int[] qword buffer before the send() call (byte[] must not cross a DLL
// boundary packed -- its slots are qwords; see the MEMORY LAYOUT note above).
// Exists for wire formats whose bytes are produced as byte[] -- e.g. ws
// frames (encodeFrame), which may legitimately contain 0x00 bytes that a
// Silver string cannot carry. No-op on len <= 0.
//
// SEND-ALL (data integrity): loops until the whole payload is accepted --
// see sendRaw for why the one-shot send() was wrong. Returns the byte count
// accepted (-1 on a hard error).
public int sendBytesRaw(int fd, byte[] data) {
    int len = data.length;
    if (len <= 0) { return 0; }
    int slots = (len + 7) / 8;
    int[] packedBuf = new int[slots];
    for (int i = 0; i < len; i++) {
        int b = data[i] & 0xFF;
        packedBuf[i / 8] = packedBuf[i / 8] | (b << ((i % 8) * 8));
    }
    return sendAllRaw(fd, packedBuf, len);
}

// SEND-ALL helper: hands a packed qword buffer to send() until the whole
// `len` bytes are accepted. A short send() (kernel buffer full) resumes at
// the next byte, so no payload byte is ever dropped. The buffer is re-packed
// from the surviving offset on each round because send() takes the buffer's
// base address (a Silver int[] has no interior pointer arithmetic).
private int sendAllRaw(int fd, int[] packedBuf, int len) {
    int sent = 0;
    while (sent < len) {
        int remaining = len - sent;
        int slots = (remaining + 7) / 8;
        int[] chunk = new int[slots];
        for (int i = 0; i < remaining; i++) {
            int src = sent + i;
            int b = (packedBuf[src / 8] >> ((src % 8) * 8)) & 0xFF;
            chunk[i / 8] = chunk[i / 8] | (b << ((i % 8) * 8));
        }
        int n = send(fd, chunk, remaining, 0);
        if (n > 2147483647) { n -= 4294967296; }
        if (n <= 0) { return -1; }
        sent += n;
    }
    return sent;
}

// Length-capped variant of sendRaw: sends the first `len` bytes of `data`
// (clamped to data.length; no-op on len <= 0). Exists for wire shapes that
// send a prefix of a known string -- e.g. ftp's server greeting, which
// writes the first 20 of its 22 bytes ("220 FTP Server ready" without the
// CRLF).
//
// SEND-ALL (data integrity): loops until the whole prefix is accepted --
// see sendRaw. Returns the byte count accepted (-1 on a hard error).
public int sendRawLen(int fd, string data, int len) {
    if (len <= 0) { return 0; }
    if (len > data.length) { len = data.length; }
    int slots = (len + 7) / 8;
    int[] packedBuf = new int[slots];
    for (int i = 0; i < len; i++) {
        int b = int(data[i]);
        packedBuf[i / 8] = packedBuf[i / 8] | ((b & 0xFF) << ((i % 8) * 8));
    }
    return sendAllRaw(fd, packedBuf, len);
}

// Receives up to maxLen bytes from the raw descriptor and returns them as a
// string ("" on error or clean close).
//
// TEXT PATH (NUL-limited): a Silver string cannot carry a NUL byte -- the
// runtime string is NUL-terminated -- so a payload with an embedded 0x00
// truncates here. Use recvBytesRaw for binary payloads (images, video,
// audio, any protocol with NUL bytes in it). recvRaw stays the text-shaped
// entry point for line/field protocols.
public string recvRaw(int fd, int maxLen) {
    if (maxLen <= 0) { return ""; }
    byte[] bytes = recvBytesRaw(fd, maxLen);
    int n = bytes.length;
    if (n <= 0) { return ""; }
    string result = "";
    for (int i = 0; i < n; i++) {
        char c = char(bytes[i] & 0xFF);
        result += (string)c;
    }
    return result;
}

// Receives up to maxLen bytes from the raw descriptor and returns them as a
// byte[] of the EXACT received length (an empty array on error or clean
// close).
//
// BINARY-SAFE (data integrity): the bytes travel as byte values 0..255 --
// no string is involved, so an embedded 0x00 survives the round trip. This
// is the receive counterpart of sendBytesRaw and the only lossless way to
// read a binary payload off the wire. The returned array's length IS the
// received byte count (a short read returns a shorter array).
public byte[] recvBytesRaw(int fd, int maxLen) {
    if (maxLen <= 0) { return []; }
    int slots = (maxLen + 7) / 8;
    int[] buf = new int[slots];
    int n = recv(fd, buf, maxLen, 0);
    if (n > 2147483647) { n -= 4294967296; }
    if (n <= 0) { return []; }
    byte[] out = netAllocBytes(n);
    for (int i = 0; i < n; i++) {
        int b = (buf[i / 8] >> ((i % 8) * 8)) & 0xFF;
        out[i] = b;
    }
    return out;
}

// Runtime-sized byte[] allocation routed through a return statement.
// The self-hosted compiler mis-lowers `byte[] x = new byte[expr];`
// DECLARATION initializers as one-element byte-array literals, so every
// runtime-sized byte[] is built here and returned; the caller's
// `byte[] out = netAllocBytes(n);` init is a plain call and takes the normal
// path. silverc-rs lowers both shapes correctly; this detour is
// byte-for-byte equivalent there.
private byte[] netAllocBytes(int count) {
    return new byte[count];
}

// Receives EXACTLY `count` bytes from the raw descriptor and returns them
// as a byte[] (an empty array if the peer closed early or the read timed
// out before `count` bytes arrived).
//
// EXACT-LENGTH READ (data integrity): TCP is a STREAM, not a message
// channel -- one recv() returns whatever has arrived so far, which may be
// a fraction of the payload (a 2 KB packet routinely arrives as three
// reads). A protocol that frames its messages by length MUST read exactly
// that many bytes; recvBytesRaw alone cannot express that, and a caller
// that assumes "one recv = one message" silently gets truncated frames.
// This loops until the full count is in hand.
//
// The read stops early (returning what it has) when recv() reports end of
// stream (0) or an error/timeout (-1) -- arm setRecvTimeoutRaw on the
// descriptor to bound the wait.
public byte[] recvBytesExactRaw(int fd, int count) {
    if (count <= 0) { return []; }
    byte[] out = netAllocBytes(count);
    int filled = 0;
    while (filled < count) {
        int[] buf = new int[(count - filled + 7) / 8];
        int n = recv(fd, buf, count - filled, 0);
        if (n > 2147483647) { n -= 4294967296; }
        if (n <= 0) { break; }
        for (int i = 0; i < n; i++) {
            int b = (buf[i / 8] >> ((i % 8) * 8)) & 0xFF;
            out[filled + i] = b;
        }
        filled += n;
    }
    if (filled == count) { return out; }
    // Short read: hand back only the bytes that actually arrived.
    byte[] partial = netAllocBytes(filled);
    for (int i = 0; i < filled; i++) { partial[i] = out[i]; }
    return partial;
}

// Receives EXACTLY `count` bytes and returns them as a string ("" on a
// short read). The text-shaped counterpart of recvBytesExactRaw: same
// exact-length contract, same NUL limitation (a Silver string cannot carry
// a NUL byte -- use recvBytesExactRaw for binary payloads).
public string recvRawExact(int fd, int count) {
    byte[] bytes = recvBytesExactRaw(fd, count);
    int n = bytes.length;
    if (n <= 0) { return ""; }
    string result = "";
    for (int i = 0; i < n; i++) {
        char c = char(bytes[i] & 0xFF);
        result += (string)c;
    }
    return result;
}

// Closes the raw descriptor.
public void closeRaw(int fd) {
    #on WINDOWS
    closesocket(fd);
    #else
    close(fd);
    #off
}

// Arms a receive timeout on the raw descriptor: subsequent recvRaw calls on
// it give up after `ms` milliseconds of silence and return "" instead of
// blocking forever (SO_RCVTIMEO: SOL_SOCKET 0xFFFF, SO_RCVTIMEO 0x1006, the
// millisecond value as a DWORD in the low half of one int[] qword slot).
// Protocol modules (ftp, ftps, ...) arm this on every socket they open so a
// silent peer cannot hang a bounded read loop. The setsockopt result is
// ignored (matching the protocol modules' posture).
public void setRecvTimeoutRaw(int fd, int ms) {
    #on WINDOWS
    int[] opt = new int[1];
    opt[0] = ms;
    setsockopt(fd, 0xFFFF, 0x1006, opt, 4);
    #on LINUX
    int[] opt = new int[2];
    opt[0] = ms / 1000;
    opt[1] = (ms % 1000) * 1000;
    setsockopt(fd, 1, 21, opt, 16);
    #on MAC
    int[] opt = new int[2];
    opt[0] = ms / 1000;
    opt[1] = (ms % 1000) * 1000;
    setsockopt(fd, 0xFFFF, 0x1006, opt, 16);
    #off
}

// ---- module-private Windows bodies ----------------------------------------
// openTcp/bindListen hold the shared WSAStartup + socket-creation sequences
// for connectRaw/listenRaw. Resolution prefers the DLL export inside regions
// whenever no user declaration accepts the argument count (true on both
// compilers), so the bare connect(sock, sa, 16) / listen(sock, 10) calls
// below reach ws2_32 while the module's public connect(string, int) /
// listen(int) keep winning their own matching arities.

// WSAStartup + socket() + inet_addr + connect: returns the connected raw
// descriptor, or -1 on failure.
int openTcp(string host, int port) {
    #on WINDOWS
    byte[] wsa = new byte[408];
    WSAStartup(0x0202, wsa);
    int sock = socket(2, 1, 0);
    if (sock < 0) { return -1; }
    int ip = inet_addr(host);
    if (ip < 0 || ip > 2147483647) { closesocket(sock); return -1; }
    int pHi = (port >> 8) & 0xFF;
    int pLo = port & 0xFF;
    int[] sa = new int[2];
    sa[0] = 2 | (pHi << 16) | (pLo << 24) | ((ip & 0xFFFFFFFF) << 32);
    sa[1] = 0;
    int c = dllConnect(sock, sa, 16);
    if (c < 0 || c > 2147483647) {
        closesocket(sock);
        return -1;
    }
    return sock;
    #else
    int sock = socket(2, 1, 0);
    if (sock < 0) { return -1; }
    int ip = parseDotted(host);
    if (ip < 0) { close(sock); return -1; }
    int pHi = (port >> 8) & 0xFF;
    int pLo = port & 0xFF;
    int[] sa = new int[2];
    sa[0] = 2 | (pHi << 16) | (pLo << 24) | ((ip & 0xFFFFFFFF) << 32);
    sa[1] = 0;
    int c = dllConnect(sock, sa, 16);
    if (c < 0 || c > 2147483647) {
        close(sock);
        return -1;
    }
    return sock;
    #off
    return -1;
}

// WSAStartup + socket() + bind + listen(10): returns the listening raw
// descriptor, or -1 on failure.
int bindListen(int port) {
    #on WINDOWS
    byte[] wsa = new byte[408];
    WSAStartup(0x0202, wsa);
    int sock = socket(2, 1, 0);
    if (sock < 0) { return -1; }
    int pHi = (port >> 8) & 0xFF;
    int pLo = port & 0xFF;
    int[] sa = new int[2];
    sa[0] = 2 | (pHi << 16) | (pLo << 24);
    sa[1] = 0;
    int b = bind(sock, sa, 16);
    if (b < 0 || b > 2147483647) {
        closesocket(sock);
        return -1;
    }
    int l = dllListen(sock, 10);
    if (l < 0 || l > 2147483647) {
        closesocket(sock);
        return -1;
    }
    return sock;
    #else
    int sock = socket(2, 1, 0);
    if (sock < 0) { return -1; }
    int pHi = (port >> 8) & 0xFF;
    int pLo = port & 0xFF;
    int[] sa = new int[2];
    sa[0] = 2 | (pHi << 16) | (pLo << 24);
    sa[1] = 0;
    int b = bind(sock, sa, 16);
    if (b < 0 || b > 2147483647) {
        close(sock);
        return -1;
    }
    int l = dllListen(sock, 10);
    if (l < 0 || l > 2147483647) {
        close(sock);
        return -1;
    }
    return sock;
    #off
    return -1;
}

// Renders a network-order IPv4 word as "a.b.c.d" (first octet = lowest
// byte). Single home of the quad render shared by every lookup branch;
// octet temps keep the explicit-cast shape the compilers prove (cf. the
// pasvHost/ip quad shapes).
string quadStr(int ip) {
    int o0 = (ip >> 0) & 0xFF;
    int o1 = (ip >> 8) & 0xFF;
    int o2 = (ip >> 16) & 0xFF;
    int o3 = (ip >> 24) & 0xFF;
    return (string)o0 + "." + (string)o1 + "." + (string)o2 + "." + (string)o3;
}

// ---- name resolution -------------------------------------------------------
// net is the socket AND name-resolution core: getaddrinfo is a ws2_32 call,
// so it lives here. Resolves `host` to its IPv4 dotted-quad addresses (the
// AF_INET hint means every returned node is a sockaddr_in; family defaults
// to 2 = AF_INET). Returns [] on any failure -- the shape a failing
// getaddrinfo produces.
//
// NAME-COLLISION FINDING: the dns module also exports a public
// one-argument `lookup(string)` and cross-module call dispatch is by BARE
// NAME + arity (the LAST declaration accepting the argument count wins,
// silverc-rs codegen.rs resolve_overload_symbol / self-host mini_cg.sr
// selectOverloadIdx -- module-qualified calls lose their qualifier). A
// same-name same-arity net.lookup(string) would therefore be UNREACHABLE
// from dns.sr: its own declaration would intercept every one-argument call
// and recurse forever. The trailing defaulted `family` parameter keeps the
// prescribed one-argument call shape (`net.lookup("host")`) for every other
// caller while giving dns.sr the two-argument call shape `net.lookup(host,
// 2)` that only this declaration accepts. Family is the getaddrinfo
// ai_family hint field (runtime shift into the high dword of hints qword 0;
// the constant-fold of `2 << 32` is unproven on the self-host, runtime
// shifts by 32 are the probed sockaddr idiom).
public string[] lookup(string host, int family = 2) {
    #on WINDOWS
    byte[] wsa = new byte[408];
    WSAStartup(0x0202, wsa);
    int[] hints = new int[6];
    hints[0] = family << 32;
    hints[1] = 1;
    int[] res = new int[1];
    int ret = getaddrinfo(host, null, hints, res);
    if (ret != 0) { return []; }
    string[] addresses = [];
    int node = res[0];
    while (node != 0) {
        int[] nodeBuf = new int[6];
        memcpy(nodeBuf, node, 48);
        int saPtr = nodeBuf[4];
        int next = nodeBuf[5];
        if (saPtr != 0) {
            int[] sa = new int[2];
            memcpy(sa, saPtr, 16);
            int ip = (sa[0] >> 32) & 0xFFFFFFFF;
            string ipStr = quadStr(ip);
            addresses.push(ipStr);
        }
        node = next;
    }
    freeaddrinfo(res[0]);
    return addresses;
    #on LINUX
    int[] hints = new int[6];
    hints[0] = family << 32;
    hints[1] = 1;
    int[] res = new int[1];
    int ret = getaddrinfo(host, null, hints, res);
    if (ret != 0) { return []; }
    string[] addresses = [];
    int node = res[0];
    while (node != 0) {
        int[] nodeBuf = new int[6];
        memcpy(nodeBuf, node, 48);
        int saPtr = nodeBuf[3];
        int next = nodeBuf[5];
        if (saPtr != 0) {
            int[] sa = new int[2];
            memcpy(sa, saPtr, 16);
            int ip = (sa[0] >> 32) & 0xFFFFFFFF;
            string ipStr = quadStr(ip);
            addresses.push(ipStr);
        }
        node = next;
    }
    freeaddrinfo(res[0]);
    return addresses;
    #on MAC
    // Darwin struct addrinfo keeps ai_addr at offset 32 = node slot 4
    // (like Windows, NOT Linux's slot 3 -- see the header).
    // UNVALIDATED code-only.
    int[] hints = new int[6];
    hints[0] = family << 32;
    hints[1] = 1;
    int[] res = new int[1];
    int ret = getaddrinfo(host, null, hints, res);
    if (ret != 0) { return []; }
    string[] addresses = [];
    int node = res[0];
    while (node != 0) {
        int[] nodeBuf = new int[6];
        memcpy(nodeBuf, node, 48);
        int saPtr = nodeBuf[4];
        int next = nodeBuf[5];
        if (saPtr != 0) {
            int[] sa = new int[2];
            memcpy(sa, saPtr, 16);
            int ip = (sa[0] >> 32) & 0xFFFFFFFF;
            string ipStr = quadStr(ip);
            addresses.push(ipStr);
        }
        node = next;
    }
    freeaddrinfo(res[0]);
    return addresses;
    #off
    return [];
}

// Pure-Silver dotted-quad parse ("a.b.c.d" -> network-order u32, the
// inet_addr contract: the first octet lands in the LOWEST byte, so the
// << 32 pack drops the wire order straight into the sockaddr; -1 on
// malformed input). Ungated: no OS code.
int parseDotted(string host) {
    int ip = 0;
    int mult = 1;
    int start = 0;
    for (int part = 0; part < 4; part++) {
        string tail = host.substr(start, host.length - start);
        int rel = tail.indexOf(".");
        int end = host.length;
        if (rel >= 0) { end = start + rel; }
        if ((part == 3 && rel >= 0) || (part < 3 && rel < 0)) { return -1; }
        string piece = host.substr(start, end - start);
        if (piece.length == 0) { return -1; }
        int v = 0;
        for (int i = 0; i < piece.length; i++) {
            char c = piece[i];
            if (c < '0' || c > '9') { return -1; }
            v = v * 10 + (int(c) - 48);
        }
        if (v > 255) { return -1; }
        ip += v * mult;
        mult = mult * 256;
        start = end + 1;
    }
    return ip;
}

// ---- UDP (datagram) primitives ---------------------------------------------
// UDP is connectionless: there is no accept/connect handshake, datagrams
// are addressed per-send, and one sendto() delivers exactly one datagram
// (no partial writes, no stream reassembly). A game server that must not
// lose packets uses UDP; one that must not reorder or duplicate them uses
// TCP.
//
// SOCK_DGRAM = 2 (POSIX and Windows agree). AF_INET = 2. A sockaddr_in is
// the same 16-byte struct the TCP path already packs into an int[2]:
// family u16, port u16 (big endian), IPv4 u32, 8 zero bytes.

// Creates a UDP socket (SOCK_DGRAM) and returns the raw descriptor, or -1
// on failure. The socket is unbound: use udpBindRaw to give it a local port.
public int udpOpenRaw() {
    #on WINDOWS
    byte[] wsa = new byte[408];
    WSAStartup(0x0202, wsa);
    int sock = socket(2, 2, 0);
    if (sock < 0) { return -1; }
    return sock;
    #else
    int sock = socket(2, 2, 0);
    if (sock < 0) { return -1; }
    return sock;
    #off
    return -1;
}

// Creates a UDP socket bound to INADDR_ANY:port and returns the raw
// descriptor, or -1 on failure. A bound UDP socket receives datagrams sent
// to that port (a "listener" in UDP terms).
public int udpBindRaw(int port) {
    #on WINDOWS
    byte[] wsa = new byte[408];
    WSAStartup(0x0202, wsa);
    int sock = socket(2, 2, 0);
    if (sock < 0) { return -1; }
    int pHi = (port >> 8) & 0xFF;
    int pLo = port & 0xFF;
    int[] sa = new int[2];
    sa[0] = 2 | (pHi << 16) | (pLo << 24);
    sa[1] = 0;
    int b = bind(sock, sa, 16);
    if (b < 0 || b > 2147483647) {
        closesocket(sock);
        return -1;
    }
    return sock;
    #else
    int sock = socket(2, 2, 0);
    if (sock < 0) { return -1; }
    int pHi = (port >> 8) & 0xFF;
    int pLo = port & 0xFF;
    int[] sa = new int[2];
    sa[0] = 2 | (pHi << 16) | (pLo << 24);
    sa[1] = 0;
    int b = bind(sock, sa, 16);
    if (b < 0 || b > 2147483647) {
        close(sock);
        return -1;
    }
    return sock;
    #off
    return -1;
}

// Sends one datagram to host:port. The payload is byte-exact (0x00 bytes
// included); it is packed into an int[] qword buffer because a byte[] must
// not cross a DLL boundary packed. Returns the byte count sent, or -1 on
// failure.
//
// One datagram per call: a datagram larger than the network MTU is
// rejected by the OS rather than fragmented silently -- check the return
// value.
public int udpSendToRaw(int fd, string host, int port, byte[] data) {
    int len = data.length;
    if (len <= 0) { return 0; }
    int ip = parseDotted(host);
    if (ip < 0) { return -1; }
    int pHi = (port >> 8) & 0xFF;
    int pLo = port & 0xFF;
    int[] sa = new int[2];
    sa[0] = 2 | (pHi << 16) | (pLo << 24) | ((ip & 0xFFFFFFFF) << 32);
    sa[1] = 0;
    int slots = (len + 7) / 8;
    int[] packedBuf = new int[slots];
    for (int i = 0; i < len; i++) {
        int b = data[i] & 0xFF;
        packedBuf[i / 8] = packedBuf[i / 8] | (b << ((i % 8) * 8));
    }
    int n = sendto(fd, packedBuf, len, 0, sa, 16);
    if (n > 2147483647) { n -= 4294967296; }
    return n;
}

// Receives one datagram (up to maxLen bytes) and returns it as a byte[] of
// the exact received length (an empty array on error or timeout). The
// sender's address is written into `fromAddr` when it is non-null: slot 0
// holds the IPv4 address, slot 1 the port (both in host order).
//
// BINARY-SAFE (data integrity): the datagram's bytes are returned as byte
// values 0..255 with no string involved, so an embedded 0x00 survives.
public byte[] udpRecvFromRaw(int fd, int maxLen, int[] fromAddr) {
    if (maxLen <= 0) { return []; }
    int slots = (maxLen + 7) / 8;
    int[] buf = new int[slots];
    int[] peerRaw = new int[2];
    // sockaddr_in is 16 bytes; recvfrom writes the real length back here.
    int[] peerLen = new int[1];
    peerLen[0] = 16;
    int n = recvfrom(fd, buf, maxLen, 0, peerRaw, peerLen);
    if (n > 2147483647) { n -= 4294967296; }
    if (n <= 0) { return []; }
    if (fromAddr != null) {
        // sockaddr_in (16 bytes): family u16, port u16 (NETWORK order --
        // big endian), IPv4 u32 (network order), 8 zero bytes. The qword
        // holds them little-endian, so the port's two bytes are swapped
        // relative to the 16-bit value: byte 2 is the HIGH byte.
        int raw = peerRaw[0];
        int portHi = (raw >> 16) & 0xFF;
        int portLo = (raw >> 24) & 0xFF;
        fromAddr[0] = (raw >> 32) & 0xFFFFFFFF;
        fromAddr[1] = (portHi << 8) | portLo;
    }
    byte[] out = netAllocBytes(n);
    for (int i = 0; i < n; i++) {
        int b = (buf[i / 8] >> ((i % 8) * 8)) & 0xFF;
        out[i] = b;
    }
    return out;
}
