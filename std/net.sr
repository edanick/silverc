import * from win32.ws2_32;

mod export net;

class socket {
    private int fd;

    construct(int fd) { this.fd = fd; }

    public void send(string data) {
        byte[] bytes = data.toBytes();
        send(this.fd, bytes, bytes.length, 0);
    }

    public string receive(int maxLen) {
        byte[] buf = new byte[maxLen];
        int n = recv(this.fd, buf, maxLen, 0);
        if (n <= 0) { return ""; }
        string result = "";
        for (int i = 0; i < n; i++) { result += char(buf[i]); }
        return result;
    }

    public void close() { closesocket(this.fd); }
}

class listener {
    private int fd;

    construct(int fd) { this.fd = fd; }

    public socket accept() {
        int client = accept(this.fd, null, null);
        if (client < 0) { return null; }
        return new socket(client);
    }

    public void close() { closesocket(this.fd); }
}

class tls_client {
    private string host;
    private int port;
    private string caPath;
    private string certPath;
    private SCHANNEL_CRED creds;
    private int context;

    construct(string host, int port) {
        this.host = host;
        this.port = port;
    }

    public void setCA(string path) { this.caPath = path; }
    public void setCert(string path) { this.certPath = path; }

    public bool connect() {
        int sock = socket(AF_INET, SOCK_STREAM, 0);
        if (sock < 0) { return false; }
        struct sockaddr_in addr;
        addr.sin_family = AF_INET;
        addr.sin_port = (this.port & 0xFF) << 8 | (this.port >> 8) & 0xFF;
        addr.sin_addr.s_addr = inet_addr(this.host);
        if (connect(sock, &addr, 16) < 0) { closesocket(sock); return false; }
        this.context = sock;
        return true;
    }

    public void send(string data) {
        byte[] bytes = data.toBytes();
        EncryptMessage(this.context, 0, bytes, bytes.length);
    }

    public string receive() {
        byte[] buf = new byte[8192];
        int n = DecryptMessage(this.context, buf, 8192);
        if (n <= 0) { return ""; }
        string result = "";
        for (int i = 0; i < n; i++) { result += char(buf[i]); }
        return result;
    }

    public void close() { closesocket(this.context); }
}

public socket connect(string host, int port) {
    int sock = socket(AF_INET, SOCK_STREAM, 0);
    if (sock < 0) { return null; }
    struct sockaddr_in addr;
    addr.sin_family = AF_INET;
    addr.sin_port = (port & 0xFF) << 8 | (port >> 8) & 0xFF;
    addr.sin_addr.s_addr = inet_addr(host);
    if (connect(sock, &addr, 16) < 0) { closesocket(sock); return null; }
    return new socket(sock);
}

public listener listen(int port) {
    int sock = socket(AF_INET, SOCK_STREAM, 0);
    if (sock < 0) { return null; }
    struct sockaddr_in addr;
    addr.sin_family = AF_INET;
    addr.sin_addr.s_addr = 0;
    addr.sin_port = (port & 0xFF) << 8 | (port >> 8) & 0xFF;
    if (bind(sock, &addr, 16) < 0) { closesocket(sock); return null; }
    listen(sock, 10);
    return new listener(sock);
}
