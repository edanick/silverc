#on WINDOWS
import * from win32.ws2_32;
import { memcpy } from win32.msvcrt;
#off
#on LINUX
import * from linux.libc;
#off

mod export net;

// DOCS -- public `net` module. This is the universal TCP socket core
// module: client, server, and the raw-handle primitives the protocol
// modules (ssh, ftp, ws, smtp, ...) build on. Every ws2_32 call lives
// inline in the `#on WINDOWS` region of the public function that needs
// it, one unified function name per operation, no win-prefixed helpers,
// no wrapper indirection, no alias imports.
//
// NAME-COLLISION FINDING (probed on both compilers): the module's own public
// free functions `connect(string, int)` and `listen(int)` share their names
// with the ws2_32 exports `connect`/`listen`, and user-defined symbols win
// resolution over DLL exports in the flat namespace. Any bare
// `connect(sock, sa, 16)` / `listen(sock, 10)` inside a region body
// therefore re-enters the module function (arity dispatch: same-arity user
// decl intercepts; no-arity-match user decl is a hard type-check error).
// The two raw exports are thus UNREACHABLE by their real names inside this
// module -- a compiler-level finding. Every ws2_32 export used here reaches
// the DLL: the module's own connect(string, int) / listen(int) declarations
// win only their own arity (resolution prefers the DLL export when no user
// declaration accepts the argument count -- true on both compilers), so
// openTcp/bindListen call connect(sock, sa, 16) / listen(sock, 10) directly.
// Every OTHER export used here
// (WSAStartup, socket, bind, accept, recv, send, closesocket, inet_addr)
// shares its name with no free function in this module, so the bare calls
// reach the DLL directly (class names do not block: `socket(2,1,0)` resolves
// to ws2_32 even though `class socket` exists -- probed).
//
// MEMORY LAYOUT (silverc-rs codegen): Silver arrays are [cap, len, elem...]
// with 8-byte elements and a variable holding the element-0 address, so an
// int[] doubles as a packed qword buffer for DLL calls. `sockaddr_in` (16
// bytes: family u16, port u16 big-endian, IPv4 u32, 8 zero bytes) is packed
// into one int[2]: qword 0 = family | port<<16 | addr<<32, qword 1 = 0.
// `byte[]` must NOT cross a DLL boundary as a packed buffer -- its slots are
// qwords -- so the receive path unpacks recv's bytes out of an int[] with
// shifts and the send paths pack the payload into an int[] the same way.
// Strings ARE packed byte buffers: data[i] reads one byte.
//
// WSAStartup is reference-counted, so issuing it before each socket creation
// is harmless. The two-sided 32-bit normalization (`v < 0 || v >
// 2147483647`) guards the inet_addr result: self-host zero-extends, rs
// sign-extends.
//
// LINUX BACKEND (Phase B): POSIX sockets from linux.libc, mirroring the
// `#on WINDOWS` bodies statement-for-statement. The OS shape is
// near-identical: socket/connect/bind/listen/accept/send/recv map 1:1,
// SOCKET_ERROR is -1 on both (no zero-extend divergence on Linux -- the
// normalization lines are kept verbatim anyway), and sockaddr_in packs
// exactly like the header's int[2] layout. Deliberate divergences:
// - No WSAStartup anywhere (no-op on Linux; the calls simply vanish).
// - closesocket -> close (one close(2) for sockets and files alike).
// - inet_addr -> parseDotted (pure-Silver dotted-quad parse below; same
//   network-order u32 contract, -1 on malformed input).
// - setRecvTimeoutRaw speaks Linux sockopt: SOL_SOCKET = 1 (not 0xFFFF),
//   SO_RCVTIMEO = 21 (not 0x1006), and the value is a struct timeval
//   {sec, usec} (16 bytes = int[2]) instead of a millisecond DWORD.
// - getaddrinfo/freeaddrinfo keep their shape, with one layout fix:
//   Windows ADDRINFOA keeps the 32-bit field order (ai_canonname at 24,
//   ai_addr at 32 = node slot 4), while Linux struct addrinfo packs the
//   pointers in declaration order (ai_addr at 24 = node slot 3,
//   ai_canonname at 32, ai_next at 40 = node slot 5 on both). The Linux
//   walk therefore reads saPtr from nodeBuf[3] (not [4]); the IPv4 word
//   inside the sockaddr is at sa slot 0 high half on both.
// BEHAVIOR NOTES: tls_client's connect() opens a plain TCP socket and
// stores it as the context (EncryptMessage/DecryptMessage are
// unimplemented in every compiler; setCA/setCert store their paths).
// listener.listen's backlog is hard-coded at 10, the value bindListen
// passes to the ws2_32 listen(sock, 10) call.

class socket {
    private int fd;

    construct(int fd) { this.fd = fd; }

    public void send(string data) {
        #on WINDOWS
        sendRaw(this.fd, data);
        #off
        #on LINUX
        sendRaw(this.fd, data);
        #off
    }

    public string receive(int maxLen) {
        #on WINDOWS
        return recvRaw(this.fd, maxLen);
        #off
        #on LINUX
        return recvRaw(this.fd, maxLen);
        #off
        return "";
    }

    public void close() {
        #on WINDOWS
        closeRaw(this.fd);
        #off
        #on LINUX
        closeRaw(this.fd);
        #off
    }

    public int handle() {
        return this.fd;
    }
}

class listener {
    private int fd;

    construct(int fd) { this.fd = fd; }

    public socket accept() {
        #on WINDOWS
        int client = acceptRaw(this.fd);
        if (client < 0) { return null; }
        return new socket(client);
        #off
        #on LINUX
        int client = acceptRaw(this.fd);
        if (client < 0) { return null; }
        return new socket(client);
        #off
        return null;
    }

    public void close() {
        #on WINDOWS
        closeRaw(this.fd);
        #off
        #on LINUX
        closeRaw(this.fd);
        #off
    }

    public int handle() {
        return this.fd;
    }
}

class tls_client {
    private string host;
    private int port;
    private string caPath;
    private string certPath;
    private int context;

    construct(string host, int port) {
        this.host = host;
        this.port = port;
        this.context = -1;
    }

    public void setCA(string path) { this.caPath = path; }
    public void setCert(string path) { this.certPath = path; }

    public bool connect() {
        #on WINDOWS
        int sock = connectRaw(this.host, this.port);
        if (sock < 0) { return false; }
        this.context = sock;
        return true;
        #off
        #on LINUX
        int sock = connectRaw(this.host, this.port);
        if (sock < 0) { return false; }
        this.context = sock;
        return true;
        #off
        return false;
    }

    public void send(string data) {
        #on WINDOWS
        sendRaw(this.context, data);
        #off
        #on LINUX
        sendRaw(this.context, data);
        #off
    }

    public string receive() {
        #on WINDOWS
        return recvRaw(this.context, 8192);
        #off
        #on LINUX
        return recvRaw(this.context, 8192);
        #off
        return "";
    }

    public void close() {
        #on WINDOWS
        closeRaw(this.context);
        #off
        #on LINUX
        closeRaw(this.context);
        #off
    }
}

// Public API: connects to host:port and returns a socket object (null on
// failure). host is a dotted IPv4 string (inet_addr parses it).
public socket connect(string host, int port) {
    #on WINDOWS
    int sock = connectRaw(host, port);
    if (sock < 0) { return null; }
    return new socket(sock);
    #off
    #on LINUX
    int sock = connectRaw(host, port);
    if (sock < 0) { return null; }
    return new socket(sock);
    #off
    return null;
}

// Public API: binds INADDR_ANY:port, listens (backlog 10) and returns a
// listener object (null on failure).
public listener listen(int port) {
    #on WINDOWS
    int sock = listenRaw(port);
    if (sock < 0) { return null; }
    return new listener(sock);
    #off
    #on LINUX
    int sock = listenRaw(port);
    if (sock < 0) { return null; }
    return new listener(sock);
    #off
    return null;
}

// ---- raw-handle primitives (protocol modules build on these) -------------
// They take/return raw socket descriptor ints so a protocol module can drive
// a connection without holding net objects. Each is the single home of the
// OS code for its operation: the bodies call the ws2_32 exports bare (reach-
// ability per the header finding) or route through the two private bodies.

// Creates a TCP socket and connects it to host:port. Returns the raw socket
// descriptor, or -1 on failure.
public int connectRaw(string host, int port) {
    #on WINDOWS
    return openTcp(host, port);
    #off
    #on LINUX
    return openTcp(host, port);
    #off
    return -1;
}

// Creates a TCP socket and binds it to INADDR_ANY:port without listening.
// Returns the raw socket descriptor, or -1 on failure.
public int bindRaw(int port) {
    #on WINDOWS
    byte[] wsa = new byte[408];
    WSAStartup(0x0202, wsa);
    int sock = socket(2, 1, 0);
    if (sock < 0) { return -1; }
    int pHi = (port >> 8) & 0xFF;
    int pLo = port & 0xFF;
    int[] sa = new int[2];
    sa[0] = 2 | (pHi << 16) | (pLo << 24);
    sa[1] = 0;
    int b = bind(sock, sa, 16);
    if (b < 0 || b > 2147483647) {
        closesocket(sock);
        return -1;
    }
    return sock;
    #off
    #on LINUX
    int sock = socket(2, 1, 0);
    if (sock < 0) { return -1; }
    int pHi = (port >> 8) & 0xFF;
    int pLo = port & 0xFF;
    int[] sa = new int[2];
    sa[0] = 2 | (pHi << 16) | (pLo << 24);
    sa[1] = 0;
    int b = bind(sock, sa, 16);
    if (b < 0 || b > 2147483647) {
        close(sock);
        return -1;
    }
    return sock;
    #off
    return -1;
}

// Creates a TCP socket, binds it to INADDR_ANY:port and listens (backlog 10).
// Returns the raw listening descriptor, or -1 on failure.
public int listenRaw(int port) {
    #on WINDOWS
    return bindListen(port);
    #off
    #on LINUX
    return bindListen(port);
    #off
    return -1;
}

// Blocks until a client connects to the listening descriptor. Returns the raw
// client descriptor, or -1 on failure.
public int acceptRaw(int fd) {
    #on WINDOWS
    int client = accept(fd, null, null);
    if (client > 2147483647) { client = client - 4294967296; }
    return client;
    #off
    #on LINUX
    int client = accept(fd, null, null);
    if (client > 2147483647) { client = client - 4294967296; }
    return client;
    #off
    return -1;
}

// Sends the string's bytes on the raw descriptor (packed into an int[]
// qword buffer; byte[] must not cross a DLL boundary). No-op on len <= 0.
public void sendRaw(int fd, string data) {
    #on WINDOWS
    int len = data.length;
    if (len <= 0) { return; }
    int slots = (len + 7) / 8;
    int[] packedBuf = new int[slots];
    for (int i = 0; i < len; i++) {
        int b = int(data[i]);
        packedBuf[i / 8] = packedBuf[i / 8] | ((b & 0xFF) << ((i % 8) * 8));
    }
    send(fd, packedBuf, len, 0);
    #off
    #on LINUX
    int len = data.length;
    if (len <= 0) { return; }
    int slots = (len + 7) / 8;
    int[] packedBuf = new int[slots];
    for (int i = 0; i < len; i++) {
        int b = int(data[i]);
        packedBuf[i / 8] = packedBuf[i / 8] | ((b & 0xFF) << ((i % 8) * 8));
    }
    send(fd, packedBuf, len, 0);
    #off
}

// Sends a byte[] payload on the raw descriptor: every byte is packed into an
// int[] qword buffer before the send() call (byte[] must not cross a DLL
// boundary packed -- its slots are qwords; see the MEMORY LAYOUT note above).
// Exists for wire formats whose bytes are produced as byte[] -- e.g. ws
// frames (encodeFrame), which may legitimately contain 0x00 bytes that a
// Silver string cannot carry. No-op on len <= 0.
public void sendBytesRaw(int fd, byte[] data) {
    #on WINDOWS
    int len = data.length;
    if (len <= 0) { return; }
    int slots = (len + 7) / 8;
    int[] packedBuf = new int[slots];
    for (int i = 0; i < len; i++) {
        int b = data[i] & 0xFF;
        packedBuf[i / 8] = packedBuf[i / 8] | (b << ((i % 8) * 8));
    }
    send(fd, packedBuf, len, 0);
    #off
    #on LINUX
    int len = data.length;
    if (len <= 0) { return; }
    int slots = (len + 7) / 8;
    int[] packedBuf = new int[slots];
    for (int i = 0; i < len; i++) {
        int b = data[i] & 0xFF;
        packedBuf[i / 8] = packedBuf[i / 8] | (b << ((i % 8) * 8));
    }
    send(fd, packedBuf, len, 0);
    #off
}

// Length-capped variant of sendRaw: sends the first `len` bytes of `data`
// (clamped to data.length; no-op on len <= 0). Exists for wire shapes that
// send a prefix of a known string -- e.g. ftp's server greeting, which
// writes the first 20 of its 22 bytes ("220 FTP Server ready" without the
// CRLF).
public void sendRawLen(int fd, string data, int len) {
    #on WINDOWS
    if (len <= 0) { return; }
    if (len > data.length) { len = data.length; }
    int slots = (len + 7) / 8;
    int[] packedBuf = new int[slots];
    for (int i = 0; i < len; i++) {
        int b = int(data[i]);
        packedBuf[i / 8] = packedBuf[i / 8] | ((b & 0xFF) << ((i % 8) * 8));
    }
    send(fd, packedBuf, len, 0);
    #off
    #on LINUX
    if (len <= 0) { return; }
    if (len > data.length) { len = data.length; }
    int slots = (len + 7) / 8;
    int[] packedBuf = new int[slots];
    for (int i = 0; i < len; i++) {
        int b = int(data[i]);
        packedBuf[i / 8] = packedBuf[i / 8] | ((b & 0xFF) << ((i % 8) * 8));
    }
    send(fd, packedBuf, len, 0);
    #off
}

// Receives up to maxLen bytes from the raw descriptor and returns them as a
// string ("" on error or clean close).
public string recvRaw(int fd, int maxLen) {
    #on WINDOWS
    if (maxLen <= 0) { return ""; }
    int slots = (maxLen + 7) / 8;
    int[] buf = new int[slots];
    int n = recv(fd, buf, maxLen, 0);
    if (n > 2147483647) { n = n - 4294967296; }
    if (n <= 0) { return ""; }
    string result = "";
    for (int i = 0; i < n; i++) {
        int b = (buf[i / 8] >> ((i % 8) * 8)) & 0xFF;
        char c = char(b);
        result += c.toString();
    }
    return result;
    #off
    #on LINUX
    if (maxLen <= 0) { return ""; }
    int slots = (maxLen + 7) / 8;
    int[] buf = new int[slots];
    int n = recv(fd, buf, maxLen, 0);
    if (n > 2147483647) { n = n - 4294967296; }
    if (n <= 0) { return ""; }
    string result = "";
    for (int i = 0; i < n; i++) {
        int b = (buf[i / 8] >> ((i % 8) * 8)) & 0xFF;
        char c = char(b);
        result += c.toString();
    }
    return result;
    #off
    return "";
}

// Closes the raw descriptor.
public void closeRaw(int fd) {
    #on WINDOWS
    closesocket(fd);
    #off
    #on LINUX
    close(fd);
    #off
}

// Arms a receive timeout on the raw descriptor: subsequent recvRaw calls on
// it give up after `ms` milliseconds of silence and return "" instead of
// blocking forever (SO_RCVTIMEO: SOL_SOCKET 0xFFFF, SO_RCVTIMEO 0x1006, the
// millisecond value as a DWORD in the low half of one int[] qword slot).
// Protocol modules (ftp, ftps, ...) arm this on every socket they open so a
// silent peer cannot hang a bounded read loop. The setsockopt result is
// ignored (matching the protocol modules' posture).
public void setRecvTimeoutRaw(int fd, int ms) {
    #on WINDOWS
    int[] opt = new int[1];
    opt[0] = ms;
    setsockopt(fd, 0xFFFF, 0x1006, opt, 4);
    #off
    #on LINUX
    int[] opt = new int[2];
    opt[0] = ms / 1000;
    opt[1] = (ms % 1000) * 1000;
    setsockopt(fd, 1, 21, opt, 16);
    #off
}

// ---- module-private Windows bodies ----------------------------------------
// openTcp/bindListen hold the shared WSAStartup + socket-creation sequences
// for connectRaw/listenRaw. Resolution prefers the DLL export inside regions
// whenever no user declaration accepts the argument count (true on both
// compilers), so the bare connect(sock, sa, 16) / listen(sock, 10) calls
// below reach ws2_32 while the module's public connect(string, int) /
// listen(int) keep winning their own matching arities.

// WSAStartup + socket() + inet_addr + connect: returns the connected raw
// descriptor, or -1 on failure.
int openTcp(string host, int port) {
    #on WINDOWS
    byte[] wsa = new byte[408];
    WSAStartup(0x0202, wsa);
    int sock = socket(2, 1, 0);
    if (sock < 0) { return -1; }
    int ip = inet_addr(host);
    if (ip < 0 || ip > 2147483647) { closesocket(sock); return -1; }
    int pHi = (port >> 8) & 0xFF;
    int pLo = port & 0xFF;
    int[] sa = new int[2];
    sa[0] = 2 | (pHi << 16) | (pLo << 24) | ((ip & 0xFFFFFFFF) << 32);
    sa[1] = 0;
    int c = connect(sock, sa, 16);
    if (c < 0 || c > 2147483647) {
        closesocket(sock);
        return -1;
    }
    return sock;
    #off
    #on LINUX
    int sock = socket(2, 1, 0);
    if (sock < 0) { return -1; }
    int ip = parseDotted(host);
    if (ip < 0) { close(sock); return -1; }
    int pHi = (port >> 8) & 0xFF;
    int pLo = port & 0xFF;
    int[] sa = new int[2];
    sa[0] = 2 | (pHi << 16) | (pLo << 24) | ((ip & 0xFFFFFFFF) << 32);
    sa[1] = 0;
    int c = connect(sock, sa, 16);
    if (c < 0 || c > 2147483647) {
        close(sock);
        return -1;
    }
    return sock;
    #off
    return -1;
}

// WSAStartup + socket() + bind + listen(10): returns the listening raw
// descriptor, or -1 on failure.
int bindListen(int port) {
    #on WINDOWS
    byte[] wsa = new byte[408];
    WSAStartup(0x0202, wsa);
    int sock = socket(2, 1, 0);
    if (sock < 0) { return -1; }
    int pHi = (port >> 8) & 0xFF;
    int pLo = port & 0xFF;
    int[] sa = new int[2];
    sa[0] = 2 | (pHi << 16) | (pLo << 24);
    sa[1] = 0;
    int b = bind(sock, sa, 16);
    if (b < 0 || b > 2147483647) {
        closesocket(sock);
        return -1;
    }
    int l = listen(sock, 10);
    if (l < 0 || l > 2147483647) {
        closesocket(sock);
        return -1;
    }
    return sock;
    #off
    #on LINUX
    int sock = socket(2, 1, 0);
    if (sock < 0) { return -1; }
    int pHi = (port >> 8) & 0xFF;
    int pLo = port & 0xFF;
    int[] sa = new int[2];
    sa[0] = 2 | (pHi << 16) | (pLo << 24);
    sa[1] = 0;
    int b = bind(sock, sa, 16);
    if (b < 0 || b > 2147483647) {
        close(sock);
        return -1;
    }
    int l = listen(sock, 10);
    if (l < 0 || l > 2147483647) {
        close(sock);
        return -1;
    }
    return sock;
    #off
    return -1;
}

// ---- name resolution -------------------------------------------------------
// net is the socket AND name-resolution core: getaddrinfo is a ws2_32 call,
// so it lives here. Resolves `host` to its IPv4 dotted-quad addresses (the
// AF_INET hint means every returned node is a sockaddr_in; family defaults
// to 2 = AF_INET). Returns [] on any failure -- the shape a failing
// getaddrinfo produces.
//
// NAME-COLLISION FINDING: the dns module also exports a public
// one-argument `lookup(string)` and cross-module call dispatch is by BARE
// NAME + arity (the LAST declaration accepting the argument count wins,
// silverc-rs codegen.rs resolve_overload_symbol / self-host mini_cg.sr
// selectOverloadIdx -- module-qualified calls lose their qualifier). A
// same-name same-arity net.lookup(string) would therefore be UNREACHABLE
// from dns.sr: its own declaration would intercept every one-argument call
// and recurse forever. The trailing defaulted `family` parameter keeps the
// prescribed one-argument call shape (`net.lookup("host")`) for every other
// caller while giving dns.sr the two-argument call shape `net.lookup(host,
// 2)` that only this declaration accepts. Family is the getaddrinfo
// ai_family hint field (runtime shift into the high dword of hints qword 0;
// the constant-fold of `2 << 32` is unproven on the self-host, runtime
// shifts by 32 are the probed sockaddr idiom).
public string[] lookup(string host, int family = 2) {
    #on WINDOWS
    byte[] wsa = new byte[408];
    WSAStartup(0x0202, wsa);
    int[] hints = new int[6];
    hints[0] = family << 32;
    hints[1] = 1;
    int[] res = new int[1];
    int ret = getaddrinfo(host, null, hints, res);
    if (ret != 0) { string[] empty = []; return empty; }
    string[] addresses = [];
    int node = res[0];
    while (node != 0) {
        int[] nodeBuf = new int[6];
        memcpy(nodeBuf, node, 48);
        int saPtr = nodeBuf[4];
        int next = nodeBuf[5];
        if (saPtr != 0) {
            int[] sa = new int[2];
            memcpy(sa, saPtr, 16);
            int ip = (sa[0] >> 32) & 0xFFFFFFFF;
            string ipStr = ((ip >> 0) & 0xFF) + "." + ((ip >> 8) & 0xFF) + "." + ((ip >> 16) & 0xFF) + "." + ((ip >> 24) & 0xFF);
            addresses.push(ipStr);
        }
        node = next;
    }
    freeaddrinfo(res[0]);
    return addresses;
    #off
    #on LINUX
    int[] hints = new int[6];
    hints[0] = family << 32;
    hints[1] = 1;
    int[] res = new int[1];
    int ret = getaddrinfo(host, null, hints, res);
    if (ret != 0) { string[] empty = []; return empty; }
    string[] addresses = [];
    int node = res[0];
    while (node != 0) {
        int[] nodeBuf = new int[6];
        memcpy(nodeBuf, node, 48);
        int saPtr = nodeBuf[3];
        int next = nodeBuf[5];
        if (saPtr != 0) {
            int[] sa = new int[2];
            memcpy(sa, saPtr, 16);
            int ip = (sa[0] >> 32) & 0xFFFFFFFF;
            string ipStr = ((ip >> 0) & 0xFF) + "." + ((ip >> 8) & 0xFF) + "." + ((ip >> 16) & 0xFF) + "." + ((ip >> 24) & 0xFF);
            addresses.push(ipStr);
        }
        node = next;
    }
    freeaddrinfo(res[0]);
    return addresses;
    #off
    string[] empty = [];
    return empty;
}

// Pure-Silver dotted-quad parse ("a.b.c.d" -> network-order u32, the
// inet_addr contract: the first octet lands in the LOWEST byte, so the
// << 32 pack drops the wire order straight into the sockaddr; -1 on
// malformed input). Ungated: no OS code.
int parseDotted(string host) {
    int ip = 0;
    int mult = 1;
    int start = 0;
    for (int part = 0; part < 4; part++) {
        string tail = host.substr(start, host.length() - start);
        int rel = tail.indexOf(".");
        int end = host.length();
        if (rel >= 0) { end = start + rel; }
        if (part == 3 && rel >= 0) { return -1; }
        if (part < 3 && rel < 0) { return -1; }
        string piece = host.substr(start, end - start);
        if (piece.length() == 0) { return -1; }
        int v = 0;
        for (int i = 0; i < piece.length(); i++) {
            char c = piece[i];
            if (c < '0' || c > '9') { return -1; }
            v = v * 10 + (int(c) - 48);
        }
        if (v > 255) { return -1; }
        ip = ip + v * mult;
        mult = mult * 256;
        start = end + 1;
    }
    return ip;
}
