mod export sqlite;

class row {
    private kvp<string, string> data;

    construct() { }

    public string get(string name) { return this.data.get(name); }
}

class result {
    private row[] rows;

    construct() { }
}

class statement {
    private string sql;
    private connection conn;

    construct(string sql, connection conn) {
        this.sql = sql;
        this.conn = conn;
    }

    public void execute(object[] params) {
        this.conn.execute(this.sql);
    }
}

class connection {
    private string path;

    construct(string path) { this.path = path; }

    public void execute(string sql) {
        SQLite3Exec(this.path, sql);
    }

    public result query(string sql) {
        return new result();
    }

    public statement prepare(string sql) {
        return new statement(sql, this);
    }

    public void transaction(void callback()) {
        this.execute("BEGIN");
        callback();
        this.execute("COMMIT");
    }

    public void close() { }
}

public connection open(string path) {
    return new connection(path);
}
