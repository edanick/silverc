mod export sqlite;

// DOCS -- public `sqlite` module. A PURE-Silver storage module: there is NO
// SQLite bridge here -- no wire protocol, no file-format reader, no DLL
// bridge (a real SQLite bridge means either sqlite3.dll FFI or the SQLite
// file format; that is a separate feature ticket).
//
// SCOPE: open() wraps the path in a connection (the (path, sql) shapes flow
// through connection/statement). execute() is a silent no-op; query()
// returns an empty result (rows stay empty -- there is no row framing to
// fill them with, so hasNext-less result.get is unreachable by
// construction); transaction() runs BEGIN/COMMIT execute() calls around
// the callback -- two no-ops around the callback, which still runs (the
// callback side-effect contract holds). close() is a no-op. Against a
// real SQLite file nothing happens and nothing crashes.
//
// STORAGE SHAPE: row's storage is two parallel `= []`-initialized string[]
// arrays (std/sql.sr row / std/mongo.sr doc precedent), with set()/has()
// alongside get() (the mongo.sr posture) so the class is usable by a
// future bridge; result's rows field is `= []`-initialized in construct().
//
// PUBLIC API: class row -- construct(), get(string) -> string,
// set(string, string), has(string); class result -- construct(); class
// statement -- construct(string, connection), execute(object[]); class
// connection -- construct(string), execute(string), query(string) ->
// result, prepare(string) -> statement, transaction(void () callback),
// close(); free function open(string) -> connection. The transaction
// fn-parameter is zero-arg, so handlers needing payload must reach it
// through outer scope/module state the same way graphql/http_server
// handlers do.
//
// DISPATCH: `sqlite` is builtin-reserved on NEITHER compiler --
// silverc-rs's builtin_modules_set (src/main.rs:81 lists fs/json/yaml/env/
// url/hash/path/bom/console/math/http only) and the self-hosted compiler's
// visBuiltinModule both exclude it, and the module is excluded from the
// compiler's own aggregate build (silverc.srp). Both compilers resolve
// `import * from sqlite;` as an ORDINARY SOURCE module from disk; no
// native dispatch exists, so there is no per-compiler call interception.

class row {
    // Storage is two parallel `= []`-initialized string[] arrays (the
    // sql.sr row / mongo.sr doc precedent), initialized in construct.
    private string[] names;
    private string[] values;

    construct() {
        this.names = [];
        this.values = [];
    }

    // Stores `value` under `name` (overwriting an existing entry) so
    // get()/has() are meaningful for a future bridge.
    public void set(string name, string value) {
        for (int i = 0; i < this.names.length; i++) {
            if (this.names[i] == name) {
                this.values[i] = value;
                return;
            }
        }
        this.names.push(name);
        this.values.push(value);
    }

    // The value stored under `name`, or null when absent (the kvp.get
    // contract -- sql.sr row keeps the same contract). On this build rows
    // are never populated (no bridge exists), so every get() returns null;
    // the parallel-array implementation exists so a future bridge can fill
    // rows without an API change.
    public string get(string name) {
        for (int i = 0; i < this.names.length; i++) {
            if (this.names[i] == name) {
                return this.values[i];
            }
        }
        return null;
    }

    // True when `name` is present (get returns null for absent names, so
    // has() is the non-null check callers want -- the sql.sr row posture).
    public bool has(string name) {
        for (int i = 0; i < this.names.length; i++) {
            if (this.names[i] == name) {
                return true;
            }
        }
        return false;
    }
}

class result {
    private row[] rows;

    construct() {
        this.rows = [];
    }
}

class statement {
    private string sql;
    private connection conn;

    construct(string sql, connection conn) {
        this.sql = sql;
        this.conn = conn;
    }

    // Delegates to this.conn.execute(this.sql); `params` remain
    // carried-unused (execute() is a no-op -- see SCOPE above).
    public void execute(object[] params) {
        this.conn.execute(this.sql);
    }
}

class connection {
    private string path;

    construct(string path) {
        this.path = path;
    }

    // No-op: no SQLite bridge exists to hand the statement to.
    public void execute(string sql) { }

    // Returns an empty result: rows stay EMPTY -- there is no bridge to
    // produce rows, so reading them is unreachable by construction.
    public result query(string sql) {
        return new result();
    }

    public statement prepare(string sql) {
        return new statement(sql, this);
    }

    // The zero-arg `void () callback` spelling (the DOCS/259 form, the
    // graphql.sr precedent). Behavior on this build: BEGIN and COMMIT are
    // no-op execute() calls; the callback still runs between them, so the
    // caller's side effects happen. There is no ROLLBACK path -- no
    // failure can occur inside the no-op execute() calls.
    public void transaction(void () callback) {
        this.execute("BEGIN");
        callback();
        this.execute("COMMIT");
    }

    // No-op (nothing is held open).
    public void close() { }
}

public connection open(string path) {
    return new connection(path);
}
