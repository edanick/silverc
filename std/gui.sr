// ---------------------------------------------------------------------------
// gui - native Win32 window class for the self-hosted Silver compiler.
//
// The universal gui module -- one module, one OS layer (gui ->
// win32.user32 + win32.kernel32). The user32 calls
// (RegisterClassExA is NOT needed -- the pre-registered "STATIC" window class
// is used instead -- CreateWindowExA, GetSystemMetrics, SetWindowTextA,
// LoadImageA, SendMessageA, ShowWindow, UpdateWindow, DestroyWindow) plus
// kernel32's GetModuleHandleA live inline in the `#on WINDOWS` regions of
// the Window class methods that need them, one unified method per
// operation, no wrapper indirection, no alias imports; OS selection is
// compile-time via the preprocessor regions, so the runtime `os.type` check
// is not used here and no `import * from os;` is needed.
//
// For a future non-Windows backend the fallback follows the module's handle
// contract: the constructor never creates a window, so `handle` stays 0,
// which every state-changing method below already guards on (no DLL touch,
// no crash); show/hide still maintain the `visible` flag and
// setTitle/setIcon still record the requested title/icon string, so the
// class behaves as a headless window record. The pure getters (getName,
// getTitle, getWidth, getHeight, getHandle, isVisible, getIcon) are
// field-only and stay ungated.
//
// NATIVE-BRIDGE NOTE (per compiler): the bare
// guiCreateWindow/guiShow/guiHide/guiMaximize/guiMinimize/guiSetTitle/
// guiClose/guiRunLoop/guiSetIcon/loadIcon names are native-intercepted on
// BOTH compilers -- silverc-rs emits the real user32 sequences
// (src/codegen.rs, stdlib/gui.rs), the self-hosted compiler routes them to
// deterministic stubs in mini_cg.sr -- so they are kept ungated here: they
// never collide with any win32 export and any future call site lowers the
// same way on both backends.
//
// BEHAVIOR: each `#on WINDOWS` region carries the full raw-OS sequence for
// its method:
//   - the constructor centers the window on the primary display via
//     GetSystemMetrics(SM_CXSCREEN/SM_CYSCREEN) and creates it with
//     CreateWindowExA + WS_OVERLAPPEDWINDOW (0x00CF0000) on the
//     pre-registered "STATIC" class, so no RegisterClassExA + WndProc is
//     needed for a simple window; `handle` becomes the HWND (0 on failure).
//   - setIcon loads the .ico via LoadImageA(LR_LOADFROMFILE |
//     LR_DEFAULTSIZE = 0x50, IMAGE_ICON = 1) and only when that succeeded
//     attaches it with SendMessageA(WM_SETICON = 0x80) for both ICON_BIG
//     (1) and ICON_SMALL (0).
//   - show() is ShowWindow(SW_SHOW = 5) followed by UpdateWindow so the
//     client area paints immediately; hide() is ShowWindow(SW_HIDE = 0);
//     close() is DestroyWindow.
// The handle!=0 guards stay in the methods; the regions trust their caller.
//
// TESTING NOTE: no method here pumps messages (this module has no run
// loop), so constructing + showing + closing a Window never blocks and is
// probe-safe; SetWindowTextA/LoadImageA/SendMessageA only fire on a live
// handle. No screen-metrics function is exposed publicly --
// GetSystemMetrics is constructor-internal (centering) only.
// ---------------------------------------------------------------------------

mod export gui;

#on WINDOWS
import * from win32.user32;
import * from win32.kernel32;
#off

class Window {
    private string name;
    private string title;
    private int width;
    private int height;
    private int handle;
    private bool visible;
    private string icon;

    construct(string name, string title, int width, int height) {
        this.name = name;
        this.title = title;
        this.width = width;
        this.height = height;
        this.handle = 0;
        this.visible = false;
        this.icon = "";

        #on WINDOWS
        int hinst = GetModuleHandleA(0);
        int x = (GetSystemMetrics(0) - width) / 2;
        int y = (GetSystemMetrics(1) - height) / 2;
        if (x < 0) { x = 0; }
        if (y < 0) { y = 0; }
        this.handle = CreateWindowExA(0, "STATIC", title, 0x00CF0000, x, y, width, height, 0, 0, hinst, 0);
        #off
        // Non-Windows fallback: no window-system backend yet, `handle`
        // stays 0 ("no window") and every method below guards on it.
    }

    public string getName() { return this.name; }
    public string getTitle() { return this.title; }
    public int getWidth() { return this.width; }
    public int getHeight() { return this.height; }
    public int getHandle() { return this.handle; }
    public bool isVisible() { return this.visible; }

    public void setTitle(string t) {
        this.title = t;
        if (this.handle != 0) {
            #on WINDOWS
            SetWindowTextA(this.handle, t);
            #off
        }
    }

    // Load a custom .ico asset and attach it as the window icon via
    // user32!LoadImageA (LR_LOADFROMFILE) + SendMessageA(WM_SETICON).
    public void setIcon(string path) {
        this.icon = path;
        if (this.handle != 0) {
            #on WINDOWS
            int hicon = LoadImageA(0, path, 1, 0, 0, 0x50);
            if (hicon != 0) {
                SendMessageA(this.handle, 0x80, 1, hicon); // ICON_BIG
                SendMessageA(this.handle, 0x80, 0, hicon); // ICON_SMALL
            }
            #off
        }
    }

    public string getIcon() { return this.icon; }

    public void show() {
        if (this.handle != 0) {
            #on WINDOWS
            ShowWindow(this.handle, 5); // SW_SHOW
            UpdateWindow(this.handle);
            #off
        }
        this.visible = true;
    }

    public void hide() {
        if (this.handle != 0) {
            #on WINDOWS
            ShowWindow(this.handle, 0); // SW_HIDE
            #off
        }
        this.visible = false;
    }

    public void close() {
        if (this.handle != 0) {
            #on WINDOWS
            DestroyWindow(this.handle);
            #off
        }
        this.handle = 0;
        this.visible = false;
    }
}
