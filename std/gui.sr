mod export gui;

class Color {
    public int r;
    public int g;
    public int b;
    public int a;

    construct() { this.r = 0; this.g = 0; this.b = 0; this.a = 255; }
    construct(int r, int g, int b) {
        this.r = r; this.g = g; this.b = b; this.a = 255;
    }

    public static Color White = new Color(255, 255, 255);
    public static Color Black = new Color(0, 0, 0);
}

class buttonStyle {
    public Color backgroundColor;
    public Color hoverColor;
    public Color pressedColor;
    public Color textColor;
    public int borderRadius;
    public Color borderColor;
    public int borderWidth;
    public int fontSize;
}

class checkboxStyle {
    public Color checkColor;
    public Color uncheckedBorderColor;
    public Color textColor;
    public int fontSize;
    public int checkmarkSize;
}

class imageStyle {
    public int borderRadius;
    public Color borderColor;
    public int borderWidth;
}

class labelStyle {
    public int fontSize;
    public Color textColor;
    public bool bold;
}

class canvas {
    public void clear(Color c) { }
    public void fillRoundedRect(int x, int y, int w, int h, int r, Color c) { }
    public void drawText(string text, int x, int y, Color c, int size, string weight) { }
}

class button {
    private string text;

    construct(string text) { this.text = text; }
    public void setPosition(int x, int y) { }
    public void setSize(int w, int h) { }
    public void setStyle(buttonStyle s) { }
    public void onClick(void callback()) { }
}

class checkbox {
    private string label;

    construct(string label) { this.label = label; }
    public void setPosition(int x, int y) { }
    public void setSize(int w, int h) { }
    public void setStyle(checkboxStyle s) { }
    public void onChange(void callback(bool state)) { }
}

class image {
    construct(string path) { }
    public void setPosition(int x, int y) { }
    public void setSize(int w, int h) { }
    public void setStyle(imageStyle s) { }
}

class label {
    private string text;

    construct(string text) { this.text = text; }
    public void setPosition(int x, int y) { }
    public void setStyle(labelStyle s) { }
}

class window {
    public void setBackground(Color c) { }
    public void onDraw(void callback(canvas)) { }
    public void add(button b) { }
    public void add(checkbox c) { }
    public void add(image i) { }
    public void add(label l) { }
    public void show() { }

    construct(application app, string title, int w, int h) {
        HWND hwnd = CreateWindowEx(0, "STATIC", title, 0x10000000, 0, 0, w, h, null, null, null, null);
        ShowWindow(hwnd, 1);
    }
}

class application {
    public void run() {
        MSG msg;
        while (GetMessage(&msg, null, 0, 0)) {
            TranslateMessage(&msg);
            DispatchMessage(&msg);
        }
    }
}
