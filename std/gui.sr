import * from win32.kernel32;
import * from win32.user32;

mod export gui;

// DOCS/248 -- Window GUI (self-hosted backend).
//
// The `Window` class creates a native Win32 window through user32.dll:
// CreateWindowExA / ShowWindow / UpdateWindow / SetWindowTextA /
// DestroyWindow, centered on the primary display via GetSystemMetrics.
//
//     Window w = new Window("main", "Silver App", 400, 400);
//     w.show();
//     w.setTitle("Updated title");
//     w.close();
//
// `handle` is the opaque native HWND (0 when the window has not been created
// or has been closed).

class Window {
    private string name;
    private string title;
    private int width;
    private int height;
    private int handle;
    private bool visible;
    private string icon;

    construct(string name, string title, int width, int height) {
        this.name = name;
        this.title = title;
        this.width = width;
        this.height = height;
        this.handle = 0;
        this.visible = false;
        this.icon = "";

        int hinst = GetModuleHandleA(0);
        int x = (GetSystemMetrics(0) - width) / 2;
        int y = (GetSystemMetrics(1) - height) / 2;
        if (x < 0) { x = 0; }
        if (y < 0) { y = 0; }
        // WS_OVERLAPPEDWINDOW = 0x00CF0000, with the pre-registered "STATIC"
        // class so we do not need RegisterClassExA + a WndProc for a simple
        // window.
        this.handle = CreateWindowExA(0, "STATIC", title, 0x00CF0000, x, y, width, height, 0, 0, hinst, 0);
    }

    public string getName() { return this.name; }
    public string getTitle() { return this.title; }
    public int getWidth() { return this.width; }
    public int getHeight() { return this.height; }
    public int getHandle() { return this.handle; }
    public bool isVisible() { return this.visible; }

    public void setTitle(string t) {
        this.title = t;
        if (this.handle != 0) { SetWindowTextA(this.handle, t); }
    }

    // Load a custom .ico asset and attach it as the window icon via
    // user32!LoadImageA (LR_LOADFROMFILE) + SendMessageA(WM_SETICON).
    public void setIcon(string path) {
        this.icon = path;
        if (this.handle != 0) {
            int hicon = LoadImageA(0, path, 1, 0, 0, 0x50);
            if (hicon != 0) {
                SendMessageA(this.handle, 0x80, 1, hicon); // ICON_BIG
                SendMessageA(this.handle, 0x80, 0, hicon); // ICON_SMALL
            }
        }
    }

    public string getIcon() { return this.icon; }

    public void show() {
        if (this.handle != 0) {
            ShowWindow(this.handle, 5);   // SW_SHOW
            UpdateWindow(this.handle);
        }
        this.visible = true;
    }

    public void hide() {
        if (this.handle != 0) { ShowWindow(this.handle, 0); } // SW_HIDE
        this.visible = false;
    }

    public void close() {
        if (this.handle != 0) { DestroyWindow(this.handle); }
        this.handle = 0;
        this.visible = false;
    }
}
