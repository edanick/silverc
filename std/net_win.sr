import { socket as rawSocket, connect as rawConnect, listen as rawListen, bind, accept, recv, send, closesocket, inet_addr, WSAStartup } from win32.ws2_32;

internal mod export net_win;

// DOCS -- INTERNAL Windows backend of the public `net` module
// (UNIFIED_CORE_LIBRARY.md phase 2). Every ws2_32 DLL call the net module
// needs lives here and nowhere else: the public wrapper (std/net.sr) contains
// zero win32 imports and reaches this code only behind the OS gate
// `if (osType() == OSTypes.WINDOWS)` (see std/os.sr for why the gate calls
// the plain-Silver osType() stand-in instead of the native os.type query).
//
// Everything in this file is project-internal: the `internal mod export`
// marker plus `internal` on every function keep the backend from leaking to
// user projects. A user file that tries `import * from net_win;` fails with
// the standard internal-visibility error.
//
// WINSOCK IMPORT ALIASING: the class `socket` and the free functions
// `connect`/`listen` that the public net API exports share their names with
// ws2_32 exports. In one flat compile namespace a user-defined symbol wins
// resolution over a DLL export, so the raw calls below reach the DLL through
// `X as Y` import aliases (`socket as rawSocket`, ...). Code that must call
// the DLL exports under their real names can never coexist with the public
// net API -- every std module that wraps a ws2_32 name must alias the same
// way.
//
// MEMORY LAYOUT (silverc-rs codegen): Silver arrays are [cap, len, elem...]
// with 8-byte elements and a variable holding the element-0 address, so an
// int[] doubles as a packed qword buffer for DLL calls. `sockaddr_in` (16
// bytes: family u16, port u16 big-endian, IPv4 u32, 8 zero bytes) is packed
// into one int[2]: qword 0 = family | port<<16 | addr<<32, qword 1 = 0.
// `byte[]` must NOT cross a DLL boundary as a packed buffer -- its slots are
// qwords -- so receive() unpacks recv's bytes out of an int[] with shifts and
// send() packs the payload into an int[] the same way. Strings ARE packed
// byte buffers: data[i] reads one byte.
//
// WSAStartup: the pre-split net.sr never called it (winsock stays
// uninitialized and every socket() fails with -1); it is initialized before
// each socket creation. WSAStartup is reference-counted, so the repeated
// calls are harmless.
//
// tls_client: the pre-split class called EncryptMessage/DecryptMessage, which
// exist in no compiler DLL table (the class never compiled). Its connect()
// opened a plain TCP socket and stored it as the context, so that de-facto
// behavior is preserved by routing tls traffic through the same raw
// netWinSend/netWinReceive/netWinClose primitives. data.toBytes() in the old
// sources was likewise a phantom: no such builtin exists in either compiler.

internal int netWinStartup() {
    byte[] wsa = new byte[408];
    return WSAStartup(0x0202, wsa);
}

// Packs family/port/addr into the sockaddr_in image (two qwords). `ip` is the
// network-order u32 that inet_addr returns; 0 means INADDR_ANY.
internal void netWinFillSockaddr(int[] sa, int port, int ip) {
    int pHi = (port >> 8) & 0xFF;
    int pLo = port & 0xFF;
    sa[0] = 2 | (pHi << 16) | (pLo << 24) | ((ip & 0xFFFFFFFF) << 32);
    sa[1] = 0;
}

internal int netWinConnect(string host, int port) {
    netWinStartup();
    int sock = rawSocket(2, 1, 0);
    if (sock < 0) { return -1; }
    int ip = inet_addr(host);
    int[] sa = new int[2];
    netWinFillSockaddr(sa, port, ip);
    if (rawConnect(sock, sa, 16) < 0) {
        closesocket(sock);
        return -1;
    }
    return sock;
}

internal int netWinListen(int port) {
    netWinStartup();
    int sock = rawSocket(2, 1, 0);
    if (sock < 0) { return -1; }
    int[] sa = new int[2];
    netWinFillSockaddr(sa, port, 0);
    if (bind(sock, sa, 16) < 0) {
        closesocket(sock);
        return -1;
    }
    rawListen(sock, 10);
    return sock;
}

internal int netWinAccept(int fd) {
    return accept(fd, null, null);
}

internal void netWinSend(int fd, string data) {
    int len = data.length;
    if (len <= 0) { return; }
    int slots = (len + 7) / 8;
    int[] packedBuf = new int[slots];
    for (int i = 0; i < len; i++) {
        int b = int(data[i]);
        packedBuf[i / 8] = packedBuf[i / 8] | ((b & 0xFF) << ((i % 8) * 8));
    }
    send(fd, packedBuf, len, 0);
}

internal string netWinReceive(int fd, int maxLen) {
    if (maxLen <= 0) { return ""; }
    int slots = (maxLen + 7) / 8;
    int[] buf = new int[slots];
    int n = recv(fd, buf, maxLen, 0);
    if (n <= 0) { return ""; }
    string result = "";
    for (int i = 0; i < n; i++) {
        int b = (buf[i / 8] >> ((i % 8) * 8)) & 0xFF;
        char c = char(b);
        result += c.toString();
    }
    return result;
}

internal void netWinClose(int fd) {
    closesocket(fd);
}

