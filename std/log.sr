mod export log;
import {stringify} from json;
import {writeString} from fs;

public const int TRACE = 0;
public const int DEBUG = 1;
public const int INFO = 2;
public const int WARN = 3;
public const int ERROR = 4;

private int currentLevel = 2;
private string currentFormat = "[${level}] ${message}";
private string logFile = "";
private bool useFile = false;

private string levelName(int level) {
    if (level == 0) { return "TRACE"; }
    if (level == 1) { return "DEBUG"; }
    if (level == 2) { return "INFO"; }
    if (level == 3) { return "WARN"; }
    if (level == 4) { return "ERROR"; }
    return "UNKNOWN";
}

private void writeLog(int level, string message, object data) {
    if (level < currentLevel) { return; }
    string line = currentFormat.replace("${level}", levelName(level)).replace("${message}", message);
    if (data != null) {
        line += " " + json.stringify(data);
    }
    if (useFile) {
        fs.writeString(logFile, line + "\n");
    } else {
        printline(line);
    }
}

public void setLevel(int level) { currentLevel = level; }
public void setFormat(string fmt) { currentFormat = fmt; }

public void trace(string msg) { writeLog(TRACE, msg, null); }
public void debug(string msg) { writeLog(DEBUG, msg, null); }
public void info(string msg) { writeLog(INFO, msg, null); }
public void info(string msg, object data) { writeLog(INFO, msg, data); }
public void warn(string msg) { writeLog(WARN, msg, null); }
public void error(string msg) { writeLog(ERROR, msg, null); }
public void error(string msg, exception ex) { writeLog(ERROR, msg + ": " + ex.message, null); }

public void toFile(string path) {
    logFile = path;
    useFile = true;
}
