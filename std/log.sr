mod export log;
import {stringify} from json;
import {writeString} from fs;
import {Exception} from exception;

public const int TRACE = 0;
public const int DEBUG = 1;
public const int INFO = 2;
public const int WARN = 3;
public const int ERROR = 4;

class LogState {
    public int level;
    public string format;
    public string file;
    public bool useFile;

    construct {
        this.level = 2;
        this.format = "[${level}] ${message}";
        this.file = "";
        this.useFile = false;
    }
}

private LogState state = new LogState();

private string levelName(int level) {
    if (level == 0) { return "TRACE"; }
    if (level == 1) { return "DEBUG"; }
    if (level == 2) { return "INFO"; }
    if (level == 3) { return "WARN"; }
    if (level == 4) { return "ERROR"; }
    return "UNKNOWN";
}

private void writeLog(int level, string message, object data) {
    if (level < state.level) { return; }
    string line = state.format.replace("${level}", levelName(level)).replace("${message}", message);
    if (data != null) {
        line += " " + json.stringify(data);
    }
    if (state.useFile) {
        fs.writeString(state.file, line + "\n");
    } else {
        printline(line);
    }
}

public void setLevel(int level) { state.level = level; }
public void setFormat(string fmt) { state.format = fmt; }

public void trace(string msg) { writeLog(TRACE, msg, null); }
public void debug(string msg) { writeLog(DEBUG, msg, null); }
public void info(string msg) { writeLog(INFO, msg, null); }
public void info(string msg, object data) { writeLog(INFO, msg, data); }
public void warn(string msg) { writeLog(WARN, msg, null); }
public void error(string msg) { writeLog(ERROR, msg, null); }
public void error(string msg, Exception ex) {
    // NOTE (probed on the self-hosted macx64 backend): formulations that
    // rebind a concat involving the cross-module `ex.message` field (inline
    // call argument, or reassignment of a local first bound to it) corrupt
    // the heap and abort in libsystem_malloc on a later allocation. The
    // fresh-local two-step below is stable in small call graphs but still
    // unreliable when surrounded by many other log calls (compiler-level
    // string/field aliasing bug, mini_cg); DOCS/174 therefore logs errors
    // through the one-argument error(msg) overload.
    string message = ex.message;
    string detail = msg + ": " + message;
    writeLog(ERROR, detail, null);
}

public void toFile(string path) {
    state.file = path;
    state.useFile = true;
}
