mod export fs;

// DOCS -- public `fs` module (see UNIFIED_CORE_LIBRARY.md).
// This is the universal file-system module: one module, one OS layer
// (fs -> win32.kernel32). Each raw OS call lives INSIDE its public
// function's body behind a `#on WINDOWS` ... `#off` region -- one unified
// function name, no win-prefixed helpers, no wrapper indirection. There is
// no `#else` and no LINUX/MAC placeholders in std; the non-Windows regions
// get filled on their own machines later. The preprocessor selects the OS
// code at compile time, so `import * from os;` is not needed here (the
// runtime `os.type` check is a user-facing feature). The kernel32 grant is
// a plain `import * from win32.kernel32;`; no kernel32 export name
// (CreateFileA, ReadFile, ...) collides with this module's public API.
//
// FolderOps.list's FindFirstFileA enumeration quirk is intentional, do not
// "fix": the handle-based loop never copies the WIN32_FIND_DATA name, so
// each entry contributes "". Allocations use the codebase-standard idiom
// `byte[] buf = new byte[size];`.
//
// DELEGATION QUIRK (intentional, do not "fix"): FileOps.readString calls
// fs.readString(path). When the self-hosted compiler compiles that name it
// resolves to the compiler's builtin native readString, not to this
// module's own function. The delegation is required: the native path
// allocates a raw byte buffer for ReadFile, while a Silver array header
// passed to Win32 could crash on ordinary instance reads.
//
// LINUX BACKEND (Phase B): open/read/write/close + stat/unlink/renameFile/
// mkdir/opendir+readdir/closedir from linux.libc, mirroring the WINDOWS
// bodies statement-for-statement. The rename grant is aliased
// (`rename as renameFile`): a bare rename(string, string) would resolve to
// this module's own rename/2 (same arity) and recurse forever -- the
// net.sr NAME-COLLISION FINDING; uuid.sr carries the same documented alias
// precedent. Paths use `/` (no drive letters) and are case-sensitive.
// NUL bytes cannot ride string concat (dropped on both backends), so short
// reads and binary tails behave the same here as under ReadFile.
// Times/attrs beyond size are not queried: stat is used for size only
// (st_size, i64 at offset 48 = slot 6 of an int[18]); directory/file kinds
// decode st_mode (u32 at offset 24, low half of slot 3) with S_IFMT/FDIR.
// struct dirent's d_name starts at offset 19 and is copied bounded (256)
// out of libc's static storage into an int[] before the NUL scan.
//
// MAC BACKEND (Phase B, code-only -- MAC.md section 10, UNVALIDATED until
// probed on Mac hardware): same POSIX calls via mac.libsystem, mirroring
// the LINUX bodies statement-for-statement. Deliberate divergences,
// re-derived from macOS headers (never copied from the Linux table):
// - open(2) flags: O_WRONLY|O_CREAT|O_TRUNC = 0x601 on Darwin
//   (0x1|0x200|0x400, <fcntl.h>) vs 0x241 on Linux; mode 0644 = 0x1A4
//   is the same on both.
// - stat is Darwin stat64: st_size is the i64 at byte offset 96 (slot 12
//   of an int[18]), st_mode the u16 at bytes 4-5 (slot 0 high half).
//   S_IFMT/S_IFDIR values match Linux (0xF000/0x4000).
// - struct dirent's d_name starts at offset 21 on Darwin (d_ino 8 +
//   d_seekoff 8 + d_reclen 2 + d_namlen 2 + d_type 1, <dirent.h>) vs 19
//   on Linux; copied bounded (256) the same way.
// - Path normalization rides macNormPath (the fsNormPath duplicate the
//   region style calls for: regions are per-OS, never shared, and
//   fsNormPath lives in a `#on LINUX` region the MAC build never sees).
// - APFS is case-insensitive-but-preserving by default: never assume the
//   case-sensitivity the Linux bodies can rely on (documented, no code).

#on WINDOWS
import * from win32.kernel32;
#on LINUX
import * from linux.libc;
#on MAC
import * from mac.libsystem;
#off
#on LINUX
import { rename as renameFile } from linux.libc;
#on MAC
import { rename as renameFile } from mac.libsystem;
#off

#on LINUX
string fsNormPath(string path) {
    string r = "";
    for (int i = 0; i < path.length; i++) {
        if (path[i] == '\\') { r = r + '/'; }
        else { r = r + path[i]; }
    }
    return r;
}
#off

#on MAC
string macNormPath(string path) {
    string r = "";
    for (int i = 0; i < path.length; i++) {
        if (path[i] == '\\') { r = r + '/'; }
        else { r = r + path[i]; }
    }
    return r;
}
#off

class FileOps {
    construct () {}

    public bool exists(string path) {
        #on WINDOWS
        return GetFileAttributesA(path) != -1;
        #on LINUX
        string npath = fsNormPath(path);
        int fd = open(npath, 0, 0);
        if (fd < 0) { return false; }
        close(fd);
        return true;
        #on MAC
        string npath = macNormPath(path);
        int fd = open(npath, 0, 0);
        if (fd < 0) { return false; }
        close(fd);
        return true;
        #off
        return false;
    }

    public void delete(string path) {
        #on WINDOWS
        DeleteFileA(path);
        #on LINUX
        string npath = fsNormPath(path);
        unlink(npath);
        #on MAC
        string npath = macNormPath(path);
        unlink(npath);
        #off
    }

    public void rename(string oldPath, string newPath) {
        #on WINDOWS
        MoveFileA(oldPath, newPath);
        #on LINUX
        string nold = fsNormPath(oldPath);
        string nnew = fsNormPath(newPath);
        renameFile(nold, nnew);
        #on MAC
        string nold = macNormPath(oldPath);
        string nnew = macNormPath(newPath);
        renameFile(nold, nnew);
        #off
    }

    public string readString(string path) {
        // Keep the instance API in parity with the native fs module. The
        // native path allocates a raw byte buffer for ReadFile; a Silver
        // array header passed to Win32 could crash on ordinary instance
        // reads.
        return fs.readString(path);
    }

    public void write(string path, byte[] data) {
        #on WINDOWS
        int h = CreateFileA(path, 0x40000000, 0, null, 2, 0x80, 0);
        if (h == -1) { return; }
        int wrote = 0;
        WriteFile(h, data, data.length, &wrote, null);
        CloseHandle(h);
        #on LINUX
        string npath = fsNormPath(path);
        int fd = open(npath, 0x241, 0x1A4);
        if (fd < 0) { return; }
        if (data.length > 0) {
            int slots = (data.length + 7) / 8;
            int[] packed = new int[slots];
            for (int i = 0; i < data.length; i++) {
                int b = data[i] & 0xFF;
                packed[i / 8] = packed[i / 8] | (b << ((i % 8) * 8));
            }
            write(fd, packed, data.length);
        }
        close(fd);
        #on MAC
        string npath = macNormPath(path);
        int fd = open(npath, 0x601, 0x1A4);
        if (fd < 0) { return; }
        if (data.length > 0) {
            int slots = (data.length + 7) / 8;
            int[] packed = new int[slots];
            for (int i = 0; i < data.length; i++) {
                int b = data[i] & 0xFF;
                packed[i / 8] = packed[i / 8] | (b << ((i % 8) * 8));
            }
            write(fd, packed, data.length);
        }
        close(fd);
        #off
    }
}

class FolderOps {
    construct () {}

    public string[] list(string path) {
        #on WINDOWS
        string sp = path + "\\*";
        int h = FindFirstFileA(sp, null);
        if (h == -1) { return []; }
        string[] names = [];
        bool cont = true;
        while (cont) {
            string name = "";
            if (name != "." && name != "..") { names.add(name); }
            cont = FindNextFileA(h, null);
        }
        FindClose(h);
        return names;
        #on LINUX
        string npath = fsNormPath(path);
        string[] names = readDirNames(npath);
        return names;
        #on MAC
        string npath = macNormPath(path);
        string[] names = readDirNames(npath);
        return names;
        #off
    }

    public string[] list() << this.list(".");

    public string[] files() {
        #on WINDOWS
        string[] all = this.list();
        string[] result = [];
        foreach (string f in all) {
            if (GetFileAttributesA(f) != 0x10) { result.add(f); }
        }
        return result;
        #else
        string[] all = this.list();
        string[] result = [];
        foreach (string f in all) {
            if (isDirPath(f) == 0) { result.add(f); }
        }
        return result;
        #off
    }

    public string[] folders() {
        #on WINDOWS
        string[] all = this.list();
        string[] result = [];
        foreach (string f in all) {
            if (GetFileAttributesA(f) == 0x10) { result.add(f); }
        }
        return result;
        #else
        string[] all = this.list();
        string[] result = [];
        foreach (string f in all) {
            if (isDirPath(f) != 0) { result.add(f); }
        }
        return result;
        #off
    }

    public string[] entries() << this.list();

    public string[] list(string[] exts) {
        string[] all = this.list();
        string[] result = [];
        foreach (string f in all) {
            foreach (string ext in exts) {
                if (f.endsWith("." + ext)) { result.add(f); break; }
            }
        }
        return result;
    }

    public void create(string path) {
        #on WINDOWS
        CreateDirectoryA(path, null);
        #on LINUX
        string npath = fsNormPath(path);
        mkdir(npath, 493);
        #on MAC
        string npath = macNormPath(path);
        mkdir(npath, 493);
        #off
    }

    public void create(string path, bool ignoreExistence) {
        #on WINDOWS
        CreateDirectoryA(path, null);
        #on LINUX
        string npath = fsNormPath(path);
        mkdir(npath, 493);
        #on MAC
        string npath = macNormPath(path);
        mkdir(npath, 493);
        #off
    }
}

public FileOps file;
public FolderOps folder;

public string readString(string path) {
    #on WINDOWS
    int h = CreateFileA(path, 0x80000000, 3, null, 3, 0x80, 0);
    if (h == -1) { return ""; }
    int size = GetFileSize(h, null);
    byte[] buf = new byte[size];
    int read = 0;
    ReadFile(h, buf, size, &read, null);
    CloseHandle(h);
    string result = "";
    foreach (byte b in buf) { result += char(b); }
    return result;
    #on LINUX
    string npath = fsNormPath(path);
    int fd = open(npath, 0, 0);
    if (fd < 0) { return ""; }
    int64 size = statSize(npath);
    if (size <= 0) { close(fd); return ""; }
    int slots = int((size + 7) / 8);
    int[] buf = new int[slots];
    int n = read(fd, buf, int(size));
    close(fd);
    if (n < 0) { return ""; }
    string result = "";
    for (int i = 0; i < n; i++) {
        int b = (buf[i / 8] >> ((i % 8) * 8)) & 0xFF;
        result += char(b);
    }
    return result;
    #on MAC
    string npath = macNormPath(path);
    int fd = open(npath, 0, 0);
    if (fd < 0) { return ""; }
    int64 size = statSize(npath);
    if (size <= 0) { close(fd); return ""; }
    int slots = int((size + 7) / 8);
    int[] buf = new int[slots];
    int n = read(fd, buf, int(size));
    close(fd);
    if (n < 0) { return ""; }
    string result = "";
    for (int i = 0; i < n; i++) {
        int b = (buf[i / 8] >> ((i % 8) * 8)) & 0xFF;
        result += char(b);
    }
    return result;
    #off
}

public byte[] read(string path) {
    #on WINDOWS
    int h = CreateFileA(path, 0x80000000, 3, null, 3, 0x80, 0);
    if (h == -1) { return []; }
    int size = GetFileSize(h, null);
    byte[] buf = new byte[size];
    int read = 0;
    ReadFile(h, buf, size, &read, null);
    CloseHandle(h);
    return buf;
    #on LINUX
    string npath = fsNormPath(path);
    int fd = open(npath, 0, 0);
    if (fd < 0) { return []; }
    int64 size = statSize(npath);
    if (size <= 0) { close(fd); return []; }
    int slots = int((size + 7) / 8);
    int[] buf = new int[slots];
    int n = read(fd, buf, int(size));
    close(fd);
    if (n < 0) { return []; }
    byte[] out = new byte[n];
    for (int i = 0; i < n; i++) {
        out[i] = (buf[i / 8] >> ((i % 8) * 8)) & 0xFF;
    }
    return out;
    #on MAC
    string npath = macNormPath(path);
    int fd = open(npath, 0, 0);
    if (fd < 0) { return []; }
    int64 size = statSize(npath);
    if (size <= 0) { close(fd); return []; }
    int slots = int((size + 7) / 8);
    int[] buf = new int[slots];
    int n = read(fd, buf, int(size));
    close(fd);
    if (n < 0) { return []; }
    byte[] out = new byte[n];
    for (int i = 0; i < n; i++) {
        out[i] = (buf[i / 8] >> ((i % 8) * 8)) & 0xFF;
    }
    return out;
    #off
}

public void writeString(string path, string content) {
    #on WINDOWS
    int h = CreateFileA(path, 0x40000000, 0, null, 2, 0x80, 0);
    if (h == -1) { return; }
    byte[] buf = content.toBytes();
    int wrote = 0;
    WriteFile(h, buf, buf.length, &wrote, null);
    CloseHandle(h);
    #on LINUX
    string npath = fsNormPath(path);
    int fd = open(npath, 0x241, 0x1A4);
    if (fd < 0) { return; }
    int len = content.length;
    if (len > 0) {
        int slots = (len + 7) / 8;
        int[] packed = new int[slots];
        for (int i = 0; i < len; i++) {
            int b = int(content[i]);
            packed[i / 8] = packed[i / 8] | ((b & 0xFF) << ((i % 8) * 8));
        }
        write(fd, packed, len);
    }
    close(fd);
    #on MAC
    string npath = macNormPath(path);
    int fd = open(npath, 0x601, 0x1A4);
    if (fd < 0) { return; }
    int len = content.length;
    if (len > 0) {
        int slots = (len + 7) / 8;
        int[] packed = new int[slots];
        for (int i = 0; i < len; i++) {
            int b = int(content[i]);
            packed[i / 8] = packed[i / 8] | ((b & 0xFF) << ((i % 8) * 8));
        }
        write(fd, packed, len);
    }
    close(fd);
    #off
}

public void write(string path, byte[] data) {
    #on WINDOWS
    int h = CreateFileA(path, 0x40000000, 0, null, 2, 0x80, 0);
    if (h == -1) { return; }
    int wrote = 0;
    WriteFile(h, data, data.length, &wrote, null);
    CloseHandle(h);
    #on LINUX
    string npath = fsNormPath(path);
    int fd = open(npath, 0x241, 0x1A4);
    if (fd < 0) { return; }
    if (data.length > 0) {
        int slots = (data.length + 7) / 8;
        int[] packed = new int[slots];
        for (int i = 0; i < data.length; i++) {
            int b = data[i] & 0xFF;
            packed[i / 8] = packed[i / 8] | (b << ((i % 8) * 8));
        }
        write(fd, packed, data.length);
    }
    close(fd);
    #on MAC
    string npath = macNormPath(path);
    int fd = open(npath, 0x601, 0x1A4);
    if (fd < 0) { return; }
    if (data.length > 0) {
        int slots = (data.length + 7) / 8;
        int[] packed = new int[slots];
        for (int i = 0; i < data.length; i++) {
            int b = data[i] & 0xFF;
            packed[i / 8] = packed[i / 8] | (b << ((i % 8) * 8));
        }
        write(fd, packed, data.length);
    }
    close(fd);
    #off
}

public bool exists(string path) {
    #on WINDOWS
    return GetFileAttributesA(path) != -1;
    #on LINUX
    string npath = fsNormPath(path);
    int fd = open(npath, 0, 0);
    if (fd < 0) { return false; }
    close(fd);
    return true;
    #on MAC
    string npath = macNormPath(path);
    int fd = open(npath, 0, 0);
    if (fd < 0) { return false; }
    close(fd);
    return true;
    #off
}

public void delete(string path) {
    #on WINDOWS
    DeleteFileA(path);
    #on LINUX
    string npath = fsNormPath(path);
    unlink(npath);
    #on MAC
    string npath = macNormPath(path);
    unlink(npath);
    #off
}

public void rename(string oldPath, string newPath) {
    #on WINDOWS
    MoveFileA(oldPath, newPath);
    #on LINUX
    string nold = fsNormPath(oldPath);
    string nnew = fsNormPath(newPath);
    renameFile(nold, nnew);
    #on MAC
    string nold = macNormPath(oldPath);
    string nnew = macNormPath(newPath);
    renameFile(nold, nnew);
    #off
}

public string[] listDir(string path) {
    #on WINDOWS
    string sp = path + "\\*";
    int h = FindFirstFileA(sp, null);
    if (h == -1) { return []; }
    string[] names = [];
    bool cont = true;
    while (cont) {
        string name = "";
        if (name != "." && name != "..") { names.add(name); }
        cont = FindNextFileA(h, null);
    }
    FindClose(h);
    return names;
    #on LINUX
    string npath = fsNormPath(path);
    string[] names = readDirNames(npath);
    return names;
    #on MAC
    string npath = macNormPath(path);
    string[] names = readDirNames(npath);
    return names;
    #off
}

public void createDir(string path) {
    #on WINDOWS
    CreateDirectoryA(path, null);
    #on LINUX
    string npath = fsNormPath(path);
    mkdir(npath, 493);
    #on MAC
    string npath = macNormPath(path);
    mkdir(npath, 493);
    #off
}

// st_size (i64 at stat offset 48 = slot 6 of an int[18] on Linux; Darwin
// stat64 st_size at byte 96 = slot 12, UNVALIDATED code-only), or -1 when
// stat fails. The WINDOWS bodies size via GetFileSize.
int64 statSize(string path) {
    #on LINUX
    string npath = fsNormPath(path);
    int[] st = new int[18];
    int rc = stat(npath, st);
    if (rc != 0) { return -1; }
    return st[6];
    #on MAC
    string npath = macNormPath(path);
    int[] st = new int[18];
    int rc = stat(npath, st);
    if (rc != 0) { return -1; }
    return st[12];
    #off
    return -1;
}

// 1 when path stats as a directory, else 0 (stat failure counts as
// not-a-dir, mirroring GetFileAttributesA != 0x10). LINUX branch plus the
// MAC branch (Darwin st_mode at bytes 4-5; UNVALIDATED code-only).
int isDirPath(string path) {
    #on LINUX
    string npath = fsNormPath(path);
    int[] st = new int[18];
    int rc = stat(npath, st);
    if (rc != 0) { return 0; }
    int mode = st[3] & 0xFFFF;
    if ((mode & 0xF000) == 0x4000) { return 1; }
    return 0;
    #on MAC
    string npath = macNormPath(path);
    int[] st = new int[18];
    int rc = stat(npath, st);
    if (rc != 0) { return 0; }
    int mode = (st[0] >> 32) & 0xFFFF;
    if ((mode & 0xF000) == 0x4000) { return 1; }
    return 0;
    #off
    return 0;
}

// Directory entries via opendir/readdir/closedir, skipping "." and "..".
// Each dirent's d_name (offset 19 Linux, 21 Darwin UNVALIDATED code-only) is
// copied bounded (256) out of libc's static storage before the NUL scan,
// so no unbounded read escapes. The WINDOWS bodies enumerate with FindFirstFileA.
string[] readDirNames(string path) {
    #on LINUX
    string npath = fsNormPath(path);
    string[] names = [];
    int dir = opendir(npath);
    if (dir == 0) { return names; }
    while (true) {
        int node = readdir(dir);
        if (node == 0) { break; }
        int[] raw = new int[32];
        memcpy(raw, node + 19, 256);
        string name = "";
        for (int i = 0; i < 256; i++) {
            int b = (raw[i / 8] >> ((i % 8) * 8)) & 0xFF;
            if (b == 0) { break; }
            name += char(b);
        }
        if (name != "." && name != "..") { names.add(name); }
    }
    closedir(dir);
    return names;
    #on MAC
    string npath = macNormPath(path);
    string[] names = [];
    int dir = opendir(npath);
    if (dir == 0) { return names; }
    while (true) {
        int node = readdir(dir);
        if (node == 0) { break; }
        int[] raw = new int[32];
        memcpy(raw, node + 21, 256);
        string name = "";
        for (int i = 0; i < 256; i++) {
            int b = (raw[i / 8] >> ((i % 8) * 8)) & 0xFF;
            if (b == 0) { break; }
            name += char(b);
        }
        if (name != "." && name != "..") { names.add(name); }
    }
    closedir(dir);
    return names;
    #off
    string[] empty = [];
    return empty;
}

construct () {
    file = new FileOps();
    folder = new FolderOps();
}
