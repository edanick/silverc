mod export fs;

// DOCS -- public `fs` module (UNIFIED_CORE_LIBRARY.md v2 canonical fold).
// This is the universal file-system module: there is no fs_win.sr backend
// and no win-named helpers -- one module, one OS layer (fs -> win32.kernel32).
// The canonical shape puts each raw OS call INSIDE its public function's
// body behind a `#on WINDOWS` ... `#off` region: one unified function name,
// no wrapper indirection, no `#else`, no LINUX/MAC placeholders (the
// non-Windows regions get filled on their own machines later). The osType()
// runtime gates are gone: the preprocessor replaces them, so
// `import * from os;` is not needed here. Plain
// `import * from win32.kernel32;` -- alias imports are removed in v2. No
// kernel32 export name (CreateFileA, ReadFile, ...) collides with this
// module's public API.
//
// The bodies below are the pre-split fs.sr implementations so behavior is
// unchanged -- including FolderOps.list's FindFirstFileA enumeration quirk
// (the handle-based loop never copies the WIN32_FIND_DATA name, so each
// entry contributes ""). One mechanical adjustment inherited from the v1
// split: the old `byte[] buf[size];` fixed-declaration is spelled
// `byte[] buf = new byte[size];` (the codebase-standard allocation idiom).
//
// DELEGATION QUIRK (intentional, do not "fix"): FileOps.readString still
// calls fs.readString(path). When the self-hosted compiler compiles that
// name it resolves to the compiler's builtin native readString, not to this
// module's own function -- identical to pre-split behavior. The native path
// allocates a raw byte buffer for ReadFile; compiling the old managed-array
// implementation passed a Silver array header to Win32 and could crash on
// ordinary instance reads.

#on WINDOWS
import * from win32.kernel32;
#off

class FileOps {
    construct () {}

    public bool exists(string path) {
        #on WINDOWS
        return GetFileAttributesA(path) != -1;
        #off
    }

    public void delete(string path) {
        #on WINDOWS
        DeleteFileA(path);
        #off
    }

    public void rename(string oldPath, string newPath) {
        #on WINDOWS
        MoveFileA(oldPath, newPath);
        #off
    }

    public string readString(string path) {
        // Keep the instance API in parity with the native fs module. The
        // native path allocates a raw byte buffer for ReadFile; compiling the
        // old managed-array implementation passed a Silver array header to
        // Win32 and could crash on ordinary instance reads.
        return fs.readString(path);
    }

    public void write(string path, byte[] data) {
        #on WINDOWS
        int h = CreateFileA(path, 0x40000000, 0, null, 2, 0x80, 0);
        if (h == -1) { return; }
        int wrote = 0;
        WriteFile(h, data, data.length, &wrote, null);
        CloseHandle(h);
        #off
    }
}

class FolderOps {
    construct () {}

    public string[] list(string path) {
        #on WINDOWS
        string sp = path + "\\*";
        int h = FindFirstFileA(sp, null);
        if (h == -1) { return []; }
        string[] names = [];
        bool cont = true;
        while (cont) {
            string name = "";
            if (name != "." && name != "..") { names.add(name); }
            cont = FindNextFileA(h, null);
        }
        FindClose(h);
        return names;
        #off
    }

    public string[] list() << this.list(".");

    public string[] files() {
        #on WINDOWS
        string[] all = this.list();
        string[] result = [];
        foreach (string f in all) {
            if (GetFileAttributesA(f) != 0x10) { result.add(f); }
        }
        return result;
        #off
    }

    public string[] folders() {
        #on WINDOWS
        string[] all = this.list();
        string[] result = [];
        foreach (string f in all) {
            if (GetFileAttributesA(f) == 0x10) { result.add(f); }
        }
        return result;
        #off
    }

    public string[] entries() << this.list();

    public string[] list(string[] exts) {
        string[] all = this.list();
        string[] result = [];
        foreach (string f in all) {
            foreach (string ext in exts) {
                if (f.endsWith("." + ext)) { result.add(f); break; }
            }
        }
        return result;
    }

    public void create(string path) {
        #on WINDOWS
        CreateDirectoryA(path, null);
        #off
    }

    public void create(string path, bool ignoreExistence) {
        #on WINDOWS
        CreateDirectoryA(path, null);
        #off
    }
}

public FileOps file;
public FolderOps folder;

public string readString(string path) {
    #on WINDOWS
    int h = CreateFileA(path, 0x80000000, 3, null, 3, 0x80, 0);
    if (h == -1) { return ""; }
    int size = GetFileSize(h, null);
    byte[] buf = new byte[size];
    int read = 0;
    ReadFile(h, buf, size, &read, null);
    CloseHandle(h);
    string result = "";
    foreach (byte b in buf) { result += char(b); }
    return result;
    #off
}

public byte[] read(string path) {
    #on WINDOWS
    int h = CreateFileA(path, 0x80000000, 3, null, 3, 0x80, 0);
    if (h == -1) { return []; }
    int size = GetFileSize(h, null);
    byte[] buf = new byte[size];
    int read = 0;
    ReadFile(h, buf, size, &read, null);
    CloseHandle(h);
    return buf;
    #off
}

public void writeString(string path, string content) {
    #on WINDOWS
    int h = CreateFileA(path, 0x40000000, 0, null, 2, 0x80, 0);
    if (h == -1) { return; }
    byte[] buf = content.toBytes();
    int wrote = 0;
    WriteFile(h, buf, buf.length, &wrote, null);
    CloseHandle(h);
    #off
}

public void write(string path, byte[] data) {
    #on WINDOWS
    int h = CreateFileA(path, 0x40000000, 0, null, 2, 0x80, 0);
    if (h == -1) { return; }
    int wrote = 0;
    WriteFile(h, data, data.length, &wrote, null);
    CloseHandle(h);
    #off
}

public bool exists(string path) {
    #on WINDOWS
    return GetFileAttributesA(path) != -1;
    #off
}

public void delete(string path) {
    #on WINDOWS
    DeleteFileA(path);
    #off
}

public void rename(string oldPath, string newPath) {
    #on WINDOWS
    MoveFileA(oldPath, newPath);
    #off
}

public string[] listDir(string path) {
    #on WINDOWS
    string sp = path + "\\*";
    int h = FindFirstFileA(sp, null);
    if (h == -1) { return []; }
    string[] names = [];
    bool cont = true;
    while (cont) {
        string name = "";
        if (name != "." && name != "..") { names.add(name); }
        cont = FindNextFileA(h, null);
    }
    FindClose(h);
    return names;
    #off
}

public void createDir(string path) {
    #on WINDOWS
    CreateDirectoryA(path, null);
    #off
}

construct () {
    file = new FileOps();
    folder = new FolderOps();
}
