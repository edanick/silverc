import * from net;

mod export ssh;

// DOCS -- public `ssh` module (UNIFIED_CORE_LIBRARY.md §4). This is the
// portable front of the SSH library. It contains ZERO OS code: no win32
// imports, no `#on` regions -- every byte on the wire is sent through the
// universal socket core std/net.sr
// (connectRaw/sendRawLen/recvRaw/closeRaw/setRecvTimeoutRaw), whose
// Windows regions hold the ws2_32 calls. This module is pure SSH protocol
// logic and compiles unchanged on any backend that provides net.
//
// TRANSPORT: everything rides net. connectRaw dials, setRecvTimeoutRaw
// arms a 30 s receive timeout right after the connect -- login() and
// exec() arm it immediately after each connectRaw (net.setRecvTimeoutRaw,
// 30000 ms), so every socket carries a 30 s receive timeout bound. The
// recv loops call net.recvRaw(fd, 4096) and the senders call
// net.sendRawLen with exact byte counts. The receive path returns "" on
// both recv error and zero-length reads: recvRaw normalizes the DLL
// return first, then reports "" for `n <= 0`.
//
// DISPATCH: `ssh` is builtin-reserved on NEITHER compiler -- silverc-rs
// has no `ssh` anywhere in src/ (win32.rs's DLL module table holds
// kernel32/user32/ws2_32/winhttp/wininet/msvcrt/advapi32/shell32/version/
// registry only) and the self-hosted compiler's visBuiltinModule
// (compiler/visibility.sr:605 lists fs/json/yaml/llmai/LLMAI/os/project/
// exception/bom/process/notifications/env/url/hash/path/console/math/
// http) plus its driver prepend list all exclude it. Both compilers
// resolve `import * from ssh;` as an ORDINARY SOURCE module (std/ssh.sr);
// there is no native dispatch for it. (ssh.sr's entry in silverc.srp's
// exclude list only keeps it out of the compiler's own aggregate build --
// the same posture as smtp.sr/pop.sr/imap.sr; it does not make `ssh` a
// builtin.)
//
// HONESTY NOTE -- this is NOT a full SSH implementation: real SSH needs key
// exchange, the RFC 4253 binary packet protocol and encryption, and NONE of
// that is implemented here (a real implementation is a separate feature
// ticket, and this module does NOT deliver an encrypted session). What the
// module delivers is the transport plus the one protocol framing SSH
// defines before any crypto: the RFC 4253 version exchange -- the server
// banner "SSH-2.0-..." is read and validated (bannerOk) and the client
// version string "SSH-2.0-SilverSSH_1.0\r\n" is sent. login() completes
// that version exchange and then FAILS at the authentication stage -- it
// always ends with the connection dropped and isLoggedIn() false, because
// there is no key exchange behind the banner to authenticate over (the
// user/pass parameters are carried unused). exec() opens a per-call
// socket, performs the banner round-trip, sends one command line, reads
// one bounded reply and closes, but what it returns is the raw post-banner
// bytes the peer sent, NOT a decrypted command result -- against a real
// SSH server the post-banner traffic is the binary packet protocol (key
// exchange), which this module does not speak, so the raw bytes or "" come
// back and the session ends. The class/method names (login/authWithKey/
// shell/sftp) are the public API surface only.
//
// WIRE BEHAVIOR:
// - The transport: socket + connect over ws2_32 with WSAStartup inside
//   net.sr's Windows regions, the sockaddr_in image packed into an int[2]
//   qword buffer (with the network-order port swap), and DLL returns
//   normalized with the two-sided `v < 0 || v > 2147483647` check (the
//   self-host zero-extends SOCKET_ERROR to 4294967295).
// - login(): performs the RFC 4253 version exchange -- connect, read and
//   validate the server's "SSH-..." banner (bannerOk; RFC 4253 permits the
//   server to send other lines first), send the client version string, and
//   record the observation in serverVersion()/getLastReply(). The auth
//   stage then fails gracefully: fail() drops the connection and
//   isLoggedIn() stays false -- the honest terminal state, since no key
//   exchange/USERAUTH exists behind the banner. Against a non-SSH listener
//   login fails earlier and equally gracefully: the peer's junk (or ""
//   after a silent disconnect) is surfaced through getLastReply() and the
//   process exits cleanly. No exceptions anywhere.
// - exec(): performs the client-banner round-trip, waits for the server's
//   "SSH-" banner line, sends `<cmd>\r\n` as a plain line and reads one
//   bounded reply before closing, returning the raw bytes (see HONESTY
//   NOTE); "" on any failure -- on connect failure there is no socket, and
//   on a failed banner exchange the socket is closed first.
// - Bounded reads: every socket gets a 30 s SO_RCVTIMEO
//   (net.setRecvTimeoutRaw, armed after each connectRaw). Every
//   accumulation loop below is bounded at 16 x 4096 bytes (~64 KB) until
//   its stop condition (a complete CRLF line carrying "SSH-", or the peer
//   going quiet) -- whichever comes first, so no path can spin forever.
//
// SCOPE: no key exchange, no RFC 4254 binary packet protocol, no
// cipher/HMAC of any kind, no diffie-hellman, no host key verification, no
// USERAUTH of any kind (authWithKey is a no-op stub with the keyPath/
// passphrase parameters carried unused), no pty/channel-open/
// channel-request framing, no SCP/SFTP (the sftp methods are empty
// stubs), no keepalives, no compression. shell.write/read/close are empty
// stubs (no channel layer exists to attach them to); the shell/sftp
// factory methods are methods named exactly like their class, each
// returning a new instance.
//
// PUBLIC API: class shell -- construct(), write(string), read() -> string,
// close(); class sftp -- construct(), list(string), get(string, string),
// put(string, string), delete(string), close(); class client --
// construct(string host, int port); login(string user, string pass);
// authWithKey(string user, string keyPath); authWithKey(string user,
// string keyPath, string passphrase) (both overloads); exec(string cmd)
// -> string; shell() -> shell; sftp() -> sftp; upload(string local,
// string remote); download(string remote, string local); close(). Every
// name (shell, sftp, client, write, read, close, list, get, put, delete,
// login, authWithKey, exec, upload, download) is keyword-free on both
// compilers -- checked against silverc-rs src/token.rs and self-host
// compiler/lexer.sr (`from`/`to`/`match` are keywords on both and appear
// nowhere here).
// getLastReply(): the raw text of the last bytes read from the peer (""
// before the first read -- the graceful-failure surface). isLoggedIn():
// true only after a COMPLETED authenticated session, which never happens
// (authentication is unimplemented -- see HONESTY NOTE). serverVersion():
// the server's version tail (everything after the literal "SSH-" prefix
// of the first banner line, e.g. "2.0-OpenSSH_9.0"; "" when no banner has
// been accepted). Free pure helpers -- clientBanner() (the client
// identification string this module sends, WITHOUT the CRLF),
// bannerOk(resp) (true when `resp` carries an "SSH-" sequence),
// bannerIndex(resp) (index of the first "SSH-" sequence, -1 when absent)
// and versionString(banner) (the banner's tail after "SSH-", "" when
// absent) are pure and probeable. Module-internal: the private
// lastReply/loggedIn/serverVer/sock fields, the private readBanner/fail
// plumbing, and construct()'s full field initialization (sock to -1,
// strings to "", loggedIn to false), so close() never touches an
// uninitialized handle.
//
// CALLER NOTES: instantiate the client with `var c = new client(...);` --
// a lowercase class arriving from a star-imported module cannot be spelled
// as a local's type on silverc-rs (per-file parsing: `client c` dies with
// "unknown keyword"; `new mod.client()` dies on BOTH compilers; `var`
// works on both; the same `var` pattern works in std/ftps.sr). Strings
// returned across this module's boundary
// (exec/getLastReply/serverVersion/shell.read and the
// free helpers) should be assigned to a local before being concatenated
// into larger expressions (silverc-rs stringifies the return pointer in
// expression position; see std/dns.sr's RS-ONLY CALLER LANDMINE). exec()
// returns "" on any failure; login()/authWithKey()/upload()/download() are
// silent and close() is idempotent. The module compares server text with
// char/int scans only -- no string == -- and callers wanting to test
// banners should reuse bannerOk/bannerIndex rather than spelling ==.

// The client identification string this module sends during the RFC 4253
// version exchange (WITHOUT the trailing CRLF; the senders append it). It
// carries the same "SSH-protoversion-softwareversion" shape any RFC 4253
// identification carries. Pure; probeable byte-identical on both compilers.
public string clientBanner() {
    return "SSH-2.0-SilverSSH_1.0";
}

// True when `resp` carries an SSH identification line: any "SSH-" sequence
// (RFC 4253 permits the server to send other lines before it, so this is a
// containment scan, not a prefix check). Pure; probeable.
public bool bannerOk(string resp) {
    return bannerIndex(resp) >= 0;
}

// Index of the first "SSH-" octet sequence in `resp` (-1 when absent).
// Pure; probeable.
public int bannerIndex(string resp) {
    int n = resp.length;
    for (int i = 0; i + 3 < n; i++) {
        if (resp[i] == 83 && resp[i + 1] == 83 && resp[i + 2] == 72 && resp[i + 3] == 45) {
            return i;
        }
    }
    return -1;
}

// The version tail of an SSH identification string: everything after the
// literal "SSH-" prefix (e.g. "2.0-OpenSSH_9.0" for
// "SSH-2.0-OpenSSH_9.0"). "" when the prefix is absent. Pure; probeable.
public string versionString(string banner) {
    int idx = bannerIndex(banner);
    if (idx < 0) { return ""; }
    return sliceRange(banner, idx + 4, banner.length);
}

class shell {

    // Empty stub: no SSH channel layer exists behind it (see SCOPE), so
    // write is a silent no-op.
    public void write(string cmd) { }

    // Stub returning "": no channel layer exists to read from.
    public string read() { return ""; }

    // Empty stub (no channel layer to close).
    public void close() { }
}

class sftp {

    // Empty stubs: no SFTP subsystem exists behind them (see SCOPE) --
    // the names and arities are the API surface.
    public void list(string path) { }
    public void get(string remote, string local) { }
    public void put(string local, string remote) { }
    public void delete(string path) { }
    public void close() { }
}

class client {
    private string host;
    private int port;
    private int sock;
    private string lastReply;
    private bool loggedIn;
    private string serverVer;

    construct(string host, int port) {
        this.host = host;
        this.port = port;
        this.sock = -1;
        this.lastReply = "";
        this.loggedIn = false;
        this.serverVer = "";
    }

    // The raw text of the last bytes read from the peer ("" before the
    // first read). This is the graceful-failure surface: against a
    // non-SSH listener it holds the junk the peer sent, or "" when the
    // peer said nothing and closed.
    public string getLastReply() {
        return this.lastReply;
    }

    // True only after a COMPLETED authenticated session. Always false --
    // authentication is unimplemented (see HONESTY NOTE).
    public bool isLoggedIn() {
        return this.loggedIn;
    }

    // The server's version tail after the "SSH-" prefix (e.g.
    // "2.0-OpenSSH_9.0"), "" when no banner has been accepted.
    public string serverVersion() {
        return this.serverVer;
    }

    // The RFC 4253 version exchange, then a graceful failure at the
    // (unimplemented) authentication stage: connect, read and validate
    // the server's "SSH-" banner, send the client version string, then
    // fail() drops the connection -- there is no key exchange behind the
    // banner to authenticate over (see HONESTY NOTE). serverVersion() and
    // getLastReply() carry the observation; isLoggedIn() stays false.
    // Against a non-SSH listener the banner check fails first and the
    // outcome is equally graceful.
    public void login(string user, string pass) {
        this.sock = net.connectRaw(this.host, this.port);
        if (this.sock < 0) {
            this.sock = -1;
            this.lastReply = "";
            return;
        }
        net.setRecvTimeoutRaw(this.sock, 30000);
        this.readBanner();
        if (!bannerOk(this.lastReply)) {
            this.fail();
            return;
        }
        this.serverVer = versionString(firstLine(this.lastReply));
        this.sendLine(clientBanner());
        this.fail();
    }

    // No-op stub (overload 1 of 2): no USERAUTH exists (see SCOPE);
    // keyPath is carried unused.
    public void authWithKey(string user, string keyPath) { }

    // No-op stub (overload 2 of 2).
    public void authWithKey(string user, string keyPath, string passphrase) { }

    // One connection per call: a fresh socket, the client banner
    // round-trip first, then `<cmd>\r\n` as a plain line, one bounded
    // reply read, close. Returns the raw post-banner bytes the peer sent
    // (NOT a decrypted result -- see HONESTY NOTE); "" on any failure --
    // on connect failure there is no socket, and on a failed banner
    // exchange the socket is closed first.
    public string exec(string cmd) {
        string banner = clientBanner();
        int sock = net.connectRaw(this.host, this.port);
        if (sock < 0) { return ""; }
        net.setRecvTimeoutRaw(sock, 30000);
        net.sendRawLen(sock, banner + "\r\n", banner.length + 2);
        string acc = "";
        for (int guard = 0; guard < 16; guard++) {
            string chunk = net.recvRaw(sock, 4096);
            if (chunk.length <= 0) { break; }
            acc += chunk;
            if (bannerIndex(acc) >= 0 && lineEndIndex(acc) >= 0) { break; }
        }
        if (!bannerOk(acc)) {
            net.closeRaw(sock);
            return "";
        }
        net.sendRawLen(sock, cmd + "\r\n", cmd.length + 2);
        string reply = "";
        for (int guard2 = 0; guard2 < 16; guard2++) {
            string chunk2 = net.recvRaw(sock, 4096);
            if (chunk2.length <= 0) { break; }
            reply += chunk2;
        }
        net.closeRaw(sock);
        return reply;
    }

    // Factory method named exactly like its class; returns a new instance.
    public shell shell() { return new shell(); }

    // Factory method named exactly like its class; returns a new instance.
    public sftp sftp() { return new sftp(); }

    // Empty stub (no SFTP subsystem exists behind it -- see SCOPE).
    public void upload(string local, string remote) { }

    // Empty stub (no SFTP subsystem exists behind it -- see SCOPE).
    public void download(string remote, string local) { }

    // Closes the session's socket. Silent and idempotent when no session
    // is open.
    public void close() {
        if (this.sock >= 0) {
            net.closeRaw(this.sock);
        }
        this.sock = -1;
        this.loggedIn = false;
    }

    // Sends one line with its CRLF. No-op on a dead channel -- every
    // caller pairs it with a bounded read, so the failure surfaces there
    // instead.
    private void sendLine(string line) {
        if (this.sock < 0) { return; }
        net.sendRawLen(this.sock, line + "\r\n", line.length + 2);
    }

    // Accumulates reads into lastReply until a complete line carrying
    // "SSH-" is seen, the peer goes quiet, or 16 x 4096 bytes (~64 KB)
    // pass -- whichever comes first. Overwrites, never appends across
    // calls: a stale reply must not leak into the next check.
    private void readBanner() {
        string acc = "";
        for (int guard = 0; guard < 16; guard++) {
            string chunk = net.recvRaw(this.sock, 4096);
            if (chunk.length <= 0) { break; }
            acc += chunk;
            if (bannerIndex(acc) >= 0 && lineEndIndex(acc) >= 0) { break; }
        }
        this.lastReply = acc;
    }

    // Drops the connection and marks the client logged out; lastReply
    // keeps whatever the peer last said so the caller can surface it.
    private void fail() {
        this.loggedIn = false;
        if (this.sock >= 0) {
            net.closeRaw(this.sock);
        }
        this.sock = -1;
    }
}

// Index of the first "\r\n" at or after `startIdx` (the \r's index; -1 when
// absent). Private plumbing for the line-oriented scans. The parameter is
// spelled startIdx -- `from` is a lexer keyword on both compilers (the
// smtp/ftp RENAMED MEMBERS landmine; never a parameter name either).
private int lineEndFrom(string s, int startIdx) {
    for (int i = startIdx; i + 1 < s.length; i++) {
        if (s[i] == 13 && s[i + 1] == 10) { return i; }
    }
    return -1;
}

private int lineEndIndex(string s) {
    return lineEndFrom(s, 0);
}

// The text before the first "\r\n" (the whole string when no CRLF exists).
private string firstLine(string s) {
    int eol = lineEndIndex(s);
    if (eol < 0) { return s; }
    return sliceRange(s, 0, eol);
}

// Copies s[start .. end) character by character. Deliberately NOT substr:
// rs's two-arg substr treats X as an END offset while the self-host treats
// it as a LENGTH -- identical only when start is 0 (see
// silverc-rs/src/string_ops.rs emit_string_substring) -- and every caller
// here slices from a nonzero offset.
private string sliceRange(string s, int start, int end) {
    string result = "";
    for (int i = start; i < end; i++) {
        result += s[i];
    }
    return result;
}
