mod export json;
import {readString} from fs;

class JsonParser {
    private prop string src;
    private prop int pos;

    construct (string src) {
        this.src = src;
        this.pos = 0;
    }

    private void skip() {
        while (this.pos < this.src.length) {
            char c = this.src[this.pos];
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
                this.pos++;
            } else { break; }
        }
    }

    private char? peek() {
        this.skip();
        if (this.pos >= this.src.length) { return null; }
        return this.src[this.pos];
    }

    private char advance() {
        char c = this.src[this.pos];
        this.pos++;
        return c;
    }

    private object parseValue() {
        char? c = this.peek();
        if (c == null) { return null; }
        if (c == '{') { return this.parseObject(); }
        if (c == '[') { return this.parseArray(); }
        if (c == '"') { return this.parseString(); }
        if (c == 't' || c == 'f') { return this.parseBool(); }
        if (c == 'n') { this.expect("null"); return null; }
        return this.parseNumber();
    }

    private dict<string, object> parseObject() {
        dict<string, object> obj = {};
        this.advance();
        if (this.peek() == '}') { this.advance(); return obj; }
        while (true) {
            this.skip();
            string key = this.parseString();
            this.skip();
            this.expect(":");
            this.skip();
            object val = this.parseValue();
            obj[key] = val;
            this.skip();
            if (this.peek() == '}') { this.advance(); break; }
            if (this.peek() == ',') { this.advance(); }
        }
        return obj;
    }

    private object[] parseArray() {
        object[] arr = [];
        this.advance();
        if (this.peek() == ']') { this.advance(); return arr; }
        while (true) {
            arr.add(this.parseValue());
            this.skip();
            if (this.peek() == ']') { this.advance(); break; }
            if (this.peek() == ',') { this.advance(); }
        }
        return arr;
    }

    private string parseString() {
        string s = "";
        if (this.peek() == '"') { this.advance(); }
        while (this.pos < this.src.length) {
            char c = this.advance();
            if (c == '"') { break; }
            if (c == '\\') {
                if (this.pos >= this.src.length) { break; }
                char n = this.advance();
                if (n == 'n') { s += "\n"; }
                else if (n == 't') { s += "\t"; }
                else if (n == 'r') { s += "\r"; }
                else if (n == '\\') { s += "\\"; }
                else if (n == '"') { s += "\""; }
                else if (n == '/') { s += "/"; }
                else if (n == 'u') {
                    string hex = "";
                    for (int i = 0; i < 4 && this.pos < this.src.length; i++) { hex += this.advance(); }
                    s += char(int(hex, 16));
                }
                else { s += n; }
            } else { s += c; }
        }
        return s;
    }

    private float64 parseNumber() {
        string s = "";
        if (this.peek() == '-') { s += this.advance(); }
        while (this.pos < this.src.length) {
            char c = this.src[this.pos];
            if (c.isDigit() || c == '.' || c == 'e' || c == 'E' || c == '+' || c == '-') {
                if ((c == '+' || c == '-') && s.length > 0 && s[s.length - 1] != 'e' && s[s.length - 1] != 'E') { break; }
                s += this.advance();
            } else { break; }
        }
        return this.strToF(s);
    }

    // Manual decimal parse: the float64(string) conversion is unreliable on
    // the self-host (it converts the string POINTER), so numbers are
    // accumulated digit by digit: [minus] digits [. digits] [eE [+-] exp].
    private float64 strToF(string s) {
        int i = 0;
        bool neg = false;
        if (i < s.length && s[i] == '-') { neg = true; i++; }
        float64 whole = 0.0;
        while (i < s.length && s[i] >= '0' && s[i] <= '9') {
            whole = whole * 10.0 + float64(s[i] - '0');
            i++;
        }
        float64 frac = 0.0;
        if (i < s.length && s[i] == '.') {
            i++;
            float64 scale = 0.1;
            while (i < s.length && s[i] >= '0' && s[i] <= '9') {
                frac += float64(s[i] - '0') * scale;
                scale /= 10.0;
                i++;
            }
        }
        float64 result = whole + frac;
        if (i < s.length && (s[i] == 'e' || s[i] == 'E')) {
            i++;
            bool eneg = false;
            if (i < s.length && (s[i] == '+' || s[i] == '-')) {
                if (s[i] == '-') { eneg = true; }
                i++;
            }
            int exp = 0;
            while (i < s.length && s[i] >= '0' && s[i] <= '9') {
                exp = exp * 10 + (s[i] - '0');
                i++;
            }
            float64 m = 1.0;
            for (int k = 0; k < exp; k++) { m *= 10.0; }
            if (eneg) { result /= m; } else { result *= m; }
        }
        if (neg) { return -result; }
        return result;
    }

    private bool parseBool() {
        if (this.src.substr(this.pos, 4) == "true") { this.pos += 4; return true; }
        this.pos += 5;
        return false;
    }

    private void expect(string s) {
        if (this.src.substr(this.pos, s.length) == s) {
            this.pos += s.length;
        }
    }

    private string spaces(int n) {
        string s = "";
        for (int i = 0; i < n; i++) { s += " "; }
        return s;
    }

    // Pretty-print (DOCS/96 json beautify): parse the NEXT value and render
    // it with `indent` spaces per nesting level, one member per line --
    // python json.dumps(data, indent=N) formatting. Empty objects/arrays
    // stay inline ("{}" / "[]").
    private string parsePrettyValue(int level, int indent) {
        char? c = this.peek();
        if (c == null) { return "null"; }
        if (c == '{') { return this.parsePrettyObject(level, indent); }
        if (c == '[') { return this.parsePrettyArray(level, indent); }
        if (c == '"') { return "\"" + this.parseString() + "\""; }
        if (c == 't' || c == 'f') {
            if (this.parseBool()) { return "true"; }
            return "false";
        }
        if (c == 'n') { this.expect("null"); return "null"; }
        return (string)this.parseNumber();
    }

    private string parsePrettyObject(int level, int indent) {
        this.advance();
        if (this.peek() == '}') { this.advance(); return "{}"; }
        string pad = this.spaces((level + 1) * indent);
        string endPad = this.spaces(level * indent);
        string out = "{";
        while (true) {
            this.skip();
            string key = this.parseString();
            this.skip();
            this.expect(":");
            this.skip();
            string val = this.parsePrettyValue(level + 1, indent);
            out += "\n" + pad + "\"" + key + "\": " + val;
            this.skip();
            if (this.peek() == '}') { this.advance(); break; }
            if (this.peek() == ',') { this.advance(); out += ","; }
        }
        out += "\n" + endPad + "}";
        return out;
    }

    private string parsePrettyArray(int level, int indent) {
        this.advance();
        if (this.peek() == ']') { this.advance(); return "[]"; }
        string pad = this.spaces((level + 1) * indent);
        string endPad = this.spaces(level * indent);
        string out = "[";
        while (true) {
            string val = this.parsePrettyValue(level + 1, indent);
            out += "\n" + pad + val;
            this.skip();
            if (this.peek() == ']') { this.advance(); break; }
            if (this.peek() == ',') { this.advance(); out += ","; }
        }
        out += "\n" + endPad + "]";
        return out;
    }
}

// json.stringify(text, <options>) divert target (DOCS/96): parse raw JSON
// text and return the pretty-printed form.
public string beautify(string jsonStr, int indent) {
    if (indent <= 0) { indent = 2; }
    JsonParser p = new JsonParser(jsonStr);
    return p.parsePrettyValue(0, indent);
}

public object parse(string jsonStr) {
    JsonParser p = new JsonParser(jsonStr);
    return p.parseValue();
}

public void load(string filepath, object obj) {
    string content = fs.readString(filepath);
    JsonParser p = new JsonParser(content);
    obj = p.parseValue();
}

