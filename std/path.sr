mod export path;

string pathJoinTwo(string left, string right) {
    if (left.length == 0) { return right; }
    if (right.length == 0) { return left; }
    char last = left[left.length - 1];
    char first = right[0];
    bool leftSep = last == '/' || last == '\\';
    bool rightSep = first == '/' || first == '\\';
    if (leftSep && rightSep) { return left + right[1..right.length]; }
    if (leftSep || rightSep) { return left + right; }
    return left + "\\" + right;
}

public string join(string left, string right) {
    return pathJoinTwo(left, right);
}

public string join(string[] parts) {
    string result = "";
    for (int i = 0; i < parts.length; i++) {
        result = pathJoinTwo(result, parts[i]);
    }
    return result;
}

public string normalize(string p) {
    string r = "";
    for (int i = 0; i < p.length; i++) {
        if (p[i] == '\\') { r += '/'; }
        else { r += p[i]; }
    }
    return r;
}

public string dirname(string p) {
    int last = -1;
    for (int i = 0; i < p.length; i++) {
        if (p[i] == '\\' || p[i] == '/') { last = i; }
    }
    if (last < 0) { return "."; }
    return p.substring(0, last);
}

bool pathIsWindowsForbidden(char c) {
    return c == '<' || c == '>' || c == ':' || c == '"' || c == '/'
        || c == '\\' || c == '|' || c == '?' || c == '*';
}

public string guardForWindows(string name) {
    string result = "";
    for (int i = 0; i < name.length; i++) {
        char c = name[i];
        if (pathIsWindowsForbidden(c)) {
            result += '_';
        } else {
            result += c;
        }
    }
    return result;
}
