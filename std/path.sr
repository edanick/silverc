mod export path;
import * from fs;

bool pathIsSep(char c) {
    return c == '/' || c == '\\';
}

string pathSeparator() {
    #on LINUX or MAC
    return "/";
    #off
    return "\\";
}

string pathJoinTwo(string left, string right) {
    int leftLen = left.length;
    if (leftLen == 0) { return right; }
    int rightLen = right.length;
    if (rightLen == 0) { return left; }
    char last = left[leftLen - 1];
    char first = right[0];
    bool leftSep = pathIsSep(last);
    bool rightSep = pathIsSep(first);
    if (leftSep && rightSep) { return left + right.substring(1, rightLen - 1); }
    if (leftSep || rightSep) { return left + right; }
    return left + pathSeparator() + right;
}

public string join(string left, string right) {
    return pathJoinTwo(left, right);
}

public string join(string[] parts) {
    string[] pieces = [];
    bool hasPrev = false;
    bool prevSep = false;
    for (int i = 0; i < parts.length; i++) {
        string part = parts[i];
        int partLen = part.length;
        if (partLen == 0) { continue; }
        if (!hasPrev) {
            pieces.add(part);
            hasPrev = true;
            prevSep = pathIsSep(part[partLen - 1]);
            continue;
        }
        bool partSep = pathIsSep(part[0]);
        if (prevSep && partSep) {
            if (partLen > 1) {
                string stripped = part.substring(1, partLen - 1);
                pieces.add(stripped);
                prevSep = pathIsSep(stripped[stripped.length - 1]);
            }
        } else if (prevSep || partSep) {
            pieces.add(part);
            prevSep = pathIsSep(part[partLen - 1]);
        } else {
            pieces.add(pathSeparator());
            pieces.add(part);
            prevSep = pathIsSep(part[partLen - 1]);
        }
    }
    return pieces.join("");
}

public string normalize(string p) {
    int n = p.length;
    string[] parts = [];
    int start = 0;
    bool changed = false;
    for (int i = 0; i < n; i++) {
        if (p[i] == '\\') {
            changed = true;
            if (i > start) { parts.add(p.substring(start, i - start)); }
            parts.add("/");
            start = i + 1;
        }
    }
    if (!changed) { return p; }
    if (start < n) { parts.add(p.substring(start, n - start)); }
    return parts.join("");
}

public string dirname(string p) {
    int n = p.length;
    int last = -1;
    for (int i = 0; i < n; i++) {
        if (p[i] == '\\' || p[i] == '/') { last = i; }
    }
    if (last < 0) { return "."; }
    return p.substring(0, last);
}

// §6 home of the bcache relKey contract: absolute path relative to root
// (both slash-normalized; the tail past root + '/' when rooted, else the
// full normalized path — the trailing-separator quirk falls out untouched).
public string relative(string root, string absolute) {
    string norm = normalize(absolute);
    string rootNorm = normalize(root);
    int normLen = norm.length;
    int rootLen = rootNorm.length;
    if (rootLen > 0 && normLen > rootLen + 1) {
        bool prefix = true;
        for (int i = 0; i < rootLen; i++) {
            if (norm[i] != rootNorm[i]) { prefix = false; break; }
        }
        if (prefix && norm[rootLen] == '/') {
            return norm.substring(rootLen + 1, normLen - rootLen - 1);
        }
    }
    return norm;
}

bool pathIsWindowsForbidden(char c) {
    return c == '<' || c == '>' || c == ':' || c == '"' || c == '/'
        || c == '\\' || c == '|' || c == '?' || c == '*';
}

public string guardForWindows(string name) {
    int n = name.length;
    string[] parts = [];
    int start = 0;
    for (int i = 0; i < n; i++) {
        if (pathIsWindowsForbidden(name[i])) {
            if (i > start) { parts.add(name.substring(start, i - start)); }
            parts.add("_");
            start = i + 1;
        }
    }
    if (start == 0) { return name; }
    if (start < n) { parts.add(name.substring(start, n - start)); }
    return parts.join("");
}

// File stem of a path: the characters after the last separator, with the
// final extension removed (a leading dot is not an extension, so ".sr"
// keeps its name). Case is preserved — callers lowercase explicitly.
public string stem(string p) {
    int n = p.length;
    int last = -1;
    for (int i = 0; i < n; i++) {
        if (p[i] == '\\' || p[i] == '/') { last = i; }
    }
    string name = p.substring(last + 1, n - last - 1);
    int nameLen = name.length;
    int dot = -1;
    for (int j = nameLen - 1; j >= 0; j--) {
        if (name[j] == '.') { dot = j; break; }
    }
    if (dot > 0) { name = name.substring(0, dot); }
    return name;
}

// True when a path literal is unusable on Windows: empty, carrying
// <>\"|?* or a control byte, or sitting on a drive whose root is missing.
// Sibling of guardForWindows (which repairs); this one only reports.
public bool invalidForWindows(string s) {
    int n = s.length;
    if (n == 0) { return true; }
    for (int i = 0; i < n; i++) {
        char c = s[i];
        if (c == '<' || c == '>' || c == '"' || c == '|' || c == '?' || c == '*') { return true; }
        if (c < 32) { return true; }
    }
    if (n >= 2 && s[1] == ':') {
        char d = s[0];
        if ((d >= 'a' && d <= 'z') || (d >= 'A' && d <= 'Z')) {
            string root = (string)d + ":" + (string)char(92);
            if (!file.exists(root)) { return true; }
        }
    }
    return false;
}
