mod export crypto;
import * from fs;
import { base64Encode, base64Decode } from encoding;

// DOCS -- public `crypto` module.
// This is the universal crypto module: all OS code lives inline in
// `#on WINDOWS` regions inside the function bodies -- one module, one OS
// layer (crypto -> win32.advapi32 + win32.msvcrt), one unified function
// name per operation, no wrapper indirection. Regions are flat
// `#on WINDOWS` ... `#off` blocks: no `#else`, no LINUX/MAC placeholders
// (the non-Windows regions get filled on their own machines later). The
// module needs no `import * from os;`: OS selection is the compiler
// preprocessor's job, and the runtime `os.type` check is a user-facing
// feature.
//
// IMPORT SHAPE: everything in this module is tabled on both compilers except
// the Crypt* trio -- advapi32 does not export-register CryptAcquireContextA/
// CryptGenRandom/CryptReleaseContext in either compiler's per-DLL export
// table (only the Reg*/GetUserNameA registry set), so the star form cannot
// answer them; they are bound through PLAIN single-export grants
// (`import { CryptAcquireContextA, ... } from win32.advapi32;` -- no `as Y`
// aliasing), which resolve by local name on both compilers, with the PE
// import keeping the real export. rand IS tabled (msvcrt) on both
// compilers, so it takes the star form. Everything else in this file is
// pure Silver, with no regions.
//
// BASE64 NOTE: aes*/rsa* payloads are base64 strings, and the codec lives
// in std/encoding.sr (the §6 home) -- encoding.base64Encode/base64Decode
// were probed byte-identical to the former private helpers on both
// compilers (RFC vectors, binary 1-255 round-trip, invalid-char skip,
// '='-padding stop), so crypto delegates to them and carries no codec of
// its own. The functions' documented contract is unchanged:
// aesEncrypt = base64("data:key"), rsaEncrypt = base64(data), aesDecrypt =
// the "data" part of the decoded payload.
//
// RNG NOTE: salt/key material routes through the module's
// cryptoRandomRange (msvcrt rand inside its Windows region, libc rand
// inside the Linux region). Swapping the CRT rand for a stronger unified
// RNG (and making bcryptHash actually hash) is future work.
//
// LINUX BACKEND (Phase B): cryptoRandomRange rides libc rand() with the
// same span shape; randomBytes reads real entropy from getrandom(2) into
// a packed int[2+]-style buffer and unpacks one byte per slot (the uuid.sr
// layout -- byte[] must not cross the boundary packed). A failed getrandom
// keeps the zero fill, matching the old fallback.
//
// MAC BACKEND (Phase B, code-only -- MAC.md section 10, UNVALIDATED until
// probed on Mac hardware): cryptoRandomRange rides libSystem rand() with
// the same span shape (shared through `#else`); randomBytes reads real
// entropy from arc4random_buf into a packed int[] and unpacks one byte per
// slot (the same uuid.sr layout). getrandom(2) is Linux-only and does not
// exist on macOS -- it is never called here. randomBytes MUST return real
// bytes on macOS (never the zero fill).
//
// COMPILER NOTE: silverc-rs cannot consume exported CLASS types from
// source modules (rsaKeyPair as a user-local type fails with the standard
// rs parser error "unknown keyword rsaKeyPair"), so rsaGenerate's return
// value is only directly usable on the self-hosted compiler; the
// string-based rsaEncrypt/rsaDecrypt pair works everywhere. The
// deterministic results -- base64 payloads, round-trip equality, key/salt
// lengths, the bcrypt prefix/length/verify contract -- follow the
// documented API contract.
//
// NON-WINDOWS FALLBACK: randomBytes returns a zero-filled array of the
// requested length and cryptoRandomRange returns its minimum when no
// Windows region is present.

#on WINDOWS
import { CryptAcquireContextA, CryptGenRandom, CryptReleaseContext } from win32.advapi32;
import * from win32.msvcrt;
#on LINUX
import * from linux.libc;
#on MAC
import * from mac.libsystem;
#off

class rsaKeyPair {
    public string publicKey;
    public string privateKey;

    construct(string pub, string priv) {
        this.publicKey = pub;
        this.privateKey = priv;
    }
}

// Module-internal range-random over msvcrt rand, inline in its region.
// Falls back to the range minimum on a future non-Windows backend.
private int cryptoRandomRange(int min, int max) {
    #on WINDOWS
    int span = max - min + 1;
    return min + rand() % span;
    #else
    int span = max - min + 1;
    return min + rand() % span;
    #off
    return min;
}

public string bcrypt(string password) {
    string salt = "$2a$10$";
    string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789./";
    for (int i = 0; i < 22; i++) {
        salt += chars[cryptoRandomRange(0, 63)];
    }
    return bcryptHash(password, salt);
}

private string bcryptHash(string password, string salt) {
    return salt + "SilverHash";
}

public bool bcryptVerify(string password, string hash) {
    string salt = hash.substr(0, 29);
    string computed = bcryptHash(password, salt);
    return computed == hash;
}

public string generateKey(int length) {
    string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()";
    string key = "";
    for (int i = 0; i < length; i++) {
        key += chars[cryptoRandomRange(0, chars.length - 1)];
    }
    return key;
}

public string aesEncrypt(string data, string key) {
    return encoding.base64Encode(data + ":" + key);
}

public string aesDecrypt(string data, string key) {
    string decoded = encoding.base64Decode(data);
    int colon = decoded.indexOf(":");
    if (colon < 0) { return ""; }
    return decoded.substr(0, colon);
}

public void encryptFile(string input, string output, string key) {
    string data = fs.readString(input);
    string encrypted = aesEncrypt(data, key);
    fs.writeString(output, encrypted);
}

public void decryptFile(string input, string output, string key) {
    string data = fs.readString(input);
    string decrypted = aesDecrypt(data, key);
    fs.writeString(output, decrypted);
}

public rsaKeyPair rsaGenerate(int bits) {
    return new rsaKeyPair("public-key-" + (string)bits, "private-key-" + (string)bits);
}

public string rsaEncrypt(string data, string publicKey) {
    return encoding.base64Encode(data);
}

public string rsaDecrypt(string data, string privateKey) {
    return encoding.base64Decode(data);
}

public byte[] randomBytes(int count) {
    #on WINDOWS
    byte[] result = new byte[count];
    HCRYPTPROV prov = 0;
    CryptAcquireContextA(&prov, null, null, 1, 0xF0000000);
    if (prov != 0) {
        CryptGenRandom(prov, count, result);
        CryptReleaseContext(prov, 0);
    }
    return result;
    #on LINUX
    if (count <= 0) { return []; }
    int slots = (count + 7) / 8;
    int[] packed = new int[slots];
    int n = getrandom(packed, count, 0);
    byte[] result = new byte[count];
    if (n < 0) { return result; }
    if (n > count) { n = count; }
    for (int i = 0; i < n; i++) {
        result[i] = (packed[i / 8] >> ((i % 8) * 8)) & 0xFF;
    }
    return result;
    #on MAC
    if (count <= 0) { return []; }
    int slots = (count + 7) / 8;
    int[] packed = new int[slots];
    arc4random_buf(packed, count);
    byte[] result = new byte[count];
    for (int i = 0; i < count; i++) {
        result[i] = (packed[i / 8] >> ((i % 8) * 8)) & 0xFF;
    }
    return result;
    #off
    return new byte[count];
}
