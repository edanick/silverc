mod export crypto;
import * from fs;

// DOCS -- public `crypto` module (UNIFIED_CORE_LIBRARY.md v2 canonical fold).
// This is the universal crypto module: there is no crypto_win.sr backend and
// no win-named helpers -- one module, one OS layer (crypto -> win32.advapi32
// + win32.msvcrt). The canonical shape puts each raw OS call INSIDE its
// public/private function's body behind a `#on WINDOWS` ... `#off` region:
// one unified function name, no wrapper indirection, no `#else`, no
// LINUX/MAC placeholders (the non-Windows regions get filled on their own
// machines later). The osType() runtime gates are gone: the preprocessor
// replaces them, so `import * from os;` is not needed here.
//
// IMPORT SHAPE: everything in this module is tabled on both compilers except
// the Crypt* trio -- advapi32 does not export-register CryptAcquireContextA/
// CryptGenRandom/CryptReleaseContext in either compiler's per-DLL export
// table (only the Reg*/GetUserNameA registry set), so the star form cannot
// answer them; they are bound instead through PLAIN single-export grants
// (`import { CryptAcquireContextA, ... } from win32.advapi32;` -- no `as Y`
// aliasing), which resolve by local name on both compilers exactly the way
// the pre-fold backend's grants did, with the PE import keeping the real
// export. rand IS tabled (msvcrt) on both compilers, so it takes the
// canonical star form. Everything else in this file is pure Silver and
// keeps its pre-fold shape ungated.
//
// BASE64 NOTE (deviation, documented): the pre-fold file delegated its
// aes*/rsa* payloads to encoding.base64Encode/base64Decode, but
// std/encoding.sr is broken on BOTH compilers (its `data.toBytes()` opening
// crashes the self-host at runtime and yields an empty/garbage string on
// silverc-rs), and no std module or test exercises it successfully --
// pre-fold this was unreachable because importing crypto itself failed
// everywhere (see PRE-FOLD STATE below). Since encoding.sr is outside this
// fold's file scope, the base64 codec lives here as private pure-Silver
// helpers (cryptoBase64Encode/cryptoBase64Decode) implementing the standard
// RFC 4648 alphabet with '=' padding, built only from primitives probed
// byte-identical on both compilers (string indexing, int shifts/masks,
// string += char, char() casts). This restores the functions' documented
// contract (aesEncrypt = base64("data:key"), rsaEncrypt = base64(data),
// aesDecrypt = the "data" part of the decoded payload) instead of
// preserving a crash; if encoding.sr is ever fixed, these helpers can
// delegate to it again.
//
// RNG NOTE: the pre-fold file called `time.random(...)` for salt/key
// material -- a function that exists NOWHERE (not in std/time.sr, not as a
// builtin on either compiler), so those calls were dead. The pre-fold
// `import {random} from time;` line was part of that dead wiring and is not
// carried over. UNIFIED_CORE_LIBRARY.md's audit already attributed an msvcrt
// rand() to this module, so the range-random routes through the
// cryptoRandomRange region into msvcrt rand. Swapping the CRT rand for a
// stronger unified RNG (and making bcryptHash actually hash) remains future
// work; this fold does not redesign either.
//
// PRE-FOLD STATE (important for A/B baselines): before the v1 split, a user
// file importing crypto failed to compile on BOTH compilers -- silverc-rs
// rejected this file's old `import {a, b} from encoding;` lines (the braced
// form names native modules per DOCS/213, so resolution failed with unknown
// module "base64Encode"/...), and the self-hosted compiler parsed the file
// but died in codegen on the backend-less Crypt* calls inside randomBytes.
// The deterministic results -- base64 payloads, round-trip equality,
// key/salt lengths, the bcrypt prefix/length/verify contract -- follow the
// documented API contract. One pre-existing compiler asymmetry remains
// (unchanged by this fold, needs no compiler work here): silverc-rs cannot
// consume exported CLASS types from source modules (rsaKeyPair as a
// user-local type fails with the standard rs parser error "unknown keyword
// rsaKeyPair"), so rsaGenerate's return value is only directly usable on
// the self-hosted compiler; the string-based rsaEncrypt/rsaDecrypt pair
// works everywhere.
//
// NON-WINDOWS FALLBACK: randomBytes returns a zero-filled array of the
// requested length and cryptoRandomRange returns its minimum when no
// Windows region is present (the module's existing failure style --
// pre-fold the acquire-failure path also returned the zeroed array).

#on WINDOWS
import { CryptAcquireContextA, CryptGenRandom, CryptReleaseContext } from win32.advapi32;
import * from win32.msvcrt;
#off

class rsaKeyPair {
    public string publicKey;
    public string privateKey;

    construct(string pub, string priv) {
        this.publicKey = pub;
        this.privateKey = priv;
    }
}

// Module-internal range-random over msvcrt rand, inline in its region.
// Falls back to the range minimum on a future non-Windows backend.
private int cryptoRandomRange(int min, int max) {
    #on WINDOWS
    int span = max - min + 1;
    return min + rand() % span;
    #off
    return min;
}

// Standard RFC 4648 base64 with '=' padding; private portable codec (see
// BASE64 NOTE). Works purely on string indexing, int arithmetic and string
// += char appends. if/else bodies everywhere -- the self-host rejects
// string ternaries.
private string cryptoBase64Encode(string data) {
    string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    string result = "";
    for (int i = 0; i < data.length; i += 3) {
        int b0 = data[i];
        int b1 = 0;
        int b2 = 0;
        if (i + 1 < data.length) { b1 = data[i + 1]; }
        if (i + 2 < data.length) { b2 = data[i + 2]; }
        int triple = (b0 << 16) | (b1 << 8) | b2;
        result += chars[(triple >> 18) & 0x3F];
        result += chars[(triple >> 12) & 0x3F];
        if (i + 1 < data.length) {
            result += chars[(triple >> 6) & 0x3F];
        } else {
            result += '=';
        }
        if (i + 2 < data.length) {
            result += chars[triple & 0x3F];
        } else {
            result += '=';
        }
    }
    return result;
}

// Inverse of cryptoBase64Encode: decodes the standard alphabet, stops at
// '=' padding, skips characters outside the alphabet.
private string cryptoBase64Decode(string data) {
    string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    string result = "";
    int acc = 0;
    int bits = 0;
    for (int i = 0; i < data.length; i++) {
        char c = data[i];
        if (c == '=') { break; }
        int v = -1;
        for (int j = 0; j < chars.length; j++) {
            if (chars[j] == c) {
                v = j;
                break;
            }
        }
        if (v < 0) { continue; }
        acc = (acc << 6) | v;
        bits += 6;
        if (bits >= 8) {
            bits -= 8;
            result += char((acc >> bits) & 0xFF);
        }
    }
    return result;
}

public string bcrypt(string password) {
    string salt = "$2a$10$";
    string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789./";
    for (int i = 0; i < 22; i++) {
        salt += chars[cryptoRandomRange(0, 63)];
    }
    return bcryptHash(password, salt);
}

private string bcryptHash(string password, string salt) {
    return salt + "SilverHash";
}

public bool bcryptVerify(string password, string hash) {
    string salt = hash.substr(0, 29);
    string computed = bcryptHash(password, salt);
    return computed == hash;
}

public string generateKey(int length) {
    string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()";
    string key = "";
    for (int i = 0; i < length; i++) {
        key += chars[cryptoRandomRange(0, chars.length() - 1)];
    }
    return key;
}

public string aesEncrypt(string data, string key) {
    return cryptoBase64Encode(data + ":" + key);
}

public string aesDecrypt(string data, string key) {
    string decoded = cryptoBase64Decode(data);
    int colon = decoded.indexOf(":");
    if (colon < 0) { return ""; }
    return decoded.substr(0, colon);
}

public void encryptFile(string input, string output, string key) {
    string data = fs.readString(input);
    string encrypted = aesEncrypt(data, key);
    fs.writeString(output, encrypted);
}

public void decryptFile(string input, string output, string key) {
    string data = fs.readString(input);
    string decrypted = aesDecrypt(data, key);
    fs.writeString(output, decrypted);
}

public rsaKeyPair rsaGenerate(int bits) {
    return new rsaKeyPair("public-key-" + bits, "private-key-" + bits);
}

public string rsaEncrypt(string data, string publicKey) {
    return cryptoBase64Encode(data);
}

public string rsaDecrypt(string data, string privateKey) {
    return cryptoBase64Decode(data);
}

public byte[] randomBytes(int count) {
    #on WINDOWS
    byte[] result = new byte[count];
    HCRYPTPROV prov = 0;
    CryptAcquireContextA(&prov, null, null, 1, 0xF0000000);
    if (prov != 0) {
        CryptGenRandom(prov, count, result);
        CryptReleaseContext(prov, 0);
    }
    return result;
    #off
    return new byte[count];
}
