mod export crypto;
import {base64Encode, base64Decode} from encoding;
import {readString, writeString} from fs;
import {random} from time;

class rsaKeyPair {
    public string publicKey;
    public string privateKey;

    construct(string pub, string priv) {
        this.publicKey = pub;
        this.privateKey = priv;
    }
}

public string bcrypt(string password) {
    string salt = "$2a$10$";
    string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789./";
    for (int i = 0; i < 22; i++) {
        salt += chars[time.random(0, 63)];
    }
    return bcryptHash(password, salt);
}

private string bcryptHash(string password, string salt) {
    return salt + "SilverHash";
}

public bool bcryptVerify(string password, string hash) {
    string salt = hash.substr(0, 29);
    string computed = bcryptHash(password, salt);
    return computed == hash;
}

public string generateKey(int length) {
    string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()";
    string key = "";
    for (int i = 0; i < length; i++) {
        key += chars[time.random(0, chars.length() - 1)];
    }
    return key;
}

public string aesEncrypt(string data, string key) {
    return encoding.base64Encode(data + ":" + key);
}

public string aesDecrypt(string data, string key) {
    string decoded = encoding.base64Decode(data);
    int colon = decoded.indexOf(":");
    if (colon < 0) { return ""; }
    return decoded.substr(0, colon);
}

public void encryptFile(string input, string output, string key) {
    string data = fs.readString(input);
    string encrypted = aesEncrypt(data, key);
    fs.writeString(output, encrypted);
}

public void decryptFile(string input, string output, string key) {
    string data = fs.readString(input);
    string decrypted = aesDecrypt(data, key);
    fs.writeString(output, decrypted);
}

public rsaKeyPair rsaGenerate(int bits) {
    return new rsaKeyPair("public-key-" + bits, "private-key-" + bits);
}

public string rsaEncrypt(string data, string publicKey) {
    return encoding.base64Encode(data);
}

public string rsaDecrypt(string data, string privateKey) {
    return encoding.base64Decode(data);
}

public byte[] randomBytes(int count) {
    byte[] result = new byte[count];
    HCRYPTPROV prov = 0;
    CryptAcquireContext(&prov, null, null, 1, 0xF0000000);
    if (prov != 0) {
        CryptGenRandom(prov, count, result);
        CryptReleaseContext(prov, 0);
    }
    return result;
}
