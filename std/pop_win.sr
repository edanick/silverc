import { socket as popWinRawSocket, connect as popWinRawConnect, recv as popWinRawRecv, send as popWinRawSend, closesocket as popWinRawClose, inet_addr as popWinRawInetAddr, setsockopt as popWinRawSetSockopt, WSAStartup as popWinRawStartup } from win32.ws2_32;

internal mod export pop_win;

// DOCS -- INTERNAL Windows backend of the public `pop` module
// (UNIFIED_CORE_LIBRARY.md Phase 2). Every ws2_32 DLL call the pop module
// needs lives here and nowhere else: the public wrapper (std/pop.sr) contains
// zero win32 imports and reaches this code only behind the OS gate
// `if (osType() == OSTypes.WINDOWS)`. See std/os.sr for why the gate calls
// the plain-Silver osType() stand-in instead of the native os.type query.
//
// Everything in this file is project-internal: the `internal mod export`
// marker plus `internal` on every function keep the backend from leaking to
// user projects. A user file that tries `import * from pop_win;` fails with
// the standard internal-visibility error on both compilers (same posture as
// std/smtp_win.sr / std/ftp_win.sr, probed there; re-probed for pop_win).
//
// IMPORT GRANTS -- ALL ALIASED (UNIFIED_CORE_LIBRARY.md phase 2 `X as Y`
// form, the std/smtp_win.sr probed posture): none of the ws2_32 exports
// granted here (socket/connect/recv/send/closesocket/inet_addr/setsockopt/
// WSAStartup) collide with a name in the pop public API (classes client and
// message with construct/login/count/retrieve/remove/list/quit plus the
// additive getLastReply/isLoggedIn; free functions isOk/isErr/
// multiLineComplete/statCount/statSize/headerValue/messageBody), so -- unlike
// std/ws_win.sr and std/net_win.sr, which alias only the colliding names --
// no alias is REQUIRED for namespace reasons; the class names `client` and
// `message` match no ws2_32 export and the client METHOD names (login/count/
// retrieve/remove/list/quit/...) are class-scoped and never collide with flat
// DLL grants (the probed ws_win.sr pattern). EVERY grant is aliased anyway,
// probed-verified posture: with the direct (unaliased) grant shape shared by
// std/ftp_win.sr/std/net_win.sr, silverc-rs mis-lowers the raw `send`/`recv`
// calls (a probed two-program exchange delivered 2 garbage bytes per call in
// BOTH directions while the same binaries built by the self-host exchanged
// the exact payloads -- see the std/ftps.sr caller notes), while the aliased
// calls (rawSocket/rawConnect, the smtp_win shape) work on rs. Aliasing all
// eight grants routes every call through the probed-working aliased path on
// both compilers and costs nothing (the PE import keeps the real export
// names). This backend is transport-only, so the bind/listen/accept grants
// the ftp backend needs are NOT granted here (a backend grants exactly what
// it uses -- std/math_win.sr precedent); POP3 has no client-side listener.
//
// MEMORY LAYOUT (identical to std/smtp_win.sr / std/ftp_win.sr, probed
// there): Silver arrays are [cap, len, elem...] with 8-byte elements, so an
// int[] doubles as a packed qword buffer for DLL calls; `byte[]` must NOT
// cross a DLL boundary as a packed buffer, so send packs payloads into an
// int[] and receive unpacks recv's bytes out of an int[] with shifts.
// Strings ARE packed byte buffers: data[i] reads one byte. sockaddr_in
// (16 bytes) is packed into one int[2] via popWinFillSockaddr, byte-for-byte
// the probed smtpWinFillSockaddr/ftpWinFillSockaddr algorithm (`struct
// sockaddr_in` locals and `&addr` are unexpressible in Silver -- the same
// phantom syntax that kept the pre-split std/pop.sr from compiling
// anywhere, probed on both compilers).
//
// WSAStartup: issued before each socket creation; it is reference-counted,
// so the repeated calls are harmless. The pre-split pop.sr never called it
// at all (winsock would have stayed uninitialized) -- a documented fix, not
// a regression: the pre-split file never compiled anywhere (see std/pop.sr
// PRE-SPLIT STATE).
//
// DLL RETURN NORMALIZATION (see std/smtp_win.sr for the general rule): the
// self-hosted compiler ZERO-extends 32-bit DLL int returns, silverc-rs
// sign-extends them, so SOCKET_ERROR (-1) arrives as 4294967295 on the
// self-host and -1 on rs. Every return below that can be SOCKET_ERROR
// (socket/connect/recv; send/closesocket/setsockopt results are deliberately
// ignored -- see each function) is normalized with the two-sided check
// `v < 0 || v > 2147483647`, which is correct on both compilers and cannot
// misfire: valid SOCKET handles are small positive values far below 2^31.
//
// RECEIVE TIMEOUT: popWinConnect arms SO_RCVTIMEO (SOL_SOCKET 0xFFFF,
// SO_RCVTIMEO 0x1006, 30000 ms as a DWORD in the low half of one int[]
// qword slot) on every socket it returns. The pre-split file had no timeout
// at all (and never ran); with the timeout, every read in the public client
// is bounded: a peer that accepts and then goes silent cannot hang a probe
// past 30 s per read -- the read simply returns SOCKET_ERROR, which
// popWinReceive reports as "".
//
// SCOPE: this backend is TRANSPORT ONLY. The POP3 protocol itself (+OK/-ERR
// status scanning, USER/PASS/STAT/LIST/RETR/DELE/QUIT command text, STAT
// number parsing, header/body extraction) is pure Silver and lives in the
// public wrapper (std/pop.sr) -- backends exist only where real DLL-backed
// operations exist. This file compiles standalone (primitives only, no
// wrapper-class references).

internal int popWinStartup() {
    byte[] wsa = new byte[408];
    return popWinRawStartup(0x0202, wsa);
}

// Packs family/port/addr into the sockaddr_in image (two qwords). `ip` is
// the network-order u32 that inet_addr returns; 0 means INADDR_ANY.
internal void popWinFillSockaddr(int[] sa, int port, int ip) {
    int pHi = (port >> 8) & 0xFF;
    int pLo = port & 0xFF;
    sa[0] = 2 | (pHi << 16) | (pLo << 24) | ((ip & 0xFFFFFFFF) << 32);
    sa[1] = 0;
}

// Opens a TCP connection to host:port and arms the receive timeout. Returns
// the socket handle, or -1 on any failure (startup, socket, connect -- all
// normalized per the DLL-return note above).
internal int popWinConnect(string host, int port) {
    popWinStartup();
    int sock = popWinRawSocket(2, 1, 0);
    if (sock < 0 || sock > 2147483647) { return -1; }
    int ip = popWinRawInetAddr(host);
    int[] sa = new int[2];
    popWinFillSockaddr(sa, port, ip);
    int rc = popWinRawConnect(sock, sa, 16);
    if (rc < 0 || rc > 2147483647) {
        popWinRawClose(sock);
        return -1;
    }
    int[] opt = new int[1];
    opt[0] = 30000;
    popWinRawSetSockopt(sock, 0xFFFF, 0x1006, opt, 4);
    return sock;
}

// Sends the first `len` bytes of `data` (clamped to data.length): packed
// byte-for-byte into int[] qword slots before the send() call (byte[] must
// not cross the DLL boundary packed). The explicit length mirrors the
// smtpWinSend shape (single-line commands are sent with their one CRLF). The
// send result (byte count or SOCKET_ERROR) is deliberately ignored: the
// pre-split senders never checked it either.
internal void popWinSend(int fd, string data, int len) {
    if (len <= 0) { return; }
    if (len > data.length) { len = data.length; }
    int slots = (len + 7) / 8;
    int[] packedBuf = new int[slots];
    for (int i = 0; i < len; i++) {
        int b = int(data[i]);
        packedBuf[i / 8] = packedBuf[i / 8] | ((b & 0xFF) << ((i % 8) * 8));
    }
    popWinRawSend(fd, packedBuf, len, 0);
}

// Receives up to maxLen raw bytes; returns them as a string. Returns "" on
// disconnect, timeout, or a zero-extended SOCKET_ERROR (see the DLL-return
// note above) -- the caller cannot distinguish those, which is the desired
// graceful-failure shape for every control read.
internal string popWinReceive(int fd, int maxLen) {
    if (maxLen <= 0) { return ""; }
    int slots = (maxLen + 7) / 8;
    int[] buf = new int[slots];
    int n = popWinRawRecv(fd, buf, maxLen, 0);
    if (n <= 0 || n > 2147483647) { return ""; }
    string result = "";
    for (int i = 0; i < n; i++) {
        int b = (buf[i / 8] >> ((i % 8) * 8)) & 0xFF;
        char c = char(b);
        result += c.toString();
    }
    return result;
}

internal void popWinClose(int fd) {
    popWinRawClose(fd);
}
