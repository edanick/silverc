mod export bom;

public bool hasBom(string text) {
    return text.length >= 3
        && text[0] == char(0xEF)
        && text[1] == char(0xBB)
        && text[2] == char(0xBF);
}

public string strip(string text) {
    if (hasBom(text)) { return text[3..text.length]; }
    return text;
}

public string prepend(string text) {
    if (hasBom(text)) { return text; }
    return "\xEF\xBB\xBF" + text;
}
