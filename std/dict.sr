mod export dict;

class dict<K, V> {
    private prop K[] _keys;
    private prop V[] _values;
    private prop int _count;

    construct () {
        this._keys = [];
        this._values = [];
        this._count = 0;
    }

    public void set(K key, V value) {
        for (int i = 0; i < this._count; i++) {
            if (this._keys[i] == key) {
                this._values[i] = value;
                return;
            }
        }
        this._keys.push(key);
        this._values.push(value);
        this._count++;
    }

    public V? get(K key) {
        for (int i = 0; i < this._count; i++) {
            if (this._keys[i] == key) {
                return this._values[i];
            }
        }
        return null;
    }

    public bool contains(K key) {
        for (int i = 0; i < this._count; i++) {
            if (this._keys[i] == key) {
                return true;
            }
        }
        return false;
    }

    public int count() {
        return this._count;
    }
}