mod export parser;

import * from token;
import * from node;
import * from lexer;

class Parser {
    private prop Token[] tokens;
    private prop int pos;
    // Inside a `[...]` index, a top-level `..` (token 144) starts a slice
    // rather than a binary range expression.
    private bool rangeIsSliceBoundary;
    // ---- EXCEPTIONS/*.md diagnostics --------------------------------------
    // Recoverable syntax errors, one message per line, in source order
    // (SYNTAX_EXCEPTIONS.md #4).  The driver prints them all and exits.
    public prop string[] diagErrors;
    // Missing-semicolon positions, flushed as ONE merged message at the end
    // of parseProgram.
    private int[] missingSemiLines;
    private int[] missingSemiCols;
    // Lowercase user-declared type names (def/enum/struct/class/typealias):
    // `direction dir = ...` is a declaration, not an unknown keyword.
    private string[] declaredTypes;
    // Identifiers with known meaning that may appear as bare statements
    // (builtins plus every function/const name parsed so far).
    private string[] knownIdents;
    // Parsed function signatures for TYPE_EXCEPTIONS call-arg checks:
    // parallel arrays; types/names joined with commas per signature.
    private string[] sigNames;
    private string[] sigTypes;
    private string[] sigParams;
    private int[] sigVariadic;
    // Per-line character lengths (1-based indexing via line-1) used to point
    // just past the end of a line for missing-bracket diagnostics.
    private int[] lineLens;
    // win32 grants recorded from import statements (DOCS/213): a full open
    // (`import * from win32;`), opened module names (`win32.<mod>`), and
    // individually granted export names.  Used by the post-parse
    // unknown-method walk so free Win32 calls are never flagged.
    private bool win32AllModules;
    private string[] win32OpenModules;
    private string[] win32GrantNames;
    // linux grants recorded from import statements (LINUX.md Phase B): a
    // full open (`import * from linux;`), opened module names
    // (`linux.libc`, `linux.x11`, `linux.xtst`), and individually granted
    // export names. Mirrors the win32 trio above; used by the same
    // unknown-method walk so free libc/X11 calls are never flagged. Like
    // win32, `linux.libc` is the public systems surface while the other
    // linux.* modules stay std-internal (enforced by visibility.sr).
    private bool linuxAllModules;
    private string[] linuxOpenModules;
    private string[] linuxGrantNames;
    // DOCS/261 -- per-project custom native modules (`.srp` `nativeModules`).
    // Declared custom names resolve per target OS (bare `import { f } from m;`
    // uses the `windows` file on WINDOWS/MAC, the `linux` file on LINUX; star
    // needs an export list). Fixed `win32.*`/`linux.*` tables above are
    // untouched; custom grants skip the std-internal rule (manifest opt-in).
    // Empty when the manifest declares none (absent key = no change).
    public NativeModules customNative;
    public string customTargetOs;
    // `mod export NAME;` declarations and inline `mod NAME { ... }` blocks:
    // names plus their `internal` flag (DOCS/258). The flattened program
    // drops these containers, so the visibility pass reads them from here.
    public string[] modExportNames;
    public bool[] modExportInternal;
    // `internal:` section marker active inside the class body being parsed
    // (reset by `public:`/`private:` and at the start of every class).
    private bool classSectionInternal;
    // DOCS/259 -- function-typed parameters (`void () name`) of the function
    // whose body the call-diagnostics walk is currently inside. A zero-arg
    // call to one of these names invokes the stored address instead of a
    // declared function, so the unknown-call check must accept it.
    private string[] fnPtrCallScope;
    // DOCS/259 -- top-level variable names, collected before the diagnostics
    // walk. Anonymous function bodies are isolated scopes: their identifier
    // uses resolve against their own locals, these globals, and the file's
    // known symbols -- never against the enclosing function's locals.
    private string[] anonKnownGlobals;
    // Depth of anonymous-function bodies the diagnostics walk is inside.
    private int anonWalkDepth;

    construct (Token[] toks) {
        this.tokens = toks;
        this.pos = 0;
        this.rangeIsSliceBoundary = false;
        this.diagErrors = [];
        this.missingSemiLines = [];
        this.missingSemiCols = [];
        this.declaredTypes = [];
        this.knownIdents = [];
        this.sigNames = [];
        this.sigTypes = [];
        this.sigParams = [];
        this.sigVariadic = [];
        this.lineLens = [];
        this.win32AllModules = false;
        this.win32OpenModules = [];
        this.win32GrantNames = [];
        this.linuxAllModules = false;
        this.linuxOpenModules = [];
        this.linuxGrantNames = [];
        this.customNative = new NativeModules();
        this.customTargetOs = "";
        this.modExportNames = [];
        this.modExportInternal = [];
        this.classSectionInternal = false;
        this.fnPtrCallScope = [];
        this.anonKnownGlobals = [];
        this.anonWalkDepth = 0;
    }

    // Provide per-line character lengths so bracket diagnostics can point
    // just past the end of a line (SYNTAX_EXCEPTIONS.md #3).
    public void setLineLengths(int[] lens) {
        this.lineLens = lens;
    }

    private void recordError(string msg) {
        this.diagErrors.add(msg);
    }

    // Source width of a token (quotes included for literals), used for
    // insertion-point columns of missing `;` / `,` / `)`.
    private int tokenSrcLen(Token t) {
        if (t.kind == 3 || t.kind == 4) { return t.text.length + 2; }
        return t.text.length;
    }

    private int prevEndLine() {
        if (this.pos == 0) { return this.peek().line; }
        return this.tokens[this.pos - 1].line;
    }

    private int prevEndCol() {
        if (this.pos == 0) { return this.peek().col; }
        Token prev = this.tokens[this.pos - 1];
        return prev.col + this.tokenSrcLen(prev);
    }

    // Column one past the last character of the given line (1-based), or -1
    // when line lengths were not provided.
    private int lineEndCol(int line) {
        if (line >= 1 && line <= this.lineLens.length) { return this.lineLens[line - 1] + 1; }
        return -1;
    }

    // Statement-final semicolon: consume it, or record the position and keep
    // parsing (SYNTAX_EXCEPTIONS.md "Missing semicolons").  EOF tolerates
    // the final statement of a file, and a preceding `}` already terminates
    // braced statements (match/switch/block expressions).
    private void expectSemi() {
        if (this.check(106)) { this.advance(); return; }
        if (this.check(0)) { return; }
        if (this.pos > 0 && this.tokens[this.pos - 1].kind == 103) { return; }
        this.missingSemiLines.add(this.prevEndLine());
        this.missingSemiCols.add(this.prevEndCol());
    }

    // All Silver keywords, used for did-you-mean suggestions.
    public string[] keywordCandidates() {
        string[] cands = [];
        cands.add("if"); cands.add("else"); cands.add("elif"); cands.add("while");
        cands.add("for"); cands.add("foreach"); cands.add("return"); cands.add("match");
        cands.add("void"); cands.add("int"); cands.add("int32"); cands.add("int64");
        cands.add("uint"); cands.add("float"); cands.add("float64"); cands.add("double");
        cands.add("bool"); cands.add("byte"); cands.add("char"); cands.add("string");
        cands.add("var"); cands.add("struct"); cands.add("class"); cands.add("enum");
        cands.add("def"); cands.add("found"); cands.add("collect"); cands.add("mod");
        cands.add("export"); cands.add("import"); cands.add("from"); cands.add("as");
        cands.add("new"); cands.add("const"); cands.add("true"); cands.add("false");
        cands.add("null"); cands.add("public"); cands.add("private"); cands.add("static");
        cands.add("prop"); cands.add("construct"); cands.add("unset"); cands.add("local");
        cands.add("alias"); cands.add("fixed"); cands.add("live"); cands.add("once");
        cands.add("shared"); cands.add("mut"); cands.add("ref"); cands.add("try");
        cands.add("catch"); cands.add("finally"); cands.add("throw"); cands.add("to");
        cands.add("in"); cands.add("break"); cands.add("continue"); cands.add("switch");
        cands.add("case"); cands.add("typealias"); cands.add("loop");
        cands.add("internal");
        return cands;
    }

    private bool identStartsLower(string word) {
        if (word.length == 0) { return false; }
        char fc = word[0];
        return fc >= 'a' && fc <= 'z';
    }

    // True when a statement-leading lowercase identifier is an unknown
    // keyword: not heading a declaration shape, and not an identifier with
    // known meaning (SYNTAX_EXCEPTIONS.md).
    private bool identShouldFlag(Token cur, int nk) {
        if (!this.identStartsLower(cur.text)) { return false; }
        // Primitive type words that lex as identifiers (e.g. `double`) head
        // declarations, never unknown keywords.
        if (this.strEq(cur.text, "double") || this.strEq(cur.text, "long")
            || this.strEq(cur.text, "uint") || this.strEq(cur.text, "byte")
            || this.strEq(cur.text, "int32") || this.strEq(cur.text, "int64")
            || this.strEq(cur.text, "float64") || this.strEq(cur.text, "string")
            || this.strEq(cur.text, "boolean")) { return false; }
        // Any `T ident` (or `T[] ident`, `T? ident`, `<T> ident`)
        // declaration shape is accepted — the declaration type name is
        // validated later (type checker / codegen resolve it against the
        // flattened aggregate), mirroring the rs compiler's decl-shape
        // heuristic.  This covers imported classes the parser has not
        // reached yet and same-file classes declared after use.
        if (nk == 7 && this.pos + 2 < this.tokens.length && this.tokens[this.pos + 2].kind == 100) {
            // `T name (` is a function-signature shape — legacy sources use
            // non-keyword return spellings there; leave it to parseFunction.
            return false;
        }
        if (nk == 7 || nk == 104 || nk == 123 || nk == 120) {
            return false;
        }
        return !this.knownIdentName(cur.text);
    }

    // `print"hello world");` — an identifier immediately followed by a string
    // literal: the open parenthesis of the call is missing and is reported at
    // the string literal's position.
    private Node parseCallMissingOpenParen() {
        Token nameTok = this.advance();
        Token strTok = this.peek();
        string lit = "";
        if (strTok.kind == 3) { lit = strTok.strVal; }
        this.advance();
        if (this.check(101)) { this.advance(); }
        this.recordError("Missing open parenthesis at line " + strTok.line.toString() + ", column " + strTok.col.toString());
        this.expectSemi();
        Node call = new Node(); call.kind = 10;
        call.name = nameTok.text;
        Node strNode = new Node(); strNode.kind = 2;
        strNode.strVal = lit;
        strNode.line = strTok.line; strNode.col = strTok.col;
        call.children.add(strNode);
        Node stmt = new Node(); stmt.kind = 61;
        stmt.children.add(call);
        return stmt;
    }

    private bool isDeclaredTypeName(string name) {
        for (int i = 0; i < this.declaredTypes.length; i++) {
            if (this.strEq(this.declaredTypes[i], name)) { return true; }
        }
        return false;
    }

    private bool knownIdentName(string name) {
        for (int i = 0; i < this.knownIdents.length; i++) {
            if (this.strEq(this.knownIdents[i], name)) { return true; }
        }
        if (this.strEq(name, "cargs") || this.strEq(name, "getCommandLine")
            || this.strEq(name, "print") || this.strEq(name, "printline")
            || this.strEq(name, "eprint") || this.strEq(name, "eprintln")
            || this.strEq(name, "exit") || this.strEq(name, "input")
            || this.strEq(name, "sleep") || this.strEq(name, "assert")
            || this.strEq(name, "strlen") || this.strEq(name, "now")) { return true; }
        return false;
    }

    private void registerDeclaredType(string name) {
        if (!this.isDeclaredTypeName(name)) { this.declaredTypes.add(name); }
    }

    private void recordModExport(string name, bool isInternal) {
        this.modExportNames.add(name);
        if (isInternal) { this.modExportInternal.add(true); } else { this.modExportInternal.add(false); }
    }

    // Can the token kind continue an identifier as a real expression or
    // declaration?  If not, a lowercase statement-leading identifier is an
    // unknown keyword (SYNTAX_EXCEPTIONS.md).
    private bool tokenContinuesExpr(int nk) {
        if (nk == 100 || nk == 108 || nk == 104 || nk == 110) { return true; }
        if (nk == 130 || nk == 131 || nk == 132 || nk == 133 || nk == 115) { return true; }
        if (nk == 116 || nk == 117 || nk == 118 || nk == 160 || nk == 158 || nk == 159) { return true; }
        if (nk == 161 || nk == 162 || nk == 142 || nk == 143) { return true; }
        if (nk == 123 || nk == 148 || nk == 144 || nk == 147) { return true; }
        if (nk == 109 || nk == 120 || nk == 140) { return true; }
        return false;
    }

    // Flag an unknown keyword / keyword typo at the token's position.
    private void flagUnknownKeywordAt(Token t) {
        string sugg = diagClosestMatch(t.text, this.keywordCandidates());
        if (sugg.length > 0) {
            this.recordError("did you mean \"" + sugg + "\"?, at line " + t.line.toString() + ", column " + t.col.toString());
        } else {
            this.recordError("unknown keyword \"" + t.text + "\" at line " + t.line.toString() + ", column " + t.col.toString());
        }
    }

    // No-op expression-statement node used during error recovery.
    private Node noopNode() {
        Node n = new Node(); n.kind = 61;
        Node zero = new Node(); zero.kind = 0; zero.intVal = 0;
        n.children.add(zero);
        return n;
    }

    // Skip ahead to the next top-level statement boundary: past a terminating
    // semicolon, or to the first token on a later line — whichever first.
    private void syncToStatementEnd() {
        while (!this.check(0) && !this.check(103)) {
            int line = this.peek().line;
            if (this.check(106)) { this.advance(); return; }
            this.advance();
            if (this.pos < this.tokens.length && this.tokens[this.pos].line > line) { return; }
        }
    }

    // TYPE_EXCEPTIONS.md fundamental value classes that must never mix
    // silently: numbers/chars interoperate; strings and booleans do not.
    private int typeFamily(string t) {
        for (int i = 0; i < t.length; i++) {
            char c = t[i];
            if (c == '[' || c == ']' || c == '?' || c == '<' || c == '>' || c == '.' || c == ',') { return -1; }
        }
        if (this.strEq(t, "int") || this.strEq(t, "int32") || this.strEq(t, "int64")
            || this.strEq(t, "uint") || this.strEq(t, "byte") || this.strEq(t, "float")
            || this.strEq(t, "float64") || this.strEq(t, "double") || this.strEq(t, "char")) { return 0; }
        if (this.strEq(t, "string")) { return 1; }
        if (this.strEq(t, "bool")) { return 2; }
        return -1;
    }

    private int literalFamily(Node n) {
        if (n.kind == 0 || n.kind == 1 || n.kind == 3) { return 0; }
        if (n.kind == 2) { return 1; }
        if (n.kind == 4) { return 2; }
        return -1;
    }

    private string literalTypeName(Node n) {
        if (n.kind == 0) { return "int"; }
        if (n.kind == 1) { return "float"; }
        if (n.kind == 2) { return "string"; }
        if (n.kind == 3) { return "char"; }
        if (n.kind == 4) { return "bool"; }
        return "var";
    }

    // `an int`, `a string`, ... for exception message phrasing.
    private string articleOf(string typeName) {
        if (typeName.length == 0) { return "a " + typeName; }
        char fc = typeName[0];
        if (fc == 'a' || fc == 'e' || fc == 'i' || fc == 'o') { return "an " + typeName; }
        return "a " + typeName;
    }

    // Split a comma-joined signature component back into entries.
    private string[] splitSigList(string joined) {
        string[] parts = [];
        string cur = "";
        for (int i = 0; i < joined.length; i++) {
            char c = joined[i];
            if (c == ',') { parts.add(cur); cur = ""; }
            else { cur = cur + charToString(c); }
        }
        parts.add(cur);
        return parts;
    }

    // VALUE_EXCEPTION.md — a numeric parse conversion receiving a non-numeric
    // string literal raises a ValueException pointing at the literal.
    private bool stringIsNumber(string s, bool wantInt) {
        string t = "";
        int start = 0;
        int end = s.length;
        while (start < end && s[start] == ' ') { start = start + 1; }
        while (end > start && s[end - 1] == ' ') { end = end - 1; }
        for (int i = start; i < end; i++) { t = t + charToString(s[i]); }
        int len = t.length;
        if (len == 0) { return false; }
        int i2 = 0;
        if (t[0] == '+' || t[0] == '-') { i2 = 1; }
        if (i2 >= len) { return false; }
        bool sawDigit = false;
        bool sawDot = false;
        bool sawExp = false;
        while (i2 < len) {
            char c = t[i2];
            if (c >= '0' && c <= '9') { sawDigit = true; }
            elif (c == '.' && !wantInt && !sawDot && !sawExp) { sawDot = true; }
            elif ((c == 'e' || c == 'E') && !wantInt && sawDigit && !sawExp) {
                sawExp = true;
                if (i2 + 1 < len && (t[i2 + 1] == '+' || t[i2 + 1] == '-')) { i2 = i2 + 1; }
                if (i2 + 1 >= len) { return false; }
            }
            else { return false; }
            i2 = i2 + 1;
        }
        return sawDigit;
    }

    // TYPE_EXCEPTIONS.md — chained parameter type mismatches for a plain
    // call whose callee matches a signature parsed in this file.
    private void checkCallArgTypes(Node call) {
        int idx = -1;
        for (int i = 0; i < this.sigNames.length; i++) {
            if (this.strEq(this.sigNames[i], call.name)) { idx = i; break; }
        }
        if (idx < 0) { return; }
        string bestSegs = "";
        int bestCount = 0;
        // Accept the call when any same-named signature fits its arguments.
        for (int m = 0; m < this.sigNames.length; m++) {
            if (!this.strEq(this.sigNames[m], call.name)) { continue; }
            string[] types = this.splitSigList(this.sigTypes[m]);
            string[] names = this.splitSigList(this.sigParams[m]);
            int limit = types.length;
            if (call.childCount() < limit) { limit = call.childCount(); }
            if (this.sigVariadic[m] == 1 && limit > types.length - 1) { limit = types.length - 1; }
            string segs = "";
            int count = 0;
            for (int j = 0; j < limit; j++) {
                int pf = this.typeFamily(types[j]);
                if (pf < 0) { continue; }
                Node arg = call.child(j);
                int af = this.literalFamily(arg);
                if (af < 0 || af == pf) { continue; }
                if (count > 0) { segs = segs + ", and "; }
                segs = segs + "line " + arg.line.toString() + ", column " + arg.col.toString() + " for \"" + names[j] + "\" parameter expected " + this.articleOf(types[j]) + " got " + this.articleOf(this.literalTypeName(arg));
                count = count + 1;
            }
            if (count == 0) { return; }
            if (count > 0) { bestSegs = segs; bestCount = count; }
        }
        if (bestCount > 0) {
            this.recordError("wrong value type at " + bestSegs);
        }
    }

    // VALUE_EXCEPTION.md — `expected a string of a number at line L,
    // column C, got "hello"` for numeric parse conversions on literals.
    private void checkParseValueException(string recv, string method, Node arg) {
        bool isIntRecv = this.strEq(recv, "int") || this.strEq(recv, "int64");
        bool isDblRecv = this.strEq(recv, "double") || this.strEq(recv, "float");
        if (!isIntRecv && !isDblRecv) { return; }
        bool wantsInt = this.strEq(method, "parseInt") || this.strEq(method, "toInt")
            || this.strEq(method, "parseLong") || this.strEq(method, "toInt64");
        bool wantsDouble = this.strEq(method, "parseDouble") || this.strEq(method, "toDouble")
            || this.strEq(method, "parseFloat");
        if (!wantsInt && !wantsDouble) { return; }
        if (arg.kind != 2) { return; }
        if (this.stringIsNumber(arg.strVal, wantsInt)) { return; }
        this.recordError("expected a string of a number at line " + arg.line.toString() + ", column " + arg.col.toString() + ", got \"" + arg.strVal + "\"");
    }

    // TYPE_EXCEPTIONS.md — a declaration whose initializer's value kind
    // cannot possibly fit (`int x = "hello"`) points at the value and names
    // the declared type and variable.
    private void checkDeclValueType(string declaredType, Node value, string varName) {
        int df = this.typeFamily(declaredType);
        if (df < 0) { return; }
        int vf = this.literalFamily(value);
        if (vf < 0 || vf == df) { return; }
        this.recordError("wrong value type at line " + value.line.toString() + ", column " + value.col.toString() + ", expected " + this.articleOf(declaredType) + " got " + this.articleOf(this.literalTypeName(value)) + " for " + declaredType + " \"" + varName + "\"");
    }

    private bool strEq(string a, string b) {
        if (a.length != b.length) { return false; }
        for (int i = 0; i < a.length; i++) {
            if (a[i] != b[i]) { return false; }
        }
        return true;
    }

    private string sliceStr(string s, int a, int b) {
        string out = "";
        for (int i = a; i < b; i++) { out = out + charToString(s[i]); }
        return out;
    }

    private bool strStartsWith(string s, string prefix) {
        if (s.length < prefix.length) { return false; }
        for (int i = 0; i < prefix.length; i++) {
            if (s[i] != prefix[i]) { return false; }
        }
        return true;
    }

    // ---- Post-parse call diagnostics (EXCEPTIONS/*.md) ---------------------
    // Runs once after parseProgram so the whole symbol table (functions,
    // methods, types, win32 grants) is visible to every call site.

    // SYNTAX_EXCEPTIONS.md — undefined plain calls emit `unknown method`,
    // with a did-you-mean suggestion when the name resembles a known one.
    // VALUE_EXCEPTION.md — filesystem calls receiving a URL or an unusable
    // path literal where a file path is required.
    public void checkCallDiagnostics(Node[] ast) {
        // DOCS/259 -- top-level variable declarations are the globals an
        // anonymous body may legally reference (its enclosing function's
        // locals may not).
        this.anonKnownGlobals = [];
        for (int g = 0; g < ast.length; g++) {
            if (ast[g].kind == 50) { this.anonKnownGlobals.add(ast[g].name); }
        }
        for (int i = 0; i < ast.length; i++) {
            this.walkCallDiagnostics(ast[i]);
        }
    }

    private void walkCallDiagnostics(Node n) {
        if (n.kind == 50 && this.strEq(n.typeHint, "void ()") && n.name.length > 0) {
            // DOCS/259 G2 -- fn-typed locals are invocable like fn-typed
            // parameters once declared (forward-visible for the rest of the
            // walk, matching the reference compiler's never-popped registry).
            this.fnPtrCallScope.add(n.name);
        }
        if (n.kind == 100) {
            // DOCS/259 -- the enclosing function's fn-typed parameters are
            // invocable as zero-arg calls within its body only. The scope is
            // extended on a copy so the saved array stays untouched.
            string[] savedScope = this.fnPtrCallScope;
            string[] extended = [];
            for (int sc = 0; sc < savedScope.length; sc++) { extended.add(savedScope[sc]); }
            if (n.childCount() > 0) {
                Node fnParams = n.child(0);
                for (int fp = 0; fp < fnParams.childCount(); fp++) {
                    if (this.strEq(fnParams.child(fp).typeHint, "void ()")) {
                        extended.add(fnParams.child(fp).name);
                    }
                }
            }
            this.fnPtrCallScope = extended;
            for (int fc = 0; fc < n.childCount(); fc++) {
                this.walkCallDiagnostics(n.child(fc));
            }
            this.fnPtrCallScope = savedScope;
            return;
        }
        if (n.kind == 85) {
            // DOCS/259 -- an anonymous function body is an isolated scope:
            // enclosing fn-typed parameters and locals are not visible, so
            // its identifier uses are validated against its own locals, the
            // file's globals, and the known symbol table.
            string[] savedScope = this.fnPtrCallScope;
            this.fnPtrCallScope = [];
            this.anonWalkDepth = this.anonWalkDepth + 1;
            Node anonBody = n.child(0);
            string[] anonLocals = [];
            this.collectAnonBodyLocals(anonBody, anonLocals);
            this.checkAnonBodyIdentifiers(anonBody, anonLocals);
            this.anonWalkDepth = this.anonWalkDepth - 1;
            this.fnPtrCallScope = savedScope;
            return;
        }
        if (n.kind == 10 && n.line > 0) {
            // Recovery-built call nodes carry no source position and already
            // reported their own syntax error.
            if (!n.isMember) { this.checkPlainCallTarget(n); }
            this.checkFsPathValueException(n);
        }
        // Struct/collect/class bodies are opaque to this pass: their member
        // functions are not symbol-checked (the reference checker walks free
        // functions only; unresolved helpers inside classes stay a codegen-
        // time warning).
        if (n.kind == 101 || n.kind == 102) { return; }
        for (int i = 0; i < n.childCount(); i++) {
            this.walkCallDiagnostics(n.child(i));
        }
    }

    private void checkPlainCallTarget(Node call) {
        string name = call.name;
        if (name.length == 0) { return; }
        // DOCS/259 -- invoking a function-typed parameter of the enclosing
        // function: allowed for zero-arg calls only (the stored address is
        // called, arguments cannot be passed).
        if (this.anonWalkDepth == 0 && call.childCount() == 0 && this.fnPtrCallScopeHas(name)) { return; }
        // Dotted names (dotted-new candidates) are never free functions of
        // this pass — in anonymous bodies too:
        // codegen resolves them through the module namespace or reports
        // `Unknown type '<name>'`, matching the reference compiler for known
        // and unknown modules.
        bool callNameHasDot = false;
        for (int d = 0; d < name.length; d++) {
            if (name[d] == '.') { callNameHasDot = true; break; }
        }
        if (callNameHasDot) { return; }
        if (this.anonWalkDepth > 0) {
            // DOCS/259 -- inside an isolated anonymous body an unresolved
            // call is reported with the reference checker's wording.
            if (this.isKnownCallableName(name)) { return; }
            this.recordError(call.line.toString() + ":" + call.col.toString() + ": Undefined function '" + name + "'");
            return;
        }
        if (this.isKnownCallableName(name)) { return; }
        string sugg = diagClosestMatch(name, this.callableCandidates());
        if (sugg.length > 0) {
            this.recordError("did you mean \"" + sugg + "\"?, at line " + call.line.toString() + ", column " + call.col.toString());
        } else {
            this.recordError("unknown method \"" + name + "\", at line " + call.line.toString() + ", column " + call.col.toString());
        }
    }

    // DOCS/259 -- declared names inside an anonymous body (its own locals).
    private void collectAnonBodyLocals(Node n, string[] locals) {
        if (n.kind == 50 && n.name.length > 0) { locals.add(n.name); }
        if (n.kind == 73 && n.name.length > 0) { locals.add(n.name); }
        if (n.kind == 21 && n.childCount() > 0) {
            // Match-arm binding patterns introduce a local in the arm body.
            Node pat = n.child(0);
            if (pat.kind == 6 && pat.name.length > 0 && !this.strEq(pat.name, "_")) { locals.add(pat.name); }
        }
        for (int i = 0; i < n.childCount(); i++) {
            this.collectAnonBodyLocals(n.child(i), locals);
        }
    }

    // DOCS/259 -- validate identifier uses inside an anonymous body against
    // its own locals and the file-level symbol table. Enclosing locals are
    // deliberately NOT consulted: the body compiles to a standalone function.
    private void checkAnonBodyIdentifiers(Node n, string[] locals) {
        if (n.kind == 74) {
            // Struct literal keys are field names, not identifier uses.
            for (int i = 0; i < n.childCount(); i++) {
                Node pair = n.child(i);
                if (pair.childCount() > 1) { this.checkAnonBodyIdentifiers(pair.child(1), locals); }
            }
            return;
        }
        if (n.kind == 21 && n.childCount() > 0) {
            // Match-arm patterns bind, they do not use.
            for (int i = 1; i < n.childCount(); i++) {
                this.checkAnonBodyIdentifiers(n.child(i), locals);
            }
            return;
        }
        if (n.kind == 6) {
            string name = n.name;
            if (name.length > 0 && !this.strEq(name, "this") && !this.strEq(name, "null")) {
                if (!this.anonIdentResolves(name, locals)) {
                    this.recordError(n.line.toString() + ":" + n.col.toString() + ": Undefined variable '" + name + "'");
                }
            }
        }
        for (int i = 0; i < n.childCount(); i++) {
            this.checkAnonBodyIdentifiers(n.child(i), locals);
        }
    }

    private bool anonIdentResolves(string name, string[] locals) {
        for (int i = 0; i < locals.length; i++) {
            if (this.strEq(locals[i], name)) { return true; }
        }
        for (int g = 0; g < this.anonKnownGlobals.length; g++) {
            if (this.strEq(this.anonKnownGlobals[g], name)) { return true; }
        }
        if (this.knownIdentName(name)) { return true; }
        for (int s = 0; s < this.sigNames.length; s++) {
            if (this.strEq(this.sigNames[s], name)) { return true; }
        }
        if (this.isDeclaredTypeName(name)) { return true; }
        // Module receivers (`time.now()` inside the body): the aggregate's
        // declared modules resolve like silverc-rs's module_names set.
        for (int m = 0; m < this.modExportNames.length; m++) {
            if (this.strEq(this.modExportNames[m], name)) { return true; }
        }
        if (this.win32Resolvable(name)) { return true; }
        if (this.linuxResolvable(name)) { return true; }
        if (name.length > 0) {
            bool allCaps = true;
            for (int c = 0; c < name.length; c++) {
                char ch = name[c];
                if (!((ch >= 'A' && ch <= 'Z') || ch == '_')) { allCaps = false; }
            }
            if (allCaps) { return true; }
        }
        return false;
    }

    private bool fnPtrCallScopeHas(string name) {
        for (int i = 0; i < this.fnPtrCallScope.length; i++) {
            if (this.strEq(this.fnPtrCallScope[i], name)) { return true; }
        }
        return false;
    }

    private bool isKnownCallableName(string name) {
        for (int i = 0; i < this.sigNames.length; i++) {
            if (this.strEq(this.sigNames[i], name)) { return true; }
        }
        if (this.isDeclaredTypeName(name)) { return true; }
        if (this.isBuiltinCallableName(name)) { return true; }
        if (this.win32Resolvable(name)) { return true; }
        if (this.linuxResolvable(name)) { return true; }
        // ALL-CAPS identifiers stay native-call placeholders.
        if (name.length > 0) {
            bool allCaps = true;
            for (int c = 0; c < name.length; c++) {
                char ch = name[c];
                if (!((ch >= 'A' && ch <= 'Z') || ch == '_')) { allCaps = false; }
            }
            if (allCaps) { return true; }
        }
        if (this.strStartsWith(name, "__Value_")) { return true; }
        return false;
    }

    private bool win32Resolvable(string name) {
        if (this.win32AllModules) { return true; }
        for (int g = 0; g < this.win32GrantNames.length; g++) {
            if (this.strEq(this.win32GrantNames[g], name)) { return true; }
        }
        for (int m = 0; m < this.win32OpenModules.length; m++) {
            string dll = this.win32ModuleNameDll(this.win32OpenModules[m]);
            if (dll.length > 0 && this.win32TableHas(dll, name)) { return true; }
        }
        return false;
    }

    // Mirror of win32Resolvable for the linux grant trio above: a full
    // `linux` open, an opened `linux.<module>`, or a granted export name
    // (aliases answer to their local name only) resolves a free libc/X11
    // call. Used beside win32Resolvable in the same two call sites.
    private bool linuxResolvable(string name) {
        if (this.linuxAllModules) { return true; }
        for (int g = 0; g < this.linuxGrantNames.length; g++) {
            if (this.strEq(this.linuxGrantNames[g], name)) { return true; }
        }
        for (int m = 0; m < this.linuxOpenModules.length; m++) {
            string lib = this.linuxModuleNameLib(this.linuxOpenModules[m]);
            if (lib.length > 0 && this.linuxTableHas(lib, name)) { return true; }
        }
        return false;
    }

    private string linuxModuleNameLib(string module) {
        if (this.strEq(module, "libc")) { return "libc.so.6"; }
        if (this.strEq(module, "x11")) { return "libX11.so.6"; }
        if (this.strEq(module, "xtst")) { return "libXtst.so.6"; }
        return "";
    }

    private string linuxLibExportTable(string lib) {
        if (this.strEq(lib, "libc.so.6")) { return "exit mmap munmap malloc free read write open close lseek stat unlink rename mkdir rmdir opendir readdir closedir getenv setenv clock_gettime nanosleep localtime_r gmtime_r fork execve waitpid kill pipe dup2 _exit execvpe getpid pthread_create pthread_join sysconf uname gethostname getlogin_r statvfs getrandom rand srand getuid printf strlen strcmp strcpy memcpy memset socket connect bind listen accept send recv setsockopt getaddrinfo freeaddrinfo"; }
        if (this.strEq(lib, "libX11.so.6")) { return "XOpenDisplay XCloseDisplay XQueryPointer XWarpPointer XFlush XCreateSimpleWindow XMapWindow XUnmapWindow XDestroyWindow XStoreName XDefaultRootWindow XScreenCount XDisplayWidth XDisplayHeight XStringToKeysym XKeysymToKeycode XQueryKeymap"; }
        if (this.strEq(lib, "libXtst.so.6")) { return "XTestFakeButtonEvent XTestFakeKeyEvent XTestFakeMotionEvent XTestQueryExtension"; }
        return "";
    }

    private bool linuxTableHas(string lib, string fn) {
        string table = this.linuxLibExportTable(lib);
        int i = 0;
        while (i < table.length) {
            while (i < table.length && table[i] == ' ') { i++; }
            int start = i;
            while (i < table.length && table[i] != ' ') { i++; }
            if (i > start && this.strEq(fn, this.sliceStr(table, start, i))) { return true; }
        }
        return false;
    }

    private string win32ModuleNameDll(string module) {
        if (this.strEq(module, "kernel32")) { return "kernel32.dll"; }
        if (this.strEq(module, "ws2_32")) { return "ws2_32.dll"; }
        if (this.strEq(module, "winhttp")) { return "winhttp.dll"; }
        if (this.strEq(module, "wininet")) { return "wininet.dll"; }
        if (this.strEq(module, "shell32")) { return "shell32.dll"; }
        if (this.strEq(module, "msvcrt")) { return "msvcrt.dll"; }
        if (this.strEq(module, "user32")) { return "user32.dll"; }
        if (this.strEq(module, "registry") || this.strEq(module, "advapi32")) { return "advapi32.dll"; }
        if (this.strEq(module, "version")) { return "version.dll"; }
        return "";
    }

    private string win32DllExportTable(string dll) {
        if (this.strEq(dll, "kernel32.dll")) { return "CreateFileA ReadFile WriteFile CloseHandle GetFileSize GetFileSizeEx SetFilePointer FlushFileBuffers DeleteFileA MoveFileA CopyFileA GetFileAttributesA SetFileAttributesA CreateDirectoryA RemoveDirectoryA SetCurrentDirectoryA GetCurrentDirectoryA GetFullPathNameA FindFirstFileA FindNextFileA FindClose GetStdHandle SetConsoleTextAttribute GetConsoleScreenBufferInfo SetConsoleCursorPosition GetConsoleMode SetConsoleMode ReadConsoleA WriteConsoleA GetModuleHandleA GetModuleFileNameA LoadLibraryA GetProcAddress Sleep GetTickCount GetTickCount64 GetLastError CreateProcessA CreateProcessW WaitForSingleObject GetExitCodeProcess TerminateProcess OpenProcess GetProcessId CreatePipe GetProcessHeap HeapFree GlobalAlloc GlobalFree VirtualAlloc VirtualFree GetCurrentProcessId GetCurrentProcess GetCurrentThreadId GetCurrentThread GetEnvironmentVariableA GetEnvironmentVariableW SetEnvironmentVariableA SetEnvironmentVariableW ExpandEnvironmentStringsA GetEnvironmentStringsA FreeEnvironmentStringsA GetTempPathA GetComputerNameA GetUserNameA QueryPerformanceCounter QueryPerformanceFrequency GetVersionExA GetSystemDirectoryA GetWindowsDirectoryA GetLocalTime GetSystemTime GetSystemInfo GlobalMemoryStatusEx GetDiskFreeSpaceExA GetUserDefaultUILanguage OutputDebugStringA IsDebuggerPresent GetCommandLineA SetThreadPriority QueryFullProcessImageNameA GetFileAttributesW lstrlenA lstrcpyA lstrcatA lstrcmpA CreateProcess"; }
        if (this.strEq(dll, "ws2_32.dll")) { return "WSAStartup WSACleanup socket bind listen accept recv send shutdown closesocket connect select setsockopt ioctlsocket htons inet_addr getaddrinfo freeaddrinfo WSAGetLastError"; }
        if (this.strEq(dll, "winhttp.dll")) { return "WinHttpOpen WinHttpConnect WinHttpOpenRequest WinHttpSendRequest WinHttpReceiveResponse WinHttpQueryHeaders WinHttpQueryDataAvailable WinHttpReadData WinHttpCloseHandle WinHttpSetOption"; }
        if (this.strEq(dll, "wininet.dll")) { return "InternetOpenA InternetConnectA InternetOpenUrlA InternetReadFile InternetReadFileExA InternetCloseHandle HttpSendRequestA HttpSendRequestExA InternetQueryDataAvailable InternetSetOptionA InternetQueryOptionA HttpQueryInfoA InternetWriteFile InternetGetConnectedState InternetCrackUrlA InternetCanonicalizeUrlA InternetSetStatusCallback"; }
        if (this.strEq(dll, "shell32.dll")) { return "ShellExecuteA ShellExecuteW ShellExecuteExA ShellExecuteExW"; }
        if (this.strEq(dll, "msvcrt.dll")) { return "memcpy memset memmove memcmp strlen strcmp strchr strstr strrchr strcpy strcat strncmp strncat strncpy strtok strpbrk strspn strcspn atoi atol strtol malloc free realloc calloc printf fprintf sprintf sscanf fopen fclose fread fwrite fflush fgets fputs fseek ftell system getenv putenv time rand srand abs labs toupper tolower isalpha isdigit isspace isprint isalnum isxdigit isupper islower"; }
        if (this.strEq(dll, "user32.dll")) { return "keybd_event VkKeyScanA GetKeyState GetAsyncKeyState GetKeyboardState SetKeyboardState MapVirtualKeyA SendInput mouse_event GetCursorPos SetCursorPos SetCursor ClipCursor GetClipCursor GetDoubleClickTime SetDoubleClickTime GetForegroundWindow GetWindowTextA GetWindowThreadProcessId RegisterHotKey UnregisterHotKey MessageBeep RegisterRawInputDevices GetRawInputData GetRawInputDeviceList RegisterClassExA CreateWindowExA ShowWindow UpdateWindow SetWindowTextA DestroyWindow GetMessageA TranslateMessage DispatchMessageA DefWindowProcA PostQuitMessage GetSystemMetrics LoadIconA LoadCursorA LoadImageA SendMessageA GetCursorX GetCursorY"; }
        if (this.strEq(dll, "advapi32.dll")) { return "RegOpenKeyExA RegCreateKeyExA RegQueryValueExA RegSetValueExA RegDeleteValueA RegDeleteKeyA RegEnumKeyExA RegEnumValueA RegQueryInfoKeyA RegCloseKey GetUserNameA"; }
        if (this.strEq(dll, "version.dll")) { return "GetFileVersionInfoSizeA GetFileVersionInfoA VerQueryValueA"; }
        return "";
    }

    private bool win32TableHas(string dll, string fn) {
        string table = this.win32DllExportTable(dll);
        int i = 0;
        while (i < table.length) {
            while (i < table.length && table[i] == ' ') { i++; }
            int start = i;
            while (i < table.length && table[i] != ' ') { i++; }
            if (i > start && this.strEq(fn, this.sliceStr(table, start, i))) { return true; }
        }
        return false;
    }

    private bool isBuiltinCallableName(string name) {
        if (this.strEq(name, "print") || this.strEq(name, "printline")) { return true; }
        if (this.strEq(name, "eprint") || this.strEq(name, "eprintln")) { return true; }
        if (this.strEq(name, "exit") || this.strEq(name, "input")) { return true; }
        if (this.strEq(name, "sleep") || this.strEq(name, "assert")) { return true; }
        if (this.strEq(name, "int") || this.strEq(name, "float")) { return true; }
        if (this.strEq(name, "double") || this.strEq(name, "char")) { return true; }
        if (this.strEq(name, "byte") || this.strEq(name, "string_cast")) { return true; }
        if (this.strEq(name, "now") || this.strEq(name, "cargs")) { return true; }
        if (this.strEq(name, "getCommandLine") || this.strEq(name, "super")) { return true; }
        if (this.strEq(name, "readFile") || this.strEq(name, "readString")) { return true; }
        if (this.strEq(name, "writeBytes") || this.strEq(name, "writeString")) { return true; }
        if (this.strEq(name, "writeFile") || this.strEq(name, "strlen")) { return true; }
        if (this.strEq(name, "exists") || this.strEq(name, "delete")) { return true; }
        if (this.strEq(name, "deleteFile")) { return true; }
        if (this.strEq(name, "keybd_event") || this.strEq(name, "mouse_event")) { return true; }
        if (this.strEq(name, "VkKeyScanA") || this.strEq(name, "GetKeyState")) { return true; }
        if (this.strEq(name, "GetAsyncKeyState") || this.strEq(name, "MapVirtualKeyA")) { return true; }
        if (this.strEq(name, "GetCursorPos") || this.strEq(name, "SetCursorPos")) { return true; }
        if (this.strEq(name, "SetCursor") || this.strEq(name, "ClipCursor")) { return true; }
        if (this.strEq(name, "GetClipCursor") || this.strEq(name, "GetDoubleClickTime")) { return true; }
        if (this.strEq(name, "SetDoubleClickTime") || this.strEq(name, "RegisterHotKey")) { return true; }
        if (this.strEq(name, "UnregisterHotKey") || this.strEq(name, "MessageBeep")) { return true; }
        if (this.strEq(name, "RegisterRawInputDevices") || this.strEq(name, "GetRawInputData")) { return true; }
        if (this.strEq(name, "GetRawInputDeviceList") || this.strEq(name, "SendInput")) { return true; }
        if (this.strEq(name, "GetForegroundWindow") || this.strEq(name, "GetWindowTextA")) { return true; }
        if (this.strEq(name, "GetWindowThreadProcessId") || this.strEq(name, "OpenProcess")) { return true; }
        if (this.strEq(name, "QueryFullProcessImageNameA") || this.strEq(name, "CloseHandle")) { return true; }
        if (this.strEq(name, "getFocusedProcessDataNative")) { return true; }
        // std/os.sr defines `osType()` as plain Silver, but the `os` module
        // is builtin-reserved in the self-hosted compiler, so its source is
        // never collected; the backend provides the native os.type contract
        // (compile-time OSTypes.WINDOWS constant).
        if (this.strEq(name, "osType")) { return true; }
        if (this.strEq(name, "__binaryMetadataStatus") || this.strEq(name, "__binaryMetadataField")) { return true; }
        if (this.strEq(name, "__binaryMetadataStatusNative") || this.strEq(name, "__binaryMetadataFieldNative")) { return true; }
        if (this.strEq(name, "nativeToastShow") || this.strEq(name, "loadIcon")) { return true; }
        if (this.strEq(name, "guiSetIcon") || this.strEq(name, "guiCreateWindow")) { return true; }
        if (this.strEq(name, "guiShow") || this.strEq(name, "guiHide")) { return true; }
        if (this.strEq(name, "guiMaximize") || this.strEq(name, "guiMinimize")) { return true; }
        if (this.strEq(name, "guiSetTitle") || this.strEq(name, "guiClose")) { return true; }
        if (this.strEq(name, "guiRunLoop")) { return true; }
        if (this.strEq(name, "trayAdd") || this.strEq(name, "traySetTooltip")) { return true; }
        if (this.strEq(name, "trayDelete") || this.strEq(name, "trayRemove")) { return true; }
        if (this.strEq(name, "traySetMenu") || this.strEq(name, "trayRunLoop")) { return true; }
        if (this.strEq(name, "trayPollMenu") || this.strEq(name, "trayPollClick")) { return true; }
        if (this.strEq(name, "regOpen") || this.strEq(name, "regCreate")) { return true; }
        if (this.strEq(name, "regClose") || this.strEq(name, "regSubKey")) { return true; }
        if (this.strEq(name, "regGetString") || this.strEq(name, "regSetString")) { return true; }
        if (this.strEq(name, "regGetInt") || this.strEq(name, "regSetInt")) { return true; }
        if (this.strEq(name, "regGetInt64") || this.strEq(name, "regSetInt64")) { return true; }
        if (this.strEq(name, "regDeleteValue") || this.strEq(name, "regDeleteKey")) { return true; }
        if (this.strEq(name, "regValueExists")) { return true; }
        if (this.strEq(name, "regEnumSubKeyName") || this.strEq(name, "regEnumValueName")) { return true; }
        if (this.strEq(name, "regSubKeyCount") || this.strEq(name, "regValueCount")) { return true; }
        return false;
    }

    // Did-you-mean candidate pool: every user-defined function plus the
    // builtin free calls.
    private string[] callableCandidates() {
        string[] cands = [];
        for (int i = 0; i < this.sigNames.length; i++) { cands.add(this.sigNames[i]); }
        cands.add("print"); cands.add("printline");
        cands.add("exit"); cands.add("input");
        cands.add("sleep"); cands.add("assert");
        cands.add("int"); cands.add("float");
        cands.add("double"); cands.add("char");
        cands.add("byte"); cands.add("string_cast");
        cands.add("now"); cands.add("cargs");
        cands.add("getCommandLine");
        cands.add("readFile"); cands.add("readString");
        cands.add("writeBytes"); cands.add("writeString");
        cands.add("writeFile"); cands.add("strlen");
        cands.add("exists"); cands.add("delete");
        cands.add("deleteFile");
        cands.add("toString"); cands.add("toInt");
        cands.add("toUpper"); cands.add("toLower");
        return cands;
    }

    // Filesystem entry points whose first argument must be a file path
    // (VALUE_EXCEPTION.md).
    private bool isPathFirstArgMethod(string m) {
        if (this.strEq(m, "readString") || this.strEq(m, "readFile")) { return true; }
        if (this.strEq(m, "readBytes") || this.strEq(m, "writeString")) { return true; }
        if (this.strEq(m, "writeFile") || this.strEq(m, "writeBytes")) { return true; }
        if (this.strEq(m, "exists") || this.strEq(m, "delete")) { return true; }
        if (this.strEq(m, "deleteFile") || this.strEq(m, "rename")) { return true; }
        if (this.strEq(m, "copy") || this.strEq(m, "mkdir")) { return true; }
        if (this.strEq(m, "createDirectory") || this.strEq(m, "createDir")) { return true; }
        if (this.strEq(m, "directoryExists") || this.strEq(m, "folderExists")) { return true; }
        if (this.strEq(m, "isFile") || this.strEq(m, "isDirectory")) { return true; }
        if (this.strEq(m, "size") || this.strEq(m, "listFiles")) { return true; }
        return false;
    }

    private void checkFsPathValueException(Node call) {
        if (!this.isPathFirstArgMethod(call.name)) { return; }
        if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6) {
            string recv = call.child(0).name;
            if (!this.strEq(recv, "fs") && !this.strEq(recv, "file") && !this.strEq(recv, "folder")) { return; }
        }
        int argStart = 0;
        if (call.isMember) { argStart = 1; }
        this.checkPathLiteralArg(call, argStart);
        // rename(src, dst) / copy(src, dst): both arguments are paths.
        if (this.strEq(call.name, "rename") || this.strEq(call.name, "copy")) {
            this.checkPathLiteralArg(call, argStart + 1);
        }
    }

    private void checkPathLiteralArg(Node call, int idx) {
        if (idx < 0 || idx >= call.childCount()) { return; }
        Node arg = call.child(idx);
        if (arg.kind != 2) { return; }
        if (this.looksLikeUrl(arg.strVal)) {
            this.recordError("expected a string of a file path at line " + arg.line.toString() + ", column " + arg.col.toString() + ", got a url");
            return;
        }
        if (this.isInvalidPathLiteral(arg.strVal)) {
            this.recordError("expected a valid file path at line " + arg.line.toString() + ", column " + arg.col.toString() + ", got an invalid path");
        }
    }

    private bool looksLikeUrl(string s) {
        string lo = diagToLower(s);
        if (this.strStartsWith(lo, "http://")) { return true; }
        if (this.strStartsWith(lo, "https://")) { return true; }
        if (this.strStartsWith(lo, "http:")) { return true; }
        if (this.strStartsWith(lo, "https:")) { return true; }
        if (this.strStartsWith(lo, "ftp://")) { return true; }
        if (this.strStartsWith(lo, "ftps://")) { return true; }
        if (this.strStartsWith(lo, "file://")) { return true; }
        if (this.strStartsWith(lo, "www.")) { return true; }
        return false;
    }

    // A literal is an unusable local path when it is empty, carries
    // characters Windows forbids in paths, or sits on a drive that does not
    // exist (probed through the drive root).
    private bool isInvalidPathLiteral(string s) {
        if (s.length == 0) { return true; }
        for (int i = 0; i < s.length; i++) {
            char c = s[i];
            if (c == '<' || c == '>' || c == '"' || c == '|' || c == '?' || c == '*') { return true; }
            if (c < 32) { return true; }
        }
        if (s.length >= 2 && s[1] == ':') {
            char d = s[0];
            if ((d >= 'a' && d <= 'z') || (d >= 'A' && d <= 'Z')) {
                string root = charToString(d) + ":" + charToString((char)(92));
                if (!file.exists(root)) { return true; }
            }
        }
        return false;
    }

    private void pppp() {
        Node n = new Node();
        n.kind = 64;
        this.expect(14);
        this.expect(100);
        Node v = new Node();
        v.kind = 50;
        string vt = this.advance().text;
        if (this.check(120)) {
            while (!this.check(121) && !this.check(106) && !this.check(103)) {
                vt = vt + this.advance().text;
            }
            if (this.check(121)) { vt = vt + ">"; this.advance(); }
        }
        if (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } vt = vt + "[]"; }
        if (this.check(123)) { this.advance(); vt = vt + "?"; }
        v.typeHint = vt;
        v.name = this.advance().text;
        n.children.add(v);
        this.expect(54);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlock());
        return n;
    }

    private Token peek() {
        if (this.pos < this.tokens.length) {
            return this.tokens[this.pos];
        }
        return this.tokens[this.tokens.length - 1];
    }

    private Token advance() {
        // Guard against running past the EOF sentinel (e.g. an unterminated
        // paren/brace/bracket at end of file): reading tokens[this.pos] beyond
        // the array would be an out-of-bounds access.
        if (this.pos >= this.tokens.length) {
            Token eof = this.tokens[this.tokens.length - 1];
            printline("Parse error at line " + eof.line.toString() + ", column " + eof.col.toString() + ": unexpected end of file");
            exit(1);
            return eof;
        }
        Token t = this.tokens[this.pos];
        this.pos = this.pos + 1;
        return t;
    }

    private bool check(int kind) {
        Token t = this.peek();
        return t.kind == kind;
    }

    private Token expect(int kind) {
        if (this.check(kind)) {
            return this.advance();
        }
        Token tok = this.peek();
        printline("Parse error at line " + tok.line.toString() + ", column " + tok.col.toString() + ": expected " + this.kindName(kind) + " but found " + this.tokenText(tok));
        exit(1);
        return this.peek();
    }

    private string kindName(int kind) {
        if (kind == 0) { return "end of file"; }
        if (kind == 1) { return "number"; }
        if (kind == 3) { return "string"; }
        if (kind == 4) { return "character"; }
        if (kind == 5) { return "boolean"; }
        if (kind == 6) { return "null"; }
        if (kind == 7) { return "identifier"; }
        if (kind == 10) { return "if"; }
        if (kind == 11) { return "else"; }
        if (kind == 12) { return "while"; }
        if (kind == 13) { return "for"; }
        if (kind == 14) { return "foreach"; }
        if (kind == 15) { return "return"; }
        if (kind == 16) { return "match"; }
        if (kind == 17) { return "void"; }
        if (kind == 18) { return "int"; }
        if (kind == 19) { return "int32"; }
        if (kind == 20) { return "int64"; }
        if (kind == 22) { return "float"; }
        if (kind == 23) { return "float64"; }
        if (kind == 25) { return "bool"; }
        if (kind == 26) { return "char"; }
        if (kind == 27) { return "string"; }
        if (kind == 28) { return "var"; }
        if (kind == 29) { return "struct"; }
        if (kind == 30) { return "class"; }
        if (kind == 31) { return "enum"; }
        if (kind == 32) { return "def"; }
        if (kind == 33) { return "found"; }
        if (kind == 34) { return "collect"; }
        if (kind == 35) { return "mod"; }
        if (kind == 36) { return "import"; }
        if (kind == 37) { return "from"; }
        if (kind == 38) { return "as"; }
        if (kind == 39) { return "new"; }
        if (kind == 40) { return "const"; }
        if (kind == 44) { return "public"; }
        if (kind == 45) { return "private"; }
        if (kind == 46) { return "static"; }
        if (kind == 47) { return "prop"; }
        if (kind == 48) { return "construct"; }
        if (kind == 49) { return "unset"; }
        if (kind == 50) { return "mut"; }
        if (kind == 51) { return "ref"; }
        if (kind == 52) { return "try"; }
        if (kind == 53) { return "catch"; }
        if (kind == 54) { return "in"; }
        if (kind == 55) { return "to"; }
        if (kind == 56) { return "elif"; }
        if (kind == 57) { return "break"; }
        if (kind == 58) { return "continue"; }
        if (kind == 59) { return "export"; }
        if (kind == 60) { return "extends"; }
        if (kind == 64) { return "throw"; }
        if (kind == 100) { return "("; }
        if (kind == 101) { return ")"; }
        if (kind == 102) { return "{"; }
        if (kind == 103) { return "}"; }
        if (kind == 104) { return "["; }
        if (kind == 105) { return "]"; }
        if (kind == 106) { return ";"; }
        if (kind == 107) { return ","; }
        if (kind == 108) { return "."; }
        if (kind == 109) { return ":"; }
        if (kind == 110) { return "="; }
        if (kind == 111) { return "+"; }
        if (kind == 112) { return "-"; }
        if (kind == 113) { return "*"; }
        if (kind == 114) { return "/"; }
        if (kind == 115) { return "%"; }
        if (kind == 116) { return "&"; }
        if (kind == 117) { return "|"; }
        if (kind == 118) { return "^"; }
        if (kind == 119) { return "~"; }
        if (kind == 120) { return "<"; }
        if (kind == 121) { return ">"; }
        if (kind == 122) { return "!"; }
        if (kind == 123) { return "?"; }
        if (kind == 125) { return "#"; }
        if (kind == 130) { return "+="; }
        if (kind == 131) { return "-="; }
        if (kind == 132) { return "*="; }
        if (kind == 133) { return "/="; }
        if (kind == 134) { return "=="; }
        if (kind == 135) { return "!="; }
        if (kind == 136) { return "<="; }
        if (kind == 137) { return ">="; }
        if (kind == 138) { return "&&"; }
        if (kind == 139) { return "||"; }
        if (kind == 140) { return "<<"; }
        if (kind == 141) { return ">>"; }
        if (kind == 142) { return "++"; }
        if (kind == 143) { return "--"; }
        if (kind == 144) { return ".."; }
        if (kind == 145) { return "->"; }
        if (kind == 146) { return "=>"; }
        if (kind == 147) { return "..."; }
        if (kind == 148) { return "??"; }
        if (kind == 163) { return "?."; }
        if (kind == 164) { return "protected"; }
        if (kind == 165) { return "typealias"; }
        if (kind == 166) { return "loop"; }
        if (kind == 167) { return "internal"; }
        if (kind == 149) { return "$"; }
        if (kind == 150) { return "local"; }
        if (kind == 151) { return "alias"; }
        if (kind == 152) { return "fixed"; }
        if (kind == 153) { return "live"; }
        if (kind == 154) { return "once"; }
        if (kind == 155) { return "shared"; }
        if (kind == 156) { return "@"; }
        return "token(" + kind.toString() + ")";
    }

    private string tokenText(Token t) {
        if (t.kind == 0) { return "end of file"; }
        if (t.kind == 3) { return "\"" + t.text + "\""; }
        if (t.kind == 4) { return "'" + t.text + "'"; }
        return t.text;
    }

    public Node[] parseProgram() {
        Node[] items = [];
        Node mainBody = new Node();
        mainBody.kind = 16;
        bool mainSeen = false;
        while (!this.check(0)) {
            int posBefore = this.pos;
            Node? item = this.parseItem();
            if (item != null) {
                if (item.kind == 100 && this.strEq(item.name, "main")) {
                    mainSeen = true;
                }
                if (item.kind == 112) {
                    // Inline module block: hoist its items to top level. An
                    // `internal mod` block marks everything inside it internal.
                    for (int mi = 0; mi < item.childCount(); mi++) {
                        Node inner = item.child(mi);
                        if (item.isInternal) { inner.isInternal = true; }
                        if (inner.kind == 100 && this.strEq(inner.name, "main")) {
                            mainSeen = true;
                        }
                        if (inner.kind == 61 || inner.kind == 50 || inner.kind == 73 || inner.kind == 16 || inner.kind == 53 || inner.kind == 54 || inner.kind == 55 || inner.kind == 59 || inner.kind == 68) {
                            mainBody.children.add(inner);
                        } else {
                            items.add(inner);
                        }
                    }
                } elif (item.kind == 61 || item.kind == 50 || item.kind == 73 || item.kind == 16 || item.kind == 53 || item.kind == 54 || item.kind == 55 || item.kind == 59 || item.kind == 68) {
                    mainBody.children.add(item);
                } else {
                    items.add(item);
                }
            }
            if (this.pos == posBefore) {
                break;
            }
        }
        if (mainBody.children.length > 0 && !mainSeen) {
            Node main = new Node();
            main.kind = 100;
            main.name = "main";
            main.typeHint = "void";
            Node params = new Node();
            main.children.add(params);
            main.children.add(mainBody);
            items.add(main);
        }
        if (mainSeen) {
            // Top-level variable declarations become real globals when a main
            // function exists: keep them in the program list so codegen can
            // allocate writable slots and run their initializers before main().
            for (int gi = 0; gi < mainBody.children.length; gi++) {
                if (mainBody.children[gi].kind == 50) {
                    items.add(mainBody.children[gi]);
                }
            }
        }
        // Flush the merged missing-semicolon message (single line listing
        // every position, joined with "and").
        if (this.missingSemiLines.length > 0) {
            string msg = "you forgot to put a semicolon \";\" in ";
            for (int si = 0; si < this.missingSemiLines.length; si++) {
                if (si > 0) { msg = msg + " and "; }
                msg = msg + "line " + this.missingSemiLines[si].toString() + ", column " + this.missingSemiCols[si].toString();
            }
            this.recordError(msg);
        }
        return items;
    }    private Node? parseItem() {
        // Skip access modifiers preceding a top-level declaration
        // (`public const int X = 1;`, `private void helper() { ... }`),
        // recording `internal` (DOCS/258) for the item about to be parsed.
        bool internalItem = false;
        while (this.check(44) || this.check(45) || this.check(164) || this.check(46) || this.check(167)) {
            if (this.check(167)) { internalItem = true; }
            this.advance();
        }
        if (this.check(35)) {
            this.advance();
            if (this.check(59)) { this.advance(); }
            if (this.check(102)) { return null; }
            string modName = this.advance().text;
            if (this.check(102)) {
                // Inline module block `mod name { ... }`: lift the inner items
                // to top level so `name.f()` qualified calls resolve to global
                // functions.  Returns a kind-112 container that parseProgram
                // flattens (mirrors silverc-rs flatten_inline_modules); an
                // `internal` block marks every hoisted item internal.
                this.advance();
                Node modNode = new Node();
                modNode.kind = 112;
                modNode.name = modName;
                modNode.isInternal = internalItem;
                this.recordModExport(modName, internalItem);
                while (!this.check(103) && !this.check(0)) {
                    Node? inner = this.parseItem();
                    if (inner != null) {
                        if (inner.kind == 112) {
                            for (int mi = 0; mi < inner.childCount(); mi++) {
                                if (modNode.isInternal) { inner.child(mi).isInternal = true; }
                                modNode.children.add(inner.child(mi));
                            }
                        } else {
                            if (modNode.isInternal) { inner.isInternal = true; }
                            modNode.children.add(inner);
                        }
                    }
                }
                this.expect(103);
                return modNode;
            }
            this.expect(106);
            this.recordModExport(modName, internalItem);
            return null;
        }
        if (this.check(36)) { return this.parseImport(); }
        if (this.check(165)) { return this.flagInternal(this.parseTypeAlias(), internalItem); }
        if (this.check(40)) { return this.flagInternal(this.parseConst(), internalItem); }
        if (this.check(32)) { return this.parseDef(); }
        if (this.check(34)) { return this.parseCollect(); }
        if (this.check(29)) { return this.parseStruct(); }
        if (this.check(30)) { return this.flagInternal(this.parseClass(), internalItem); }
        if (this.check(31)) { return this.parseEnum(); }
        // Unknown keyword at top level (e.g. a typo like `impor`), with a
        // did-you-mean suggestion when it resembles a real keyword.  Recovery
        // resyncs to the next statement boundary so the damaged region does
        // not cascade into unrelated follow-on errors.
        if (this.check(7)) {
            Token curTok = this.peek();
            if (!this.strEq(curTok.text, "switch") && !this.strEq(curTok.text, "tuple")) {
                int nk = -1;
                if (this.pos + 1 < this.tokens.length) { nk = this.tokens[this.pos + 1].kind; }
                bool continuesExpr = this.tokenContinuesExpr(nk);
                if (!continuesExpr && nk == 3) {
                    return this.parseCallMissingOpenParen();
                }
                if (!continuesExpr && this.identShouldFlag(curTok, nk)) {
                    this.advance();
                    this.flagUnknownKeywordAt(curTok);
                    this.syncToStatementEnd();
                    return null;
                }
            }
        }
        // Top-level statements (e.g. `printline(42);`) are legal: a source
        // without a function is compiled as if the statements were the body
        // of an implicit `void main()`.  Functions are recognized by their
        // `Type name (` shape (including array returns like `string[] name (`
        // and optional public/private/static prefixes); anything else is
        // parsed as a statement.
        if (this.pos + 1 < this.tokens.length) {
            int typePos = this.pos;
            Token t0 = this.tokens[this.pos];
            if ((t0.kind == 44 || t0.kind == 45 || t0.kind == 46) && this.pos + 1 < this.tokens.length) {
                typePos = this.pos + 1;
                t0 = this.tokens[typePos];
            }
            bool typeStart = t0.kind == 17 || t0.kind == 18 || t0.kind == 19 || t0.kind == 20 || t0.kind == 22 || t0.kind == 23 || t0.kind == 25 || t0.kind == 26 || t0.kind == 27 || t0.kind == 28 || t0.kind == 7 || t0.kind == 120 || t0.kind == 150 || t0.kind == 151 || t0.kind == 152 || t0.kind == 153 || t0.kind == 154 || t0.kind == 155;
            if (typeStart) {
                int scan = typePos + 1;
                if (this.tokens[typePos].kind == 120) {
                    // Union/result type `<A | B>` (DOCS/29) starting at the
                    // `<`: skip the whole `<...>` group before looking for
                    // the function name.
                    while (scan < this.tokens.length && this.tokens[scan].kind != 121) { scan = scan + 1; }
                    scan = scan + 1;
                } elif (this.tokens[scan].kind == 120) {
                    scan = scan + 1;
                    while (scan < this.tokens.length && this.tokens[scan].kind != 121) { scan = scan + 1; }
                    scan = scan + 1;
                }
                while (scan + 1 < this.tokens.length && this.tokens[scan].kind == 104 && this.tokens[scan + 1].kind == 105) { scan = scan + 2; }
                if (scan < this.tokens.length && this.tokens[scan].kind == 123) { scan = scan + 1; }
                if (scan + 1 < this.tokens.length && this.tokens[scan].kind == 7 && this.tokens[scan + 1].kind == 100) {
                    return this.flagInternal(this.parseFunction(), internalItem);
                }
                return this.flagInternal(this.parseStmt(), internalItem);
            }
            return this.flagInternal(this.parseStmt(), internalItem);
        }
        return this.flagInternal(this.parseFunction(), internalItem);
    }

    // Attach the recorded `internal` flag to a freshly parsed top-level item
    // (function, class, const, or `internal int x = 2;` global declaration).
    private Node? flagInternal(Node? item, bool internalItem) {
        if (item != null && internalItem) { item.isInternal = true; }
        return item;
    }

    private Node parseImport() {
        Node node = new Node();
        node.kind = 105;
        Token kwTok = this.peek();
        node.line = kwTok.line;
        node.col = kwTok.col;
        this.expect(36);
        if (this.check(113)) {
            this.advance();
            node.isStatic = true;
        } elif (this.check(102)) {
            this.advance();
            Node first = this.parseImportNameNode();
            node.name = first.name;
            node.isAlias = first.isAlias;
            node.strVal = first.strVal;
            while (this.check(107)) {
                this.advance();
                node.children.add(this.parseImportNameNode());
            }
            this.expect(103);
        } else {
            Node first = this.parseImportNameNode();
            node.name = first.name;
            node.isAlias = first.isAlias;
            node.strVal = first.strVal;
            while (this.check(107)) {
                this.advance();
                node.children.add(this.parseImportNameNode());
            }
        }
        if (this.check(37)) {
            this.advance();
            string src = this.advance().text;
            while (this.check(108)) {
                this.advance();
                src = src + "." + this.advance().text;
            }
            node.typeHint = src;
        }
        // `X as Y` import aliasing. An alias binds a DLL/lib export under a
        // different local call name, which only carries meaning on win32
        // and linux imports (fs.sr's `rename as renameFile` dodges the
        // module's own rename/2); on a Silver-module import it would
        // silently rebind the module's own symbols, so reject it.
        if (this.importHasAlias(node) && !this.importSourceIsWin32(node.typeHint) && !this.importSourceIsLinux(node.typeHint)) {
            this.recordError("aliased import names (X as Y) are only allowed on win32/linux imports, at line " + node.line.toString() + ", column " + node.col.toString());
        }
        // Remember win32 grants for the post-parse unknown-method walk
        // (DOCS/213): free Win32 calls resolve only through these imports.
        this.recordWin32ImportGrant(node);
        // Remember linux grants beside them (LINUX.md Phase B): free libc
        // calls resolve only through linux imports.
        this.recordLinuxImportGrant(node);
        // DOCS/261 bare custom grants resolve per target OS beside them.
        this.recordCustomBareGrant(node);
        this.expectSemi();
        return node;
    }

    // One name inside an import list: `export` or `export as local`.
    // The alias local rides on the node's strVal with isAlias set, keeping
    // the import node shape unchanged for every other consumer.
    private Node parseImportNameNode() {
        Node nameNode = new Node();
        nameNode.name = this.advance().text;
        if (this.check(38)) {
            this.advance();
            nameNode.isAlias = true;
            nameNode.strVal = this.advance().text;
        }
        return nameNode;
    }

    private bool importHasAlias(Node node) {
        if (node.isAlias) { return true; }
        for (int i = 0; i < node.childCount(); i++) {
            if (node.child(i).isAlias) { return true; }
        }
        return false;
    }

    private bool importSourceIsWin32(string src) {
        if (this.strEq(src, "win32")) { return true; }
        if (src.length > 6 && this.strEq(this.sliceStr(src, 0, 6), "win32.")) { return true; }
        return false;
    }

    private bool importSourceIsLinux(string src) {
        if (this.strEq(src, "linux")) { return true; }
        if (src.length > 6 && this.strEq(this.sliceStr(src, 0, 6), "linux.")) { return true; }
        return false;
    }

    // The name an import grant answers to: the alias local for `X as Y`,
    // the plain name otherwise.
    private string importLocalName(Node nameNode) {
        if (nameNode.isAlias && nameNode.strVal.length > 0) { return nameNode.strVal; }
        return nameNode.name;
    }

    // Mirror of MiniCg.registerWin32Import, kept in the parser so the
    // diagnostics pass can tell granted Win32 exports from unknown methods.
    // DOCS/261: fixed names resolve first (untouched); declared custom names
    // grant single exports only (star rejected); undeclared names report the
    // manifest stanza. `import * from win32;` still grants fixed only.
    private void recordWin32ImportGrant(Node node) {
        string src = node.typeHint;
        if (this.strEq(src, "win32")) {
            if (node.isStatic) { this.win32AllModules = true; return; }
            this.checkWin32ModuleName(node.name, node);
            for (int j = 0; j < node.childCount(); j++) {
                this.checkWin32ModuleName(node.child(j).name, node);
            }
            return;
        }
        if (src.length > 6 && this.strEq(this.sliceStr(src, 0, 6), "win32.")) {
            string module = this.sliceStr(src, 6, src.length);
            string dll = this.win32ModuleNameDll(module);
            if (dll.length > 0) {
                if (node.isStatic) {
                    this.win32OpenModules.add(module);
                    return;
                }
                this.win32GrantNames.add(this.importLocalName(node));
                for (int j2 = 0; j2 < node.childCount(); j2++) {
                    this.win32GrantNames.add(this.importLocalName(node.child(j2)));
                }
                return;
            }
            if (this.customDeclared(module)) {
                string winf = this.customNative.winFile(module);
                if (winf.length == 0) {
                    this.recordError(nativeUndeclaredMsg(src) + ", at line " + node.line.toString() + ", column " + node.col.toString());
                    return;
                }
                if (node.isStatic) {
                    this.recordError(nativeStarMsg(src) + ", at line " + node.line.toString() + ", column " + node.col.toString());
                    return;
                }
                this.win32GrantNames.add(this.importLocalName(node));
                for (int j3 = 0; j3 < node.childCount(); j3++) {
                    this.win32GrantNames.add(this.importLocalName(node.child(j3)));
                }
                return;
            }
            this.recordError(nativeUndeclaredMsg(src) + ", at line " + node.line.toString() + ", column " + node.col.toString());
        }
    }

    private void checkWin32ModuleName(string modName, Node node) {
        if (modName.length == 0) { return; }
        string dll = this.win32ModuleNameDll(modName);
        if (dll.length > 0) {
            this.win32OpenModules.add(modName);
            return;
        }
        if (this.customDeclared(modName)) {
            this.recordError(nativeStarMsg("win32." + modName) + ", at line " + node.line.toString() + ", column " + node.col.toString());
            return;
        }
        this.recordError(nativeUndeclaredMsg("win32." + modName) + ", at line " + node.line.toString() + ", column " + node.col.toString());
    }

    private bool customDeclared(string name) {
        if (name.length == 0) { return false; }
        return this.customNative.declared(name);
    }

    private string customEffectiveTarget() {
        if (this.customTargetOs.length > 0) { return this.customTargetOs; }
        return "WINDOWS";
    }

    // Mirror of recordWin32ImportGrant for `linux` / `linux.<module>`
    // imports (LINUX.md Phase B): `import * from linux;` opens every known
    // lib, `import <mod> from linux;` / `import * from linux.<mod>;` open
    // one, and braced names grant single exports (aliases answer to their
    // local name only, same as win32). DOCS/261 custom rules mirror win32.
    private void recordLinuxImportGrant(Node node) {
        string src = node.typeHint;
        if (this.strEq(src, "linux")) {
            if (node.isStatic) { this.linuxAllModules = true; return; }
            this.checkLinuxModuleName(node.name, node);
            for (int j = 0; j < node.childCount(); j++) {
                this.checkLinuxModuleName(node.child(j).name, node);
            }
            return;
        }
        if (src.length > 6 && this.strEq(this.sliceStr(src, 0, 6), "linux.")) {
            string module = this.sliceStr(src, 6, src.length);
            string lib = this.linuxModuleNameLib(module);
            if (lib.length > 0) {
                if (node.isStatic) {
                    this.linuxOpenModules.add(module);
                    return;
                }
                this.linuxGrantNames.add(this.importLocalName(node));
                for (int j2 = 0; j2 < node.childCount(); j2++) {
                    this.linuxGrantNames.add(this.importLocalName(node.child(j2)));
                }
                return;
            }
            if (this.customDeclared(module)) {
                string linf = this.customNative.linFile(module);
                if (linf.length == 0) {
                    this.recordError(nativeUndeclaredMsg(src) + ", at line " + node.line.toString() + ", column " + node.col.toString());
                    return;
                }
                if (node.isStatic) {
                    this.recordError(nativeStarMsg(src) + ", at line " + node.line.toString() + ", column " + node.col.toString());
                    return;
                }
                this.linuxGrantNames.add(this.importLocalName(node));
                for (int j3 = 0; j3 < node.childCount(); j3++) {
                    this.linuxGrantNames.add(this.importLocalName(node.child(j3)));
                }
                return;
            }
            this.recordError(nativeUndeclaredMsg(src) + ", at line " + node.line.toString() + ", column " + node.col.toString());
        }
    }

    private void checkLinuxModuleName(string modName, Node node) {
        if (modName.length == 0) { return; }
        string lib = this.linuxModuleNameLib(modName);
        if (lib.length > 0) {
            this.linuxOpenModules.add(modName);
            return;
        }
        if (this.customDeclared(modName)) {
            this.recordError(nativeStarMsg("linux." + modName) + ", at line " + node.line.toString() + ", column " + node.col.toString());
            return;
        }
        this.recordError(nativeUndeclaredMsg("linux." + modName) + ", at line " + node.line.toString() + ", column " + node.col.toString());
    }

    // DOCS/261 bare custom grants (`import { f } from m;`,
    // `import * from m;`): declared names resolve per target OS with no `#on`
    // regions. Undeclared bare names are Silver (no grant, no error);
    // declared-but-wrong-side and star-without-list report here so the
    // unknown-method walk never misfires. Single grants need no export list.
    private void recordCustomBareGrant(Node node) {
        string src = node.typeHint;
        if (src.length == 0) { return; }
        if (this.strEq(src, "win32") || this.strEq(src, "linux")) { return; }
        if (src.length > 6 && this.strEq(this.sliceStr(src, 0, 6), "win32.")) { return; }
        if (src.length > 6 && this.strEq(this.sliceStr(src, 0, 6), "linux.")) { return; }
        // Precedence: project-local sources, `.qs` bundle modules, and std
        // modules beat custom native names; a colliding fixed name resolves
        // to the fixed module (handled above). Std names never grant here.
        if (projectIsStdModule(src) || projectBuiltin(src)) { return; }
        if (!this.customDeclared(src)) { return; }
        string target = this.customEffectiveTarget();
        string file = this.customNative.fileFor(src, target);
        if (file.length == 0) {
            this.recordError(nativeSideError(this.customNative, src, target) + ", at line " + node.line.toString() + ", column " + node.col.toString());
            return;
        }
        bool isLinux = cliArgEq(target, "LINUX");
        if (node.isStatic) {
            if (!this.customNative.starAllowed(src, target)) {
                this.recordError(nativeStarMsg(src) + ", at line " + node.line.toString() + ", column " + node.col.toString());
                return;
            }
            string exps = this.customNative.exportsFor(src, target);
            int s = 0;
            while (s < exps.length) {
                while (s < exps.length && (exps[s] == ' ' || exps[s] == '\t')) { s++; }
                int e = s;
                while (e < exps.length && exps[e] != ' ' && exps[e] != '\t') { e++; }
                if (e > s) {
                    string nm = "";
                    for (int k = s; k < e; k++) { nm = nm + exps[k]; }
                    if (isLinux) { this.linuxGrantNames.add(nm); }
                    else { this.win32GrantNames.add(nm); }
                }
                s = e;
            }
            return;
        }
        string local0 = this.importLocalName(node);
        if (isLinux) { this.linuxGrantNames.add(local0); }
        else { this.win32GrantNames.add(local0); }
        for (int j = 0; j < node.childCount(); j++) {
            string ln = this.importLocalName(node.child(j));
            if (isLinux) { this.linuxGrantNames.add(ln); }
            else { this.win32GrantNames.add(ln); }
        }
    }

    private Node parseConst() {
        Node node = new Node();
        node.kind = 104;
        this.expect(40);
        // Support both `const int NAME = 3;` and C-style `const NAME = "x";`.
        // If the token after `const` is a primitive type keyword, consume it;
        // otherwise the name comes directly (type is inferred from the
        // initializer).  Identifiers (kind 7) are always treated as the name.
        if (this.check(17) || this.check(18) || this.check(19) || this.check(20) || this.check(22) || this.check(23) || this.check(25) || this.check(26) || this.check(27) || this.check(28)) {
            node.typeHint = this.advance().text;
        } else {
            node.typeHint = "";
        }
        node.name = this.advance().text;
        this.knownIdents.add(node.name);
        if (this.check(110)) {
            this.advance();
            node.children.add(this.parseExpr(0));
        }
        this.expectSemi();
        return node;
    }

    private Node parseDef() {
        Node node = new Node();
        this.expect(32);
        node.name = this.advance().text;
        this.registerDeclaredType(node.name);
        if (this.check(110)) {
            node.kind = 103;
            this.advance();
            this.expect(31);
            this.expect(102);
            while (!this.check(103) && !this.check(0)) {
                node.children.add(this.parsePattern());
                if (this.check(107)) { this.advance(); }
            }
            this.expect(103);
            this.expectSemi();
        } else {
            node.kind = 110;
            this.expectSemi();
        }
        return node;
    }

    private Node parseCollect() {
        Node node = new Node();
        node.kind = 102;
        this.expect(34);
        node.name = this.advance().text;
        this.expect(110);
        this.expect(100);
        int fieldIndex = 0;
        while (!this.check(101) && !this.check(0)) {
            Node field = new Node();
            field.kind = 50;
            field.typeHint = this.advance().text;
            field.name = fieldIndex.toString();
            node.children.add(field);
            fieldIndex = fieldIndex + 1;
            if (this.check(107)) { this.advance(); }
        }
        this.expect(101);
        this.expectSemi();
        return node;
    }

    private Node parseStruct() {
        Node node = new Node();
        node.kind = 101;
        this.expect(29);
        node.name = this.advance().text;
        this.registerDeclaredType(node.name);
        this.expect(102);
        while (!this.check(103) && !this.check(0)) {
            Node field = new Node();
            field.typeHint = this.advance().text;
            string fn = this.advance().text;
            field.name = fn;
            field.kind = 0;
            node.children.add(field);
            this.expect(106);
        }
        this.expect(103);
        return node;
    }

    private Node parseClass() {
        Node node = new Node();
        node.kind = 102;
        this.expect(30);
        node.name = this.advance().text;
        this.registerDeclaredType(node.name);
        if (this.check(109) || this.check(60)) {
            this.advance();
            node.parentClass = this.advance().text;
        }
        this.expect(102);
        this.classSectionInternal = false;
        while (!this.check(103) && !this.check(0)) {
            Node member = this.parseClassMember();
            if (member != null) { node.children.add(member); }
        }
        this.expect(103);
        return node;
    }

    private Node? parseEnum() {
        this.expect(31);
        Node node = new Node();
        node.kind = 105;
        node.name = this.advance().text;
        this.registerDeclaredType(node.name);
        this.expect(102);
        int value = 0;
        while (!this.check(103) && !this.check(0)) {
            Node member = new Node();
            member.kind = 106;
            member.name = this.advance().text;
            member.intVal = value;
            node.children.add(member);
            value = value + 1;
            if (this.check(107)) { this.advance(); }
        }
        this.expect(103);
        return node;
    }

    private Node? parseClassMember() {
        // `internal:` / `public:` / `private:` section markers (DOCS/258):
        // a bare modifier followed by `:` toggles the default visibility for
        // the rest of the class body instead of declaring a member.
        if (this.check(167) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 109) {
            this.advance();
            this.advance();
            this.classSectionInternal = true;
            return null;
        }
        if ((this.check(44) || this.check(45)) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 109) {
            this.advance();
            this.advance();
            this.classSectionInternal = false;
            return null;
        }
        bool memberInternal = false;
        while (this.check(44) || this.check(45) || this.check(164) || this.check(46) || this.check(167)) {
            if (this.check(167)) { memberInternal = true; }
            this.advance();
        }
        if (this.classSectionInternal) { memberInternal = true; }
        if (this.check(48)) {
            Node ctor = new Node();
            ctor.kind = 100;
            ctor.name = "construct";
            ctor.isInternal = memberInternal;
            this.advance();
            this.expect(100);
            Node params = new Node();
            while (!this.check(101) && !this.check(0)) {
                Node param = new Node();
                string cpt = this.advance().text;
                if (this.check(120)) {
                    while (!this.check(121) && !this.check(106) && !this.check(103)) {
                        cpt = cpt + this.advance().text;
                    }
                    if (this.check(121)) { cpt = cpt + ">"; this.advance(); }
                }
                if (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } cpt = cpt + "[]"; }
                if (this.check(123)) { this.advance(); cpt = cpt + "?"; }
                if (this.check(100)) {
                    // DOCS/259 G1 -- function-typed constructor parameter
                    // suffix: `void () name`. Only the supported `void ()`
                    // shape is accepted (mirrors parseFunction's param path).
                    if (this.strEq(cpt, "void") && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 101) {
                        this.advance();
                        this.advance();
                        cpt = "void ()";
                    } else {
                        Token ftTok = this.peek();
                        this.recordError(ftTok.line.toString() + ":" + ftTok.col.toString() + ": Unexpected token '(: function-typed parameters support only `void () name`; other shapes are not supported yet (see DOCS/259)'");
                        this.skipBalancedParens();
                        cpt = "void ()";
                    }
                }
                if (this.check(147)) {
                    this.advance();
                    cpt = cpt + "[]";
                    param.isVariadic = true;
                }
                param.typeHint = cpt;
                param.name = this.advance().text;
                if (this.check(110)) {
                    this.advance();
                    param.children.add(this.parseExpr(0));
                }
                params.children.add(param);
                if (this.check(107)) { this.advance(); }
            }
            this.expect(101);
            ctor.children.add(params);
            // `construct(args) : base(parentArgs) { ... }` chains the parent
            // constructor.  Desugar the `: base(...)` clause into an injected
            // `super(...)` call at the top of the body, reusing the existing
            // super() codegen.
            if (this.check(109)) {
                this.advance();
                if (this.check(7) && this.strEq(this.peek().text, "base")) {
                    this.advance();
                    this.expect(100);
                    Node superCall = new Node();
                    superCall.kind = 10;
                    superCall.name = "super";
                    while (!this.check(101) && !this.check(0)) {
                        superCall.children.add(this.parseExpr(0));
                        if (this.check(107)) { this.advance(); }
                    }
                    this.expect(101);
                    Node origBody = this.parseBlock();
                    Node newBody = new Node();
                    newBody.kind = 16;
                    Node superStmt = new Node();
                    superStmt.kind = 61;
                    superStmt.children.add(superCall);
                    newBody.children.add(superStmt);
                    for (int bi = 0; bi < origBody.childCount(); bi++) {
                        newBody.children.add(origBody.child(bi));
                    }
                    ctor.children.add(newBody);
                    return ctor;
                }
            }
            ctor.children.add(this.parseBlock());
            return ctor;
        }
        if (this.check(47)) {
            this.advance();
            Node field = new Node();
            field.kind = 50;
            string ft = this.advance().text;
            if (this.check(120)) {
                while (!this.check(121) && !this.check(106) && !this.check(103)) {
                    ft = ft + this.advance().text;
                }
                if (this.check(121)) { ft = ft + ">"; this.advance(); }
            }
            if (this.strEq(ft, "void") && this.check(100) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 101) {
                // DOCS/259 G2 -- fn-typed prop: `prop void () cb;` (fn arrays
                // too via the `[]` suffix below).
                this.advance();
                this.advance();
                ft = "void ()";
            }
            if (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } ft = ft + "[]"; }
            if (this.check(123)) { this.advance(); ft = ft + "?"; }
            field.typeHint = ft;
            field.name = this.advance().text;
            field.isInternal = memberInternal;
            this.expect(106);
            return field;
        }
        if (this.check(28) || this.check(18) || this.check(19) || this.check(20) || this.check(25) || this.check(27) || this.check(22) || this.check(23) || this.check(26) || this.check(17) || this.check(7)) {
            int savedPos = this.pos;
            string ft = this.advance().text;
            if (this.check(120)) {
                while (!this.check(121) && !this.check(106) && !this.check(103)) {
                    ft = ft + this.advance().text;
                }
                if (this.check(121)) { ft = ft + ">"; this.advance(); }
            }
            if (this.strEq(ft, "void") && this.check(100) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 101) {
                // DOCS/259 G2 -- bare fn-typed field: `void () cb;` (fn arrays
                // too via the `[]` suffix below). 17 (`void`) was added to the
                // member dispatch so this path is reached at all.
                this.advance();
                this.advance();
                ft = "void ()";
            }
            if (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } ft = ft + "[]"; }
            if (this.check(123)) { this.advance(); ft = ft + "?"; }
            if (this.check(7) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 106) {
                Node field = new Node();
                field.kind = 50;
                field.typeHint = ft;
                field.name = this.advance().text;
                field.isInternal = memberInternal;
                this.expect(106);
                return field;
            }
            // Legacy class sources (cd_test_classes.sr) omit the trailing
            // semicolon on fields.  Accept `Type name` followed by another
            // type/field or the closing brace as a field declaration.
            if (this.check(7) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind != 100 && this.tokens[this.pos + 1].kind != 101 && this.tokens[this.pos + 1].kind != 102) {
                Node field = new Node();
                field.kind = 50;
                field.typeHint = ft;
                field.name = this.advance().text;
                field.isInternal = memberInternal;
                if (this.check(106)) { this.advance(); }
                return field;
            }
            this.pos = savedPos;
        }
        Node method = this.parseFunction();
        method.isInternal = memberInternal;
        return method;
    }

    // Kinds that can begin a parameter's type inside a `( ... )` list.
    private bool tokenStartsParam(int kind) {
        if (kind == 17 || kind == 18 || kind == 19 || kind == 20 || kind == 22 || kind == 23 || kind == 25 || kind == 26 || kind == 27) { return true; }
        if (kind == 28 || kind == 7 || kind == 120 || kind == 50 || kind == 51) { return true; }
        if (kind == 150 || kind == 151 || kind == 152 || kind == 153 || kind == 154 || kind == 155) { return true; }
        return false;
    }

    private Node parseFunction() {
        Node node = new Node();
        node.kind = 100;
        while (this.check(44) || this.check(45) || this.check(46) || this.check(164) || this.check(167)) {
            if (this.check(167)) { node.isInternal = true; }
            this.advance();
        }
        string retType = this.advance().text;
        if (this.check(120)) {
            while (!this.check(121) && !this.check(106) && !this.check(103)) {
                retType = retType + this.advance().text;
            }
            if (this.check(121)) { retType = retType + ">"; this.advance(); }
        } elif (this.strEq(retType, "<")) {
            // Union/result return type `<A | B>` (DOCS/29).
            while (!this.check(121) && !this.check(106) && !this.check(103)) {
                retType = retType + this.advance().text;
            }
            if (this.check(121)) { retType = retType + ">"; this.advance(); }
        }
        if (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } retType = retType + "[]"; }
        if (this.check(123)) { this.advance(); retType = retType + "?"; }
        node.typeHint = retType;
        node.name = this.advance().text;
        this.knownIdents.add(node.name);
        Token openParen = this.expect(100);
        Node params = new Node();
        bool sawParam = false;
        while (!this.check(101) && !this.check(0)) {
            // Consume the separating comma, or report its absence
            // (`int add(int x int y)`).
            if (this.check(107)) {
                this.advance();
            } elif (sawParam) {
                Token prevT = this.tokens[this.pos - 1];
                this.recordError("you forgot a comma \",\" at line " + prevT.line.toString() + ", column " + (prevT.col + this.tokenSrcLen(prevT)).toString());
            }
            // A `{` (or any token that cannot start a type) before the closing
            // parenthesis means the `)` itself is missing.
            if (!this.tokenStartsParam(this.peek().kind)) { break; }
            // DOCS/259 -- the C-style `function` keyword does not exist in
            // Silver; report it verbatim where a parameter type is expected.
            if (this.rejectCStyleFunctionParam()) {
                this.skipDamagedFunction();
                this.registerDamagedSignature(node.name);
                return node;
            }
            Node param = new Node();
            string pt = this.advance().text;
            if (this.check(120)) {
                while (!this.check(121) && !this.check(106) && !this.check(103)) {
                    pt = pt + this.advance().text;
                }
                if (this.check(121)) { pt = pt + ">"; this.advance(); }
            }
            if (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } pt = pt + "[]"; }
            if (this.check(123)) { this.advance(); pt = pt + "?"; }
            if (this.check(100)) {
                // DOCS/259 -- function-typed parameter suffix: `void () name`
                // stores an 8-byte function address in the parameter slot.
                // Only the supported `void ()` shape is accepted; any other
                // shape (parameters, non-void return types) is rejected.
                if (this.strEq(pt, "void") && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 101) {
                    this.advance();
                    this.advance();
                    pt = "void ()";
                } else {
                    Token ftTok = this.peek();
                    this.recordError(ftTok.line.toString() + ":" + ftTok.col.toString() + ": Unexpected token '(: function-typed parameters support only `void () name`; other shapes are not supported yet (see DOCS/259)'");
                    this.skipBalancedParens();
                    this.skipDamagedFunction();
                    this.registerDamagedSignature(node.name);
                    return node;
                }
            }
            if (this.check(147)) {
                // Variadic tail `Type ... name`: the callee receives an array
                // of the element type (DOCS/112).
                this.advance();
                pt = pt + "[]";
                param.isVariadic = true;
            }
            param.typeHint = pt;
            param.name = this.advance().text;
            if (this.check(110)) {
                this.advance();
                param.children.add(this.parseExpr(0));
            }
            params.children.add(param);
            sawParam = true;
        }
        if (this.check(101)) {
            this.advance();
        } else {
            // `void main( {` — the closing parenthesis is missing; it is
            // reported just past the opening one.
            this.recordError("Missing close parenthesis at line " + openParen.line.toString() + ", column " + (openParen.col + 1).toString());
        }
        node.children.add(params);
        // TYPE_EXCEPTIONS.md — remember this signature for call-arg checks.
        string joinTypes = "";
        string joinNames = "";
        bool variadicTail = false;
        for (int spi = 0; spi < params.childCount(); spi++) {
            Node sp = params.child(spi);
            if (spi > 0) { joinTypes = joinTypes + ","; joinNames = joinNames + ","; }
            joinTypes = joinTypes + sp.typeHint;
            joinNames = joinNames + sp.name;
            if (sp.isVariadic) { variadicTail = true; }
        }
        this.sigNames.add(node.name);
        this.sigTypes.add(joinTypes);
        this.sigParams.add(joinNames);
        if (variadicTail) { this.sigVariadic.add(1); } else { this.sigVariadic.add(0); }
        if (this.check(145)) {
            this.advance();
            string ret = this.advance().text;
            if (this.check(120)) {
                while (!this.check(121) && !this.check(106) && !this.check(103)) {
                    ret = ret + this.advance().text;
                }
                if (this.check(121)) { ret = ret + ">"; this.advance(); }
            }
            if (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } ret = ret + "[]"; }
            if (this.check(123)) { this.advance(); ret = ret + "?"; }
            node.typeHint = ret;
        }
        if (this.check(140)) {
            this.advance();
            node.children.add(this.parseExpr(0));
        } elif (this.check(102)) {
            node.children.add(this.parseBlock());
        } elif (this.check(103) || this.check(0)) {
            // `void main()` followed by `}` on the next line: the opening
            // curly bracket is missing; point just past the signature's
            // end-of-line.
            int sigLine = this.prevEndLine();
            int sigEndCol = this.lineEndCol(sigLine);
            if (sigEndCol < 0) { sigEndCol = this.prevEndCol(); }
            this.recordError("Missing opening curly bracket at line " + sigLine.toString() + ", column " + sigEndCol.toString());
            if (this.check(103)) { this.advance(); }
            Node emptyBody = new Node(); emptyBody.kind = 16;
            node.children.add(emptyBody);
        } else {
            node.children.add(this.parseBlock());
        }
        return node;
    }

    private Node parseBlock() {
        Node block = new Node();
        block.kind = 16;
        this.expect(102);
        while (!this.check(103) && !this.check(0)) {
            block.children.add(this.parseStmt());
        }
        if (this.check(103)) {
            this.advance();
        } else {
            // Missing `}` at end of file: reported one line after the last
            // line of code inside the block, column 1 (SYNTAX_EXCEPTIONS.md #3
            // bracket position).
            int closeLine = this.prevEndLine() + 1;
            this.recordError("Missing closing curly bracket at line " + closeLine.toString() + ", column 1");
        }
        return block;
    }

    // Accepts either a brace block or a single brace-less statement
    // (JS-style `if (x) return 1;` one-liners).
    private Node parseBlockOrStmt() {
        if (this.check(102)) {
            return this.parseBlock();
        }
        return this.parseStmt();
    }

    private Node parseStmt() {
        // A stray `;` is an empty statement (also the recovery anchor used
        // after an unknown-keyword error).
        if (this.check(106)) { this.advance(); return this.noopNode(); }
        if (this.check(7) && this.strEq(this.peek().text, "switch")) {
            return this.parseSwitch();
        }
        if ((this.check(18) || this.check(19) || this.check(20) || this.check(22) || this.check(23) || this.check(25) || this.check(26) || this.check(27)) && this.pos + 3 < this.tokens.length && this.tokens[this.pos + 1].kind == 7 && this.tokens[this.pos + 2].kind == 104) {
            return this.parseFixedVarDecl();
        }
        if (this.check(7) && this.strEq(this.peek().text, "tuple") && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 120) {
            int tupleSaved = this.pos;
            this.advance();
            this.advance();
            while (!this.check(121) && !this.check(0)) { this.advance(); }
            this.expect(121);
            if (this.check(7)) {
                this.pos = tupleSaved;
                return this.parseVarDecl();
            }
            this.expect(100);
            Node destr = new Node(); destr.kind = 71;
            while (!this.check(101) && !this.check(0)) {
                destr.children.add(this.makeNameNode(this.advance().text));
                if (this.check(107)) { this.advance(); }
            }
            this.expect(101);
            this.expect(110);
            destr.children.add(this.parseExpr(0));
            this.expectSemi();
            return destr;
        }
        // Unknown-keyword detection (SYNTAX_EXCEPTIONS.md).  A statement that
        // begins with a lowercase identifier not followed by any expression
        // continuation (`(`, `.`, `=`, `[`, ...) is an unknown keyword or a
        // typo of one.  Uppercase-led identifiers stay on the user-defined
        // type-declaration path below.
        if (this.check(7)) {
            Token curTok = this.peek();
            if (!this.strEq(curTok.text, "switch") && !this.strEq(curTok.text, "tuple")) {
                int nk = -1;
                if (this.pos + 1 < this.tokens.length) { nk = this.tokens[this.pos + 1].kind; }
                bool continuesExpr = this.tokenContinuesExpr(nk);
                // `print"hello world");` — a call missing its open parenthesis.
                if (!continuesExpr && nk == 3) {
                    return this.parseCallMissingOpenParen();
                }
                if (!continuesExpr && this.identShouldFlag(curTok, nk)) {
                    this.advance();
                    this.flagUnknownKeywordAt(curTok);
                    return this.noopNode();
                }
            }
        }
        if (this.check(7) && this.pos + 1 < this.tokens.length) {
            Token next = this.tokens[this.pos + 1];
            if (next.kind == 7) {
                return this.parseVarDecl();
            }
if (next.kind == 104 && this.pos + 2 < this.tokens.length && this.tokens[this.pos + 2].kind == 105) {
                return this.parseVarDecl();
            }
            if (next.kind == 123 && this.pos + 2 < this.tokens.length && this.tokens[this.pos + 2].kind == 7) {
                return this.parseVarDecl();
            }
            if (next.kind == 120) {
                return this.parseVarDecl();
            }
        }
        if (this.check(120)) {
            // Union/result type `<A | B>` (DOCS/29) in declaration position.
            return this.parseVarDecl();
        }
        if (this.check(15)) {
            Node n = new Node(); n.kind = 51;
            this.advance();
            if (!this.check(106)) { n.children.add(this.parseExpr(0)); }
            this.expectSemi();
            return n;
        }
        if (this.check(141)) {
            Node n = new Node(); n.kind = 52;
            this.advance();
            n.children.add(this.parseExpr(0));
            this.expectSemi();
            return n;
        }
        if (this.check(10)) { return this.parseIf(); }
        // A leading `elif` continues an if-chain begun by a previous
        // statement (`if (...) { } else { }\n elif (...) { }`).
        if (this.check(56)) { return this.parseIf(); }
        if (this.check(12)) { return this.parseWhile(); }
        if (this.check(13)) { return this.parseFor(); }
        if (this.check(166)) { return this.parseLoop(); }
        if (this.check(14)) { return this.pppp(); }
        if (this.check(57)) { Node n = new Node(); n.kind = 62; this.advance(); this.expectSemi(); return n; }
        if (this.check(58)) { Node n = new Node(); n.kind = 63; this.advance(); this.expectSemi(); return n; }
        if (this.check(150)) {
            this.advance();
            return this.parseVarDecl();
        }
        if (this.check(152)) {
            this.advance();
            Node n = this.parseTypeNameInit();
            n.isFixed = true;
            return n;
        }
        if (this.check(153)) {
            this.advance();
            Node n = this.parseTypeNameInit();
            n.isLive = true;
            return n;
        }
        if (this.check(154)) {
            this.advance();
            Node n = this.parseTypeNameInit();
            n.isOnce = true;
            return n;
        }
        if (this.check(155)) {
            this.advance();
            Node n = this.parseTypeNameInit();
            n.isShared = true;
            return n;
        }
        if (this.check(151)) {
            this.advance();
            Node n = new Node(); n.kind = 73; n.isAlias = true;
            string aliasType = this.advance().text;
            if (this.check(120)) {
                while (!this.check(121) && !this.check(106) && !this.check(103)) {
                    this.advance();
                }
                this.expect(121);
            }
            while (this.check(104)) {
                this.advance();
                this.expect(105);
                aliasType = aliasType + "[]";
            }
            if (this.check(123)) { this.advance(); aliasType = aliasType + "?"; }
            n.typeHint = aliasType;
            n.name = this.advance().text;
            n.children.add(this.makeNameNode(n.name));
            if (this.check(110)) {
                this.advance();
                n.children.add(this.parseExpr(0));
            }
            this.expectSemi();
            return n;
        }
        if (this.check(49)) {
            Node n = new Node(); n.kind = 60;
            this.advance();
            n.name = this.advance().text;
            this.expectSemi();
            return n;
        }
        if (this.check(52)) { return this.parseTryCatch(); }
        if (this.check(64)) { return this.parseThrow(); }
        // A primitive type keyword followed by `.` is a static-method
        // receiver (`int.parseInt(s)`), not a declaration.
        if ((this.check(28) || this.check(18) || this.check(19) || this.check(20) || this.check(25) || this.check(27) || this.check(22) || this.check(23) || this.check(26)) && !(this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 108)) {
            return this.parseVarDecl();
        }
        if (this.check(17) && this.pos + 2 < this.tokens.length && this.tokens[this.pos + 1].kind == 100 && this.tokens[this.pos + 2].kind == 101) {
            // DOCS/259 G2/G3 -- local fn-typed declaration: `void () cb;` or
            // `void ()[] jobs;` (decl-init forms included).  The value is an
            // 8-byte function address (or an array of them).
            this.advance();
            this.advance();
            this.advance();
            string declType = "void ()";
            while (this.check(104) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 105) {
                this.advance();
                this.advance();
                declType = declType + "[]";
            }
            Node n = new Node(); n.kind = 50;
            n.typeHint = declType;
            n.name = this.advance().text;
            if (this.check(110)) {
                this.advance();
                n.children.add(this.parseExpr(0));
            }
            this.expectSemi();
            return n;
        }
        Node exprStmt = new Node(); exprStmt.kind = 61;
        exprStmt.children.add(this.parseExpr(0));
        // Statement-final semicolon: recorded (merged into one message) when
        // missing, tolerated at end of file.
        this.expectSemi();
        return exprStmt;
    }

    private Node parseFixedVarDecl() {
        Node n = new Node(); n.kind = 50;
        string typeName = this.advance().text;
        n.name = this.advance().text;
        this.expect(104);
        Node sizeExpr = this.parseExpr(0);
        this.expect(105);
        n.typeHint = typeName + "[]";
        Node arr = new Node(); arr.kind = 19; arr.op = 1;
        if (sizeExpr.kind == 0) { arr.intVal = sizeExpr.intVal; }
        n.children.add(arr);
        this.expectSemi();
        return n;
    }

    private Node makeNameNode(string name) {
        Node n = new Node(); n.kind = 6; n.name = name; return n;
    }

    private Node parseVarDecl() {
        string typeName = this.advance().text;
        if (this.check(38)) {
            Node n = new Node(); n.kind = 111;
            n.typeHint = typeName;
            this.advance();
            n.name = this.advance().text;
            this.registerDeclaredType(n.name);
            this.expectSemi();
            return n;
        }
        this.pos = this.pos - 1;
        return this.parseTypeNameInit();
    }

    // `typealias Name = T;` — the `typealias` keyword spelling of the type
    // alias declaration (the existing `T as Name;` form parses via
    // parseVarDecl).  Emits the same kind-111 node so codegen treats both
    // spellings identically.
    private Node parseTypeAlias() {
        Node n = new Node(); n.kind = 111;
        this.expect(165);
        n.name = this.advance().text;
        this.expect(110);
        string aliasType = this.advance().text;
        if (this.check(120)) {
            while (!this.check(121) && !this.check(106) && !this.check(103)) {
                aliasType = aliasType + this.advance().text;
            }
            if (this.check(121)) { aliasType = aliasType + ">"; this.advance(); }
        }
        while (this.check(104)) {
            this.advance();
            this.expect(105);
            aliasType = aliasType + "[]";
        }
        if (this.check(123)) { this.advance(); aliasType = aliasType + "?"; }
        n.typeHint = aliasType;
        this.registerDeclaredType(n.name);
        this.expectSemi();
        return n;
    }

    private Node parseTypeNameInit() {
        Node n = new Node(); n.kind = 50;
        string typeName = this.advance().text;
        if (this.check(120)) {
            bool isTupleType = this.strEq(typeName, "tuple");
            while (!this.check(121) && !this.check(106) && !this.check(103)) {
                this.advance();
            }
            this.expect(121);
            if (isTupleType) { typeName = "tuple"; }
        } elif (this.strEq(typeName, "<")) {
            // Union/result type `<A | B>` (DOCS/29) or nullable `<T>`: collect
            // the member tokens into the type hint string.
            while (!this.check(121) && !this.check(106) && !this.check(103)) {
                typeName = typeName + this.advance().text;
            }
            if (this.check(121)) { typeName = typeName + ">"; this.advance(); }
        }
        while (this.check(104)) {
            this.advance();
            this.expect(105);
            typeName = typeName + "[]";
        }
        if (this.check(123)) { this.advance(); typeName = typeName + "?"; }
        n.typeHint = typeName;
        if (this.check(50)) { this.advance(); n.isMut = true; }
        n.name = this.advance().text;
        if (this.check(107)) {
            // Array destructuring declaration `int a, b = arr;` (DOCS/119):
            // binds successive array elements to fresh typed locals.
            Node destr = new Node(); destr.kind = 79;
            destr.typeHint = typeName;
            destr.children.add(this.makeNameNode(n.name));
            while (this.check(107)) {
                this.advance();
                destr.children.add(this.makeNameNode(this.advance().text));
            }
            this.expect(110);
            destr.children.add(this.parseExpr(0));
            this.expectSemi();
            return destr;
        }
        if (this.check(110)) {
            this.advance();
            n.children.add(this.parseExpr(0));
        } elif (this.check(140)) {
            this.advance();
            Node rhs = this.parseExpr(0);
            Node moveBin = new Node(); moveBin.kind = 7; moveBin.op = 28;
            moveBin.children.add(this.makeNameNode(n.name));
            moveBin.children.add(rhs);
            n.children.add(moveBin);
        }
        // TYPE_EXCEPTIONS.md — flag an initializer literal whose value kind
        // can never fit the declared scalar type (`int x = "hello"`).
        if (n.childCount() > 0) {
            this.checkDeclValueType(typeName, n.child(0), n.name);
        }
        this.expectSemi();
        return n;
    }

    private Node parseIf() {
        Node n = new Node(); n.kind = 53;
        if (this.check(56)) {
            this.advance();
        } else {
            this.expect(10);
        }
        this.expect(100);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlockOrStmt());
        if (this.check(11)) {
            this.advance();
            if (this.check(10)) {
                n.children.add(this.parseIf());
            } elif (this.check(56)) {
                n.children.add(this.parseIf());
            } else {
                n.children.add(this.parseBlockOrStmt());
            }
        } elif (this.check(56)) {
            n.children.add(this.parseIf());
        }
        return n;
    }

    private Node parseWhile() {
        Node n = new Node(); n.kind = 54;
        this.expect(12);
        this.expect(100);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlockOrStmt());
        return n;
    }

    // `switch (subject) { case v { body } ... else { body } }` (DOCS/108).
    // `switch`/`case` lex as identifiers.  Node shape: child(0) = subject,
    // then alternating (case value, case body) children; when the child count
    // is even the final child is the else body.  Codegen tests each case
    // against the subject with no fall-through.
    private Node parseSwitch() {
        Node n = new Node(); n.kind = 76;
        this.advance();
        this.expect(100);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        this.expect(102);
        while (!this.check(103) && !this.check(0)) {
            if (this.check(7) && this.strEq(this.peek().text, "case")) {
                this.advance();
                if (this.check(100)) {
                    this.advance();
                    n.children.add(this.parseExpr(0));
                    this.expect(101);
                } else {
                    n.children.add(this.parseExpr(0));
                }
                n.children.add(this.parseBlock());
            } elif (this.check(11) || (this.check(7) && this.strEq(this.peek().text, "default"))) {
                this.advance();
                n.children.add(this.parseBlock());
            } else {
                printline("Parse error at line " + this.peek().line.toString() + ", column " + this.peek().col.toString() + ": expected case or else in switch");
                exit(1);
            }
        }
        this.expect(103);
        return n;
    }

    // `loop { body }` (DOCS/12): an infinite loop with break/continue.  The
    // Rust bootstrap lowers `loop` to `while(true)`; here it gets its own
    // node (kind 77) so codegen emits an unconditional jump loop.
    private Node parseLoop() {
        Node n = new Node(); n.kind = 77;
        this.expect(166);
        n.children.add(this.parseBlockOrStmt());
        return n;
    }

    private Node parseTryCatch() {
        Node n = new Node(); n.kind = 59;
        this.expect(52);
        n.children.add(this.parseBlock());
        if (this.check(53)) {
            this.advance();
            this.expect(100);
            string catchType = this.advance().text;
            if (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } catchType = catchType + "[]"; }
            if (this.check(123)) { this.advance(); catchType = catchType + "?"; }
            n.name = this.advance().text;
            n.typeHint = catchType;
            this.expect(101);
            n.children.add(this.parseBlock());
        } else {
            Node empty = new Node(); empty.kind = 16;
            n.children.add(empty);
        }
        if (this.check(65)) {
            this.advance();
            n.hasFinally = true;
            n.children.add(this.parseBlock());
        }
        return n;
    }

    private Node parseThrow() {
        Node n = new Node(); n.kind = 68;
        this.advance();
        n.children.add(this.parseExpr(0));
        this.expectSemi();
        return n;
    }

    private Node parseFor() {
        Node n = new Node();
        this.expect(13);
        this.expect(100);
        // Range-style for loop: `for (type name as start to end) { body }`.
        // Look ahead for the `type name as` pattern; if present, desugar it
        // into the C-style for node (kind 55) that codegen already handles.
        int savedPos = this.pos;
        bool isRange = false;
        string rangeType = "";
        string rangeVar = "";
        if (this.check(28) || this.check(18) || this.check(19) || this.check(20) || this.check(7)) {
            rangeType = this.advance().text;
            if (this.check(7)) {
                rangeVar = this.advance().text;
                if (this.check(38)) {
                    isRange = true;
                }
            }
        }
        if (isRange) {
            this.advance();
            Node startExpr = this.parseExpr(0);
            this.expect(55);
            Node endExpr = this.parseExpr(0);
            this.expect(101);
            Node body = this.parseBlockOrStmt();
            n.kind = 55;
            // init: type name = start
            Node init = new Node();
            init.kind = 50;
            init.typeHint = rangeType;
            init.name = rangeVar;
            init.children.add(startExpr);
            n.children.add(init);
            // cond: name < end
            Node cond = new Node();
            cond.kind = 7;
            cond.op = 7;
            Node lhs = new Node();
            lhs.kind = 6;
            lhs.name = rangeVar;
            cond.children.add(lhs);
            cond.children.add(endExpr);
            n.children.add(cond);
            // update: name = name + 1
            Node upd = new Node();
            upd.kind = 7;
            upd.op = 20;
            Node uLhs = new Node();
            uLhs.kind = 6;
            uLhs.name = rangeVar;
            Node add = new Node();
            add.kind = 7;
            add.op = 1;
            Node aLhs = new Node();
            aLhs.kind = 6;
            aLhs.name = rangeVar;
            Node one = new Node();
            one.kind = 0;
            one.intVal = 1;
            add.children.add(aLhs);
            add.children.add(one);
            upd.children.add(uLhs);
            upd.children.add(add);
            n.children.add(upd);
            n.children.add(body);
            return n;
        }
        this.pos = savedPos;
        if (this.check(28) || this.check(18) || this.check(19) || this.check(20)) {
            n.kind = 55;
            n.children.add(this.parseVarDecl());
        } else {
            n.kind = 55;
            n.children.add(this.parseStmt());
        }
        n.children.add(this.parseExpr(0));
        this.expect(106);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlockOrStmt());
        return n;
    }

    // Array methods that take a predicate/transform lambda argument
    // (DOCS/81-84, 91, 99): map/filter/reduce/forEach/every/some/all/any/find.
    private bool isHofMethod(string name) {
        if (this.strEq(name, "map")) { return true; }
        if (this.strEq(name, "filter")) { return true; }
        if (this.strEq(name, "reduce")) { return true; }
        if (this.strEq(name, "forEach")) { return true; }
        if (this.strEq(name, "every")) { return true; }
        if (this.strEq(name, "some")) { return true; }
        if (this.strEq(name, "all")) { return true; }
        if (this.strEq(name, "any")) { return true; }
        if (this.strEq(name, "find")) { return true; }
        return false;
    }

    // Parse one argument of a higher-order call: either an inline lambda
    // (`x => expr`, `x << expr`, `(a, b) => expr`) or a plain expression.
    // Lambdas are represented as a kind-80 node whose children are the
    // parameter name nodes followed by the body expression.
    private Node parseLambdaArg() {
        // Multi-param form: `(a, b) => body` / `(a, b) << body`.  Backtracks
        // when the parenthesized text is really a plain expression.
        if (this.check(100)) {
            int saved = this.pos;
            Node? pl = this.tryParseParenLambda();
            if (pl != null) {
                return pl;
            }
            this.pos = saved;
        }
        // Single-param form: `x => body` / `x << body`.
        if (this.check(7) && this.pos + 1 < this.tokens.length) {
            int nextKind = this.tokens[this.pos + 1].kind;
            if (nextKind == 146 || nextKind == 140) {
                Node lam = new Node(); lam.kind = 80;
                lam.children.add(this.makeNameNode(this.advance().text));
                this.advance();
                lam.children.add(this.parseExpr(0));
                return lam;
            }
        }
        Node e = this.parseExpr(0);
        // `x << expr` can also arrive here as a shift expression when the
        // single form above did not catch it; per DOCS/81 it binds x in the
        // method's element position.
        if (e.kind == 7 && e.op == 18 && e.childCount() >= 2 && e.child(0).kind == 6) {
            Node lam = new Node(); lam.kind = 80;
            lam.children.add(e.child(0));
            lam.children.add(e.child(1));
            return lam;
        }
        return e;
    }

    private Node? tryParseParenLambda() {
        if (!this.check(100)) { return null; }
        this.advance();
        Node lam = new Node(); lam.kind = 80;
        while (this.check(7)) {
            lam.children.add(this.makeNameNode(this.advance().text));
            if (this.check(107)) { this.advance(); }
            else { break; }
        }
        if (!this.check(101)) { return null; }
        this.advance();
        if (!this.check(146) && !this.check(140)) { return null; }
        this.advance();
        lam.children.add(this.parseExpr(0));
        return lam;
    }

    private Node parseExpr(int minPrec) {
        Node lhs = this.parsePrefix();
        while (true) {
            if (this.check(100) && lhs.kind == 6) {
                Node call = new Node(); call.kind = 10;
                call.name = lhs.name;
                // The callee's own position: unknown-method diagnostics point
                // at the name, not at the arguments.
                call.line = lhs.line; call.col = lhs.col;
                Token openTok = this.peek();
                this.advance();
                int argc = 0;
                while (!this.check(101) && !this.check(0)) {
                    // Consume the separating comma, or report its absence
                    // (`add (1 2)`).
                    if (this.check(107)) {
                        this.advance();
                    } elif (argc > 0) {
                        Token prevT = this.tokens[this.pos - 1];
                        this.recordError("you forgot a comma \",\" at line " + prevT.line.toString() + ", column " + (prevT.col + this.tokenSrcLen(prevT)).toString());
                    }
                    call.children.add(this.parseExpr(0));
                    argc = argc + 1;
                }
                if (this.check(101)) {
                    this.advance();
                } else {
                    // Missing closing parenthesis: reported just past the
                    // opening one.
                    this.recordError("Missing close parenthesis at line " + openTok.line.toString() + ", column " + (openTok.col + 1).toString());
                }
                this.checkCallArgTypes(call);
                lhs = call;
                continue;
            }
            if (this.check(104)) {
                Node idx = new Node(); idx.kind = 24;
                idx.children.add(lhs);
                this.advance();
                // Inside the brackets, `..` is a slice boundary rather than a
                // binary range operator, so the index expression stops there.
                bool oldBoundary = this.rangeIsSliceBoundary;
                this.rangeIsSliceBoundary = true;
                idx.children.add(this.parseExpr(0));
                bool isSlice = this.check(109) || this.check(144);
                // Slice syntax: arr[a:b] (colon) or arr[a..b] (range) -> kind 67.
                if (isSlice) {
                    this.advance();
                    idx.kind = 67;
                    if (this.check(105)) {
                        // Open-ended slice [a:]: the end bound is the base's
                        // length, resolved in genSlice (sentinel intVal -1).
                        Node openEnd = new Node(); openEnd.kind = 0; openEnd.intVal = -1;
                        idx.children.add(openEnd);
                    } else {
                        idx.children.add(this.parseExpr(0));
                    }
                }
                this.rangeIsSliceBoundary = oldBoundary;
                this.expect(105);
                lhs = idx;
                continue;
            }
            if (this.check(100) && lhs.kind == 24) {
                // DOCS/259 G3 -- indirect call through a function-typed value
                // (`jobs[0]()`). The FULL index expression is carried as the
                // callee child so codegen performs the bounds-checked element
                // load; the element holds the function address. Zero-argument
                // calls only.
                Token callOpen = this.peek();
                this.advance();
                if (!this.check(101)) {
                    this.recordError(callOpen.line.toString() + ":" + callOpen.col.toString() + ": Unexpected token '(: function-typed values support only zero-argument calls — the supported type is `void ()` (see DOCS/259)'");
                    this.skipBalancedParens();
                } else {
                    this.advance();
                }
                Node indirect = new Node();
                indirect.kind = 87;
                indirect.line = lhs.line;
                indirect.col = lhs.col;
                indirect.children.add(lhs);
                lhs = indirect;
                continue;
            }
            if (this.check(108)) {
                this.advance();
                Token name = this.advance();
                if (this.check(100)) {
                    Node call = new Node(); call.kind = 10;
                    call.name = name.text;
                    call.isMember = true;
                    // Receiver-side position keeps post-parse diagnostics
                    // (VALUE_EXCEPTION.md path checks) pointed at this call.
                    call.line = lhs.line; call.col = lhs.col;
                    call.children.add(lhs);
                    bool hof = this.isHofMethod(name.text);
                    Token openTok2 = this.peek();
                    this.advance();
                    int mArgc = 0;
                    while (!this.check(101) && !this.check(0)) {
                        if (this.check(107)) {
                            this.advance();
                        } elif (mArgc > 0) {
                            Token prevT2 = this.tokens[this.pos - 1];
                            this.recordError("you forgot a comma \",\" at line " + prevT2.line.toString() + ", column " + (prevT2.col + this.tokenSrcLen(prevT2)).toString());
                        }
                        if (hof) {
                            call.children.add(this.parseLambdaArg());
                        } else {
                            call.children.add(this.parseExpr(0));
                        }
                        mArgc = mArgc + 1;
                    }
                    if (this.check(101)) {
                        this.advance();
                    } else {
                        // Missing closing parenthesis: reported just past the
                        // opening one.
                        this.recordError("Missing close parenthesis at line " + openTok2.line.toString() + ", column " + (openTok2.col + 1).toString());
                    }
                    // VALUE_EXCEPTION.md — numeric parse conversions on a
                    // literal string argument (`int.parseInt("hello")`).
                    if (lhs.kind == 6 && mArgc == 1) {
                        this.checkParseValueException(lhs.name, name.text, call.child(1));
                    }
                    lhs = call;
                } else {
                    Node member = new Node(); member.kind = 13;
                    member.name = name.text;
                    member.children.add(lhs);
                    lhs = member;
                }
                continue;
            }
            if (this.check(163)) {
                // Nullable-conditional member access `a?.b`: evaluate the
                // receiver once; when it is null the whole expression yields
                // null instead of dereferencing.  Wrapped in a kind-75 node
                // so codegen can short-circuit the member access/call.
                this.advance();
                Token name = this.advance();
                Node qmMember = null;
                if (this.check(100)) {
                    Node call = new Node(); call.kind = 10;
                    call.name = name.text;
                    call.isMember = true;
                    call.line = lhs.line; call.col = lhs.col;
                    call.children.add(lhs);
                    this.advance();
                    while (!this.check(101) && !this.check(0)) {
                        call.children.add(this.parseExpr(0));
                        if (this.check(107)) { this.advance(); }
                    }
                    this.expect(101);
                    qmMember = call;
                } else {
                    Node member = new Node(); member.kind = 13;
                    member.name = name.text;
                    member.children.add(lhs);
                    qmMember = member;
                }
                Node qm = new Node(); qm.kind = 75;
                qm.children.add(qmMember);
                lhs = qm;
                continue;
            }
            if (this.check(142)) {
                this.advance();
                Node one = new Node(); one.kind = 0; one.intVal = 1;
                Node inc = new Node(); inc.kind = 7; inc.op = 35;
                inc.children.add(lhs);
                inc.children.add(one);
                lhs = inc;
                continue;
            }
            if (this.check(143)) {
                this.advance();
                Node one = new Node(); one.kind = 0; one.intVal = 1;
                Node dec = new Node(); dec.kind = 7; dec.op = 36;
                dec.children.add(lhs);
                dec.children.add(one);
                lhs = dec;
                continue;
            }
            if (this.check(148) && minPrec <= 1) {
                this.advance();
                Node coalesce = new Node(); coalesce.kind = 7; coalesce.op = 25;
                coalesce.children.add(lhs);
                coalesce.children.add(this.parseExpr(2));
                lhs = coalesce;
                continue;
            }
            if (this.check(123) && minPrec <= 1) {
                this.advance();
                Node thenExpr = this.parseExpr(0);
                this.expect(109);
                Node elseExpr = this.parseExpr(0);
                Node tern = new Node(); tern.kind = 65;
                tern.children.add(lhs);
                tern.children.add(thenExpr);
                tern.children.add(elseExpr);
                lhs = tern;
                continue;
            }
            if (this.check(144) && this.rangeIsSliceBoundary) {
                // `..` inside a `[...]` index starts a slice, so it is not an
                // infix operator there; stop and let the index handler see it.
                break;
            }
            if (this.check(38) && this.isAsCastAhead()) {
                // DOCS/259 G4 -- `expr as Type`: a no-op cast for class
                // instances. Binds between the comparison operators (prec 5)
                // and the bitwise operators (prec 6+) — same relative strength
                // the Rust compiler gives it — and chains left-associatively.
                // `as` NOT followed by a type-like token is left alone (the
                // generic path then ends the expression, so statement-position
                // `T as Alias;` type aliases still parse through parseVarDecl
                // before any expression work).
                int castLine = this.peek().line;
                int castCol = this.peek().col;
                this.advance();
                string target = this.parseAsCastTarget();
                if (this.isPrimitiveTypeSpelling(target) || (lhs.kind >= 0 && lhs.kind <= 4)) {
                    this.recordError(castLine.toString() + ":" + castCol.toString() + ": Unexpected token 'as: as cast only supports class instances (see DOCS/259); got 'expression as " + target + "''");
                }
                Node cast = new Node();
                cast.kind = 86;
                cast.name = target;
                cast.line = castLine;
                cast.col = castCol;
                cast.children.add(lhs);
                lhs = cast;
                continue;
            }
            int prec = this.getPrec(this.peek().kind);
            if (prec < minPrec) { break; }
            int nextMin = prec + 1;
            int op = this.peek().kind;
            if (op == 110 || op == 130 || op == 131 || op == 132 || op == 133 || op == 157 || op == 158 || op == 159 || op == 160 || op == 161 || op == 162) {
                nextMin = 1;
            }
            this.advance();
            Node rhs = this.parseExpr(nextMin);
            Node bin = new Node(); bin.kind = 7;
            bin.op = this.tokenToOp(op);
            bin.children.add(lhs);
            bin.children.add(rhs);
            lhs = bin;
        }
        return lhs;
    }

    private int tokenToOp(int kind) {
        if (kind == 111) { return 1; }
        if (kind == 112) { return 2; }
        if (kind == 113) { return 3; }
        if (kind == 114) { return 4; }
        if (kind == 115) { return 13; }
        if (kind == 134) { return 5; }
        if (kind == 135) { return 6; }
        if (kind == 120) { return 7; }
        if (kind == 136) { return 8; }
        if (kind == 121) { return 9; }
        if (kind == 137) { return 10; }
        if (kind == 138) { return 11; }
        if (kind == 139) { return 12; }
        if (kind == 110) { return 20; }
        if (kind == 130) { return 14; }
        if (kind == 131) { return 15; }
        if (kind == 132) { return 16; }
        if (kind == 133) { return 17; }
        if (kind == 140) { return 18; }
        if (kind == 141) { return 19; }
        if (kind == 157) { return 29; }
        if (kind == 158) { return 30; }
        if (kind == 159) { return 31; }
        if (kind == 160) { return 32; }
        if (kind == 161) { return 33; }
        if (kind == 162) { return 34; }
        if (kind == 144) { return 27; }
        if (kind == 147) { return 26; }
        if (kind == 148) { return 25; }
        if (kind == 116) { return 22; }
        if (kind == 117) { return 23; }
        if (kind == 118) { return 24; }
        return 0;
    }

    // DOCS/259 G4 -- lookahead for the `as` cast: the `as` keyword must be
    // followed by a type-like token (class identifier or primitive keyword).
    // A comma, closing paren/bracket, semicolon, brace, or operator after
    // `as` means it is NOT a cast (e.g. the range-for `for (x as start..end)`
    // spelling is consumed before parseExpr ever sees that context, and bare
    // `T as Alias;` declaration statements end the expression here).
    private bool isAsCastAhead() {
        if (this.pos + 1 >= this.tokens.length) { return false; }
        int nk = this.tokens[this.pos + 1].kind;
        if (nk == 7) { return true; }
        if (nk == 17 || nk == 18 || nk == 19 || nk == 20 || nk == 22 || nk == 23 || nk == 25 || nk == 26 || nk == 27) { return true; }
        return false;
    }

    // DOCS/259 G4 -- parse the cast target spelling after `as`: an
    // identifier (class name), a primitive keyword, or a generic/nullable
    // shape. Array/nullable suffixes are accepted like a plain type.
    private string parseAsCastTarget() {
        Token t = this.advance();
        string target = t.text;
        if (this.check(120)) {
            while (!this.check(121) && !this.check(106) && !this.check(103)) {
                target = target + this.advance().text;
            }
            if (this.check(121)) { target = target + ">"; this.advance(); }
        }
        while (this.check(104)) {
            this.advance();
            this.expect(105);
            target = target + "[]";
        }
        if (this.check(123)) { this.advance(); target = target + "?"; }
        return target;
    }

    // DOCS/259 G4 -- primitive type spellings rejected as cast targets (the
    // cast is only a class-instance assertion).
    private bool isPrimitiveTypeSpelling(string t) {
        if (this.strEq(t, "int")) { return true; }
        if (this.strEq(t, "int32")) { return true; }
        if (this.strEq(t, "int64")) { return true; }
        if (this.strEq(t, "uint")) { return true; }
        if (this.strEq(t, "float")) { return true; }
        if (this.strEq(t, "float64")) { return true; }
        if (this.strEq(t, "double")) { return true; }
        if (this.strEq(t, "bool")) { return true; }
        if (this.strEq(t, "byte")) { return true; }
        if (this.strEq(t, "char")) { return true; }
        if (this.strEq(t, "string")) { return true; }
        if (this.strEq(t, "void")) { return true; }
        return false;
    }

    private int getPrec(int kind) {
        if (kind == 110 || kind == 130 || kind == 131 || kind == 132 || kind == 133 || kind == 148 || kind == 157 || kind == 158 || kind == 159 || kind == 160 || kind == 161 || kind == 162) { return 1; }
        if (kind == 139) { return 2; }
        if (kind == 138) { return 3; }
        if (kind == 135 || kind == 134) { return 4; }
        if (kind == 120 || kind == 136 || kind == 121 || kind == 137) { return 5; }
        if (kind == 117) { return 6; }
        if (kind == 116) { return 7; }
        if (kind == 118) { return 7; }
        if (kind == 140 || kind == 141) { return 8; }
        if (kind == 111 || kind == 112) { return 9; }
        if (kind == 113 || kind == 114 || kind == 115) { return 10; }
        if (kind == 147) { return 4; }
        if (kind == 144) { return 11; }
        return -1;
    }

    private Node parsePrefix() {
        Token t = this.advance();
        Node n = new Node();
        n.line = t.line; n.col = t.col;
        int kind = t.kind;

        if (kind == 1) {
            // Number literal.  The token text distinguishes ints from floats:
            // a float's spelling contains a '.' (46) or exponent marker
            // 'e'/'E' (101/69), which the lexer preserves verbatim.
            bool isFloat = false;
            for (int tc = 0; tc < t.text.length; tc++) {
                int tcc = t.text[tc];
                if (tcc == 46 || tcc == 101 || tcc == 69) { isFloat = true; break; }
            }
            if (isFloat) { n.kind = 1; n.intVal = t.intVal; }
            else { n.kind = 0; n.intVal = t.intVal; }
            return n;
        }
        if (kind == 2) { n.kind = 1; n.floatVal = t.floatVal; return n; }
        if (kind == 3) { n.kind = 2; n.strVal = t.strVal; return n; }
        if (kind == 4) { n.kind = 3; n.charVal = t.charVal; return n; }
        if (kind == 5) {
            n.kind = 4;
            n.boolVal = this.strEq(t.text, "true");
            return n;
        }
        if (kind == 6) { n.kind = 5; return n; }
        if (kind == 7) { n.kind = 6; n.name = t.text; return n; }        if (kind == 39) {
            Node ctor = new Node();
            ctor.kind = 10;
            ctor.name = this.advance().text;
            ctor.line = t.line;
            ctor.col = t.col;
            // Marker for codegen (mini_cg isClass==1 branch): this kind-10
            // call node came from a `new T(...)` expression, not a bare
            // call. Without it a same-named imported win32 export (net.sr's
            // bare `socket(2,1,0)` under `class socket`) is hijacked into
            // the constructor path -- silverc-rs distinguishes the two at
            // parse level and resolves the DLL export first.
            ctor.isStatic = true;
            // Dotted-new: a qualified class
            // name `new mod.Class(args)` — any chain depth, the last segment
            // is the class. Joined into a single dotted call name; codegen
            // resolves it through the module's flattened namespace. Each
            // segment must be an identifier (parse error otherwise, matching
            // the reference compiler's ExpectedToken("identifier")).
            while (this.check(108)) {
                this.advance();
                ctor.name = ctor.name + "." + this.expect(7).text;
            }
            if (this.check(104)) {
                // new T[n]: native array allocation.  A zero/omitted size
                // produces an empty array; a positive constant size produces
                // that many zeroed slots.  A non-literal size expression
                // marks an op=2 runtime-sized allocation node (child 0 = the
                // size expression) that codegen lowers through the same
                // HeapAlloc shape silverc-rs emits — net.sr's
                // `new int[slots]` buffers depend on it.
                this.advance();
                Node sizeExpr = this.parseExpr(0);
                this.expect(105);
                Node arr = new Node(); arr.kind = 19;
                if (sizeExpr.kind == 0) {
                    arr.op = 1;
                    arr.intVal = sizeExpr.intVal;
                }
                if (sizeExpr.kind == 0 && sizeExpr.intVal > 0 && sizeExpr.intVal <= 256) {
                    for (int zi = 0; zi < sizeExpr.intVal; zi++) {
                        Node zero = new Node(); zero.kind = 0; zero.intVal = 0;
                        arr.children.add(zero);
                    }
                }
                if (sizeExpr.kind != 0) {
                    arr.op = 2;
                    arr.children.add(sizeExpr);
                }
                return arr;
            }
            this.expect(100);
            while (!this.check(101) && !this.check(0)) {
                ctor.children.add(this.parseExpr(0));
                if (this.check(107)) { this.advance(); }
            }
            this.expect(101);
            return ctor;
        }

        if (kind == 16) {
            // `match (subject) { pattern => expr; ... }` is an expression: the
            // value of the matched arm is the match's value.  Arms may carry a
            // guard `pattern if cond => body` (DOCS/154); the guard (if any)
            // is stored as arm child(1) so codegen can test it after the
            // pattern binds.
            Node m = new Node(); m.kind = 20;
            if (this.check(100)) {
                this.advance();
                m.children.add(this.parseExpr(0));
                this.expect(101);
            } else {
                m.children.add(this.parseExpr(0));
            }
            this.expect(102);
            while (!this.check(103) && !this.check(0)) {
                Node arm = new Node(); arm.kind = 21;
                arm.children.add(this.parsePattern());
                if (this.check(10)) {
                    this.advance();
                    arm.children.add(this.parseExpr(0));
                }
                this.expect(146);
                arm.children.add(this.parseExpr(0));
                if (this.check(106)) { this.advance(); }
                m.children.add(arm);
            }
            this.expect(103);
            return m;
        }

        if (kind == 100) {
            // DOCS/259 -- anonymous function argument. The supported form is
            // `(void () { ... })`; the lookahead is `void` `(` `)` `{`.
            if (this.check(17) && this.pos + 3 < this.tokens.length
                && this.tokens[this.pos + 1].kind == 100
                && this.tokens[this.pos + 2].kind == 101
                && this.tokens[this.pos + 3].kind == 102) {
                this.advance();
                this.advance();
                this.advance();
                Node anonBody = this.parseBlock();
                this.expect(101);
                Node anon = new Node();
                anon.kind = 85;
                anon.line = t.line;
                anon.col = t.col;
                anon.children.add(anonBody);
                return anon;
            }
            // DOCS/259 -- an anonymous-function attempt whose shape is not the
            // supported `void ()`: a type keyword, `(`, a balanced parameter
            // list, then `{`. Reported instead of a generic parse failure.
            if (this.isUnsupportedAnonFnAhead()) {
                this.recordError(t.line.toString() + ":" + t.col.toString() + ": Unexpected token '(: only `void ()` anonymous functions are supported; parameters and non-void return types in function types are not supported yet (see DOCS/259)'");
                this.skipAnonFnShapedTokens();
                Node unsupportedNul = new Node();
                unsupportedNul.kind = 5;
                return unsupportedNul;
            }
            // C-style casts used by legacy/runtime modules, e.g. `(int) c`.
            // Integer and character values share the native scalar
            // representation, so the self-hosted backend can lower these
            // casts as the operand itself.  Detect the cast before ordinary
            // parenthesized/tuple expressions; the required closing `)` makes
            // the forms unambiguous.
            int castSaved = this.pos;
            bool castType = this.check(17) || this.check(18) || this.check(19) || this.check(20) || this.check(22) || this.check(23) || this.check(25) || this.check(26) || this.check(27) || this.check(28) || this.check(7);
            if (castType) {
                this.advance();
                if (this.check(101)) {
                    this.advance();
                    return this.parseExpr(10);
                }
            }
            this.pos = castSaved;
            Node first = this.parseExpr(0);
            if (this.check(107)) {
                n.kind = 70;
                n.children.add(first);
                while (this.check(107)) {
                    this.advance();
                    n.children.add(this.parseExpr(0));
                }
                this.expect(101);
                return n;
            }
            n.kind = 23; n.children.add(first); this.expect(101); return n;
        }
        if (kind == 102) {
            if (this.check(103)) {
                n.kind = 66;
                this.advance();
                return n;
            }
            // Braced string/int key pairs are dictionary literals; a braced
            // identifier-keyed form is a struct literal; other braced
            // expressions retain the historical array-compatible form.
            if (this.check(3) || this.check(1) || this.check(7)) {
                int saved = this.pos;
                Node firstKey = this.parseExpr(0);
                if (this.check(109)) {
                    this.advance();
                    if (firstKey.kind == 6) {
                        // Struct literal: `{name: value, ...}`. Field names are
                        // identifiers; keep each pair as `(identifier, value)`.
                        n.kind = 74;
                        Node pair = new Node(); pair.kind = 18;
                        pair.children.add(firstKey);
                        pair.children.add(this.parseExpr(0));
                        n.children.add(pair);
                        while (this.check(107)) {
                            this.advance();
                            Node key = this.parseExpr(0);
                            this.expect(109);
                            Node nextPair = new Node(); nextPair.kind = 18;
                            nextPair.children.add(key);
                            nextPair.children.add(this.parseExpr(0));
                            n.children.add(nextPair);
                        }
                        this.expect(103);
                        return n;
                    }
                    n.kind = 66;
                    Node dpair = new Node(); dpair.kind = 18;
                    dpair.children.add(firstKey);
                    dpair.children.add(this.parseExpr(0));
                    n.children.add(dpair);
                    while (this.check(107)) {
                        this.advance();
                        Node key = this.parseExpr(0);
                        this.expect(109);
                        Node nextPair = new Node(); nextPair.kind = 18;
                        nextPair.children.add(key);
                        nextPair.children.add(this.parseExpr(0));
                        n.children.add(nextPair);
                    }
                    this.expect(103);
                    return n;
                }
                this.pos = saved;
            }
            n.kind = 19;
            while (!this.check(103) && !this.check(0)) {
                n.children.add(this.parseExpr(0));
                if (this.check(107)) { this.advance(); }
            }
            this.expect(103);
            return n;
        }

        if (kind == 104) {
            n.kind = 19;
            while (!this.check(105) && !this.check(0)) {
                if (this.check(147)) {
                    // Spread element `...arr` inside an array literal (DOCS/116):
                    // copy the source array's elements into this literal.
                    this.advance();
                    Node sp = new Node(); sp.kind = 77;
                    sp.children.add(this.parseExpr(0));
                    n.children.add(sp);
                } else {
                    n.children.add(this.parseExpr(0));
                }
                if (this.check(107)) { this.advance(); }
            }
            this.expect(105);
            return n;
        }

        if (kind == 112) { n.kind = 8; n.op = 0; n.children.add(this.parseExpr(10)); return n; }
        if (kind == 122) { n.kind = 8; n.op = 1; n.children.add(this.parseExpr(10)); return n; }
        if (kind == 119) { n.kind = 8; n.op = 2; n.children.add(this.parseExpr(10)); return n; }
        if (kind == 116) { n.kind = 8; n.op = 3; n.children.add(this.parseExpr(10)); return n; }
        if (kind == 156) {
            Node a = new Node(); a.kind = 72;
            a.children.add(this.parseExpr(10));
            return a;
        }
        if (kind == 149) {
            if (this.check(3)) {
                Token st = this.advance();
                Node ip = this.parseInterpString(st.strVal);
                ip.line = t.line; ip.col = t.col;
                return ip;
            }
            Node bad = new Node(); bad.kind = 6; bad.name = "$";
            return bad;
        }

        if (kind == 17) {
            // DOCS/259: an anonymous function argument must be wrapped in
            // parentheses — `void () { ... }` alone is not a value. Recovery
            // consumes the anon-shaped tokens so the damaged region reports
            // only this error.
            if (this.check(100)) {
                this.recordError(t.line.toString() + ":" + t.col.toString() + ": Unexpected token 'void: the anonymous function must be wrapped in parentheses — write (void () { ... }) (see DOCS/259)'");
                this.skipBalancedParens();
                if (this.check(102)) { this.skipBalancedBraces(); }
                Node wrapNul = new Node();
                wrapNul.kind = 5;
                return wrapNul;
            }
        }

        Node ident = new Node(); ident.kind = 6; ident.name = t.text;
        return ident;
    }

    private Node parseInterpString(string s) {
        Node n = new Node();
        n.kind = 69;
        n.name = "interp";
        string text = "";
        int i = 0;
        while (i < s.length) {
            if (s[i] == '{') {
                if (text.length > 0) {
                    Node tn = new Node(); tn.kind = 2; tn.strVal = text;
                    n.children.add(tn);
                    text = "";
                }
                int depth = 1;
                i = i + 1;
                string exprSrc = "";
                while (i < s.length && depth > 0) {
                    if (s[i] == '{') { depth = depth + 1; }
                    elif (s[i] == '}') {
                        depth = depth - 1;
                        if (depth == 0) { break; }
                    }
                    exprSrc = exprSrc + charToString(s[i]);
                    i = i + 1;
                }
                if (depth == 0) {
                    Lexer lx = new Lexer(exprSrc);
                    Token[] toks = lx.tokenize();
                    Parser pp = new Parser(toks);
                    Node en = pp.parseExpr(0);
                    n.children.add(en);
                }
                i = i + 1;
            } else {
                text = text + charToString(s[i]);
                i = i + 1;
            }
        }
        if (text.length > 0) {
            Node tn = new Node(); tn.kind = 2; tn.strVal = text;
            n.children.add(tn);
        }
        return n;
    }

    // ---- DOCS/259 helpers ---------------------------------------------------

    // Reject the C-style `function` keyword at the point a parameter type is
    // expected. `function` is not a Silver keyword (it lexes as an
    // identifier), so the check matches the identifier's text.
    private bool rejectCStyleFunctionParam() {
        Token t = this.peek();
        if (t.kind == 7 && this.strEq(t.text, "function")) {
            this.recordError(t.line.toString() + ":" + t.col.toString() + ": Unexpected token 'function: function-typed parameters are declared `void () name` and passed as `(void () { ... })` — C-style `function` keyword is not Silver (see DOCS/259)'");
            return true;
        }
        return false;
    }

    // After a verbatim DOCS/259 rejection: consume the damaged function's
    // remaining tokens (rest of the parameter list, optional arrow/return
    // type, body) so the report contains exactly the one error.
    private void skipDamagedFunction() {
        int depth = 1;
        while (!this.check(0)) {
            if (this.check(100)) {
                depth = depth + 1;
                this.advance();
            } elif (this.check(101)) {
                depth = depth - 1;
                this.advance();
                if (depth == 0) { break; }
            } else {
                this.advance();
            }
        }
        if (this.check(145)) {
            while (!this.check(0) && !this.check(102) && !this.check(106)) { this.advance(); }
            if (this.check(106)) { this.advance(); }
        }
        if (this.check(141) || this.check(140)) {
            this.advance();
            while (!this.check(0) && !this.check(106) && !this.check(103)) { this.advance(); }
            if (this.check(106)) { this.advance(); }
        } elif (this.check(102)) {
            this.skipBalancedBraces();
            if (this.check(106)) { this.advance(); }
        }
    }

    // DOCS/259 -- register a rejected function's name as a known (empty)
    // signature so call sites in the remaining program text do not produce
    // follow-on unknown-method noise.
    private void registerDamagedSignature(string name) {
        this.sigNames.add(name);
        this.sigTypes.add("");
        this.sigParams.add("");
        this.sigVariadic.add(0);
    }

    // DOCS/259 -- after the outer `(` of a parenthesized expression has been
    // consumed, decide whether what follows is an anonymous-function attempt
    // whose shape is not the supported `void ()`: a type keyword, `(`, a
    // balanced parameter list, then `{`.
    private bool isUnsupportedAnonFnAhead() {
        bool typeKw = this.check(17) || this.check(18) || this.check(19) || this.check(20)
            || this.check(22) || this.check(23) || this.check(25) || this.check(26) || this.check(27);
        if (!typeKw) {
            // uint/byte/double/long lex as identifiers in this grammar.
            if (this.check(7)) {
                string w = this.peek().text;
                typeKw = this.strEq(w, "uint") || this.strEq(w, "byte") || this.strEq(w, "double")
                    || this.strEq(w, "long") || this.strEq(w, "boolean");
            }
        }
        if (!typeKw) { return false; }
        if (this.pos + 1 >= this.tokens.length || this.tokens[this.pos + 1].kind != 100) { return false; }
        int depth = 0;
        int i = this.pos + 1;
        while (i < this.tokens.length) {
            int k = this.tokens[i].kind;
            if (k == 100) {
                depth = depth + 1;
                i = i + 1;
            } elif (k == 101) {
                depth = depth - 1;
                i = i + 1;
                if (depth == 0) { break; }
            } elif (k == 0) {
                return false;
            } else {
                i = i + 1;
            }
        }
        if (i >= this.tokens.length) { return false; }
        return this.tokens[i].kind == 102;
    }

    // Consume the rejected `( Type ( ... ) { ... } )` shape so the damaged
    // region produces no follow-on errors. The outer `(` is already consumed
    // when this runs.
    private void skipAnonFnShapedTokens() {
        this.skipBalancedParens();
        if (this.check(102)) { this.skipBalancedBraces(); }
        if (this.check(101)) { this.advance(); }
    }

    // From the current token, consume a balanced `(...)` run including the
    // opening parenthesis. A leading `)` that would take the depth negative
    // is left in place (mirrors the reference lookahead walker).
    private void skipBalancedParens() {
        int depth = 0;
        bool started = false;
        while (!this.check(0)) {
            if (this.check(100)) {
                depth = depth + 1;
                started = true;
                this.advance();
            } elif (this.check(101)) {
                if (!started) { return; }
                depth = depth - 1;
                this.advance();
                if (depth == 0) { return; }
            } else {
                this.advance();
            }
        }
    }

    // From the current token (expected to be `{`), consume through the
    // matching closing brace.
    private void skipBalancedBraces() {
        int depth = 0;
        while (!this.check(0)) {
            if (this.check(102)) {
                depth = depth + 1;
                this.advance();
            } elif (this.check(103)) {
                depth = depth - 1;
                this.advance();
                if (depth == 0) { return; }
            } else {
                this.advance();
            }
        }
    }

    private Node parsePattern() {
        Node n = new Node();
        Token t = this.advance();
        if (t.kind == 126) { n.name = "_"; return n; }
        if (t.kind == 1) { n.kind = 0; n.intVal = t.intVal; return n; }
        if (t.kind == 3) { n.kind = 2; n.strVal = t.strVal; return n; }
        if (t.kind == 4) { n.kind = 3; n.charVal = t.charVal; return n; }
        if (t.kind == 100) {
            // Tuple pattern `(p1, p2, ...)` (kind 78): positional compare and
            // bind.  The codegen walks each element at ptr + i*8.
            n.kind = 78;
            while (!this.check(101) && !this.check(0)) {
                n.children.add(this.parsePattern());
                if (this.check(107)) { this.advance(); }
            }
            this.expect(101);
            return n;
        }
        if (t.kind == 7) {
            n.name = t.text;
            if (this.check(108)) {
                // Enum variant pattern `Enum.Variant` (kind 13): the codegen
                // compares the subject against the enum's constant value.
                this.advance();
                n.kind = 13;
                n.name = t.text + "." + this.advance().text;
            }
            return n;
        }
        return n;
    }
}

// ---- EXCEPTIONS/*.md shared suggestion helpers ----------------------------

// Levenshtein edit distance between two lowercase-folded words.
int diagLevenshtein(string a, string b) {
    int alen = a.length;
    int blen = b.length;
    if (alen == 0) { return blen; }
    if (blen == 0) { return alen; }
    int[] prev = [];
    int[] cur = [];
    for (int j = 0; j <= blen; j++) { prev.add(j); cur.add(0); }
    for (int i = 1; i <= alen; i++) {
        cur[0] = i;
        for (int j = 1; j <= blen; j++) {
            int cost = 1;
            if (a[i - 1] == b[j - 1]) { cost = 0; }
            int del = prev[j] + 1;
            int ins = cur[j - 1] + 1;
            int sub = prev[j - 1] + cost;
            int best = del;
            if (ins < best) { best = ins; }
            if (sub < best) { best = sub; }
            cur[j] = best;
        }
        for (int k = 0; k <= blen; k++) { prev[k] = cur[k]; }
    }
    return prev[blen];
}

string diagToLower(string word) {
    string lo = "";
    for (int i = 0; i < word.length; i++) {
        char c = word[i];
        if (c >= 'A' && c <= 'Z') { c = c + 32; }
        lo = lo + charToString(c);
    }
    return lo;
}

// Smallest-edit-distance suggestion lookup (Levenshtein).  A candidate
// qualifies when it differs by one edit, or by two edits with the same first
// two letters (a real typo shape, not merely similar junk).
string diagClosestMatch(string needle, string[] candidates) {
    string needleLc = diagToLower(needle);
    if (needleLc.length == 0) { return ""; }
    string best = "";
    int bestDist = 0;
    for (int i = 0; i < candidates.length; i++) {
        string candLc = diagToLower(candidates[i]);
        if (candLc.length == 0) { continue; }
        int d = diagLevenshtein(needleLc, candLc);
        bool acceptable = false;
        if (d == 1) { acceptable = true; }
        elif (d == 2 && needleLc.length >= 3) {
            if (needleLc[0] == candLc[0] && needleLc[1] == candLc[1]) { acceptable = true; }
        }
        if (acceptable) {
            if (best.length == 0 || d < bestDist) {
                best = candidates[i];
                bestDist = d;
            }
        }
    }
    return best;
}