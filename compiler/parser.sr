mod export parser;

import * from token;
import * from node;
import * from lexer;
import * from string;
import * from path;
import * from array;

class Parser {
    private prop Token[] tokens;
    private prop int pos;
    // Inside a `[...]` index, a top-level `..` (token 144) starts a slice
    // rather than a binary range expression.
    private bool rangeIsSliceBoundary;
    // ---- EXCEPTIONS/*.md diagnostics --------------------------------------
    // Recoverable syntax errors, one message per line, in source order
    // (SYNTAX_EXCEPTIONS.md #4).  The driver prints them all and exits.
    public prop string[] diagErrors;
    // Missing-semicolon positions, flushed as ONE merged message at the end
    // of parseProgram.
    private int[] missingSemiLines;
    private int[] missingSemiCols;
    // Lowercase user-declared type names (def/enum/struct/class/typealias):
    // `direction dir = ...` is a declaration, not an unknown keyword.
    private string[] declaredTypes;
    // Identifiers with known meaning that may appear as bare statements
    // (builtins plus every function/const name parsed so far).
    private string[] knownIdents;
    // Parsed function signatures for TYPE_EXCEPTIONS call-arg checks:
    // parallel arrays; types/names joined with commas per signature.
    private string[] sigNames;
    private string[] sigTypes;
    private string[] sigParams;
    private int[] sigVariadic;
    // Per-line character lengths (1-based indexing via line-1) used to point
    // just past the end of a line for missing-bracket diagnostics.
    private int[] lineLens;
    // win32 grants recorded from import statements (DOCS/213): a full open
    // (`import * from win32;`), opened module names (`win32.<mod>`), and
    // individually granted export names.  Used by the post-parse
    // unknown-method walk so free Win32 calls are never flagged.
    private bool win32AllModules;
    private string[] win32OpenModules;
    private string[] win32GrantNames;
    // linux grants recorded from import statements (LINUX.md Phase B): a
    // full open (`import * from linux;`), opened module names
    // (`linux.libc`, `linux.x11`, `linux.xtst`), and individually granted
    // export names. Mirrors the win32 trio above; used by the same
    // unknown-method walk so free libc/X11 calls are never flagged. Like
    // win32, `linux.libc` is the public systems surface while the other
    // linux.* modules stay std-internal (enforced by visibility.sr).
    private bool linuxAllModules;
    private string[] linuxOpenModules;
    private string[] linuxGrantNames;
    // MAC.md Phase C -- mac grants, mirroring the linux trio above: a full
    // open (`import * from mac;`), opened module names (`mac.libsystem`,
    // `mac.objc`), and individually granted export names. Used by the same
    // unknown-method walk so free libSystem/objc calls are never flagged.
    // No public mac.* module initially (std-internal, enforced by
    // visibility.sr, mirroring how Linux started).
    private bool macAllModules;
    private string[] macOpenModules;
    private string[] macGrantNames;
    // DOCS/261 -- per-project custom native modules (`.srp` `nativeModules`).
    // Declared custom names resolve per target OS (bare `import { f } from m;`
    // uses the `windows` file on WINDOWS/MAC, the `linux` file on LINUX; star
    // needs an export list). Fixed `win32.*`/`linux.*` tables above are
    // untouched; custom grants skip the std-internal rule (manifest opt-in).
    // Empty when the manifest declares none (absent key = no change).
    public NativeModules customNative;
    public string customTargetOs;
    // `mod export NAME;` declarations and inline `mod NAME { ... }` blocks:
    // names plus their `internal` flag (DOCS/258). The flattened program
    // drops these containers, so the visibility pass reads them from here.
    public string[] modExportNames;
    public bool[] modExportInternal;
    // Owning module of the top-level item currently being parsed: the last
    // `mod export NAME;` (or `mod NAME;`) declaration seen. parseProgram tags
    // every hoisted item with it, so codegen can bind a module-qualified call
    // (`datetime.now()`) to the named module's own global when two collected
    // modules export the same top-level name. The entry file declares no
    // module, so its items keep "" and resolve exactly as before.
    public string curModule;
    // `internal:` section marker active inside the class body being parsed
    // (reset by `public:`/`private:` and at the start of every class).
    private bool classSectionInternal;
    // DOCS/259 -- function-typed parameters (`void () name`) of the function
    // whose body the call-diagnostics walk is currently inside. A zero-arg
    // call to one of these names invokes the stored address instead of a
    // declared function, so the unknown-call check must accept it.
    private string[] fnPtrCallScope;
    // DOCS/259 -- top-level variable names, collected before the diagnostics
    // walk. Anonymous function bodies are isolated scopes: their identifier
    // uses resolve against their own locals, these globals, and the file's
    // known symbols -- never against the enclosing function's locals.
    private string[] anonKnownGlobals;
    // Depth of anonymous-function bodies the diagnostics walk is inside.
    private int anonWalkDepth;
    // DOCS/261 / SPEC 15.6 -- membership operators: nesting depth of `(`
    // grouping parentheses (incremented in if/while/switch conditions and
    // around `(` grouping prefixes).  A bare `not in` outside parentheses
    // (depth 0) is a parse error.
    private int parenDepth;
    // Set while parsing the right operand of a membership operator: `in`
    // there is an operator token again, never the `in` of a `for`/`foreach`
    // loop header.
    private bool inMembershipOperand;
    // DOCS/274: hidden class definitions minted by `new class { ... }`
    // expressions. Each anonymous class desugars to a top-level class with
    // a generated name plus a `new Hidden()` expression; the definitions
    // accumulate here during the parse and are drained into the program by
    // parseProgram, so every downstream stage sees an ordinary named class.
    private prop Node[] anonClasses;
    // DOCS/274: per-parse counter mixed into each minted hidden-class name
    // (alongside the definition's structural hash) so two identical bodies
    // still mint distinct names.
    private prop int anonCounter;

    construct (Token[] toks) {
        this.tokens = toks;
        this.pos = 0;
        this.rangeIsSliceBoundary = false;
        this.diagErrors = [];
        this.missingSemiLines = [];
        this.missingSemiCols = [];
        this.declaredTypes = [];
        this.knownIdents = [];
        this.sigNames = [];
        this.sigTypes = [];
        this.sigParams = [];
        this.sigVariadic = [];
        this.lineLens = [];
        this.win32AllModules = false;
        this.win32OpenModules = [];
        this.win32GrantNames = [];
        this.linuxAllModules = false;
        this.linuxOpenModules = [];
        this.linuxGrantNames = [];
        this.macAllModules = false;
        this.macOpenModules = [];
        this.macGrantNames = [];
        this.customNative = new NativeModules();
        this.customTargetOs = "";
        this.modExportNames = [];
        this.modExportInternal = [];
        this.curModule = "";
        this.classSectionInternal = false;
        this.fnPtrCallScope = [];
        this.anonKnownGlobals = [];
        this.anonWalkDepth = 0;
        this.parenDepth = 0;
        this.inMembershipOperand = false;
        this.anonClasses = [];
        this.anonCounter = 0;
    }

    // Provide per-line character lengths so bracket diagnostics can point
    // just past the end of a line (SYNTAX_EXCEPTIONS.md #3).
    public void setLineLengths(int[] lens) {
        this.lineLens = lens;
    }

    private void recordError(string msg) {
        this.diagErrors.add(msg);
    }

    // Source width of a token (quotes included for literals), used for
    // insertion-point columns of missing `;` / `,` / `)`.
    private int tokenSrcLen(Token t) {
        if (t.kind == 3 || t.kind == 4) { return t.text.length + 2; }
        return t.text.length;
    }

    private int prevEndLine() {
        if (this.pos == 0) { return this.peek().line; }
        return this.tokens[this.pos - 1].line;
    }

    private int prevEndCol() {
        if (this.pos == 0) { return this.peek().col; }
        Token prev = this.tokens[this.pos - 1];
        return prev.col + this.tokenSrcLen(prev);
    }

    // Column one past the last character of the given line (1-based), or -1
    // when line lengths were not provided.
    private int lineEndCol(int line) {
        if (line >= 1 && line <= this.lineLens.length) { return this.lineLens[line - 1] + 1; }
        return -1;
    }

    // Statement-final semicolon: consume it, or record the position and keep
    // parsing (SYNTAX_EXCEPTIONS.md "Missing semicolons").  EOF tolerates
    // the final statement of a file, and a preceding `}` already terminates
    // braced statements (match/switch/block expressions).
    private void expectSemi() {
        if (this.check(106)) { this.advance(); return; }
        if (this.check(0)) { return; }
        if (this.pos > 0 && this.tokens[this.pos - 1].kind == 103) { return; }
        this.missingSemiLines.add(this.prevEndLine());
        this.missingSemiCols.add(this.prevEndCol());
    }

    // All Silver keywords, used for did-you-mean suggestions.
    public string[] keywordCandidates() {
        string[] cands = [];
        cands.add("if"); cands.add("else"); cands.add("elif"); cands.add("while");
        cands.add("for"); cands.add("foreach"); cands.add("return"); cands.add("match");
        cands.add("void"); cands.add("int"); cands.add("int32"); cands.add("int64");
        cands.add("uint"); cands.add("uint64"); cands.add("float"); cands.add("float64"); cands.add("double");
        cands.add("bool"); cands.add("byte"); cands.add("char"); cands.add("string");
        cands.add("var"); cands.add("struct"); cands.add("class"); cands.add("enum");
        cands.add("def"); cands.add("found"); cands.add("collect"); cands.add("mod");
        cands.add("export"); cands.add("import"); cands.add("from"); cands.add("as");
        cands.add("new"); cands.add("const"); cands.add("true"); cands.add("false");
        cands.add("null"); cands.add("public"); cands.add("private"); cands.add("static");
        cands.add("prop"); cands.add("construct"); cands.add("unset"); cands.add("local");
        cands.add("alias"); cands.add("fixed"); cands.add("live"); cands.add("once");
        cands.add("shared"); cands.add("mut"); cands.add("ref"); cands.add("try");
        cands.add("catch"); cands.add("finally"); cands.add("throw"); cands.add("to");
        cands.add("in"); cands.add("break"); cands.add("continue"); cands.add("switch");
        cands.add("case"); cands.add("typealias");
        cands.add("internal");
        return cands;
    }

    private bool identStartsLower(string word) {
        if (word.length == 0) { return false; }
        char fc = word[0];
        return fc >= 'a' && fc <= 'z';
    }

    // True when a statement-leading lowercase identifier is an unknown
    // keyword: not heading a declaration shape, and not an identifier with
    // known meaning (SYNTAX_EXCEPTIONS.md).
    private bool identShouldFlag(Token cur, int nk) {
        if (!this.identStartsLower(cur.text)) { return false; }
        // Primitive type words that lex as identifiers (e.g. `double`) head
        // declarations, never unknown keywords.
        if (cur.text == "double" || cur.text == "long"
            || cur.text == "uint" || cur.text == "byte"
            || cur.text == "int32" || cur.text == "int64"
            || cur.text == "float64" || cur.text == "string"
            || cur.text == "boolean") { return false; }
        // Any `T ident` (or `T[] ident`, `T? ident`, `<T> ident`)
        // declaration shape is accepted — the declaration type name is
        // validated later (type checker / codegen resolve it against the
        // flattened aggregate), mirroring the rs compiler's decl-shape
        // heuristic.  This covers imported classes the parser has not
        // reached yet and same-file classes declared after use.
        if (nk == 7 && this.pos + 2 < this.tokens.length && this.tokens[this.pos + 2].kind == 100) {
            // `T name (` is a function-signature shape — legacy sources use
            // non-keyword return spellings there; leave it to parseFunction.
            return false;
        }
        if (nk == 7 || nk == 104 || nk == 123 || nk == 120) {
            return false;
        }
        return !this.knownIdentName(cur.text);
    }

    // `print"hello world");` — an identifier immediately followed by a string
    // literal: the open parenthesis of the call is missing and is reported at
    // the string literal's position.
    private Node parseCallMissingOpenParen() {
        Token nameTok = this.advance();
        Token strTok = this.peek();
        string lit = "";
        if (strTok.kind == 3) { lit = strTok.strVal; }
        this.advance();
        if (this.check(101)) { this.advance(); }
        this.recordError("Missing open parenthesis at line " + (string)strTok.line + ", column " + (string)strTok.col);
        this.expectSemi();
        Node call = new Node(); call.kind = 10;
        call.name = nameTok.text;
        Node strNode = new Node(); strNode.kind = 2;
        strNode.strVal = lit;
        strNode.line = strTok.line; strNode.col = strTok.col;
        call.children.add(strNode);
        Node stmt = new Node(); stmt.kind = 61;
        stmt.children.add(call);
        return stmt;
    }

    private bool isDeclaredTypeName(string name) {
        for (int i = 0; i < this.declaredTypes.length; i++) {
            if (this.declaredTypes[i] == name) { return true; }
        }
        return false;
    }

    private bool knownIdentName(string name) {
        for (int i = 0; i < this.knownIdents.length; i++) {
            if (this.knownIdents[i] == name) { return true; }
        }
        if (name == "cargs" || name == "getCommandLine"
            || name == "print" || name == "printline"
            || name == "eprint" || name == "eprintln"
            || name == "debug" || name == "debugline"
            || name == "exit" || name == "input"
            || name == "sleep" || name == "assert"
            || name == "strlen" || name == "now") { return true; }
        return false;
    }

    private void registerDeclaredType(string name) {
        if (!this.isDeclaredTypeName(name)) { this.declaredTypes.add(name); }
    }

    private void recordModExport(string name, bool isInternal) {
        this.modExportNames.add(name);
        if (isInternal) { this.modExportInternal.add(true); } else { this.modExportInternal.add(false); }
    }

    // Can the token kind continue an identifier as a real expression or
    // declaration?  If not, a lowercase statement-leading identifier is an
    // unknown keyword (SYNTAX_EXCEPTIONS.md).
    private bool tokenContinuesExpr(int nk) {
        if (nk == 100 || nk == 108 || nk == 104 || nk == 110) { return true; }
        if (nk == 130 || nk == 131 || nk == 132 || nk == 133 || nk == 157 || nk == 115) { return true; }
        if (nk == 116 || nk == 117 || nk == 118 || nk == 160 || nk == 158 || nk == 159) { return true; }
        if (nk == 161 || nk == 162 || nk == 142 || nk == 143) { return true; }
        if (nk == 123 || nk == 148 || nk == 144 || nk == 147) { return true; }
        if (nk == 109 || nk == 120 || nk == 140) { return true; }
        if (nk == 163 || nk == 169 || nk == 170) { return true; }
        return false;
    }

    // Flag an unknown keyword / keyword typo at the token's position.
    private void flagUnknownKeywordAt(Token t) {
        string sugg = array.findBestMatch(this.keywordCandidates(), t.text);
        if (sugg.length > 0) {
            this.recordError("did you mean \"" + sugg + "\"?, at line " + (string)t.line + ", column " + (string)t.col);
        } else {
            this.recordError("unknown keyword \"" + t.text + "\" at line " + (string)t.line + ", column " + (string)t.col);
        }
    }

    // No-op expression-statement node used during error recovery.
    private Node noopNode() {
        Node n = new Node(); n.kind = 61;
        Node zero = new Node(); zero.kind = 0; zero.intVal = 0;
        n.children.add(zero);
        return n;
    }

    // Skip ahead to the next top-level statement boundary: past a terminating
    // semicolon, or to the first token on a later line — whichever first.
    private void syncToStatementEnd() {
        while (!this.check(0) && !this.check(103)) {
            int line = this.peek().line;
            if (this.check(106)) { this.advance(); return; }
            this.advance();
            if (this.pos < this.tokens.length && this.tokens[this.pos].line > line) { return; }
        }
    }

    // TYPE_EXCEPTIONS.md fundamental value classes that must never mix
    // silently: numbers/chars interoperate; strings and booleans do not.
    private int typeFamily(string t) {
        for (int i = 0; i < t.length; i++) {
            char c = t[i];
            if (c == '[' || c == ']' || c == '?' || c == '<' || c == '>' || c == '.' || c == ',') { return -1; }
        }
        if (t == "int" || t == "int32" || t == "int64"
            || t == "uint" || t == "uint64" || t == "byte" || t == "float"
            || t == "float64" || t == "double" || t == "char") { return 0; }
        if (t == "string") { return 1; }
        if (t == "bool") { return 2; }
        return -1;
    }

    private int literalFamily(Node n) {
        if (n.kind == 0 || n.kind == 1 || n.kind == 3) { return 0; }
        if (n.kind == 2) { return 1; }
        if (n.kind == 4) { return 2; }
        return -1;
    }

    private string literalTypeName(Node n) {
        if (n.kind == 0) { return "int"; }
        if (n.kind == 1) { return "float"; }
        if (n.kind == 2) { return "string"; }
        if (n.kind == 3) { return "char"; }
        if (n.kind == 4) { return "bool"; }
        return "var";
    }

    // `an int`, `a string`, ... for exception message phrasing.
    private string articleOf(string typeName) {
        if (typeName.length == 0) { return "a " + typeName; }
        char fc = typeName[0];
        if (fc == 'a' || fc == 'e' || fc == 'i' || fc == 'o') { return "an " + typeName; }
        return "a " + typeName;
    }

    // Split a comma-joined signature component back into entries.
    private string[] splitSigList(string joined) {
        string[] parts = [];
        string cur = "";
        for (int i = 0; i < joined.length; i++) {
            char c = joined[i];
            if (c == ',') { parts.add(cur); cur = ""; }
            else { cur += (string)c; }
        }
        parts.add(cur);
        return parts;
    }

    // VALUE_EXCEPTION.md — a numeric parse conversion receiving a non-numeric
    // string literal raises a ValueException pointing at the literal.
    private bool stringIsNumber(string s, bool wantInt) {
        string t = "";
        int start = 0;
        int end = s.length;
        while (start < end && s[start] == ' ') { start++; }
        while (end > start && s[end - 1] == ' ') { end--; }
        for (int i = start; i < end; i++) { t += (string)s[i]; }
        int len = t.length;
        if (len == 0) { return false; }
        int i2 = 0;
        if (t[0] == '+' || t[0] == '-') { i2 = 1; }
        if (i2 >= len) { return false; }
        bool sawDigit = false;
        bool sawDot = false;
        bool sawExp = false;
        while (i2 < len) {
            char c = t[i2];
            if (c >= '0' && c <= '9') { sawDigit = true; }
            else if (c == '.' && !wantInt && !sawDot && !sawExp) { sawDot = true; }
            else if ((c == 'e' || c == 'E') && !wantInt && sawDigit && !sawExp) {
                sawExp = true;
                if (i2 + 1 < len && (t[i2 + 1] == '+' || t[i2 + 1] == '-')) { i2++; }
                if (i2 + 1 >= len) { return false; }
            }
            else { return false; }
            i2++;
        }
        return sawDigit;
    }

    // TYPE_EXCEPTIONS.md — chained parameter type mismatches for a plain
    // call whose callee matches a signature parsed in this file.
    private void checkCallArgTypes(Node call) {
        int idx = -1;
        for (int i = 0; i < this.sigNames.length; i++) {
            if (this.sigNames[i] == call.name) { idx = i; break; }
        }
        if (idx < 0) { return; }
        string bestSegs = "";
        int bestCount = 0;
        // Accept the call when any same-named signature fits its arguments.
        for (int m = 0; m < this.sigNames.length; m++) {
            if (this.sigNames[m] != call.name) { continue; }
            string[] types = this.splitSigList(this.sigTypes[m]);
            string[] names = this.splitSigList(this.sigParams[m]);
            int limit = types.length;
            if (call.childCount() < limit) { limit = call.childCount(); }
            if (this.sigVariadic[m] == 1 && limit > types.length - 1) { limit = types.length - 1; }
            string segs = "";
            int count = 0;
            for (int j = 0; j < limit; j++) {
                int pf = this.typeFamily(types[j]);
                if (pf < 0) { continue; }
                Node arg = call.child(j);
                int af = this.literalFamily(arg);
                if (af < 0 || af == pf || (types[j] == "string" && arg.kind == 3)) { continue; }
                if (count > 0) { segs += ", and "; }
                segs += "line " + (string)arg.line + ", column " + (string)arg.col + " for \"" + names[j] + "\" parameter expected " + this.articleOf(types[j]) + " got " + this.articleOf(this.literalTypeName(arg));
                count++;
            }
            if (count == 0) { return; }
            if (count > 0) { bestSegs = segs; bestCount = count; }
        }
        if (bestCount > 0) {
            this.recordError("wrong value type at " + bestSegs);
        }
    }

    // VALUE_EXCEPTION.md — `expected a string of a number at line L,
    // column C, got "hello"` for numeric parse conversions on literals.
    private void checkParseValueException(string recv, string method, Node arg) {
        bool isIntRecv = recv == "int" || recv == "int64";
        bool isDblRecv = recv == "double" || recv == "float";
        if (!isIntRecv && !isDblRecv) { return; }
        bool wantsInt = method == "parseInt" || method == "toInt"
            || method == "parseLong" || method == "toInt64";
        bool wantsDouble = method == "parseDouble" || method == "toDouble"
            || method == "parseFloat";
        if (!wantsInt && !wantsDouble) { return; }
        if (arg.kind != 2) { return; }
        if (this.stringIsNumber(arg.strVal, wantsInt)) { return; }
        this.recordError("expected a string of a number at line " + (string)arg.line + ", column " + (string)arg.col + ", got \"" + arg.strVal + "\"");
    }

    // Static int parse conversions (`int.parseInt(s)`, `int.toInt(s)`,
    // `int64.*`, `long.parseLong(s)`) lower to the plain `int(...)`
    // conversion call (mirrors silverc-rs parse_expr_postfix), so an
    // optional radix rides the same routine as `int(s, base)`.
    private bool isIntParseConv(string recv, string method) {
        if (recv == "int") { return method == "parseInt" || method == "toInt"; }
        if (recv == "int64") { return method == "parseInt" || method == "toInt64"; }
        if (recv == "long") { return method == "parseLong"; }
        return false;
    }

    // `int(s, base)` (DOCS/113) — a string literal parsed in a literal radix
    // is validated per-radix with the same prefix semantics the runtime loop
    // implements (mirrors silverc-rs radix_prefix_ok): trim, an optional
    // leading '-' (first char only), then at least one digit whose value is
    // below the base. A non-literal or out-of-range base defers to the
    // runtime contract (invalid base yields 0). The 1-arg free form keeps its
    // historical behavior (no literal check here).
    private void checkIntCallValueException(Node call) {
        if (call.name != "int") { return; }
        if (call.childCount() != 2) { return; }
        Node arg = call.child(0);
        Node base = call.child(1);
        if (arg.kind != 2) { return; }
        if (base.kind != 0) { return; }
        int b = base.intVal;
        if (b < 2 || b > 36) { return; }
        if (this.radixPrefixOk(arg.strVal, b)) { return; }
        this.recordError("expected a string of a number at line " + (string)arg.line + ", column " + (string)arg.col + ", got \"" + arg.strVal + "\"");
    }

    private bool radixPrefixOk(string s, int base) {
        int start = 0;
        int end = s.length;
        while (start < end && s[start] == ' ') { start++; }
        while (end > start && s[end - 1] == ' ') { end--; }
        if (start < end && s[start] == '-') { start++; }
        if (start >= end) { return false; }
        int v = this.radixDigitVal(s[start]);
        if (v < 0) { return false; }
        return v < base;
    }

    private int radixDigitVal(char c) {
        if (c >= '0' && c <= '9') { return c - '0'; }
        if (c >= 'a' && c <= 'z') { return c - 'a' + 10; }
        if (c >= 'A' && c <= 'Z') { return c - 'A' + 10; }
        return -1;
    }

    // TYPE_EXCEPTIONS.md — a declaration whose initializer's value kind
    // cannot possibly fit (`int x = "hello"`) points at the value and names
    // the declared type and variable.
    private void checkDeclValueType(string declaredType, Node value, string varName) {
        int df = this.typeFamily(declaredType);
        if (df < 0) { return; }
        int vf = this.literalFamily(value);
        if (vf < 0 || vf == df) { return; }
        this.recordError("wrong value type at line " + (string)value.line + ", column " + (string)value.col + ", expected " + this.articleOf(declaredType) + " got " + this.articleOf(this.literalTypeName(value)) + " for " + declaredType + " \"" + varName + "\"");
    }

    // ---- Post-parse call diagnostics (EXCEPTIONS/*.md) ---------------------
    // Runs once after parseProgram so the whole symbol table (functions,
    // methods, types, win32 grants) is visible to every call site.

    // SYNTAX_EXCEPTIONS.md — undefined plain calls emit `unknown method`,
    // with a did-you-mean suggestion when the name resembles a known one.
    // VALUE_EXCEPTION.md — filesystem calls receiving a URL or an unusable
    // path literal where a file path is required.
    public void checkCallDiagnostics(Node[] ast) {
        // DOCS/259 -- top-level variable declarations are the globals an
        // anonymous body may legally reference (its enclosing function's
        // locals may not).
        this.anonKnownGlobals = [];
        for (int g = 0; g < ast.length; g++) {
            if (ast[g].kind == 50) { this.anonKnownGlobals.add(ast[g].name); }
        }
        for (int i = 0; i < ast.length; i++) {
            this.walkCallDiagnostics(ast[i]);
        }
    }

    private void walkCallDiagnostics(Node n) {
        if (n.kind == 50 && n.typeHint == "void ()" && n.name.length > 0) {
            // DOCS/259 G2 -- fn-typed locals are invocable like fn-typed
            // parameters once declared (forward-visible for the rest of the
            // walk, matching the reference compiler's never-popped registry).
            this.fnPtrCallScope.add(n.name);
        }
        if (n.kind == 100) {
            // DOCS/259 -- the enclosing function's fn-typed parameters are
            // invocable as zero-arg calls within its body only. The scope is
            // extended on a copy so the saved array stays untouched.
            string[] savedScope = this.fnPtrCallScope;
            string[] extended = [];
            for (int sc = 0; sc < savedScope.length; sc++) { extended.add(savedScope[sc]); }
            if (n.childCount() > 0) {
                Node fnParams = n.child(0);
                for (int fp = 0; fp < fnParams.childCount(); fp++) {
                    if (fnParams.child(fp).typeHint == "void ()") {
                        extended.add(fnParams.child(fp).name);
                    }
                }
            }
            this.fnPtrCallScope = extended;
            for (int fc = 0; fc < n.childCount(); fc++) {
                this.walkCallDiagnostics(n.child(fc));
            }
            this.fnPtrCallScope = savedScope;
            return;
        }
        if (n.kind == 85) {
            // DOCS/259 -- an anonymous function body is an isolated scope:
            // enclosing fn-typed parameters and locals are not visible, so
            // its identifier uses are validated against its own locals, the
            // file's globals, and the known symbol table. Its calls are
            // walked too (with the isolation still active): a free call
            // inside the body that resolves against no declaration reports
            // the missing function itself.
            string[] savedScope = this.fnPtrCallScope;
            this.fnPtrCallScope = [];
            this.anonWalkDepth++;
            Node anonBody = n.child(0);
            string[] anonLocals = [];
            this.collectAnonBodyLocals(anonBody, anonLocals);
            this.checkAnonBodyIdentifiers(anonBody, anonLocals);
            this.walkCallDiagnostics(anonBody);
            this.anonWalkDepth--;
            this.fnPtrCallScope = savedScope;
            return;
        }
        if ((n.kind == 10 || n.kind == 88) && n.line > 0) {
            // Recovery-built call nodes carry no source position and already
            // reported their own syntax error.
            if (!n.isMember) { this.checkPlainCallTarget(n); }
            this.checkBuiltinPredicateArity(n);
            this.checkFsPathValueException(n);
        }
        // Struct/collect/class bodies are opaque to this pass: their member
        // functions are not symbol-checked (the reference checker walks free
        // functions only; unresolved helpers inside classes stay a codegen-
        // time warning).
        if (n.kind == 101 || n.kind == 102) { return; }
        for (int i = 0; i < n.childCount(); i++) {
            this.walkCallDiagnostics(n.child(i));
        }
    }

    private void checkPlainCallTarget(Node call) {
        string name = call.name;
        if (name.length == 0) { return; }
        // DOCS/259 -- invoking a function-typed parameter of the enclosing
        // function: allowed for zero-arg calls only (the stored address is
        // called, arguments cannot be passed).
        if (this.anonWalkDepth == 0 && call.childCount() == 0 && this.fnPtrCallScopeHas(name)) { return; }
        // Dotted names (dotted-new candidates) are never free functions of
        // this pass — in anonymous bodies too:
        // codegen resolves them through the module namespace or reports
        // `Unknown type '<name>'`, matching the reference compiler for known
        // and unknown modules.
        bool callNameHasDot = false;
        for (int d = 0; d < name.length; d++) {
            if (name[d] == '.') { callNameHasDot = true; break; }
        }
        if (callNameHasDot) { return; }
        if (this.anonWalkDepth > 0) {
            // DOCS/259 -- inside an isolated anonymous body an unresolved
            // call is reported with the reference checker's wording.
            if (this.isKnownCallableName(name)) { return; }
            this.recordError((string)call.line + ":" + (string)call.col + ": Undefined function '" + name + "'");
            return;
        }
        if (this.isKnownCallableName(name)) { return; }
        string sugg = array.findBestMatch(this.callableCandidates(), name);
        if (sugg.length > 0) {
            this.recordError("did you mean \"" + sugg + "\"?, at line " + (string)call.line + ", column " + (string)call.col);
        } else {
            this.recordError("unknown method \"" + name + "\", at line " + (string)call.line + ", column " + (string)call.col);
        }
    }

    // DOCS/259 -- declared names inside an anonymous body (its own locals).
    private void collectAnonBodyLocals(Node n, string[] locals) {
        if (n.kind == 50 && n.name.length > 0) { locals.add(n.name); }
        if (n.kind == 73 && n.name.length > 0) { locals.add(n.name); }
        if (n.kind == 21 && n.childCount() > 0) {
            // Match-arm binding patterns introduce a local in the arm body.
            Node pat = n.child(0);
            if (pat.kind == 6 && pat.name.length > 0 && pat.name != "_") { locals.add(pat.name); }
        }
        for (int i = 0; i < n.childCount(); i++) {
            this.collectAnonBodyLocals(n.child(i), locals);
        }
    }

    // DOCS/259 -- validate identifier uses inside an anonymous body against
    // its own locals and the file-level symbol table. Enclosing locals are
    // deliberately NOT consulted: the body compiles to a standalone function.
    private void checkAnonBodyIdentifiers(Node n, string[] locals) {
        if (n.kind == 74) {
            // Struct literal keys are field names, not identifier uses.
            for (int i = 0; i < n.childCount(); i++) {
                Node pair = n.child(i);
                if (pair.childCount() > 1) { this.checkAnonBodyIdentifiers(pair.child(1), locals); }
            }
            return;
        }
        if (n.kind == 21 && n.childCount() > 0) {
            // Match-arm patterns bind, they do not use.
            for (int i = 1; i < n.childCount(); i++) {
                this.checkAnonBodyIdentifiers(n.child(i), locals);
            }
            return;
        }
        if (n.kind == 6) {
            string name = n.name;
            if (name.length > 0 && name != "this" && name != "null") {
                if (!this.anonIdentResolves(name, locals)) {
                    this.recordError((string)n.line + ":" + (string)n.col + ": Undefined variable '" + name + "'");
                }
            }
        }
        for (int i = 0; i < n.childCount(); i++) {
            this.checkAnonBodyIdentifiers(n.child(i), locals);
        }
    }

    private bool anonIdentResolves(string name, string[] locals) {
        for (int i = 0; i < locals.length; i++) {
            if (locals[i] == name) { return true; }
        }
        for (int g = 0; g < this.anonKnownGlobals.length; g++) {
            if (this.anonKnownGlobals[g] == name) { return true; }
        }
        if (this.knownIdentName(name)) { return true; }
        for (int s = 0; s < this.sigNames.length; s++) {
            if (this.sigNames[s] == name) { return true; }
        }
        if (this.isDeclaredTypeName(name)) { return true; }
        // Module receivers (`time.now()` inside the body): the aggregate's
        // declared modules resolve like silverc-rs's module_names set.
        for (int m = 0; m < this.modExportNames.length; m++) {
            if (this.modExportNames[m] == name) { return true; }
        }
        if (this.win32Resolvable(name)) { return true; }
        if (this.linuxResolvable(name)) { return true; }
        if (this.macResolvable(name)) { return true; }
        if (name.length > 0) {
            bool allCaps = true;
            for (int c = 0; c < name.length; c++) {
                char ch = name[c];
                if (!((ch >= 'A' && ch <= 'Z') || ch == '_')) { allCaps = false; }
            }
            if (allCaps) { return true; }
        }
        return false;
    }

    private bool fnPtrCallScopeHas(string name) {
        for (int i = 0; i < this.fnPtrCallScope.length; i++) {
            if (this.fnPtrCallScope[i] == name) { return true; }
        }
        return false;
    }

    private bool isKnownCallableName(string name) {
        for (int i = 0; i < this.sigNames.length; i++) {
            if (this.sigNames[i] == name) { return true; }
        }
        if (this.isDeclaredTypeName(name)) { return true; }
        if (this.isBuiltinCallableName(name)) { return true; }
        if (this.win32Resolvable(name)) { return true; }
        if (this.linuxResolvable(name)) { return true; }
        if (this.macResolvable(name)) { return true; }
        // ALL-CAPS identifiers stay native-call placeholders.
        if (name.length > 0) {
            bool allCaps = true;
            for (int c = 0; c < name.length; c++) {
                char ch = name[c];
                if (!((ch >= 'A' && ch <= 'Z') || ch == '_')) { allCaps = false; }
            }
            if (allCaps) { return true; }
        }
        if (name.startsWith("__Value_")) { return true; }
        return false;
    }

    private bool win32Resolvable(string name) {
        if (this.win32AllModules) { return true; }
        for (int g = 0; g < this.win32GrantNames.length; g++) {
            if (this.win32GrantNames[g] == name) { return true; }
        }
        for (int m = 0; m < this.win32OpenModules.length; m++) {
            string dll = this.win32ModuleNameDll(this.win32OpenModules[m]);
            if (dll.length > 0 && this.tableHas(this.win32DllExportTable(dll), name)) { return true; }
        }
        return false;
    }

    // Mirror of win32Resolvable for the linux grant trio above: a full
    // `linux` open, an opened `linux.<module>`, or a granted export name
    // (aliases answer to their local name only) resolves a free libc/X11
    // call. Used beside win32Resolvable in the same two call sites.
    private bool linuxResolvable(string name) {
        if (this.linuxAllModules) { return true; }
        for (int g = 0; g < this.linuxGrantNames.length; g++) {
            if (this.linuxGrantNames[g] == name) { return true; }
        }
        for (int m = 0; m < this.linuxOpenModules.length; m++) {
            string lib = this.linuxModuleNameLib(this.linuxOpenModules[m]);
            if (lib.length > 0 && this.tableHas(this.linuxLibExportTable(lib), name)) { return true; }
        }
        return false;
    }

    private string linuxModuleNameLib(string module) {
        if (module == "libc") { return "libc.so.6"; }
        if (module == "x11") { return "libX11.so.6"; }
        if (module == "xtst") { return "libXtst.so.6"; }
        return "";
    }

    private string linuxLibExportTable(string lib) {
        if (lib == "libc.so.6") { return "exit mmap munmap malloc free read write open close lseek stat unlink rename mkdir rmdir opendir readdir closedir getenv setenv clock_gettime nanosleep localtime_r gmtime_r fork execve waitpid kill pipe dup2 _exit execvpe getpid pthread_create pthread_join sysconf uname gethostname getlogin_r statvfs getrandom rand srand getuid printf strlen strcmp strcpy memcpy memset socket connect bind listen accept send recv setsockopt getaddrinfo freeaddrinfo sendto recvfrom"; }
        if (lib == "libX11.so.6") { return "XOpenDisplay XCloseDisplay XQueryPointer XWarpPointer XFlush XCreateSimpleWindow XMapWindow XUnmapWindow XDestroyWindow XStoreName XDefaultRootWindow XScreenCount XDisplayWidth XDisplayHeight XStringToKeysym XKeysymToKeycode XQueryKeymap"; }
        if (lib == "libXtst.so.6") { return "XTestFakeButtonEvent XTestFakeKeyEvent XTestFakeMotionEvent XTestQueryExtension"; }
        return "";
    }

    private bool tableHas(string table, string fn) {
        int i = 0;
        while (i < table.length) {
            while (i < table.length && table[i] == ' ') { i++; }
            int start = i;
            while (i < table.length && table[i] != ' ') { i++; }
            if (i > start && fn == projectSlice(table, start, i)) { return true; }
        }
        return false;
    }

    // Mirror of linuxResolvable for the mac grant trio above: a full `mac`
    // open, an opened `mac.<module>`, or a granted export name (aliases answer
    // to their local name only) resolves a free libSystem/objc call.
    private bool macResolvable(string name) {
        if (this.macAllModules) { return true; }
        for (int g = 0; g < this.macGrantNames.length; g++) {
            if (this.macGrantNames[g] == name) { return true; }
        }
        for (int m = 0; m < this.macOpenModules.length; m++) {
            string lib = this.macModuleNameLib(this.macOpenModules[m]);
            if (lib.length > 0 && this.tableHas(this.macLibExportTable(lib), name)) { return true; }
        }
        return false;
    }

    private string macModuleNameLib(string module) {
        if (module == "libsystem") { return "/usr/lib/libSystem.B.dylib"; }
        if (module == "objc") { return "/usr/lib/libobjc.A.dylib"; }
        if (module == "appkit") { return "/System/Library/Frameworks/AppKit.framework/Versions/C/AppKit"; }
        if (module == "quartz") { return "/System/Library/Frameworks/QuartzCore.framework/Versions/A/QuartzCore"; }
        return "";
    }

    private string macLibExportTable(string lib) {
        if (lib == "/usr/lib/libSystem.B.dylib") { return "exit _exit mmap munmap malloc free read write open close lseek stat fstat unlink rename mkdir rmdir opendir readdir closedir getenv setenv clock_gettime nanosleep localtime_r gmtime_r posix_spawn posix_spawnp posix_spawn_file_actions_init posix_spawn_file_actions_adddup2 posix_spawn_file_actions_destroy waitpid kill pipe dup2 getpid pthread_create pthread_join pthread_mach_thread_np sysconf sysctlbyname uname gethostname getlogin_r statvfs getentropy arc4random_buf dlopen dlsym rand srand getuid printf strlen strcmp strcpy memcpy memset socket connect bind listen accept send recv setsockopt getaddrinfo freeaddrinfo sendto recvfrom"; }
        if (lib == "/usr/lib/libobjc.A.dylib") { return "objc_getClass sel_registerName objc_msgSend"; }
        return "";
    }

    private string win32ModuleNameDll(string module) {
        if (module == "kernel32") { return "kernel32.dll"; }
        if (module == "ws2_32") { return "ws2_32.dll"; }
        if (module == "winhttp") { return "winhttp.dll"; }
        if (module == "wininet") { return "wininet.dll"; }
        if (module == "shell32") { return "shell32.dll"; }
        if (module == "msvcrt") { return "msvcrt.dll"; }
        if (module == "user32") { return "user32.dll"; }
        if (module == "registry" || module == "advapi32") { return "advapi32.dll"; }
        if (module == "version") { return "version.dll"; }
        return "";
    }

    private string win32DllExportTable(string dll) {
        if (dll == "kernel32.dll") { return "CreateFileA ReadFile WriteFile CloseHandle GetFileSize GetFileSizeEx SetFilePointer FlushFileBuffers DeleteFileA MoveFileA CopyFileA GetFileAttributesA SetFileAttributesA CreateDirectoryA RemoveDirectoryA SetCurrentDirectoryA GetCurrentDirectoryA GetFullPathNameA FindFirstFileA FindNextFileA FindClose GetStdHandle SetConsoleTextAttribute GetConsoleScreenBufferInfo SetConsoleCursorPosition GetConsoleMode SetConsoleMode ReadConsoleA WriteConsoleA GetModuleHandleA GetModuleFileNameA LoadLibraryA GetProcAddress Sleep GetTickCount GetTickCount64 GetLastError CreateProcessA CreateProcessW WaitForSingleObject GetExitCodeProcess TerminateProcess OpenProcess GetProcessId CreatePipe GetProcessHeap HeapFree GlobalAlloc GlobalFree VirtualAlloc VirtualFree GetCurrentProcessId GetCurrentProcess GetCurrentThreadId GetCurrentThread GetEnvironmentVariableA GetEnvironmentVariableW SetEnvironmentVariableA SetEnvironmentVariableW ExpandEnvironmentStringsA GetEnvironmentStringsA FreeEnvironmentStringsA GetTempPathA GetComputerNameA GetUserNameA QueryPerformanceCounter QueryPerformanceFrequency GetVersionExA GetSystemDirectoryA GetWindowsDirectoryA GetLocalTime GetSystemTime GetSystemInfo GlobalMemoryStatusEx GetDiskFreeSpaceExA GetUserDefaultUILanguage OutputDebugStringA IsDebuggerPresent GetCommandLineA SetThreadPriority QueryFullProcessImageNameA GetFileAttributesW lstrlenA lstrcpyA lstrcatA lstrcmpA CreateProcess"; }
        if (dll == "ws2_32.dll") { return "WSAStartup WSACleanup socket bind listen accept recv send shutdown closesocket connect select setsockopt ioctlsocket htons inet_addr getaddrinfo freeaddrinfo WSAGetLastError sendto recvfrom"; }
        if (dll == "winhttp.dll") { return "WinHttpOpen WinHttpConnect WinHttpOpenRequest WinHttpSendRequest WinHttpReceiveResponse WinHttpQueryHeaders WinHttpQueryDataAvailable WinHttpReadData WinHttpCloseHandle WinHttpSetOption"; }
        if (dll == "wininet.dll") { return "InternetOpenA InternetConnectA InternetOpenUrlA InternetReadFile InternetReadFileExA InternetCloseHandle HttpSendRequestA HttpSendRequestExA InternetQueryDataAvailable InternetSetOptionA InternetQueryOptionA HttpQueryInfoA InternetWriteFile InternetGetConnectedState InternetCrackUrlA InternetCanonicalizeUrlA InternetSetStatusCallback"; }
        if (dll == "shell32.dll") { return "ShellExecuteA ShellExecuteW ShellExecuteExA ShellExecuteExW"; }
        if (dll == "msvcrt.dll") { return "memcpy memset memmove memcmp strlen strcmp strchr strstr strrchr strcpy strcat strncmp strncat strncpy strtok strpbrk strspn strcspn atoi atol strtol malloc free realloc calloc printf fprintf sprintf sscanf fopen fclose fread fwrite fflush fgets fputs fseek ftell system getenv putenv time rand srand abs labs toupper tolower isalpha isdigit isspace isprint isalnum isxdigit isupper islower"; }
        if (dll == "user32.dll") { return "keybd_event VkKeyScanA GetKeyState GetAsyncKeyState GetKeyboardState SetKeyboardState MapVirtualKeyA SendInput mouse_event GetCursorPos SetCursorPos SetCursor ClipCursor GetClipCursor GetDoubleClickTime SetDoubleClickTime GetForegroundWindow GetWindowTextA GetWindowThreadProcessId RegisterHotKey UnregisterHotKey MessageBeep RegisterRawInputDevices GetRawInputData GetRawInputDeviceList RegisterClassExA CreateWindowExA ShowWindow UpdateWindow SetWindowTextA DestroyWindow GetMessageA TranslateMessage DispatchMessageA DefWindowProcA PostQuitMessage GetSystemMetrics LoadIconA LoadCursorA LoadImageA SendMessageA SetFocus SetForegroundWindow PeekMessageA ScreenToClient GetClientRect GetCursorX GetCursorY MessageBoxA"; }
        if (dll == "advapi32.dll") { return "RegOpenKeyExA RegCreateKeyExA RegQueryValueExA RegSetValueExA RegDeleteValueA RegDeleteKeyA RegEnumKeyExA RegEnumValueA RegQueryInfoKeyA RegCloseKey GetUserNameA"; }
        if (dll == "version.dll") { return "GetFileVersionInfoSizeA GetFileVersionInfoA VerQueryValueA"; }
        return "";
    }

    private bool isBuiltinCallableName(string name) {
        if (name == "print" || name == "printline") { return true; }
        if (name == "eprint" || name == "eprintln") { return true; }
        if (name == "debug" || name == "debugline") { return true; }
        if (name == "exit" || name == "input") { return true; }
        if (name == "sleep" || name == "assert") { return true; }
        if (name == "swap") { return true; }
        if (name == "int" || name == "int64" || name == "int32" || name == "float") { return true; }
        if (name == "double" || name == "char" || name == "uint" || name == "uint64" || name == "float64") { return true; }
        if (name == "byte" || name == "string_cast") { return true; }
        if (name == "bool") { return true; }
        if (name == "now" || name == "cargs") { return true; }
        if (name == "getCommandLine" || name == "super") { return true; }
        if (name == "readFile" || name == "readString") { return true; }
        if (name == "writeBytes" || name == "writeString") { return true; }
        if (name == "writeFile" || name == "strlen") { return true; }
        if (name == "exists" || name == "delete") { return true; }
        if (name == "deleteFile") { return true; }
        if (name == "keybd_event" || name == "mouse_event") { return true; }
        if (name == "VkKeyScanA" || name == "GetKeyState") { return true; }
        if (name == "GetAsyncKeyState" || name == "MapVirtualKeyA") { return true; }
        if (name == "GetCursorPos" || name == "SetCursorPos") { return true; }
        if (name == "SetCursor" || name == "ClipCursor") { return true; }
        if (name == "GetClipCursor" || name == "GetDoubleClickTime") { return true; }
        if (name == "SetDoubleClickTime" || name == "RegisterHotKey") { return true; }
        if (name == "UnregisterHotKey" || name == "MessageBeep") { return true; }
        if (name == "RegisterRawInputDevices" || name == "GetRawInputData") { return true; }
        if (name == "GetRawInputDeviceList" || name == "SendInput") { return true; }
        if (name == "GetForegroundWindow" || name == "GetWindowTextA") { return true; }
        if (name == "GetWindowThreadProcessId" || name == "OpenProcess") { return true; }
        if (name == "QueryFullProcessImageNameA" || name == "CloseHandle") { return true; }
        if (name == "getFocusedProcessDataNative") { return true; }
        // std/os.sr defines `osType()` as plain Silver, but the `os` module
        // is builtin-reserved in the self-hosted compiler, so its source is
        // never collected; the backend provides the native os.type contract
        // (compile-time OSTypes.WINDOWS constant).
        if (name == "osType") { return true; }
        if (name == "__binaryMetadataStatus" || name == "__binaryMetadataField") { return true; }
        if (name == "__binaryMetadataStatusNative" || name == "__binaryMetadataFieldNative") { return true; }
        if (name == "nativeToastShow" || name == "loadIcon") { return true; }
        // DOCS/259 -- file dialog bridges (real comdlg32/shell32 sequences
        // in the backends, dispatched by name like nativeToastShow).
        if (name == "nativeOpenFile" || name == "nativeSaveFile" || name == "nativeFolder") { return true; }
        if (name == "guiSetIcon" || name == "guiCreateWindow") { return true; }
        if (name == "guiShow" || name == "guiHide") { return true; }
        if (name == "guiMaximize" || name == "guiMinimize") { return true; }
        if (name == "guiSetTitle" || name == "guiClose") { return true; }
        if (name == "guiRunLoop") { return true; }
        if (name == "trayAdd" || name == "traySetTooltip") { return true; }
        if (name == "trayDelete" || name == "trayRemove") { return true; }
        if (name == "traySetMenu" || name == "trayRunLoop") { return true; }
        if (name == "trayPollMenu" || name == "trayPollClick") { return true; }
        if (name == "regOpen" || name == "regCreate") { return true; }
        if (name == "regClose" || name == "regSubKey") { return true; }
        if (name == "regGetString" || name == "regSetString") { return true; }
        if (name == "regGetInt" || name == "regSetInt") { return true; }
        if (name == "regGetInt64" || name == "regSetInt64") { return true; }
        if (name == "regDeleteValue" || name == "regDeleteKey") { return true; }
        if (name == "regValueExists") { return true; }
        if (name == "regEnumSubKeyName" || name == "regEnumValueName") { return true; }
        if (name == "regSubKeyCount" || name == "regValueCount") { return true; }
        return false;
    }

    // Did-you-mean candidate pool: every user-defined function plus the
    // builtin free calls.
    private string[] callableCandidates() {
        string[] cands = [];
        for (int i = 0; i < this.sigNames.length; i++) { cands.add(this.sigNames[i]); }
        cands.add("print"); cands.add("printline");
        cands.add("debug"); cands.add("debugline");
        cands.add("exit"); cands.add("input");
        cands.add("sleep"); cands.add("assert");
        cands.add("swap");
        cands.add("int"); cands.add("int64"); cands.add("int32"); cands.add("float");
        cands.add("double"); cands.add("char");
        cands.add("byte"); cands.add("string_cast");
        cands.add("bool");
        cands.add("now"); cands.add("cargs");
        cands.add("getCommandLine");
        cands.add("readFile"); cands.add("readString");
        cands.add("writeBytes"); cands.add("writeString");
        cands.add("writeFile"); cands.add("strlen");
        cands.add("exists"); cands.add("delete");
        cands.add("deleteFile");
        cands.add("toString"); cands.add("toInt");
        cands.add("toUpper"); cands.add("toLower");
        return cands;
    }

    // Filesystem entry points whose first argument must be a file path
    // (VALUE_EXCEPTION.md).
    private bool isPathFirstArgMethod(string m) {
        if (m == "readString" || m == "readFile") { return true; }
        if (m == "readBytes" || m == "writeString") { return true; }
        if (m == "writeFile" || m == "writeBytes") { return true; }
        if (m == "exists" || m == "delete") { return true; }
        if (m == "deleteFile" || m == "rename") { return true; }
        if (m == "copy" || m == "mkdir") { return true; }
        if (m == "createDirectory" || m == "createDir") { return true; }
        if (m == "directoryExists" || m == "folderExists") { return true; }
        if (m == "isFile" || m == "isDirectory") { return true; }
        if (m == "size" || m == "listFiles") { return true; }
        return false;
    }

    // `startsWith(prefix)` / `endsWith(suffix)` take exactly ONE argument —
    // that is the whole signature, in SPEC, in the docs, and in the
    // interpreter. There is no offset overload. The code generators read
    // only the first argument, so an extra one used to be dropped silently
    // and the call answered as if it had never been written — a
    // wrong-but-plausible answer. A user-declared function, method, or
    // trait of the same name is not the built-in and is left alone.
    private void checkBuiltinPredicateArity(Node call) {
        if (!call.isMember) { return; }
        string m = call.name;
        if (m != "startsWith" && m != "endsWith") { return; }
        int argc = call.childCount() - 1;
        if (argc <= 1) { return; }
        for (int i = 0; i < this.sigNames.length; i++) {
            if (this.sigNames[i] == m) { return; }
        }
        this.recordError((string)call.line + ":" + (string)call.col + ": no overload of '" + m + "' takes " + (string)argc + " argument(s)");
    }

    private void checkFsPathValueException(Node call) {
        if (!this.isPathFirstArgMethod(call.name)) { return; }
        if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6) {
            string recv = call.child(0).name;
            if (recv != "fs" && recv != "file" && recv != "folder") { return; }
        }
        int argStart = 0;
        if (call.isMember) { argStart = 1; }
        this.checkPathLiteralArg(call, argStart);
        // rename(src, dst) / copy(src, dst): both arguments are paths.
        if (call.name == "rename" || call.name == "copy") {
            this.checkPathLiteralArg(call, argStart + 1);
        }
    }

    private void checkPathLiteralArg(Node call, int idx) {
        if (idx < 0 || idx >= call.childCount()) { return; }
        Node arg = call.child(idx);
        if (arg.kind != 2) { return; }
        if (this.looksLikeUrl(arg.strVal)) {
            this.recordError("expected a string of a file path at line " + (string)arg.line + ", column " + (string)arg.col + ", got a url");
            return;
        }
        if (path.invalidForWindows(arg.strVal)) {
            this.recordError("expected a valid file path at line " + (string)arg.line + ", column " + (string)arg.col + ", got an invalid path");
        }
    }

    private bool looksLikeUrl(string s) {
        string lo = s.toLower();
        if (lo.startsWith("http://")) { return true; }
        if (lo.startsWith("https://")) { return true; }
        if (lo.startsWith("http:")) { return true; }
        if (lo.startsWith("https:")) { return true; }
        if (lo.startsWith("ftp://")) { return true; }
        if (lo.startsWith("ftps://")) { return true; }
        if (lo.startsWith("file://")) { return true; }
        if (lo.startsWith("www.")) { return true; }
        return false;
    }

    private void pppp() {
        Node n = new Node();
        n.kind = 64;
        this.expect(14);
        this.expect(100);
        Node v = new Node();
        v.kind = 50;
        bool leadVt = this.parseLeadStar();
        string vt = this.advance().text;
        if (this.check(120)) {
            while (!this.check(121) && !this.check(106) && !this.check(103)) {
                vt += this.advance().text;
            }
            if (this.check(121)) { vt += ">"; this.advance(); }
        }
        while (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } vt += "[]"; }
        vt = this.parsePointerSuffix(vt);
        vt = this.applyLeadStar(vt, leadVt);
        if (this.check(123)) { this.advance(); vt += "?"; }
        v.typeHint = vt;
        v.name = this.advance().text;
        n.children.add(v);
        this.expect(54);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlock());
        return n;
    }

    private Token peek() {
        if (this.pos < this.tokens.length) {
            return this.tokens[this.pos];
        }
        return this.tokens[this.tokens.length - 1];
    }

    private Token advance() {
        // Guard against running past the EOF sentinel (e.g. an unterminated
        // paren/brace/bracket at end of file): reading tokens[this.pos] beyond
        // the array would be an out-of-bounds access.
        if (this.pos >= this.tokens.length) {
            Token eof = this.tokens[this.tokens.length - 1];
            printline("Parse error at line " + (string)eof.line + ", column " + (string)eof.col + ": unexpected end of file");
            exit(1);
            return eof;
        }
        Token t = this.tokens[this.pos];
        this.pos++;
        return t;
    }

    private bool check(int kind) {
        Token t = this.peek();
        return t.kind == kind;
    }

    private Token expect(int kind) {
        if (this.check(kind)) {
            return this.advance();
        }
        Token tok = this.peek();
        printline("Parse error at line " + (string)tok.line + ", column " + (string)tok.col + ": expected " + this.kindName(kind) + " but found " + this.tokenText(tok));
        exit(1);
        return this.peek();
    }

    private string kindName(int kind) {
        if (kind == 0) { return "end of file"; }
        if (kind == 1) { return "number"; }
        if (kind == 3) { return "string"; }
        if (kind == 4) { return "character"; }
        if (kind == 5) { return "boolean"; }
        if (kind == 6) { return "null"; }
        if (kind == 7) { return "identifier"; }
        if (kind == 10) { return "if"; }
        if (kind == 11) { return "else"; }
        if (kind == 12) { return "while"; }
        if (kind == 13) { return "for"; }
        if (kind == 14) { return "foreach"; }
        if (kind == 15) { return "return"; }
        if (kind == 16) { return "match"; }
        if (kind == 17) { return "void"; }
        if (kind == 18) { return "int"; }
        if (kind == 19) { return "int32"; }
        if (kind == 20) { return "int64"; }
        if (kind == 21) { return "uint64"; }
        if (kind == 22) { return "float"; }
        if (kind == 23) { return "float64"; }
        if (kind == 25) { return "bool"; }
        if (kind == 26) { return "char"; }
        if (kind == 27) { return "string"; }
        if (kind == 28) { return "var"; }
        if (kind == 29) { return "struct"; }
        if (kind == 30) { return "class"; }
        if (kind == 31) { return "enum"; }
        if (kind == 32) { return "def"; }
        if (kind == 33) { return "found"; }
        if (kind == 34) { return "collect"; }
        if (kind == 35) { return "mod"; }
        if (kind == 36) { return "import"; }
        if (kind == 37) { return "from"; }
        if (kind == 38) { return "as"; }
        if (kind == 39) { return "new"; }
        if (kind == 40) { return "const"; }
        if (kind == 44) { return "public"; }
        if (kind == 45) { return "private"; }
        if (kind == 46) { return "static"; }
        if (kind == 47) { return "prop"; }
        if (kind == 48) { return "construct"; }
        if (kind == 49) { return "unset"; }
        if (kind == 50) { return "mut"; }
        if (kind == 51) { return "ref"; }
        if (kind == 52) { return "try"; }
        if (kind == 53) { return "catch"; }
        if (kind == 54) { return "in"; }
        if (kind == 55) { return "to"; }
        if (kind == 56) { return "elif"; }
        if (kind == 57) { return "break"; }
        if (kind == 58) { return "continue"; }
        if (kind == 59) { return "export"; }
        if (kind == 60) { return "extends"; }
        if (kind == 64) { return "throw"; }
        if (kind == 100) { return "("; }
        if (kind == 101) { return ")"; }
        if (kind == 102) { return "{"; }
        if (kind == 103) { return "}"; }
        if (kind == 104) { return "["; }
        if (kind == 105) { return "]"; }
        if (kind == 106) { return ";"; }
        if (kind == 107) { return ","; }
        if (kind == 108) { return "."; }
        if (kind == 109) { return ":"; }
        if (kind == 110) { return "="; }
        if (kind == 111) { return "+"; }
        if (kind == 112) { return "-"; }
        if (kind == 113) { return "*"; }
        if (kind == 114) { return "/"; }
        if (kind == 115) { return "%"; }
        if (kind == 116) { return "&"; }
        if (kind == 117) { return "|"; }
        if (kind == 118) { return "^"; }
        if (kind == 119) { return "~"; }
        if (kind == 120) { return "<"; }
        if (kind == 121) { return ">"; }
        if (kind == 122) { return "!"; }
        if (kind == 123) { return "?"; }
        if (kind == 125) { return "#"; }
        if (kind == 130) { return "+="; }
        if (kind == 131) { return "-="; }
        if (kind == 132) { return "*="; }
        if (kind == 133) { return "/="; }
        if (kind == 134) { return "=="; }
        if (kind == 135) { return "!="; }
        if (kind == 136) { return "<="; }
        if (kind == 137) { return ">="; }
        if (kind == 138) { return "&&"; }
        if (kind == 139) { return "||"; }
        if (kind == 140) { return "<<"; }
        if (kind == 141) { return ">>"; }
        if (kind == 142) { return "++"; }
        if (kind == 143) { return "--"; }
        if (kind == 144) { return ".."; }
        if (kind == 145) { return "->"; }
        if (kind == 146) { return "=>"; }
        if (kind == 147) { return "..."; }
        if (kind == 148) { return "??"; }
        if (kind == 163) { return "?."; }
        if (kind == 169) { return "?["; }
        if (kind == 170) { return "??="; }
        if (kind == 164) { return "protected"; }
        if (kind == 165) { return "typealias"; }
        if (kind == 167) { return "internal"; }
        if (kind == 149) { return "$"; }
        if (kind == 168) { return "$"; }
        if (kind == 150) { return "local"; }
        if (kind == 151) { return "alias"; }
        if (kind == 152) { return "fixed"; }
        if (kind == 153) { return "live"; }
        if (kind == 154) { return "once"; }
        if (kind == 155) { return "shared"; }
        if (kind == 156) { return "@"; }
        return "token(" + (string)kind + ")";
    }

    private string tokenText(Token t) {
        if (t.kind == 0) { return "end of file"; }
        if (t.kind == 3) { return "\"" + t.text + "\""; }
        if (t.kind == 4) { return "'" + t.text + "'"; }
        return t.text;
    }

    public Node[] parseProgram() {
        Node[] items = [];
        Node mainBody = new Node();
        mainBody.kind = 16;
        bool mainSeen = false;
        while (!this.check(0)) {
            int posBefore = this.pos;
            Node? item = this.parseItem();
            if (item != null) {
                if (item.kind == 100 && item.name == "main") {
                    mainSeen = true;
                }
                if (item.kind == 112) {
                    // Inline module block: hoist its items to top level. An
                    // `internal mod` block marks everything inside it internal.
                    // Each hoisted item belongs to the block's own module, so
                    // qualified calls bind to it exactly like `mod export`
                    // items do (see curModule).
                    for (int mi = 0; mi < item.childCount(); mi++) {
                        Node inner = item.child(mi);
                        if (item.isInternal) { inner.isInternal = true; }
                        inner.srcModule = item.name;
                        if (inner.kind == 100 && inner.name == "main") {
                            mainSeen = true;
                        }
                        if (inner.kind == 61 || inner.kind == 50 || inner.kind == 73 || inner.kind == 16 || inner.kind == 53 || inner.kind == 54 || inner.kind == 55 || inner.kind == 59 || inner.kind == 68) {
                            mainBody.children.add(inner);
                        } else {
                            items.add(inner);
                        }
                    }
                } else if (item.kind == 61 || item.kind == 50 || item.kind == 73 || item.kind == 16 || item.kind == 53 || item.kind == 54 || item.kind == 55 || item.kind == 59 || item.kind == 68) {
                    mainBody.children.add(item);
                } else {
                    item.srcModule = this.curModule;
                    items.add(item);
                }
            }
            if (this.pos == posBefore) {
                break;
            }
        }
        if (mainBody.children.length > 0 && !mainSeen) {
            Node main = new Node();
            main.kind = 100;
            main.name = "main";
            main.typeHint = "void";
            Node params = new Node();
            main.children.add(params);
            main.children.add(mainBody);
            items.add(main);
        }
        if (mainSeen) {
            // Top-level variable declarations become real globals when a main
            // function exists: keep them in the program list so codegen can
            // allocate writable slots and run their initializers before main().
            for (int gi = 0; gi < mainBody.children.length; gi++) {
                if (mainBody.children[gi].kind == 50) {
                    items.add(mainBody.children[gi]);
                }
            }
        }
        // DOCS/274: anonymous classes desugar during expression parsing
        // into hidden top-level classes (see parseAnonClass). Drain them
        // here so they join the program like any named class declaration.
        // The generated names embed a structural hash of each definition
        // plus a per-parse counter, so merged multi-file programs never
        // collide: identical bodies merge harmlessly (same name, same
        // definition), differing bodies always differ by name.
        for (int hi = 0; hi < this.anonClasses.length; hi++) {
            items.add(this.anonClasses[hi]);
        }
        this.anonClasses = [];
        // Flush the merged missing-semicolon message (single line listing
        // every position, joined with "and").
        if (this.missingSemiLines.length > 0) {
            string msg = "you forgot to put a semicolon \";\" in ";
            for (int si = 0; si < this.missingSemiLines.length; si++) {
                if (si > 0) { msg += " and "; }
                msg += "line " + (string)this.missingSemiLines[si] + ", column " + (string)this.missingSemiCols[si];
            }
            this.recordError(msg);
        }
        return items;
    }    private Node? parseItem() {
        // Skip access modifiers preceding a top-level declaration
        // (`public const int X = 1;`, `private void helper() { ... }`),
        // recording `internal` (DOCS/258) for the item about to be parsed.
        bool internalItem = false;
        while (this.check(44) || this.check(45) || this.check(164) || this.check(46) || this.check(167)) {
            if (this.check(167)) { internalItem = true; }
            this.advance();
        }
        if (this.check(35)) {
            this.advance();
            bool sawExport = false;
            if (this.check(59)) { this.advance(); sawExport = true; }
            if (this.check(102)) { return null; }
            string modName = this.advance().text;
            // Dotted module declaration (`mod export mini_cg.windows;`):
            // accept `ident (. ident)*` on the export form only; plain
            // identifiers and inline `mod name {` blocks take zero
            // iterations and behave byte-identically.
            if (sawExport) {
                while (this.check(108)) {
                    this.advance();
                    modName += "." + this.advance().text;
                }
            }
            // The file's own module starts here: every following top-level
            // item belongs to it until the next module declaration. The
            // inline-block arm below saves and restores it, so a nested
            // declaration cannot leak into the enclosing module.
            string outerMod = this.curModule;
            this.curModule = modName;
            if (this.check(102)) {
                // Inline module block `mod name { ... }`: lift the inner items
                // to top level so `name.f()` qualified calls resolve to global
                // functions.  Returns a kind-112 container that parseProgram
                // flattens (mirrors silverc-rs flatten_inline_modules); an
                // `internal` block marks every hoisted item internal.
                this.advance();
                Node modNode = new Node();
                modNode.kind = 112;
                modNode.name = modName;
                modNode.isInternal = internalItem;
                this.recordModExport(modName, internalItem);
                while (!this.check(103) && !this.check(0)) {
                    Node? inner = this.parseItem();
                    if (inner != null) {
                        if (inner.kind == 112) {
                            for (int mi = 0; mi < inner.childCount(); mi++) {
                                if (modNode.isInternal) { inner.child(mi).isInternal = true; }
                                modNode.children.add(inner.child(mi));
                            }
                        } else {
                            if (modNode.isInternal) { inner.isInternal = true; }
                            modNode.children.add(inner);
                        }
                    }
                }
                this.expect(103);
                this.curModule = outerMod;
                return modNode;
            }
            this.expect(106);
            this.recordModExport(modName, internalItem);
            return null;
        }
        if (this.check(36)) { return this.parseImport(); }
        if (this.check(165)) { return this.flagInternal(this.parseTypeAlias(), internalItem); }
        if (this.check(40)) { return this.flagInternal(this.parseConst(), internalItem); }
        if (this.check(32)) { return this.parseDef(); }
        if (this.check(34)) { return this.parseCollect(); }
        if (this.check(29)) { return this.flagInternal(this.parseStruct(), internalItem); }
        if (this.check(30)) { return this.flagInternal(this.parseClass(), internalItem); }
        if (this.check(31)) { return this.parseEnum(); }
        // Unknown keyword at top level (e.g. a typo like `impor`), with a
        // did-you-mean suggestion when it resembles a real keyword.  Recovery
        // resyncs to the next statement boundary so the damaged region does
        // not cascade into unrelated follow-on errors.
        if (this.check(7)) {
            Token curTok = this.peek();
            if (curTok.text != "switch" && curTok.text != "tuple") {
                int nk = -1;
                if (this.pos + 1 < this.tokens.length) { nk = this.tokens[this.pos + 1].kind; }
                bool continuesExpr = this.tokenContinuesExpr(nk);
                if (!continuesExpr && nk == 3) {
                    return this.parseCallMissingOpenParen();
                }
                if (!continuesExpr && this.identShouldFlag(curTok, nk)) {
                    this.advance();
                    this.flagUnknownKeywordAt(curTok);
                    this.syncToStatementEnd();
                    return null;
                }
            }
        }
        // Top-level statements (e.g. `printline(42);`) are legal: a source
        // without a function is compiled as if the statements were the body
        // of an implicit `void main()`.  Functions are recognized by their
        // `Type name (` shape (including array returns like `string[] name (`
        // and optional public/private/static prefixes); anything else is
        // parsed as a statement.
        if (this.pos + 1 < this.tokens.length) {
            int typePos = this.pos;
            Token t0 = this.tokens[this.pos];
            if ((t0.kind == 44 || t0.kind == 45 || t0.kind == 46) && this.pos + 1 < this.tokens.length) {
                typePos = this.pos + 1;
                t0 = this.tokens[typePos];
            }
            bool typeStart = t0.kind == 17 || t0.kind == 18 || t0.kind == 19 || t0.kind == 20 || t0.kind == 21 || t0.kind == 22 || t0.kind == 23 || t0.kind == 25 || t0.kind == 26 || t0.kind == 27 || t0.kind == 28 || t0.kind == 7 || t0.kind == 120 || t0.kind == 150 || t0.kind == 151 || t0.kind == 152 || t0.kind == 153 || t0.kind == 154 || t0.kind == 155;
            if (typeStart) {
                int scan = typePos + 1;
                if (this.tokens[typePos].kind == 120) {
                    // Union/result type `<A | B>` (DOCS/29) starting at the
                    // `<`: skip the whole `<...>` group before looking for
                    // the function name.
                    while (scan < this.tokens.length && this.tokens[scan].kind != 121) { scan++; }
                    scan++;
                } else if (this.tokens[scan].kind == 120) {
                    scan++;
                    while (scan < this.tokens.length && this.tokens[scan].kind != 121) { scan++; }
                    scan++;
                }
                while (scan + 1 < this.tokens.length && this.tokens[scan].kind == 104 && this.tokens[scan + 1].kind == 105) { scan += 2; }
                if (scan < this.tokens.length && this.tokens[scan].kind == 123) { scan++; }
                if (scan + 1 < this.tokens.length && this.tokens[scan].kind == 7 && this.tokens[scan + 1].kind == 100) {
                    return this.flagInternal(this.parseFunction(), internalItem);
                }
                return this.flagInternal(this.parseStmt(), internalItem);
            }
            return this.flagInternal(this.parseStmt(), internalItem);
        }
        return this.flagInternal(this.parseFunction(), internalItem);
    }

    // Attach the recorded `internal` flag to a freshly parsed top-level item
    // (function, class, const, or `internal int x = 2;` global declaration).
    private Node? flagInternal(Node? item, bool internalItem) {
        if (item != null && internalItem) { item.isInternal = true; }
        return item;
    }

    private Node parseImport() {
        Node node = new Node();
        node.kind = 105;
        Token kwTok = this.peek();
        node.line = kwTok.line;
        node.col = kwTok.col;
        this.expect(36);
        if (this.check(113)) {
            this.advance();
            node.isStatic = true;
        } else if (this.check(102)) {
            this.advance();
            Node first = this.parseImportNameNode();
            node.name = first.name;
            node.isAlias = first.isAlias;
            node.strVal = first.strVal;
            while (this.check(107)) {
                this.advance();
                node.children.add(this.parseImportNameNode());
            }
            this.expect(103);
        } else {
            Node first = this.parseImportNameNode();
            node.name = first.name;
            node.isAlias = first.isAlias;
            node.strVal = first.strVal;
            while (this.check(107)) {
                this.advance();
                node.children.add(this.parseImportNameNode());
            }
        }
        if (this.check(37)) {
            this.advance();
            string src = this.advance().text;
            while (this.check(108)) {
                this.advance();
                src += "." + this.advance().text;
            }
            node.typeHint = src;
        }
        // `X as Y` import aliasing. An alias binds a DLL/lib export under a
        // different local call name, which only carries meaning on win32,
        // linux and mac imports (fs.sr's `rename as renameFile` dodges the
        // module's own rename/2); on a Silver-module import it would
        // silently rebind the module's own symbols, so reject it.
        if (this.importHasAlias(node) && !this.importSourceIsWin32(node.typeHint) && !this.importSourceIsLinux(node.typeHint) && !this.importSourceIsMac(node.typeHint)) {
            this.recordError("aliased import names (X as Y) are only allowed on win32/linux/mac imports, at line " + (string)node.line + ", column " + (string)node.col);
        }
        // Remember win32 grants for the post-parse unknown-method walk
        // (DOCS/213): free Win32 calls resolve only through these imports.
        this.recordWin32ImportGrant(node);
        // Remember linux grants beside them (LINUX.md Phase B): free libc
        // calls resolve only through linux imports.
        this.recordLinuxImportGrant(node);
        // Remember mac grants beside them (MAC.md Phase C): free libSystem
        // calls resolve only through mac imports.
        this.recordMacImportGrant(node);
        // DOCS/261 bare custom grants resolve per target OS beside them.
        this.recordCustomBareGrant(node);
        this.expectSemi();
        return node;
    }

    // One name inside an import list: `export` or `export as local`.
    // The alias local rides on the node's strVal with isAlias set, keeping
    // the import node shape unchanged for every other consumer.
    private Node parseImportNameNode() {
        Node nameNode = new Node();
        nameNode.name = this.advance().text;
        if (this.check(38)) {
            this.advance();
            nameNode.isAlias = true;
            nameNode.strVal = this.advance().text;
        }
        return nameNode;
    }

    private bool importHasAlias(Node node) {
        if (node.isAlias) { return true; }
        for (int i = 0; i < node.childCount(); i++) {
            if (node.child(i).isAlias) { return true; }
        }
        return false;
    }

    private bool importSourceIsWin32(string src) {
        if (src == "win32") { return true; }
        if (src.length > 6 && projectSlice(src, 0, 6) == "win32.") { return true; }
        return false;
    }

    private bool importSourceIsLinux(string src) {
        if (src == "linux") { return true; }
        if (src.length > 6 && projectSlice(src, 0, 6) == "linux.") { return true; }
        return false;
    }

    private bool importSourceIsMac(string src) {
        if (src == "mac") { return true; }
        if (src.length > 4 && projectSlice(src, 0, 4) == "mac.") { return true; }
        return false;
    }

    // The name an import grant answers to: the alias local for `X as Y`,
    // the plain name otherwise.
    private string importLocalName(Node nameNode) {
        if (nameNode.isAlias && nameNode.strVal.length > 0) { return nameNode.strVal; }
        return nameNode.name;
    }

    // Mirror of MiniCg.registerWin32Import, kept in the parser so the
    // diagnostics pass can tell granted Win32 exports from unknown methods.
    // DOCS/261: fixed names resolve first (untouched); declared custom names
    // grant single exports only (star rejected); undeclared names report the
    // manifest stanza. `import * from win32;` still grants fixed only.
    private void recordWin32ImportGrant(Node node) {
        string src = node.typeHint;
        if (src == "win32") {
            if (node.isStatic) { this.win32AllModules = true; return; }
            this.checkWin32ModuleName(node.name, node);
            for (int j = 0; j < node.childCount(); j++) {
                this.checkWin32ModuleName(node.child(j).name, node);
            }
            return;
        }
        if (src.length > 6 && projectSlice(src, 0, 6) == "win32.") {
            string module = projectSlice(src, 6, src.length);
            string dll = this.win32ModuleNameDll(module);
            if (dll.length > 0) {
                if (node.isStatic) {
                    this.win32OpenModules.add(module);
                    return;
                }
                this.win32GrantNames.add(this.importLocalName(node));
                for (int j2 = 0; j2 < node.childCount(); j2++) {
                    this.win32GrantNames.add(this.importLocalName(node.child(j2)));
                }
                return;
            }
            if (this.customDeclared(module)) {
                string winf = this.customNative.winFile(module);
                if (winf.length == 0) {
                    this.recordError(nativeUndeclaredMsg(src) + ", at line " + (string)node.line + ", column " + (string)node.col);
                    return;
                }
                if (node.isStatic) {
                    this.recordError(nativeStarMsg(src) + ", at line " + (string)node.line + ", column " + (string)node.col);
                    return;
                }
                this.win32GrantNames.add(this.importLocalName(node));
                for (int j3 = 0; j3 < node.childCount(); j3++) {
                    this.win32GrantNames.add(this.importLocalName(node.child(j3)));
                }
                return;
            }
            this.recordError(nativeUndeclaredMsg(src) + ", at line " + (string)node.line + ", column " + (string)node.col);
        }
    }

    private void checkWin32ModuleName(string modName, Node node) {
        if (modName.length == 0) { return; }
        string dll = this.win32ModuleNameDll(modName);
        if (dll.length > 0) {
            this.win32OpenModules.add(modName);
            return;
        }
        if (this.customDeclared(modName)) {
            this.recordError(nativeStarMsg("win32." + modName) + ", at line " + (string)node.line + ", column " + (string)node.col);
            return;
        }
        this.recordError(nativeUndeclaredMsg("win32." + modName) + ", at line " + (string)node.line + ", column " + (string)node.col);
    }

    private bool customDeclared(string name) {
        if (name.length == 0) { return false; }
        return this.customNative.declared(name);
    }

    private string customEffectiveTarget() {
        if (this.customTargetOs.length > 0) { return this.customTargetOs; }
        return "WINDOWS";
    }

    // Mirror of recordWin32ImportGrant for `linux` / `linux.<module>`
    // imports (LINUX.md Phase B): `import * from linux;` opens every known
    // lib, `import <mod> from linux;` / `import * from linux.<mod>;` open
    // one, and braced names grant single exports (aliases answer to their
    // local name only, same as win32). DOCS/261 custom rules mirror win32.
    private void recordLinuxImportGrant(Node node) {
        string src = node.typeHint;
        if (src == "linux") {
            if (node.isStatic) { this.linuxAllModules = true; return; }
            this.checkLinuxModuleName(node.name, node);
            for (int j = 0; j < node.childCount(); j++) {
                this.checkLinuxModuleName(node.child(j).name, node);
            }
            return;
        }
        if (src.length > 6 && projectSlice(src, 0, 6) == "linux.") {
            string module = projectSlice(src, 6, src.length);
            string lib = this.linuxModuleNameLib(module);
            if (lib.length > 0) {
                if (node.isStatic) {
                    this.linuxOpenModules.add(module);
                    return;
                }
                this.linuxGrantNames.add(this.importLocalName(node));
                for (int j2 = 0; j2 < node.childCount(); j2++) {
                    this.linuxGrantNames.add(this.importLocalName(node.child(j2)));
                }
                return;
            }
            if (this.customDeclared(module)) {
                string linf = this.customNative.linFile(module);
                if (linf.length == 0) {
                    this.recordError(nativeUndeclaredMsg(src) + ", at line " + (string)node.line + ", column " + (string)node.col);
                    return;
                }
                if (node.isStatic) {
                    this.recordError(nativeStarMsg(src) + ", at line " + (string)node.line + ", column " + (string)node.col);
                    return;
                }
                this.linuxGrantNames.add(this.importLocalName(node));
                for (int j3 = 0; j3 < node.childCount(); j3++) {
                    this.linuxGrantNames.add(this.importLocalName(node.child(j3)));
                }
                return;
            }
            this.recordError(nativeUndeclaredMsg(src) + ", at line " + (string)node.line + ", column " + (string)node.col);
        }
    }

    private void checkLinuxModuleName(string modName, Node node) {
        if (modName.length == 0) { return; }
        string lib = this.linuxModuleNameLib(modName);
        if (lib.length > 0) {
            this.linuxOpenModules.add(modName);
            return;
        }
        if (this.customDeclared(modName)) {
            this.recordError(nativeStarMsg("linux." + modName) + ", at line " + (string)node.line + ", column " + (string)node.col);
            return;
        }
        this.recordError(nativeUndeclaredMsg("linux." + modName) + ", at line " + (string)node.line + ", column " + (string)node.col);
    }

    private void recordMacImportGrant(Node node) {
        string src = node.typeHint;
        if (src == "mac") {
            if (node.isStatic) { this.macAllModules = true; return; }
            this.checkMacModuleName(node.name, node);
            for (int j = 0; j < node.childCount(); j++) {
                this.checkMacModuleName(node.child(j).name, node);
            }
            return;
        }
        if (src.length > 4 && projectSlice(src, 0, 4) == "mac.") {
            string module = projectSlice(src, 4, src.length);
            string lib = this.macModuleNameLib(module);
            if (lib.length > 0) {
                if (node.isStatic) {
                    this.macOpenModules.add(module);
                    return;
                }
                this.macGrantNames.add(this.importLocalName(node));
                for (int j2 = 0; j2 < node.childCount(); j2++) {
                    this.macGrantNames.add(this.importLocalName(node.child(j2)));
                }
                return;
            }
            this.recordError(nativeUndeclaredMsg(src) + ", at line " + (string)node.line + ", column " + (string)node.col);
        }
    }

    private void checkMacModuleName(string modName, Node node) {
        if (modName.length == 0) { return; }
        string lib = this.macModuleNameLib(modName);
        if (lib.length > 0) {
            this.macOpenModules.add(modName);
            return;
        }
        this.recordError(nativeUndeclaredMsg("mac." + modName) + ", at line " + (string)node.line + ", column " + (string)node.col);
    }

    // DOCS/261 bare custom grants (`import { f } from m;`,
    // `import * from m;`): declared names resolve per target OS with no `#on`
    // regions. Undeclared bare names are Silver (no grant, no error);
    // declared-but-wrong-side and star-without-list report here so the
    // unknown-method walk never misfires. Single grants need no export list.
    private void recordCustomBareGrant(Node node) {
        string src = node.typeHint;
        if (src.length == 0) { return; }
        if (src == "win32" || src == "linux" || src == "mac") { return; }
        if (src.length > 6 && projectSlice(src, 0, 6) == "win32.") { return; }
        if (src.length > 6 && projectSlice(src, 0, 6) == "linux.") { return; }
        if (src.length > 4 && projectSlice(src, 0, 4) == "mac.") { return; }
        // Precedence: project-local sources, `.qs` bundle modules, and std
        // modules beat custom native names; a colliding fixed name resolves
        // to the fixed module (handled above). Std names never grant here.
        if (projectIsStdModule(src) || projectBuiltin(src)) { return; }
        if (!this.customDeclared(src)) { return; }
        string target = this.customEffectiveTarget();
        string file = this.customNative.fileFor(src, target);
        if (file.length == 0) {
            this.recordError(nativeSideError(this.customNative, src, target) + ", at line " + (string)node.line + ", column " + (string)node.col);
            return;
        }
        bool isLinux = target == "LINUX";
        if (node.isStatic) {
            if (!this.customNative.starAllowed(src, target)) {
                this.recordError(nativeStarMsg(src) + ", at line " + (string)node.line + ", column " + (string)node.col);
                return;
            }
            string exps = this.customNative.exportsFor(src, target);
            int s = 0;
            while (s < exps.length) {
                while (s < exps.length && (exps[s] == ' ' || exps[s] == '\t')) { s++; }
                int e = s;
                while (e < exps.length && exps[e] != ' ' && exps[e] != '\t') { e++; }
                if (e > s) {
                    string nm = "";
                    for (int k = s; k < e; k++) { nm += exps[k]; }
                    if (isLinux) { this.linuxGrantNames.add(nm); }
                    else { this.win32GrantNames.add(nm); }
                }
                s = e;
            }
            return;
        }
        string local0 = this.importLocalName(node);
        if (isLinux) { this.linuxGrantNames.add(local0); }
        else { this.win32GrantNames.add(local0); }
        for (int j = 0; j < node.childCount(); j++) {
            string ln = this.importLocalName(node.child(j));
            if (isLinux) { this.linuxGrantNames.add(ln); }
            else { this.win32GrantNames.add(ln); }
        }
    }

    private Node parseConst() {
        Node node = new Node();
        node.kind = 104;
        this.expect(40);
        // Support both `const int NAME = 3;` and C-style `const NAME = "x";`.
        // If the token after `const` is a primitive type keyword, consume it;
        // otherwise the name comes directly (type is inferred from the
        // initializer).  Identifiers (kind 7) are always treated as the name.
        if (this.check(17) || this.check(18) || this.check(19) || this.check(20) || this.check(21) || this.check(22) || this.check(23) || this.check(25) || this.check(26) || this.check(27) || this.check(28)) {
            node.typeHint = this.advance().text;
        } else {
            node.typeHint = "";
        }
        node.name = this.advance().text;
        this.knownIdents.add(node.name);
        if (this.check(110)) {
            this.advance();
            node.children.add(this.parseExpr(0));
        }
        this.expectSemi();
        return node;
    }

    private Node parseDef() {
        Node node = new Node();
        this.expect(32);
        node.name = this.advance().text;
        this.registerDeclaredType(node.name);
        if (this.check(110)) {
            // `def Name = enum { ... };` is not Silver. Enums are declared
            // as `enum Name { ... }` (DOCS/212). Swallow the legacy body so
            // the user gets this single error instead of a cascade, and
            // fall back to a plain unit so later passes still see the
            // declared type name.
            Token eqTok = this.peek();
            this.recordError((string)eqTok.line + ":" + (string)eqTok.col + ": `def " + node.name + " = enum ...` is not Silver; declare enums as `enum " + node.name + " { ... }` (see DOCS/212)");
            this.advance();
            if (this.check(31)) { this.advance(); }
            if (this.check(102)) { this.skipBalancedBraces(); }
            node.kind = 110;
            this.expectSemi();
        } else {
            node.kind = 110;
            this.expectSemi();
        }
        return node;
    }

    private Node parseCollect() {
        Node node = new Node();
        node.kind = 102;
        this.expect(34);
        node.name = this.advance().text;
        this.expect(110);
        this.expect(100);
        int fieldIndex = 0;
        while (!this.check(101) && !this.check(0)) {
            Node field = new Node();
            field.kind = 50;
            field.typeHint = this.advance().text;
            field.name = (string)fieldIndex;
            node.children.add(field);
            fieldIndex++;
            if (this.check(107)) { this.advance(); }
        }
        this.expect(101);
        this.expectSemi();
        return node;
    }

    private Node parseStruct() {
        Node node = new Node();
        node.kind = 101;
        Token structStart = this.peek();
        node.line = structStart.line;
        node.col = structStart.col;
        this.expect(29);
        node.name = this.advance().text;
        this.registerDeclaredType(node.name);
        this.expect(102);
        // DOCS/275: structs share the class body parser so operator
        // overloads (`public static T operator + (T b)`), `construct`,
        // `prop` and methods parse inside `struct` too. A plain-data
        // struct (no methods) stays a kind-101 struct; any method
        // (including an operator) promotes the definition to a kind-102
        // class with the same name, layout and `this` semantics as a class.
        Node tmp = new Node();
        tmp.kind = 102;
        tmp.name = node.name;
        tmp.line = node.line;
        tmp.col = node.col;
        this.parseClassBodyInto(tmp);
        this.expect(103);
        bool hasMethod = false;
        for (int i = 0; i < tmp.childCount(); i++) {
            if (tmp.child(i).kind == 100) { hasMethod = true; }
        }
        if (!hasMethod) {
            for (int j = 0; j < tmp.childCount(); j++) {
                node.children.add(tmp.child(j));
            }
            return node;
        }
        Node cls = new Node();
        cls.kind = 102;
        cls.name = node.name;
        cls.line = node.line;
        cls.col = node.col;
        cls.parentClass = "";
        for (int k = 0; k < tmp.childCount(); k++) {
            cls.children.add(tmp.child(k));
        }
        return cls;
    }

    private Node parseClass() {
        Node node = new Node();
        node.kind = 102;
        // Same aggregate-line attribution as parseFunction: class methods
        // inherit their class item's file ownership in the object tier.
        Token clsStart = this.peek();
        node.line = clsStart.line;
        node.col = clsStart.col;
        this.expect(30);
        node.name = this.advance().text;
        this.registerDeclaredType(node.name);
        this.parseClassParentsInto(node);
        this.expect(102);
        this.parseClassBodyInto(node);
        this.expect(103);
        return node;
    }

    // Shared parent-list parser for named (`class C : A, B` /
    // `class C extends A, B`, DOCS/207) and anonymous
    // (`new class : A, B` / `new class extends A, B`, DOCS/274) classes.
    private void parseClassParentsInto(Node node) {
        if (this.check(109) || this.check(60)) {
            this.advance();
            // Multiple inheritance (DOCS/207): comma-separated parents for
            // both `:` and `extends`. parentClass keeps the first listed
            // parent; parentClasses holds the full ordered list.
            string firstParent = this.advance().text;
            node.parentClass = firstParent;
            node.parentClasses.add(firstParent);
            while (this.check(107)) {
                this.advance();
                string nextParent = this.advance().text;
                node.parentClasses.add(nextParent);
            }
        }
    }

    // Shared member parser for named and anonymous (DOCS/274) class bodies:
    // visibility sections, inline modifiers, `construct`, `def` methods,
    // props (read only / visible), statics, `*`-private fields, methods and
    // plain fields. Stops before the closing `}` which the caller consumes.
    private void parseClassBodyInto(Node node) {
        bool savedInternal = this.classSectionInternal;
        this.classSectionInternal = false;
        while (!this.check(103) && !this.check(0)) {
            Node member = this.parseClassMember();
            if (member != null) { node.children.add(member); }
        }
        this.classSectionInternal = savedInternal;
    }

    // DOCS/274: `new class { ... }` anonymous class expression. Parses the
    // optional parent list (`extends Base` / `: Base, Other`) and the class
    // body with the shared named-class parsers, mints a hidden top-level
    // class (`__AnonClass_<hash>`), queues it for parseProgram to drain,
    // and returns `new __AnonClass_<hash>()` — so each evaluation creates
    // one fresh instance with its own fields, dispatched through the
    // ordinary named-class layout/method tables.
    private Node parseAnonClass(Token newTok) {
        this.expect(30);
        // Anonymous classes are unnamed: a bare identifier here is a missing
        // `extends`/`:`, never a name. (`implements` also lands here — it
        // lexes as an identifier because Silver has no such keyword:
        // foundations use `extends`/`:` per SPEC section 8 and DOCS/207.)
        if (this.check(7)) {
            Token badTok = this.peek();
            this.recordError((string)badTok.line + ":" + (string)badTok.col + ": Unexpected token 'class name: anonymous classes have no name — write `new class { ... }`, optionally with `extends Parent` / `: Parent` after `class` (Silver has no `implements` keyword; foundations attach with `extends`/`:` — see DOCS/274)'");
            this.advance();
        }
        // `found` declares a foundation (interface) at top level — it is
        // neither a parent nor, inside the body, a field modifier.
        if (this.check(33)) {
            Token foundTok = this.peek();
            this.recordError((string)foundTok.line + ":" + (string)foundTok.col + ": Unexpected token 'found: `found` declares a foundation at top level, it is not an anonymous-class parent — write `new class extends Base { ... }` (see DOCS/274)'");
            this.advance();
        }
        Node hidden = new Node();
        hidden.kind = 102;
        hidden.line = newTok.line;
        hidden.col = newTok.col;
        hidden.srcModule = this.curModule;
        this.parseClassParentsInto(hidden);
        this.expect(102);
        this.parseClassBodyInto(hidden);
        this.expect(103);
        // No constructor arguments: the instance is built with zero args, so
        // field setup belongs in a zero-arg `construct { ... }`.
        if (this.check(100)) {
            Token parenTok = this.peek();
            this.recordError((string)parenTok.line + ":" + (string)parenTok.col + ": Unexpected token '(: anonymous classes take no constructor arguments — initialize fields in `construct { ... }` (see DOCS/274)'");
            this.skipBalancedParens();
        }
        // The desugared instance is built as `new Hidden()` with no
        // arguments, so a `construct` needing arguments could never run.
        for (int mi = 0; mi < hidden.childCount(); mi++) {
            Node m = hidden.child(mi);
            if (m.kind == 100 && m.name == "construct" && m.childCount() > 0) {
                Node cparams = m.child(0);
                int required = 0;
                for (int pi = 0; pi < cparams.childCount(); pi++) {
                    if (cparams.child(pi).childCount() == 0) { required++; }
                }
                if (required > 0) {
                    int errLine = m.line;
                    int errCol = m.col;
                    if (errLine == 0) { errLine = newTok.line; errCol = newTok.col; }
                    this.recordError((string)errLine + ":" + (string)errCol + ": Unexpected token 'construct: anonymous class constructor needs " + (string)required + " argument(s) but `new class { ... }` passes none — give every parameter a default value or write `construct { ... }` (see DOCS/274)'");
                }
            }
        }
        string hiddenName = this.mintAnonClassName(hidden, newTok);
        hidden.name = hiddenName;
        this.registerDeclaredType(hiddenName);
        this.anonClasses.add(hidden);
        Node res = new Node();
        res.kind = 10;
        res.name = hiddenName;
        res.isStatic = true;
        res.line = newTok.line;
        res.col = newTok.col;
        return res;
    }

    // DOCS/274: mint the hidden name for one anonymous class definition.
    // The name embeds an FNV-1a hash over the definition's structural rendering
    // (plus line/col, so every occurrence differs) plus a per-parse counter
    // (so even identical spellings differ). Hash-based naming keeps merged
    // multi-file programs collision-free without threading file identities
    // through the parse entry: identical bodies share a name AND a definition
    // (harmless duplicates), differing bodies always differ by name.
    private string mintAnonClassName(Node hidden, Token newTok) {
        while (true) {
            int curCount = this.anonCounter;
            string render = (string)curCount + "|" + (string)newTok.line + "|" + (string)newTok.col + "|" + this.renderAnonDef(hidden);
            curCount++;
            this.anonCounter = curCount;
            int64 h = this.anonFnv1a(render);
            string hex = this.anonHex16(h);
            string name = "__AnonClass_" + hex;
            if (!this.isDeclaredTypeName(name)) { return name; }
        }
        return "";
    }

    private string renderAnonDef(Node hidden) {
        string r = "";
        r += hidden.parentClass + "|";
        for (int i = 0; i < hidden.parentClasses.length; i++) { r += hidden.parentClasses[i] + ","; }
        r += "|";
        for (int j = 0; j < hidden.childCount(); j++) {
            Node m = hidden.child(j);
            r += (string)m.kind + ":" + m.name + ":" + m.typeHint + "|";
            for (int k = 0; k < m.childCount(); k++) {
                Node c = m.child(k);
                r += "[" + (string)c.kind + ":" + c.name + ":" + c.typeHint + "]";
                for (int l = 0; l < c.childCount(); l++) {
                    Node gc = c.child(l);
                    r += "{" + (string)gc.kind + ":" + gc.name + ":" + gc.typeHint + "}";
                }
                r += ";";
            }
            r += "#";
        }
        return r;
    }

    // FNV-1a 64-bit over the input bytes (zero-deps hashing for DOCS/274
    // hidden-class names, mirrors silverc-rs fnv1a64).
    private int64 anonFnv1a(string s) {
        int64 h = -3750763034362895579;
        for (int i = 0; i < s.length; i++) {
            h = h ^ int64(s[i]);
            h = h * 1099511628211;
        }
        return h;
    }

    private string anonHex16(int64 v) {
        string digits = "0123456789abcdef";
        string r = "";
        for (int idx = 0; idx < 16; idx++) {
            int shift = 60 - idx * 4;
            int64 nib64 = (v >> shift) & 15;
            int nib = (int)nib64;
            r += projectSlice(digits, nib, nib + 1);
        }
        return r;
    }

    private Node? parseEnum() {
        this.expect(31);
        Node node = new Node();
        node.kind = 105;
        node.name = this.advance().text;
        this.registerDeclaredType(node.name);
        this.expect(102);
        int value = 0;
        while (!this.check(103) && !this.check(0)) {
            Node member = new Node();
            member.kind = 106;
            member.name = this.advance().text;
            member.intVal = value;
            node.children.add(member);
            value++;
            if (this.check(107)) { this.advance(); }
        }
        this.expect(103);
        return node;
    }

    private Node? parseClassMember() {
        // `internal:` / `public:` / `private:` section markers (DOCS/258):
        // a bare modifier followed by `:` toggles the default visibility for
        // the rest of the class body instead of declaring a member.
        if (this.check(167) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 109) {
            this.advance();
            this.advance();
            this.classSectionInternal = true;
            return null;
        }
        if ((this.check(44) || this.check(45)) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 109) {
            this.advance();
            this.advance();
            this.classSectionInternal = false;
            return null;
        }
        bool memberInternal = false;
        bool memberExplicitPrivate = false;
        bool memberStatic = false;
        while (this.check(44) || this.check(45) || this.check(164) || this.check(46) || this.check(167)) {
            if (this.check(167)) { memberInternal = true; }
            if (this.check(45)) { memberExplicitPrivate = true; }
            if (this.check(44)) { memberExplicitPrivate = false; }
            if (this.check(46)) { memberStatic = true; }
            this.advance();
        }
        if (this.classSectionInternal) { memberInternal = true; }
        // DOCS/274: `found` declares a foundation at top level — it is never
        // a member starter. Without this guard a stray `found` (e.g.
        // `private found Provider[] providers;`) falls through to a cryptic
        // closing-brace error; name the actual mistake instead. Sits after
        // inline-visibility parsing so prefixed forms (`private found ...`)
        // point here too.
        if (this.check(33)) {
            Token foundTok = this.peek();
            this.recordError((string)foundTok.line + ":" + (string)foundTok.col + ": Unexpected token 'found: `found` declares a foundation at top level, it is not a field modifier — write `private Provider[] providers;` (see DOCS/274)'");
            this.advance();
            return null;
        }
        // `read only` / `visible` contextual modifiers directly before `prop`,
        // in either order (`read only visible prop`, `visible read only prop`).
        // `read`/`only`/`visible` are not keywords (kind 7 identifiers) and stay
        // usable as ordinary names everywhere else.
        bool memberReadOnly = false;
        bool memberVisible = false;
        while (true) {
            if (this.check(7) && this.peek().text == "read"
                && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 7 && this.tokens[this.pos + 1].text == "only"
                && this.pos + 2 < this.tokens.length && (this.tokens[this.pos + 2].kind == 47
                    || (this.tokens[this.pos + 2].kind == 7 && this.tokens[this.pos + 2].text == "visible"
                        && this.pos + 3 < this.tokens.length && this.tokens[this.pos + 3].kind == 47))) {
                this.advance();
                this.advance();
                memberReadOnly = true;
                continue;
            }
            if (this.check(7) && this.peek().text == "visible"
                && this.pos + 1 < this.tokens.length && (this.tokens[this.pos + 1].kind == 47
                    || (this.tokens[this.pos + 1].kind == 7 && this.tokens[this.pos + 1].text == "read"
                        && this.pos + 2 < this.tokens.length && this.tokens[this.pos + 2].kind == 7 && this.tokens[this.pos + 2].text == "only"
                        && this.pos + 3 < this.tokens.length && this.tokens[this.pos + 3].kind == 47))) {
                this.advance();
                memberVisible = true;
                continue;
            }
            break;
        }
        // `def construct(...)` / `def construct { ... }` spells the
        // constructor with an explicit `def` (mirrors silverc-rs).
        if (this.check(32) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 48) {
            this.advance();
        }
        if (this.check(48)) {
            Node ctor = new Node();
            ctor.kind = 100;
            ctor.name = "construct";
            ctor.isInternal = memberInternal;
            Token ctorTok = this.peek();
            ctor.line = ctorTok.line;
            ctor.col = ctorTok.col;
            this.advance();
            // The parameter list is optional: `construct { ... }` is a
            // zero-parameter constructor, `construct(params) { ... }` the
            // full form. A class may also omit `construct` entirely.
            Node params = new Node();
            if (this.check(100)) {
                this.advance();
                while (!this.check(101) && !this.check(0)) {
                    Node param = new Node();
                    bool leadCpt = this.parseLeadStar();
                    string cpt = this.advance().text;
                    if (this.check(120)) {
                        while (!this.check(121) && !this.check(106) && !this.check(103)) {
                            cpt += this.advance().text;
                        }
                        if (this.check(121)) { cpt += ">"; this.advance(); }
                    }
                    while (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } cpt += "[]"; }
                    cpt = this.parsePointerSuffix(cpt);
                    cpt = this.applyLeadStar(cpt, leadCpt);
                    if (this.check(123)) { this.advance(); cpt += "?"; }
                    if (this.check(100)) {
                        // DOCS/259 G1 -- function-typed constructor parameter
                        // suffix: `void () name`. Only the supported `void ()`
                        // shape is accepted (mirrors parseFunction's param path).
                        if (cpt == "void" && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 101) {
                            this.advance();
                            this.advance();
                            cpt = "void ()";
                        } else {
                            Token ftTok = this.peek();
                            this.recordError((string)ftTok.line + ":" + (string)ftTok.col + ": Unexpected token '(: function-typed parameters support only `void () name`; other shapes are not supported yet (see DOCS/259)'");
                            this.skipBalancedParens();
                            cpt = "void ()";
                        }
                    }
                    if (this.check(147)) {
                        this.advance();
                        cpt += "[]";
                        param.isVariadic = true;
                    }
                    param.typeHint = cpt;
                    param.name = this.advance().text;
                    if (this.check(110)) {
                        this.advance();
                        param.children.add(this.parseExpr(0));
                    }
                    params.children.add(param);
                    if (this.check(107)) { this.advance(); }
                }
                this.expect(101);
            }
            ctor.children.add(params);
            // `construct(args) : base(parentArgs) { ... }` chains the parent
            // constructor.  Desugar the `: base(...)` clause into an injected
            // `super(...)` call at the top of the body, reusing the existing
            // super() codegen.
            if (this.check(109)) {
                this.advance();
                if (this.check(7) && this.peek().text == "base") {
                    this.advance();
                    this.expect(100);
                    Node superCall = new Node();
                    superCall.kind = 10;
                    superCall.name = "super";
                    while (!this.check(101) && !this.check(0)) {
                        superCall.children.add(this.parseExpr(0));
                        if (this.check(107)) { this.advance(); }
                    }
                    this.expect(101);
                    Node origBody = this.parseBlock();
                    Node newBody = new Node();
                    newBody.kind = 16;
                    Node superStmt = new Node();
                    superStmt.kind = 61;
                    superStmt.children.add(superCall);
                    newBody.children.add(superStmt);
                    for (int bi = 0; bi < origBody.childCount(); bi++) {
                        newBody.children.add(origBody.child(bi));
                    }
                    ctor.children.add(newBody);
                    return ctor;
                }
            }
            ctor.children.add(this.parseBlock());
            return ctor;
        }
        if (this.check(47)) {
            this.advance();
            Node field = new Node();
            field.kind = 50;
            bool leadProp = this.parseLeadStar();
            string ft = this.advance().text;
            if (this.check(120)) {
                while (!this.check(121) && !this.check(106) && !this.check(103)) {
                    ft += this.advance().text;
                }
                if (this.check(121)) { ft += ">"; this.advance(); }
            }
            if (ft == "void" && this.check(100) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 101) {
                // DOCS/259 G2 -- fn-typed prop: `prop void () cb;` (fn arrays
                // too via the `[]` suffix below).
                this.advance();
                this.advance();
                ft = "void ()";
            }
            while (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } ft += "[]"; }
            ft = this.parsePointerSuffix(ft);
            ft = this.applyLeadStar(ft, leadProp);
            if (this.check(123)) { this.advance(); ft += "?"; }
            field.typeHint = ft;
            field.name = this.advance().text;
            // DOCS/271 `visible prop`: publicly readable, writable only inside
            // the declaring class. Visible implies public; contradictory
            // combinations are compile errors.
            if (memberVisible) {
                if (memberExplicitPrivate) {
                    Token pvTok = this.peek();
                    this.recordError((string)pvTok.line + ":" + (string)pvTok.col + ": visible prop \"" + field.name + "\" cannot be private");
                }
                if (memberInternal) {
                    Token ivTok = this.peek();
                    this.recordError((string)ivTok.line + ":" + (string)ivTok.col + ": visible prop \"" + field.name + "\" cannot be internal");
                }
                if (memberStatic) {
                    Token svTok = this.peek();
                    this.recordError((string)svTok.line + ":" + (string)svTok.col + ": visible prop \"" + field.name + "\" cannot be static");
                }
                if (memberReadOnly) {
                    Token rvTok = this.peek();
                    this.recordError((string)rvTok.line + ":" + (string)rvTok.col + ": visible prop \"" + field.name + "\" cannot be read only");
                }
            }
            field.isInternal = memberInternal;
            field.isReadOnly = memberReadOnly;
            field.isVisible = memberVisible;
            // Read-only props are set exactly once, by the declaration
            // initializer (`=` is kind 110, like default values). Mutable
            // and visible props take no initializer.
            if (memberReadOnly) {
                if (!this.check(110)) {
                    Token roTok = this.peek();
                    this.recordError((string)roTok.line + ":" + (string)roTok.col + ": read-only prop \"" + field.name + "\" must be declared with a value");
                } else {
                    this.advance();
                    field.children.add(this.parseExpr(0));
                }
            } else if (this.check(110)) {
                if (memberVisible) {
                    Token vvTok = this.peek();
                    this.recordError((string)vvTok.line + ":" + (string)vvTok.col + ": visible prop \"" + field.name + "\" takes no initializer");
                    this.advance();
                    field.children.add(this.parseExpr(0));
                } else {
                    Token mutTok = this.peek();
                    this.recordError((string)mutTok.line + ":" + (string)mutTok.col + ": prop \"" + field.name + "\" takes an initializer only as `read only prop`");
                    this.advance();
                    field.children.add(this.parseExpr(0));
                }
            }
            this.expect(106);
            return field;
        }
        // DOCS/275: C#-shaped static operator overloads
        // (`public static Ret operator <op> (Own b) { ... }` with
        // implicit `this` + one explicit param for binary ops,
        // zero params for unary `!`/`-`). Runs before the normal
        // method probe: `operator` lexes as an identifier, so the
        // `Type name (` probe would misread the shape.
        Node? opMethod = this.tryParseOperator(memberStatic, memberInternal, memberExplicitPrivate);
        if (opMethod != null) { return opMethod; }
        if (this.check(28) || this.check(18) || this.check(19) || this.check(20) || this.check(21) || this.check(25) || this.check(27) || this.check(22) || this.check(23) || this.check(26) || this.check(17) || this.check(7) || this.looksLikeLeadDecl()) {
            int savedPos = this.pos;
            // Plain-field leading `*` is DISCARDED (silveri parity: its
            // class-field branch sets `field.typeHint = typ` with no `*`
            // appended, so `internal * string serial` is a normal string
            // field). A method shape below restores savedPos, so `*T name()`
            // still reaches parseFunction with pointer semantics.
            this.parseLeadStar();
            string ft = this.advance().text;
            if (this.check(120)) {
                while (!this.check(121) && !this.check(106) && !this.check(103)) {
                    ft += this.advance().text;
                }
                if (this.check(121)) { ft += ">"; this.advance(); }
            }
            if (ft == "void" && this.check(100) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 101) {
                // DOCS/259 G2 -- bare fn-typed field: `void () cb;` (fn arrays
                // too via the `[]` suffix below). 17 (`void`) was added to the
                // member dispatch so this path is reached at all.
                this.advance();
                this.advance();
                ft = "void ()";
            }
            while (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } ft += "[]"; }
            ft = this.parsePointerSuffix(ft);
            if (this.check(123)) { this.advance(); ft += "?"; }
            if (this.check(7) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 106) {
                Node field = new Node();
                field.kind = 50;
                field.typeHint = ft;
                field.name = this.advance().text;
                field.isInternal = memberInternal;
                this.expect(106);
                return field;
            }
            // Legacy class sources (cd_test_classes.sr) omit the trailing
            // semicolon on fields.  Accept `Type name` followed by another
            // type/field or the closing brace as a field declaration.
            if (this.check(7) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind != 100 && this.tokens[this.pos + 1].kind != 101 && this.tokens[this.pos + 1].kind != 102) {
                Node field = new Node();
                field.kind = 50;
                field.typeHint = ft;
                field.name = this.advance().text;
                field.isInternal = memberInternal;
                if (this.check(106)) { this.advance(); }
                return field;
            }
            this.pos = savedPos;
        }
        Node method = this.parseFunction();
        method.isInternal = memberInternal;
        return method;
    }

    // DOCS/275: `operator` symbol text for overload names and diagnostics.
    private string operatorSymbol(int kind) {
        if (kind == 111) { return "+"; }
        if (kind == 112) { return "-"; }
        if (kind == 113) { return "*"; }
        if (kind == 114) { return "/"; }
        if (kind == 115) { return "%"; }
        if (kind == 134) { return "=="; }
        if (kind == 135) { return "!="; }
        if (kind == 120) { return "<"; }
        if (kind == 136) { return "<="; }
        if (kind == 121) { return ">"; }
        if (kind == 137) { return ">="; }
        if (kind == 122) { return "!"; }
        return "";
    }

    private bool isNonOverloadableOperator(int kind) {
        return kind == 116 || kind == 117 || kind == 118 || kind == 119 || kind == 140 || kind == 141 || kind == 138 || kind == 139 || kind == 110 || kind == 130 || kind == 131 || kind == 132 || kind == 133 || kind == 157 || kind == 158 || kind == 159 || kind == 160 || kind == 161 || kind == 162 || kind == 142 || kind == 143 || kind == 123 || kind == 148;
    }

    // DOCS/275: parse a C#-shaped static operator overload inside a class
    // (or struct-promoted-to-class) body. Returns null when the member is
    // not an operator shape; records a clean error for malformed operator
    // declarations with the bootstrap message.
    private Node? tryParseOperator(bool memberStatic, bool memberInternal, bool memberExplicitPrivate) {
        if (this.check(7) && this.peek().text == "operator") {
            if (this.pos + 1 < this.tokens.length) {
                int nk = this.tokens[this.pos + 1].kind;
                if (this.operatorSymbol(nk) != "") {
                    Token errTok = this.peek();
                    this.recordError((string)errTok.line + ":" + (string)errTok.col + ": Unexpected token 'operator: operator overloads must declare a return type — write `public static Vec2 operator + (Vec2 b) { ... }` (see DOCS/275)'");
                    return null;
                }
            }
        }
        bool canStart = this.check(17) || this.check(18) || this.check(19) || this.check(20) || this.check(21) || this.check(22) || this.check(23) || this.check(25) || this.check(26) || this.check(27) || this.check(28) || this.check(7) || this.check(120) || this.check(113);
        if (!canStart) { return null; }
        int saved = this.pos;
        bool isVoid = false;
        string retType = "";
        if (this.check(17)) {
            this.advance();
            isVoid = true;
        } else {
            Token rtTok = this.peek();
            bool rtOk = rtTok.kind == 18 || rtTok.kind == 19 || rtTok.kind == 20 || rtTok.kind == 21 || rtTok.kind == 22 || rtTok.kind == 23 || rtTok.kind == 25 || rtTok.kind == 26 || rtTok.kind == 27 || rtTok.kind == 28 || rtTok.kind == 7 || rtTok.kind == 120 || rtTok.kind == 113;
            if (!rtOk) { this.pos = saved; return null; }
            bool leadOpRet = this.parseLeadStar();
            retType = this.advance().text;
            if (retType == "<") {
                while (!this.check(121) && !this.check(106) && !this.check(103) && !this.check(0)) {
                    retType += this.advance().text;
                }
                if (this.check(121)) { retType += ">"; this.advance(); }
            } else if (this.check(120)) {
                while (!this.check(121) && !this.check(106) && !this.check(103) && !this.check(0)) {
                    retType += this.advance().text;
                }
                if (this.check(121)) { retType += ">"; this.advance(); }
            }
            while (this.check(104)) {
                this.advance();
                if (this.check(105)) { this.advance(); }
                retType += "[]";
            }
            retType = this.parsePointerSuffix(retType);
            retType = this.applyLeadStar(retType, leadOpRet);
            if (this.check(123)) { this.advance(); retType += "?"; }
        }
        if (!(this.check(7) && this.peek().text == "operator")) { this.pos = saved; return null; }
        int afterOpKind = -1;
        if (this.pos + 1 < this.tokens.length) { afterOpKind = this.tokens[this.pos + 1].kind; }
        if (afterOpKind == 106 || afterOpKind == 100 || afterOpKind == 103 || afterOpKind == 0 || afterOpKind == 7) { this.pos = saved; return null; }
        Token opTok = this.peek();
        int opLine = opTok.line;
        int opCol = opTok.col;
        this.advance();
        int opKind = -1;
        if (this.pos < this.tokens.length) { opKind = this.peek().kind; }
        string sym = this.operatorSymbol(opKind);
        if (sym == "") {
            if (this.isNonOverloadableOperator(opKind)) {
                Token badTok = this.peek();
                this.recordError((string)badTok.line + ":" + (string)badTok.col + ": Unexpected token 'operator: unsupported operator for overloading (supported: + - * / % == != < > <= >= ! and unary -; see DOCS/275)'");
                this.pos = saved;
                return null;
            }
            this.pos = saved;
            return null;
        }
        this.advance();
        if (isVoid) {
            this.recordError((string)opLine + ":" + (string)opCol + ": Unexpected token 'operator: operator overloads must declare a non-void return type (see DOCS/275)'");
            this.pos = saved;
            return null;
        }
        if (!memberStatic) {
            this.recordError((string)opLine + ":" + (string)opCol + ": Unexpected token 'operator: operator overloads must be static — write `public static Ret operator <op> (...)` (see DOCS/275)'");
            this.pos = saved;
            return null;
        }
        if (!this.check(100)) { this.pos = saved; return null; }
        this.advance();
        Node params = new Node();
        while (!this.check(101) && !this.check(0)) {
            if (this.check(107)) { this.advance(); continue; }
            if (!this.tokenStartsParam(this.peek().kind)) { break; }
            Token ptStart = this.peek();
            bool leadOpPt = this.parseLeadStar();
            string pt = this.advance().text;
            if (this.check(120)) {
                while (!this.check(121) && !this.check(106) && !this.check(103) && !this.check(0)) {
                    pt += this.advance().text;
                }
                if (this.check(121)) { pt += ">"; this.advance(); }
            }
            while (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } pt += "[]"; }
            pt = this.parsePointerSuffix(pt);
            pt = this.applyLeadStar(pt, leadOpPt);
            if (this.check(123)) { this.advance(); pt += "?"; }
            if (this.check(100)) {
                Token ftTok = this.peek();
                this.recordError((string)ftTok.line + ":" + (string)ftTok.col + ": Unexpected token 'operator: operator parameters cannot be function-typed (see DOCS/275)'");
                this.pos = saved;
                return null;
            }
            if (this.check(147)) {
                this.advance();
                pt += "[]";
            }
            string pname = "";
            if (this.check(7)) { pname = this.advance().text; } else { break; }
            if (this.check(110)) {
                Token defTok = this.peek();
                this.recordError((string)defTok.line + ":" + (string)defTok.col + ": Unexpected token 'operator: operator parameters take no default values (see DOCS/275)'");
                this.pos = saved;
                return null;
            }
            Node param = new Node();
            param.typeHint = pt;
            param.name = pname;
            param.line = ptStart.line;
            param.col = ptStart.col;
            params.children.add(param);
            if (this.check(107)) { this.advance(); }
        }
        if (!this.check(101)) { this.pos = saved; return null; }
        this.advance();
        int pcount = params.childCount();
        bool arityOk = false;
        if (sym == "!") {
            if (pcount == 0) { arityOk = true; }
        } else if (sym == "-") {
            if (pcount == 0 || pcount == 1) { arityOk = true; }
        } else {
            if (pcount == 1) { arityOk = true; }
        }
        if (!arityOk) {
            string expected = "exactly 1 parameter (binary overloads use implicit `this` + one explicit param)";
            if (sym == "!") { expected = "exactly 0 parameters (unary `!` uses implicit `this` only)"; }
            if (sym == "-") { expected = "0 parameters (unary neg) or 1 parameter (binary sub)"; }
            this.recordError((string)opLine + ":" + (string)opCol + ": Unexpected token 'operator: `operator " + sym + "` takes " + expected + "; got " + (string)pcount + " (see DOCS/275)'");
            this.pos = saved;
            return null;
        }
        Node opNode = new Node();
        opNode.kind = 100;
        opNode.line = opLine;
        opNode.col = opCol;
        opNode.typeHint = retType;
        string opName = "operator" + sym;
        opNode.name = opName;
        opNode.isStatic = true;
        opNode.isInternal = memberInternal;
        if (memberExplicitPrivate) { opNode.isPublic = false; } else { opNode.isPublic = true; }
        this.knownIdents.add(opName);
        opNode.children.add(params);
        string joinTypes = "";
        string joinNames = "";
        for (int spi = 0; spi < params.childCount(); spi++) {
            Node sp = params.child(spi);
            if (spi > 0) { joinTypes += ","; joinNames += ","; }
            joinTypes += sp.typeHint;
            joinNames += sp.name;
        }
        this.sigNames.add(opName);
        this.sigTypes.add(joinTypes);
        this.sigParams.add(joinNames);
        this.sigVariadic.add(0);
        if (this.check(102)) {
            opNode.children.add(this.parseBlock());
        } else if (this.check(140)) {
            this.advance();
            Node oneExpr = this.parseExpr(0);
            this.expect(106);
            opNode.children.add(oneExpr);
        } else {
            Token bodyTok = this.peek();
            this.recordError((string)bodyTok.line + ":" + (string)bodyTok.col + ": Unexpected token 'operator: operator overloads must have a body `{ ... }` (see DOCS/275)'");
            this.pos = saved;
            return null;
        }
        return opNode;
    }

    // Kinds that can begin a parameter's type inside a `( ... )` list.
    private bool tokenStartsParam(int kind) {
        if (kind == 17 || kind == 18 || kind == 19 || kind == 20 || kind == 21 || kind == 22 || kind == 23 || kind == 25 || kind == 26 || kind == 27) { return true; }
        if (kind == 28 || kind == 7 || kind == 120 || kind == 50 || kind == 51 || kind == 113) { return true; }
        if (kind == 150 || kind == 151 || kind == 152 || kind == 153 || kind == 154 || kind == 155) { return true; }
        return false;
    }

    private Node parseFunction() {
        Node node = new Node();
        node.kind = 100;
        // Aggregate line of the item start (the first modifier or return-type
        // token): --cache-object ownership maps top-level items back to their
        // collected file through these lines. Diagnostics never read them.
        Token fnStart = this.peek();
        node.line = fnStart.line;
        node.col = fnStart.col;
        while (this.check(44) || this.check(45) || this.check(46) || this.check(164) || this.check(167)) {
            if (this.check(167)) { node.isInternal = true; }
            this.advance();
        }
        string retType = "";
        bool leadFnRet = this.parseLeadStar();
        retType = this.advance().text;
        if (this.check(120)) {
            while (!this.check(121) && !this.check(106) && !this.check(103)) {
                retType += this.advance().text;
            }
            if (this.check(121)) { retType += ">"; this.advance(); }
        } else if (retType == "<") {
            // Union/result return type `<A | B>` (DOCS/29).
            while (!this.check(121) && !this.check(106) && !this.check(103)) {
                retType += this.advance().text;
            }
            if (this.check(121)) { retType += ">"; this.advance(); }
        }
        while (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } retType += "[]"; }
        retType = this.parsePointerSuffix(retType);
        retType = this.applyLeadStar(retType, leadFnRet);
        if (this.check(123)) { this.advance(); retType += "?"; }
        node.typeHint = retType;
        node.name = this.advance().text;
        this.knownIdents.add(node.name);
        Token openParen = this.expect(100);
        Node params = new Node();
        bool sawParam = false;
        while (!this.check(101) && !this.check(0)) {
            // Consume the separating comma, or report its absence
            // (`int add(int x int y)`).
            if (this.check(107)) {
                this.advance();
            } else if (sawParam) {
                Token prevT = this.tokens[this.pos - 1];
                this.recordError("you forgot a comma \",\" at line " + (string)prevT.line + ", column " + (prevT.col + this.tokenSrcLen(prevT)).toString());
            }
            // A `{` (or any token that cannot start a type) before the closing
            // parenthesis means the `)` itself is missing.
            if (!this.tokenStartsParam(this.peek().kind)) { break; }
            // DOCS/259 -- the C-style `function` keyword does not exist in
            // Silver; report it verbatim where a parameter type is expected.
            if (this.rejectCStyleFunctionParam()) {
                this.skipDamagedFunction();
                this.registerDamagedSignature(node.name);
                return node;
            }
            Node param = new Node();
            bool leadFnPt = this.parseLeadStar();
            string pt = this.advance().text;
            if (this.check(120)) {
                while (!this.check(121) && !this.check(106) && !this.check(103)) {
                    pt += this.advance().text;
                }
                if (this.check(121)) { pt += ">"; this.advance(); }
            }
            while (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } pt += "[]"; }
            pt = this.parsePointerSuffix(pt);
            pt = this.applyLeadStar(pt, leadFnPt);
            if (this.check(123)) { this.advance(); pt += "?"; }
            if (this.check(100)) {
                // DOCS/259 -- function-typed parameter suffix: `void () name`
                // stores an 8-byte function address in the parameter slot.
                // Only the supported `void ()` shape is accepted; any other
                // shape (parameters, non-void return types) is rejected.
                if (pt == "void" && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 101) {
                    this.advance();
                    this.advance();
                    pt = "void ()";
                } else {
                    Token ftTok = this.peek();
                    this.recordError((string)ftTok.line + ":" + (string)ftTok.col + ": Unexpected token '(: function-typed parameters support only `void () name`; other shapes are not supported yet (see DOCS/259)'");
                    this.skipBalancedParens();
                    this.skipDamagedFunction();
                    this.registerDamagedSignature(node.name);
                    return node;
                }
            }
            if (this.check(147)) {
                // Variadic tail `Type ... name`: the callee receives an array
                // of the element type (DOCS/112).
                this.advance();
                pt += "[]";
                param.isVariadic = true;
            }
            param.typeHint = pt;
            Token nameTok = this.advance();
            param.name = nameTok.text;
            // `default` is reserved: an optional parameter carries a real
            // default VALUE (`int level = 6`), never a `default` keyword, and
            // `default` cannot be used as a parameter name.
            if (param.name == "default") {
                this.recordError("reserved word 'default' cannot be used as an identifier at line " + (string)nameTok.line + ", column " + (string)nameTok.col);
            }
            if (this.check(110)) {
                this.advance();
                param.children.add(this.parseExpr(0));
            }
            params.children.add(param);
            sawParam = true;
        }
        if (this.check(101)) {
            this.advance();
        } else {
            // `void main( {` — the closing parenthesis is missing; it is
            // reported just past the opening one.
            this.recordError("Missing close parenthesis at line " + (string)openParen.line + ", column " + (openParen.col + 1).toString());
        }
        node.children.add(params);
        // TYPE_EXCEPTIONS.md — remember this signature for call-arg checks.
        string joinTypes = "";
        string joinNames = "";
        bool variadicTail = false;
        for (int spi = 0; spi < params.childCount(); spi++) {
            Node sp = params.child(spi);
            if (spi > 0) { joinTypes += ","; joinNames += ","; }
            joinTypes += sp.typeHint;
            joinNames += sp.name;
            if (sp.isVariadic) { variadicTail = true; }
        }
        this.sigNames.add(node.name);
        this.sigTypes.add(joinTypes);
        this.sigParams.add(joinNames);
        if (variadicTail) { this.sigVariadic.add(1); } else { this.sigVariadic.add(0); }
        if (this.check(145)) {
            this.advance();
            bool leadArrow = this.parseLeadStar();
            string ret = this.advance().text;
            if (this.check(120)) {
                while (!this.check(121) && !this.check(106) && !this.check(103)) {
                    ret += this.advance().text;
                }
                if (this.check(121)) { ret += ">"; this.advance(); }
            }
            while (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } ret += "[]"; }
            ret = this.parsePointerSuffix(ret);
            ret = this.applyLeadStar(ret, leadArrow);
            if (this.check(123)) { this.advance(); ret += "?"; }
            node.typeHint = ret;
        }
        if (this.check(140)) {
            this.advance();
            node.children.add(this.parseExpr(0));
        } else if (this.check(102)) {
            node.children.add(this.parseBlock());
        } else if (this.check(103) || this.check(0)) {
            // `void main()` followed by `}` on the next line: the opening
            // curly bracket is missing; point just past the signature's
            // end-of-line.
            int sigLine = this.prevEndLine();
            int sigEndCol = this.lineEndCol(sigLine);
            if (sigEndCol < 0) { sigEndCol = this.prevEndCol(); }
            this.recordError("Missing opening curly bracket at line " + (string)sigLine + ", column " + (string)sigEndCol);
            if (this.check(103)) { this.advance(); }
            Node emptyBody = new Node(); emptyBody.kind = 16;
            node.children.add(emptyBody);
        } else {
            node.children.add(this.parseBlock());
        }
        return node;
    }

    private Node parseBlock() {
        Node block = new Node();
        block.kind = 16;
        this.expect(102);
        while (!this.check(103) && !this.check(0)) {
            int stmtStart = this.pos;
            Node one = this.parseStmt();
            if (one.line == 0) {
                one.line = this.tokens[stmtStart].line;
                one.col = this.tokens[stmtStart].col;
            }
            block.children.add(one);
        }
        if (this.check(103)) {
            this.advance();
        } else {
            // Missing `}` at end of file: reported one line after the last
            // line of code inside the block, column 1 (SYNTAX_EXCEPTIONS.md #3
            // bracket position).
            int closeLine = this.prevEndLine() + 1;
            this.recordError("Missing closing curly bracket at line " + (string)closeLine + ", column 1");
        }
        return block;
    }

    // Accepts either a brace block or a single brace-less statement
    // (JS-style `if (x) return 1;` one-liners).
    private Node parseBlockOrStmt() {
        if (this.check(102)) {
            return this.parseBlock();
        }
        return this.parseStmt();
    }

    private Node parseStmt() {
        if (this.check(102)) { return this.parseBlock(); }
        // A stray `;` is an empty statement (also the recovery anchor used
        // after an unknown-keyword error).
        if (this.check(106)) { this.advance(); return this.noopNode(); }
        if (this.check(7) && this.peek().text == "switch") {
            return this.parseSwitch();
        }
        if ((this.check(18) || this.check(19) || this.check(20) || this.check(21) || this.check(22) || this.check(23) || this.check(25) || this.check(26) || this.check(27)) && this.pos + 3 < this.tokens.length && this.tokens[this.pos + 1].kind == 7 && this.tokens[this.pos + 2].kind == 104) {
            return this.parseFixedVarDecl();
        }
        if (this.check(7) && this.peek().text == "tuple" && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 120) {
            int tupleSaved = this.pos;
            this.advance();
            this.advance();
            while (!this.check(121) && !this.check(0)) { this.advance(); }
            this.expect(121);
            if (this.check(7)) {
                this.pos = tupleSaved;
                return this.parseVarDecl();
            }
            this.expect(100);
            Node destr = new Node(); destr.kind = 71;
            while (!this.check(101) && !this.check(0)) {
                destr.children.add(this.makeNameNode(this.advance().text));
                if (this.check(107)) { this.advance(); }
            }
            this.expect(101);
            this.expect(110);
            destr.children.add(this.parseExpr(0));
            this.expectSemi();
            return destr;
        }
        // Unknown-keyword detection (SYNTAX_EXCEPTIONS.md).  A statement that
        // begins with a lowercase identifier not followed by any expression
        // continuation (`(`, `.`, `=`, `[`, ...) is an unknown keyword or a
        // typo of one.  Uppercase-led identifiers stay on the user-defined
        // type-declaration path below.
        if (this.check(7)) {
            Token curTok = this.peek();
            if (curTok.text != "switch" && curTok.text != "tuple") {
                int nk = -1;
                if (this.pos + 1 < this.tokens.length) { nk = this.tokens[this.pos + 1].kind; }
                bool continuesExpr = this.tokenContinuesExpr(nk);
                // `print"hello world");` — a call missing its open parenthesis.
                if (!continuesExpr && nk == 3) {
                    return this.parseCallMissingOpenParen();
                }
                if (!continuesExpr && this.identShouldFlag(curTok, nk)) {
                    this.advance();
                    this.flagUnknownKeywordAt(curTok);
                    return this.noopNode();
                }
            }
        }
        // Leading-star local declaration `*T name ...` (DOCS/50): only a
        // `*` + full-type + identifier shape declares; dereference, index,
        // call and multiply shapes (`*p = v;`, `*p[i];`, `*f(x);`, `*a * b;`)
        // stay expression statements (see looksLikeLeadDecl).
        if (this.looksLikeLeadDecl()) {
            return this.parseVarDecl();
        }
        if (this.check(7) && this.pos + 1 < this.tokens.length) {
            Token next = this.tokens[this.pos + 1];
            if (next.kind == 7) {
                return this.parseVarDecl();
            }
if (next.kind == 104 && this.pos + 2 < this.tokens.length && this.tokens[this.pos + 2].kind == 105) {
                return this.parseVarDecl();
            }
            if (next.kind == 123 && this.pos + 2 < this.tokens.length && this.tokens[this.pos + 2].kind == 7) {
                return this.parseVarDecl();
            }
            if (next.kind == 120) {
                return this.parseVarDecl();
            }
        }
        if (this.check(120)) {
            // Union/result type `<A | B>` (DOCS/29) in declaration position.
            return this.parseVarDecl();
        }
        if (this.check(15)) {
            Node n = new Node(); n.kind = 51;
            this.advance();
            if (!this.check(106)) { n.children.add(this.parseExpr(0)); }
            this.expectSemi();
            return n;
        }
        if (this.check(141)) {
            Node n = new Node(); n.kind = 52;
            this.advance();
            n.children.add(this.parseExpr(0));
            this.expectSemi();
            return n;
        }
        if (this.check(10)) { return this.parseIf(); }
        // A leading `elif` is not Silver; write `else if` (merged into
        // the previous chain) or `if` (standalone). Parsed as `if` so
        // later passes see a valid tree; the driver still fails on this.
        if (this.check(56)) {
            Token leadTok = this.peek();
            this.recordError((string)leadTok.line + ":" + (string)leadTok.col + ": `elif` is not Silver; write `else if` instead");
            return this.parseIf();
        }
        if (this.check(12)) { return this.parseWhile(); }
        if (this.check(13)) { return this.parseFor(); }
        if (this.check(14)) { return this.pppp(); }
        if (this.check(57)) { Node n = new Node(); n.kind = 62; this.advance(); this.expectSemi(); return n; }
        if (this.check(58)) { Node n = new Node(); n.kind = 63; this.advance(); this.expectSemi(); return n; }
        if (this.check(150)) {
            this.advance();
            return this.parseVarDecl();
        }
        if (this.check(152)) {
            this.advance();
            Node n = this.parseTypeNameInit();
            n.isFixed = true;
            return n;
        }
        if (this.check(153)) {
            this.advance();
            Node n = this.parseTypeNameInit();
            n.isLive = true;
            return n;
        }
        if (this.check(154)) {
            this.advance();
            Node n = this.parseTypeNameInit();
            n.isOnce = true;
            return n;
        }
        if (this.check(155)) {
            this.advance();
            Node n = this.parseTypeNameInit();
            n.isShared = true;
            return n;
        }
        if (this.check(151)) {
            this.advance();
            Node n = new Node(); n.kind = 73; n.isAlias = true;
            bool leadAlias = this.parseLeadStar();
            string aliasType = this.advance().text;
            if (this.check(120)) {
                while (!this.check(121) && !this.check(106) && !this.check(103)) {
                    this.advance();
                }
                this.expect(121);
            }
            while (this.check(104)) {
                this.advance();
                this.expect(105);
                aliasType += "[]";
            }
            aliasType = this.parsePointerSuffix(aliasType);
            aliasType = this.applyLeadStar(aliasType, leadAlias);
            if (this.check(123)) { this.advance(); aliasType += "?"; }
            n.typeHint = aliasType;
            n.name = this.advance().text;
            n.children.add(this.makeNameNode(n.name));
            if (this.check(110)) {
                this.advance();
                n.children.add(this.parseExpr(0));
            }
            this.expectSemi();
            return n;
        }
        if (this.check(49)) {
            Node n = new Node(); n.kind = 60;
            this.advance();
            n.name = this.advance().text;
            this.expectSemi();
            return n;
        }
        if (this.check(52)) { return this.parseTryCatch(); }
        if (this.check(64)) { return this.parseThrow(); }
        // A primitive type keyword followed by `.` is a static-method
        // receiver (`int.parseInt(s)`), not a declaration.
        if ((this.check(28) || this.check(18) || this.check(19) || this.check(20) || this.check(21) || this.check(25) || this.check(27) || this.check(22) || this.check(23) || this.check(26)) && !(this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 108)) {
            return this.parseVarDecl();
        }
        if (this.check(17) && this.pos + 2 < this.tokens.length && this.tokens[this.pos + 1].kind == 100 && this.tokens[this.pos + 2].kind == 101) {
            // DOCS/259 G2/G3 -- local fn-typed declaration: `void () cb;` or
            // `void ()[] jobs;` (decl-init forms included).  The value is an
            // 8-byte function address (or an array of them).
            this.advance();
            this.advance();
            this.advance();
            string declType = "void ()";
            while (this.check(104) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 105) {
                this.advance();
                this.advance();
                declType += "[]";
            }
            Node n = new Node(); n.kind = 50;
            n.typeHint = declType;
            n.name = this.advance().text;
            if (this.check(110)) {
                this.advance();
                n.children.add(this.parseExpr(0));
            }
            this.expectSemi();
            return n;
        }
        Node exprStmt = new Node(); exprStmt.kind = 61;
        exprStmt.children.add(this.parseExpr(0));
        // Statement-final semicolon: recorded (merged into one message) when
        // missing, tolerated at end of file.
        this.expectSemi();
        return exprStmt;
    }

    private Node parseFixedVarDecl() {
        Node n = new Node(); n.kind = 50;
        string typeName = this.advance().text;
        n.name = this.advance().text;
        this.expect(104);
        Node sizeExpr = this.parseExpr(0);
        this.expect(105);
        n.typeHint = typeName + "[]";
        Node arr = new Node(); arr.kind = 19; arr.op = 1;
        if (sizeExpr.kind == 0) { arr.intVal = sizeExpr.intVal; }
        n.children.add(arr);
        this.expectSemi();
        return n;
    }

    private Node makeNameNode(string name) {
        Node n = new Node(); n.kind = 6; n.name = name; return n;
    }

    private Node parseVarDecl() {
        string typeName = this.advance().text;
        if (this.check(38)) {
            Node n = new Node(); n.kind = 111;
            n.typeHint = typeName;
            this.advance();
            n.name = this.advance().text;
            this.registerDeclaredType(n.name);
            this.expectSemi();
            return n;
        }
        this.pos--;
        return this.parseTypeNameInit();
    }

    // `typealias Name = T;` — the `typealias` keyword spelling of the type
    // alias declaration (the existing `T as Name;` form parses via
    // parseVarDecl).  Emits the same kind-111 node so codegen treats both
    // spellings identically.
    private Node parseTypeAlias() {
        Node n = new Node(); n.kind = 111;
        this.expect(165);
        n.name = this.advance().text;
        this.expect(110);
        bool leadTAlias = this.parseLeadStar();
        string aliasType = this.advance().text;
        if (this.check(120)) {
            while (!this.check(121) && !this.check(106) && !this.check(103)) {
                aliasType += this.advance().text;
            }
            if (this.check(121)) { aliasType += ">"; this.advance(); }
        }
        while (this.check(104)) {
            this.advance();
            this.expect(105);
            aliasType += "[]";
        }
        aliasType = this.parsePointerSuffix(aliasType);
        aliasType = this.applyLeadStar(aliasType, leadTAlias);
        if (this.check(123)) { this.advance(); aliasType += "?"; }
        n.typeHint = aliasType;
        this.registerDeclaredType(n.name);
        this.expectSemi();
        return n;
    }

    // DOCS/50: pointer type suffix `T*` (at minimum `int32*`, generalized
    // to any `T*`): after the `[]` array suffixes, one trailing `*` makes
    // the type a raw-address pointer (values are 8-byte cells). Mirrors
    // silverc-rs parse_type (arrays, then a single `*`, then `?`). A
    // second `*` is left unconsumed so `int** p` fails loudly downstream
    // instead of silently becoming a pointer.
    private string parsePointerSuffix(string base) {
        if (this.check(113)) { this.advance(); return base + "*"; }
        return base;
    }

    // DOCS/50 leading-star pointer types (`*T` in annotation position):
    // guarded consume of one leading `*` (token 113). Returns true when a
    // star was consumed. A `*` NOT followed by a type-start token is left
    // alone (deref `*p`, multiply, `&&` never reach these sites with a
    // type-start next, and the two statement/member dispatches use the
    // fuller looksLikeLeadDecl lookahead below). A second `*` (`**T`) is
    // a loud error, mirroring how a second trailing `*` fails downstream.
    private bool parseLeadStar() {
        if (!this.check(113)) { return false; }
        if (!this.typeStartsAt(this.pos + 1)) { return false; }
        this.advance();
        if (this.check(113)) {
            Token t = this.peek();
            this.recordError((string)t.line + ":" + (string)t.col + ": pointer type takes only one `*`; write `T*` or `*T` (see DOCS/50)");
            while (this.check(113)) { this.advance(); }
        }
        return true;
    }

    // Fold a consumed leading star into the trailing form, so `*T` and
    // `T*` share exactly one typeHint and all downstream codegen (deref,
    // address printing, ref-param exclusion). `*T*` is a loud error.
    // NOTE: the plain class/struct FIELD path deliberately does NOT call
    // this (it discards the star, matching silveri's class-field branch
    // which sets `field.typeHint = typ` with no `*` appended).
    private string applyLeadStar(string base, bool lead) {
        if (!lead) { return base; }
        if (base.endsWith("*")) {
            Token t = this.peek();
            this.recordError((string)t.line + ":" + (string)t.col + ": pointer type `" + base + "` takes only one `*`; write `T*` or `*T` (see DOCS/50)");
            return base;
        }
        return base + "*";
    }

    // True when tokens[at] can start a type name (mirrors the member
    // dispatch and tokenStartsParam kind sets). Lead-star lookahead only.
    private bool typeStartsAt(int at) {
        if (at < 0 || at >= this.tokens.length) { return false; }
        int k = this.tokens[at].kind;
        if (k == 17 || k == 18 || k == 19 || k == 20 || k == 21 || k == 22 || k == 23 || k == 25 || k == 26 || k == 27) { return true; }
        if (k == 28 || k == 7 || k == 120) { return true; }
        return false;
    }

    // True for `* Type name ...` declaration shapes (locals and members):
    // a leading `*`, one full type (base + `<...>` generics + `[]` pairs +
    // `?`, plus an optional second `*` which still counts as decl-shaped
    // so `*T*` errors as a declaration, not a dereference), then an
    // identifier. Dereference/index/call shapes (`*p = v;`, `*p[i];`,
    // `*f(x);`, `*a * b;`, `*a.b;`) never have an identifier there and
    // stay expression statements.
    private bool looksLikeLeadDecl() {
        if (!this.check(113)) { return false; }
        int at = this.pos + 1;
        if (!this.typeStartsAt(at)) { return false; }
        if (this.tokens[at].kind == 120) {
            at++;
            while (at < this.tokens.length && this.tokens[at].kind != 121 && this.tokens[at].kind != 106 && this.tokens[at].kind != 103) { at++; }
            if (at >= this.tokens.length || this.tokens[at].kind != 121) { return false; }
            at++;
        } else {
            at++;
            if (at < this.tokens.length && this.tokens[at].kind == 120) {
                at++;
                while (at < this.tokens.length && this.tokens[at].kind != 121 && this.tokens[at].kind != 106 && this.tokens[at].kind != 103) { at++; }
                if (at >= this.tokens.length || this.tokens[at].kind != 121) { return false; }
                at++;
            }
        }
        while (at + 1 < this.tokens.length && this.tokens[at].kind == 104 && this.tokens[at + 1].kind == 105) { at += 2; }
        if (at < this.tokens.length && this.tokens[at].kind == 123) { at++; }
        if (at < this.tokens.length && this.tokens[at].kind == 113) { at++; }
        if (at >= this.tokens.length || this.tokens[at].kind != 7) { return false; }
        return true;
    }

    private Node parseTypeNameInit() {
        Node n = new Node(); n.kind = 50;
        bool leadLocal = this.parseLeadStar();
        string typeName = this.advance().text;
        if (this.check(120)) {
            bool isTupleType = typeName == "tuple";
            // Keep the generic arguments in the type hint (e.g.
            // `dict<string,P> d;` records "dict<string,P>", not "dict"):
            // params, props and type aliases already collect them, and
            // codegen's dict value typing (dictValueType) needs them so
            // `d[k].field` resolves the value class. Nested generics
            // (`dict<string, dict<string,int>>`) track bracket depth so
            // only the MATCHING `>` ends the hint. `tuple` keeps its
            // opaque single-word hint.
            int genDepth = 0;
            bool genClosed = false;
            while (!this.check(106) && !this.check(103)) {
                if (this.check(121)) {
                    genDepth--;
                    typeName += this.advance().text;
                    if (genDepth == 0) { genClosed = true; break; }
                    continue;
                }
                if (this.check(141)) {
                    // The lexer fuses `>>` (token 141): nested generics
                    // that close together (`dict<string, dict<string,int>>`)
                    // end on one token closing two levels.
                    genDepth -= 2;
                    typeName += this.advance().text;
                    if (genDepth <= 0) { genClosed = true; break; }
                    continue;
                }
                if (this.check(120)) { genDepth++; }
                typeName += this.advance().text;
            }
            if (!genClosed) {
                if (this.check(121)) { typeName += ">"; this.advance(); }
                else { this.expect(121); }
            }
            if (isTupleType) { typeName = "tuple"; }
        } else if (typeName == "<") {
            // Union/result type `<A | B>` (DOCS/29) or nullable `<T>`: collect
            // the member tokens into the type hint string.
            while (!this.check(121) && !this.check(106) && !this.check(103)) {
                typeName += this.advance().text;
            }
            if (this.check(121)) { typeName += ">"; this.advance(); }
        }
        while (this.check(104)) {
            this.advance();
            this.expect(105);
            typeName += "[]";
        }
        typeName = this.parsePointerSuffix(typeName);
        typeName = this.applyLeadStar(typeName, leadLocal);
        if (this.check(123)) { this.advance(); typeName += "?"; }
        n.typeHint = typeName;
        if (this.check(50)) { this.advance(); n.isMut = true; }
        n.name = this.advance().text;
        if (this.check(107)) {
            // Array destructuring declaration `int a, b = arr;` (DOCS/119):
            // binds successive array elements to fresh typed locals.
            Node destr = new Node(); destr.kind = 79;
            destr.typeHint = typeName;
            destr.children.add(this.makeNameNode(n.name));
            while (this.check(107)) {
                this.advance();
                destr.children.add(this.makeNameNode(this.advance().text));
            }
            this.expect(110);
            destr.children.add(this.parseExpr(0));
            this.expectSemi();
            return destr;
        }
        if (this.check(110)) {
            this.advance();
            n.children.add(this.parseExpr(0));
        } else if (this.check(140)) {
            this.advance();
            Node rhs = this.parseExpr(0);
            Node moveBin = new Node(); moveBin.kind = 7; moveBin.op = 28;
            moveBin.children.add(this.makeNameNode(n.name));
            moveBin.children.add(rhs);
            n.children.add(moveBin);
        }
        // TYPE_EXCEPTIONS.md — flag an initializer literal whose value kind
        // can never fit the declared scalar type (`int x = "hello"`).
        if (n.childCount() > 0) {
            this.checkDeclValueType(typeName, n.child(0), n.name);
        }
        this.expectSemi();
        return n;
    }

    private Node parseIf() {
        Node n = new Node(); n.kind = 53;
        if (this.check(56)) {
            // Reached only after the caller already recorded the `elif`
            // error (statement dispatch, `else` and trailing positions
            // below): swallow the keyword and parse the clause as `if`.
            this.advance();
        } else {
            this.expect(10);
        }
        this.expect(100);
        this.parenDepth++;
        n.children.add(this.parseExpr(0));
        this.parenDepth--;
        this.expect(101);
        n.children.add(this.parseBlockOrStmt());
        if (this.check(11)) {
            this.advance();
            if (this.check(56)) {
                Token chainTok = this.peek();
                this.recordError((string)chainTok.line + ":" + (string)chainTok.col + ": `elif` is not Silver; write `else if` instead");
            }
            if (this.check(10) || this.check(56)) {
                n.children.add(this.parseIf());
            } else {
                n.children.add(this.parseBlockOrStmt());
            }
        } else if (this.check(56)) {
            Token tailTok = this.peek();
            this.recordError((string)tailTok.line + ":" + (string)tailTok.col + ": `elif` is not Silver; write `else if` instead");
            n.children.add(this.parseIf());
        }
        return n;
    }

    private Node parseWhile() {
        Node n = new Node(); n.kind = 54;
        this.expect(12);
        this.expect(100);
        this.parenDepth++;
        n.children.add(this.parseExpr(0));
        this.parenDepth--;
        this.expect(101);
        n.children.add(this.parseBlockOrStmt());
        return n;
    }

    // `switch (subject) { case v { body } ... else { body } }` (DOCS/108).
    // `switch`/`case` lex as identifiers.  Node shape: child(0) = subject,
    // then alternating (case value, case body) children; when the child count
    // is even the final child is the else body.  Codegen tests each case
    // against the subject with no fall-through.
    private Node parseSwitch() {
        Token swTok = this.peek();
        Node n = new Node(); n.kind = 76;
        // Statement span for the guard's diagnostics (enum-exhaustiveness
        // warnings point at the switch itself).
        n.line = swTok.line; n.col = swTok.col;
        this.advance();
        this.expect(100);
        this.parenDepth++;
        n.children.add(this.parseExpr(0));
        this.parenDepth--;
        this.expect(101);
        this.expect(102);
        while (!this.check(103) && !this.check(0)) {
            if (this.check(7) && this.peek().text == "case") {
                this.advance();
                if (this.check(100)) {
                    this.advance();
                    n.children.add(this.parseExpr(0));
                    this.expect(101);
                } else {
                    n.children.add(this.parseExpr(0));
                }
                n.children.add(this.parseBlock());
            } else if (this.check(11) || (this.check(7) && this.peek().text == "default")) {
                this.advance();
                n.children.add(this.parseBlock());
            } else {
                printline("Parse error at line " + (string)this.peek().line + ", column " + (string)this.peek().col + ": expected case or else in switch");
                exit(1);
            }
        }
        this.expect(103);
        return n;
    }

    private Node parseTryCatch() {
        Node n = new Node(); n.kind = 59;
        this.expect(52);
        n.children.add(this.parseBlock());
        if (this.check(53)) {
            this.advance();
            this.expect(100);
            bool leadCatch = this.parseLeadStar();
            string catchType = this.advance().text;
            while (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } catchType += "[]"; }
            catchType = this.parsePointerSuffix(catchType);
            catchType = this.applyLeadStar(catchType, leadCatch);
            if (this.check(123)) { this.advance(); catchType += "?"; }
            n.name = this.advance().text;
            n.typeHint = catchType;
            this.expect(101);
            n.children.add(this.parseBlock());
        } else {
            Node empty = new Node(); empty.kind = 16;
            n.children.add(empty);
        }
        if (this.check(65)) {
            this.advance();
            n.hasFinally = true;
            n.children.add(this.parseBlock());
        }
        return n;
    }

    private Node parseThrow() {
        Node n = new Node(); n.kind = 68;
        this.advance();
        n.children.add(this.parseExpr(0));
        this.expectSemi();
        return n;
    }

    private Node parseFor() {
        Node n = new Node();
        this.expect(13);
        this.expect(100);
        // Range-style for loop: `for (type name as start to end) { body }`.
        // Look ahead for the `type name as` pattern; if present, desugar it
        // into the C-style for node (kind 55) that codegen already handles.
        int savedPos = this.pos;
        bool isRange = false;
        string rangeType = "";
        string rangeVar = "";
        if (this.check(28) || this.check(18) || this.check(19) || this.check(20) || this.check(21) || this.check(7)) {
            rangeType = this.advance().text;
            if (this.check(7)) {
                rangeVar = this.advance().text;
                if (this.check(38)) {
                    isRange = true;
                }
            }
        }
        if (isRange) {
            this.advance();
            Node startExpr = this.parseExpr(0);
            this.expect(55);
            Node endExpr = this.parseExpr(0);
            this.expect(101);
            Node body = this.parseBlockOrStmt();
            n.kind = 55;
            // init: type name = start
            Node init = new Node();
            init.kind = 50;
            init.typeHint = rangeType;
            init.name = rangeVar;
            init.children.add(startExpr);
            n.children.add(init);
            // cond: name < end
            Node cond = new Node();
            cond.kind = 7;
            cond.op = 7;
            Node lhs = new Node();
            lhs.kind = 6;
            lhs.name = rangeVar;
            cond.children.add(lhs);
            cond.children.add(endExpr);
            n.children.add(cond);
            // update: name = name + 1
            Node upd = new Node();
            upd.kind = 7;
            upd.op = 20;
            Node uLhs = new Node();
            uLhs.kind = 6;
            uLhs.name = rangeVar;
            Node add = new Node();
            add.kind = 7;
            add.op = 1;
            Node aLhs = new Node();
            aLhs.kind = 6;
            aLhs.name = rangeVar;
            Node one = new Node();
            one.kind = 0;
            one.intVal = 1;
            add.children.add(aLhs);
            add.children.add(one);
            upd.children.add(uLhs);
            upd.children.add(add);
            n.children.add(upd);
            n.children.add(body);
            return n;
        }
        this.pos = savedPos;
        if (this.check(28) || this.check(18) || this.check(19) || this.check(20) || this.check(21)) {
            n.kind = 55;
            n.children.add(this.parseVarDecl());
        } else {
            n.kind = 55;
            n.children.add(this.parseStmt());
        }
        n.children.add(this.parseExpr(0));
        this.expect(106);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlockOrStmt());
        return n;
    }

    // Array methods that take a predicate/transform lambda argument
    // (DOCS/81-84, 91, 99): map/filter/reduce/forEach/every/some/all/any/find.
    private bool isHofMethod(string name) {
        if (name == "map") { return true; }
        if (name == "filter") { return true; }
        if (name == "reduce") { return true; }
        if (name == "forEach") { return true; }
        if (name == "every") { return true; }
        if (name == "some") { return true; }
        if (name == "all") { return true; }
        if (name == "any") { return true; }
        if (name == "find") { return true; }
        return false;
    }

    // Parse one argument of a higher-order call: either an inline lambda
    // (`x => expr`, `x << expr`, `(a, b) => expr`) or a plain expression.
    // Lambdas are represented as a kind-80 node whose children are the
    // parameter name nodes followed by the body expression.
    private Node parseLambdaArg() {
        // Multi-param form: `(a, b) => body` / `(a, b) << body`.  Backtracks
        // when the parenthesized text is really a plain expression.
        if (this.check(100)) {
            int saved = this.pos;
            Node? pl = this.tryParseParenLambda();
            if (pl != null) {
                return pl;
            }
            this.pos = saved;
        }
        // Single-param form: `x => body` / `x << body`.
        if (this.check(7) && this.pos + 1 < this.tokens.length) {
            int nextKind = this.tokens[this.pos + 1].kind;
            if (nextKind == 146 || nextKind == 140) {
                Node lam = new Node(); lam.kind = 80;
                lam.children.add(this.makeNameNode(this.advance().text));
                this.advance();
                lam.children.add(this.parseExpr(0));
                return lam;
            }
        }
        Node e = this.parseExpr(0);
        // `x << expr` can also arrive here as a shift expression when the
        // single form above did not catch it; per DOCS/81 it binds x in the
        // method's element position.
        if (e.kind == 7 && e.op == 18 && e.childCount() >= 2 && e.child(0).kind == 6) {
            Node lam = new Node(); lam.kind = 80;
            lam.children.add(e.child(0));
            lam.children.add(e.child(1));
            return lam;
        }
        return e;
    }

    private Node? tryParseParenLambda() {
        if (!this.check(100)) { return null; }
        this.advance();
        Node lam = new Node(); lam.kind = 80;
        while (this.check(7)) {
            lam.children.add(this.makeNameNode(this.advance().text));
            if (this.check(107)) { this.advance(); }
            else { break; }
        }
        if (!this.check(101)) { return null; }
        this.advance();
        if (!this.check(146) && !this.check(140)) { return null; }
        this.advance();
        lam.children.add(this.parseExpr(0));
        return lam;
    }

    // The member after `.` / `?.` must name something: an identifier, or a
    // tuple position as an integer literal (`t.0`). A number token ending
    // in a bare trailing dot is the `t.0.toString()` re-lex of a tuple
    // position — the dot is stripped back off. Anything else names the
    // mistake instead of building a member the rest of the pipeline cannot
    // explain.
    private string memberNameAfterDot(Token name, string what) {
        if (name.kind == 7) { return name.text; }
        if (name.kind == 1) {
            bool hasDot = false;
            for (int i = 0; i < name.text.length; i++) {
                if (name.text[i] == '.') { hasDot = true; break; }
            }
            if (!hasDot) { return name.text; }
            if (name.text.length > 1 && name.text[name.text.length - 1] == '.') {
                string r = "";
                for (int j = 0; j < name.text.length - 1; j++) { r += name.text[j]; }
                return r;
            }
        }
        this.recordError((string)name.line + ":" + (string)name.col + ": expected identifier or integer literal after '" + what + "'");
        return "_err";
    }

    private Node parseExpr(int minPrec) {
        Node lhs = this.parsePrefix();
        while (true) {
            if (this.check(100) && lhs.kind == 6) {
                Node call = new Node(); call.kind = 10;
                call.name = lhs.name;
                if (call.name == "string") { call.name = "string_cast"; }
                // The callee's own position: unknown-method diagnostics point
                // at the name, not at the arguments.
                call.line = lhs.line; call.col = lhs.col;
                Token openTok = this.peek();
                this.advance();
                int argc = 0;
                while (!this.check(101) && !this.check(0)) {
                    // Consume the separating comma, or report its absence
                    // (`add (1 2)`).
                    if (this.check(107)) {
                        this.advance();
                    } else if (argc > 0) {
                        Token prevT = this.tokens[this.pos - 1];
                        this.recordError("you forgot a comma \",\" at line " + (string)prevT.line + ", column " + (prevT.col + this.tokenSrcLen(prevT)).toString());
                    }
                    call.children.add(this.parseExpr(0));
                    argc++;
                }
                if (this.check(101)) {
                    this.advance();
                } else {
                    // Missing closing parenthesis: reported just past the
                    // opening one.
                    this.recordError("Missing close parenthesis at line " + (string)openTok.line + ", column " + (openTok.col + 1).toString());
                }
                this.checkCallArgTypes(call);
                // `int(s, base)` (DOCS/113): a string literal in a literal
                // radix is validated per-radix here, at the only site that
                // builds free calls (the post-parse walk skips free
                // type-keyword calls: they carry line 0, like this one when
                // lhs came from a type keyword).
                this.checkIntCallValueException(call);
                lhs = call;
                continue;
            }
            if (this.check(104)) {
                Node idx = new Node(); idx.kind = 24;
                idx.children.add(lhs);
                this.advance();
                // Inside the brackets, `..` is a slice boundary rather than a
                // binary range operator, so the index expression stops there.
                bool oldBoundary = this.rangeIsSliceBoundary;
                this.rangeIsSliceBoundary = true;
                idx.children.add(this.parseExpr(0));
                bool isSlice = this.check(109) || this.check(144);
                // Slice syntax: arr[a:b] (colon) or arr[a..b] (range) -> kind 67.
                if (isSlice) {
                    this.advance();
                    idx.kind = 67;
                    if (this.check(105)) {
                        // Open-ended slice [a:]: the end bound is the base's
                        // length, resolved in genSlice (sentinel intVal -1).
                        Node openEnd = new Node(); openEnd.kind = 0; openEnd.intVal = -1;
                        idx.children.add(openEnd);
                    } else {
                        idx.children.add(this.parseExpr(0));
                    }
                }
                this.rangeIsSliceBoundary = oldBoundary;
                this.expect(105);
                lhs = idx;
                continue;
            }
            if (this.check(100) && lhs.kind == 24) {
                // DOCS/259 G3 -- indirect call through a function-typed value
                // (`jobs[0]()`). The FULL index expression is carried as the
                // callee child so codegen performs the bounds-checked element
                // load; the element holds the function address. Zero-argument
                // calls only.
                Token callOpen = this.peek();
                this.advance();
                if (!this.check(101)) {
                    this.recordError((string)callOpen.line + ":" + (string)callOpen.col + ": Unexpected token '(: function-typed values support only zero-argument calls — the supported type is `void ()` (see DOCS/259)'");
                    this.skipBalancedParens();
                } else {
                    this.advance();
                }
                Node indirect = new Node();
                indirect.kind = 87;
                indirect.line = lhs.line;
                indirect.col = lhs.col;
                indirect.children.add(lhs);
                lhs = indirect;
                continue;
            }
            if (this.check(108)) {
                this.advance();
                Token name = this.advance();
                string memberText = this.memberNameAfterDot(name, ".");
                if (this.check(100)) {
                    Node call = new Node(); call.kind = 10;
                    call.name = memberText;
                    call.isMember = true;
                    // Receiver-side position keeps post-parse diagnostics
                    // (VALUE_EXCEPTION.md path checks) pointed at this call.
                    call.line = lhs.line; call.col = lhs.col;
                    call.children.add(lhs);
                    bool hof = this.isHofMethod(name.text);
                    Token openTok2 = this.peek();
                    this.advance();
                    int mArgc = 0;
                    while (!this.check(101) && !this.check(0)) {
                        if (this.check(107)) {
                            this.advance();
                        } else if (mArgc > 0) {
                            Token prevT2 = this.tokens[this.pos - 1];
                            this.recordError("you forgot a comma \",\" at line " + (string)prevT2.line + ", column " + (prevT2.col + this.tokenSrcLen(prevT2)).toString());
                        }
                        if (hof) {
                            call.children.add(this.parseLambdaArg());
                        } else {
                            call.children.add(this.parseExpr(0));
                        }
                        mArgc++;
                    }
                    if (this.check(101)) {
                        this.advance();
                    } else {
                        // Missing closing parenthesis: reported just past the
                        // opening one.
                        this.recordError("Missing close parenthesis at line " + (string)openTok2.line + ", column " + (openTok2.col + 1).toString());
                    }
                    // VALUE_EXCEPTION.md — numeric parse conversions on a
                    // literal string argument (`int.parseInt("hello")`).
                    // Runs on the member shape before the int desugar below,
                    // so the 1-arg rejection is preserved.
                    if (lhs.kind == 6 && mArgc == 1) {
                        this.checkParseValueException(lhs.name, name.text, call.child(1));
                    }
                    if (lhs.kind == 6 && this.isIntParseConv(lhs.name, name.text)) {
                        // Static int parse conversion: desugar to the plain
                        // `int(...)` call with the same args (the optional
                        // radix rides the free-call routine; literals are
                        // validated per-radix below).
                        Node conv = new Node(); conv.kind = 10;
                        conv.name = "int";
                        conv.line = call.line; conv.col = call.col;
                        for (int ca = 1; ca < call.childCount(); ca++) { conv.children.add(call.child(ca)); }
                        this.checkIntCallValueException(conv);
                        lhs = conv;
                    } else {
                        // Fast path (STANDARDS.md 10): `[lit, ...].contains(x)`
                        // (and the `includes` alias) desugars exactly like
                        // `x in [lit, ...]` — an `||` chain of `==` under the
                        // same guards. A literal receiver heap-allocates on
                        // every evaluation before the scan loop runs; the
                        // chain compares directly with no allocation. Dict and
                        // string receivers never match (not kind 19) and keep
                        // their own lowering.
                        if ((name.text == "contains" || name.text == "includes") && mArgc == 1) {
                            Node? fastCall = this.desugarLiteralMembership(call.child(1), lhs, false);
                            if (fastCall != null) { lhs = fastCall ?? lhs; continue; }
                        }
                        lhs = call;
                    }
                } else {
                    Node member = new Node(); member.kind = 13;
                    member.name = memberText;
                    member.children.add(lhs);
                    lhs = member;
                }
                continue;
            }
            if (this.check(163)) {
                // Nullable-conditional member access `a?.b`: evaluate the
                // receiver once; when it is null the whole expression yields
                // null instead of dereferencing.  Wrapped in a kind-75 node
                // so codegen can short-circuit the member access/call.
                // Left-associative at `.` precedence: the loop re-applies,
                // so `a?.b?.c` nests as `((a?.b)?.c)` with each receiver
                // spilled once (see DOCS/273).
                this.advance();
                Token name = this.advance();
                string qMemberText = this.memberNameAfterDot(name, "?.");
                Node qmMember = null;
                if (this.check(100)) {
                    Node call = new Node(); call.kind = 10;
                    call.name = qMemberText;
                    call.isMember = true;
                    call.line = lhs.line; call.col = lhs.col;
                    call.children.add(lhs);
                    bool hof = this.isHofMethod(name.text);
                    this.advance();
                    while (!this.check(101) && !this.check(0)) {
                        if (hof) {
                            call.children.add(this.parseLambdaArg());
                        } else {
                            call.children.add(this.parseExpr(0));
                        }
                        if (this.check(107)) { this.advance(); }
                    }
                    this.expect(101);
                    qmMember = call;
                } else {
                    Node member = new Node(); member.kind = 13;
                    member.name = qMemberText;
                    member.children.add(lhs);
                    qmMember = member;
                }
                Node qm = new Node(); qm.kind = 75;
                qm.line = lhs.line; qm.col = lhs.col;
                qm.children.add(qmMember);
                lhs = qm;
                continue;
            }
            if (this.check(169)) {
                // DOCS/273 null-safe indexing `users?[i]`: element index
                // only, chainable with `?.`/`?[]` at `.` precedence. A null
                // receiver yields null without evaluating the index; a live
                // receiver runs the normal bounds-checked index. `?..`
                // slicing is rejected.
                this.advance();
                bool oldBoundary = this.rangeIsSliceBoundary;
                this.rangeIsSliceBoundary = true;
                Node safeIdx = this.parseExpr(0);
                bool isSlice = this.check(109) || this.check(144);
                if (isSlice) {
                    Token sliceTok = this.peek();
                    this.recordError((string)sliceTok.line + ":" + (string)sliceTok.col + ": ?[: null-safe slicing is not supported — write users?[i] for elements (see DOCS/273)");
                    this.advance();
                    if (!this.check(105)) {
                        this.parseExpr(0);
                    }
                }
                this.rangeIsSliceBoundary = oldBoundary;
                this.expect(105);
                Node idxNode = new Node(); idxNode.kind = 24;
                idxNode.children.add(lhs);
                idxNode.children.add(safeIdx);
                idxNode.line = lhs.line; idxNode.col = lhs.col;
                Node qmIdx = new Node(); qmIdx.kind = 75;
                qmIdx.line = lhs.line; qmIdx.col = lhs.col;
                qmIdx.children.add(idxNode);
                lhs = qmIdx;
                continue;
            }
            if (this.check(142)) {
                this.advance();
                Node one = new Node(); one.kind = 0; one.intVal = 1;
                Node inc = new Node(); inc.kind = 7; inc.op = 35;
                inc.children.add(lhs);
                inc.children.add(one);
                lhs = inc;
                continue;
            }
            if (this.check(143)) {
                this.advance();
                Node one = new Node(); one.kind = 0; one.intVal = 1;
                Node dec = new Node(); dec.kind = 7; dec.op = 36;
                dec.children.add(lhs);
                dec.children.add(one);
                lhs = dec;
                continue;
            }
            if (this.check(148) && minPrec <= 1) {
                this.advance();
                Node coalesce = new Node(); coalesce.kind = 7; coalesce.op = 25;
                coalesce.children.add(lhs);
                coalesce.children.add(this.parseExpr(2));
                lhs = coalesce;
                continue;
            }
            if (this.check(170) && minPrec <= 1) {
                // DOCS/273 assign-if-null `cache ??= rhs`: assigns (and
                // evaluates RHS) only when LHS is null, yields the resulting
                // value. Right-associative at `=` precedence. A safe access
                // is never a target (`a?.b ??= c` is Invalid assignment).
                Token coalTok = this.peek();
                if (lhs.kind == 75) {
                    this.recordError((string)coalTok.line + ":" + (string)coalTok.col + ": Invalid assignment target");
                }
                this.advance();
                Node coalRhs = this.parseExpr(1);
                Node coalAssign = new Node(); coalAssign.kind = 7; coalAssign.op = 38;
                coalAssign.line = coalTok.line; coalAssign.col = coalTok.col;
                coalAssign.children.add(lhs);
                coalAssign.children.add(coalRhs);
                lhs = coalAssign;
                continue;
            }
            if (this.check(123) && minPrec <= 1) {
                this.advance();
                Node thenExpr = this.parseExpr(0);
                this.expect(109);
                Node elseExpr = this.parseExpr(0);
                Node tern = new Node(); tern.kind = 65;
                tern.children.add(lhs);
                tern.children.add(thenExpr);
                tern.children.add(elseExpr);
                lhs = tern;
                continue;
            }
            if (this.check(144) && this.rangeIsSliceBoundary) {
                // `..` inside a `[...]` index starts a slice, so it is not an
                // infix operator there; stop and let the index handler see it.
                break;
            }
            if (this.check(38) && this.isAsCastAhead()) {
                // DOCS/259 G4 -- `expr as Type`: a no-op cast for class
                // instances. Binds between the comparison operators (prec 5)
                // and the bitwise operators (prec 6+) — same relative strength
                // the Rust compiler gives it — and chains left-associatively.
                // `as` NOT followed by a type-like token is left alone (the
                // generic path then ends the expression, so statement-position
                // `T as Alias;` type aliases still parse through parseVarDecl
                // before any expression work).
                int castLine = this.peek().line;
                int castCol = this.peek().col;
                this.advance();
                string target = this.parseAsCastTarget();
                if (this.isPrimitiveTypeSpelling(target) || (lhs.kind >= 0 && lhs.kind <= 4)) {
                    this.recordError((string)castLine + ":" + (string)castCol + ": Unexpected token 'as: as cast only supports class instances (see DOCS/259); got 'expression as " + target + "''");
                }
                Node cast = new Node();
                cast.kind = 86;
                cast.name = target;
                cast.line = castLine;
                cast.col = castCol;
                cast.children.add(lhs);
                lhs = cast;
                continue;
            }
            // DOCS/261 / SPEC 15.6: membership operators `in` and `not in`.
            // `not in` is a two-token sequence [Identifier "not"][In].
            // The loop-header parsers (foreach, for-in) consume the `in`
            // keyword themselves before any expression parse begins.
            if (this.check(7) && this.peek().text == "not"
                && this.pos + 1 < this.tokens.length
                && this.tokens[this.pos + 1].kind == 54
                && !this.inMembershipOperand) {
                int notLine = this.peek().line;
                int notCol = this.peek().col;
                this.advance(); // not
                this.advance(); // in
                if (this.parenDepth == 0) {
                    this.recordError("not in must be wrapped in parentheses: use (a not in b) at line " + (string)notLine + ", column " + (string)notCol);
                }
                int savedInMem = this.inMembershipOperand;
                this.inMembershipOperand = true;
                Node rhs = this.parseExpr(6);
                this.inMembershipOperand = savedInMem;
                Node? fastNot = this.desugarLiteralMembership(lhs, rhs, true);
                if (fastNot != null) { lhs = fastNot ?? lhs; continue; }
                Node? fastRangeNot = this.desugarRangeMembership(lhs, rhs, true);
                if (fastRangeNot != null) { lhs = fastRangeNot ?? lhs; continue; }
                Node bin = new Node(); bin.kind = 7; bin.op = 37;
                bin.boolVal = true;
                bin.line = notLine;
                bin.col = notCol;
                bin.children.add(lhs);
                bin.children.add(rhs);
                lhs = bin;
                continue;
            }
            if (this.check(54) && !this.inMembershipOperand) {
                int inLine = this.peek().line;
                int inCol = this.peek().col;
                this.advance(); // in
                int savedInMem = this.inMembershipOperand;
                this.inMembershipOperand = true;
                Node rhs = this.parseExpr(6);
                this.inMembershipOperand = savedInMem;
                Node? fast = this.desugarLiteralMembership(lhs, rhs, false);
                if (fast != null) { lhs = fast ?? lhs; continue; }
                Node? fastRange = this.desugarRangeMembership(lhs, rhs, false);
                if (fastRange != null) { lhs = fastRange ?? lhs; continue; }
                Node bin = new Node(); bin.kind = 7; bin.op = 37;
                bin.boolVal = false;
                bin.line = inLine;
                bin.col = inCol;
                bin.children.add(lhs);
                bin.children.add(rhs);
                lhs = bin;
                continue;
            }
            // DOCS/275: `is null` / `is not null` (comparison tier, prec 5).
            if (minPrec <= 5 && this.check(7) && this.peek().text == "is") {
                Node? isRes = this.parseIs(lhs);
                if (isRes != null) { lhs = isRes ?? lhs; continue; }
                break;
            }
            int prec = this.getPrec(this.peek().kind);
            if (prec < minPrec) { break; }
            int nextMin = prec + 1;
            int op = this.peek().kind;
            if (op == 110 || op == 130 || op == 131 || op == 132 || op == 133 || op == 157 || op == 158 || op == 159 || op == 160 || op == 161 || op == 162 || op == 170) {
                nextMin = 1;
            }
            // DOCS/273: a safe access yields a value, not a place — it can
            // never be an assignment target (`a?.b = c` is Invalid assignment).
            if (lhs.kind == 75 && (op == 110 || op == 130 || op == 131 || op == 132 || op == 133 || op == 157 || op == 158 || op == 159 || op == 160 || op == 161 || op == 162 || op == 170)) {
                Token opTok = this.peek();
                this.recordError((string)opTok.line + ":" + (string)opTok.col + ": Invalid assignment target");
            }
            this.advance();
            Node rhs = this.parseExpr(nextMin);
            Node bin = new Node(); bin.kind = 7;
            bin.op = this.tokenToOp(op);
            bin.children.add(lhs);
            bin.children.add(rhs);
            // Fast path (STANDARDS.md 21): `"a" + "b"` folds to one string
            // literal at parse time. Runtime concat sizes both operands by
            // strlen and heap-allocates on every evaluation; the folded
            // literal is emitted once, so a hot loop ties a hand-written
            // literal. The length-sum guard rejects embedded NULs (`\0`,
            // `\x00`): they truncate at runtime (strlen) while a folded
            // literal would carry the NUL bytes into a different truncation.
            if (bin.op == 1 && lhs.kind == 2 && rhs.kind == 2) {
                string both = lhs.strVal + rhs.strVal;
                if (both.length == lhs.strVal.length + rhs.strVal.length) {
                    Node lit = new Node();
                    lit.kind = 2;
                    lit.strVal = both;
                    lit.line = lhs.line;
                    lit.col = lhs.col;
                    lhs = lit;
                    continue;
                }
            }
            lhs = bin;
        }
        return lhs;
    }

    // Fast path (STANDARDS.md 10): `needle in [lit, ...]` desugars to an
    // `||` chain of `==` (`&&` of `!=` for `not in`) when every element is
    // a string literal (kind 2) and the needle is an identifier (kind 6)
    // or a string literal, or every element is an int literal (kind 0)
    // and the needle is an identifier or an int literal. The membership
    // loop heap-allocates the array on every evaluation; the chain
    // compares directly with the same equality (strcmp for strings,
    // bit-identity for ints) in the same order, so the result is
    // identical and performance ties a hand-written `||`. Anything else
    // returns null and the caller keeps the kind-7/op-37 node.
    private Node? desugarLiteralMembership(Node needle, Node collection, bool negated) {
        if (collection.kind != 19 || collection.op == 1 || collection.op == 2) { return null; }
        if (collection.childCount() == 0) { return null; }
        bool allStr = true;
        bool allInt = true;
        for (int i = 0; i < collection.childCount(); i++) {
            int k = collection.child(i).kind;
            if (k != 2) { allStr = false; }
            if (k != 0) { allInt = false; }
        }
        if (!allStr && !allInt) { return null; }
        bool needleOk = false;
        if (needle.kind == 6) { needleOk = true; }
        else if (needle.kind == 2 && allStr) { needleOk = true; }
        else if (needle.kind == 0 && allInt) { needleOk = true; }
        if (!needleOk) { return null; }
        int cmpOp = 5;
        int chainOp = 12;
        if (negated) { cmpOp = 6; chainOp = 11; }
        bool first = true;
        Node acc = new Node();
        for (int j = 0; j < collection.childCount(); j++) {
            Node one = new Node();
            one.kind = 7;
            one.op = cmpOp;
            one.line = needle.line;
            one.col = needle.col;
            one.children.add(this.freshNeedleCopy(needle));
            one.children.add(collection.child(j));
            if (first) { acc = one; first = false; }
            else {
                Node ch = new Node();
                ch.kind = 7;
                ch.op = chainOp;
                ch.line = needle.line;
                ch.col = needle.col;
                ch.children.add(acc);
                ch.children.add(one);
                acc = ch;
            }
        }
        return acc;
    }

    // A fresh copy of a pure needle (identifier or int/string literal) so
    // each desugared comparison owns its node; sharing one node across
    // parents would alias later in-place passes over the tree.
    private Node freshNeedleCopy(Node needle) {
        Node c = new Node();
        c.kind = needle.kind;
        c.line = needle.line;
        c.col = needle.col;
        if (needle.kind == 6) { c.name = needle.name; return c; }
        if (needle.kind == 0) { c.intVal = needle.intVal; return c; }
        if (needle.kind == 2) { c.strVal = needle.strVal; return c; }
        return c;
    }

    // Fast path: `needle in lo..hi` (int-literal bounds, pure needle)
    // desugars to `needle >= lo && needle < hi` (`< lo || >= hi` for
    // `not in`). A range literal heap-allocates and fills an int array on
    // every evaluation before the membership loop scans it; two integer
    // comparisons decide the same predicate in O(1) with no allocation.
    // End-exclusive semantics make the empty range (`lo >= hi`) an
    // always-false conjunction, matching the scan over zero elements, so
    // no extra guard is needed. Anything else returns null and the caller
    // keeps the kind-7/op-37 node.
    private Node? desugarRangeMembership(Node needle, Node collection, bool negated) {
        if (collection.kind != 7 || collection.op != 27) { return null; }
        if (collection.childCount() < 2) { return null; }
        Node lo = collection.child(0);
        Node hi = collection.child(1);
        if (lo.kind != 0 || hi.kind != 0) { return null; }
        bool needleOk = false;
        if (needle.kind == 6) { needleOk = true; }
        else if (needle.kind == 0) { needleOk = true; }
        if (!needleOk) { return null; }
        int firstOp = 10;
        int secondOp = 7;
        int chainOp = 11;
        if (negated) { firstOp = 7; secondOp = 10; chainOp = 12; }
        Node first = new Node();
        first.kind = 7;
        first.op = firstOp;
        first.line = needle.line;
        first.col = needle.col;
        first.children.add(this.freshNeedleCopy(needle));
        first.children.add(lo);
        Node second = new Node();
        second.kind = 7;
        second.op = secondOp;
        second.line = needle.line;
        second.col = needle.col;
        second.children.add(this.freshNeedleCopy(needle));
        second.children.add(hi);
        Node ch = new Node();
        ch.kind = 7;
        ch.op = chainOp;
        ch.line = needle.line;
        ch.col = needle.col;
        ch.children.add(first);
        ch.children.add(second);
        return ch;
    }

    // DOCS/275: `is null` / `is not null` null checks. `is` lexes as
    // Identifier("is"); the parser desugars `a is null` to `a == null`
    // and `a is not null` to `a != null` (builtin pointer equality, so
    // null operands never crash and never dispatch to an `==`/`!=`
    // overload). `is <Type>` stays a clean error — only null checks are
    // supported.
    private Node? parseIs(Node lhs) {
        Token isTok = this.peek();
        int isLine = isTok.line;
        int isCol = isTok.col;
        this.advance();
        if (this.check(7) && this.peek().text == "not") {
            this.advance();
            if (this.check(6)) {
                Token nullTok = this.advance();
                Node n = new Node();
                n.kind = 5;
                n.line = nullTok.line;
                n.col = nullTok.col;
                Node bin = new Node();
                bin.kind = 7;
                bin.op = 6;
                bin.line = isLine;
                bin.col = isCol;
                bin.children.add(lhs);
                bin.children.add(n);
                return bin;
            }
            this.recordError((string)isLine + ":" + (string)isCol + ": Unexpected token 'is: only `is null` and `is not null` are supported — `is <Type>` is not Silver (see DOCS/275)'");
            return null;
        }
        if (this.check(6)) {
            Token nullTok = this.advance();
            Node n = new Node();
            n.kind = 5;
            n.line = nullTok.line;
            n.col = nullTok.col;
            Node bin = new Node();
            bin.kind = 7;
            bin.op = 5;
            bin.line = isLine;
            bin.col = isCol;
            bin.children.add(lhs);
            bin.children.add(n);
            return bin;
        }
        this.recordError((string)isLine + ":" + (string)isCol + ": Unexpected token 'is: only `is null` and `is not null` are supported — `is <Type>` is not Silver (see DOCS/275)'");
        return null;
    }

    private int tokenToOp(int kind) {
        if (kind == 111) { return 1; }
        if (kind == 112) { return 2; }
        if (kind == 113) { return 3; }
        if (kind == 114) { return 4; }
        if (kind == 115) { return 13; }
        if (kind == 134) { return 5; }
        if (kind == 135) { return 6; }
        if (kind == 120) { return 7; }
        if (kind == 136) { return 8; }
        if (kind == 121) { return 9; }
        if (kind == 137) { return 10; }
        if (kind == 138) { return 11; }
        if (kind == 139) { return 12; }
        if (kind == 110) { return 20; }
        if (kind == 130) { return 14; }
        if (kind == 131) { return 15; }
        if (kind == 132) { return 16; }
        if (kind == 133) { return 17; }
        if (kind == 140) { return 18; }
        if (kind == 141) { return 19; }
        if (kind == 157) { return 29; }
        if (kind == 158) { return 30; }
        if (kind == 159) { return 31; }
        if (kind == 160) { return 32; }
        if (kind == 161) { return 33; }
        if (kind == 162) { return 34; }
        if (kind == 144) { return 27; }
        if (kind == 147) { return 26; }
        if (kind == 148) { return 25; }
        if (kind == 170) { return 38; }
        if (kind == 116) { return 22; }
        if (kind == 117) { return 23; }
        if (kind == 118) { return 24; }
        if (kind == 54) { return 37; }
        return 0;
    }

    // DOCS/259 G4 -- lookahead for the `as` cast: the `as` keyword must be
    // followed by a type-like token (class identifier or primitive keyword).
    // A comma, closing paren/bracket, semicolon, brace, or operator after
    // `as` means it is NOT a cast (e.g. the range-for `for (x as start..end)`
    // spelling is consumed before parseExpr ever sees that context, and bare
    // `T as Alias;` declaration statements end the expression here).
    private bool isAsCastAhead() {
        if (this.pos + 1 >= this.tokens.length) { return false; }
        int nk = this.tokens[this.pos + 1].kind;
        if (nk == 7) { return true; }
        if (nk == 17 || nk == 18 || nk == 19 || nk == 20 || nk == 22 || nk == 23 || nk == 25 || nk == 26 || nk == 27) { return true; }
        return false;
    }

    // DOCS/259 G4 -- parse the cast target spelling after `as`: an
    // identifier (class name), a primitive keyword, or a generic/nullable
    // shape. Array/nullable suffixes are accepted like a plain type.
    private string parseAsCastTarget() {
        Token t = this.advance();
        string target = t.text;
        if (this.check(120)) {
            while (!this.check(121) && !this.check(106) && !this.check(103)) {
                target += this.advance().text;
            }
            if (this.check(121)) { target += ">"; this.advance(); }
        }
        while (this.check(104)) {
            this.advance();
            this.expect(105);
            target += "[]";
        }
        if (this.check(123)) { this.advance(); target += "?"; }
        return target;
    }

    // DOCS/259 G4 -- primitive type spellings rejected as cast targets (the
    // cast is only a class-instance assertion).
    private bool isPrimitiveTypeSpelling(string t) {
        if (t == "int") { return true; }
        if (t == "int32") { return true; }
        if (t == "int64") { return true; }
        if (t == "uint") { return true; }
        if (t == "uint64") { return true; }
        if (t == "float") { return true; }
        if (t == "float64") { return true; }
        if (t == "double") { return true; }
        if (t == "bool") { return true; }
        if (t == "byte") { return true; }
        if (t == "char") { return true; }
        if (t == "string") { return true; }
        if (t == "void") { return true; }
        return false;
    }

    private int getPrec(int kind) {
        if (kind == 110 || kind == 130 || kind == 131 || kind == 132 || kind == 133 || kind == 148 || kind == 170 || kind == 157 || kind == 158 || kind == 159 || kind == 160 || kind == 161 || kind == 162) { return 1; }
        if (kind == 139) { return 2; }
        if (kind == 138) { return 3; }
        if (kind == 135 || kind == 134) { return 4; }
        if (kind == 120 || kind == 136 || kind == 121 || kind == 137) { return 5; }
        if (kind == 54) { return 5; }
        if (kind == 117) { return 6; }
        if (kind == 116) { return 7; }
        if (kind == 118) { return 7; }
        if (kind == 140 || kind == 141) { return 8; }
        if (kind == 111 || kind == 112) { return 9; }
        if (kind == 113 || kind == 114 || kind == 115) { return 10; }
        if (kind == 147) { return 4; }
        if (kind == 144) { return 11; }
        return -1;
    }

    // True when the token after a `match` token cannot begin a match
    // subject: `) ; , ] }` end the expression, `.`/`?.`/`?[`/ternary
    // continue it, and the binary/assignment operators take it as an
    // operand. A match subject can never start with any of these, so every
    // currently-valid program keeps the match-expression parse exactly.
    // Anything else (notably `(` and expression-leading tokens) keeps the
    // legacy match-expression path.
    private bool matchIsIdentAhead() {
        if (this.pos >= this.tokens.length) { return false; }
        int nk = this.tokens[this.pos].kind;
        if (nk == 101 || nk == 103 || nk == 105 || nk == 106 || nk == 107) { return true; }
        if (nk == 108 || nk == 163 || nk == 169 || nk == 109 || nk == 123) { return true; }
        if (nk == 110 || nk == 114 || nk == 115 || nk == 118) { return true; }
        if (nk == 130 || nk == 131 || nk == 132 || nk == 133 || nk == 157) { return true; }
        if (nk == 134 || nk == 135 || nk == 136 || nk == 137) { return true; }
        if (nk == 138 || nk == 139 || nk == 140 || nk == 141) { return true; }
        if (nk == 142 || nk == 143 || nk == 148 || nk == 170) { return true; }
        return false;
    }

    private Node parsePrefix() {
        Token t = this.advance();
        Node n = new Node();
        n.line = t.line; n.col = t.col;
        int kind = t.kind;

        if (kind == 1) {
            // Number literal.  The token text distinguishes ints from floats:
            // a float's spelling contains a '.' (46) or exponent marker
            // 'e'/'E' (101/69), which the lexer preserves verbatim. Hex
            // spellings are exempt: their 'e'/'E' are DIGITS (0x5e is 94,
            // not 5e0), flagged by the lexer's isHexNum.
            bool isFloat = false;
            if (!t.isHexNum) {
                for (int tc = 0; tc < t.text.length; tc++) {
                    int tcc = t.text[tc];
                    if (tcc == 46 || tcc == 101 || tcc == 69) { isFloat = true; break; }
                }
            }
            if (isFloat) { n.kind = 1; n.intVal = t.intVal; }
            else { n.kind = 0; n.intVal = t.intVal; }
            return n;
        }
        if (kind == 2) { n.kind = 1; n.floatVal = t.floatVal; return n; }
        if (kind == 3) { n.kind = 2; n.strVal = t.strVal; return n; }
        if (kind == 4) { n.kind = 3; n.charVal = t.charVal; return n; }
        if (kind == 5) {
            n.kind = 4;
            n.boolVal = t.text == "true";
            return n;
        }
        if (kind == 6) { n.kind = 5; return n; }
        if (kind == 7) { n.kind = 6; n.name = t.text; return n; }        if (kind == 39) {
            // DOCS/274: `new class { ... }` — anonymous class expression.
            // Desugars to a hidden named class plus a zero-argument `new`
            // of it (see parseAnonClass).
            if (this.check(30)) {
                return this.parseAnonClass(t);
            }
            Node ctor = new Node();
            ctor.kind = 10;
            ctor.name = this.advance().text;
            ctor.line = t.line;
            ctor.col = t.col;
            // Marker for codegen (mini_cg isClass==1 branch): this kind-10
            // call node came from a `new T(...)` expression, not a bare
            // call. Without it a same-named imported win32 export (net.sr's
            // bare `socket(2,1,0)` under `class socket`) is hijacked into
            // the constructor path -- silverc-rs distinguishes the two at
            // parse level and resolves the DLL export first.
            ctor.isStatic = true;
            // Dotted-new: a qualified class
            // name `new mod.Class(args)` — any chain depth, the last segment
            // is the class. Joined into a single dotted call name; codegen
            // resolves it through the module's flattened namespace. Each
            // segment must be an identifier (parse error otherwise, matching
            // the reference compiler's ExpectedToken("identifier")).
            while (this.check(108)) {
                this.advance();
                ctor.name += "." + this.expect(7).text;
            }
            if (this.check(104)) {
                // new T[n]: native array allocation.  A zero/omitted size
                // produces an empty array; a positive constant size produces
                // that many zeroed slots.  A non-literal size expression
                // marks an op=2 runtime-sized allocation node (child 0 = the
                // size expression) that codegen lowers through the same
                // HeapAlloc shape silverc-rs emits — net.sr's
                // `new int[slots]` buffers depend on it.
                this.advance();
                Node sizeExpr = this.parseExpr(0);
                this.expect(105);
                Node arr = new Node(); arr.kind = 19;
                if (sizeExpr.kind == 0) {
                    arr.op = 1;
                    arr.intVal = sizeExpr.intVal;
                }
                if (sizeExpr.kind == 0 && sizeExpr.intVal > 0 && sizeExpr.intVal <= 256) {
                    for (int zi = 0; zi < sizeExpr.intVal; zi++) {
                        Node zero = new Node(); zero.kind = 0; zero.intVal = 0;
                        arr.children.add(zero);
                    }
                }
                if (sizeExpr.kind != 0) {
                    arr.op = 2;
                    arr.children.add(sizeExpr);
                }
                return arr;
            }
            if (this.check(102)) {
                // DOCS/270: `new Type { field = value, ... }` — no
                // constructor parens; zero ctor args plus brace inits.
                return this.parseObjectInit(ctor, t);
            }
            this.expect(100);
            while (!this.check(101) && !this.check(0)) {
                ctor.children.add(this.parseExpr(0));
                if (this.check(107)) { this.advance(); }
            }
            this.expect(101);
            if (this.check(102)) {
                return this.parseObjectInit(ctor, t);
            }
            return ctor;
        }

        if (kind == 16) {
            // `match` as an identifier (DOCS/176 `bool match = ...`): when
            // the next token cannot begin a match subject, this is a variable
            // reference, not a match expression.
            if (this.matchIsIdentAhead()) {
                n.kind = 6; n.name = t.text; return n;
            }
            // `match (subject) { pattern => expr; ... }` is an expression: the
            // value of the matched arm is the match's value.  Arms may carry a
            // guard `pattern if cond => body` (DOCS/154); the guard (if any)
            // is stored as arm child(1) so codegen can test it after the
            // pattern binds.
            Node m = new Node(); m.kind = 20;
            // Span for the guard's diagnostics (enum-exhaustiveness
            // warnings point at the match itself).
            m.line = t.line; m.col = t.col;
            if (this.check(100)) {
                this.advance();
                m.children.add(this.parseExpr(0));
                this.expect(101);
            } else {
                m.children.add(this.parseExpr(0));
            }
            this.expect(102);
            while (!this.check(103) && !this.check(0)) {
                Node arm = new Node(); arm.kind = 21;
                arm.children.add(this.parsePattern());
                if (this.check(10)) {
                    this.advance();
                    arm.children.add(this.parseExpr(0));
                }
                this.expect(146);
                arm.children.add(this.parseExpr(0));
                if (this.check(106)) { this.advance(); }
                m.children.add(arm);
            }
            this.expect(103);
            return m;
        }

        if (kind == 100) {
            // DOCS/259 -- anonymous function argument. The supported form is
            // `(void () { ... })`; the lookahead is `void` `(` `)` `{`.
            if (this.check(17) && this.pos + 3 < this.tokens.length
                && this.tokens[this.pos + 1].kind == 100
                && this.tokens[this.pos + 2].kind == 101
                && this.tokens[this.pos + 3].kind == 102) {
                this.advance();
                this.advance();
                this.advance();
                Node anonBody = this.parseBlock();
                this.expect(101);
                Node anon = new Node();
                anon.kind = 85;
                anon.line = t.line;
                anon.col = t.col;
                anon.children.add(anonBody);
                return anon;
            }
            // DOCS/259 -- an anonymous-function attempt whose shape is not the
            // supported `void ()`: a type keyword, `(`, a balanced parameter
            // list, then `{`. Reported instead of a generic parse failure.
            if (this.isUnsupportedAnonFnAhead()) {
                this.recordError((string)t.line + ":" + (string)t.col + ": Unexpected token '(: only `void ()` anonymous functions are supported; parameters and non-void return types in function types are not supported yet (see DOCS/259)'");
                this.skipAnonFnShapedTokens();
                Node unsupportedNul = new Node();
                unsupportedNul.kind = 5;
                return unsupportedNul;
            }
            // C-style casts, e.g. `(int) c`: primitive targets lower as the
            // matching conversion call (DOCS/113) so every cast converts;
            // void/var/user-type names keep the legacy pass-through.
            int castSaved = this.pos;
            bool castPrim = this.isPrimitiveTypeSpelling(this.peek().text) && this.peek().text != "void";
            // A bare `(name)` is a transparent grouping, not a cast, unless
            // the name is a declared type (def/struct/class/enum/alias) —
            // otherwise `(int)(len)` swallows `len` and eats the `;`.
            bool castNop = this.check(17) || this.check(28) || (this.check(7) && this.isDeclaredTypeName(this.peek().text));
            if (castPrim || castNop) {
                Token typeTok = this.peek();
                this.advance();
                if (this.check(101)) {
                    this.advance();
                    Node operand = this.parseExpr(13);
                    if (castNop) { return operand; }
                    string convName = typeTok.text;
                    if (typeTok.text == "string") { convName = "string_cast"; }
                    Node conv = new Node();
                    conv.kind = 10;
                    conv.name = convName;
                    conv.line = typeTok.line; conv.col = typeTok.col;
                    conv.children.add(operand);
                    return conv;
                }
            }
            this.pos = castSaved;
            this.parenDepth++;
            Node first = this.parseExpr(0);
            if (this.check(107)) {
                n.kind = 70;
                n.children.add(first);
                while (this.check(107)) {
                    this.advance();
                    n.children.add(this.parseExpr(0));
                }
                this.expect(101);
                this.parenDepth--;
                return n;
            }
            n.kind = 23; n.children.add(first); this.expect(101); this.parenDepth--; return n;
        }
        if (kind == 102) {
            if (this.check(103)) {
                n.kind = 66;
                this.advance();
                return n;
            }
            // Braced string/int key pairs are dictionary literals; a braced
            // identifier-keyed form is a struct literal; other braced
            // expressions retain the historical array-compatible form.
            if (this.check(3) || this.check(1) || this.check(7)) {
                int saved = this.pos;
                Node firstKey = this.parseExpr(0);
                if (this.check(109)) {
                    this.advance();
                    if (firstKey.kind == 6) {
                        // Struct literal: `{name: value, ...}`. Field names are
                        // identifiers; keep each pair as `(identifier, value)`.
                        n.kind = 74;
                        Node pair = new Node(); pair.kind = 18;
                        pair.children.add(firstKey);
                        pair.children.add(this.parseExpr(0));
                        n.children.add(pair);
                        while (this.check(107)) {
                            this.advance();
                            Node key = this.parseExpr(0);
                            this.expect(109);
                            Node nextPair = new Node(); nextPair.kind = 18;
                            nextPair.children.add(key);
                            nextPair.children.add(this.parseExpr(0));
                            n.children.add(nextPair);
                        }
                        this.expect(103);
                        return n;
                    }
                    n.kind = 66;
                    Node dpair = new Node(); dpair.kind = 18;
                    dpair.children.add(firstKey);
                    dpair.children.add(this.parseExpr(0));
                    n.children.add(dpair);
                    while (this.check(107)) {
                        this.advance();
                        Node key = this.parseExpr(0);
                        this.expect(109);
                        Node nextPair = new Node(); nextPair.kind = 18;
                        nextPair.children.add(key);
                        nextPair.children.add(this.parseExpr(0));
                        n.children.add(nextPair);
                    }
                    this.expect(103);
                    return n;
                }
                this.pos = saved;
            }
            n.kind = 19;
            while (!this.check(103) && !this.check(0)) {
                n.children.add(this.parseExpr(0));
                if (this.check(107)) { this.advance(); }
            }
            this.expect(103);
            return n;
        }

        if (kind == 104) {
            n.kind = 19;
            while (!this.check(105) && !this.check(0)) {
                if (this.check(147)) {
                    // Spread element `...arr` inside an array literal (DOCS/116):
                    // copy the source array's elements into this literal.
                    this.advance();
                    Node sp = new Node(); sp.kind = 77;
                    sp.children.add(this.parseExpr(0));
                    n.children.add(sp);
                } else {
                    n.children.add(this.parseExpr(0));
                }
                if (this.check(107)) { this.advance(); }
            }
            this.expect(105);
            return n;
        }

        if (kind == 112) { n.kind = 8; n.op = 0; n.children.add(this.parseExpr(13)); return n; }
        if (kind == 122) { n.kind = 8; n.op = 1; n.children.add(this.parseExpr(10)); return n; }
        if (kind == 119) { n.kind = 8; n.op = 2; n.children.add(this.parseExpr(10)); return n; }
        if (kind == 116) { n.kind = 8; n.op = 3; n.children.add(this.parseExpr(10)); return n; }
        // DOCS/50: dereference `*p` — a value expression loading the 8-byte
        // cell at the address `p` holds. Prefix position only, so infix
        // multiply (`a * b`) is unaffected.
        if (kind == 113) { n.kind = 8; n.op = 4; n.children.add(this.parseExpr(10)); return n; }
        if (kind == 156) {
            Node a = new Node(); a.kind = 72;
            a.children.add(this.parseExpr(10));
            return a;
        }
        if (kind == 168) {
            // SPEC 12.2 / DOCS 102: the lexer produced a brace/quote-aware
            // interpolation string (adjacent `$"..."`); build the node from its
            // segments, classifying each hole.
            Node ip = this.buildInterpFromToken(t);
            ip.line = t.line; ip.col = t.col;
            return ip;
        }
        if (kind == 149) {
            if (this.check(3)) {
                Token st = this.advance();
                Node ip = this.parseInterpString(st.strVal);
                ip.line = t.line; ip.col = t.col;
                return ip;
            }
            Node bad = new Node(); bad.kind = 6; bad.name = "$";
            return bad;
        }

        if (kind == 17) {
            // DOCS/259: an anonymous function argument must be wrapped in
            // parentheses — `void () { ... }` alone is not a value. Recovery
            // consumes the anon-shaped tokens so the damaged region reports
            // only this error.
            if (this.check(100)) {
                this.recordError((string)t.line + ":" + (string)t.col + ": Unexpected token 'void: the anonymous function must be wrapped in parentheses — write (void () { ... }) (see DOCS/259)'");
                this.skipBalancedParens();
                if (this.check(102)) { this.skipBalancedBraces(); }
                Node wrapNul = new Node();
                wrapNul.kind = 5;
                return wrapNul;
            }
        }

        Node ident = new Node(); ident.kind = 6; ident.name = t.text;
        return ident;
    }

    // DOCS/270: object initializer `{ field = value, ... }` after
    // `new Type(args)` or `new Type`. Rewrites the kind-10 ctor node into a
    // kind-88 new-init node: `name` stays the class, `op` records the
    // constructor argument count, children are [args..., initPairs...]
    // where each init pair is kind 18 holding (fieldIdent, value) — the
    // same pair shape struct literals use. Entries use `=` (a `:` is a
    // struct-literal separator, diagnosed here), are separated by `,` (a
    // `;` is also accepted), and a trailing separator is allowed.
    private Node parseObjectInit(Node ctor, Token t) {
        Node res = new Node();
        res.kind = 88;
        res.name = ctor.name;
        res.line = t.line;
        res.col = t.col;
        res.isStatic = true;
        res.op = ctor.childCount();
        for (int ai = 0; ai < ctor.childCount(); ai++) {
            res.children.add(ctor.child(ai));
        }
        this.advance();
        string[] seenFields = [];
        while (!this.check(103) && !this.check(0)) {
            Token fname = this.expect(7);
            if (this.check(109)) {
                this.recordError((string)fname.line + ":" + (string)fname.col + ": object initializers use `field = value`; `{ field: value }` is a struct literal");
                this.advance();
            } else {
                this.expect(110);
            }
            Node val = this.parseExpr(0);
            // DOCS/270: a collision — the same field twice in one brace
            // list — is a compile error; the initializer has no ordering
            // that could give one entry priority.
            bool isDup = false;
            for (int si = 0; si < seenFields.length; si++) {
                if (seenFields[si] == fname.text) { isDup = true; break; }
            }
            if (isDup) {
                this.recordError((string)fname.line + ":" + (string)fname.col + ": duplicate field '" + fname.text + "' in object initializer");
            } else {
                seenFields.add(fname.text);
                Node key = new Node(); key.kind = 6; key.name = fname.text; key.line = fname.line; key.col = fname.col;
                Node pair = new Node(); pair.kind = 18; pair.children.add(key); pair.children.add(val);
                res.children.add(pair);
            }
            if (this.check(107) || this.check(106)) { this.advance(); } else { break; }
        }
        this.expect(103);
        return res;
    }

    // Build the kind-69 interpolation node from a lexer InterpString token's
    // segments (SPEC 12.2 / DOCS 102). Text segments become literal kind-2
    // children; hole segments are classified value-vs-parenthesized-expression.
    private Node buildInterpFromToken(Token t) {
        Node n = new Node();
        n.kind = 69;
        n.name = "interp";
        for (int i = 0; i < t.ipKinds.length; i++) {
            if (t.ipKinds[i] == 0) {
                string txt = t.ipTexts[i];
                if (txt.length > 0) {
                    Node tn = new Node(); tn.kind = 2; tn.strVal = txt;
                    n.children.add(tn);
                }
            } else {
                n.children.add(this.classifyHole(t.ipTexts[i], t.ipLines[i], t.ipCols[i]));
            }
        }
        return n;
    }

    // Classify one interpolation hole (SPEC 12.2 / DOCS 102): a hole fully
    // wrapped in parentheses is an arbitrary expression; anything else must be
    // a plain value reference (identifier with `.member` / `[index]` postfixes),
    // or it is a compile error telling the user to parenthesize. Mirrors
    // silverc-rs Parser::parse_interp_hole.
    private Node classifyHole(string raw, int hLine, int hCol) {
        string h = projectTrim(raw);
        if (h.length == 0) {
            this.recordError("Expected expression in interpolation hole at line " + (string)hLine + ", column " + (string)hCol);
            Node empty = new Node(); empty.kind = 2; empty.strVal = "";
            return empty;
        }
        if (this.holeFullyParenthesized(h)) {
            string inner = projectTrim(projectSlice(h, 1, h.length - 1));
            if (inner.length == 0) {
                this.recordError("Expected expression in interpolation hole at line " + (string)hLine + ", column " + (string)hCol);
                Node empty = new Node(); empty.kind = 2; empty.strVal = "";
                return empty;
            }
            return this.parseHoleExpr(inner, hLine, hCol);
        }
        Node en = this.parseHoleExpr(h, hLine, hCol);
        if (!this.isValueRefNode(en)) {
            this.recordError("expression interpolation must be wrapped in parentheses: use {(" + h + ")} for \"" + h + "\" at line " + (string)hLine + ", column " + (string)hCol);
            Node empty = new Node(); empty.kind = 2; empty.strVal = "";
            return empty;
        }
        return en;
    }

    // Re-lex and parse one hole body as a single complete expression, forwarding
    // any diagnostics the sub-parser records and rejecting trailing tokens
    // (mirrors silverc-rs Parser::parse_hole_expr).
    private Node parseHoleExpr(string text, int hLine, int hCol) {
        Lexer lx = new Lexer(text);
        Token[] toks = lx.tokenize();
        Parser pp = new Parser(toks);
        // DOCS/274: holes re-lex into a fresh sub-parser. Carry the
        // anonymous-class counter across so minted hidden names stay unique,
        // then take the sub-parser's hidden classes (and their names) back —
        // otherwise a `new class` inside `$"{...}"` would dangle.
        pp.anonCounter = this.anonCounter;
        Node en = pp.parseExpr(0);
        for (int e = 0; e < pp.diagErrors.length; e++) { this.recordError(pp.diagErrors[e]); }
        if (!pp.check(0)) {
            this.recordError("Expected end of interpolation hole at line " + (string)hLine + ", column " + (string)hCol);
        }
        this.anonCounter = pp.anonCounter;
        for (int hi = 0; hi < pp.anonClasses.length; hi++) {
            Node hidden = pp.anonClasses[hi];
            hidden.srcModule = this.curModule;
            this.registerDeclaredType(hidden.name);
            this.anonClasses.add(hidden);
        }
        return en;
    }

    // True when the trimmed hole body `h` is entirely wrapped in one matching
    // pair of parentheses: it starts with `(` whose partner `)` is the final
    // character. Nested string/char literals are skipped so parens inside
    // literals never count (mirrors silverc-rs hole_is_fully_parenthesized).
    private bool holeFullyParenthesized(string h) {
        int n = h.length;
        if (n < 2) { return false; }
        if (h[0] != '(' || h[n - 1] != ')') { return false; }
        int depth = 0;
        int i = 0;
        while (i < n) {
            char c = h[i];
            if (c == '(') {
                depth++;
            } else if (c == ')') {
                depth--;
                if (depth == 0) { return i == n - 1; }
                if (depth < 0) { return false; }
            } else if (c == '"' || c == '\'') {
                char q = c;
                int j = i + 1;
                while (j < n) {
                    if (h[j] == '\\') { j += 2; continue; }
                    if (h[j] == q) { break; }
                    j++;
                }
                i = j;
            }
            i++;
        }
        return false;
    }

    // Value-form interpolation check (SPEC 12.2): an identifier optionally
    // followed by `.member` and/or `[index]` postfixes -- no operators, calls
    // or literals. The bracket contents of an index may be any expression
    // (mirrors silverc-rs is_value_ref_expr; kind 6 = identifier, 13 = member
    // access, 24 = index).
    private bool isValueRefNode(Node e) {
        if (e.kind == 6) { return true; }
        if (e.kind == 13 && e.childCount() > 0) { return this.isValueRefNode(e.child(0)); }
        if (e.kind == 24 && e.childCount() > 0) { return this.isValueRefNode(e.child(0)); }
        return false;
    }

    // Legacy `$ "..."` splitter for a non-adjacent Dollar token followed by a
    // string literal (SPEC 12.2). Holes are split on balanced braces and routed
    // through classifyHole so the value-vs-parenthesized rule matches the main
    // interpolation path.
    private Node parseInterpString(string s) {
        Node n = new Node();
        n.kind = 69;
        n.name = "interp";
        string text = "";
        int i = 0;
        while (i < s.length) {
            if (s[i] == '{') {
                if (i + 1 < s.length && s[i + 1] == '{') { text += "{"; i += 2; continue; }
                if (text.length > 0) {
                    Node tn = new Node(); tn.kind = 2; tn.strVal = text;
                    n.children.add(tn);
                    text = "";
                }
                int depth = 1;
                i++;
                string exprSrc = "";
                while (i < s.length && depth > 0) {
                    if (s[i] == '{') { depth++; }
                    else if (s[i] == '}') {
                        depth--;
                        if (depth == 0) { break; }
                    }
                    exprSrc += (string)s[i];
                    i++;
                }
                if (depth == 0) {
                    n.children.add(this.classifyHole(exprSrc, n.line, n.col));
                }
                i++;
            } else if (s[i] == '}') {
                if (i + 1 < s.length && s[i + 1] == '}') { text += "}"; i += 2; continue; }
                text += "}";
                i++;
            } else {
                text += (string)s[i];
                i++;
            }
        }
        if (text.length > 0) {
            Node tn = new Node(); tn.kind = 2; tn.strVal = text;
            n.children.add(tn);
        }
        return n;
    }

    // ---- DOCS/259 helpers ---------------------------------------------------

    // Reject the C-style `function` keyword at the point a parameter type is
    // expected. `function` is not a Silver keyword (it lexes as an
    // identifier), so the check matches the identifier's text.
    private bool rejectCStyleFunctionParam() {
        Token t = this.peek();
        if (t.kind == 7 && t.text == "function") {
            this.recordError((string)t.line + ":" + (string)t.col + ": Unexpected token 'function: function-typed parameters are declared `void () name` and passed as `(void () { ... })` — C-style `function` keyword is not Silver (see DOCS/259)'");
            return true;
        }
        return false;
    }

    // After a verbatim DOCS/259 rejection: consume the damaged function's
    // remaining tokens (rest of the parameter list, optional arrow/return
    // type, body) so the report contains exactly the one error.
    private void skipDamagedFunction() {
        int depth = 1;
        while (!this.check(0)) {
            if (this.check(100)) {
                depth++;
                this.advance();
            } else if (this.check(101)) {
                depth--;
                this.advance();
                if (depth == 0) { break; }
            } else {
                this.advance();
            }
        }
        if (this.check(145)) {
            while (!this.check(0) && !this.check(102) && !this.check(106)) { this.advance(); }
            if (this.check(106)) { this.advance(); }
        }
        if (this.check(141) || this.check(140)) {
            this.advance();
            while (!this.check(0) && !this.check(106) && !this.check(103)) { this.advance(); }
            if (this.check(106)) { this.advance(); }
        } else if (this.check(102)) {
            this.skipBalancedBraces();
            if (this.check(106)) { this.advance(); }
        }
    }

    // DOCS/259 -- register a rejected function's name as a known (empty)
    // signature so call sites in the remaining program text do not produce
    // follow-on unknown-method noise.
    private void registerDamagedSignature(string name) {
        this.sigNames.add(name);
        this.sigTypes.add("");
        this.sigParams.add("");
        this.sigVariadic.add(0);
    }

    // DOCS/259 -- after the outer `(` of a parenthesized expression has been
    // consumed, decide whether what follows is an anonymous-function attempt
    // whose shape is not the supported `void ()`: a type keyword, `(`, a
    // balanced parameter list, then `{`.
    private bool isUnsupportedAnonFnAhead() {
        bool typeKw = this.check(17) || this.check(18) || this.check(19) || this.check(20) || this.check(21)
            || this.check(22) || this.check(23) || this.check(25) || this.check(26) || this.check(27);
        if (!typeKw) {
            // uint/byte/double/long lex as identifiers in this grammar.
            if (this.check(7)) {
                string w = this.peek().text;
                typeKw = w == "uint" || w == "byte" || w == "double"
                    || w == "long" || w == "boolean";
            }
        }
        if (!typeKw) { return false; }
        if (this.pos + 1 >= this.tokens.length || this.tokens[this.pos + 1].kind != 100) { return false; }
        int depth = 0;
        int i = this.pos + 1;
        while (i < this.tokens.length) {
            int k = this.tokens[i].kind;
            if (k == 100) {
                depth++;
                i++;
            } else if (k == 101) {
                depth--;
                i++;
                if (depth == 0) { break; }
            } else if (k == 0) {
                return false;
            } else {
                i++;
            }
        }
        if (i >= this.tokens.length) { return false; }
        return this.tokens[i].kind == 102;
    }

    // Consume the rejected `( Type ( ... ) { ... } )` shape so the damaged
    // region produces no follow-on errors. The outer `(` is already consumed
    // when this runs.
    private void skipAnonFnShapedTokens() {
        this.skipBalancedParens();
        if (this.check(102)) { this.skipBalancedBraces(); }
        if (this.check(101)) { this.advance(); }
    }

    // From the current token, consume a balanced `(...)` run including the
    // opening parenthesis. A leading `)` that would take the depth negative
    // is left in place (mirrors the reference lookahead walker).
    private void skipBalancedParens() {
        int depth = 0;
        bool started = false;
        while (!this.check(0)) {
            if (this.check(100)) {
                depth++;
                started = true;
                this.advance();
            } else if (this.check(101)) {
                if (!started) { return; }
                depth--;
                this.advance();
                if (depth == 0) { return; }
            } else {
                this.advance();
            }
        }
    }

    // From the current token (expected to be `{`), consume through the
    // matching closing brace.
    private void skipBalancedBraces() {
        int depth = 0;
        while (!this.check(0)) {
            if (this.check(102)) {
                depth++;
                this.advance();
            } else if (this.check(103)) {
                depth--;
                this.advance();
                if (depth == 0) { return; }
            } else {
                this.advance();
            }
        }
    }

    private Node parsePattern() {
        Node n = new Node();
        Token t = this.advance();
        if (t.kind == 126) { n.name = "_"; return n; }
        if (t.kind == 1) { n.kind = 0; n.intVal = t.intVal; return n; }
        if (t.kind == 3) { n.kind = 2; n.strVal = t.strVal; return n; }
        if (t.kind == 4) { n.kind = 3; n.charVal = t.charVal; return n; }
        if (t.kind == 100) {
            // Tuple pattern `(p1, p2, ...)` (kind 78): positional compare and
            // bind.  The codegen walks each element at ptr + i*8.
            n.kind = 78;
            while (!this.check(101) && !this.check(0)) {
                n.children.add(this.parsePattern());
                if (this.check(107)) { this.advance(); }
            }
            this.expect(101);
            return n;
        }
        if (t.kind == 7) {
            n.name = t.text;
            if (this.check(108)) {
                // Enum variant pattern `Enum.Variant` (kind 13): the codegen
                // compares the subject against the enum's constant value.
                this.advance();
                n.kind = 13;
                n.name = t.text + "." + this.advance().text;
            }
            return n;
        }
        return n;
    }
}
