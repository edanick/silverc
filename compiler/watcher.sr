mod export watcher;

import * from fs;
import * from bcache;
import * from cli_flags;
import * from path;

// OVERHAUL.md --watch — predictive precompilation watcher helpers.
//
// The watcher is an idle debounce timer, not an interval: every save resets
// the timer to zero and precompilation fires only after exactly the
// configured idle duration with no saves in between.
//
// Defaults (replaced entirely by .srp precompile overrides):
//   single .sr file            30 s
//   multi-file project         5 min
//   project size limit         5 MB

class WatchConfig {
    public prop int frequencySecs;
    public prop int sizeLimitBytes;

    construct {
        this.frequencySecs = 30;
        this.sizeLimitBytes = 5242880;
    }
}

// Automatic defaults for an input; a manifest's precompile block replaces
// them entirely (custom settings do not mix with the built-ins). An empty
// manifest string means standalone-file defaults.
public WatchConfig watchConfigFor(bool multiFile, string manifest) {
    WatchConfig cfg = new WatchConfig();
    if (multiFile) {
        cfg.frequencySecs = 300;
    } else {
        cfg.frequencySecs = 30;
    }
    if (manifest.length > 0) {
        int freq = precompileNumericValue(manifest, "frequency");
        if (freq >= 0) { cfg.frequencySecs = freq; }
        int limitKb = precompileNumericValue(manifest, "project_size_limit");
        if (limitKb >= 0) { cfg.sizeLimitBytes = limitKb * 1024; }
    }
    return cfg;
}

// One scan's file list. The walk grows this holder's property array instead
// of a bare string[] parameter: growing a bare array inside a helper leaves
// the caller's length stale (the stage-2 truncate-at-8 edge documented in
// std/project.sr:181; see also ProjectVisited / ProjectPieces / PpPieces).
// Growth through the class property stays visible to the holder's owner, and
// a held WatchFiles can be drained in place and refilled per tick instead of
// abandoning a fresh list per 500 ms poll.
class WatchFiles {
    public prop string[] files;

    construct {
        this.files = [];
    }

    public void add(string s) {
        this.files.add(s);
    }

    public void clear() {
        while (this.files.length > 0) { this.files.pop(); }
    }
}

// Refill a held file list from rootDir, reusing its backing capacity: the
// per-tick watch poll calls this instead of allocating a fresh list per tick
// (in the never-free runtime every fresh list is abandoned, so watcher state
// would grow with the number of ticks). The walk itself is unchanged (same
// order, same joins), so results are byte-identical to watchScanSources.
public void watchScanInto(string rootDir, WatchFiles out) {
    out.clear();
    wtWalk(rootDir, "", out);
}

// Recursively list the .sr files under root (sorted by discovery order is
// not required; stability comes from the directory walk).
public string[] watchScanSources(string rootDir) {
    WatchFiles out = new WatchFiles();
    watchScanInto(rootDir, out);
    return out.files;
}

private void wtWalk(string rootDir, string relDir, WatchFiles out) {
    string dir = rootDir;
    if (relDir.length > 0) {
        // A "." root stays bare (".\x" would leak into cache keys); every
        // other join rides the universal path module.
        if (rootDir == ".") { dir = relDir; } else { dir = path.join(rootDir, relDir); }
    }
    string[] names = folder.getFiles(dir);
    for (int i = 0; i < names.length; i++) {
        string name = names[i];
        if (!name.endsWith(".sr")) { continue; }
        if (rootDir == ".") {
            if (relDir.length > 0) { out.add(relDir + "\\" + name); }
            else { out.add(name); }
        } else {
            out.add(path.join(dir, name));
        }
    }
    string[] subdirs = folder.getFolders(dir);
    for (int k = 0; k < subdirs.length; k++) {
        string subname = subdirs[k];
        if (subname == ".git" || subname == "build" || subname == "target") { continue; }
        string subrel = subname;
        if (relDir.length > 0) { subrel = relDir + "\\" + subname; }
        wtWalk(rootDir, subrel, out);
    }
}

// Total byte size of the given files.
public int wtTotalSize(string[] files) {
    int total = 0;
    for (int i = 0; i < files.length; i++) {
        total += file.size(files[i]);
    }
    return total;
}
