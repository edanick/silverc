mod export lexer;

import * from token;

class Lexer {
    private prop string src;
    private prop int pos;
    private prop int line;
    private prop int col;
    private prop char lastChar;
    // Keep the dispatch character in the receiver instead of passing it as a
    // method argument.  This avoids the self-hosted ABI path that can corrupt
    // the first scalar argument after one bootstrap boundary.
    private prop int currentCode;
    // Cached source length.  `string.length` lowers to strlen() (O(n)), so
    // reading it inside every `while (pos < src.length)` loop re-scans the
    // entire source per iteration (O(n^2)).  Cache it once in the constructor.
    private prop int srcLen;
    // Diagnostics collected while scanning (VALUE_EXCEPTION.md position
    // rules): unterminated string literals report the opening line and its
    // last character column.
    public prop string[] lexErrors;

    construct (string source) {
        this.src = source;
        this.srcLen = source.length;
        this.pos = 0;
        this.line = 1;
        this.col = 1;
        this.lastChar = ' ';
        this.currentCode = 0;
        this.lexErrors = [];
    }

    private void recordLexError(string msg) {
        this.lexErrors.add(msg);
    }

    // Character length of the given 1-based source line, excluding CR.
    private int lineCharLen(int targetLine) {
        int lineNum = 1;
        int i = 0;
        while (i < this.srcLen && lineNum < targetLine) {
            if (this.src[i] == '\n') { lineNum++; }
            i++;
        }
        int len = 0;
        while (i < this.srcLen) {
            char c = this.src[i];
            if (c == '\n') { break; }
            if (c != '\r') { len++; }
            i++;
        }
        return len;
    }

    private char? peek() {
        if (this.pos < this.srcLen) {
            char c = this.src[this.pos];
            return c;
        }
        return null;
    }

    private char? peekNext() {
        if (this.pos + 1 < this.srcLen) {
            char c2 = this.src[this.pos + 1];
            return c2;
        }
        return null;
    }

    private char? advance() {
        if (this.pos >= this.srcLen) { return null; }
        char c = this.src[this.pos];
        this.pos++;
        if (c == '\n') {
            this.line++;
            this.col = 1;
        } else {
            this.col++;
        }
        return c;
    }

    private void skipWhitespace() {
        while (this.pos < this.srcLen) {
            // Compare the byte value as an int.  A local char comparison in
            // this hot path was miscompiled by the second self-hosted stage,
            // causing it to consume the first non-whitespace source byte.
            int cCode = this.src[this.pos];
            if (cCode == 32 || cCode == 9 || cCode == 10 || cCode == 13) {
                this.advance();
            } else {
                break;
            }
        }
    }

    private void skipLineComment() {
        while (this.pos < this.srcLen) {
            char c = this.src[this.pos];
            if (c == '\n') { break; }
            this.advance();
        }
    }

    private bool skipBlockComment() {
        int depth = 1;
        while (this.pos < this.srcLen && depth > 0) {
            char c = this.src[this.pos];
            if (c == '/' && this.peekNext() == '*') {
                depth++;
                this.advance();
                this.advance();
            } else if (c == '*' && this.peekNext() == '/') {
                depth--;
                this.advance();
                this.advance();
            } else {
                this.advance();
            }
        }
        return depth == 0;
    }

    public Token[] tokenize() {
        Token[] tokens = [];
        while (true) {
            this.skipWhitespace();
            if (this.pos >= this.srcLen) {
                tokens.add(new Token(0, "", this.line, this.col));
                break;
            }
        Token? tok = this.nextToken();
        if (tok != null) {
            tokens.add(tok);
        }
        }
        return tokens;
    }

    private Token? nextToken() {
        while (this.pos < this.srcLen) {
        char c = this.src[this.pos];
        this.lastChar = c;
        int ln = this.line;
        int cl = this.col;

        if (c == '/' && this.peekNext() != null) {
            char next = this.peekNext();
            if (next == '/') { this.advance(); this.skipLineComment(); return null; }
            if (next == '*') { this.advance(); this.advance(); this.skipBlockComment(); return null; }
        }

        // The token position must point AT the opening quote (EXCEPTIONS
        // value-position rule), so capture it before the quote is consumed.
        if (c == '"') {
            int qLine = ln; int qCol = cl;
            this.advance();
            Token st = this.readStringToken();
            st.line = qLine; st.col = qCol;
            return st;
        }
        if (c == '\'') {
            int qLine2 = ln; int qCol2 = cl;
            this.advance();
            Token ct = this.readChar();
            ct.line = qLine2; ct.col = qCol2;
            return ct;
        }
        if ((c >= '0' && c <= '9')) { this.currentCode = c; return this.readNumber(); }
        if (isAlpha(c) || c == '_') { this.currentCode = c; return this.readIdent(); }

        this.advance();

        if (c == '(') { return new Token(100, "(", ln, cl); }
        if (c == ')') { return new Token(101, ")", ln, cl); }
        if (c == '{') { return new Token(102, "{", ln, cl); }
        if (c == '}') { return new Token(103, "}", ln, cl); }
        if (c == '[') { return new Token(104, "[", ln, cl); }
        if (c == ']') { return new Token(105, "]", ln, cl); }
        if (c == ';') { return new Token(106, ";", ln, cl); }
        if (c == ',') { return new Token(107, ",", ln, cl); }
        if (c == '.') {
            if (this.peek() == '.' && this.peekNext() != null && this.peekNext() == '.') {
                this.advance(); this.advance();
                return new Token(147, "...", ln, cl);
            }
            if (this.peek() == '.') { this.advance(); return new Token(144, "..", ln, cl); }
            return new Token(108, ".", ln, cl);
        }
        if (c == ':') { return new Token(109, ":", ln, cl); }
        if (c == '+') {
            if (this.peek() == '+') { this.advance(); return new Token(142, "++", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(130, "+=", ln, cl); }
            return new Token(111, "+", ln, cl);
        }
        if (c == '-') {
            if (this.peek() == '-') { this.advance(); return new Token(143, "--", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(131, "-=", ln, cl); }
            if (this.peek() == '>') { this.advance(); return new Token(145, "->", ln, cl); }
            return new Token(112, "-", ln, cl);
        }
        if (c == '*') {
            if (this.peek() == '=') { this.advance(); return new Token(132, "*=", ln, cl); }
            return new Token(113, "*", ln, cl);
        }
        if (c == '/') {
            if (this.peek() == '=') { this.advance(); return new Token(133, "/=", ln, cl); }
            return new Token(114, "/", ln, cl);
        }
        if (c == '%') {
            if (this.peek() == '=') { this.advance(); return new Token(157, "%=", ln, cl); }
            return new Token(115, "%", ln, cl);
        }
        if (c == '&') {
            if (this.peek() == '&') { this.advance(); return new Token(138, "&&", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(158, "&=", ln, cl); }
            return new Token(116, "&", ln, cl);
        }
        if (c == '|') {
            if (this.peek() == '|') { this.advance(); return new Token(139, "||", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(159, "|=", ln, cl); }
            return new Token(117, "|", ln, cl);
        }
        if (c == '<') {
            if (this.peek() == '<') {
                this.advance();
                if (this.peek() == '=') { this.advance(); return new Token(161, "<<=", ln, cl); }
                return new Token(140, "<<", ln, cl);
            }
            if (this.peek() == '=') { this.advance(); return new Token(136, "<=", ln, cl); }
            return new Token(120, "<", ln, cl);
        }
        if (c == '>') {
            if (this.peek() == '>') {
                this.advance();
                if (this.peek() == '=') { this.advance(); return new Token(162, ">>=", ln, cl); }
                return new Token(141, ">>", ln, cl);
            }
            if (this.peek() == '=') { this.advance(); return new Token(137, ">=", ln, cl); }
            return new Token(121, ">", ln, cl);
        }
        if (c == '=') {
            if (this.peek() == '=') { this.advance(); return new Token(134, "==", ln, cl); }
            if (this.peek() == '>') { this.advance(); return new Token(146, "=>", ln, cl); }
            return new Token(110, "=", ln, cl);
        }
        if (c == '!') {
            if (this.peek() == '=') { this.advance(); return new Token(135, "!=", ln, cl); }
            return new Token(122, "!", ln, cl);
        }
        if (c == '~') { return new Token(119, "~", ln, cl); }
        if (c == '^') {
            if (this.peek() == '=') { this.advance(); return new Token(160, "^=", ln, cl); }
            return new Token(118, "^", ln, cl);
        }
        if (c == '?') {
            if (this.peek() == '?') { this.advance(); return new Token(148, "??", ln, cl); }
            if (this.peek() == '.') { this.advance(); return new Token(163, "?.", ln, cl); }
            return new Token(123, "?", ln, cl);
        }
        if (c == '#') { return new Token(125, "#", ln, cl); }
        if (c == '$') { return new Token(149, "$", ln, cl); }
        if (c == '@') { return new Token(156, "@", ln, cl); }

        }
        return null;
    }

    private Token readStringToken() {
        int ln = this.line; int cl = this.col;
        string s = "";
        bool closed = false;
        while (this.pos < this.srcLen) {
            char ch = this.src[this.pos]; this.advance();
            if (ch == '"') { closed = true; break; }
            if (ch == '\\') {
                if (this.pos < this.srcLen) {
                    char esc = this.src[this.pos]; this.advance();
                    if (esc == 'n') { s += "\n"; }
                    else if (esc == 't') { s += "\t"; }
                    else if (esc == '0') { s += "\0"; }
                    else if (esc == 'r') { s += "\r"; }
                    else if (esc == '\\') { s += "\\"; }
                    else if (esc == '\"') { s += "\""; }
                    else if (esc == 'x') {
                        // Hex escape \xHH: decode 1-2 hex digits into a raw
                        // byte (ANSI codes like \x1B are the primary use).
                        int hv = 0;
                        int nd = 0;
                        while (nd < 2 && this.pos < this.srcLen) {
                            char hc = this.src[this.pos];
                            int dv = -1;
                            if (hc >= '0' && hc <= '9') { dv = hc - '0'; }
                            else if (hc >= 'a' && hc <= 'f') { dv = hc - 'a' + 10; }
                            else if (hc >= 'A' && hc <= 'F') { dv = hc - 'A' + 10; }
                            if (dv < 0) { break; }
                            this.advance();
                            hv = hv * 16 + dv;
                            nd++;
                        }
                        if (nd > 0) {
                            char xc = hv;
                            s += charToString(xc);
                        } else {
                            s += "\\x";
                        }
                    }
                    else { s += "\\" + esc; }
                }
            } else {
                s += charToString(ch);
            }
        }
        // SYNTAX_EXCEPTIONS.md — an unterminated literal reports the opening
        // line with the column of its last character.
        if (!closed) {
            int endCol = this.lineCharLen(ln);
            if (endCol <= 0) { endCol = cl; }
            this.recordLexError("you forgot to close your string quotes at line " + ln.toString() + ", column " + endCol.toString());
        }
        Token tok = new Token(3, s, ln, cl);
        tok.strVal = s;
        return tok;
    }

    private Token readChar() {
        int ln = this.line; int cl = this.col;
        char ch = ' ';
        if (this.pos < this.srcLen) {
            ch = this.src[this.pos]; this.advance();
            if (ch == '\\' && this.pos < this.srcLen) {
                char esc = this.src[this.pos]; this.advance();
                if (esc == 'n') { ch = '\n'; }
                else if (esc == 't') { ch = '\t'; }
                else if (esc == '0') { ch = '\0'; }
                else if (esc == 'r') { ch = '\r'; }
                else if (esc == '\\') { ch = '\\'; }
                else if (esc == '\'') { ch = '\''; }
                else if (esc == 'x') {
                    // Hex escape \xHH (e.g. '\x1B').
                    int hv = 0;
                    int nd = 0;
                    while (nd < 2 && this.pos < this.srcLen) {
                        char hc = this.src[this.pos];
                        int dv = -1;
                        if (hc >= '0' && hc <= '9') { dv = hc - '0'; }
                        else if (hc >= 'a' && hc <= 'f') { dv = hc - 'a' + 10; }
                        else if (hc >= 'A' && hc <= 'F') { dv = hc - 'A' + 10; }
                        if (dv < 0) { break; }
                        this.advance();
                        hv = hv * 16 + dv;
                        nd++;
                    }
                    if (nd > 0) { ch = hv; } else { ch = esc; }
                }
                else { ch = esc; }
            } else if (ch == '\r' && this.pos < this.srcLen && this.src[this.pos] == '\n') {
                // A literal CRLF inside the quotes (CRLF-saved sources) means
                // the char is the newline: the Rust frontend normalizes
                // CRLF to LF before lexing, so a real newline between the
                // quotes must read as newline here.
                this.advance();
                ch = '\n';
            }
        }
        if (this.pos < this.srcLen && this.src[this.pos] == '\'') {
            this.advance();
        }
        string charText = "";
        charText += ch;
        Token tok = new Token(4, charText, ln, cl);
        tok.charVal = ch;
        return tok;
    }

    private Token readNumber() {
        int ln = this.line; int cl = this.col;
        int firstCode = this.currentCode;
        this.advance();
        string s = "";
        if (firstCode == 48) { s += "0"; }
        else if (firstCode == 49) { s += "1"; }
        else if (firstCode == 50) { s += "2"; }
        else if (firstCode == 51) { s += "3"; }
        else if (firstCode == 52) { s += "4"; }
        else if (firstCode == 53) { s += "5"; }
        else if (firstCode == 54) { s += "6"; }
        else if (firstCode == 55) { s += "7"; }
        else if (firstCode == 56) { s += "8"; }
        else if (firstCode == 57) { s += "9"; }
        bool isFloat = false;
        int base = 10;
        if (firstCode == 48 && this.pos < this.srcLen) {
            char next = this.src[this.pos];
            if (next == 'x' || next == 'X') {
                this.advance();
                base = 16;
                s = "";
            } else if (next == 'b' || next == 'B') {
                this.advance();
                base = 2;
                s = "";
            }
        }
        while (this.pos < this.srcLen) {
            char ch = this.src[this.pos];
            if (base == 2) {
                if (ch == '0' || ch == '1' || ch == '_') {
                    s += ch; this.advance();
                } else {
                    break;
                }
            } else if ((ch >= '0' && ch <= '9') || ch == '_') {
                s += ch; this.advance();
            } else if (base == 16 && ((ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F'))) {
                s += ch; this.advance();
            } else if (ch == '.' && !isFloat) {
                if (this.peekNext() == '.' || this.peekNext() == null) { break; }
                isFloat = true; s += "."; this.advance();
            } else if (ch == 'e' || ch == 'E') {
                isFloat = true; s += ch; this.advance();
if (this.pos < this.srcLen) {
                char sign = this.src[this.pos];
                if (sign == '+' || sign == '-') {
                    s += sign; this.advance();
                }
            }
            } else { break; }
        }
        Token tok = new Token(1, s, ln, cl);
        if (isFloat) {
            tok.intVal = this.parseFloatBits(s);
        } else {
            // Parse the digit string manually.  The toInt64 / toInt64FromBase
            // builtin methods are not dispatched by every backend, so compute
            // the value directly with arithmetic that all stages support.
            int64 val = 0;
            for (int i = 0; i < s.length; i++) {
                char ch = s[i];
                int d = -1;
                if (ch >= '0' && ch <= '9') { d = ch - '0'; }
                else if (base == 16 && ch >= 'a' && ch <= 'f') { d = ch - 'a' + 10; }
                else if (base == 16 && ch >= 'A' && ch <= 'F') { d = ch - 'A' + 10; }
                if (d >= 0) { val = val * base + d; }
            }
            tok.intVal = val;
        }
        return tok;
    }

    // Convert a decimal float literal text ("3.14", "1e5", "-2.5e-3") into the
    // IEEE-754 double bit pattern, computed with integer arithmetic only (the
    // self-hosted backend has no SSE float ops).  The value is stored as
    // num/denom and converted to binary via long division.
    private int64 parseFloatBits(string s) {
        int len = s.length;
        int p = 0;
        int64 signBits = 0;
        int sc = s[p];
        if (sc == 45) { signBits = 0x8000000000000000; p++; }
        else if (sc == 43) { p++; }
        int64 intPart = 0;
        while (p < len) {
            int dc = s[p];
            if (dc >= 48 && dc <= 57) { intPart = intPart * 10 + (dc - 48); p++; }
            else { break; }
        }
        int64 fracPart = 0;
        int fracLen = 0;
        if (p < len && s[p] == 46) {
            p++;
            while (p < len) {
                int fc = s[p];
                if (fc >= 48 && fc <= 57) { fracPart = fracPart * 10 + (fc - 48); fracLen++; p++; }
                else { break; }
            }
        }
        int64 exp = 0;
        if (p < len && (s[p] == 101 || s[p] == 69)) {
            p++;
            int64 esign = 1;
            if (p < len && s[p] == 45) { esign = -1; p++; }
            else if (p < len && s[p] == 43) { p++; }
            while (p < len) {
                int ec = s[p];
                if (ec >= 48 && ec <= 57) { exp = exp * 10 + (ec - 48); p++; }
                else { break; }
            }
            exp = exp * esign;
        }
        int64 denom = 1;
        for (int i = 0; i < fracLen; i++) { denom = denom * 10; }
        int64 num = intPart * denom + fracPart;
        if (num == 0) { return signBits; }
        if (exp > 0) {
            for (int i = 0; i < exp && num < 0x0CCCCCCCCCCCCCCC; i++) { num = num * 10; }
        } else if (exp < 0) {
            int64 neg = -exp;
            for (int i = 0; i < neg && denom < 0x0CCCCCCCCCCCCCCC; i++) { denom = denom * 10; }
        }
        // Integer part (may be zero) and remainder; find the binary exponent.
        int64 ip = num / denom;
        int64 rem = num % denom;
        int64 expo = 0;
        if (ip > 0) {
            int64 t = ip;
            expo = 0;
            while (t >= 2) { t = t / 2; expo++; }
        } else {
            // Pure fraction: scale the remainder until its leading bit lands
            // at 2^expo.  Each doubling moves one binary place down.
            int64 guard = 0;
            while (rem > 0 && rem < denom && guard < 1200) {
                rem = rem * 2;
                expo--;
                guard++;
            }
            if (rem == 0) { return signBits; }
            rem -= denom;
            ip = 1;
        }
        // Build the 52-bit fraction after the leading 1.
        int64 frac = 0;
        int have = 0;
        if (ip > 1) {
            // Fraction bits already present in the integer part (below the
            // leading bit).  Shift them out, most-significant first.
            int64 hi = 1;
            int64 t2 = ip;
            while (t2 >= 2) { t2 = t2 / 2; hi = hi * 2; }
            int64 mask = hi / 2;
            while (mask > 0) {
                if (have >= 52) { break; }
                if ((ip & mask) != 0) { frac = frac * 2 + 1; }
                else { frac = frac * 2; }
                have++;
                mask = mask / 2;
            }
        }
        // Remaining fraction bits from the remainder via long division.
        int64 fr = rem;
        while (have < 52 && fr > 0) {
            fr = fr * 2;
            if (fr >= denom) {
                frac = frac * 2 + 1;
                fr -= denom;
            } else {
                frac = frac * 2;
            }
            have++;
        }
        while (have < 52) { frac = frac * 2; have++; }
        // Round-to-nearest on the 53rd bit; if it carries past 2^52, bump the
        // exponent (the fraction becomes zero).
        if (ip > 0) {
            int64 extra = 0;
            if (fr > 0) {
                fr = fr * 2;
                if (fr >= denom) { extra = 1; }
            }
            if (extra == 1) {
                frac++;
                if (frac >= 0x0010000000000000) {
                    frac = 0;
                    expo++;
                }
            }
        }
        int64 biased = expo + 1023;
        if (biased <= 0) { return signBits; }
        if (biased >= 2047) { return signBits | 0x7FF0000000000000; }
        return signBits | (biased << 52) | frac;
    }

    private Token readIdent() {
        int ln = this.line; int cl = this.col;
        int firstCode = this.currentCode;
        this.advance();
        string s = "";
        if (firstCode == 97) { s += "a"; }
        else if (firstCode == 98) { s += "b"; }
        else if (firstCode == 99) { s += "c"; }
        else if (firstCode == 100) { s += "d"; }
        else if (firstCode == 101) { s += "e"; }
        else if (firstCode == 102) { s += "f"; }
        else if (firstCode == 103) { s += "g"; }
        else if (firstCode == 104) { s += "h"; }
        else if (firstCode == 105) { s += "i"; }
        else if (firstCode == 106) { s += "j"; }
        else if (firstCode == 107) { s += "k"; }
        else if (firstCode == 108) { s += "l"; }
        else if (firstCode == 109) { s += "m"; }
        else if (firstCode == 110) { s += "n"; }
        else if (firstCode == 111) { s += "o"; }
        else if (firstCode == 112) { s += "p"; }
        else if (firstCode == 113) { s += "q"; }
        else if (firstCode == 114) { s += "r"; }
        else if (firstCode == 115) { s += "s"; }
        else if (firstCode == 116) { s += "t"; }
        else if (firstCode == 117) { s += "u"; }
        else if (firstCode == 118) { s += "v"; }
        else if (firstCode == 119) { s += "w"; }
        else if (firstCode == 120) { s += "x"; }
        else if (firstCode == 121) { s += "y"; }
        else if (firstCode == 122) { s += "z"; }
        else if (firstCode == 65) { s += "A"; }
        else if (firstCode == 66) { s += "B"; }
        else if (firstCode == 67) { s += "C"; }
        else if (firstCode == 68) { s += "D"; }
        else if (firstCode == 69) { s += "E"; }
        else if (firstCode == 70) { s += "F"; }
        else if (firstCode == 71) { s += "G"; }
        else if (firstCode == 72) { s += "H"; }
        else if (firstCode == 73) { s += "I"; }
        else if (firstCode == 74) { s += "J"; }
        else if (firstCode == 75) { s += "K"; }
        else if (firstCode == 76) { s += "L"; }
        else if (firstCode == 77) { s += "M"; }
        else if (firstCode == 78) { s += "N"; }
        else if (firstCode == 79) { s += "O"; }
        else if (firstCode == 80) { s += "P"; }
        else if (firstCode == 81) { s += "Q"; }
        else if (firstCode == 82) { s += "R"; }
        else if (firstCode == 83) { s += "S"; }
        else if (firstCode == 84) { s += "T"; }
        else if (firstCode == 85) { s += "U"; }
        else if (firstCode == 86) { s += "V"; }
        else if (firstCode == 87) { s += "W"; }
        else if (firstCode == 88) { s += "X"; }
        else if (firstCode == 89) { s += "Y"; }
        else if (firstCode == 90) { s += "Z"; }
        else if (firstCode == 95) { s += "_"; }
        while (this.pos < this.srcLen) {
            char ch = this.src[this.pos];
            if (isAlphaNum(ch) || ch == '_') {
                s += ch; this.advance();
            } else { break; }
        }
        int kind = this.keywordKind(s);
        Token tok = new Token(kind, s, ln, cl);
        if (kind == 7) { tok.strVal = s; }
        return tok;
    }

    private int keywordKind(string s) {
        if (s == "if") { return 10; }
        if (s == "else") { return 11; }
        if (s == "while") { return 12; }
        if (s == "for") { return 13; }
        if (s == "foreach") { return 14; }
        if (s == "return") { return 15; }
        if (s == "match") { return 16; }
        if (s == "void") { return 17; }
        if (s == "int") { return 18; }
        if (s == "int32") { return 19; }
        if (s == "int64") { return 20; }
        if (s == "float") { return 22; }
        if (s == "float64") { return 23; }
        if (s == "bool") { return 25; }
        if (s == "char") { return 26; }
        if (s == "string") { return 27; }
        if (s == "var") { return 28; }
        if (s == "struct") { return 29; }
        if (s == "class") { return 30; }
        if (s == "enum") { return 31; }
        if (s == "def") { return 32; }
        if (s == "new") { return 39; }
        if (s == "const") { return 40; }
        if (s == "true") { return 5; }
        if (s == "false") { return 5; }
        if (s == "null") { return 6; }
        if (s == "import") { return 36; }
        if (s == "from") { return 37; }
        if (s == "as") { return 38; }
        if (s == "typealias") { return 165; }
        if (s == "loop") { return 166; }
        if (s == "mod") { return 35; }
        if (s == "mut") { return 50; }
        if (s == "public") { return 44; }
        if (s == "private") { return 45; }
        if (s == "protected") { return 164; }
        if (s == "static") { return 46; }
        if (s == "prop") { return 47; }
        if (s == "construct") { return 48; }
        if (s == "unset") { return 49; }
        if (s == "local") { return 150; }
        if (s == "alias") { return 151; }
        if (s == "fixed") { return 152; }
        if (s == "live") { return 153; }
        if (s == "once") { return 154; }
        if (s == "shared") { return 155; }
        if (s == "try") { return 52; }
        if (s == "catch") { return 53; }
        if (s == "finally") { return 65; }
        if (s == "throw") { return 64; }
        if (s == "found") { return 33; }
        if (s == "collect") { return 34; }
        if (s == "ref") { return 51; }
        if (s == "in") { return 54; }
        if (s == "to") { return 55; }
        if (s == "elif") { return 56; }
        if (s == "break") { return 57; }
        if (s == "continue") { return 58; }
        if (s == "export") { return 59; }
        if (s == "extends") { return 60; }
        if (s == "internal") { return 167; }
        return 7;
    }
}
