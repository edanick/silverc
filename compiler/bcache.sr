    if (k == 102) { return 68; }
    if (k == 103) { return 69; }
    if (k == 104) { return 70; }
    if (k == 105) { return 71; }
    if (k == 106) { return 72; }
    if (k == 107) { return 73; }
    if (k == 108) { return 74; }
    if (k == 109) { return 75; }
    if (k == 110) { return 76; }
    if (k == 111) { return 77; }
    if (k == 112) { return 78; }
    if (k == 113) { return 79; }
    if (k == 114) { return 80; }
    if (k == 115) { return 81; }
    if (k == 116) { return 82; }
    if (k == 117) { return 83; }
    if (k == 118) { return 84; }
    if (k == 119) { return 85; }
    if (k == 120) { return 86; }
    if (k == 121) { return 87; }
    if (k == 122) { return 88; }
    if (k == 123) { return 89; }
    if (k == 125) { return 93; }
    if (k == 130) { return 95; }
