mod export bcache;

import * from win32.kernel32;
import * from win32.msvcrt;
import * from token;
import * from lexer;

// OVERHAUL.md --cache-bytecode — persistent bytecode cache.
//
// Cache layout under %APPDATA%\silver cache\<project>\:
//
//   project.sbcr            record file (one entry per .sr file, recursive)
//   src/main.srbc           cached token stream mirroring the source tree
//
// Both artifacts are written in the reference binary formats so caches stay
// toolchain-compatible:
//
// **.sbcr (Silver ByteCode Record) v1** — little-endian:
//   magic "SBCR" | u16 version=1 | u64 created (ms since epoch)
//   u32 name_len + UTF-8 project name
//   u32 entry_count
//   per entry: u32 rel_path_len + UTF-8 '/'-separated path,
//              u64 creation_millis u64 modified_millis
//              u64 fnv1_hash       u64 last_cached_millis
//
// **.srbc (Silver ByteCode) v1** — the linear token stream of one file:
//   magic "SRBC" | u16 version=1
//   u64 fnv1_hash   u64 last_cached_millis
//   u32 token_count
//   per token: u16 kind_tag, payload, u32 line, u32 col
//
// Tag space: 0..119 unit kinds in reference declaration order, 200+ payload
// kinds (200 int literal i64 LE, 201 float literal f64 bits, 202 string
// u32len+bytes, 203 char u32 codepoint, 204 identifier, 205 annotation,
// 206 EOF).
//
// Because the compiled Silver runtime cannot re-read NUL-containing binaries
// safely (strings are strlen-based and managed arrays are not byte-dense),
// each binary artifact has a NUL-free text companion ("*.sbcri"/"*.srbc.t")
// that carries the same information. The companions are the authoritative
// read side; the binaries are written byte-exactly for other toolchains.
//
// Workflow: compare current files against the records; re-cache only files
// whose FNV-1 hash / size changed; compile from the refreshed cache.

class CacheSession {
    public prop bool ok;
    public prop string dir;
    public prop string root;
    public prop string projectName;
    // Parallel record arrays keyed by '/'-separated relative path.
    public prop string[] keys;
    public prop string[] cTimesStr;
    public prop string[] mTimesStr;
    public prop string[] hashesStr;
    public prop string[] cachedAtStr;
    public prop int64 createdStamp;
    // Record file contents at open time ("" on a fresh cache); flush skips
    // all writes when nothing changed.
    public prop string oldIndexText;
    // Files whose .srbc was rewritten this run.
    public prop int dirtyCount;

    construct (string rootDir, string projName) {
        this.ok = false;
        this.dir = "";
        this.root = rootDir;
        this.projectName = projName;
        this.keys = [];
        this.cTimesStr = [];
        this.mTimesStr = [];
        this.hashesStr = [];
        this.cachedAtStr = [];
        this.createdStamp = 0;
        this.oldIndexText = "";
        this.dirtyCount = 0;
        string appdata = bcEnvValue("APPDATA");
        if (appdata.length == 0) { return; }
        this.dir = appdata + "\\silver cache\\" + bcSanitize(projName);
        ensureDirTree(this.dir);
        this.loadRecords();
        this.ok = true;
    }

    private bool eqStr(string a, string b) {
        if (a.length != b.length) { return false; }
        for (int i = 0; i < a.length; i++) {
            if (a[i] != b[i]) { return false; }
        }
        return true;
    }

    private string keyOf(int i) {
        string sep = "|";
        return this.keys[i] + sep + this.cTimesStr[i] + sep + this.mTimesStr[i]
            + sep + this.hashesStr[i] + sep + this.cachedAtStr[i];
    }

    // ------------------------------------------------------------------
    // Public API
    // ------------------------------------------------------------------

    // Return cached tokens for the source range [start, end) of aggSource
    // when its contents are unchanged and the stored bytecode decodes;
    // otherwise materialize the body (hop file first, char-copy fallback),
    // lex it fresh, store the new bytecode, and return those tokens. Range
    // hashing means full-project cache hits never slice the aggregate at
    // all — the O(bodyLen^2) slice is paid only per actual miss.
    public Token[] tokensForRange(string absPath, string aggSource, int start, int end, string hopPath) {
        if (!this.ok) { return bcLex(bcSliceSlow(aggSource, start, end)); }
        string key = this.relKey(absPath);
        if (key.length == 0) { return bcLex(bcSliceSlow(aggSource, start, end)); }
        int64 hash = bcFnv1Range(aggSource, start, end);
        int size = bcFileSize(absPath);
        string hashKey = bcIntToStr(hash);
        string sizeKey = size.toString();
        int idx = this.indexOfKey(key);
        if (idx >= 0) {
            if (this.eqStr(this.hashesStr[idx], hashKey) && this.eqStr(this.mTimesStr[idx], sizeKey)) {
                Token[] cached = this.loadSrbcText(absPath);
                if (cached.length > 0) {
                    return cached;
                }
            }
        }
        // Re-cache this file: materialize the body, lex, encode, mark dirty.
        string body = "";
        if (hopPath.length > 0) { body = bcSliceViaFile(hopPath, start, end - start); }
        if (body.length == 0) { body = bcSliceSlow(aggSource, start, end); }
        Token[] tokens = bcLex(body);
        int stamp = bcNowMillis();
        if (this.encodable(tokens)) {
            this.storeSrbc(absPath, tokens, stamp, hashKey, sizeKey);
            string created = stamp.toString();
            if (idx >= 0) {
                created = this.cTimesStr[idx];
                this.mTimesStr[idx] = sizeKey;
                this.hashesStr[idx] = hashKey;
                this.cachedAtStr[idx] = stamp.toString();
            } else {
                this.keys.add(key);
                this.cTimesStr.add(created);
                this.mTimesStr.add(sizeKey);
                this.hashesStr.add(hashKey);
                this.cachedAtStr.add(stamp.toString());
            }
            this.dirtyCount++;
        }
        return tokens;
    }

    // Whole-string variant kept for direct callers with an in-memory file.
    public Token[] tokensFor(string absPath, string source) {
        return this.tokensForRange(absPath, source, 0, source.length, "");
    }

    // Drop records whose sources vanished and rewrite the record files once
    // after the whole import graph is resolved. Skips the rewrite when
    // nothing changed (no-change reruns leave every artifact untouched).
    public void flush() {
        if (!this.ok) { return; }
        int w = 0;
        for (int i = 0; i < this.keys.length; i++) {
            string abs = resolveRel(this.root, this.keys[i]);
            if (file.exists(abs)) {
                this.keys[w] = this.keys[i];
                this.cTimesStr[w] = this.cTimesStr[i];
                this.mTimesStr[w] = this.mTimesStr[i];
                this.hashesStr[w] = this.hashesStr[i];
                this.cachedAtStr[w] = this.cachedAtStr[i];
                w++;
            } else {
                string srbcPath = this.srbcPathFor(this.keys[i]);
                if (srbcPath.length > 0 && file.exists(srbcPath)) {
                    file.delete(srbcPath);
                    file.delete(srbcPath + ".t");
                }
            }
        }
        while (this.keys.length > w) { this.keys.pop(); }
        while (this.cTimesStr.length > w) { this.cTimesStr.pop(); }
        while (this.mTimesStr.length > w) { this.mTimesStr.pop(); }
        while (this.hashesStr.length > w) { this.hashesStr.pop(); }
        while (this.cachedAtStr.length > w) { this.cachedAtStr.pop(); }

        this.sortRecords();

        // Linear index build: one small string per line, joined once
        // (per-line concatenation was quadratic in the record count).
        string[] idxParts = [];
        idxParts.add("created " + bcIntToStr(this.createdStamp) + "\n");
        idxParts.add("name " + this.projectName + "\n");
        for (int r = 0; r < this.keys.length; r++) {
            idxParts.add("f " + this.keyOf(r) + "\n");
        }
        string indexText = idxParts.join("");
        if (this.eqStr(indexText, this.oldIndexText)) { return; }

        ensureDirTree(this.dir);
        file.writeString(this.dir + "\\project.sbcri", indexText);

        // Reference-format binary record (little-endian, see module docs),
        // streamed in bounded chunks like the .srbc artifacts.
        BcBinWriter bw = new BcBinWriter(this.dir + "\\project.sbcr");
        if (bw.ok()) {
            bw.b8(83);
            bw.b8(66);
            bw.b8(67);
            bw.b8(82);
            bw.b16(1);
            bw.b64(this.createdStamp);
            string pn = this.projectName;
            bw.b32(pn.length);
            for (int ni = 0; ni < pn.length; ni++) {
                bw.b8(pn[ni] & 0xFF);
            }
            bw.b32(this.keys.length);
            for (int rb = 0; rb < this.keys.length; rb++) {
                string kp = this.keys[rb];
                bw.b32(kp.length);
                for (int pi = 0; pi < kp.length; pi++) {
                    bw.b8(kp[pi] & 0xFF);
                }
                bw.b64(decToI64(this.cTimesStr[rb]));
                bw.b64(decToI64(this.mTimesStr[rb]));
                bw.b64(decToI64(this.hashesStr[rb]));
                bw.b64(decToI64(this.cachedAtStr[rb]));
            }
        }
        bw.close();
    }

    public int statsTotal() {
        return this.keys.length;
    }

    public int statsDirty() {
        return this.dirtyCount;
    }

    // ------------------------------------------------------------------
    // Record loading (text index is authoritative)
    // ------------------------------------------------------------------

    private void loadRecords() {
        string text = tryReadText(this.dir + "\\project.sbcri");
        if (text.length == 0) { return; }
        this.oldIndexText = text;
        int pos = 0;
        while (pos < text.length) {
            int eol = pos;
            while (eol < text.length && text[eol] != '\n') { eol++; }
            string line = sliceRange(text, pos, eol);
            pos = eol + 1;
            if (startsWith(line, "created ")) {
                this.createdStamp = decToI64(sliceRange(line, 8, line.length));
            } elif (startsWith(line, "f ")) {
                // f <key> <created> <modified-token> <hash> <cachedAt>
                // (fields joined with the unit separator so paths containing
                // spaces survive the round trip)
                string rest = sliceRange(line, 2, line.length);
                string f1 = wordAtSep(rest, 0, '|');
                string f2 = wordAtSep(rest, 1, '|');
                string f3 = wordAtSep(rest, 2, '|');
                string f4 = wordAtSep(rest, 3, '|');
                string f5 = wordAtSep(rest, 4, '|');
                if (f5.length > 0) {
                    this.keys.add(f1);
                    this.cTimesStr.add(f2);
                    this.mTimesStr.add(f3);
                    this.hashesStr.add(f4);
                    this.cachedAtStr.add(f5);
                }
            }
        }
    }

    private int indexOfKey(string key) {
        for (int i = 0; i < this.keys.length; i++) {
            if (this.eqStr(this.keys[i], key)) { return i; }
        }
        return -1;
    }

    // Deterministic record order: sorted by relative path (matches the
    // reference serializer).
    private void sortRecords() {
        int n = this.keys.length;
        for (int i = 1; i < n; i++) {
            string k = this.keys[i];
            string c = this.cTimesStr[i];
            string m = this.mTimesStr[i];
            string h = this.hashesStr[i];
            string lc = this.cachedAtStr[i];
            int j = i - 1;
            while (j >= 0 && bcKeyLess(k, this.keys[j])) {
                this.keys[j + 1] = this.keys[j];
                this.cTimesStr[j + 1] = this.cTimesStr[j];
                this.mTimesStr[j + 1] = this.mTimesStr[j];
                this.hashesStr[j + 1] = this.hashesStr[j];
                this.cachedAtStr[j + 1] = this.cachedAtStr[j];
                j--;
            }
            this.keys[j + 1] = k;
            this.cTimesStr[j + 1] = c;
            this.mTimesStr[j + 1] = m;
            this.hashesStr[j + 1] = h;
            this.cachedAtStr[j + 1] = lc;
        }
    }

    // ------------------------------------------------------------------
    // Bytecode storage
    // ------------------------------------------------------------------

    private string srbcPathFor(string keyOrAbs) {
        string rel = this.relKey(keyOrAbs);
        if (rel.length == 0) { return ""; }
        string dotted = rel;
        if (dotted.length >= 3 && dotted[dotted.length - 1] == 'r'
            && dotted[dotted.length - 2] == 's' && dotted[dotted.length - 3] == '.') {
            dotted = sliceRange(dotted, 0, dotted.length - 3);
        }
        return this.dir + "\\" + bcReplaceAll(dotted, "/", "\\") + ".srbc";
    }

    private void storeSrbc(string absPath, Token[] tokens, int stamp, string hashKey, string sizeKey) {
        string path = this.srbcPathFor(absPath);
        if (path.length == 0) { return; }
        ensureDirTree(bcDirname(path));

        // Reference-format binary stream (see module docs), flushed in
        // bounded chunks straight to disk — never materialized as one
        // string or one whole-file array. Float literals carry all-zero
        // bits: the self-hosted front end materializes float literals as
        // 0.0 today.
        BcBinWriter bw = new BcBinWriter(path);
        if (bw.ok()) {
            bw.b8(83);
            bw.b8(82);
            bw.b8(66);
            bw.b8(67);
            bw.b16(1);
            bw.b64(decToI64(hashKey));
            int64 sv = stamp;
            bw.b64(sv);
            bw.b32(tokens.length);
            for (int ib = 0; ib < tokens.length; ib++) {
                Token tb = tokens[ib];
                int tag = tagOf(tb);
                bw.b16(tag);
                if (tag == 200) {
                    bw.b64(tb.intVal);
                } elif (tag == 201) {
                    bw.b64(0);
                } elif (tag == 203) {
                    int ccv = tb.charVal;
                    bw.b32(ccv);
                } elif (tag == 202 || tag == 204 || tag == 205) {
                    string sv2 = tb.strVal;
                    bw.b32(sv2.length);
                    for (int si3 = 0; si3 < sv2.length; si3++) {
                        bw.b8(sv2[si3] & 0xFF);
                    }
                }
                bw.b32(tb.line);
                bw.b32(tb.col);
            }
        }
        bw.close();

        // NUL-free text companion (authoritative read side), streamed the
        // same way; hex payloads spill in bounded windows so no line is
        // ever built with per-char concatenation.
        BcTextWriter tw = new BcTextWriter(path + ".t");
        if (tw.ok()) {
            tw.put(hashKey);
            tw.put(" ");
            tw.put(stamp.toString());
            tw.put(" ");
            tw.put(tokens.length.toString());
            tw.put("\n");
            for (int i = 0; i < tokens.length; i++) {
                this.writeTokenLine(tw, tokens[i]);
            }
        }
        tw.close();
    }

    // One token as one companion line: <tag> <line> <col> <payload>
    // (payload "-" for unit tags, decimal for int/char, "<byteLen>:<hex>"
    // for string payloads). Identical bytes to the previous one-shot
    // tokenLine(); emitted piecewise into the streaming writer.
    private void writeTokenLine(BcTextWriter t, Token tok) {
        int tag = tagOf(tok);
        t.put(tag.toString());
        t.put(" ");
        t.put(tok.line.toString());
        t.put(" ");
        t.put(tok.col.toString());
        if (tag == 200) {
            t.put(" ");
            t.put(bcIntToStr(tok.intVal));
            t.put("\n");
            return;
        }
        if (tag == 201) {
            t.put(" 0\n");
            return;
        }
        if (tag == 203) {
            int cvEnc = tok.charVal;
            t.put(" ");
            t.put(cvEnc.toString());
            t.put("\n");
            return;
        }
        if (tag == 202 || tag == 204 || tag == 205) {
            t.put(" ");
            string s = tok.strVal;
            t.put(s.length.toString());
            t.put(":");
            string hex = "";
            for (int i = 0; i < s.length; i++) {
                hex = hex + bcHexDigits(s[i] & 0xFF);
                if (hex.length >= 64) {
                    t.put(hex);
                    hex = "";
                }
            }
            t.put(hex);
            t.put("\n");
            return;
        }
        t.put(" -\n");
    }

    private Token[] loadSrbcText(string absPath) {
        string path = this.srbcPathFor(absPath);
        if (path.length == 0) { return []; }
        string text = tryReadText(path + ".t");
        if (text.length == 0) { return []; }
        // Header line: <hash> <stamp> <count> — parsed in place, no slices.
        int he = 0;
        while (he < text.length && text[he] != '\n') { he++; }
        int hp = 0;
        int fieldsSeen = 0;
        while (hp < he && fieldsSeen < 2) {
            if (text[hp] == ' ') { fieldsSeen++; }
            hp++;
        }
        int count = bcUintRange(text, hp, he);
        if (count <= 0) { return []; }
        int pos = he + 1;
        Token[] tokens = [];
        for (int i = 0; i < count && pos < text.length; i++) {
            int le = pos;
            while (le < text.length && text[le] != '\n') { le++; }
            Token t = tokenFromRange(text, pos, le);
            pos = le + 1;
            if (t == null) { return []; }
            tokens.add(t);
        }
        if (tokens.length != count) { return []; }
        return tokens;
    }

    // True when every token maps onto the reference tag space. Files using
    // syntax without a reference spelling simply never cache (the aggregate
    // still compiles from the fresh lex).
    private bool encodable(Token[] tokens) {
        for (int i = 0; i < tokens.length; i++) {
            if (tagOf(tokens[i]) < 0) { return false; }
        }
        return true;
    }

    // ------------------------------------------------------------------
    // Paths
    // ------------------------------------------------------------------

    private string relKey(string absPath) {
        string norm = bcNormalizeSlashes(absPath);
        string rootNorm = bcNormalizeSlashes(this.root);
        if (rootNorm.length > 0 && norm.length > rootNorm.length + 1) {
            bool prefix = true;
            for (int i = 0; i < rootNorm.length; i++) {
                if (norm[i] != rootNorm[i]) { prefix = false; break; }
            }
            if (prefix && norm[rootNorm.length] == '/') {
                return sliceRange(norm, rootNorm.length + 1, norm.length);
            }
        }
        return norm;
    }
}

// ---------------------------------------------------------------------------
// Streaming writers (memory bounds for --cache-bytecode).
//
// String concatenation allocates a fresh buffer on every `+` and the
// runtime never frees the old one, so accumulating a whole artifact with
// `s = s + piece` is quadratic in both time and peak memory. These sinks
// keep only a bounded chunk resident and push bytes to disk with direct
// kernel32 writes:
//
//   BcBinWriter  — .srbc/.sbcr bytes: a bounded int[] chunk staged through
//                  a scratch file (file.writeBytes) and appended to the
//                  artifact with a direct WriteFile of the exact byte
//                  count. The full stream never exists as one string or
//                  one whole-file array.
//   BcTextWriter — NUL-free text (.srbc.t / project.sbcri): a preallocated
//                  writable string buffer appended in place with lstrcatA
//                  and flushed with WriteFile, reset in place with
//                  lstrcpyA("") — the same buffer mechanism bcEnvValue
//                  relies on, so no per-piece allocation at all.
// ---------------------------------------------------------------------------

class BcBinWriter {
    public prop string path;
    public prop int handle;
    public prop int[] buf;
    public prop string scratch;
    public prop int failed;

    construct (string outPath) {
        this.path = outPath;
        this.buf = [];
        this.failed = 0;
        this.scratch = outPath + ".part";
        ensureDirTree(bcDirname(outPath));
        // CREATE_ALWAYS: every artifact is rewritten whole on change.
        this.handle = CreateFileA(outPath, 0x40000000, 0, null, 2, 0x80, 0);
        if (this.handle == -1 || this.handle == 0) {
            this.handle = 0;
            this.failed = 1;
        }
    }

    public bool ok() {
        return this.failed == 0;
    }

    public void b8(int64 v) {
        this.buf.add(v & 0xFF);
        if (this.buf.length >= 8192) { this.flush(); }
    }

    public void b16(int64 v) {
        this.b8(v);
        this.b8(v >> 8);
    }

    public void b32(int64 v) {
        for (int i = 0; i < 4; i++) { this.b8((v >> (i * 8)) & 0xFF); }
    }

    public void b64(int64 v) {
        for (int i = 0; i < 8; i++) { this.b8((v >> (i * 8)) & 0xFF); }
    }

    public void flush() {
        int n = this.buf.length;
        if (n > 0 && this.failed == 0) {
            // Chunk staging through a scratch file keeps this portable
            // across bootstrap stages: file.writeBytes compacts the array's
            // low bytes in place on the self-hosted backend but copies to a
            // separate heap buffer on the Rust bootstrap, so the array
            // itself must never be handed to WriteFile. The round trip
            // (write dense bytes, read them back into a heap buffer, append
            // with an explicit byte count) is byte-exact on both, NULs
            // included — the carrier's strlen-based .length is never
            // consulted.
            file.writeBytes(this.scratch, this.buf);
            if (bcFileSize(this.scratch) == n) {
                string carrier = file.readString(this.scratch);
                int w = 0;
                WriteFile(this.handle, carrier, n, &w, null);
            } else {
                this.failed = 1;
            }
        }
        // pop() only drops the length slot; the buffer and its capacity
        // stay alive so the next chunk reuses them without reallocation.
        while (this.buf.length > 0) { this.buf.pop(); }
    }

    public void close() {
        this.flush();
        if (this.handle != 0) {
            CloseHandle(this.handle);
            this.handle = 0;
        }
        if (file.exists(this.scratch)) { file.delete(this.scratch); }
    }
}

class BcTextWriter {
    public prop string path;
    public prop int handle;
    public prop string buf;

    construct (string outPath) {
        this.path = outPath;
        this.handle = 0;
        this.buf = "";
        ensureDirTree(bcDirname(outPath));
        int h = CreateFileA(outPath, 0x40000000, 0, null, 2, 0x80, 0);
        if (h == -1 || h == 0) { return; }
        this.handle = h;
        // Heap-allocated capacity buffer (never a literal: lstrcatA writes
        // through the pointer), emptied in place so appends stay within it.
        this.buf = bcSpaces(4096);
        lstrcpyA(this.buf, "");
    }

    public bool ok() {
        return this.handle != 0;
    }

    // NUL-free text only: the buffer is a plain C string, so lstrcatA
    // appends in place and .length stays truthful.
    public void put(string s) {
        if (s.length == 0 || this.handle == 0) { return; }
        if (s.length >= 4000) {
            this.flush();
            int w2 = 0;
            WriteFile(this.handle, s, s.length, &w2, null);
            return;
        }
        if (this.buf.length + s.length > 4000) { this.flush(); }
        lstrcatA(this.buf, s);
    }

    public void flush() {
        if (this.handle == 0 || this.buf.length == 0) { return; }
        int w = 0;
        WriteFile(this.handle, this.buf, this.buf.length, &w, null);
        lstrcpyA(this.buf, "");
    }

    public void close() {
        this.flush();
        if (this.handle != 0) {
            CloseHandle(this.handle);
            this.handle = 0;
        }
    }
}

// ---------------------------------------------------------------------------
// Module-level helpers. Free-function names carry a bc prefix: every module
// flattens into one program namespace, so duplicates would collide.
// ---------------------------------------------------------------------------

// Heap string of n spaces built with one join (linear) — the writable
// buffer primitive for BcTextWriter and range reads.
public string bcSpaces(int n) {
    if (n <= 0) { return ""; }
    string unit = "                    ";
    string[] parts = [];
    int full = n / 20;
    for (int i = 0; i < full; i++) { parts.add(unit); }
    int rem = n - full * 20;
    if (rem > 0) { parts.add(sliceRange(unit, 0, rem)); }
    return parts.join("");
}

// FNV-1 over a character range of the aggregate, so cache hits hash a
// chunk in place without ever materializing its text.
public int64 bcFnv1Range(string data, int start, int end) {
    int64 hash = -3750763034362895579;
    if (end > data.length) { end = data.length; }
    if (start < 0) { start = 0; }
    for (int i = start; i < end; i++) {
        hash = hash * 1099511628211;
        int64 b = data[i];
        hash = hash ^ b;
    }
    return hash;
}

// Byte-range slice through a temp copy of the aggregate: seek + ReadFile
// into a preallocated buffer sized exactly for the range, so the buffer's
// own NUL terminator lands right after the bytes read.
public string bcSliceViaFile(string hopPath, int start, int len) {
    if (len <= 0 || hopPath.length == 0) { return ""; }
    int h = CreateFileA(hopPath, 0x80000000, 3, null, 3, 0x80, 0);
    if (h == -1 || h == 0) { return ""; }
    string r = "";
    int seeked = SetFilePointer(h, start, null, 0);
    if (seeked != -1) {
        string buf = bcSpaces(len);
        int got = 0;
        int okR = ReadFile(h, buf, len, &got, null);
        if (okR != 0 && got == len) { r = buf; }
    }
    CloseHandle(h);
    return r;
}

// Fallback slice for tiny ranges and hop failures: plain per-char copy,
// correct for any size but quadratic on large bodies — used only when the
// bounded paths above are unavailable.
public string bcSliceSlow(string s, int start, int end) {
    if (end > s.length) { end = s.length; }
    if (start < 0) { start = 0; }
    string r = "";
    for (int i = start; i < end; i++) { r = r + s[i]; }
    return r;
}

public bool bcFileExists(string path) {
    return file.exists(path);
}

// Environment lookup through a preallocated writable string buffer (strings
// lower to dense char buffers on every backend, unlike managed arrays).
public string bcEnvValue(string name) {
    string buf = "                                                                ";
    int cap = 64;
    GetEnvironmentVariableA(name, buf, cap);
    string r = "";
    for (int i = 0; i < cap; i++) {
        char c = buf[i];
        if (c == 0) { break; }
        r = r + c;
    }
    return r;
}

public int bcNowMillis() {
    return time(0) * 1000;
}

public int bcFileSize(string path) {
    int h = CreateFileA(path, 0x80000000, 3, null, 3, 0x80, 0);
    if (h == -1 || h == 0) { return 0; }
    int sz = GetFileSize(h, null);
    CloseHandle(h);
    if (sz < 0) { return 0; }
    return sz;
}

// Modification-time proxy recorded in the .sbcr slot: the compiled runtime
// has no cross-stage-safe way to read FILETIMEs, so the change token is the
// file size. Content identity is always decided by the FNV-1 hash alongside
// it, so cache hits remain correct.
public int bcModifiedMs(string path) {
    return bcFileSize(path);
}

// FNV-1 64-bit hash (spec: "FNV-1 hash of the contents"). Compiled int64
// arithmetic wraps in two's complement, matching the reference's u64
// wrapping bit for bit. bcFnv1Range below is the range form the cache
// actually hashes with.
public int64 bcFnv1(string data) {
    return bcFnv1Range(data, 0, data.length);
}

public string bcSanitize(string name) {
    string r = "";
    for (int i = 0; i < name.length; i++) {
        char c = name[i];
        if (c == '<' || c == '>' || c == ':' || c == '"' || c == '/'
            || c == '\\' || c == '|' || c == '?' || c == '*') {
            r = r + '_';
        } else {
            r = r + c;
        }
    }
    return r;
}

public string bcNormalizeSlashes(string path) {
    string r = "";
    for (int i = 0; i < path.length; i++) {
        if (path[i] == '\\') { r = r + '/'; }
        else { r = r + path[i]; }
    }
    return r;
}

public string bcReplaceAll(string s, string what, string with) {
    string r = "";
    int i = 0;
    while (i < s.length) {
        if (i + what.length <= s.length) {
            bool hit = true;
            for (int j = 0; j < what.length; j++) {
                if (s[i + j] != what[j]) { hit = false; break; }
            }
            if (hit) {
                r = r + with;
                i += what.length;
                continue;
            }
        }
        r = r + s[i];
        i++;
    }
    return r;
}

public string bcDirname(string path) {
    int last = -1;
    for (int i = 0; i < path.length; i++) {
        if (path[i] == '\\' || path[i] == '/') { last = i; }
    }
    if (last < 0) { return "."; }
    return sliceRange(path, 0, last);
}

public string resolveRel(string root, string rel) {
    string winRel = bcReplaceAll(rel, "/", "\\");
    if (root.length == 0 || root == ".") { return winRel; }
    return root + "\\" + winRel;
}

// Create every path component below the current directory; CreateDirectoryA
// fails harmlessly when a level already exists.
public void ensureDirTree(string dir) {
    string cur = "";
    for (int i = 0; i < dir.length; i++) {
        char c = dir[i];
        if (c == '\\' || c == '/') {
            if (cur.length >= 2) { CreateDirectoryA(cur, null); }
            cur = cur + '\\';
        } else {
            cur = cur + c;
        }
    }
    if (cur.length >= 2) { CreateDirectoryA(cur, null); }
}

public string sliceRange(string s, int start, int end) {
    string r = "";
    for (int i = start; i < end && i < s.length; i++) { r = r + s[i]; }
    return r;
}

private bool startsWith(string s, string prefix) {
    if (s.length < prefix.length) { return false; }
    for (int i = 0; i < prefix.length; i++) {
        if (s[i] != prefix[i]) { return false; }
    }
    return true;
}

private string wordAtSep(string s, int which, char sep) {
    int idx = 0;
    int i = 0;
    while (i < s.length) {
        while (i < s.length && s[i] == sep) { i++; }
        int start = i;
        while (i < s.length && s[i] != sep) { i++; }
        if (i > start) {
            if (idx == which) { return sliceRange(s, start, i); }
            idx++;
        }
    }
    return "";
}

private int64 decToI64(string s) {
    bool neg = false;
    int i = 0;
    if (s.length > 0 && s[0] == '-') { neg = true; i = 1; }
    int64 v = 0;
    for (; i < s.length; i++) {
        char c = s[i];
        if (c < '0' || c > '9') { break; }
        v = v * 10 + (c - '0');
    }
    if (neg) { v = -v; }
    return v;
}

private string tryReadText(string path) {
    string result = "";
    try {
        result = file.readString(path);
    } catch (int e) {
        result = "";
    }
    return result;
}

private bool bcKeyLess(string a, string b) {
    int n = a.length;
    if (b.length < n) { n = b.length; }
    for (int i = 0; i < n; i++) {
        if (a[i] != b[i]) { return a[i] < b[i]; }
    }
    return a.length < b.length;
}

// ---------------------------------------------------------------------------
// Reference tag space (must match silverc-rs src/cache.rs SIMPLE_KINDS order)
// ---------------------------------------------------------------------------

private int tagOf(Token t) {
    int k = t.kind;
    if (k == 0) { return 206; }
    if (k == 1) { return 200; }
    if (k == 2) { return 201; }
    if (k == 3) { return 202; }
    if (k == 4) { return 203; }
    if (k == 5) {
        if (t.text.length == 4 && t.text[0] == 't') { return 32; }
        return 33;
    }
    if (k == 6) { return 34; }
    if (k == 7) { return 204; }
    if (k == 10) { return 0; }
    if (k == 11) { return 1; }
    if (k == 12) { return 2; }
    if (k == 13) { return 3; }
    if (k == 14) { return 4; }
    if (k == 15) { return 5; }
    if (k == 16) { return 6; }
    if (k == 17) { return 7; }
    if (k == 18) { return 8; }
    if (k == 19) { return 9; }
    if (k == 20) { return 10; }
    if (k == 22) { return 12; }
    if (k == 23) { return 13; }
    if (k == 25) { return 15; }
    if (k == 26) { return 17; }
    if (k == 27) { return 18; }
    if (k == 28) { return 19; }
    if (k == 29) { return 20; }
    if (k == 30) { return 21; }
    if (k == 31) { return 22; }
    if (k == 32) { return 23; }
    if (k == 33) { return 24; }
    if (k == 34) { return 25; }
    if (k == 35) { return 26; }
    if (k == 36) { return 27; }
    if (k == 37) { return 28; }
    if (k == 38) { return 29; }
    if (k == 39) { return 30; }
    if (k == 40) { return 31; }
    if (k == 44) { return 35; }
    if (k == 45) { return 36; }
    if (k == 46) { return 37; }
    if (k == 47) { return 38; }
    if (k == 48) { return 39; }
    if (k == 49) { return 40; }
    if (k == 50) { return 47; }
    if (k == 51) { return 48; }
    if (k == 52) { return 49; }
    if (k == 53) { return 50; }
    if (k == 54) { return 57; }
    if (k == 55) { return 53; }
    if (k == 56) { return 56; }
    if (k == 57) { return 64; }
    if (k == 58) { return 65; }
    if (k == 59) { return 54; }
    if (k == 60) { return 55; }
