    public void genFileRenameCall(Node call) {
        if (call.childCount() < 3) { this.asm.xorRR64(0, 0); return; }
        this.genExpr(call.child(1));
        int srcOff = this.allocLocal("__fr_src");
        this.asm.movMBaseR(5, 0, srcOff);
        this.genExpr(call.child(2));
        int dstOff = this.allocLocal("__fr_dst");
        this.asm.movMBaseR(5, 0, dstOff);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, srcOff);
        this.asm.movRMBase(2, 5, dstOff);
        this.addImportPatch("kernel32.dll", "MoveFileA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }


    public void genFileCopyCall(Node call) {
        if (call.childCount() < 3) { this.asm.xorRR64(0, 0); return; }
        this.genExpr(call.child(1));
        int srcOff = this.allocLocal("__fc_src");
        this.asm.movMBaseR(5, 0, srcOff);
        this.genExpr(call.child(2));
        int dstOff = this.allocLocal("__fc_dst");
        this.asm.movMBaseR(5, 0, dstOff);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, srcOff);
        this.asm.movRMBase(2, 5, dstOff);
        this.asm.xorRR64(8, 8);
        this.addImportPatch("kernel32.dll", "CopyFileA");
