mod export optimizer;

import * from node;
import * from mini_asm;

// OVERHAUL.md --optimize — behavior-preserving optimization pass.
//
// Three stages, all guaranteed to leave the program's observable result
// unchanged:
//
// 1. Constant folding — arithmetic / bitwise / comparison operations on int
//    literal operands are evaluated at compile time using exactly the
//    semantics of the emitted x64 code (wrapping add/sub/mul, truncating
//    idiv, hardware shift masking). Operations that would fault at runtime
//    (division by zero, INT64_MIN / -1, out-of-range shifts) stay untouched
//    so runtime behavior is preserved bit for bit.
// 2. Dead-code elimination — a top-level function that is never referenced
//    anywhere in the aggregate program is dropped before codegen. The
//    reference collection is deliberately conservative: every identifier,
//    call name, and method name appearing anywhere (including default
//    arguments, global initializers, class methods, match patterns, and
//    string interpolations) marks a name live, so a function is only removed
//    when nothing can possibly reach it.
// 3. Peephole — runs on the emitted machine code (peepholeOptimize):
//    provably redundant instruction pairs are overwritten with NOPs in
//    place, so labels and relocations stay valid.

class Optimizer {
    // DCE candidates: top-level functions that may be dropped. The old
    // design collected every referenced name into one array and scanned it
    // linearly per identifier — O(references x distinctNames) on large
    // aggregates, which stalled --optimize builds for hours. Candidates are
    // instead grouped into (first-char class, length) buckets so each name
    // node compares only against the few candidates that could match, and
    // one single walk marks them live.
    private prop string[] candNames;
    private prop int[] candLive;
    private prop int[] candOrder;
    private prop int[] bucketStart;
    private prop int[] candIndexOfItem;

    construct () {
        this.candNames = [];
        this.candLive = [];
        this.candOrder = [];
        this.bucketStart = [];
        this.candIndexOfItem = [];
    }

    private bool eqStr(string a, string b) {
        if (a.length != b.length) { return false; }
        for (int i = 0; i < a.length; i++) {
            if (a[i] != b[i]) { return false; }
        }
        return true;
    }

    // 64 first-character classes: a-z, A-Z, 0-9, '_', other.
    private int nameCharClass(char c) {
        if (c >= 'a' && c <= 'z') { return c - 'a'; }
        if (c >= 'A' && c <= 'Z') { return c - 'A' + 26; }
        if (c >= '0' && c <= '9') { return c - '0' + 52; }
        if (c == '_') { return 62; }
        return 63;
    }

    private int bucketKey(string name) {
        if (name.length == 0) { return 63 * 65; }
        int len = name.length;
        if (len > 64) { len = 64; }
        return this.nameCharClass(name[0]) * 65 + len;
    }

    // Entry point: fold constants across the whole program, then drop dead
    // top-level functions. Mutates the item list in place.
    public void optimizeProgram(Node[] program) {
        for (int i = 0; i < program.length; i++) {
            this.foldNode(program[i]);
        }
        this.buildCandidates(program);
        for (int i = 0; i < program.length; i++) {
            this.collectRefs(program[i]);
        }
        int w = 0;
        for (int k = 0; k < program.length; k++) {
            Node item = program[k];
            bool keep = true;
            int ci = this.candIndexOfItem[k];
            if (ci >= 0 && this.candLive[ci] == 0) {
                keep = false;
            }
            if (keep) {
                program[w] = item;
                w++;
            }
        }
        truncateItems(program, w);
    }

    // Register the droppable top-level functions (everything except main,
    // __-prefixed runtime helpers, and declarations without a body) and
    // index them by bucket. candIndexOfItem maps each program slot to its
    // candidate (-1 when the item is automatically kept).
    private void buildCandidates(Node[] program) {
        this.candNames = [];
        this.candLive = [];
        this.candIndexOfItem = [];
        int nb = 64 * 65 + 1;
        int[] counts = [];
        for (int b = 0; b < nb; b++) { counts.add(0); }
        for (int k = 0; k < program.length; k++) {
            Node item = program[k];
            int ci = -1;
            if (item.kind == 100
                && !this.eqStr(item.name, "main")
                && !(item.name.length >= 2 && item.name[0] == '_' && item.name[1] == '_')
                && item.childCount() >= 2) {
                this.candNames.add(item.name);
                this.candLive.add(0);
                ci = this.candNames.length - 1;
                int bk = this.bucketKey(item.name);
                counts[bk] = counts[bk] + 1;
            }
            this.candIndexOfItem.add(ci);
        }
        // Counting sort of candidate indices by bucket; bucketStart[b] ..
        // bucketStart[b + 1] is the scan range for bucket b.
        this.bucketStart = [];
        int running = 0;
        for (int b2 = 0; b2 < nb; b2++) {
            this.bucketStart.add(running);
            running += counts[b2];
        }
        this.bucketStart.add(running);
        this.candOrder = [];
        for (int c2 = 0; c2 < this.candNames.length; c2++) { this.candOrder.add(0); }
        int[] fill = [];
        for (int b3 = 0; b3 < nb; b3++) { fill.add(this.bucketStart[b3]); }
        for (int c3 = 0; c3 < this.candNames.length; c3++) {
            int bk2 = this.bucketKey(this.candNames[c3]);
            this.candOrder[fill[bk2]] = c3;
            fill[bk2] = fill[bk2] + 1;
        }
    }

    // Mark every candidate whose name appears here live. Overloads share a
    // name, so all equal names in the bucket are marked (no early break).
    private void markRef(string name) {
        if (name.length == 0 || this.candNames.length == 0) { return; }
        int b = this.bucketKey(name);
        for (int j = this.bucketStart[b]; j < this.bucketStart[b + 1]; j++) {
            int ci = this.candOrder[j];
            if (this.candLive[ci] == 0 && this.eqStr(this.candNames[ci], name)) {
                this.candLive[ci] = 1;
            }
        }
    }

    // ------------------------------------------------------------------
    // 1. Constant folding
    // ------------------------------------------------------------------

    // Bottom-up generic walk: fold children first, then try to fold this
    // node. Recursing over every child keeps the traversal correct for all
    // container shapes (statements, match arms, lambdas, interp strings...)
    // without duplicating their layouts here.
    private void foldNode(Node n) {
        for (int i = 0; i < n.childCount(); i++) {
            this.foldNode(n.child(i));
            Node replacement = this.tryFold(n.child(i));
            if (replacement != null) {
                n.children[i] = replacement;
            }
        }
    }

    // Returns the folded replacement for an expression node, or null when it
    // must stay as written.
    private Node? tryFold(Node e) {
        if (e.kind == 8) {
            return this.tryFoldUnary(e);
        }
        if (e.kind == 7) {
            return this.tryFoldBinary(e);
        }
        return null;
    }

    private Node? tryFoldUnary(Node u) {
        if (u.childCount() < 1) { return null; }
        Node c = u.child(0);
        if (c.kind != 0 && c.kind != 4) { return null; }
        if (u.op == 0 && c.kind == 0) {
            Node r = new Node();
            r.kind = 0;
            r.intVal = -c.intVal;
            return r;
        }
        if (u.op == 2 && c.kind == 0) {
            Node r = new Node();
            r.kind = 0;
            r.intVal = ~c.intVal;
            return r;
        }
        if (u.op == 1 && c.kind == 4) {
            Node r = new Node();
            r.kind = 4;
            r.boolVal = !c.boolVal;
            return r;
        }
        return null;
    }

    private Node? tryFoldBinary(Node bin) {
        if (bin.childCount() < 2) { return null; }
        int op = bin.op;
        // Assignment family mutates; logical operators short-circuit; range /
        // spread / coalesce / move-init are structural. Leave them all.
        if (op == 20 || op == 25 || (op >= 14 && op <= 17) || (op >= 26 && op <= 28) || (op >= 29 && op <= 36)) {
            return null;
        }
        Node l = bin.child(0);
        Node r = bin.child(1);
        if (l.kind != 0 || r.kind != 0) { return null; }
        int64 a = l.intVal;
        int64 b = r.intVal;
        Node res = new Node();
        if (op == 1) { res.kind = 0; res.intVal = a + b; return res; }
        if (op == 2) { res.kind = 0; res.intVal = a - b; return res; }
        if (op == 3) { res.kind = 0; res.intVal = a * b; return res; }
        if (op == 4) {
            // idiv faults on zero divisor and MIN / -1; keep those intact.
            if (b == 0 || (a == -9223372036854775807 - 1 && b == -1)) { return null; }
            res.kind = 0;
            res.intVal = a / b;
            return res;
        }
        if (op == 13) {
            if (b == 0 || (a == -9223372036854775807 - 1 && b == -1)) { return null; }
            res.kind = 0;
            res.intVal = a % b;
            return res;
        }
        if (op == 22) { res.kind = 0; res.intVal = a & b; return res; }
        if (op == 23) { res.kind = 0; res.intVal = a | b; return res; }
        if (op == 24) { res.kind = 0; res.intVal = a ^ b; return res; }
        if (op == 18) {
            // x86 masks the shift count with 63; fold only unmasked cases.
            if (b < 0 || b > 63) { return null; }
            res.kind = 0;
            res.intVal = a << b;
            return res;
        }
        if (op == 19) {
            if (b < 0 || b > 63) { return null; }
            res.kind = 0;
            res.intVal = a >> b;
            return res;
        }
        bool bv = false;
        if (op == 5) { bv = a == b; }
        elif (op == 6) { bv = a != b; }
        elif (op == 7) { bv = a < b; }
        elif (op == 8) { bv = a <= b; }
        elif (op == 9) { bv = a > b; }
        elif (op == 10) { bv = a >= b; }
        else { return null; }
        res.kind = 4;
        res.boolVal = bv;
        return res;
    }

    // ------------------------------------------------------------------
    // 2. Dead-code elimination reference collection
    // ------------------------------------------------------------------

    private void collectRefs(Node n) {
        if (n.kind == 6 || n.kind == 10 || n.kind == 13) {
            this.markRef(n.name);
        }
        for (int i = 0; i < n.childCount(); i++) {
            this.collectRefs(n.child(i));
        }
    }
}

// Drop list items beyond keepCount in place (the array length slot is
// refreshed by the caller through the returned value).
public Node[] optimizeProgramList(Node[] program) {
    Optimizer opt = new Optimizer();
    opt.optimizeProgram(program);
    return program;
}

private void truncateItems(Node[] arr, int keep) {
    while (arr.length > keep) {
        arr.pop();
    }
}

// ---------------------------------------------------------------------------
// 3. Peephole pass over the emitted machine code
//
// NOTE: DISABLED — the byte-scanning implementation matched the
// `push r; pop r` / `mov r, r` patterns without decoding instruction
// boundaries, so it falsely matched those byte sequences inside instruction
// immediates (e.g. an 8-byte `movabs` address containing the bytes 0x50 0x58)
// and NOP'd them out, corrupting the machine code. Large programs reliably hit
// such false matches, producing a compiler that AVs (0xC0000005) at runtime.
// The redundant pairs are pure no-ops, so removing the pass costs nothing
// functionally. The silverc-rs peephole was disabled for the same reason.
// ---------------------------------------------------------------------------
public void peepholeOptimize(MiniAsm asm) {
}

private bool labelInside(MiniAsm asm, int pos, int width) {
    return false;
}
