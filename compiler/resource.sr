mod export resource;

import * from sysinfo;

// ---------------------------------------------------------------------------
// Adaptive resource layer — auto-adjust to the host machine.
//
// The compiler scales to whatever system it runs on: big machines (many CPU
// threads, lots of RAM) or small ones (less). Every size decision derives
// from live system state queried through the universal `sysinfo` std module
// (sysinfo -> win32.kernel32 behind its own `#on WINDOWS` regions) — there
// are no raw DLL calls or preprocessor regions here, no hardcoded
// assumptions about machine size. Targets ~90% of system resources with a
// 10% safety margin, never overcommitting.
//
// UNIFIED_CORE_LIBRARY.md §4 rule 6: this module is pure universal Silver —
// the one OS layer lives inside sysinfo's public functions (cpuCores decodes
// SYSTEM_INFO's dwNumberOfProcessors DWORD at offset 32; memoryTotal /
// memoryFree decode MEMORYSTATUSEX's ullTotalPhys / ullAvailPhys QWORDs at
// offsets 8 / 16, reported in whole MiB).
// ---------------------------------------------------------------------------

private int64 LOW_MEMORY_FLOOR = 1073741824; // 1 GiB

// Logical processor count (SYSTEM_INFO.dwNumberOfProcessors).
public int rsCpuThreadCount() {
    int n = sysinfo.cpuCores();
    if (n < 1) { n = 1; }
    return n;
}

// Bytes of physical RAM currently available (MEMORYSTATUSEX.ullAvailPhys).
// sysinfo reports whole MiB; the byte value is reconstructed exactly for
// every whole-MiB figure.
public int64 rsAvailableRamBytes() {
    return sysinfo.memoryFree() * 1024 * 1024;
}

// Total physical RAM bytes (MEMORYSTATUSEX.ullTotalPhys), same MiB basis.
public int64 rsTotalRamBytes() {
    return sysinfo.memoryTotal() * 1024 * 1024;
}

// Default worker count: 90% of logical processors, never exceeding total
// and never below 1. On very small machines (e.g. 2 threads → 1.8 → 2)
// the clamp ensures total is never exceeded.
public int rsDefaultThreadCount() {
    int total = rsCpuThreadCount();
    float scaled = float(total) * 0.9 + 0.5;
    int n = int(scaled);
    if (n < 1) { n = 1; }
    if (n > total) { n = total; }
    return n;
}

// Check a manually requested thread count against the host's logical
// processor count:
// - returns -1 when requested > total (caller must abort, exact message)
// - returns 0 when requested == total (caller warns about the missing margin)
// - returns the effective count (>= 1) when requested < total
public int rsThreadsWithMargin(int requested) {
    int total = rsCpuThreadCount();
    if (requested > total) { return -1; }
    if (requested == total) { return 0; }
    if (requested < 1) { return 1; }
    return requested;
}

// 90% of currently available physical RAM (10% safety margin).
public int64 rsMemoryBudgetBytes() {
    int64 avail = rsAvailableRamBytes();
    float scaled = float(avail) * 0.9;
    return int64(scaled);
}

// True when the host is memory-constrained (available RAM < 1 GiB).
public bool rsIsLowMemory() {
    return rsAvailableRamBytes() < LOW_MEMORY_FLOOR;
}

// Memory-budget-aware chunk size for parallel partitioning.
// `hint` is the caller's preferred per-worker item count. The result is
// clamped so the total concurrent working set of all active workers stays
// within the adaptive memory budget: each worker holds at most
// budget / threads / 1024 items' worth of memory, never below 1.
public int rsAdaptiveChunkSize(int hint) {
    int threads = rsDefaultThreadCount();
    if (threads < 1) { threads = 1; }
    int64 budget = rsMemoryBudgetBytes();
    int64 perWorker = budget / threads / 1024;
    if (perWorker < 1) { perWorker = 1; }
    int cap = int(perWorker);
    if (hint < 1) { hint = 1; }
    if (hint < cap) { return hint; }
    return cap;
}
