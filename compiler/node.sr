mod export node;

class Node {
    public prop int kind;
    public prop int64 intVal;
    public prop float64 floatVal;
    public prop string strVal;
    public prop char charVal;
    public prop bool boolVal;
    public prop int op;
    public prop string name;
    public prop string typeHint;
    public prop bool isMut;
    public prop bool isPublic;
    public prop bool isStatic;
    public prop bool isMember;
    public prop bool isInternal;
    public prop bool isFixed;
    public prop bool isLive;
    public prop bool isOnce;
    public prop bool isAlias;
    public prop bool isShared;
    public prop bool isReadOnly;
    public prop bool isVisible;
    public prop bool hasFinally;
    public prop bool isVariadic;
    public prop string parentClass;
    // Multiple inheritance (DOCS/207): every listed parent in order
    // (`class Person : Creature, Human`). parentClass above stays the
    // FIRST listed parent so single-parent readers keep working.
    public prop string[] parentClasses;
    // Owning module as an interned id (index into the Parser's module
    // interning table; 0 = the entry file / untagged). One int per item
    // instead of one module-path string per item (MEMORY.md M3).
    public prop int srcModule;
    public prop Node[] children;
    public prop int line;
    public prop int col;
    public prop int localBindingSlot;

    construct {
        this.kind = 0; this.intVal = 0; this.floatVal = 0.0;
        this.strVal = ""; this.charVal = ' '; this.boolVal = false;
        this.op = 0; this.name = ""; this.typeHint = "";
        this.isMut = false; this.isPublic = true; this.isStatic = false;
        this.isMember = false;
        this.isInternal = false;
        this.isFixed = false; this.isLive = false; this.isOnce = false;
        this.isAlias = false; this.isShared = false;
        this.isReadOnly = false;
        this.isVisible = false;
        this.hasFinally = false; this.isVariadic = false;
        this.parentClass = ""; this.parentClasses = []; this.srcModule = 0; this.children = [];
        this.line = 0; this.col = 0; this.localBindingSlot = 0;
    }

    public int childCount() {
        return this.children.length;
    }

    public Node child(int i) {
        if (i >= 0 && i < this.children.length) {
            return this.children[i];
        }
        return new Node();
    }
}

