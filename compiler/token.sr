mod export token;

class Token {
    public prop int kind;
    public prop string text;
    public prop int line;
    public prop int col;
    public prop int64 intVal;
    public prop float64 floatVal;
    public prop string strVal;
    public prop char charVal;
    // Number tokens (kind 1) only: the literal was spelled 0x/0X, so its
    // text may contain 'e'/'E' as HEX DIGITS, never as a scientific
    // exponent. The parser's int-vs-float re-classification must not fire
    // on them (see parser.sr readNumber handling).
    public prop bool isHexNum;
    // SPEC 12.2 / DOCS 102 interpolation segments (kind 168 tokens only): four
    // parallel arrays, one entry per `$"..."` segment. `ipKinds[d]` is 0 for a
    // literal text run (decoded escapes in `ipTexts[d]`) or 1 for a `{...}`
    // hole (raw source between the braces in `ipTexts[d]`, with its `{`
    // position in `ipLines[d]`/`ipCols[d]` so the parser can report the
    // parenthesization error at the right spot). Mirrors silverc-rs
    // `TokenKind::InterpString(Vec<InterpSegment>)`.
    public prop int[] ipKinds;
    public prop string[] ipTexts;
    public prop int[] ipLines;
    public prop int[] ipCols;

    construct (int kind, string text, int line, int col) {
        this.kind = kind; this.text = text;
        this.line = line; this.col = col;
        this.intVal = 0; this.floatVal = 0.0;
        this.strVal = ""; this.charVal = ' ';
        this.isHexNum = false;
        this.ipKinds = []; this.ipTexts = []; this.ipLines = []; this.ipCols = [];
    }
}

