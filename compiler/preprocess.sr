mod export preprocess;

// DOCS/260 — the preprocessor: `#on <OS>` / `#else` / `#off` region filter.
//
// A line/region filter stage that runs BEFORE lexing. Lines inside regions
// whose OS does not match the compile target are NEVER tokenized — they are
// replaced by blank lines so every downstream line/column diagnostic keeps
// pointing at the original file's lines (the filter always emits the same
// number of lines it consumed).
//
// Semantics:
//   #on WINDOWS   open a region fed only on WINDOWS builds
//   #on LINUX or MAC
//                 open (or chain) a single branch fed on LINUX *or* MAC
//                 builds: one branch listing several OS names separated by
//                 the lowercase word `or` (OS names stay UPPERCASE-only,
//                 order is irrelevant — `#on MAC or LINUX` means the same).
//                 The branch matches when the target equals ANY listed OS
//                 and keeps the usual first-match-wins / `#else`-last rules.
//   #on LINUX     inside an open region: close the previous branch and open
//                 the next branch of the SAME region (first match wins)
//   #else         fed only when no preceding `#on` of the region matched;
//                 always the LAST branch of the region
//   #off          close the region; shared code resumes
//   A `#on` after `#else` in the same region is an error.
//
// Directives are recognized on their OWN lines (first non-whitespace token);
// indented directives are fine, nothing else may share the line. Any other
// line-leading `#...` token is NOT a directive and passes through unchanged.
//
// Errors are appended to the `errs` array (messages embed the original line
// number); the caller prints them and exits with status 1.
//
// Implementation shape: pass 1 is a pure state-machine scan that records the
// char offsets of the lines to blank (no string building, so scanning a
// 600KB source stays linear); pass 2 splices the output from a handful of
// kept runs. Files with nothing to blank return their input untouched.

// The target OS for every current build. Host-default mirrors silverc-rs
// TargetOs::DEFAULT (cfg!(target_os="linux")->LINUX, cfg!(target_os="macos")
// ->MAC, otherwise WINDOWS); explicit --os override wins via ppTargetOsFor
// (see cli_flags targetOs). MAC host-default is coded here; the default path
// cannot execution-test on non-Mac hosts (explicit --os mac is what the
// code-only phase tests). The flag is case-insensitive (lowercase
// windows/linux/mac is the documented form; WINDOWS/LINUX/MAC and mixed-case
// also accepted) and always normalizes to the canonical UPPERCASE name. `#on`
// directive names stay UPPERCASE-only (see ppIsOsName) — unchanged.
// WINDOWS builds with no override return WINDOWS byte-identically;
// LINUX builds return LINUX.
public string ppTargetOsFor(string overrideOs) {
    if (string.equals(overrideOs, "WINDOWS", StringCase.INSENSITIVE)) {
        return "WINDOWS";
    }
    if (string.equals(overrideOs, "LINUX", StringCase.INSENSITIVE)) {
        return "LINUX";
    }
    if (string.equals(overrideOs, "MAC", StringCase.INSENSITIVE)) {
        return "MAC";
    }
    return ppTargetOs();
}

public string ppTargetOs() {
    #on LINUX
    return "LINUX";
    #on MAC
    return "MAC";
    #else
    return "WINDOWS";
    #off
}

private bool ppIsOsName(string name) {
    return name == "WINDOWS" || name == "LINUX" || name == "MAC";
}

private string ppSlice(string s, int start, int end) {
    int a = start;
    if (a < 0) { a = 0; }
    int b = end;
    if (b > s.length) { b = s.length; }
    if (b <= a) { return ""; }
    // substring(start, len): the `s.slice(a..b)` Range-method form passes an
    // int[] and always yields "", so spell the exclusive-end slice with the
    // (start, length) primitive both compilers lower correctly.
    return s.substring(a, b - a);
}

private int ppFindChar(string hay, char needle, int start) {
    for (int i = start; i < hay.length; i++) {
        if (hay[i] == needle) { return i; }
    }
    return -1;
}

// First non-whitespace (space/tab) offset at or after `start`, bounded by
// `end` (exclusive). Returns `end` when the range holds only whitespace.
private int ppSkipBlanks(string s, int start, int end) {
    int p = start;
    while (p < end) {
        char c = s[p];
        if (c == ' ' || c == '\t') { p++; continue; }
        break;
    }
    return p;
}

public string ppPreprocess(string source, string targetOs, string[] errs) {
    // Pass 1: pure scan. Parallel arrays describe each line to blank:
    // start offset, newline offset (-1 = last line without terminator),
    // and 1 when the line ends with a CRLF terminator.
    int[] dropAt = [];
    int[] dropNl = [];
    int[] dropCr = [];

    // mode: 0 = outside regions, 1 = inside a region
    // sawElse: true once `#else` has fired in the open region (`#else`
    // must be the last branch, so a later `#on` is an error).
    int mode = 0;
    bool active = false;
    bool matchedAny = false;
    bool sawElse = false;
    int regionOpenLine = 0;
    int regionOpenOsStart = 0;
    int regionOpenOsEnd = 0;
    int lineNo = 1;
    int i = 0;
    while (i < source.length) {
        int nl = ppFindChar(source, '\n', i);
        int end = (nl >= 0) ? nl : source.length;
        // Content excludes a trailing CR of CRLF terminators.
        int contentEnd = end;
        if (contentEnd > i && source[contentEnd - 1] == '\r') { contentEnd--; }

        int p = ppSkipBlanks(source, i, contentEnd);
        bool isDirective = false;
        if (p < contentEnd && source[p] == '#') {
            // Directive candidate: lowercase word right after '#'.
            int q = p + 1;
            int wordEnd = q;
            while (wordEnd < contentEnd) {
                char c = source[wordEnd];
                if (c < 'a' || c > 'z') { break; }
                wordEnd++;
            }
            string word = ppSlice(source, q, wordEnd);
            if (word == "on") {
                isDirective = true;
                int nameStart = ppSkipBlanks(source, wordEnd, contentEnd);
                int nameEnd = nameStart;
                while (nameEnd < contentEnd) {
                    char c = source[nameEnd];
                    if (c == ' ' || c == '\t') { break; }
                    nameEnd++;
                }
                string osName = ppSlice(source, nameStart, nameEnd);
                if (osName.length == 0) {
                    errs.add("preprocessor: '#on' requires an OS name (WINDOWS, LINUX, MAC), at line " + lineNo.toString());
                    return source;
                }
                if (!ppIsOsName(osName)) {
                    errs.add("preprocessor: unknown OS name '" + osName + "' after '#on' (valid OS names are WINDOWS, LINUX, MAC), at line " + lineNo.toString());
                    return source;
                }
                // OR-list: `#on LINUX or MAC` — one branch fed when the
                // target equals ANY listed OS (names UPPERCASE-only,
                // separator lowercase `or`, order irrelevant). The branch
                // keeps the usual first-match-wins / `#else`-last rules.
                bool matchesTarget = osName == targetOs;
                int listEnd = nameEnd;
                int cursor = nameEnd;
                while (cursor < contentEnd) {
                    int sepSkip = ppSkipBlanks(source, cursor, contentEnd);
                    if (sepSkip >= contentEnd) { break; }
                    int sepEnd = sepSkip;
                    while (sepEnd < contentEnd) {
                        char sc = source[sepEnd];
                        if (sc == ' ' || sc == '\t') { break; }
                        sepEnd++;
                    }
                    string sep = ppSlice(source, sepSkip, sepEnd);
                    if (sep != "or") {
                        errs.add("preprocessor: unexpected text after '#on', at line " + lineNo.toString());
                        return source;
                    }
                    int nextSkip = ppSkipBlanks(source, sepEnd, contentEnd);
                    int nextEnd = nextSkip;
                    while (nextEnd < contentEnd) {
                        char nc = source[nextEnd];
                        if (nc == ' ' || nc == '\t') { break; }
                        nextEnd++;
                    }
                    string nextOs = ppSlice(source, nextSkip, nextEnd);
                    if (nextOs.length == 0) {
                        errs.add("preprocessor: '#on' requires an OS name (WINDOWS, LINUX, MAC) after 'or', at line " + lineNo.toString());
                        return source;
                    }
                    if (!ppIsOsName(nextOs)) {
                        errs.add("preprocessor: unknown OS name '" + nextOs + "' after '#on' (valid OS names are WINDOWS, LINUX, MAC), at line " + lineNo.toString());
                        return source;
                    }
                    if (nextOs == targetOs) { matchesTarget = true; }
                    listEnd = nextEnd;
                    cursor = nextEnd;
                }
                if (mode == 1) {
                    if (sawElse) {
                        errs.add("preprocessor: '#on' after '#else' in the same region ('#else' must be last), at line " + lineNo.toString());
                        return source;
                    }
                    active = matchesTarget && !matchedAny;
                    matchedAny = matchedAny || matchesTarget;
                } else {
                    mode = 1;
                    active = matchesTarget;
                    matchedAny = active;
                    sawElse = false;
                    regionOpenLine = lineNo;
                    regionOpenOsStart = nameStart;
                    regionOpenOsEnd = listEnd;
                }
            } elif (word == "else") {
                isDirective = true;
                if (ppSkipBlanks(source, wordEnd, contentEnd) < contentEnd) {
                    errs.add("preprocessor: unexpected text after '#else', at line " + lineNo.toString());
                    return source;
                }
                if (mode == 0) {
                    errs.add("preprocessor: '#else' without an open '#on' region, at line " + lineNo.toString());
                    return source;
                }
                active = !matchedAny;
                sawElse = true;
            } elif (word == "off") {
                isDirective = true;
                if (ppSkipBlanks(source, wordEnd, contentEnd) < contentEnd) {
                    errs.add("preprocessor: unexpected text after '#off', at line " + lineNo.toString());
                    return source;
                }
                if (mode == 0) {
                    errs.add("preprocessor: '#off' without an open '#on' region, at line " + lineNo.toString());
                    return source;
                }
                mode = 0;
                sawElse = false;
            }
            // Any other `#word` is not a directive: pass through unchanged.
        }

        if (isDirective || (mode == 1 && !active)) {
            dropAt.add(i);
            dropNl.add(nl);
            dropCr.add((contentEnd != end) ? 1 : 0);
        }

        if (nl < 0) { break; }
        i = nl + 1;
        lineNo++;
    }

    if (mode == 1) {
        string osName = ppSlice(source, regionOpenOsStart, regionOpenOsEnd);
        errs.add("preprocessor: '#on " + osName + "' region opened at line " + regionOpenLine.toString() + " is never closed by '#off' (end of file)");
        return source;
    }

    if (dropAt.length == 0) { return source; }

    // Pass 2: splice — one slice per kept run, one terminator per blanked
    // line, so a directive-heavy file costs a handful of concatenations.
    string result = "";
    int copyStart = 0;
    for (int d = 0; d < dropAt.length; d++) {
        if (dropAt[d] > copyStart) {
            result = result + ppSlice(source, copyStart, dropAt[d]);
        }
        if (dropNl[d] >= 0) {
            if (dropCr[d] == 1) { result = result + "\r\n"; }
            else { result = result + "\n"; }
        }
        copyStart = (dropNl[d] >= 0) ? dropNl[d] + 1 : source.length;
    }
    if (copyStart < source.length) {
        result = result + ppSlice(source, copyStart, source.length);
    }
    return result;
}
