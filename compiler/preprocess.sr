mod export preprocess;

import * from string;
import * from path;

// DOCS/260 — the preprocessor: `#on <OS>` / `#else` / `#off` region filter.
//
// A line/region filter stage that runs BEFORE lexing. Lines inside regions
// whose OS does not match the compile target are NEVER tokenized — they are
// replaced by blank lines so every downstream line/column diagnostic keeps
// pointing at the original file's lines (the filter always emits the same
// number of lines it consumed).
//
// Semantics:
//   #on WINDOWS   open a region fed only on WINDOWS builds
//   #on DEBUG     open a region fed only under `--debug`
//   #on RELEASE   open a region fed by default (no flag; release is default)
//   #on LINUX or MAC
//                 open (or chain) a single branch fed on LINUX *or* MAC
//                 builds: one branch listing several names separated by
//                 the lowercase word `or` (names stay UPPERCASE-only,
//                 order is irrelevant — `#on MAC or LINUX` means the same).
//                 Each name is tested against its own axis (OS names test
//                 the target, DEBUG/RELEASE test the `--debug` flag); the
//                 branch matches when ANY listed name matches and keeps the
//                 usual first-match-wins / `#else`-last rules.
//   #on LINUX     inside an open region: close the previous branch and open
//                 the next branch of the SAME region (first match wins)
//   #else         fed only when no preceding `#on` of the region matched;
//                 always the LAST branch of the region
//   #off          close the region; shared code resumes
//   A `#on` after `#else` in the same region is an error.
//
// Directives are recognized on their OWN lines (first non-whitespace token);
// indented directives are fine, nothing else may share the line. Any other
// line-leading `#...` token is NOT a directive and passes through unchanged.
//
// Errors are appended to the `errs` array (messages embed the original line
// number); the caller prints them and exits with status 1.
//
// Implementation shape: pass 1 is a pure state-machine scan that records the
// char offsets of the lines to blank (no string building, so scanning a
// 600KB source stays linear); pass 2 splices the output from a handful of
// kept runs. Files with nothing to blank return their input untouched.

// The target OS for every current build. Host-default mirrors silverc-rs
// TargetOs::DEFAULT (cfg!(target_os="linux")->LINUX, cfg!(target_os="macos")
// ->MAC, otherwise WINDOWS); explicit --os override wins via ppTargetOsFor
// (see cli_flags targetOs). MAC host-default is coded here; the default path
// cannot execution-test on non-Mac hosts (explicit --os mac is what the
// code-only phase tests). The flag is case-insensitive (lowercase
// windows/linux/mac is the documented form; WINDOWS/LINUX/MAC and mixed-case
// also accepted) and always normalizes to the canonical UPPERCASE name. `#on`
// directive names stay UPPERCASE-only (see ppIsOsName) — unchanged.
// WINDOWS builds with no override return WINDOWS byte-identically;
// LINUX builds return LINUX.
//
// The build mode rides a second, independent axis: `debugBuild` is true only
// under `--debug`. Release is the default (no flag); `--release` is not a
// real flag — the driver prints a notice and exits without compiling.
// `#on DEBUG` feeds only when debugBuild is true, `#on RELEASE` only when it
// is false (see ppNameMatches). Each `#on` name is tested against its own
// axis, so one branch may mix axes (`#on LINUX or DEBUG`), though
// single-axis regions stay the most readable.
public string ppTargetOsFor(string overrideOs) {
    if (string.equals(overrideOs, "WINDOWS", StringCase.INSENSITIVE)) {
        return "WINDOWS";
    }
    if (string.equals(overrideOs, "LINUX", StringCase.INSENSITIVE)) {
        return "LINUX";
    }
    if (string.equals(overrideOs, "MAC", StringCase.INSENSITIVE)) {
        return "MAC";
    }
    if (string.equals(overrideOs, "MACX64", StringCase.INSENSITIVE)) {
        return "MACX64";
    }
    return ppTargetOs();
}

public string ppTargetOs() {
    #on LINUX
    return "LINUX";
    #on MAC
    return "MAC";
    #else
    return "WINDOWS";
    #off
}

private bool ppIsOsName(string name) {
    return name == "WINDOWS" || name == "LINUX" || name == "MAC";
}

// True when `name` is a build-mode `#on` name (`DEBUG` / `RELEASE`,
// case-sensitive). Build-mode names test the `--debug` flag, not the target
// OS (mirrors silverc-rs is_build_mode_name).
private bool ppIsBuildModeName(string name) {
    return name == "DEBUG" || name == "RELEASE";
}

// True when a single `#on` name feeds for the given target OS and build
// mode. OS names test `targetOs`; build-mode names test `debugBuild`
// (`DEBUG` iff debug, `RELEASE` iff not debug). A branch feeds when ANY of
// its names matches (mirrors silverc-rs name_matches).
private bool ppNameMatches(string name, string targetOs, bool debugBuild) {
    if (ppIsBuildModeName(name)) {
        if (name == "DEBUG") { return debugBuild; }
        return !debugBuild;
    }
    // MAC.md Phase D: the Rosetta bridge target MACX64 runs Darwin sources.
    // `#on MAC` feeds on MACX64 (Darwin stat/layout branches); `#on LINUX`
    // stays Linux-only (glibc stat slots differ). No reference behavior
    // exists (the Rust toolchain has no MACX64 target).
    if (name == "MAC") { return targetOs == "MAC" || targetOs == "MACX64"; }
    return name == targetOs;
}

// Index of a `*` immediately followed by `"` inside [start, end), or -1.
// One bounded pass: `find`/`.length` both strlen the whole string (O(n)),
// so re-finding from every `*` was quadratic on star-heavy aggregates.
private int ppFindStarQuote(string s, int start, int end) {
    for (int i = start; i + 1 < end; i++) {
        if (s[i] == '*' && s[i + 1] == '"') { return i; }
    }
    return -1;
}

// Normalize one path literal body (source[start..end], without quotes) for
// the target OS and wrap it as an ordinary quoted literal: `/` becomes `\`
// on WINDOWS, `\` becomes `/` elsewhere, and backslashes are doubled so the
// normal string lexer reads them back singly (mirrors silverc-rs).
private string ppNormalizeOne(string source, int start, int end, string targetOs) {
    string body = path.normalize(projectSlice(source, start, end));
    string lit = "\"";
    for (int q = 0; q < body.length; q++) {
        if (body[q] == '/' && targetOs == "WINDOWS") { lit += "\\\\"; }
        else { lit += body[q]; }
    }
    lit += "\"";
    return lit;
}

// DOCS/257 — rewrite `*"..."` path literals for the target OS. A `*`
// immediately followed by `"` outside strings/chars/comments opens a
// compile-time path literal: separators normalize to the target, backslashes
// stay literal (no escape processing), and the result re-emits as an ordinary
// literal for the lexer. Strings (including `$"..."` text — interpolation
// braces never nest quotes at lex level), char literals (with `\X` pairs
// skipped) and `//` / `/* ... */` comments pass through untouched; `*` not
// immediately followed by `"` is untouched. Single-line only: an unclosed
// literal errors at its opening line. Pieces splice through pieces.join so a
// directive-heavy aggregate costs a handful of concatenations, mirroring the
// pass-2 splice below.
public string ppNormalizePaths(string source, string targetOs, string[] errs) {
    int srcLen = source.length;
    // No literal anywhere: the input itself, not a copy.
    if (ppFindStarQuote(source, 0, srcLen) < 0) { return source; }
    return ppNormalizeRange(source, 0, srcLen, 1, targetOs, errs);
}

// ppNormalizePaths over the range [start, end) of `source`, whose first line
// is the absolute 1-based `baseLine` (literal errors report absolute lines).
// Every bound is `end`, so the scan sees exactly the text a slice would, and
// on error the range is returned verbatim. The length is never re-read per
// character (strlen is O(n)). Comments, strings and chars are only skipped
// over: the output splits into pieces at path literals alone (one kept run +
// one rewritten literal each), never once per comment or string — the join is
// identical and a literal-free stretch costs no allocation at all.
private string ppNormalizeRange(string source, int start, int end, int baseLine, string targetOs, string[] errs) {
    if (ppFindStarQuote(source, start, end) < 0) { return projectSlice(source, start, end); }
    string[] pieces = [];
    int runStart = start;
    int i = start;
    int lineNo = baseLine;
    bool inBlock = false;
    while (i < end) {
        char c = source[i];
        if (inBlock) {
            if (c == '*' && i + 1 < end && source[i + 1] == '/') {
                i += 2;
                inBlock = false;
                continue;
            }
            if (c == '\n') { lineNo++; }
            i++;
            continue;
        }
        if (c == '/' && i + 1 < end && source[i + 1] == '/') {
            int e = i;
            while (e < end && source[e] != '\n') { e++; }
            i = e;
            continue;
        }
        if (c == '/' && i + 1 < end && source[i + 1] == '*') {
            i += 2;
            inBlock = true;
            continue;
        }
        if (c == '"') {
            int j = i + 1;
            while (j < end) {
                char d = source[j];
                if (d == '\n') { lineNo++; j++; continue; }
                if (d == '"') { j++; break; }
                if (d == '\\' && j + 1 < end) {
                    if (source[j + 1] == '\n') { lineNo++; }
                    j += 2;
                    continue;
                }
                j++;
            }
            i = j;
            continue;
        }
        if (c == '\'') {
            int j = i + 1;
            if (j < end && source[j] == '\\') {
                j++;
                if (j < end) {
                    if (source[j] == '\n') { lineNo++; }
                    j++;
                }
            } else if (j < end) {
                if (source[j] == '\n') { lineNo++; }
                j++;
            }
            if (j < end && source[j] == '\'') { j++; }
            i = j;
            continue;
        }
        if (c == '*' && i + 1 < end && source[i + 1] == '"') {
            int k = i + 2;
            while (k < end && source[k] != '"' && source[k] != '\n') { k++; }
            if (k >= end || source[k] != '"') {
                errs.add("preprocessor: '\"*\"' path literal opened at line " + (string)lineNo + " is never closed on the same line");
                if (start == 0 && end == source.length) { return source; }
                return projectSlice(source, start, end);
            }
            pieces.add(projectSlice(source, runStart, i));
            pieces.add(ppNormalizeOne(source, i + 2, k, targetOs));
            runStart = k + 1;
            i = k + 1;
            continue;
        }
        if (c == '\n') { lineNo++; }
        i++;
    }
    pieces.add(projectSlice(source, runStart, end));
    return pieces.join("");
}

// First non-whitespace (space/tab) offset at or after `start`, bounded by
// `end` (exclusive). Returns `end` when the range holds only whitespace.
private int ppSkipBlanks(string s, int start, int end) {
    int p = start;
    while (p < end) {
        char c = s[p];
        if (c == ' ' || c == '\t') { p++; continue; }
        break;
    }
    return p;
}

public string ppPreprocess(string source, string targetOs, bool debugBuild, string[] errs) {
    // Pass 1: pure scan. Parallel arrays describe each line to blank:
    // start offset, newline offset (-1 = last line without terminator),
    // and 1 when the line ends with a CRLF terminator.
    int[] dropAt = [];
    int[] dropNl = [];
    int[] dropCr = [];

    // mode: 0 = outside regions, 1 = inside a region
    // sawElse: true once `#else` has fired in the open region (`#else`
    // must be the last branch, so a later `#on` is an error).
    int mode = 0;
    bool active = false;
    bool matchedAny = false;
    bool sawElse = false;
    int regionOpenLine = 0;
    int regionOpenOsStart = 0;
    int regionOpenOsEnd = 0;
    int lineNo = 1;
    int i = 0;
    // Length read once and newlines found by a bounded walk: `.length` and
    // `find` both strlen the whole source (O(n)), which made this per-line
    // loop quadratic in the aggregate size.
    int srcLen = source.length;
    while (i < srcLen) {
        int nl = i;
        while (nl < srcLen && source[nl] != '\n') { nl++; }
        if (nl >= srcLen) { nl = -1; }
        int end = (nl >= 0) ? nl : srcLen;
        // Content excludes a trailing CR of CRLF terminators.
        int contentEnd = end;
        if (contentEnd > i && source[contentEnd - 1] == '\r') { contentEnd--; }

        int p = ppSkipBlanks(source, i, contentEnd);
        bool isDirective = false;
        if (p < contentEnd && source[p] == '#') {
            // Directive candidate: lowercase word right after '#'.
            int q = p + 1;
            int wordEnd = q;
            while (wordEnd < contentEnd) {
                char c = source[wordEnd];
                if (c < 'a' || c > 'z') { break; }
                wordEnd++;
            }
            string word = projectSlice(source, q, wordEnd);
            if (word == "on") {
                isDirective = true;
                int nameStart = ppSkipBlanks(source, wordEnd, contentEnd);
                int nameEnd = nameStart;
                while (nameEnd < contentEnd) {
                    char c = source[nameEnd];
                    if (c == ' ' || c == '\t') { break; }
                    nameEnd++;
                }
                string osName = projectSlice(source, nameStart, nameEnd);
                if (osName.length == 0) {
                    errs.add("preprocessor: '#on' requires an OS or build-mode name (WINDOWS, LINUX, MAC, DEBUG, RELEASE), at line " + (string)lineNo);
                    return source;
                }
                if (!ppIsOsName(osName) && !ppIsBuildModeName(osName)) {
                    errs.add("preprocessor: unknown OS or build-mode name '" + osName + "' after '#on' (valid names are WINDOWS, LINUX, MAC, DEBUG, RELEASE), at line " + (string)lineNo);
                    return source;
                }
                // OR-list: `#on LINUX or MAC` — one branch fed when ANY listed
                // name matches its own axis (OS names test the target,
                // DEBUG/RELEASE test the `--debug` flag; order irrelevant).
                // The branch keeps the usual first-match-wins / `#else`-last
                // rules.
                bool matchesTarget = ppNameMatches(osName, targetOs, debugBuild);
                int listEnd = nameEnd;
                int cursor = nameEnd;
                while (cursor < contentEnd) {
                    int sepSkip = ppSkipBlanks(source, cursor, contentEnd);
                    if (sepSkip >= contentEnd) { break; }
                    int sepEnd = sepSkip;
                    while (sepEnd < contentEnd) {
                        char sc = source[sepEnd];
                        if (sc == ' ' || sc == '\t') { break; }
                        sepEnd++;
                    }
                    string sep = projectSlice(source, sepSkip, sepEnd);
                    if (sep != "or") {
                        errs.add("preprocessor: unexpected text after '#on', at line " + (string)lineNo);
                        return source;
                    }
                    int nextSkip = ppSkipBlanks(source, sepEnd, contentEnd);
                    int nextEnd = nextSkip;
                    while (nextEnd < contentEnd) {
                        char nc = source[nextEnd];
                        if (nc == ' ' || nc == '\t') { break; }
                        nextEnd++;
                    }
                    string nextOs = projectSlice(source, nextSkip, nextEnd);
                    if (nextOs.length == 0) {
                        errs.add("preprocessor: '#on' requires an OS or build-mode name (WINDOWS, LINUX, MAC, DEBUG, RELEASE) after 'or', at line " + (string)lineNo);
                        return source;
                    }
                    if (!ppIsOsName(nextOs) && !ppIsBuildModeName(nextOs)) {
                        errs.add("preprocessor: unknown OS or build-mode name '" + nextOs + "' after '#on' (valid names are WINDOWS, LINUX, MAC, DEBUG, RELEASE), at line " + (string)lineNo);
                        return source;
                    }
                    if (ppNameMatches(nextOs, targetOs, debugBuild)) { matchesTarget = true; }
                    listEnd = nextEnd;
                    cursor = nextEnd;
                }
                if (mode == 1) {
                    if (sawElse) {
                        errs.add("preprocessor: '#on' after '#else' in the same region ('#else' must be last), at line " + (string)lineNo);
                        return source;
                    }
                    active = matchesTarget && !matchedAny;
                    matchedAny = matchedAny || matchesTarget;
                } else {
                    mode = 1;
                    active = matchesTarget;
                    matchedAny = active;
                    sawElse = false;
                    regionOpenLine = lineNo;
                    regionOpenOsStart = nameStart;
                    regionOpenOsEnd = listEnd;
                }
            } else if (word == "else") {
                isDirective = true;
                if (ppSkipBlanks(source, wordEnd, contentEnd) < contentEnd) {
                    errs.add("preprocessor: unexpected text after '#else', at line " + (string)lineNo);
                    return source;
                }
                if (mode == 0) {
                    errs.add("preprocessor: '#else' without an open '#on' region, at line " + (string)lineNo);
                    return source;
                }
                active = !matchedAny;
                sawElse = true;
            } else if (word == "off") {
                isDirective = true;
                if (ppSkipBlanks(source, wordEnd, contentEnd) < contentEnd) {
                    errs.add("preprocessor: unexpected text after '#off', at line " + (string)lineNo);
                    return source;
                }
                if (mode == 0) {
                    errs.add("preprocessor: '#off' without an open '#on' region, at line " + (string)lineNo);
                    return source;
                }
                mode = 0;
                sawElse = false;
            }
            // Any other `#word` is not a directive: pass through unchanged.
        }

        if (isDirective || (mode == 1 && !active)) {
            dropAt.add(i);
            dropNl.add(nl);
            dropCr.add((contentEnd != end) ? 1 : 0);
        }

        if (nl < 0) { break; }
        i = nl + 1;
        lineNo++;
    }

    if (mode == 1) {
        string osName = projectSlice(source, regionOpenOsStart, regionOpenOsEnd);
        errs.add("preprocessor: '#on " + osName + "' region opened at line " + (string)regionOpenLine + " is never closed by '#off' (end of file)");
        return source;
    }

    if (dropAt.length == 0) {
        // DOCS/257 — no regions to blank, but path literals still rewrite.
        return ppNormalizePaths(source, targetOs, errs);
    }

    // Pass 2: splice — one piece per kept run (path literals rewritten inline
    // per run, so only one output buffer exists instead of a filtered copy
    // plus a renormalized copy), one terminator per blanked line, joined once
    // at the end. runLine tracks each run's absolute first line for
    // ppNormalizeRange: every kept line and every blanked line advances it.
    string[] outParts = [];
    int runLine = 1;
    int copyStart = 0;
    for (int d = 0; d < dropAt.length; d++) {
        if (dropAt[d] > copyStart) {
            outParts.add(ppNormalizeRange(source, copyStart, dropAt[d], runLine, targetOs, errs));
            // The kept run [copyStart, dropAt[d]) ends on a newline (a drop
            // always starts a line), so it spans exactly its newline count.
            for (int r = copyStart; r < dropAt[d]; r++) {
                if (source[r] == '\n') { runLine++; }
            }
        }
        if (dropNl[d] >= 0) {
            if (dropCr[d] == 1) { outParts.add("\r\n"); }
            else { outParts.add("\n"); }
            runLine++;
        }
        copyStart = (dropNl[d] >= 0) ? dropNl[d] + 1 : srcLen;
    }
    if (copyStart < srcLen) {
        outParts.add(ppNormalizeRange(source, copyStart, srcLen, runLine, targetOs, errs));
    }
    // DOCS/257 — path literals rewrite on the kept text, during region
    // filtering, so stripped regions never see the scan.
    return outParts.join("");
}
