mod export mini_asm;

class MiniAsm {
    public prop int[] buf;
    public prop int[] labelPositions;
    public prop int[] relocLabelIds;
    public prop int[] relocOffsets;
    public prop int[] relocIs32;
    public prop int resolved;

    construct () {
        this.buf = [];
        this.labelPositions = [];
        this.relocLabelIds = [];
        this.relocOffsets = [];
        this.relocIs32 = [];
        this.resolved = 0;
    }

    public void emitU8(int b) {
        this.buf.add(b & 0xFF);
    }

    public void emitU16(int v) {
        this.emitU8(v);
        this.emitU8(v >> 8);
    }

    public void emitU32(int v) {
        this.emitU8(v);
        this.emitU8(v >> 8);
        this.emitU8(v >> 16);
        this.emitU8(v >> 24);
    }

    public void emitU64(int64 v) {
        this.emitU32(v & 0xFFFFFFFF);
        this.emitU32((v >> 32) & 0xFFFFFFFF);
    }

    public void emitBytes(int[] data) {
        for (int i = 0; i < data.length; i++) {
            this.emitU8(data[i]);
        }
    }

    public int[] getBytes() {
        this.resolveRelocs();
        return this.buf;
    }

    public void emitImm64(int reg, int64 imm) {
        this.buf.add(0x48);
        this.buf.add(0xB8 + (reg & 7));
        for (int b = 0; b < 8; b++) {
            this.buf.add((imm >> (b * 8)) & 0xFF);
        }
    }

    public void pushR64(int r) {
        int opcode = 0x50 + (r & 7);
        if (r > 7) { this.emitU8(0x41); }
        this.emitU8(opcode);
    }

    public void popR64(int r) {
        if (r > 7) { this.emitU8(0x41); }
        this.emitU8(0x58 + (r & 7));
    }

    public void movRR64(int dst, int src) {
        int rFlag = 0;
        int sFlag = 0;
        if (src > 7) { rFlag = 1; }
        if (dst > 7) { sFlag = 1; }
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x89);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void movRI64(int dst, int64 imm) {
        int dFlag = 0;
        if (dst > 7) { dFlag = 1; }
        this.emitU8(0x48 | dFlag);
        this.emitU8(0xB8 + (dst & 7));
        int lo = imm & 0xFFFFFFFF;
        this.emitU8(lo);
        this.emitU8(lo >> 8);
        this.emitU8(lo >> 16);
        this.emitU8(lo >> 24);
        int hi = (imm >> 32) & 0xFFFFFFFF;
        this.emitU8(hi);
        this.emitU8(hi >> 8);
        this.emitU8(hi >> 16);
        this.emitU8(hi >> 24);
    }

    public void movRMBase(int r, int base, int disp) {
        int rex = 0x48;
        if (r > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x8B);
        if (base == 5 || base == 13) {
            this.emitU8(0x85 | ((r & 7) << 3) | (base & 7));
            this.emitU32(disp);
        } elif (base == 4 || base == 12) {
            if (disp >= -128 && disp <= 127) {
                this.emitU8(0x44 | ((r & 7) << 3));
                this.emitU8(0x24);
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x84 | ((r & 7) << 3));
                this.emitU8(0x24);
                this.emitU32(disp);
            }
        } else {
            if (disp == 0 && base != 5 && base != 13) {
                this.emitU8(((r & 7) << 3) | (base & 7));
            } elif (disp >= -128 && disp <= 127) {
                this.emitU8(0x40 | ((r & 7) << 3) | (base & 7));
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x80 | ((r & 7) << 3) | (base & 7));
                this.emitU32(disp);
            }
        }
    }

    public void movMBaseR(int base, int r, int disp) {
        int rex = 0x48;
        if (r > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x89);
        if (base == 5 || base == 13) {
            this.emitU8(0x85 | ((r & 7) << 3) | (base & 7));
            this.emitU32(disp);
        } elif (base == 4 || base == 12) {
            if (disp >= -128 && disp <= 127) {
                this.emitU8(0x44 | ((r & 7) << 3));
                this.emitU8(0x24);
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x84 | ((r & 7) << 3));
                this.emitU8(0x24);
                this.emitU32(disp);
            }
        } else {
            if (disp == 0 && base != 5 && base != 13) {
                this.emitU8(((r & 7) << 3) | (base & 7));
            } elif (disp >= -128 && disp <= 127) {
                this.emitU8(0x40 | ((r & 7) << 3) | (base & 7));
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x80 | ((r & 7) << 3) | (base & 7));
                this.emitU32(disp);
            }
        }
    }

    public void movMBaseByteR(int base, int r, int disp) {
        int rex = 0x40;
        if (r > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        if (rex != 0x40) {
            this.emitU8(rex);
        }
        this.emitU8(0x88);
        if (base == 5 || base == 13) {
            this.emitU8(0x85 | ((r & 7) << 3) | (base & 7));
            this.emitU32(disp);
        } elif (base == 4 || base == 12) {
            if (disp >= -128 && disp <= 127) {
                this.emitU8(0x44 | ((r & 7) << 3));
                this.emitU8(0x24);
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x84 | ((r & 7) << 3));
                this.emitU8(0x24);
                this.emitU32(disp);
            }
        } else {
            if (disp == 0 && base != 5 && base != 13) {
                this.emitU8(((r & 7) << 3) | (base & 7));
            } elif (disp >= -128 && disp <= 127) {
                this.emitU8(0x40 | ((r & 7) << 3) | (base & 7));
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x80 | ((r & 7) << 3) | (base & 7));
                this.emitU32(disp);
            }
        }
    }

    public void subRI32(int r, int imm) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        if (imm >= -128 && imm <= 127) {
            this.emitU8(0x83);
            this.emitU8(0xE8 | (r & 7));
            this.emitU8(imm & 0xFF);
        } else {
            this.emitU8(0x81);
            this.emitU8(0xE8 | (r & 7));
            this.emitU32(imm);
        }
    }

    public void addRI32(int r, int imm) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        if (imm >= -128 && imm <= 127) {
            this.emitU8(0x83);
            this.emitU8(0xC0 | (r & 7));
            this.emitU8(imm & 0xFF);
        } else {
            this.emitU8(0x81);
            this.emitU8(0xC0 | (r & 7));
            this.emitU32(imm);
        }
    }

    public void xorRR64(int dst, int src) {
        int rFlag = 0;
        int sFlag = 0;
        if (src > 7) { rFlag = 1; }
        if (dst > 7) { sFlag = 1; }
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x31);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void andRImm(int r, int imm) {
        int rFlag = 0;
        if (r > 7) { rFlag = 1; }
        this.emitU8(0x48 | rFlag);
        if (imm >= -128 && imm <= 127) {
            this.emitU8(0x83);
            this.emitU8(0xE0 | (r & 7));
            this.emitU8(imm & 0xFF);
        } else {
            this.emitU8(0x81);
            this.emitU8(0xE0 | (r & 7));
            this.emitU32(imm);
        }
    }

    public void emitCallSetup(int extraBytes) {
        this.pushR64(13);
        this.movRR64(13, 4);
        this.andRImm(4, -16);
        int total = 32 + extraBytes;
        int alignedTotal = ((total + 15) / 16) * 16;
        this.subRI32(4, alignedTotal);
    }

    public void emitCallTeardown() {
        this.movRR64(4, 13);
        this.popR64(13);
    }

    public void cmpRI32(int r, int imm) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        if (imm >= -128 && imm <= 127) {
            this.emitU8(0x83);
            this.emitU8(0xF8 | (r & 7));
            this.emitU8(imm & 0xFF);
        } else {
            this.emitU8(0x81);
            this.emitU8(0xF8 | (r & 7));
            this.emitU32(imm);
        }
    }

    public void cmpRR64(int r1, int r2) {
        int rex = 0x48;
        if (r2 > 7) { rex = rex + 4; }
        if (r1 > 7) { rex = rex + 1; }
        this.emitU8(rex);
        this.emitU8(0x39);
        this.emitU8(0xC0 | ((r2 & 7) << 3) | (r1 & 7));
    }

    public void ret() {
        this.emitU8(0xC3);
    }

    public void callR64(int r) {
        if (r > 7) { this.emitU8(0x41); }
        this.emitU8(0xFF);
        this.emitU8(0xD0 | (r & 7));
    }

    public void leaRBase(int dst, int base, int disp) {
        int rex = 0x48;
        if (dst > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x8D);
        if (base == 4 || base == 12) {
            this.emitU8(0x80 | ((dst & 7) << 3) | 0x04);
            this.emitU8(0x24);
            this.emitU32(disp);
        } elif (base == 5 || base == 13) {
            this.emitU8(0x85 | ((dst & 7) << 3) | (base & 7));
            this.emitU32(disp);
        } else {
            if (disp == 0) {
                this.emitU8(((dst & 7) << 3) | (base & 7));
            } elif (disp >= -128 && disp <= 127) {
                this.emitU8(0x40 | ((dst & 7) << 3) | (base & 7));
                this.emitU8(disp & 0xFF);
            } else {
                this.emitU8(0x80 | ((dst & 7) << 3) | (base & 7));
                this.emitU32(disp);
            }
        }
    }

    public void addRR64(int dst, int src) {
        int rFlag = 0;
        int sFlag = 0;
        if (src > 7) { rFlag = 1; }
        if (dst > 7) { sFlag = 1; }
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x01);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void shlR64Imm(int reg, int imm) {
        // reg is encoded in the ModRM.rm field, so reg 8-15 needs REX.B (bit 0).
        // (REX.R would be wrong here; that extends the /4 opcode-extension field.)
        int rFlag = 0;
        if (reg > 7) { rFlag = 1; }
        this.emitU8(0x48 | rFlag);
        this.emitU8(0xC1);
        this.emitU8(0xE0 | (reg & 7));
        this.emitU8(imm & 0xFF);
    }

    public void movByteMBaseIdxR(int base, int index, int src) {
        int rb = 0;
        int ri = 0;
        int rs = 0;
        if (base > 7) { rb = 1; }
        if (index > 7) { ri = 1; }
        if (src > 7) { rs = 1; }
        int rex = 0x40 | (rs << 2) | (ri << 1) | rb;
        this.emitU8(rex);
        this.emitU8(0x88);
        if (base == 5 || base == 13) {
            this.emitU8(0x44 | ((src & 7) << 3));
            this.emitU8(((index & 7) << 3) | (base & 7));
            this.emitU8(0);
        } else {
            this.emitU8(0x04 | ((src & 7) << 3));
            this.emitU8(((index & 7) << 3) | (base & 7));
        }
    }

    public void movRImm32(int dst, int imm) {
