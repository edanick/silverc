    public void movRMBaseIdx64(int r, int base, int idx, int scale, int disp) {
        int rex = 0x48;
        if (r > 7) { rex = rex | 0x04; }
        if (idx > 7) { rex = rex | 0x02; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x8B);
        this.emitU8(0x84 | ((r & 7) << 3) | 0x04);
        this.emitU8((scale << 6) | ((idx & 7) << 3) | (base & 7));
        this.emitU32(disp);
