    private bool customDeclaredCg(string name) {
        if (name.length == 0) { return false; }
        return this.customNative.declared(name);
    }

    private string customEffectiveTarget() {
        if (this.targetOs.length > 0) { return this.targetOs; }
        return "WINDOWS";
    }

    // DOCS/261 bare custom grants (`import { f } from m;`,
    // `import * from m;`): declared names resolve per targetOs with no `#on`
    // regions. Undeclared bare names are Silver (no grant, no error);
    // declared-but-wrong-side and star-without-list fail here. Single grants
    // need no export list. Lazy: only called functions later emit imports.
    public void registerCustomBareImport(Node node) {
        string source = node.typeHint;
        if (source.length == 0) { return; }
        if (source == "win32" || source == "linux") { return; }
        if (source.length > 6 && projectSlice(source, 0, 6) == "win32.") { return; }
        if (source.length > 6 && projectSlice(source, 0, 6) == "linux.") { return; }
        if (projectIsStdModule(source) || projectBuiltin(source)) { return; }
        if (!this.customNative.declared(source)) { return; }
        string target = this.customEffectiveTarget();
        string file = this.customNative.fileFor(source, target);
        if (file.length == 0) {
            printline("Error: " + nativeSideError(this.customNative, source, target));
            exit(1);
            return;
        }
        bool isLinux = target == "LINUX";
        if (node.isStatic) {
            if (!this.customNative.starAllowed(source, target)) {
                printline("Error: " + nativeStarMsg(source));
                exit(1);
                return;
            }
            string exps = this.customNative.exportsFor(source, target);
            int s = 0;
            while (s < exps.length) {
                while (s < exps.length && (exps[s] == ' ' || exps[s] == '\t')) { s++; }
                int e = s;
                while (e < exps.length && exps[e] != ' ' && exps[e] != '\t') { e++; }
                if (e > s) {
                    string nm = projectSlice(exps, s, e);
                    if (isLinux) { this.linuxAddGrant(file, nm); }
                    else { this.win32AddGrant(file, nm); }
                }
                s = e;
            }
            return;
        }
        if (isLinux) {
            this.linuxAddGrantNamed(file, node);
            for (int j = 0; j < node.childCount(); j++) {
                this.linuxAddGrantNamed(file, node.child(j));
            }
        } else {
            this.win32AddGrantNamed(file, node);
            for (int k = 0; k < node.childCount(); k++) {
                this.win32AddGrantNamed(file, node.child(k));
            }
        }
    }

    // Inverse of win32ModuleDll: first module alias for a DLL.
    public string win32ModuleOf(string dll) {
        return this.windowsBackend.win32ModuleOf(dll);
    }

    public int findLocal(string name) {
        // Search from the most recent local backward. The flat local table has
        // no lexical scopes and codegen appends temporaries as it goes, so a
        // name can legitimately appear several times (e.g. every
        // `catch (Exception e)` declares `e`). The most recent declaration is

        // the one in scope for the code being generated now, which is what the
        // forward scan used to get wrong: every catch after the first resolved
        // to the FIRST catch's slot and read the first thrown value.
        for (int i = this.localNames.length - 1; i >= 0; i--) {
            if (this.localNames[i] == name) {
                return this.localOffsets[i];
            }
        }
        return 0;
    }

    public int findGlobal(string name) {
        for (int i = 0; i < this.globalNames.length; i++) {
            if (this.globalNames[i] == name) {
                return i;
            }
        }
        return -1;
    }

    // Parity with silverc-rs type_checker.rs check_assignment_target: an
    // assignment to a plain name must resolve to a declared local, a
    // declared file-scope global, or (inside a class method) a bare field
    // of the current class.  The old miss fallback silently stored through
    // [rbp+0], corrupting the frame.  Writes to declared globals are
    // rejected by the MemoryGuard before codegen runs; this check only
    // catches names that resolve to nothing at all.
    public void requireResolvableAssignTarget(Node lhs) {
        if (lhs.name.length == 0) { return; }
        if (this.findLocal(lhs.name) != 0) { return; }
        if (this.findGlobal(lhs.name) >= 0) { return; }
        if (this.currentClassName != "") {
            if (this.findFieldOffset(this.currentClassName, lhs.name) >= 0) { return; }
        }
        printline(lhs.line.toString() + ":" + lhs.col.toString() + ": Undefined variable '" + lhs.name + "'");
        exit(1);
    }

    // Parity with silverc-rs: anonymous function bodies are isolated scopes
    // (DOCS/259) and file-scope globals are not writable from any function
    // body.  The MemoryGuard cannot see into an anonymous body, so codegen
    // enforces the same rule here with the Guard's global-write wording.
    public void rejectGlobalWriteInAnonBody(Node lhs) {
        if (!this.inAnonBody) { return; }
        if (lhs.name.length == 0) { return; }
        if (this.findLocal(lhs.name) != 0) { return; }
        if (this.findGlobal(lhs.name) < 0) { return; }
        printline("GuardError: InvalidAssignment at line " + lhs.line.toString() + ", column " + lhs.col.toString() + ": " + lhs.name + ": cannot write to a global or const");
        exit(1);
    }

    public void genGlobalLoad(int gi) {
        // Load the 8-byte global slot value into RAX.  The slot's absolute
        // address is patched after codegen (see patchGlobalRefs).
        int sp = this.asm.buf.length;
        this.asm.emitImm64(0, 0);
        this.globalPatchOffsets.add(sp + 2);
        this.globalPatchIndices.add(gi);
        this.asm.movRMBase(0, 0, 0);
    }

    public void genGlobalStore(int gi) {
        // Store the value currently in RAX into the global slot.  Mirrors
        // genGlobalLoad but dereferences the patched slot address as a store.
        this.asm.pushR64(0);
        int sp = this.asm.buf.length;
        this.asm.emitImm64(0, 0);
        this.globalPatchOffsets.add(sp + 2);
        this.globalPatchIndices.add(gi);
        this.asm.popR64(1);
        this.asm.movMBaseR(0, 1, 0);
    }

    public void emitExceptionJump() {
        if (this.currentCatch >= 0) {
            this.asm.jmpLabel(this.currentCatch);
        } else if (this.currentFinally >= 0) {
            this.asm.jmpLabel(this.currentFinally);
        } else if (this.currentExcHandler >= 0) {
            this.asm.jmpLabel(this.currentExcHandler);
        } else {
            this.asm.jmpLabel(this.currentReturnLabel);
        }
    }

    public void emitReturnJump() {
        if (this.currentFinally >= 0) {
            this.asm.movMBaseR(5, 0, this.currentFinallyRetVal);
            this.asm.movRI64(0, 1);
            this.asm.movMBaseR(5, 0, this.currentFinallyRetFlag);
            this.asm.jmpLabel(this.currentFinally);
        } else {
            this.asm.jmpLabel(this.currentReturnLabel);
        }
    }

    public void emitThrowException(string message) {
        // Allocate a 32-byte exception object with the std Exception layout
        // (message@0, line@8, column@16, reason@24), store it in the global
        // exception state, and dispatch to the nearest handler.
        int sizeOff = this.allocLocal("__exc_size");
        this.asm.movRI64(0, 32);
        this.asm.movMBaseR(5, 0, sizeOff);
        this.emitLlmaiHeapAlloc(sizeOff);
        int objOff = this.allocLocal("__exc_obj");
        this.asm.movMBaseR(5, 0, objOff);
        this.emitLlmaiStringLiteral(message);
        this.asm.movRMBase(1, 5, objOff);
        this.asm.movMBaseR(1, 0, 0);
        this.asm.movMBaseR(1, 0, 24);
        this.asm.xorRR64(2, 2);
        this.asm.movMBaseR(1, 2, 8);
        this.asm.movMBaseR(1, 2, 16);
        int evIdx = this.findGlobal("__exc_value");
        this.asm.movRMBase(0, 5, objOff);
        this.genGlobalStore(evIdx);
        this.asm.movRI64(0, 1);
        int eaIdx = this.findGlobal("__exc_active");
        this.genGlobalStore(eaIdx);
        this.emitExceptionJump();
    }

    public void emitDivisorCheck() {
        // RCX holds the divisor before an idiv. Throw DivideByZeroException
        // when it is zero.
        int ok = this.newLabel();
        this.asm.cmpRI32(1, 0);
        this.asm.jneLabel(ok);
        this.emitThrowException("division by zero");
        this.asm.bindLabel(ok);
    }

    public void emitIndexBoundsCheck() {
        // RAX = array pointer, RCX = index (unscaled). Throws
        // IndexOutOfRangeException when index < 0 or index >= [RAX - 8]
        // (the array length stored immediately before the element data).
        int oob = this.newLabel();
        int ok = this.newLabel();
        this.asm.cmpRI32(1, 0);
        this.asm.jlLabel(oob);
        this.asm.movRMBase(2, 0, -8);
        this.asm.cmpRR64(1, 2);
        this.asm.jgeLabel(oob);
        this.asm.jmpLabel(ok);
        this.asm.bindLabel(oob);
        this.emitThrowException("index out of range");
        this.asm.bindLabel(ok);
    }

    public void emitExcCheck() {
        // After a user-function call, branch to the nearest handler (or unwind
        // via the return label) when the exception flag is set. Uses RCX as
        // scratch so RAX (the call's return value) is preserved on the
        // non-exceptional path.
        int eaIdx = this.findGlobal("__exc_active");
        int ok = this.newLabel();
        int sp = this.asm.buf.length;
        this.asm.emitImm64(1, 0);
        this.globalPatchOffsets.add(sp + 2);
        this.globalPatchIndices.add(eaIdx);
        this.asm.movRMBase(1, 1, 0);
        this.asm.cmpRI32(1, 0);
        this.asm.jeLabel(ok);
        this.emitExceptionJump();
        this.asm.bindLabel(ok);
    }

    public void patchGlobalRefs(int[] code, int globalsStart, int rdataRva) {
        // LINUX SysV backend (additive): globals live in the ELF RW data
        // segment right after stringData (mini_pe LINUX build() zero-pads
        // dataLen = stringData + globalAreaSize), so the address is
        // elfDataVaddr() + globalsStart + globalOffsets[gi]. The WINDOWS
        // loop below is byte-identical to before.
        if (this.isLinuxTarget()) {
            int dataBase = this.elfDataVaddr();
            for (int i = 0; i < this.globalPatchOffsets.length; i++) {
                int patchPos = this.globalPatchOffsets[i];
                int gi = this.globalPatchIndices[i];
                int64 addr = dataBase + globalsStart + this.globalOffsets[gi];
                code[patchPos] = addr & 0xFF;
                code[patchPos + 1] = (addr >> 8) & 0xFF;
                code[patchPos + 2] = (addr >> 16) & 0xFF;
                code[patchPos + 3] = (addr >> 24) & 0xFF;
                code[patchPos + 4] = (addr >> 32) & 0xFF;
                code[patchPos + 5] = (addr >> 40) & 0xFF;
                code[patchPos + 6] = (addr >> 48) & 0xFF;
                code[patchPos + 7] = (addr >> 56) & 0xFF;
            }
            return;
        }
        for (int i = 0; i < this.globalPatchOffsets.length; i++) {
            int patchPos = this.globalPatchOffsets[i];
            int gi = this.globalPatchIndices[i];
            int64 addr = 0x140000000 + rdataRva + globalsStart + this.globalOffsets[gi];
            code[patchPos] = addr & 0xFF;
            code[patchPos + 1] = (addr >> 8) & 0xFF;
            code[patchPos + 2] = (addr >> 16) & 0xFF;
            code[patchPos + 3] = (addr >> 24) & 0xFF;
            code[patchPos + 4] = (addr >> 32) & 0xFF;
            code[patchPos + 5] = (addr >> 40) & 0xFF;
            code[patchPos + 6] = (addr >> 48) & 0xFF;
            code[patchPos + 7] = (addr >> 56) & 0xFF;
        }
    }

    public int allocLocal(string name) {
        this.stackSize += 8;
        int off = -8 * (this.localOffsets.length + 1);
        this.localOffsets.add(off);
        this.localNames.add(name);
        this.localTypes.add("");
        return off;
    }

    public void emitPrologue() {
        this.asm.pushR64(5);
        this.asm.movRR64(5, 4);
        this.asm.subRI32(4, 32);
        this.asm.pushR64(15);
        this.asm.pushR64(13);
        this.asm.pushR64(12);
        this.asm.movRR64(15, 4);
    }

    public void emitEpilogue() {
        this.asm.popR64(12);
        this.asm.popR64(13);
        this.asm.popR64(15);
        this.asm.addRI32(4, this.stackSize);
        this.asm.popR64(5);
        this.asm.ret();
    }

    public int[] computeIatAddresses(int[] layout) {
        // LINUX SysV backend (additive): on the Linux target the returned
        // vector holds absolute ELF GOT slot addresses (flat import order)
        // instead of PE IAT RVAs. The PE arithmetic below is untouched.
        if (this.isLinuxTarget()) {
            return this.computeGotAddresses();
        }
        int stringsStart = layout[0];
        int numGroups = layout[1];
        int iltTotal = layout[2];
        int[] iatAddrs = [];
        for (int i = 0; i < this.importDlls.length; i++) {
            iatAddrs.add(0);
        }
        string[] uniqueDlls = [];
        int[] groupSizes = [];
        int[] importGroupIdx = [];
        for (int i = 0; i < this.importDlls.length; i++) {
            int gIdx = -1;
            for (int j = 0; j < uniqueDlls.length; j++) {
                if (uniqueDlls[j] == this.importDlls[i]) {
                    gIdx = j;
                    break;
                }
            }
            if (gIdx < 0) {

                uniqueDlls.add(this.importDlls[i]);
                groupSizes.add(0);
                gIdx = uniqueDlls.length - 1;
            }
            groupSizes[gIdx]++;
            importGroupIdx.add(gIdx);
        }
        int[] posInGroup = [];
        for (int i = 0; i < this.importDlls.length; i++) {
            posInGroup.add(0);
        }
        int[] runningCount = [];
        for (int g = 0; g < uniqueDlls.length; g++) {
            runningCount.add(0);
        }
        for (int i = 0; i < this.importDlls.length; i++) {
            int g = importGroupIdx[i];
            posInGroup[i] = runningCount[g];
            runningCount[g]++;
        }
        int[] groupStart = [];
        int runningOff = 0;
        for (int g = 0; g < uniqueDlls.length; g++) {
            groupStart.add(runningOff);
            runningOff = runningOff + groupSizes[g] * 8 + 8;
        }
        int descBytes = (numGroups + 1) * 20;
        for (int i = 0; i < this.importDlls.length; i++) {
            int g = importGroupIdx[i];
            iatAddrs[i] = descBytes + iltTotal + groupStart[g] + posInGroup[i] * 8;
        }
        return iatAddrs;
    }

    // LINUX SysV backend (additive): ELF code-segment base. Mirrors
    // compiler/mini_pe.sr LINUX build() (BASE + TEXT_RVA): emitted code
    // runs at rxVaddr, so code offset N addresses 0x401000 + N. Pure
    // layout math, shared by every Linux patch pass.
    public int elfCodeVaddr() {
        return this.linuxBackend.elfCodeVaddr();
    }

    // LINUX SysV backend (additive): ELF RW data-segment base (strings +
    // globals + runtime state). Mirrors mini_pe LINUX build(): the RX code
    // segment is page-padded, data follows it page-aligned. Call only after
    // the final code length is known (same point computeIatAddresses runs).
    public int elfDataVaddr() {
        return this.linuxBackend.elfDataVaddr(this);
    }

    // LINUX SysV backend (additive): absolute GOT slot addresses in flat
    // import order (rwVaddr + 24 + i*8: 3 reserved header zeros, then one
    // slot per import). Mirrors mini_pe LINUX build() and the silverc-rs
    // elf::plan().got_addrs vector. NOTE (R-overflow guard): imports are
    // deduped by findImport, so the slot count stays bounded by the distinct
    // libc symbols (~dozens); the R tables then always fit their page and
    // the fixed rxOff = PAGE layout shared with mini_pe stays valid.
    public int[] computeGotAddresses() {
        return this.linuxBackend.computeGotAddresses(this);
    }

    // MAC Mach-O backend (additive): fixed v1 header length (mach_header_64
    // + load commands). Mirrors the mini_pe MAC build() size math.
    public int machoHeaderLen() {
        return this.macBackend.machoHeaderLen();
    }

    // MAC Mach-O backend (additive): __TEXT code-segment base
    // (TEXT_VMADDR + headerLen). Mirrors the mini_pe MAC build().
    public int64 machoCodeVaddr() {
        return this.macBackend.machoCodeVaddr();
    }

    // MAC Mach-O backend (additive): __DATA segment base (__got + data).
    // Mirrors the mini_pe MAC build(): 16KB pages, 12-byte stubs per import.
    public int64 machoDataVaddr() {
        return this.macBackend.machoDataVaddr(this);
    }

    // MAC Mach-O backend (additive): absolute __got bind-slot addresses in
    // flat import order (dataVaddr + i*8). Mirrors the mini_pe MAC build().
    public int64[] computeMacGotAddresses() {
        return this.macBackend.computeMacGotAddresses(this);
    }

    public void patchImportRefs(int[] code, int[] iatAddrs, int rdataRva) {
        // WINDOWS-TARGET: rewrites every import call site to the absolute
        // PE IAT slot address (0x140000000 + rdataRva + iatOff). The Linux
        // backend replaces this pass with its own relocation/GOT patching.
        #on WINDOWS
        for (int i = 0; i < this.importPatchOffsets.length; i++) {
            int patchPos = this.importPatchOffsets[i];
            int funcIdx = this.importPatchFuncIndices[i];
            int iatOff = iatAddrs[funcIdx];
            int64 addr = 0x140000000 + rdataRva + iatOff;
            code[patchPos] = addr & 0xFF;
            code[patchPos + 1] = (addr >> 8) & 0xFF;
            code[patchPos + 2] = (addr >> 16) & 0xFF;
            code[patchPos + 3] = (addr >> 24) & 0xFF;
            code[patchPos + 4] = (addr >> 32) & 0xFF;
            code[patchPos + 5] = (addr >> 40) & 0xFF;
            code[patchPos + 6] = (addr >> 48) & 0xFF;
            code[patchPos + 7] = (addr >> 56) & 0xFF;
        }
        #off
        #on LINUX
        // Linux backend: patch import call sites against the ELF GOT model
        // (PLT-less direct-GOT calls: movabs rax,<got>; mov rax,[rax];
        // call rax). computeIatAddresses carries absolute GOT addresses in
        // iatAddrs on this target (mirror of the silverc-rs sentinel->GOT
        // loop with the 0x400000 base), so the loop stores them directly
        // instead of adding the 0x140000000 PE image base.
        for (int i = 0; i < this.importPatchOffsets.length; i++) {
            int patchPos = this.importPatchOffsets[i];
            int funcIdx = this.importPatchFuncIndices[i];
            int64 addr = iatAddrs[funcIdx];
            code[patchPos] = addr & 0xFF;
            code[patchPos + 1] = (addr >> 8) & 0xFF;
            code[patchPos + 2] = (addr >> 16) & 0xFF;
            code[patchPos + 3] = (addr >> 24) & 0xFF;
            code[patchPos + 4] = (addr >> 32) & 0xFF;
            code[patchPos + 5] = (addr >> 40) & 0xFF;
            code[patchPos + 6] = (addr >> 48) & 0xFF;
            code[patchPos + 7] = (addr >> 56) & 0xFF;
        }
        #off
    }

    public void patchStringRefs(int[] code, int stringsStart, int rdataRva) {
        // LINUX SysV backend (additive): strings live in the ELF RW data
        // segment at elfDataVaddr() + stringsStart + dataOff (mini_pe LINUX
        // build() copies stringData to dataOff). The WINDOWS loop below is
        // byte-identical to before.
        if (this.isLinuxTarget()) {
            int dataBase = this.elfDataVaddr();
            for (int i = 0; i < this.stringPatchOffsets.length; i++) {
                int patchPos = this.stringPatchOffsets[i];
                int strIdx = this.stringPatchIndices[i];
                StrEntry se = this.strings[strIdx];
                int dataOff = se.dataOffset;
                int64 addr = dataBase + stringsStart + dataOff;
                code[patchPos] = addr & 0xFF;
                code[patchPos + 1] = (addr >> 8) & 0xFF;
                code[patchPos + 2] = (addr >> 16) & 0xFF;
                code[patchPos + 3] = (addr >> 24) & 0xFF;
                code[patchPos + 4] = (addr >> 32) & 0xFF;
                code[patchPos + 5] = (addr >> 40) & 0xFF;
                code[patchPos + 6] = (addr >> 48) & 0xFF;
                code[patchPos + 7] = (addr >> 56) & 0xFF;
            }
            return;
        }
        for (int i = 0; i < this.stringPatchOffsets.length; i++) {
            int patchPos = this.stringPatchOffsets[i];
int strIdx = this.stringPatchIndices[i];
        StrEntry se2 = this.strings[strIdx];
        int dataOff = se2.dataOffset;
            int64 addr = 0x140000000 + rdataRva + stringsStart + dataOff;
            code[patchPos] = addr & 0xFF;
            code[patchPos + 1] = (addr >> 8) & 0xFF;
            code[patchPos + 2] = (addr >> 16) & 0xFF;
            code[patchPos + 3] = (addr >> 24) & 0xFF;
            code[patchPos + 4] = (addr >> 32) & 0xFF;
            code[patchPos + 5] = (addr >> 40) & 0xFF;
            code[patchPos + 6] = (addr >> 48) & 0xFF;
            code[patchPos + 7] = (addr >> 56) & 0xFF;
        }
    }

    public void genProgram(Node[] program) {
        this.collectClassLayouts(program);
        for (int i = 0; i < program.length; i++) {
            Node pi = program[i];
            if (pi.kind == 104) {
                this.constNames.add(pi.name);
                if (pi.childCount() > 0 && pi.child(0).kind == 0) {
                    this.constValues.add(pi.child(0).intVal);
                    this.constStringValues.add("");
                    this.constIsString.add(0);
                } else if (pi.childCount() > 0 && pi.child(0).kind == 2) {
                    this.constValues.add(0);
                    this.constStringValues.add(pi.child(0).strVal);
                    this.constIsString.add(1);
                } else {
                    this.constValues.add(0);
                    this.constStringValues.add("");
                    this.constIsString.add(0);
                }
            }
            if (pi.kind == 105 && (pi.typeHint.length > 0 || pi.isStatic)) {
                // DOCS/213 -- import statement (win32 module grants or a
                // no-op source-module marker). Registered, not treated as an
                // enum.
                this.registerWin32Import(pi);
                // LINUX SysV backend (additive): linux imports resolve beside
                // win32 ones (registrars self-filter by source namespace).
                this.registerLinuxImport(pi);
                // DOCS/261 bare custom grants resolve per targetOs beside them.
                this.registerCustomBareImport(pi);
                // Source-module imports are
                // remembered so dotted-new `new mod.Class(...)` resolves
                // through the module's flattened namespace. Native win32
                // sources carry no Silver classes, and neither do the
                // built-in stdlib modules (STDLIB_MODULES), so neither kind
                // becomes a user module — mirroring the Rust compiler.
                // DOCS/261: declared bare customs are native too, never user
                // modules (their dormant grant is harmless; calls resolve
                // user-first, lazily).
                string src = pi.typeHint;
                bool srcIsWin32 = src == "win32";
                if (!srcIsWin32 && src.length > 6) {
                    if (projectSlice(src, 0, 6) == "win32.") { srcIsWin32 = true; }
                }
                bool srcIsLinux = src == "linux";
                if (!srcIsLinux && src.length > 6) {
                    if (projectSlice(src, 0, 6) == "linux.") { srcIsLinux = true; }
                }
                bool srcIsCustom = false;
                if (!srcIsWin32 && !srcIsLinux && src.length > 0 && this.customNative.declared(src)) { srcIsCustom = true; }
                if (!srcIsWin32 && !srcIsLinux && !srcIsCustom && src.length > 0 && !this.isStdlibModuleName(src)) {
                    this.userModuleNames.add(src);
                }
            } else if (pi.kind == 105) {
                this.enumNames.add(pi.name);
                for (int j = 0; j < pi.childCount(); j++) {
                    Node member = pi.child(j);
                    string fullName = pi.name + "." + member.name;
                    this.constNames.add(fullName);
                    this.constValues.add(member.intVal);
                    this.constStringValues.add("");
                    this.constIsString.add(0);
                }
            }
            // Legacy `def Name = enum { A, B, ... };` (kind 103, rejected
            // by the parser since the enum-spelling reform): same shape as
            // the `enum Name { ... }` form but the members were parsed as
            // patterns (identifiers) instead of dedicated enum members.
            // Kept registering its sequential integer values so old
            // bytecode stays readable; the parser no longer produces it.
            if (pi.kind == 103) {
                this.enumNames.add(pi.name);
                for (int j = 0; j < pi.childCount(); j++) {
                    Node member = pi.child(j);
                    string fullName = pi.name + "." + member.name;
                    this.constNames.add(fullName);
                    this.constValues.add(j);
                    this.constStringValues.add("");
                    this.constIsString.add(0);
                }
            }

        }
        for (int i = 0; i < program.length; i++) {
            Node pg = program[i];
            if (pg.kind == 50) {
                this.globalNames.add(pg.name);
                this.globalTypes.add(pg.typeHint);
                this.globalOffsets.add(this.globalOffsets.length * 8);
                if (pg.childCount() > 0) {
                    this.globalInits.add(pg.child(0));
                } else {
                    Node missing = new Node(); missing.kind = 255;
                    this.globalInits.add(missing);
                }
            }
        }
        // WINDOWS-TARGET: the exception-state globals of the cooperative
        // throw/catch model (__exc_active flag + __exc_value object slot).
        #on WINDOWS
        // Reserve two writable global slots for the exception state: an
        // active flag and the thrown value. Registered after user globals so
        // their indices are stable and the init stub zeroes them.
        this.globalNames.add("__exc_active");
        this.globalTypes.add("int");
        this.globalOffsets.add(this.globalOffsets.length * 8);
        Node excMissing1 = new Node(); excMissing1.kind = 255;
        this.globalInits.add(excMissing1);
        this.globalNames.add("__exc_value");
        this.globalTypes.add("int");
        this.globalOffsets.add(this.globalOffsets.length * 8);
        Node excMissing2 = new Node(); excMissing2.kind = 255;
        this.globalInits.add(excMissing2);
        #off
        #on LINUX
        // Linux backend: the same two exception-state slots (the cooperative
        // label-dispatch model is OS-independent; the woven throw/catch
        // emitters resolve these names via findGlobal). Plus
        // __linux_stack_top: the entry stub captures the _start RSP here so
        // genCargsCall rebuilds argc/argv from it. Same shapes as WINDOWS.
        this.globalNames.add("__exc_active");
        this.globalTypes.add("int");
        this.globalOffsets.add(this.globalOffsets.length * 8);
        Node excMissing1 = new Node(); excMissing1.kind = 255;
        this.globalInits.add(excMissing1);
        this.globalNames.add("__exc_value");
        this.globalTypes.add("int");
        this.globalOffsets.add(this.globalOffsets.length * 8);
        Node excMissing2 = new Node(); excMissing2.kind = 255;
        this.globalInits.add(excMissing2);
        this.globalNames.add("__linux_stack_top");
        this.globalTypes.add("int");
        this.globalOffsets.add(this.globalOffsets.length * 8);
        Node stkMissing = new Node(); stkMissing.kind = 255;
        this.globalInits.add(stkMissing);
        #off
        if (this.globalNames.length > 0) {
            this.globalAreaSize = this.globalNames.length * 8;
        }
        for (int i = 0; i < program.length; i++) {
            Node pi = program[i];
            if (pi.kind == 100) {
                this.funcNames.add(pi.name);
                this.funcClasses.add("");
                this.funcRetTypes.add(pi.typeHint);
                this.funcOffsets.add(-1);
                int paramStart = this.funcParamDefaults.length;
                int paramCount = 0;
                bool hasVariadic = false;
                if (pi.childCount() > 0) {
                    Node params = pi.child(0);
                    paramCount = params.childCount();
                    for (int p = 0; p < params.childCount(); p++) {
                        Node param = params.child(p);
                        this.funcParamTypes.add(param.typeHint);
                        if (param.isVariadic) { hasVariadic = true; }
                        if (param.childCount() > 0) {
                            this.funcParamHasDefaults.add(1);
                            this.funcParamDefaults.add(param.child(0));
                        } else {
                            Node missing = new Node(); missing.kind = 255;
                            this.funcParamHasDefaults.add(0);
                            this.funcParamDefaults.add(missing);
                        }
                    }
                }
                this.funcParamStarts.add(paramStart);
                this.funcParamCounts.add(paramCount);
                this.funcHasVariadic.add(hasVariadic ? 1 : 0);
            }
        }
        for (int i = 0; i < program.length; i++) {
            Node pi2 = program[i];
            if (pi2.kind == 102) {
                for (int j = 0; j < pi2.childCount(); j++) {
                    Node member = pi2.child(j);
                    if (member.kind == 100) {
                        this.funcNames.add(member.name);
                        this.funcClasses.add(pi2.name);
                        this.funcRetTypes.add(member.typeHint);
                        this.funcOffsets.add(-1);
                        int paramStart = this.funcParamDefaults.length;
                        int paramCount = 0;
                        bool hasVariadic = false;
                        if (member.childCount() > 0) {
                            Node params = member.child(0);
                            paramCount = params.childCount();
                            for (int p = 0; p < params.childCount(); p++) {
                                Node param = params.child(p);
                                this.funcParamTypes.add(param.typeHint);
                                if (param.isVariadic) { hasVariadic = true; }
                                if (param.childCount() > 0) {
                                    this.funcParamHasDefaults.add(1);
                                    this.funcParamDefaults.add(param.child(0));
                                } else {
                                    Node missing = new Node(); missing.kind = 255;
                                    this.funcParamHasDefaults.add(0);
                                    this.funcParamDefaults.add(missing);
                                }
                            }
                        }
                        this.funcParamStarts.add(paramStart);
                        this.funcParamCounts.add(paramCount);
                        this.funcHasVariadic.add(hasVariadic ? 1 : 0);
                    }
                }
            }
        }
        for (int i = 0; i < program.length; i++) {
            Node pi3 = program[i];
            if (pi3.kind == 100) {
                this.scanRefCalls(pi3);
            }
        }
        for (int i = 0; i < program.length; i++) {
            Node pi4c = program[i];
            if (pi4c.kind == 102) {
                for (int j = 0; j < pi4c.childCount(); j++) {
                    Node member = pi4c.child(j);
                    if (member.kind == 100) {
                        this.scanRefCalls(member);
                    }
                }
            }
        }
        // Phase-B progress: total function bodies this program will emit
        // (free functions + class methods) so the driver can print
        // `codegen: N/M functions` ticks during long compiles.
        int fnTotal = 0;
        for (int i = 0; i < program.length; i++) {
            Node item = program[i];
            if (item.kind == 100) { fnTotal++; }
            if (item.kind == 102) {
                for (int j = 0; j < item.childCount(); j++) {
                    Node member = item.child(j);
                    if (member.kind == 100) { fnTotal++; }
                }
            }
        }
        int fnDone = 0;
        for (int i = 0; i < program.length; i++) {
            Node pi3 = program[i];
            if (pi3.kind == 100) {
                this.emitFunction(pi3);
                fnDone++;
                this.reportFnProgress(fnDone, fnTotal);
            }
        }

        for (int i = 0; i < program.length; i++) {
            Node pi4 = program[i];
            if (pi4.kind == 102) {
                for (int j = 0; j < pi4.childCount(); j++) {
                    Node member = pi4.child(j);
                    if (member.kind == 100) {
                        this.emitMethod(member, pi4.name);
                        fnDone++;
                        this.reportFnProgress(fnDone, fnTotal);
                    }
                }
            }
        }
        // DOCS/259: emit queued anonymous function bodies as standalone
        // functions and patch their address placeholders to absolute VAs.
        this.drainAnonFunctions();
        if (this.globalNames.length > 0) {
            this.emitGlobalInitStub();
        }
        if (this.hasMain == false) {
            // Sources without a main function still produce a valid
            // executable: synthesize an entry that exits with status 0.
            this.mainLabelOffset = this.asm.buf.length;
            #on WINDOWS
            this.asm.xorRR64(0, 0);
            this.asm.movRR64(1, 0);
            this.addImportPatch("kernel32.dll", "ExitProcess");
            int sSyn = 0xDEADBEEFCAFEBABE;
            this.asm.emitImm64(0, sSyn);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            #off
            #on LINUX
            // Linux backend: exit(0) through libc. RDI is the first SysV
            // argument register; Direct (no shuffle: RDI preset here).
            // mainLabelOffset stays assigned above so driver entry plumbing
            // is intact.
            this.asm.xorRR64(7, 7);
            this.addImportPatchDirect("libc.so.6", "exit");
            this.asm.emitImm64(0, 0);
            this.asm.movRMBase(0, 0, 0);
            this.emitAbiCallSetup(0);
            this.asm.callR64(0);
            this.emitAbiCallTeardown();
            #off
        }
        // OVERHAUL.md --runtime: append the embedded allocator + GC entry
        // points after all program code, then an entry trampoline that brings
        // the runtime up before user code or global initializers run.
        if (this.runtimeMode) {
            this.emitRuntimeFunctions();
            this.emitRuntimeEntryStub();
        }
    }

    // Phase-B progress: bump the emitted-function counter and forward it to
    // the driver's reporter (when installed) so long compiles show movement.
    private void reportFnProgress(int done, int total) {
        if (this.progress != null) {
            this.progress.codegenTick(done, total);
        }
    }

    public void scanRefCalls(Node func) {
        // Walk the function body (child 1) for call sites that pass `&arg`.
        // Record (callee name, param index) so emitFunction knows which
        // parameters are bound by reference and must be dereferenced on every
        // read and written-through on every store.
        if (func.childCount() > 1) {
            this.scanRefTree(func.child(1));
        }
    }

    public void scanRefTree(Node node) {
        // Check every call node for arguments that are `&expr` (kind 8, op 3).
        if ((node.kind == 9 || node.kind == 10) && node.childCount() > 0) {
            int argStart = 0;
            if (node.isMember) { argStart = 1; }
            for (int ai = argStart; ai < node.childCount(); ai++) {
                Node arg = node.child(ai);
                if (arg.kind == 8 && arg.op == 3) {
                    this.refCalleeNames.add(node.name);
                    this.refCalleeParams.add(ai - argStart);
                }
            }
        }
        for (int i = 0; i < node.childCount(); i++) {
            this.scanRefTree(node.child(i));
        }
    }

    public void collectRefParams(Node func) {
        // Populate this.refParams with the names of the current function's
        // parameters that some call site passes as `&arg`.
        this.refParams = [];
        if (func.childCount() < 1) { return; }
        Node params = func.child(0);
        for (int ri = 0; ri < this.refCalleeNames.length; ri++) {
            if (this.refCalleeNames[ri] == func.name) {
                int idx = this.refCalleeParams[ri];
                if (idx >= 0 && idx < params.childCount()) {
                    this.refParams.add(params.child(idx).name);
                }
            }
        }
    }

    public bool isRefParam(string name) {
        for (int ri = 0; ri < this.refParams.length; ri++) {
            if (this.refParams[ri] == name) { return true; }
        }
        return false;
    }

    // Register one of the embedded --runtime helper functions in the function
    // tables so the ordinary forward-call patching resolves calls to it.
    public void rtRegisterFunc(string fname) {
        int off = this.asm.buf.length;
        bool existed = false;
        for (int i = 0; i < this.funcNames.length; i++) {
            if (this.funcNames[i] == fname && this.funcOffsets[i] == -1) {
                this.funcOffsets[i] = off;
                existed = true;
            }
        }
        if (!existed) {
            this.funcNames.add(fname);
            this.funcClasses.add("");
            this.funcRetTypes.add("void");
            this.funcOffsets.add(off);
        }
    }

    // WINDOWS-TARGET: the embedded --runtime heap is built on the Win32
    // allocator (VirtualAlloc reserve + HeapAlloc fallback). The Linux
    // backend replaces the whole cluster with mmap/malloc equivalents.
    #on WINDOWS
    // Emit `movabs reg, <runtime state>` and remember the immediate's patch
    // position; the driver fills in the state block's absolute address after
    // the PE layout is known.
    public void emitRtStateAddr(int reg) {
        this.rtStatePatchOffsets.add(this.asm.buf.length + 2);
        this.asm.emitImm64(reg, 0);
    }

    public void emitRuntimeFunctions() {
        // ---- __silver_rt_init ------------------------------------------
        // VirtualAlloc(NULL, RT_HEAP_RESERVE, MEM_COMMIT|MEM_RESERVE,
        //              PAGE_READWRITE); on success records base/offset in the
        // writable state block. On failure the allocator falls back to the
        // process heap for the whole run.
        this.rtRegisterFunc("__silver_rt_init");
        this.rtInitOffset = this.asm.buf.length;
        int okLbl = this.newLabel();
        this.asm.emitCallSetup(0);
        this.asm.xorRR64(1, 1);
        this.asm.movRI64(2, 16777216);
        this.asm.movRI64(8, 12288);
        this.asm.movRI64(9, 4);
        this.addImportPatch("kernel32.dll", "VirtualAlloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.orRR64(0, 0);
        this.asm.jeLabel(okLbl);
        this.emitRtStateAddr(10);
        this.asm.movMBaseR(10, 0, 0);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(10, 0, 8);
        this.asm.bindLabel(okLbl);
        this.asm.ret();

        // ---- __silver_rt_alloc(size in R8) -----------------------------
        // Mirrors the Win32 HeapAlloc call shape already emitted at every call
        // site (RCX = heap handle, RDX = flags, R8 = bytes) so no call site
        // changes. Bump-allocates from the reserved region; falls back to the
        // real HeapAlloc import when it is exhausted.
        this.rtRegisterFunc("__silver_rt_alloc");
        this.rtAllocOffset = this.asm.buf.length;
        int fbLbl = this.newLabel();
        int doneLbl = this.newLabel();
        this.emitRtStateAddr(10);
        this.asm.movRMBase(0, 10, 0);
        this.asm.orRR64(0, 0);
        this.asm.jeLabel(fbLbl);
        this.asm.movRR64(9, 8);
        this.asm.addRI32(9, 15);
        this.asm.andRImm(9, -16);
        this.asm.movRMBase(11, 10, 8);
        this.asm.movRR64(2, 11);
        this.asm.addRR64(2, 9);
        this.asm.cmpRI32(2, 16777216);
        this.asm.jgLabel(fbLbl);
        this.asm.movMBaseR(10, 2, 8);
        this.asm.addRR64(0, 11);
        this.asm.jmpLabel(doneLbl);
        this.asm.bindLabel(fbLbl);
        this.asm.emitCallSetup(0);
        this.addImportPatch("kernel32.dll", "GetProcessHeap");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.emitCallSetup(0);
        this.asm.movRR64(1, 0);
        this.asm.movRI64(2, 8);
        this.addImportPatch("kernel32.dll", "HeapAlloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.bindLabel(doneLbl);
        this.asm.ret();

        // ---- __silver_rt_gc_collect ------------------------------------
        // Scaffolding stub: advances the cycle counter. Exact mark-sweep needs
        // tagged values in native codegen (see DOCS/GC collector design.md).
        this.rtRegisterFunc("__silver_rt_gc_collect");
        this.rtGcOffset = this.asm.buf.length;
        this.emitRtStateAddr(10);
        this.asm.movRMBase(0, 10, 16);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(10, 0, 16);
        this.asm.ret();
    }

    public void emitRuntimeEntryStub() {
        // The trampoline that becomes the PE entry point in --runtime mode:
        // bring up the embedded heap, run global initializers, call main, and
        // exit with its status. The driver prefers runtimeEntryOffset over
        // the plain main/global-init entries whenever it is set.
        this.runtimeEntryOffset = this.asm.buf.length;
        this.asm.emitCallSetup(0);
        this.asm.callRel32(0);
        this.forwardCalls.add(this.asm.buf.length - 4);
            this.forwardCallFuncIdxs.add(-1);
        this.forwardCallNames.add("__silver_rt_init");
        this.forwardCallClasses.add("");
        this.asm.emitCallTeardown();
        if (this.globalNames.length > 0) {
            this.asm.emitCallSetup(0);
            this.asm.callRel32(0);
            this.forwardCalls.add(this.asm.buf.length - 4);
            this.forwardCallFuncIdxs.add(-1);
            this.forwardCallNames.add("__init_globals");
            this.forwardCallClasses.add("");
            this.asm.emitCallTeardown();
        }
        if (this.hasMain) {
            this.asm.emitCallSetup(0);
            this.asm.callRel32(0);
            this.forwardCalls.add(this.asm.buf.length - 4);
            this.forwardCallFuncIdxs.add(-1);
            this.forwardCallNames.add("main");
            this.forwardCallClasses.add("");
            this.asm.emitCallTeardown();
            this.asm.movRR64(1, 0);
        } else {
            this.asm.xorRR64(0, 0);
            this.asm.movRR64(1, 0);
        }
        this.addImportPatch("kernel32.dll", "ExitProcess");
        int sRtEx = 0xDEADBEEFCAFEBABF;
        this.asm.emitImm64(0, sRtEx);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }
    #off
    #on LINUX
    // Linux backend (mirroring the `#on WINDOWS` block that ended above,
    // same surfaces): emitRtStateAddr, emitRuntimeFunctions,
    // emitRuntimeEntryStub — an mmap-based heap instead of VirtualAlloc +
    // HeapAlloc, and the trampoline exiting through libc exit.
    // Emit `movabs reg, <runtime state>` and remember the immediate's patch
    // position; the driver fills in the state block's ELF address after the
    // layout is known (patchRuntimeRefs LINUX slot below).
    public void emitRtStateAddr(int reg) {
        this.rtStatePatchOffsets.add(this.asm.buf.length + 2);
        this.asm.emitImm64(reg, 0);
    }

    public void emitRuntimeFunctions() {
        // ---- __silver_rt_init ------------------------------------------
        // mmap(NULL, RT_HEAP_RESERVE, PROT_READ|PROT_WRITE,
        //      MAP_PRIVATE|MAP_ANONYMOUS, -1, 0); on success records
        // base/offset in the writable state block (MAP_FAILED/-1 leaves the
        // state zeroed so allocation falls back to malloc for the run).
        // Mirrors silverc-rs runtime.rs emit_runtime_functions mmap branch.
        this.rtRegisterFunc("__silver_rt_init");
        this.rtInitOffset = this.asm.buf.length;
        int okLbl = this.newLabel();
        this.emitAbiCallSetup(0);
        this.asm.xorRR64(7, 7);
        this.asm.movRI64(6, 16777216);
        this.asm.movRI64(2, 3);
        this.asm.movRI64(1, 34);
        this.asm.movRI64(8, -1);
        this.asm.xorRR64(9, 9);
        this.addImportPatchDirect("libc.so.6", "mmap");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.emitAbiCallTeardown();
        this.asm.cmpRI32(0, -1);
        this.asm.jeLabel(okLbl);
        this.emitRtStateAddr(10);
        this.asm.movMBaseR(10, 0, 0);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(10, 0, 8);
        this.asm.bindLabel(okLbl);
        this.asm.ret();

        // ---- __silver_rt_alloc(size in R8) -----------------------------
        // Same entry shape as the Windows path (size in R8) so no call site
        // changes. Bump-allocates from the mmap region; falls back to libc
        // malloc + memset zeroing when uninitialized or exhausted (Direct
        // imports, never the redirect slot, so the fallback cannot recurse
        // into __silver_rt_alloc itself).
        this.rtRegisterFunc("__silver_rt_alloc");
        this.rtAllocOffset = this.asm.buf.length;
        int fbLbl = this.newLabel();
        int doneLbl = this.newLabel();
        this.emitRtStateAddr(10);
        this.asm.movRMBase(0, 10, 0);
        this.asm.orRR64(0, 0);
        this.asm.jeLabel(fbLbl);
        this.asm.movRR64(9, 8);
        this.asm.addRI32(9, 15);
        this.asm.andRImm(9, -16);
        this.asm.movRMBase(11, 10, 8);
        this.asm.movRR64(2, 11);
        this.asm.addRR64(2, 9);
        this.asm.cmpRI32(2, 16777216);
        this.asm.jgLabel(fbLbl);
        this.asm.movMBaseR(10, 2, 8);
        // -- spill accounting (additive): state+24 managed_bytes += rounded.
        // RCX (reg 1) is dead on this path (the Win64 heap-handle slot the
        // Linux backend ignores); RAX/RDX/R8/R9/R11 stay live for the
        // pointer commit below.
        this.asm.movRMBase(1, 10, 24);
        this.asm.addRR64(1, 9);
        this.asm.movMBaseR(10, 1, 24);
        this.asm.addRR64(0, 11);
        this.asm.jmpLabel(doneLbl);
        this.asm.bindLabel(fbLbl);
        // -- pre-commit pressure relief (additive, GC hybrid paging stage
        // 1): over-reserve and reinit-fallback arrivals call
        // __silver_rt_page_out first (Gate 2 bump>=90% check plus pressure
        // accounting; it preserves R8 size and R10 state), then run the
        // malloc fallback below unchanged (spill-or-fallback: native spill
        // of arbitrary bump pointers stays deferred until descriptors
        // exist, so every byte below behaves as before).
        this.emitAbiCallSetup(0);
        this.asm.callRel32(0);
        this.forwardCalls.add(this.asm.buf.length - 4);
        this.forwardCallFuncIdxs.add(-1);
        this.forwardCallNames.add("__silver_rt_page_out");
        this.forwardCallClasses.add("");
        this.emitAbiCallTeardown();
        this.asm.pushR64(8);
        this.asm.movRR64(7, 8);
        this.emitAbiCallSetup(0);
        this.addImportPatchDirect("libc.so.6", "malloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.emitAbiCallTeardown();
        int fokLbl = this.newLabel();
        int fdoneLbl = this.newLabel();
        this.asm.orRR64(0, 0);
        this.asm.jneLabel(fokLbl);
        this.asm.popR64(1);
        this.asm.jmpLabel(fdoneLbl);
        this.asm.bindLabel(fokLbl);
        this.asm.movRR64(7, 0);
        this.asm.xorRR64(6, 6);
        this.asm.popR64(2);
        this.asm.pushR64(7);
        this.emitAbiCallSetup(0);
        this.addImportPatchDirect("libc.so.6", "memset");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.emitAbiCallTeardown();
        this.asm.popR64(0);
        this.asm.bindLabel(fdoneLbl);
        this.asm.bindLabel(doneLbl);
        this.asm.ret();

        // ---- __silver_rt_gc_collect ------------------------------------
        // Scaffolding stub: advances the cycle counter (same as WINDOWS;
        // exact mark-sweep needs tagged values in native codegen).
        this.rtRegisterFunc("__silver_rt_gc_collect");
        this.rtGcOffset = this.asm.buf.length;
        this.emitRtStateAddr(10);
        this.asm.movRMBase(0, 10, 16);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(10, 0, 16);
        this.asm.ret();

        // ---- __silver_rt_page_out(size in R8) --------------------------
        // Spill-or-fallback wiring point (additive, GC hybrid paging stage
        // 1): Gate 2 recheck (bump >= 15099494 = 90% of the 16 MiB reserve)
        // plus pressure-probe accounting in state+32. ABI: R8 = requested
        // bytes, preserved; returns RAX = 0 (no native spill performed, so
        // the caller runs its malloc fallback). Preserves R10/R11/RDX/RCX
        // via push/pop; no calls inside, so no ABI setup is needed. Gate 1
        // (system pressure via /proc/meminfo MemAvailable) lives in the
        // Silver page manager (runtime/memory.sr smShouldSpill through
        // sysinfo.memoryUsagePercent); no /tmp/*.sm file is created here
        // (native spill of arbitrary bump pointers stays deferred until
        // descriptors exist), so workloads below either gate never touch
        // disk. Arrays/dicts/pin barriers are follow-up.
        this.rtRegisterFunc("__silver_rt_page_out");
        this.asm.pushR64(10);
        this.asm.pushR64(11);
        this.asm.pushR64(2);
        this.asm.pushR64(1);
        this.emitRtStateAddr(10);
        int poOutLbl = this.newLabel();
        this.asm.movRMBase(11, 10, 8);
        this.asm.movRI64(2, 15099494);
        this.asm.cmpRR64(11, 2);
        this.asm.jlLabel(poOutLbl);
        this.asm.movRMBase(1, 10, 32);
        this.asm.addRI32(1, 1);
        this.asm.movMBaseR(10, 1, 32);
        this.asm.bindLabel(poOutLbl);
        this.asm.xorRR64(0, 0);
        this.asm.popR64(1);
        this.asm.popR64(2);
        this.asm.popR64(11);
        this.asm.popR64(10);
        this.asm.ret();

        // ---- __silver_rt_page_in ---------------------------------------
        // Fault-in wiring point (additive, stage 1): records one fault
        // inquiry in state+48 and returns RAX = 0 (resident — no disk fault
        // performed; the Silver manager in runtime/memory.sr validates
        // header/checksum/index on real faults). Preserves R8/R10/R11/RDX/
        // RCX via push/pop; no calls inside.
        this.rtRegisterFunc("__silver_rt_page_in");
        this.asm.pushR64(10);
        this.asm.pushR64(1);
        this.emitRtStateAddr(10);
        this.asm.movRMBase(1, 10, 48);
        this.asm.addRI32(1, 1);
        this.asm.movMBaseR(10, 1, 48);
        this.asm.xorRR64(0, 0);
        this.asm.popR64(1);
        this.asm.popR64(10);
        this.asm.ret();
    }

    public void emitRuntimeEntryStub() {
        // The trampoline that becomes the ELF entry point in --runtime mode:
        // capture the _start stack, bring up the mmap heap, run global
        // initializers, call main, and exit with its status through libc.
        // The driver prefers runtimeEntryOffset whenever it is set.
        this.runtimeEntryOffset = this.asm.buf.length;
        this.emitLinuxStackCapture();
        this.emitAbiCallSetup(0);
        this.asm.callRel32(0);
        this.forwardCalls.add(this.asm.buf.length - 4);
            this.forwardCallFuncIdxs.add(-1);
        this.forwardCallNames.add("__silver_rt_init");
        this.forwardCallClasses.add("");
        this.emitAbiCallTeardown();
        if (this.globalNames.length > 0) {
            this.emitAbiCallSetup(0);
            this.asm.callRel32(0);
            this.forwardCalls.add(this.asm.buf.length - 4);
            this.forwardCallFuncIdxs.add(-1);
            this.forwardCallNames.add("__init_globals");
            this.forwardCallClasses.add("");
            this.emitAbiCallTeardown();
        }
        if (this.hasMain) {
            this.emitAbiCallSetup(0);
            this.asm.callRel32(0);
            this.forwardCalls.add(this.asm.buf.length - 4);
            this.forwardCallFuncIdxs.add(-1);
            this.forwardCallNames.add("main");
            this.forwardCallClasses.add("");
            this.emitAbiCallTeardown();
            this.asm.movRR64(7, 0);
        } else {
            this.asm.xorRR64(7, 7);
        }
        this.addImportPatchDirect("libc.so.6", "exit");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.emitAbiCallSetup(0);
        this.asm.callR64(0);
        this.emitAbiCallTeardown();
    }
    #off

    // WINDOWS-TARGET: reserves the runtime state block in the PE .rdata
    // stream and patches absolute Win64 addresses (0x140000000 image base)
    // into the movabs sites and the HeapAlloc-redirect slot. Linux replaces
    // with its own data layout + image base.
    #on WINDOWS
    // Reserve the writable runtime state block (heap base + bump offset + gc
    // cycles) and the internal pointer slot that redirects HeapAlloc calls to
    // __silver_rt_alloc. Called by the driver right after getStringData().
    public void appendRuntimeData() {
        if (!this.runtimeMode) { return; }
        this.rtStateDataOff = this.stringData.length;
        for (int i = 0; i < 24; i++) { this.stringData.add(0); }
        this.rtPtrSlotDataOff = this.stringData.length;
        for (int i = 0; i < 8; i++) { this.stringData.add(0); }
    }

    // Patch the embedded-runtime references once the layout is known: the
    // state-block address into every movabs site, __silver_rt_alloc's address
    // into the pointer slot, and the slot address over every HeapAlloc IAT
    // reference. Runs after patchImportRefs so the redirect wins.
    public void patchRuntimeRefs(int[] code, int stringsStart, int rdataRva) {
        if (!this.runtimeMode) { return; }
        int64 stateAddr = 0x140000000 + rdataRva + stringsStart + this.rtStateDataOff;
        for (int i = 0; i < this.rtStatePatchOffsets.length; i++) {
            int pos = this.rtStatePatchOffsets[i];
            code[pos] = stateAddr & 0xFF;
            code[pos + 1] = (stateAddr >> 8) & 0xFF;
            code[pos + 2] = (stateAddr >> 16) & 0xFF;
            code[pos + 3] = (stateAddr >> 24) & 0xFF;
            code[pos + 4] = (stateAddr >> 32) & 0xFF;
            code[pos + 5] = (stateAddr >> 40) & 0xFF;
            code[pos + 6] = (stateAddr >> 48) & 0xFF;
            code[pos + 7] = (stateAddr >> 56) & 0xFF;
        }
        int64 allocAddr = 0x140000000 + 0x1000 + this.rtAllocOffset;
        for (int b = 0; b < 8; b++) {
            this.stringData[this.rtPtrSlotDataOff + b] = (allocAddr >> (b * 8)) & 0xFF;
        }
        int64 slotAddr = 0x140000000 + rdataRva + stringsStart + this.rtPtrSlotDataOff;
        for (int p = 0; p < this.heapAllocPatchPos.length; p++) {
            int pos = this.heapAllocPatchPos[p];
            code[pos] = slotAddr & 0xFF;
            code[pos + 1] = (slotAddr >> 8) & 0xFF;
            code[pos + 2] = (slotAddr >> 16) & 0xFF;
            code[pos + 3] = (slotAddr >> 24) & 0xFF;
            code[pos + 4] = (slotAddr >> 32) & 0xFF;
            code[pos + 5] = (slotAddr >> 40) & 0xFF;
            code[pos + 6] = (slotAddr >> 48) & 0xFF;
            code[pos + 7] = (slotAddr >> 56) & 0xFF;
        }
    }
    #off
    #on LINUX
    // Linux backend: heap base + bump offset + gc cycles, then the
    // spill-to-disk accounting extension past byte 24 (managed bytes,
    // pressure probes, spills, faults, session salt — mirrors
    // runtime/memory.sr SM_STATE_*), then the malloc-redirect slot holding
    // __silver_rt_alloc's address. The driver calls this right after
    // getStringData(); mini_pe LINUX build() copies the extended
    // stringData into the ELF data segment. The WINDOWS 24-byte reservation
    // above is untouched.
    public void appendRuntimeData() {
        if (!this.runtimeMode) { return; }
        this.rtStateDataOff = this.stringData.length;
        for (int i = 0; i < 64; i++) { this.stringData.add(0); }
        this.rtPtrSlotDataOff = this.stringData.length;
        for (int i = 0; i < 8; i++) { this.stringData.add(0); }
    }

    // Patch the embedded-runtime references once the layout is known: the
    // state-block address into every movabs site, __silver_rt_alloc's
    // address into the pointer slot, and the slot address over every
    // recorded malloc reference (emitLinuxHeapAllocFromR8). Runs after
    // patchImportRefs so the redirect wins. ELF layout (0x400000 base).
    public void patchRuntimeRefs(int[] code, int stringsStart, int rdataRva) {
        if (!this.runtimeMode) { return; }
        int dataBase = this.elfDataVaddr();
        int64 stateAddr = dataBase + stringsStart + this.rtStateDataOff;
        for (int i = 0; i < this.rtStatePatchOffsets.length; i++) {
            int pos = this.rtStatePatchOffsets[i];
            code[pos] = stateAddr & 0xFF;
            code[pos + 1] = (stateAddr >> 8) & 0xFF;
            code[pos + 2] = (stateAddr >> 16) & 0xFF;
            code[pos + 3] = (stateAddr >> 24) & 0xFF;
            code[pos + 4] = (stateAddr >> 32) & 0xFF;
            code[pos + 5] = (stateAddr >> 40) & 0xFF;
            code[pos + 6] = (stateAddr >> 48) & 0xFF;
            code[pos + 7] = (stateAddr >> 56) & 0xFF;
        }
        int64 allocAddr = this.elfCodeVaddr() + this.rtAllocOffset;
        for (int b = 0; b < 8; b++) {
            this.stringData[this.rtPtrSlotDataOff + b] = (allocAddr >> (b * 8)) & 0xFF;
        }
        int64 slotAddr = dataBase + stringsStart + this.rtPtrSlotDataOff;
        for (int p = 0; p < this.heapAllocPatchPos.length; p++) {
            int pos = this.heapAllocPatchPos[p];
            code[pos] = slotAddr & 0xFF;
            code[pos + 1] = (slotAddr >> 8) & 0xFF;
            code[pos + 2] = (slotAddr >> 16) & 0xFF;
            code[pos + 3] = (slotAddr >> 24) & 0xFF;
            code[pos + 4] = (slotAddr >> 32) & 0xFF;
            code[pos + 5] = (slotAddr >> 40) & 0xFF;
            code[pos + 6] = (slotAddr >> 48) & 0xFF;
            code[pos + 7] = (slotAddr >> 56) & 0xFF;
        }
    }
    #off

    public void emitGlobalInitStub() {
        // Emitted at the end of .text when the program declares globals.  The
        // synthesized __init_globals() function runs every global initializer
        // through the ordinary assignment machinery (so heap allocations and
        // string constants work exactly as they do inside main), then the
        // entry stub calls main() and exits with its status.  The entry point
        // is the stub call sequence below, so entryOffset is recorded after
        // the init function's body has been emitted.
        Node initFunc = new Node();
        initFunc.kind = 100;
        initFunc.name = "__init_globals";
        initFunc.typeHint = "void";
        Node params = new Node();
        params.kind = 61;
        Node body = new Node();
        body.kind = 16;
        for (int gi = 0; gi < this.globalNames.length; gi++) {
            // LINUX SysV backend (additive): __linux_stack_top is set by the
            // entry stub (capture runs before __init_globals), so it must not
            // receive the default zero initializer or entry's captured RSP is
            // clobbered and cargs dereferences null. No WINDOWS global bears
            // this name, so the skip is behavior-neutral there.
            if (this.globalNames[gi] == "__linux_stack_top") { continue; }
            Node initExpr = this.globalInits[gi];
            if (initExpr.kind == 255) {
                string gt = this.globalTypes[gi];
                if (gt.length >= 2 && gt[gt.length - 2] == '[' && gt[gt.length - 1] == ']') {
                    initExpr = new Node(); initExpr.kind = 19;
                } else {
                    initExpr = new Node(); initExpr.kind = 0; initExpr.intVal = 0;
                }
            }
            Node assign = new Node();
            assign.kind = 7;
            assign.op = 20;
            Node lhs = new Node();
            lhs.kind = 6;
            lhs.name = this.globalNames[gi];
            assign.children.add(lhs);
            assign.children.add(initExpr);
            Node stmt = new Node();
            stmt.kind = 61;
            stmt.children.add(assign);
            body.children.add(stmt);
        }
        initFunc.children.add(params);
        initFunc.children.add(body);
        this.emitFunction(initFunc);

        this.entryOffset = this.asm.buf.length;

        // LINUX SysV backend (additive): capture the _start stack pointer
        // into __linux_stack_top before any push (entry runs with the kernel
        // RSP: [RSP]=argc, [RSP+8]=argv[0], ...). genCargsCall rebuilds
        // argc/argv from it. Skipped on WINDOWS (targetOs is "").
        if (this.isLinuxTarget()) {
            this.emitLinuxStackCapture();
        }

        // __init_globals();
        this.emitAbiCallSetup(0);
        this.asm.callRel32(0);
        this.forwardCalls.add(this.asm.buf.length - 4);
            this.forwardCallFuncIdxs.add(-1);
        this.forwardCallNames.add("__init_globals");
        this.forwardCallClasses.add("");
        this.emitAbiCallTeardown();

        if (this.hasMain) {
            // main();
            this.emitAbiCallSetup(0);
            this.asm.callRel32(0);
            this.forwardCalls.add(this.asm.buf.length - 4);
            this.forwardCallFuncIdxs.add(-1);
            this.forwardCallNames.add("main");
            this.forwardCallClasses.add("");
            this.emitAbiCallTeardown();

            // ExitProcess(main's return value in RAX).
            this.asm.movRR64(1, 0);
        } else {
            // No main function: exit(0) after running global initializers.
            this.asm.xorRR64(0, 0);
            this.asm.movRR64(1, 0);
        }
        #on WINDOWS
        this.addImportPatch("kernel32.dll", "ExitProcess");

        int sEx = 0xDEADBEEFCAFEBABF;
        this.asm.emitImm64(0, sEx);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        #off
        #on LINUX
        // Linux backend: exit(main's status) through libc. The branches
        // above staged the status in RCX (the shared Win64-shaped path);
        // move it to RDI and call the mapped exit import (Direct: no
        // shuffle, args already SysV).
        this.asm.movRR64(7, 1);
        this.addImportPatchDirect("libc.so.6", "exit");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.emitAbiCallSetup(0);
        this.asm.callR64(0);
        this.emitAbiCallTeardown();
        #off
    }

    // LINUX SysV backend (additive): save the entry RSP into the
    // __linux_stack_top global slot (see genProgram). Runs first in the
    // Linux entry stub while RSP is still the kernel _start stack.
    public void emitLinuxStackCapture() {
        this.linuxBackend.emitLinuxStackCapture(this);
    }

    // LINUX SysV backend (additive): load the captured _start RSP into RAX.
    // Exactly one dereference: RAX = [slot] = RSP. (A second deref would
    // yield [RSP] = argc and corrupt every cargs rebuild.)
    public void emitLinuxStackTopLoad() {
        this.linuxBackend.emitLinuxStackTopLoad(this);
    }

    // LINUX SysV backend (additive): rebuild argv from the captured _start
    // stack ([RSP0]=argc, [RSP0+8+i*8]=argv[i]) into the same heap layout
    // the WINDOWS parser produces ([argc, arg0, ...], arr+8 returned).
    // Mirrors silverc-rs emit_cargs_linux.
    public void genLinuxCargsCall() {
        this.linuxBackend.genLinuxCargsCall(this);
    }

    public void patchForwardCalls(int[] code) {
        for (int i = 0; i < this.forwardCalls.length; i++) {
            int patchPos = this.forwardCalls[i];
            string targetName = this.forwardCallNames[i];
            string targetClass = this.forwardCallClasses[i];
            int targetOff = -1;
            // Overload dispatch by argument count: forward calls
            // remember the exact function-table index they resolved to at
            // the call site, so same-named overload entries patch to their
            // own body instead of whichever same-named entry the legacy
            // name scan found last. Falls back to the name scan only when
            // no recorded index exists (older entries).
            if (i < this.forwardCallFuncIdxs.length && this.forwardCallFuncIdxs[i] >= 0) {
                int fi = this.forwardCallFuncIdxs[i];
                if (fi < this.funcOffsets.length) {
                    targetOff = this.funcOffsets[fi];
                }
            } else {
                for (int j = 0; j < this.funcNames.length; j++) {
                    if (this.funcNames[j] == targetName && this.funcClasses[j] == targetClass) {
                        targetOff = this.funcOffsets[j];
                    }
                }
            }
            if (targetOff >= 0) {
                int rel32 = targetOff - (patchPos + 4);
                code[patchPos] = rel32 & 0xFF;
                code[patchPos + 1] = (rel32 >> 8) & 0xFF;
                code[patchPos + 2] = (rel32 >> 16) & 0xFF;
                code[patchPos + 3] = (rel32 >> 24) & 0xFF;
            }
        }
    }    public void emitMethod(Node func, string className) {
    this.currentFunctionName = func.name;
    int emitIdx = -1;
    for (int fi = 0; fi < this.funcNames.length; fi++) {
        if (this.funcOffsets[fi] == -1 && this.funcNames[fi] == func.name && this.funcClasses[fi] == className) {
            emitIdx = fi;
            break;
        }
    }
    if (emitIdx >= 0) {
        this.funcOffsets[emitIdx] = this.asm.buf.length;
    } else {
        this.funcNames.add(func.name);
        this.funcClasses.add(className);
        this.funcRetTypes.add(func.typeHint);
        this.funcOffsets.add(this.asm.buf.length);
    }
    this.localOffsets = [];
    this.localNames = [];
    this.localTypes = [];
    this.stackSize = 0;
    this.currentClassName = className;
    this.asm.label(func.name);
    this.asm.pushR64(5);
    this.asm.movRR64(5, 4);
    this.allocLocal("this");
    int[] paramRegs = [1, 2, 8, 9];
    int numParams = 0;
    this.collectRefParams(func);
    this.fnPtrParamNames = [];
    if (func.childCount() > 0) {
        Node params = func.child(0);
        numParams = params.childCount();
        for (int i = 0; i < params.childCount(); i++) {
            this.allocLocal(params.child(i).name);
            this.localTypes[this.localTypes.length - 1] = params.child(i).typeHint;
            if (params.child(i).typeHint == "void ()") {
                // DOCS/259: an 8-byte function address, stored like an int.
                this.fnPtrParamNames.add(params.child(i).name);
            }
        }
    }
    this.emitFunctionBody(func);
}    public void emitFunction(Node func) {
    this.currentFunctionName = func.name;
    if (func.name == "main") {
        this.mainLabelOffset = this.asm.buf.length;
        this.hasMain = true;
    }
    int emitIdx = -1;
    for (int fi = 0; fi < this.funcNames.length; fi++) {
        if (this.funcOffsets[fi] == -1 && this.funcNames[fi] == func.name) {
            emitIdx = fi;
            break;
        }
    }
    if (emitIdx >= 0) {
        this.funcOffsets[emitIdx] = this.asm.buf.length;
    } else {
        this.funcNames.add(func.name);
        this.funcClasses.add("");
        this.funcRetTypes.add(func.typeHint);
        this.funcOffsets.add(this.asm.buf.length);
    }
    this.localOffsets = [];
    this.localNames = [];
    this.localTypes = [];
    this.stackSize = 0;
    this.currentClassName = "";
    this.collectRefParams(func);
    this.fnPtrParamNames = [];
    this.asm.label(func.name);
    this.asm.pushR64(5);
    this.asm.movRR64(5, 4);
    if (func.childCount() > 0) {
        Node paramsFn = func.child(0);
        for (int i = 0; i < paramsFn.childCount(); i++) {
            this.allocLocal(paramsFn.child(i).name);
            this.localTypes[this.localTypes.length - 1] = paramsFn.child(i).typeHint;
            if (paramsFn.child(i).typeHint == "void ()") {
                // DOCS/259: an 8-byte function address, stored like an int.
                this.fnPtrParamNames.add(paramsFn.child(i).name);
            }
        }
    }

    this.emitFunctionBody(func);
}    // WINDOWS-TARGET: main()'s console setup — SetConsoleOutputCP(65001)
    // so printf/WriteFile renders Silver's UTF-8 output correctly. Linux:
    // a no-op or termios/locale init — keep the same-signature method (the
    // currentIsMain call site below is ungated).
    public void emitUtf8ConsoleSetup() {
        #on WINDOWS
        // Silver strings and file contents are UTF-8 bytes. Configure the
        // Windows console so printf/WriteFile displays those bytes correctly.
        this.asm.movRI64(1, 65001);
        this.asm.emitCallSetup(0);
        this.addImportPatch("kernel32.dll", "SetConsoleOutputCP");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        #off
        #on LINUX
        // Linux slot: no-op or terminal/locale init (printf handles UTF-8
        // natively); keep the same-signature method — the currentIsMain call
        // site is ungated.
        #off
    }

    public void emitFunctionBody(Node func) {

        int isMethod = 0;
        if (this.currentClassName != "") {
            isMethod = 1;
        }
        string savedClass = this.currentClassName;
        int retLbl = this.newLabel();
        int exitLbl = this.newLabel();
        this.currentReturnLabel = retLbl;
        this.currentIsMain = func.name == "main" && this.currentClassName == "";
        // Reserve member-call argument slots before emitting the function
        // prologue.  Calls can nest while generating expressions; keeping a
        // fixed pool avoids changing stackSize after RSP has been reserved.
        this.funcCallArgTemps = [];
        this.funcCallArgCount = 0;
        this.liveSlots = [];
        this.liveSlotIsArray = [];
        this.scratchBaseOffset = -8 * (this.localOffsets.length + 1);
        for (int si = 0; si < 64; si++) {
            int scratchOff = this.allocLocal("__call_scratch");
            this.funcCallArgTemps.add(scratchOff);
        }
        if (func.childCount() > 1) {
            Node body = func.child(1);
            this.allocLocals(body);
            this.stackSize = ((this.stackSize + 15) / 16) * 16;
            int initialStackSize = this.stackSize;
            int subRspPatchPos = -1;
            // RBP is the stable frame anchor. Align the working stack before
            // reserving locals so every generated function enters calls with
            // the Win64 16-byte stack invariant, even when its caller's RSP
            // was not aligned. The epilogue restores RSP from RBP because an
            // AND operation cannot be undone by adding stackSize.
            this.asm.andRImm(4, -16);
            this.asm.emitU8(0x48);
            this.asm.emitU8(0x81);
            this.asm.emitU8(0xEC);
            this.asm.emitU32(this.stackSize);
            subRspPatchPos = this.asm.buf.length - 4;
            if (isMethod == 1) {
                // LINUX SysV backend (additive): `this` arrives in RDI (7),
                // declared params in RSI/RDX/RCX/R8/R9, params 6+ on the
                // caller stack at [RBP+16] (no shadow: retaddr 8 + saved
                // rbp 8). The WINDOWS registers/offsets below are unchanged.
                int thisReg = 1;
                int[] paramRegsMb = [2, 8, 9];
                int mbRegMax = 3;
                int mbStackBase = 48;
                int mbStackFirst = 3;
                if (this.isLinuxTarget()) {
                    thisReg = 7;
                    paramRegsMb = [6, 2, 1, 8, 9];
                    mbRegMax = 5;
                    mbStackBase = 16;
                    mbStackFirst = 5;
                }
                int thisOff = this.findLocal("this");
                this.asm.movMBaseR(5, thisReg, thisOff);
                if (func.childCount() > 0) {
                    Node params = func.child(0);
                    for (int i = 0; i < params.childCount(); i++) {
                        int poff = this.findLocal(params.child(i).name);
                        if (poff != 0) {
                            if (i < mbRegMax) {
                                this.asm.movMBaseR(5, paramRegsMb[i], poff);
                            } else {
                                // Method ABI: `this` is RCX, declared params
                                // use RDX/R8/R9, and params 4+ come from the
                                // caller's stack. After push rbp and the local
                                // frame, the first stack argument is at
                                // [RBP+48]: return address (8), saved frame
                                // pointer (8), shadow space (32).
                                this.asm.movRMBase(0, 5, mbStackBase + (i - mbStackFirst) * 8);
                                this.asm.movMBaseR(5, 0, poff);
                            }
                        }
                    }
                }
            } else {
                // LINUX SysV backend (additive): params 1-6 arrive in
                // RDI/RSI/RDX/RCX/R8/R9, params 7+ at [RBP+16]. The WINDOWS
                // registers/offsets below are unchanged.
                int[] paramRegsFb = [1, 2, 8, 9];
                int fbRegMax = 4;
                int fbStackBase = 48;
                int fbStackFirst = 4;
                if (this.isLinuxTarget()) {
                    paramRegsFb = [7, 6, 2, 1, 8, 9];
                    fbRegMax = 6;
                    fbStackBase = 16;
                    fbStackFirst = 6;
                }
                if (func.childCount() > 0) {
                    Node params = func.child(0);
                    for (int i = 0; i < params.childCount(); i++) {
                        int poff = this.findLocal(params.child(i).name);
                        if (poff != 0) {
                            if (i < fbRegMax) {
                                this.asm.movMBaseR(5, paramRegsFb[i], poff);
                            } else {
                                // Free-function ABI: params 1-4 use RCX/RDX/
                                // R8/R9; params 5+ come from the caller's
                                // stack at [RBP+48], [RBP+56], ... (return
                                // address 8 + saved frame pointer 8 + shadow
                                // space 32).
                                this.asm.movRMBase(0, 5, fbStackBase + (i - fbStackFirst) * 8);
                                this.asm.movMBaseR(5, 0, poff);
                            }
                        }
                    }
                }
            }
            if (this.currentIsMain) {
                this.emitUtf8ConsoleSetup();
            }

            if (body.kind == 16) {
                this.genBlock(body);
            } else if (body.kind == 61) {
                this.genStmt(body);
            } else {
                // Return-shortcut body (`int f(int x) << expr;`): the parser
                // stores the bare expression as the body. Evaluate it (result
                // in RAX) and jump to the return label so the value is
                // propagated to the caller.
                this.genExpr(body);
                this.emitReturnJump();
            }
            if (this.stackSize != initialStackSize) {
                this.stackSize = ((this.stackSize + 15) / 16) * 16;
                this.asm.buf[subRspPatchPos] = (this.stackSize) & 0xFF;
                this.asm.buf[subRspPatchPos+1] = (this.stackSize >> 8) & 0xFF;
                this.asm.buf[subRspPatchPos+2] = (this.stackSize >> 16) & 0xFF;
                this.asm.buf[subRspPatchPos+3] = (this.stackSize >> 24) & 0xFF;
            }
        } else {
            if (this.stackSize > 0) {
                this.asm.subRI32(4, this.stackSize);
            }
            if (isMethod == 1) {
                int thisOff = this.findLocal("this");
                // LINUX SysV backend (additive): `this` arrives in RDI.
                int thisReg2 = 1;
                if (this.isLinuxTarget()) { thisReg2 = 7; }
                this.asm.movMBaseR(5, thisReg2, thisOff);
            }
        }
        if (this.currentIsMain) {
            // A fall-through void main exits successfully; an explicit
            // return expression keeps its value for ExitProcess.
            this.asm.xorRR64(0, 0);
            this.asm.jmpLabel(exitLbl);
            this.asm.bindLabel(retLbl);
            this.asm.bindLabel(exitLbl);
        } else {
            this.asm.bindLabel(retLbl);
        }
        if (this.liveSlots.length > 0) {
            this.asm.pushR64(0);
            for (int li = 0; li < this.liveSlots.length; li++) {
                int lOff = this.liveSlots[li];
                this.asm.movRMBase(1, 5, lOff);
                this.asm.cmpRI32(1, 0);
                int lDone = this.newLabel();
                this.asm.jeLabel(lDone);
                if (this.liveSlotIsArray[li]) {
                    this.asm.subRI32(1, 16);
                }
                this.addImportPatch("msvcrt.dll", "free");
                this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD2);
                this.asm.movRMBase(0, 0, 0);
                this.asm.emitCallSetup(0);
                this.asm.callR64(0);
                this.asm.emitCallTeardown();
                this.asm.bindLabel(lDone);
            }
            this.asm.popR64(0);
        }
        if (this.currentIsMain) {
            // An exception that reaches main without a catch is unhandled:
            // exit with a non-zero status.
            int noExc = this.newLabel();
            int eaIdx = this.findGlobal("__exc_active");
            int sp = this.asm.buf.length;
            this.asm.emitImm64(1, 0);
            this.globalPatchOffsets.add(sp + 2);
            this.globalPatchIndices.add(eaIdx);
            this.asm.movRMBase(1, 1, 0);
            this.asm.cmpRI32(1, 0);
            this.asm.jeLabel(noExc);
            // Report the unhandled exception (parity with silverc-rs/silveri).
            int ueStrIdx = this.addString("Unhandled exception\n");
            int ueSp = this.asm.buf.length;
            this.asm.emitImm64(0, 0);
            this.stringPatchOffsets.add(ueSp + 2);
            this.stringPatchIndices.add(ueStrIdx);
            this.asm.movRR64(1, 0);
            this.addImportPatch("msvcrt.dll", "printf");
            int uePrintf = 0xDEADBEEFCAFEBAD0;
            this.asm.emitImm64(0, uePrintf);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movRI64(0, 1);
            this.asm.bindLabel(noExc);
        }
        this.asm.movRR64(4, 5);
        if (this.currentIsMain) {
            // LINUX SysV backend (additive): exit(RAX) through libc instead
            // of kernel32 ExitProcess. The WINDOWS sequence below is
            // byte-identical to before.
            if (this.isLinuxTarget()) {
                this.asm.movRR64(7, 0);
                this.addImportPatchDirect("libc.so.6", "exit");
                this.asm.emitImm64(0, 0);
                this.asm.movRMBase(0, 0, 0);
                this.emitAbiCallSetup(0);
                this.asm.callR64(0);
                this.emitAbiCallTeardown();
            } else {
                this.asm.movRR64(1, 0);
                this.addImportPatch("kernel32.dll", "ExitProcess");
                int sExit = 0xDEADBEEFCAFEBABE;
                this.asm.emitImm64(0, sExit);
                this.asm.movRMBase(0, 0, 0);
                this.asm.emitCallSetup(0);
                this.asm.callR64(0);
                this.asm.emitCallTeardown();
            }
        } else {
            this.asm.popR64(5);
            this.asm.ret();
        }
        this.currentClassName = savedClass;
    }

    public void allocLocals(Node node) {
    if (node.kind == 50) {
        this.allocLocal(node.name);
        while (this.localTypes.length < this.localNames.length) {
            this.localTypes.add("");
        }
            if (this.localTypes.length > 0) {
                string declType = node.typeHint;
                // `var x = expr;` has no declared type; infer it from the
                // initializer so `x.length` / `x.pop()` / `x.map()` dispatch
                // to array codegen instead of an unresolvable user call.
                if ((declType == "" || declType == "var") && node.childCount() > 0) {
                    declType = this.inferExprType(node.child(0));
                }
                this.localTypes[this.localTypes.length - 1] = declType;
                if (node.childCount() > 0 && node.child(0).kind == 66) {
                    this.localTypes[this.localTypes.length - 1] = "dict<string,int>";
                }
                if (node.childCount() > 0 && node.child(0).kind == 70) {
                    this.localTypes[this.localTypes.length - 1] = "tuple";
                }
            }
        } else if (node.kind == 73) {
            this.allocLocal(node.name);
            while (this.localTypes.length < this.localNames.length) {
                this.localTypes.add("");
            }
            if (this.localTypes.length > 0) {
                this.localTypes[this.localTypes.length - 1] = node.typeHint;
            }
        }
        for (int i = 0; i < node.childCount(); i++) {
            this.allocLocals(node.child(i));
        }
    }

    public void genBlock(Node block) {
        for (int i = 0; i < block.childCount(); i++) {
            this.genStmt(block.child(i));
        }
    }

    public void genProgram2(Node[] program) {
        for (int i = 0; i < program.length; i++) {
            Node item = program[i];
            if (item.kind == 100) {
                this.emitFunction(item);
            }
        }
    }

    public void genStmt(Node stmt) {
        if (stmt.kind == 71) {
            int valueOff = this.allocLocal("__tuple_destr");
            this.genExpr(stmt.child(stmt.childCount() - 1));
            this.asm.movMBaseR(5, 0, valueOff);
            for (int di = 0; di + 1 < stmt.childCount(); di++) {
                string name = stmt.child(di).name;
                int localOff = this.allocLocal(name);
                this.asm.movRMBase(0, 5, valueOff);
                this.asm.movRMBase(0, 0, di * 8);
                this.asm.movMBaseR(5, 0, localOff);
            }
        } else if (stmt.kind == 79) {
            // Array destructuring declaration `int a, b = arr;` (DOCS/119):
            // evaluate the array, then bind each successive element at
            // ptr + i*8 into a fresh typed local.
            int arrOff = this.allocLocal("__arr_destr");
            this.genExpr(stmt.child(stmt.childCount() - 1));
            this.asm.movMBaseR(5, 0, arrOff);
            string elemType = stmt.typeHint;
            for (int di = 0; di + 1 < stmt.childCount(); di++) {
                string name = stmt.child(di).name;
                int localOff = this.allocLocal(name);
                if (elemType != "") {
                    this.setLocalType(name, elemType);
                }
                this.asm.movRMBase(0, 5, arrOff);
                this.asm.addRI32(0, di * 8);
                this.asm.movRMBase(0, 0, 0);
                this.asm.movMBaseR(5, 0, localOff);
            }
        } else if (stmt.kind == 61) {
            if (stmt.childCount() > 0) {
                this.genExpr(stmt.child(0));
            }
    } else if (stmt.kind == 50) {
        int off = this.findLocal(stmt.name);            if (stmt.childCount() > 0) {
                Node initNode = stmt.child(0);
                if (initNode.kind == 7 && initNode.op == 28) {
                    if (initNode.childCount() > 1) {
                        this.genExpr(initNode.child(1));
                    }
                    if (off != 0) {
                        this.asm.movMBaseR(5, 0, off);
                    }
                    if (stmt.isLive && off != 0 && this.isLiveHeapType(stmt.typeHint)) {
                        this.registerLiveSlot(off, stmt.typeHint);
                    }
                } else {
                // A runtime-sized `new byte[expr]` initializer parses as a
                // kind-19 array node with op=2 and the size expression as its
                // single child. genByteArrayLiteral would treat that child as
                // element 0 of a one-element literal; route the dyn-new form
                // through genExpr instead, whose kind-19 handler owns the
                // HeapAlloc(HEAP_ZERO_MEMORY) runtime-sized lowering (same
                // shape the `return new byte[n];` workaround path uses).
                bool isDynByteNew = initNode.op == 2 && initNode.childCount() == 1;
                if (stmt.typeHint == "byte[]" && initNode.kind == 19 && !isDynByteNew) {
                    this.genByteArrayLiteral(initNode);
                } else if (initNode.kind == 74) {
                    this.genStructLiteral(initNode, stmt.typeHint);
                } else {
                    this.genExpr(initNode);
                    // `double d = n;` widens the integer to a real double
                    // (silverc-rs does this in its decl-init arm); without it
                    // the raw integer bits landed in the double slot.
                    this.coerceDeclToDouble(stmt.typeHint, initNode);
                }
                if (stmt.isLive && off != 0 && this.isLiveHeapType(stmt.typeHint)) {
                    if (stmt.typeHint == "string" || stmt.typeHint == "string?") {
                        this.emitLlmaiStringDup();
                    }
                    this.asm.movMBaseR(5, 0, off);
                    this.registerLiveSlot(off, stmt.typeHint);
                } else {
                if (off != 0) {
                this.asm.movMBaseR(5, 0, off);
            }
                }
            }
        } else {
            // Uninitialized locals start zeroed; array-typed locals start as
            // an empty array so that later .add() never touches garbage.
            string localTy = this.getLocalType(stmt.name);
            bool isArrTy = false;
            if (localTy.length >= 2) {
                if (localTy[localTy.length - 2] == '[' && localTy[localTy.length - 1] == ']') {
                    isArrTy = true;
                }
            }
            bool isFnArrTy = localTy == "void ()[]";
            if (off != 0) {
                if (isFnArrTy) {
                    // DOCS/259 G3: fn-typed array locals auto-allocate 8
                    // zeroed address slots so `jobs[0] = job; jobs[0]();`
                    // works immediately (same shape as rs NewArray).
                    Node arrInit = new Node(); arrInit.kind = 19; arrInit.op = 2;
                    Node sizeLit = new Node(); sizeLit.kind = 0; sizeLit.intVal = 8;
                    arrInit.children.add(sizeLit);
                    this.genExpr(arrInit);
                    this.asm.movMBaseR(5, 0, off);
                } else if (isArrTy) {
                    Node arrInit = new Node(); arrInit.kind = 19;
                    this.genExpr(arrInit);
                    this.asm.movMBaseR(5, 0, off);
                } else {
                    this.asm.xorRR64(0, 0);
                    this.asm.movMBaseR(5, 0, off);
                }
            }
        }        } else if (stmt.kind == 73) {
            int aliasOff = this.findLocal(stmt.name);
            if (stmt.childCount() > 1) {
                Node aliasTarget = stmt.child(1);
                if (aliasTarget.kind == 6) {
                    int targetOff = this.findLocal(aliasTarget.name);
                    if (targetOff != 0) {
                        this.setLocalOffset(stmt.name, targetOff);
                    } else {
                        this.genExpr(aliasTarget);
                        if (aliasOff != 0) {
                            this.asm.movMBaseR(5, 0, aliasOff);
                        }
                    }
                } else {
                    this.genExpr(aliasTarget);
                    if (aliasOff != 0) {
                        this.asm.movMBaseR(5, 0, aliasOff);
                    }
                }
            } else {
                if (aliasOff != 0) {
                    this.asm.xorRR64(0, 0);
                    this.asm.movMBaseR(5, 0, aliasOff);
                }
            }
        } else if (stmt.kind == 51) {
            if (stmt.childCount() > 0) {
                this.genExpr(stmt.child(0));
            } else {
                this.asm.xorRR64(0, 0);
            }
            this.emitReturnJump();
        } else if (stmt.kind == 68) {
            this.genExpr(stmt.child(0));
            int evIdx = this.findGlobal("__exc_value");
            this.genGlobalStore(evIdx);
            this.asm.movRI64(0, 1);
            int eaIdx = this.findGlobal("__exc_active");
            this.genGlobalStore(eaIdx);
            this.emitExceptionJump();
        } else if (stmt.kind == 59) {
            bool hasCatch = stmt.name != "";
            bool hasFinally = stmt.hasFinally;
            int catchLbl = this.newLabel();
            int afterLbl = this.newLabel();
            int finallyLbl = this.newLabel();
            int retVal = 0;
            int retFlag = 0;
            int prevHandler = this.currentExcHandler;
            int prevCatch = this.currentCatch;
            int prevFinally = this.currentFinally;
            int prevRetVal = this.currentFinallyRetVal;
            int prevRetFlag = this.currentFinallyRetFlag;
            if (hasFinally) {
                retVal = this.allocLocal("__finally_ret_val");
                retFlag = this.allocLocal("__finally_ret_flag");
                this.asm.xorRR64(0, 0);
                this.asm.movMBaseR(5, 0, retFlag);
                this.currentFinallyRetVal = retVal;
                this.currentFinallyRetFlag = retFlag;
                this.currentFinally = finallyLbl;
            } else {
                this.currentFinally = -1;
                this.currentFinallyRetVal = 0;
                this.currentFinallyRetFlag = 0;
            }
            if (hasCatch) {
                this.currentExcHandler = catchLbl;
                this.currentCatch = catchLbl;
            } else {
                this.currentExcHandler = prevHandler;
                this.currentCatch = -1;
            }
            this.genBlock(stmt.child(0));
            if (hasFinally) {
                this.asm.jmpLabel(finallyLbl);
            } else {
                this.asm.jmpLabel(afterLbl);
            }
            if (hasCatch) {
                this.asm.bindLabel(catchLbl);

                int evIdx2 = this.findGlobal("__exc_value");
                this.genGlobalLoad(evIdx2);
                int catchOff = this.allocLocal(stmt.name);
                this.asm.movMBaseR(5, 0, catchOff);
                this.asm.movRI64(0, 0);
                int eaIdx2 = this.findGlobal("__exc_active");
                this.genGlobalStore(eaIdx2);
                this.setLocalType(stmt.name, stmt.typeHint);
                this.currentExcHandler = prevHandler;
                this.currentCatch = -1;
                this.genBlock(stmt.child(1));
                if (hasFinally) {
                    this.asm.jmpLabel(finallyLbl);
                } else {
                    this.asm.jmpLabel(afterLbl);
                }
            }
            if (hasFinally) {
                this.asm.bindLabel(finallyLbl);
                this.currentExcHandler = prevHandler;
                this.currentCatch = prevCatch;
                this.currentFinally = prevFinally;
                this.currentFinallyRetVal = prevRetVal;
                this.currentFinallyRetFlag = prevRetFlag;
                this.genBlock(stmt.child(2));
                int noRet = this.newLabel();
                this.asm.movRMBase(0, 5, retFlag);
                this.asm.cmpRI32(0, 0);
                this.asm.jeLabel(noRet);
                this.asm.movRMBase(0, 5, retVal);
                this.asm.jmpLabel(this.currentReturnLabel);
                this.asm.bindLabel(noRet);
                this.emitExcCheck();
                this.asm.jmpLabel(afterLbl);
            }
            this.currentExcHandler = prevHandler;
            this.currentCatch = prevCatch;
            this.currentFinally = prevFinally;
            this.currentFinallyRetVal = prevRetVal;
            this.currentFinallyRetFlag = prevRetFlag;
            this.asm.bindLabel(afterLbl);
        } else if (stmt.kind == 16) {
            this.genBlock(stmt);
    } else if (stmt.kind == 53) {
        int elseLbl = this.newLabel();
        int endLbl = this.newLabel();
        this.genExpr(stmt.child(0));
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(elseLbl);
        if (stmt.childCount() > 1) {
            Node body = stmt.child(1);
            if (body.kind == 16) {
                this.genBlock(body);
            } else {
                this.genStmt(body);
            }
        }
        this.asm.jmpLabel(endLbl);
        this.asm.bindLabel(elseLbl);
        if (stmt.childCount() > 2) {
            Node elseBody = stmt.child(2);
            if (elseBody.kind == 16) {
                this.genBlock(elseBody);
            } else {
                this.genStmt(elseBody);
            }
        }
        this.asm.bindLabel(endLbl);
        } else if (stmt.kind == 54) {
            int startLbl = this.newLabel();
            int endLbl = this.newLabel();
            this.loopStartStack.add(startLbl);
            this.loopEndStack.add(endLbl);
            this.loopContinueStack.add(startLbl);
            this.asm.bindLabel(startLbl);
            if (stmt.childCount() > 0) {
                this.genExpr(stmt.child(0));
            }
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(endLbl);
            if (stmt.childCount() > 1) {
                Node body = stmt.child(1);
                if (body.kind == 16) {
                    this.genBlock(body);
                } else {
                    this.genStmt(body);
                }
            }
            this.asm.jmpLabel(startLbl);
            this.asm.bindLabel(endLbl);
            this.popLoopStart();
            this.popLoopEnd();
            this.popLoopContinue();
        } else if (stmt.kind == 76) {
            // switch (subject) { case v { body } ... else { body } } — each
            // case tests subject == v and runs its block with no fall-through
            // into the next case or the else body (DOCS/108).
            int subjOff = this.allocLocal("__switch_subj");
            this.genExpr(stmt.child(0));
            this.asm.movMBaseR(5, 0, subjOff);
            int endLbl = this.newLabel();
            int total = stmt.childCount();
            int numCases = (total - 1) / 2;
            bool hasElse = (total % 2) == 0;
            for (int ci = 0; ci < numCases; ci++) {
                int bodyLbl = this.newLabel();
                int nextLbl = this.newLabel();
                Node value = stmt.child(1 + ci * 2);
                if (value.kind == 2) {
                    // String case: match when strcmp(subject, value) == 0.
                    this.genExpr(value);
                    this.asm.movRR64(2, 0);
                    this.asm.movRMBase(1, 5, subjOff);
                    this.addImportPatch("ucrtbase.dll", "strcmp");
                    int sSc = 0xDEADBEEFCAFEBAC1;
                    this.asm.emitImm64(0, sSc);
                    this.asm.movRMBase(0, 0, 0);
                    this.asm.emitCallSetup(0);
                    this.asm.callR64(0);
                    this.asm.emitCallTeardown();
                    this.asm.cmpRI32(0, 0);
                    this.asm.jeLabel(bodyLbl);
                } else {
                    this.asm.movRMBase(0, 5, subjOff);
                    this.asm.pushR64(0);
                    this.genExpr(value);
                    this.asm.movRR64(1, 0);
                    this.asm.popR64(0);
                    this.asm.cmpRR64(0, 1);
                    this.asm.jeLabel(bodyLbl);
                }
                this.asm.jmpLabel(nextLbl);
                this.asm.bindLabel(bodyLbl);
                Node body = stmt.child(2 + ci * 2);
                if (body.kind == 16) {
                    this.genBlock(body);
                } else {
                    this.genStmt(body);
                }
                this.asm.jmpLabel(endLbl);
                this.asm.bindLabel(nextLbl);
            }
            if (hasElse) {
                Node elseBody = stmt.child(total - 1);
                if (elseBody.kind == 16) {
                    this.genBlock(elseBody);
                } else {
                    this.genStmt(elseBody);
                }
            }
            this.asm.bindLabel(endLbl);
        } else if (stmt.kind == 77) {
            // `loop { body }` (DOCS/12): unconditional-jump infinite loop with
            // break/continue support via the shared loop label stacks.
            int startLbl = this.newLabel();
            int endLbl = this.newLabel();
            this.loopStartStack.add(startLbl);
            this.loopEndStack.add(endLbl);
            this.loopContinueStack.add(startLbl);
            this.asm.bindLabel(startLbl);
            if (stmt.childCount() > 0) {
                Node body = stmt.child(0);
                if (body.kind == 16) {
                    this.genBlock(body);
                } else {
                    this.genStmt(body);
                }
            }
            this.asm.jmpLabel(startLbl);
            this.asm.bindLabel(endLbl);
            this.popLoopStart();
            this.popLoopEnd();
            this.popLoopContinue();
        } else if (stmt.kind == 55) {
            // C-style for loop: child(0)=init, child(1)=cond, child(2)=update, child(3)=body
            if (stmt.childCount() > 0) {
                Node init = stmt.child(0);
                if (init.kind == 50 || init.kind == 61) {
                    this.genStmt(init);
                } else {

                    this.genExpr(init);
                }
            }
            int startLbl = this.newLabel();
            int endLbl = this.newLabel();
            int contLbl = this.newLabel();
            this.loopStartStack.add(startLbl);
            this.loopEndStack.add(endLbl);
            this.loopContinueStack.add(contLbl);
            this.asm.bindLabel(startLbl);
            if (stmt.childCount() > 1) {
                this.genExpr(stmt.child(1));
            }
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(endLbl);
            if (stmt.childCount() > 3) {
                Node body = stmt.child(3);
                if (body.kind == 16) {
                    this.genBlock(body);
                } else {
                    this.genStmt(body);
                }
            }
            this.asm.bindLabel(contLbl);
            if (stmt.childCount() > 2) {
                this.genExpr(stmt.child(2));
            }
            this.asm.jmpLabel(startLbl);
            this.asm.bindLabel(endLbl);
            this.popLoopStart();
            this.popLoopEnd();
            this.popLoopContinue();
        } else if (stmt.kind == 62) {
            if (this.loopEndStack.length > 0) {
                int endLbl = this.loopEndStack[this.loopEndStack.length - 1];
                this.asm.jmpLabel(endLbl);
            }
        } else if (stmt.kind == 63) {
            if (this.loopContinueStack.length > 0) {
                int contLbl = this.loopContinueStack[this.loopContinueStack.length - 1];
                this.asm.jmpLabel(contLbl);
            }
        } else if (stmt.kind == 64) {
            int startLbl = this.newLabel();
            int endLbl = this.newLabel();
            int contLbl = this.newLabel();
            this.loopStartStack.add(startLbl);
            this.loopEndStack.add(endLbl);
            this.loopContinueStack.add(contLbl);
            if (stmt.childCount() > 1) {
                this.genExpr(stmt.child(1));
                int arrOff = this.allocLocal("__foreach_arr");
                this.asm.movMBaseR(5, 0, arrOff);
                this.asm.movRMBase(0, 0, -8);
                int lenOff = this.allocLocal("__foreach_len");
                this.asm.movMBaseR(5, 0, lenOff);
                int idxOff = this.allocLocal("__foreach_idx");
                this.asm.movRI64(0, 0);
                this.asm.movMBaseR(5, 0, idxOff);
                int vOff = this.findLocal(stmt.child(0).name);
                this.asm.bindLabel(startLbl);
                this.asm.movRMBase(0, 5, idxOff);
                this.asm.movRMBase(1, 5, lenOff);
                this.asm.cmpRR64(0, 1);
                this.asm.jgeLabel(endLbl);
                this.asm.movRMBase(0, 5, arrOff);
                this.asm.movRMBase(1, 5, idxOff);
                this.asm.shlR64Imm(1, 3);
                this.asm.addRR64(0, 1);
                this.asm.movRMBase(0, 0, 0);
                this.asm.movMBaseR(5, 0, vOff);
                if (stmt.childCount() > 2) {
                    Node body = stmt.child(2);
                    if (body.kind == 16) {
                        this.genBlock(body);
                    } else if (body.kind == 61) {
                        this.genStmt(body);
                    }
                }
                this.asm.bindLabel(contLbl);
                this.asm.movRMBase(0, 5, idxOff);
                this.asm.addRI32(0, 1);
                this.asm.movMBaseR(5, 0, idxOff);
                this.asm.jmpLabel(startLbl);
                this.asm.bindLabel(endLbl);
            }
            this.popLoopStart();
            this.popLoopEnd();
            this.popLoopContinue();
        }
    }

    public void popLoopStart() {
        int[] ns = [];
        for (int i = 0; i < this.loopStartStack.length - 1; i++) {
            ns.add(this.loopStartStack[i]);
        }
        this.loopStartStack = ns;
    }

    public void popLoopEnd() {
        int[] ns = [];
        for (int i = 0; i < this.loopEndStack.length - 1; i++) {
            ns.add(this.loopEndStack[i]);
        }
        this.loopEndStack = ns;
    }

    public void popLoopContinue() {
        int[] ns = [];
        for (int i = 0; i < this.loopContinueStack.length - 1; i++) {
            ns.add(this.loopContinueStack[i]);
        }
        this.loopContinueStack = ns;
    }

    public void genByteArrayLiteral(Node expr) {
        int count = expr.childCount();
        if (expr.op == 1 && expr.intVal >= 0) { count = expr.intVal; }
        int capacity = 8;
        if (count > 8) { capacity = count; }
        int allocSize = 16 + capacity;
        this.asm.emitImm64(1, allocSize);
        this.addImportPatch("msvcrt.dll", "malloc");
        int sByteArr = 0xDEADBEEFCAFEBAB0;
        this.asm.emitImm64(0, sByteArr);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int arrOff = this.allocLocal("__byte_arr_lit");
        this.asm.movMBaseR(5, 0, arrOff);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.emitImm64(1, capacity);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.emitImm64(1, count);
        this.asm.movMBaseR(0, 1, 8);
        // Explicit literals and small constant allocations carry zero-valued
        // children. Large allocations intentionally leave the payload alone;
        // native read APIs fill those buffers before they are consumed.
        for (int i = 0; i < expr.childCount(); i++) {
            this.genExpr(expr.child(i));
            this.asm.movRMBase(1, 5, arrOff);
            this.asm.movMBaseByteR(1, 0, 16 + i);
        }
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.addRI32(0, 16);
    }

    public void genStructLiteral(Node expr, string typeName) {
        // Allocate a struct object (same layout as a class instance: each
        // field at offset cnt*8), then store every `name: value` pair at the
        // offset registered for that field.
        int fieldCnt = 0;
        for (int ci = 0; ci < this.classNames.length; ci++) {
            if ((this.classNames[ci] == typeName || typeName == this.classNames[ci] + "?")) {
                fieldCnt = this.classFieldCounts[ci];
            }
        }
        int size = fieldCnt * 8;
        if (size < 16) { size = 16; }
        this.asm.emitImm64(1, size);
        this.addImportPatch("msvcrt.dll", "malloc");
        int sStruct = 0xDEADBEEFCAFEBAB0;
        this.asm.emitImm64(0, sStruct);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int objOff = this.allocLocal("__struct_lit");
        this.asm.movMBaseR(5, 0, objOff);
        for (int fi = 0; fi < expr.childCount(); fi++) {
            Node pair = expr.child(fi);
            if (pair.kind != 18 || pair.childCount() < 2) { continue; }
            Node key = pair.child(0);
            Node value = pair.child(1);
            int fieldOff = this.findFieldOffset(typeName, key.name);
            if (fieldOff < 0) { continue; }
            // Nested struct literal: the field type is itself a struct, so
            // recurse with that type instead of treating `{...}` as a dict.
            string fieldType = this.findFieldType(typeName, key.name);
            if (value.kind == 74 && (fieldType == typeName || typeName == fieldType + "?")) {
                this.genStructLiteral(value, fieldType);
            } else if (value.kind == 74) {
                this.genStructLiteral(value, fieldType);
            } else {
                this.genExpr(value);
            }
            this.asm.movRMBase(1, 5, objOff);
            this.asm.movMBaseR(1, 0, fieldOff);
        }
        this.asm.movRMBase(0, 5, objOff);
    }

    public void genExpr(Node expr) {
        int kind = expr.kind;
        if (kind == 0) {
            this.asm.emitImm64(0, expr.intVal);
        } else if (kind == 1) {
            // Float literal: intVal holds the IEEE-754 double bit pattern (the
            // self-hosted backend carries floats as their raw bits).
            this.asm.emitImm64(0, expr.intVal);
        } else if (kind == 2) {
            int strIdx = this.addString(expr.strVal);
            int sp = this.asm.buf.length;
            this.asm.emitImm64(0, 0);
            int strPatchPos = sp + 2;
            this.stringPatchOffsets.add(strPatchPos);
            this.stringPatchIndices.add(strIdx);
        } else if (kind == 3) {
            this.asm.emitImm64(0, expr.charVal);
        } else if (kind == 4) {
            if (expr.boolVal) { this.asm.emitImm64(0, 1); } else { this.asm.emitImm64(0, 0); }
        } else if (kind == 5) {
            this.asm.xorRR64(0, 0);
        } else if (kind == 66) {
            // Dictionary layout: [capacity, length, key/value slots...].
            int count = expr.childCount();
            int capacity = 16;
            int allocSize = 16 + capacity * 16;
            this.asm.emitImm64(1, allocSize);
            this.addImportPatch("msvcrt.dll", "malloc");
            int sDict = 0xDEADBEEFCAFEBAB0;
            this.asm.emitImm64(0, sDict);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            int dictOff = this.allocLocal("__dict_lit");
            this.asm.movMBaseR(5, 0, dictOff);
            // Dictionary expressions return the data pointer (allocation base
            // plus 16), so the two header words live immediately before it:
            // [capacity, length, key/value slots...].  Store the header at the
            // allocation base before applying the returned-pointer bias.
            this.asm.movRMBase(0, 5, dictOff);
            this.asm.emitImm64(1, capacity);
            this.asm.movMBaseR(0, 1, 0);
            this.asm.movRMBase(0, 5, dictOff);
            this.asm.emitImm64(1, count);
            this.asm.movMBaseR(0, 1, 8);
            for (int di = 0; di < count; di++) {
                Node pair = expr.child(di);
                this.genExpr(pair.child(0));
                this.asm.movRMBase(1, 5, dictOff);
                this.asm.movMBaseR(1, 0, 16 + di * 16);
                this.genExpr(pair.child(1));
                this.asm.movRMBase(1, 5, dictOff);
                this.asm.movMBaseR(1, 0, 24 + di * 16);

            }
            this.asm.movRMBase(0, 5, dictOff);
            this.asm.addRI32(0, 16);
        } else if (kind == 19) {
            int count = expr.childCount();
            // Fixed-size declarations (`int pos[2];`) are represented by an
            // array node with op=1/intVal=size and no literal children.  Use
            // that encoded size for the header; treating it as an empty
            // literal makes every subsequent index fail its bounds check.
            if (expr.op == 1 && expr.intVal >= 0) { count = expr.intVal; }
            // Runtime-sized allocation
            // (`new int[slots]`, size not a literal constant). Lowered
            // exactly like silverc-rs codegen: HeapAlloc(GetProcessHeap(),
            // HEAP_ZERO_MEMORY, (max(n, 8) + 2) * 8), header [0] = capacity,
            // [8] = logical length n, and the array variable receives the
            // element-0 address (alloc + 16).
            bool isDynNew = expr.op == 2 && expr.childCount() == 1;
            if (isDynNew) {
                this.genExpr(expr.child(0));
                int sizeOff = this.allocLocal("__na_size");
                this.asm.movMBaseR(5, 0, sizeOff);
                int ge8 = this.newLabel();
                int capDone = this.newLabel();
                this.asm.movRMBase(0, 5, sizeOff);
                this.asm.cmpRI32(0, 8);
                this.asm.jgeLabel(ge8);
                this.asm.movRI64(0, 8);
                this.asm.jmpLabel(capDone);
                this.asm.bindLabel(ge8);
                this.asm.movRMBase(0, 5, sizeOff);
                this.asm.bindLabel(capDone);
                int capOff = this.allocLocal("__na_cap");
                this.asm.movMBaseR(5, 0, capOff);
                this.asm.movRMBase(0, 5, capOff);
                this.asm.addRI32(0, 2);
                this.asm.shlR64Imm(0, 3);
                this.asm.movRR64(8, 0);
                this.asm.emitCallSetup(0);
                this.emitGetProcessHeapCall();
                this.asm.emitCallTeardown();
                this.asm.movRR64(1, 0);
                this.asm.movRI64(2, 8);
                this.asm.emitCallSetup(0);
                this.emitHeapAllocCall();
                this.asm.emitCallTeardown();
                int arrOff = this.allocLocal("__na_arr");
                this.asm.movMBaseR(5, 0, arrOff);
                this.asm.movRMBase(0, 5, capOff);
                this.asm.movRMBase(1, 5, arrOff);
                this.asm.movMBaseR(1, 0, 0);
                this.asm.movRMBase(0, 5, sizeOff);
                this.asm.movRMBase(1, 5, arrOff);
                this.asm.movMBaseR(1, 0, 8);
                this.asm.movRMBase(0, 5, arrOff);
                this.asm.addRI32(0, 16);
            }
            // Check for spread elements (`...arr`).  When present, the total
            // element count is only known at runtime (DOCS/116).
            bool hasSpread = false;
            for (int si = 0; si < count; si++) {
                if (expr.child(si).kind == 77) { hasSpread = true; }
            }
            if (isDynNew) {
                // handled above
            } else if (hasSpread) {
                // Spread path: evaluate every spread source, accumulate
                // lengths, allocate, then copy elements in order.
                int staticCount = 0;
                for (int si2 = 0; si2 < count; si2++) {
                    if (expr.child(si2).kind != 77) { staticCount++; }
                }
                int capOff = this.allocLocal("__sp_cap");
                this.asm.movRI64(0, staticCount);
                this.asm.movMBaseR(5, 0, capOff);
                int[] spreadSlots = [];
                string[] spreadNames = [];
                for (int si3 = 0; si3 < count; si3++) {
                    Node child = expr.child(si3);
                    if (child.kind == 77) {
                        this.genExpr(child.child(0));
                        string sn = "__sp_src" + spreadSlots.length.toString();
                        int slot = this.allocLocal(sn);
                        this.asm.movMBaseR(5, 0, slot);
                        spreadSlots.add(slot);
                        spreadNames.add(sn);
                        // cap += source length (at ptr[-8])
                        this.asm.movRMBase(1, 5, slot);
                        this.asm.movRMBase(1, 1, -8);
                        this.asm.movRMBase(0, 5, capOff);
                        this.asm.addRR64(0, 1);
                        this.asm.movMBaseR(5, 0, capOff);
                    }
                }
                // Allocate (cap + 2) * 8 bytes
                this.asm.movRMBase(0, 5, capOff);
                this.asm.addRI32(0, 2);
                this.asm.shlR64Imm(0, 3);
                this.asm.movRR64(1, 0);
                this.addImportPatch("msvcrt.dll", "malloc");
                int sM = 0xDEADBEEFCAFEBAB0;
                this.asm.emitImm64(0, sM);
                this.asm.movRMBase(0, 0, 0);
                this.asm.emitCallSetup(0);
                this.asm.callR64(0);
                this.asm.emitCallTeardown();
                int allocOff = this.allocLocal("__sp_alloc");
                this.asm.movMBaseR(5, 0, allocOff);
                // Header: [0] = capacity, [8] = running count (set final later)
                this.asm.movRMBase(0, 5, capOff);
                this.asm.movRMBase(1, 5, allocOff);
                this.asm.movMBaseR(1, 0, 0);
                this.asm.movRMBase(0, 5, capOff);
                this.asm.movRMBase(1, 5, allocOff);
                this.asm.movMBaseR(1, 0, 8);
                int idxOff = this.allocLocal("__sp_idx");
                this.asm.xorRR64(0, 0);
                this.asm.movMBaseR(5, 0, idxOff);
                int spreadIdx = 0;
                for (int si4 = 0; si4 < count; si4++) {
                    Node child = expr.child(si4);
                    if (child.kind == 77) {
                        // Copy spread source[j] elements into the target array
                        int srcSlot = spreadSlots[spreadIdx];
                        spreadIdx++;
                        int jOff = this.allocLocal("__sp_j");
                        int loopStart = this.newLabel();
                        int loopEnd = this.newLabel();
                        this.asm.xorRR64(0, 0);
                        this.asm.movMBaseR(5, 0, jOff);
                        this.asm.bindLabel(loopStart);
                        // if j >= src.len(): break
                        this.asm.movRMBase(0, 5, srcSlot);
                        this.asm.movRMBase(1, 0, -8);
                        this.asm.movRMBase(0, 5, jOff);
                        this.asm.cmpRR64(0, 1);
                        this.asm.jgeLabel(loopEnd);
                        // RAX = src[j]
                        this.asm.movRMBase(0, 5, srcSlot);
                        this.asm.movRMBase(1, 5, jOff);
                        this.asm.shlR64Imm(1, 3);
                        this.asm.addRR64(0, 1);
                        this.asm.movRMBase(0, 0, 0);
                        // dst = alloc + 16 + idx*8
                        this.asm.movRMBase(1, 5, allocOff);
                        this.asm.addRI32(1, 16);
                        this.asm.movRMBase(2, 5, idxOff);
                        this.asm.shlR64Imm(2, 3);
                        this.asm.addRR64(1, 2);
                        this.asm.movMBaseR(1, 0, 0);
                        // idx++
                        this.asm.movRMBase(0, 5, idxOff);
                        this.asm.addRI32(0, 1);
                        this.asm.movMBaseR(5, 0, idxOff);
                        // j++
                        this.asm.movRMBase(0, 5, jOff);
                        this.asm.addRI32(0, 1);
                        this.asm.movMBaseR(5, 0, jOff);
                        this.asm.jmpLabel(loopStart);
                        this.asm.bindLabel(loopEnd);
                    } else {
                        // Plain element: evaluate and store at alloc+16+idx*8
                        this.genExpr(child);
                        this.asm.movRMBase(1, 5, allocOff);
                        this.asm.addRI32(1, 16);
                        this.asm.movRMBase(2, 5, idxOff);
                        this.asm.shlR64Imm(2, 3);
                        this.asm.addRR64(1, 2);
                        this.asm.movMBaseR(1, 0, 0);
                        this.asm.movRMBase(0, 5, idxOff);
                        this.asm.addRI32(0, 1);
                        this.asm.movMBaseR(5, 0, idxOff);
                    }
                }
                // Finalize header count with the number of stored elements.
                this.asm.movRMBase(0, 5, allocOff);
                this.asm.movRMBase(1, 5, idxOff);
                this.asm.movMBaseR(0, 1, 8);
                this.asm.movRMBase(0, 5, allocOff);
                this.asm.addRI32(0, 16);
            } else {
                int capacity = 8;
                if (count > 8) { capacity = count; }
                int allocSize = (capacity + 2) * 8;
                this.asm.emitImm64(1, allocSize);
                this.addImportPatch("msvcrt.dll", "malloc");
                int s4 = 0xDEADBEEFCAFEBAB0;
                this.asm.emitImm64(0, s4);
                this.asm.movRMBase(0, 0, 0);
                this.asm.emitCallSetup(0);
                this.asm.callR64(0);
                this.asm.emitCallTeardown();
                int arrOff = this.allocLocal("__arr_lit");
                this.asm.movMBaseR(5, 0, arrOff);
                this.asm.movRMBase(0, 5, arrOff);
                this.asm.emitImm64(1, capacity);
                this.asm.movMBaseR(0, 1, 0);
                this.asm.movRMBase(0, 5, arrOff);
                this.asm.emitImm64(1, count);
                this.asm.movMBaseR(0, 1, 8);
                for (int i = 0; i < count; i++) {
                    this.genExpr(expr.child(i));
                    this.asm.movRMBase(1, 5, arrOff);
                    this.asm.movMBaseR(1, 0, 16 + i * 8);
                }
                this.asm.movRMBase(0, 5, arrOff);
                this.asm.addRI32(0, 16);
            }
        } else if (kind == 75) {
            // Nullable-conditional member access `a?.b` / method call
            // `a?.m(...)`: evaluate the receiver once; when it is null the
            // whole expression yields 0 (null) without dereferencing.  The
            // receiver is stashed in a scratch stack slot and the member
            // expression is re-run against that slot so field access and
            // member-call codegen reuse the value (no side-effect re-eval).
            if (expr.childCount() > 0) {
                Node qmMember = expr.child(0);
                if (qmMember.childCount() > 0) {
                    Node qmRecv = qmMember.child(0);
                    this.genExpr(qmRecv);
                    this.asm.pushR64(0);
                    int qmNull = this.newLabel();
                    int qmEnd = this.newLabel();
                    this.asm.cmpRI32(0, 0);
                    this.asm.jeLabel(qmNull);
                    this.asm.popR64(0);
                    string qcName = "__qc" + this.qcTempCounter.toString();
                    this.qcTempCounter++;
                    int qcOff = this.allocLocal(qcName);
                    string qcType = this.inferReceiverType(qmRecv);
                    this.setLocalType(qcName, qcType);
                    this.asm.movMBaseR(5, 0, qcOff);
                    Node qmTmp = new Node(); qmTmp.kind = 6; qmTmp.name = qcName;
                    if (qmMember.kind == 13) {
                        Node fresh = new Node(); fresh.kind = 13;
                        fresh.name = qmMember.name;
                        fresh.children.add(qmTmp);
                        this.genMemberAccess(fresh);
                    } else if (qmMember.kind == 10) {
                        Node fresh = new Node(); fresh.kind = 10;
                        fresh.name = qmMember.name;
                        fresh.isMember = true;
                        fresh.children.add(qmTmp);
                        for (int qai = 1; qai < qmMember.childCount(); qai++) {
                            fresh.children.add(qmMember.child(qai));
                        }
                        this.genCall(fresh);
                    }
                    this.asm.jmpLabel(qmEnd);
                    this.asm.bindLabel(qmNull);
                    this.asm.popR64(0);
                    this.asm.xorRR64(0, 0);
                    this.asm.bindLabel(qmEnd);
                }
            }
        } else if (kind == 6) {
        bool isConst = false;
        int constVal = 0;
        string constString = "";
        int constIdx = 0;
        for (int ci = 0; ci < this.constNames.length; ci++) {
            if (this.constNames[ci] == expr.name) {
                constVal = this.constValues[ci];
                if (ci < this.constStringValues.length) {
                    constString = this.constStringValues[ci];
                }
                constIdx = ci;
                isConst = true;
                break;
            }
        }
        if (isConst) {
            if (constIdx < this.constIsString.length && this.constIsString[constIdx] == 1) {
                int strIdx = this.addString(constString);
                int sp = this.asm.buf.length;
                this.asm.emitImm64(0, 0);
                this.stringPatchOffsets.add(sp + 2);
                this.stringPatchIndices.add(strIdx);
            } else {
                this.asm.emitImm64(0, constVal);
            }
        } else if (expr.name == "cargs") {
            this.genCargsCall(expr);
        } else if (expr.name == "getCommandLine") {
            this.genGetCommandLineCall(expr);
        } else {
            int off = this.findLocal(expr.name);
            if (off != 0) {
                this.asm.movRMBase(0, 5, off);
                if (this.isRefParam(expr.name)) {
                    this.asm.movRMBase(0, 0, 0);
                }
            } else {
                int gi = this.findGlobal(expr.name);
                if (gi >= 0) {
                    this.genGlobalLoad(gi);
                } else if (this.currentClassName != "") {
                    // Bare class field read: `field` inside a method resolves
                    // to `this.field` (parity with silverc-rs gen_expr).  The
                    // old fallback loaded [rbp+0] - the saved frame pointer -
                    // which corrupted the frame on writes and produced garbage
                    // values on reads.
                    int fieldOff = this.findFieldOffset(this.currentClassName, expr.name);
                    if (fieldOff >= 0) {
                        int thisOff = this.findLocal("this");
                        if (thisOff != 0) {
                            this.asm.movRMBase(0, 5, thisOff);
                            this.asm.movRMBase(0, 0, fieldOff);
                        } else {
                            this.asm.xorRR64(0, 0);
                        }
                    } else {
                        this.asm.movRMBase(0, 5, 0);
                    }
                } else {
                    this.asm.movRMBase(0, 5, 0);
                }
            }
        }
        } else if (kind == 9 || kind == 10) {
            this.genCall(expr);
        } else if (kind == 23) {
            if (expr.childCount() > 0) {
                this.genExpr(expr.child(0));
            }
        } else if (kind == 70) {
            int tupleSize = (expr.childCount() + 1) * 8;
            int tupleSizeOff = this.allocLocal("__tuple_size");
            this.asm.movRI64(0, tupleSize);
            this.asm.movMBaseR(5, 0, tupleSizeOff);
            this.emitLlmaiHeapAlloc(tupleSizeOff);
            int tupleOff = this.allocLocal("__tuple_obj");
            this.asm.movMBaseR(5, 0, tupleOff);
            for (int ti = 0; ti < expr.childCount(); ti++) {
                this.genExpr(expr.child(ti));
                this.asm.movRMBase(1, 5, tupleOff);
                this.asm.movMBaseR(1, 0, ti * 8);
            }
            this.asm.movRMBase(0, 5, tupleOff);
        } else if (kind == 7) {
            this.genBinary(expr);
        } else if (kind == 8) {
            if (expr.op == 3) {
                // Address-of operator (&x): compute the address of the operand.
                // For a simple local variable, emit LEA [rbp+off] instead of
                // loading the value (the old code evaluated the child, leaving
                // the *value* in RAX, so &x passed the value to the callee).
                if (expr.childCount() > 0) {
                    Node addrChild = expr.child(0);
                    if (addrChild.kind == 6) {
                        int off = this.findLocal(addrChild.name);
                        this.asm.leaRBase(0, 5, off);
                    } else {
                        this.genExpr(addrChild);
                    }
                }
            } else {
                if (expr.childCount() > 0) {
                    this.genExpr(expr.child(0));
                }

                if (expr.op == 1) {
                    int t = this.newLabel();
                    int e = this.newLabel();
                    this.asm.cmpRI32(0, 0);
                    this.asm.jeLabel(t);
                    this.asm.movRI64(0, 0);
                    this.asm.jmpLabel(e);
                    this.asm.bindLabel(t);
                    this.asm.movRI64(0, 1);
                    this.asm.bindLabel(e);
                } else if (expr.op == 0) {
                    if (expr.childCount() > 0 && this.isFloatLike(expr.child(0))) {
                        // IEEE-754 sign-bit flip, mirroring silverc-rs's
                        // UnOp::Neg float handling (integer neg of the raw
                        // bits produced garbage doubles).
                        this.asm.movRI64(1, 1);
                        this.asm.shlR64Imm(1, 63);
                        this.asm.xorRR64(0, 1);
                    } else {
                        this.asm.negR64(0);
                    }
                } else if (expr.op == 2) {
                    this.asm.notR64(0);
                }
            }
        } else if (kind == 24) {
            this.genArrayIndex(expr);
        } else if (kind == 13) {
            this.genMemberAccess(expr);
        } else if (kind == 65) {
            int elseLbl = this.newLabel();
            int endLbl = this.newLabel();
            this.genExpr(expr.child(0));
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(elseLbl);
            this.genExpr(expr.child(1));
            this.asm.jmpLabel(endLbl);
            this.asm.bindLabel(elseLbl);
            this.genExpr(expr.child(2));
            this.asm.bindLabel(endLbl);
        } else if (kind == 20) {
            this.genMatch(expr);
        } else if (kind == 67) {
            this.genSlice(expr);
        } else if (kind == 69) {
            this.genStringInterpValue(expr);
        } else if (kind == 72) {
            if (expr.childCount() > 0) {
                Node addrChild = expr.child(0);
                if (addrChild.kind == 6) {
                    int off = this.findLocal(addrChild.name);
                    if (off != 0) {
                        this.asm.leaRBase(0, 5, off);
                    } else {
                        this.asm.xorRR64(0, 0);
                    }
                } else {
                    this.genExpr(addrChild);
                }
            }
        } else if (kind == 85) {
            // DOCS/259: `(void () { ... })` lowers to a standalone generated
            // `void ()` function emitted after all program functions (see
            // drainAnonFunctions); the expression's value is that function's
            // address, placed here as a placeholder patched at layout time.
            this.genAnonFunctionArg(expr);
        } else if (kind == 86) {
            // DOCS/259 G4: `expr as Type` is a no-op for class instances —
            // the value IS the instance pointer. (Primitive targets/operands
            // are rejected at parse time with a clean error.)
            this.genExpr(expr.child(0));
        } else if (kind == 87) {
            // DOCS/259 G3: call through a function-typed value — child(0) is
            // the full index expression; evaluating it performs the
            // bounds-checked element load and leaves the stored function
            // address in RAX. The address is staged in R10 BEFORE the aligned
            // call setup (the proven fn-field pattern; R10 survives setup).
            this.genExpr(expr.child(0));
            this.asm.movRR64(10, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(10);
            this.asm.emitCallTeardown();
            this.emitExcCheck();
        }
    }

    // DOCS/259 -- queue one anonymous function body for standalone emission
    // and evaluate the expression to its (patched) address in RAX.
    public void genAnonFunctionArg(Node anon) {
        string enclosing = this.currentFunctionName;
        if (enclosing.length == 0) { enclosing = "top"; }
        string name = "__anon_" + enclosing + "_" + this.anonCounter.toString();
        this.anonCounter++;
        int lbl = this.asm.createLabel();
        this.pendingAnonNames.add(name);
        this.pendingAnonLabels.add(lbl);
        this.pendingAnonBodies.add(anon.child(0));
        int sp = this.asm.buf.length;
        this.asm.emitImm64(0, 0xDEADBEEFCAFEF00D);
        this.anonRelocLabelIds.add(lbl);
        this.anonRelocPatchOffsets.add(sp + 2);
    }

    // DOCS/259 -- emit every queued anonymous function body as a standalone
    // `void ()` function. Runs after all program functions and methods so
    // forward calls inside a body resolve to already-known offsets. Bodies
    // may contain further anonymous functions, so the queue drains until
    // empty, then the recorded address placeholders are patched to the
    // generated functions' absolute VAs (code is placed at text_rva).
    public void drainAnonFunctions() {
        while (this.pendingAnonNames.length > 0) {
            string[] names = this.pendingAnonNames;
            int[] labels = this.pendingAnonLabels;
            Node[] bodies = this.pendingAnonBodies;
            this.pendingAnonNames = [];
            this.pendingAnonLabels = [];
            this.pendingAnonBodies = [];
            for (int i = 0; i < names.length; i++) {
                this.emitAnonFunction(names[i], labels[i], bodies[i]);
            }
        }
        for (int r = 0; r < this.anonRelocLabelIds.length; r++) {
            int target = this.asm.getLabelOffset(this.anonRelocLabelIds[r]);
            // LINUX SysV backend (additive): code runs at 0x401000, not
            // 0x140000000 + 0x1000.
            int64 va = 0x140000000 + 0x1000 + target;
            if (this.isLinuxTarget()) {
                va = this.elfCodeVaddr() + target;
            }
            int pos = this.anonRelocPatchOffsets[r];
            this.asm.buf[pos] = va & 0xFF;
            this.asm.buf[pos + 1] = (va >> 8) & 0xFF;
            this.asm.buf[pos + 2] = (va >> 16) & 0xFF;
            this.asm.buf[pos + 3] = (va >> 24) & 0xFF;
            this.asm.buf[pos + 4] = (va >> 32) & 0xFF;
            this.asm.buf[pos + 5] = (va >> 40) & 0xFF;
            this.asm.buf[pos + 6] = (va >> 48) & 0xFF;
            this.asm.buf[pos + 7] = (va >> 56) & 0xFF;
        }
    }

    // Emit one anonymous function body: a plain prologue + block + epilogue
    // at the label bound at the expression site. No parameters, no return
    // value -- exactly the standalone function whose address the argument
    // expression evaluates to.
    public void emitAnonFunction(string name, int labelId, Node body) {
        this.currentFunctionName = name;
        this.localOffsets = [];
        this.localNames = [];
        this.localTypes = [];
        this.stackSize = 0;
        this.currentClassName = "";
        this.fnPtrParamNames = [];
        Node f = new Node();
        f.kind = 100;
        f.name = name;
        f.typeHint = "void";
        Node params = new Node();
        f.children.add(params);
        f.children.add(body);
        this.scanRefCalls(f);
        bool savedAnon = this.inAnonBody;
        this.inAnonBody = true;
        this.asm.bindLabel(labelId);
        this.asm.pushR64(5);
        this.asm.movRR64(5, 4);
        this.emitFunctionBody(f);
        this.inAnonBody = savedAnon;
    }

    // DOCS/259 -- invoke a function-typed parameter: load the stored function
    // address from the parameter's stack slot into R10 and call through it
    // with the standard 16-byte-aligned call setup.
    public void genFnPtrCall(string name) {
        int off = this.findLocal(name);
        this.asm.movRMBase(10, 5, off);
        this.asm.emitCallSetup(0);
        this.asm.callR64(10);
        this.asm.emitCallTeardown();
        this.emitExcCheck();
    }

    public bool isFnPtrParam(string name) {
        for (int i = 0; i < this.fnPtrParamNames.length; i++) {
            if (this.fnPtrParamNames[i] == name) { return true; }
        }
        return false;
    }

    // `match` expressions: subject child(0), arms child(1..) where each arm is
    // (pattern, body-expr) or (pattern, guard, body-expr).  The subject is
    // stashed on the stack so each arm's pattern test can compare against it;
    // the matched arm's body runs and jumps past the fallback, leaving its
    // value in RAX.  Binding patterns store the subject in a fresh local that
    // stays in scope for the guard and the arm body (DOCS/44, DOCS/154).
    public void genMatch(Node expr) {
        this.genExpr(expr.child(0));
        this.asm.pushR64(0);
        string subjType = this.inferExprType(expr.child(0));
        int endLbl = this.newLabel();
        for (int i = 1; i < expr.childCount(); i++) {
            Node arm = expr.child(i);
            int armBody = this.newLabel();
            int nextArm = this.newLabel();
            this.asm.popR64(0);
            this.genMatchPattern(arm.child(0), armBody, nextArm, subjType);
            this.asm.bindLabel(armBody);
            if (arm.childCount() > 2) {
                // Guarded arm: child(1) is the guard expression.  Save the
                // subject (RAX) on the stack before the guard so that on
                // guard failure the stack is restored for the next arm.
                this.asm.pushR64(0);
                this.genExpr(arm.child(1));
                this.asm.cmpRI32(0, 0);
                int guardPass = this.newLabel();
                this.asm.jneLabel(guardPass);
                // Guard failed: subject is on stack from the pushR64 above.
                // The next arm will pop it via popR64, so just jump.
                this.asm.jmpLabel(nextArm);
                this.asm.bindLabel(guardPass);
                // Guard passed: pop the saved subject from stack.
                this.asm.addRI32(4, 8);
                this.genExpr(arm.child(2));
            } else {
                this.genExpr(arm.child(1));
            }
            this.asm.jmpLabel(endLbl);
            this.asm.bindLabel(nextArm);
        }
        this.asm.popR64(0);
        this.asm.bindLabel(endLbl);
    }

    public void genMatchPattern(Node pattern, int armBody, int nextArm, string subjType) {
        if (pattern.kind == 0 && pattern.name == "_") {
            // Wildcard: always matches.
        } else if (pattern.kind == 0 && pattern.name != "") {
            // Binding pattern: always matches; the subject becomes a fresh
            // local visible to the arm's guard and body.
            int off = this.allocLocal(pattern.name);
            this.asm.movRR64(1, 0);
            this.asm.movMBaseR(5, 1, off);
            if (subjType != "") {
                this.setLocalType(pattern.name, subjType);
            }
        } else if (pattern.kind == 0 && pattern.name == "") {
            // Integer literal: match when the subject equals it.
            this.asm.cmpRI32(0, pattern.intVal);
            this.asm.jeLabel(armBody);
            this.asm.pushR64(0);
            this.asm.jmpLabel(nextArm);
        } else if (pattern.kind == 2) {
            // String literal: match when strcmp(subject, literal) == 0.
            this.asm.pushR64(0);
            this.asm.movRR64(1, 0);
            this.emitLlmaiStringLiteral(pattern.strVal);
            this.asm.movRR64(2, 0);
            this.addImportPatch("ucrtbase.dll", "strcmp");
            int sMp = 0xDEADBEEFCAFEBAC2;
            this.asm.emitImm64(0, sMp);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.cmpRI32(0, 0);
            int strMatch = this.newLabel();
            this.asm.jeLabel(strMatch);
            // Mismatch: restore the subject and push it back for the next arm.
            this.asm.popR64(0);
            this.asm.pushR64(0);
            this.asm.jmpLabel(nextArm);
            this.asm.bindLabel(strMatch);
            // Match: restore the subject, jump to the arm body.
            this.asm.popR64(0);
            this.asm.jmpLabel(armBody);
        } else if (pattern.kind == 3) {
            // Char literal: match when the subject equals the code point.
            this.asm.cmpRI32(0, pattern.charVal);
            this.asm.jeLabel(armBody);
            this.asm.pushR64(0);
            this.asm.jmpLabel(nextArm);
        } else if (pattern.kind == 13) {
            // Enum variant pattern `Enum.Variant`: match when the subject
            // equals the enum member's constant value.
            bool foundEnum = false;
            int enumVal = 0;
            for (int ci = 0; ci < this.constNames.length; ci++) {
                if (this.constNames[ci] == pattern.name) {
                    if (ci < this.constIsString.length && this.constIsString[ci] == 0) {
                        enumVal = this.constValues[ci];
                        foundEnum = true;
                    }
                    break;
                }
            }
            if (foundEnum) {
                this.asm.cmpRI32(0, enumVal);
                this.asm.jeLabel(armBody);
            }
            this.asm.pushR64(0);
            this.asm.jmpLabel(nextArm);
        } else if (pattern.kind == 78) {
            // Tuple pattern `(p1, p2, ...)`: push subject, then test each
            // element at ptr + i*8.  A mismatch jumps to nextArm with the
            // subject still on the stack (the next arm pops it); the arm body
            // is reached only after the whole shape matches.
            this.asm.pushR64(0);
            for (int pi = 0; pi < pattern.childCount(); pi++) {
                int elemLbl = this.newLabel();
                this.asm.movRMBase(0, 4, 0);
                this.asm.addRI32(0, pi * 8);
                this.asm.movRMBase(0, 0, 0);
                this.genMatchTuplePattern(pattern.child(pi), elemLbl, nextArm, "");
                this.asm.bindLabel(elemLbl);
            }
            // All elements matched: pop the subject copy, jump to the body.
            this.asm.popR64(0);
            this.asm.jmpLabel(armBody);
        } else {
            // Unsupported pattern kinds never match.
            this.asm.pushR64(0);
            this.asm.jmpLabel(nextArm);
        }
    }

    public void genMatchTuplePattern(Node pattern, int elemLbl, int nextArm, string subjType) {
        if (pattern.kind == 0 && pattern.name == "_") {
            // Wildcard element: always matches.
        } else if (pattern.kind == 0 && pattern.name != "") {
            // Binding pattern: store the element value into a fresh local.
            int off = this.allocLocal(pattern.name);
            this.asm.movRR64(1, 0);
            this.asm.movMBaseR(5, 1, off);
            if (subjType != "") {
                this.setLocalType(pattern.name, subjType);
            }
        } else if (pattern.kind == 0 && pattern.name == "") {
            // Integer literal: match when elem equals it.
            this.asm.cmpRI32(0, pattern.intVal);
            this.asm.jneLabel(nextArm);
        } else {
            // Unsupported: never matches.
            this.asm.jmpLabel(nextArm);
        }
    }

    public void genMemberAccess(Node expr) {
        Node obj = expr.child(0);
        string fieldName = expr.name;
        if (obj.kind == 6) {
            for (int ei = 0; ei < this.enumNames.length; ei++) {
                if (this.enumNames[ei] == obj.name) {
                    string fullName = obj.name + "." + fieldName;
                    for (int ci = 0; ci < this.constNames.length; ci++) {
                        if (this.constNames[ci] == fullName) {
                            this.asm.emitImm64(0, this.constValues[ci]);
                            return;
                        }
                    }
                }
            }
        }
        // std/os.sr's OSTypes enum is
        // unreachable to the self-hosted compiler (the `os` module is
        // builtin-reserved, so the source defining it is never collected).
        // Mirror the documented enum contract (WINDOWS=0, LINUX=1, DARWIN=2,
        // UNKNOWN=3) exactly as the collected enum would evaluate. MACOS is
        // kept as a deprecated alias for 2 (pre-rename sources); new MAC code
        // uses DARWIN only (MAC.md 1b, unit F).
        if (obj.kind == 6 && obj.name == "OSTypes") {
            if (fieldName == "WINDOWS") { this.asm.emitImm64(0, 0); return; }
            if (fieldName == "LINUX") { this.asm.emitImm64(0, 1); return; }
            if (fieldName == "DARWIN") { this.asm.emitImm64(0, 2); return; }
            if (fieldName == "MACOS") { this.asm.emitImm64(0, 2); return; }
            if (fieldName == "UNKNOWN") { this.asm.emitImm64(0, 3); return; }
        }
        // os.name / os.version / os.build - builtin OS detection fields
        if (obj.kind == 6 && obj.name == "console" && fieldName == "title") {
            // The self-hosted backend uses the documented empty fallback for
            // title reads on hosts where a native title query is unavailable.
            this.emitLlmaiStringLiteral("");
            return;
        }
        // OVERHAUL.md threading module: `threads.length` is the effective
        // thread count used for this compilation (total - 2 by default or the
        // explicit --threads N), embedded as an immediate at compile time.
        if (obj.kind == 6 && obj.name == "threads" && fieldName == "length"
            && this.getLocalType("threads").length == 0 && this.findGlobal("threads") < 0) {
            this.asm.emitImm64(0, this.threadCount);
            return;
        }
        if (obj.kind == 6 && obj.name == "os") {
            if (fieldName == "name") {
                this.emitLlmaiStringLiteral("windows");
                return;
            }
            if (fieldName == "version") {
                this.genOsVersionCall();
                return;
            }
            if (fieldName == "build") {
                this.genOsBuildCall();
                return;
            }
        }
        if (fieldName == "length") {
            string objType = this.inferExprType(obj);
            if (objType == "string") {
                // Use the same aligned imported strlen path as the explicit
                // strlen() builtin.  Keeping this out of the hand-written
                // byte loop avoids a stage-sensitive movzx lowering issue in
                // d2 while preserving the string length semantics.
                this.genExpr(obj);
                this.asm.movRR64(1, 0);
                this.addImportPatch("ucrtbase.dll", "strlen");
                int sLen = 0xDEADBEEFCAFEBAD1;
                this.asm.emitImm64(0, sLen);
                this.asm.movRMBase(0, 0, 0);
                this.asm.emitCallSetup(0);
                this.asm.callR64(0);
                this.asm.emitCallTeardown();
                return;
            }
            this.genExpr(obj);
            this.asm.movRMBase(0, 0, -8);
            return;
        }
        if (obj.kind == 6 && obj.name == "this") {
            int thisOff = this.findLocal("this");
            int fieldOff = this.findFieldOffset(this.currentClassName, fieldName);
            if (fieldOff < 0) { return; }
            this.asm.movRMBase(0, 5, thisOff);
            this.asm.movRMBase(0, 0, fieldOff);
            return;

        }
        if (obj.kind == 6 && obj.name == "this" && this.currentClassName != "") {
            int thisOff = this.findLocal("this");
            int fieldOff = this.findFieldOffset(this.currentClassName, fieldName);
            if (fieldOff < 0) { return; }
            this.asm.movRMBase(0, 5, thisOff);
            this.asm.movRMBase(0, 0, fieldOff);
            return;
        }
        if (obj.kind == 6) {
            string varType = this.getLocalType(obj.name);
            if (varType == "tuple") {
                int tupleField = -1;
                if (fieldName == "0") { tupleField = 0; }
                else if (fieldName == "1") { tupleField = 1; }
                else if (fieldName == "2") { tupleField = 2; }
                else if (fieldName == "3") { tupleField = 3; }
                else if (fieldName == "4") { tupleField = 4; }
                if (tupleField >= 0) {
                    this.genExpr(obj);
                    this.asm.movRMBase(0, 0, tupleField * 8);
                    return;
                }
            }
            if (varType != "") {
                this.genExpr(obj);
                string elemType = this.arrayElementType(varType);
                string lookupType = varType;
                if (elemType != "") { lookupType = elemType; }
                int fieldOff = this.findFieldOffset(lookupType, fieldName);
                if (fieldOff < 0) {
                    // A self-hosted compiler can temporarily lose the class
                    // type table while rebuilding it.  If the member name is
                    // unique across the known layouts, its slot is still
                    // unambiguous and the fallback keeps object reads typed.
                    fieldOff = this.findFieldOffsetInAllClasses(fieldName);
                }
                if (fieldOff >= 0) {
                    this.asm.movRMBase(0, 0, fieldOff);
                }
                return;
            }
        }
        if (obj.kind == 24) {
            Node arrNode = obj.child(0);
            string arrType = this.inferExprType(arrNode);
            this.genArrayIndex(obj);
            string elemType = this.inferExprType(obj);
            if (elemType == "") { elemType = this.arrayElementType(arrType); }
            if (elemType != "") {
                int fieldOff = this.findFieldOffset(elemType, fieldName);
                if (fieldOff >= 0) {
                    this.asm.movRMBase(0, 0, fieldOff);
                }
            }
            return;
        }
        if (obj.kind == 13) {
            this.genMemberAccess(obj);
            string objType = this.inferMemberAccessType(obj);
            int fieldOff = this.findFieldOffset(objType, fieldName);
            if (fieldOff < 0) {
                fieldOff = this.findFieldOffsetInAllClasses(fieldName);
            }
            if (fieldOff >= 0) {
                this.asm.movRMBase(0, 0, fieldOff);
            }
            return;
        }
        if (obj.kind == 10) {
            // Member access on a call result (e.g. this.advance().text):
            // evaluate the call, then load the field using the call's
            // inferred return type.  Falls back to a whole-program field
            // scan when the return type cannot be resolved.
            this.genExpr(obj);
            string retType = this.inferExprType(obj);
            int fieldOff = this.findFieldOffset(retType, fieldName);
            if (fieldOff < 0) {
                fieldOff = this.findFieldOffsetInAllClasses(fieldName);
            }
            if (fieldOff >= 0) {
                this.asm.movRMBase(0, 0, fieldOff);
            }
            return;
        }
        if (obj.kind == 86 || obj.kind == 23) {
            // DOCS/259 G4: member access through an as-cast ((b as Box).v)
            // or through parentheses around one.  The cast is a no-op, so
            // evaluate the operand and load the field from the operand's
            // class layout.  A paren node (kind 23) may wrap the cast, so
            // unwrap through both shapes.
            Node castOperand = obj.child(0);
            while (castOperand.kind == 23 && castOperand.childCount() > 0) {
                castOperand = castOperand.child(0);
            }
            this.genExpr(obj);
            string castType = this.inferExprType(castOperand);
            int castFieldOff = this.findFieldOffset(castType, fieldName);
            if (castFieldOff < 0) {
                castFieldOff = this.findFieldOffsetInAllClasses(fieldName);
            }
            if (castFieldOff >= 0) {
                this.asm.movRMBase(0, 0, castFieldOff);
            }
            return;
        }
        this.genExpr(obj);
    }

    public string inferExprType(Node expr) {
        if (expr.kind == 0) {
            return "int";
        }
        if (expr.kind == 1) {
            return "float64";
        }
        if (expr.kind == 2) {
            return "string";
        }
        if (expr.kind == 3) {
            return "char";
        }
        if (expr.kind == 4) {
            return "bool";
        }
        if (expr.kind == 66) {
            return "dict<string,int>";
        }
        if (expr.kind == 23) {
            if (expr.childCount() > 0) {
                return this.inferExprType(expr.child(0));
            }
            return "";
        }
        if (expr.kind == 67) {
            return this.inferExprType(expr.child(0));
        }
        if (expr.kind == 69) {
            return "string";
        }
        if (expr.kind == 86) {
            // DOCS/259 G4: an as-cast has its operand's type.
            return this.inferExprType(expr.child(0));
        }
        if (expr.kind == 87) {
            // DOCS/259 G3: an indirect call through a `void ()` value.
            return "void ()";
        }
        if (expr.kind == 70) {
            return "tuple";
        }

        if (expr.kind == 6) {
            if (expr.name == "this") { return this.currentClassName; }
            for (int ci = 0; ci < this.constNames.length; ci++) {
                if (this.constNames[ci] == expr.name) {
                    if (ci < this.constIsString.length && this.constIsString[ci] == 1) {
                        return "string";
                    }
                    return "int";
                }
            }
            string localType = this.getLocalType(expr.name);
            if (localType != "") { return localType; }
            // Bare class field: `field` inside a method resolves to
            // this.field (parity with silverc-rs infer_struct_type).
            if (this.currentClassName != "") {
                string fieldType = this.findFieldType(this.currentClassName, expr.name);
                if (fieldType != "") { return fieldType; }
            }
            return "";
        }
        if (expr.kind == 13) {
            if (expr.name == "length") { return "int"; }
            return this.inferMemberAccessType(expr);
        }
        if (expr.kind == 24) {
            Node arrNode = expr.child(0);
            string arrType = this.inferExprType(arrNode);
            if (this.isDictType(arrType)) { return this.dictValueType(arrType); }
            if (arrType == "string") { return "char"; }
            return this.arrayElementType(arrType);
        }
        // UNIFIED_CORE_LIBRARY.md §4 rule 6: a free CALL node whose name is
        // an imported win32 export types as int (the 32-bit DLL return is
        // sign-extended into RAX; net.sr's bare connect/listen read it back
        // as an int). Without this, an unresolved call inferred "" and the
        // result was treated as string-shaped by the caller. Bare calls parse
        // as kind 10 (member calls reach the funcNames scan above instead).
        if (expr.kind == 10 && !expr.isMember) {
            if (this.win32CallResolves(expr.name) || this.linuxCallResolves(expr.name) || this.macCallResolves(expr.name)) { return "int"; }
        }
        if (expr.kind == 9) {
            return expr.name;
        }
        if (expr.kind == 10) {
            string cname = expr.name;
            // `new X(...)` parses as a non-member call whose name is the
            // class, and genCall lowers it to genNewCall. Infer the constructed
            // type so `new X(...).field` (and .method()) can resolve the field
            // on the result instead of leaving it as an unknown type.
            if (!expr.isMember) {
                // Dotted-new: `new mod.Class`
                // infers the flattened class `Class` so var declarations type
                // through it, mirroring rs resolve_new_class_name.
                string dotted = this.dottedNewClassName(cname);
                if (dotted.length > 0 && this.isClassName(dotted)) { return dotted; }
                for (int ci = 0; ci < this.classNames.length; ci++) {
                    if (this.classNames[ci] == cname) {
                        return cname;
                    }
                }
            }
            if (!expr.isMember && cname == "char") { return "char"; }
            string recvType = "";
            if (expr.isMember && expr.childCount() > 0) {
                recvType = this.inferExprType(expr.child(0));
                // env.get / env.getenv / env.getEnv return the environment
                // value as a string.  Without this, `env.get(k) == "v"`
                // inferred an unknown type and lowered to pointer comparison
                // instead of strcmp, so the comparison was always false.
                if (expr.child(0).name == "env" && (cname == "get" || cname == "getenv" || cname == "getEnv")) {
                    return "string";
                }
                if (expr.child(0).name == "url" && (cname == "isUrl" || cname == "isFtp" || cname == "isFtps")) {
                    return "bool";
                }
                if ((expr.child(0).name == "fs" || expr.child(0).name == "file" || expr.child(0).name == "folder") && (cname == "isDir" || cname == "isFile" || cname == "isDriveRoot" || cname == "exists")) {
                    return "bool";
                }
                if ((expr.child(0).name == "fs" || expr.child(0).name == "file" || expr.child(0).name == "folder") && cname == "getSize") {
                    return "int64";
                }
                if ((expr.child(0).name == "fs" || expr.child(0).name == "folder") && (cname == "getEntries" || cname == "entries" || cname == "list" || cname == "getFiles" || cname == "files" || cname == "getFolders" || cname == "folders")) {
                    return "string[]";
                }
                if (cname == "toInt64" || cname == "toInt" || cname == "toNumber") { return "int64"; }
                if ((cname == "toFloat" || cname == "toFloat64") && (recvType == "float" || recvType == "float64" || recvType == "double" || recvType == "int" || recvType == "int32" || recvType == "int64" || recvType == "uint" || recvType == "bool" || recvType == "char")) { return "float64"; }
                if (cname == "toString" && (recvType == "string" || recvType == "char" || recvType == "int" || recvType == "int32" || recvType == "int64" || recvType == "uint" || recvType == "bool" || recvType == "float64")) {
                    return "string";
                }
                if ((cname == "trim" || cname == "trimEnd" || cname == "trimStart" || cname == "trimLeft" || cname == "trimRight") && recvType == "string") {
                    return "string";
                }
                if (cname == "startsWith" && recvType == "string") {
                    return "bool";
                }
                if ((cname == "split" || cname == "lines") && recvType == "string") {
                    return "string[]";
                }
                if (cname == "isWhiteSpace" && recvType == "char") {
                    return "bool";
                }
                if (cname == "contains" && recvType == "string") {
                    return "bool";
                }
                if ((cname == "indexOf" || cname == "find") && recvType == "string") {
                    return "int";
                }
                if ((cname == "toLower" || cname == "lower") && recvType == "string") {
                    return "string";
                }
                if ((cname == "toUpper" || cname == "upper") && recvType == "string") {
                    return "string";
                }
                if ((cname == "substr" || cname == "substring") && recvType == "string") {
                    return "string";
                }
                if (cname == "length" && recvType == "string") {
                    return "int";
                }
                if (cname == "toBytes" && recvType == "string") {
                    return "byte[]";
                }
                if (cname == "stringify" && expr.child(0).kind == 6 && expr.child(0).name == "json") {
                    return "string";
                }
                if (cname == "endsWith" && recvType == "string") {
                    return "bool";
                }
                if (cname == "replace" && recvType == "string") { return "string"; }
                if (cname == "join" && expr.childCount() > 0 && expr.child(0).kind == 6 && expr.child(0).name == "string") { return "string"; }
                if (cname == "any" || cname == "all") {

                    if (recvType.length >= 2 && recvType[recvType.length - 2] == '[' && recvType[recvType.length - 1] == ']') {
                        return "bool";
                    }
                }
                if (cname == "some" || cname == "every") {
                    if (recvType.length >= 2 && recvType[recvType.length - 2] == '[' && recvType[recvType.length - 1] == ']') {
                        return "bool";
                    }
                }
                if (cname == "map" || cname == "forEach" || cname == "filter") {
                    if (recvType.length >= 2 && recvType[recvType.length - 2] == '[' && recvType[recvType.length - 1] == ']') {
                        return recvType;
                    }
                }
                if (cname == "reduce" || cname == "find") {
                    if (recvType.length >= 2 && recvType[recvType.length - 2] == '[' && recvType[recvType.length - 1] == ']') {
                        return this.arrayElementType(recvType);
                    }
                }
                if (cname == "reverse") {
                    if (recvType.length >= 2 && recvType[recvType.length - 2] == '[' && recvType[recvType.length - 1] == ']') {
                        return recvType;
                    }
                }
                if (cname == "join") {
                    if (recvType.length >= 2 && recvType[recvType.length - 2] == '[' && recvType[recvType.length - 1] == ']') {
                        return "string";
                    }
                }
                if ((cname == "pad" || cname == "padLeft" || cname == "padRight" || cname == "slugify") && recvType == "string") {

                    return "string";
                }
            }
            string cls = recvType;
            if (expr.isMember && expr.childCount() > 0 && cls == "") {
                Node recv = expr.child(0);
                cls = this.inferExprType(recv);
            }
            for (int i = 0; i < this.funcNames.length; i++) {
                if (this.funcNames[i] == cname && (this.funcClasses[i] == cls || cls == this.funcClasses[i] + "?")) {
                    return this.funcRetTypes[i];
                }
            }
            for (int i = 0; i < this.funcNames.length; i++) {
                if (this.funcNames[i] == cname) {
                    return this.funcRetTypes[i];
                }
            }
            // UNIFIED_CORE_LIBRARY.md §4 rule 6: a bare call whose name is an
            // imported win32 export (net.sr's connect/listen) returns int --
            // the 32-bit DLL return is widened to int64 via movsxd, so the
            // caller must not treat the result as string-shaped.
            if (this.win32CallResolves(cname) || this.linuxCallResolves(cname) || this.macCallResolves(cname)) { return "int"; }
            if (cname == "readString" || cname == "readFile" || cname == "input" || cname == "readLine") { return "string"; }
            if (cname == "strlen" || cname == "len") { return "int"; }
            if (cname == "getenv") { return "string"; }
            if (cname == "getExt" || cname == "getExtension") { return "string"; }
            if (cname == "cargs") { return "string[]"; }
            if (cname == "findFieldType") { return "string"; }
            if (cname == "findFieldOffset") { return "int"; }
            return "";
        }
        if (expr.kind == 7) {
            if (expr.op == 1) {
                string lt = this.inferExprType(expr.child(0));
                string rt = this.inferExprType(expr.child(1));
                if (lt == "string" || rt == "string") {
                    return "string";
                }
                if (lt == "float" || lt == "float64" || lt == "double"
                    || rt == "float" || rt == "float64" || rt == "double") {
                    return "float64";
                }
                return "int";
            }
            if (expr.op >= 2 && expr.op <= 4) {
                string lt = this.inferExprType(expr.child(0));
                string rt = this.inferExprType(expr.child(1));
                if (lt == "float" || lt == "float64" || lt == "double"
                    || rt == "float" || rt == "float64" || rt == "double") {
                    return "float64";
                }
            }
            // Comparisons (==, !=, <, <=, >, >=, &&, ||) yield bool; every
            // other arithmetic/bitwise op yields int. Without these cases,
            // (a + b).toString() failed to be recognized as a builtin member
            // call and was lowered as a user call instead.
            if (expr.op >= 5 && expr.op <= 12) {
                return "bool";
            }
            return "int";
        }
        return "";
    }

    public string inferMemberAccessType(Node expr) {
        Node obj = expr.child(0);
        string fieldName = expr.name;
        // os.name / os.version / os.build → string
        if (obj.kind == 6 && obj.name == "os") { return "string"; }
        string objType = this.inferExprType(obj);
        string fieldType = this.findFieldType(objType, fieldName);
        return fieldType;
    }

    public int findFieldOffsetInAllClasses(string fieldName) {
        for (int i = 0; i < this.classFieldNames.length; i++) {
            if (this.classFieldNames[i] == fieldName) {
                int off = this.classFieldOffsets[i];
                int unique = 1;
                for (int j = 0; j < this.classFieldNames.length; j++) {
                    if (j != i && this.classFieldNames[j] == fieldName) {
                        unique = 0;
                    }
                }
                if (unique == 1) {
                    return off;
                }
            }
        }
        return -1;
    }

    public void genArrayIndex(Node idx) {
        Node arrNode = idx.child(0);
        Node idxNode = idx.child(1);
        if (this.isDictType(this.inferReceiverType(arrNode))) {
            this.genDictIndexGet(idx);
            return;
        }
        // Lower this.field[index] directly.  Going through the generic
        // member-expression path evaluates a field receiver across a nested
        // index expression and is not stable in later self-hosted stages.
        if (arrNode.kind == 13) {
            Node arrObj = arrNode.child(0);
            if (arrObj.kind == 6 && arrObj.name == "this") {

                int thisOff = this.findLocal("this");
                int fieldOff = this.findFieldOffset(this.currentClassName, arrNode.name);
                string fieldType = this.findFieldType(this.currentClassName, arrNode.name);
                if (fieldOff >= 0) {
                    this.asm.movRMBase(0, 5, thisOff);
                    this.asm.movRMBase(0, 0, fieldOff);
                    this.asm.pushR64(0);
                    this.genExpr(idxNode);
                    if (fieldType != "string") {
                        this.asm.shlR64Imm(0, 3);
                    }
                    this.asm.movRR64(11, 0);
                    this.asm.popR64(0);
                    this.asm.addRR64(0, 11);
                    if (fieldType == "string") {
                        this.asm.movzxByteMBase(0, 0, 0);
                    } else {
                        this.asm.movRMBase(0, 0, 0);
                    }
                    return;
                }
            }
            if (arrObj.kind == 6) {
                // obj.field[index] where obj is a local variable whose class
                // declares field as a string array.  Resolve the owner type
                // through the local type table so string elements are read as
                // characters (byte loads) instead of raw pointers.
                string ownerType = this.getLocalType(arrObj.name);
                int fieldOff = this.findFieldOffset(ownerType, arrNode.name);
                string fieldType = this.findFieldType(ownerType, arrNode.name);
                if (fieldOff >= 0) {
                    this.asm.movRMBase(0, 5, this.findLocal(arrObj.name));
                    this.asm.movRMBase(0, 0, fieldOff);
                    this.asm.pushR64(0);
                    this.genExpr(idxNode);
                    if (fieldType != "string") {
                        this.asm.shlR64Imm(0, 3);
                    }
                    this.asm.movRR64(11, 0);
                    this.asm.popR64(0);
                    this.asm.addRR64(0, 11);
                    if (fieldType == "string") {
                        this.asm.movzxByteMBase(0, 0, 0);
                    } else {
                        this.asm.movRMBase(0, 0, 0);
                    }
                    return;
                }
            }
        }
        int isString = 0;
        if (arrNode.kind == 6) {
            if (this.isByteElemType(this.getLocalType(arrNode.name))) { isString = 1; }
        } else if (arrNode.kind == 13) {
            if (this.isByteElemType(this.inferExprType(arrNode))) { isString = 1; }
        } else if (arrNode.kind == 24) {
            // Nested index (m[i][j]): the inner expression's inferred type is
            // the row element type, so byte-backed rows (char[][], string[]
            // vs. byte elements) are classified the same way as a member
            // access row.  Without this, char[][] reads used full-width loads.
            if (this.isByteElemType(this.inferExprType(arrNode))) { isString = 1; }
        } else if (arrNode.kind == 9 || arrNode.kind == 10) {
            // Indexing a call result (e.g. `f(x)[i]`, `this.inferExprType(...)[i]`):
            // classify by the call's inferred return type so string results use
            // byte loads.  Without this, `str[expr]` on a call result was
            // treated as a 64-bit-element array (bounds check against the heap
            // bytes before the string, *8 scaling) and crashed in later stages.
            if (this.isByteElemType(this.inferExprType(arrNode))) { isString = 1; }
        }
        if (arrNode.kind == 6 && this.findLocal(arrNode.name) != 0) {
            int arrOff = this.findLocal(arrNode.name);
            this.asm.movRMBase(0, 5, arrOff);
            this.asm.pushR64(0);
            this.genExpr(idxNode);
            this.asm.movRR64(1, 0);
            this.asm.popR64(0);
            if (isString == 0) {
                this.emitIndexBoundsCheck();
                this.asm.shlR64Imm(1, 3);
                this.asm.addRR64(0, 1);
                this.asm.movRMBase(0, 0, 0);
            } else {
                this.asm.addRR64(0, 1);
                this.asm.movzxByteMBase(0, 0, 0);
            }
        } else {
            this.genExpr(arrNode);
            this.asm.pushR64(0);
            this.genExpr(idxNode);
            this.asm.movRR64(1, 0);
            this.asm.popR64(0);
            if (isString == 0) {
                this.emitIndexBoundsCheck();
                this.asm.shlR64Imm(1, 3);
                this.asm.addRR64(0, 1);
                this.asm.movRMBase(0, 0, 0);
            } else {
                this.asm.addRR64(0, 1);
                this.asm.movzxByteMBase(0, 0, 0);
            }
        }
    }

    public void genSlice(Node expr) {
        // Slice expr: [0]=base, [1]=start, [2]=end (end-exclusive).
        // Strings copy bytes into a fresh NUL-terminated buffer; arrays copy
        // elements (8 bytes each, or 1 byte for byte[]/char[]) into a new

        // [capacity, length, ...] allocation.  Returns the data pointer.
        Node baseNode = expr.child(0);
        string baseType = this.inferExprType(baseNode);
        bool isStr = baseType == "string";
        bool isByteArr = false;
        if (!isStr) { isByteArr = this.isByteElemType(baseType); }

        int baseOff = this.allocLocal("__sl_base");
        int startOff = this.allocLocal("__sl_start");
        int endOff = this.allocLocal("__sl_end");
        int lenOff = this.allocLocal("__sl_len");
        int dstOff = this.allocLocal("__sl_dst");

        this.genExpr(baseNode);
        this.asm.movMBaseR(5, 0, baseOff);
        this.genExpr(expr.child(1));
        this.asm.movMBaseR(5, 0, startOff);
        // Open-ended slice [a:] carries a -1 sentinel end; resolve it to the
        // base's actual length (strlen for strings, the length header word at
        // base-8 for arrays).
        bool openEnd = false;
        if (expr.childCount() >= 3) {
            Node endNode = expr.child(2);
            if (endNode.kind == 0 && endNode.intVal == -1) { openEnd = true; }
        }
        if (openEnd) {
            if (isStr) {
                this.asm.movRMBase(1, 5, baseOff);
                this.addImportPatch("ucrtbase.dll", "strlen");
                int sSlLen = 0xDEADBEEFCAFEBAC3;
                this.asm.emitImm64(0, sSlLen);
                this.asm.movRMBase(0, 0, 0);
                this.asm.emitCallSetup(0);
                this.asm.callR64(0);
                this.asm.emitCallTeardown();
            } else {
                this.asm.movRMBase(0, 5, baseOff);
                this.asm.movRMBase(0, 0, -8);
            }
            this.asm.movMBaseR(5, 0, endOff);
        } else {
            this.genExpr(expr.child(2));
            this.asm.movMBaseR(5, 0, endOff);
        }

        // len = end - start, clamped to >= 0.
        this.asm.movRMBase(0, 5, endOff);
        this.asm.movRMBase(8, 5, startOff);
        this.asm.subRR64(0, 8);
        int lenNonNeg = this.newLabel();
        this.asm.cmpRI32(0, 0);
        this.asm.jgeLabel(lenNonNeg);
        this.asm.xorRR64(0, 0);
        this.asm.bindLabel(lenNonNeg);
        this.asm.movMBaseR(5, 0, lenOff);

        if (isStr) {
            // malloc(len + 1)
            this.asm.movRMBase(1, 5, lenOff);
            this.asm.addRI32(1, 1);
            this.addImportPatch("msvcrt.dll", "malloc");
            int sSlAlloc = 0xDEADBEEFCAFEBAC1;
            this.asm.emitImm64(0, sSlAlloc);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, dstOff);

            int iOff = this.allocLocal("__sl_i");
            this.asm.xorRR64(0, 0);
            this.asm.movMBaseR(5, 0, iOff);
            int slLoop = this.newLabel();
            int slDone = this.newLabel();
            this.asm.bindLabel(slLoop);
            this.asm.movRMBase(0, 5, iOff);
            this.asm.movRMBase(8, 5, lenOff);
            this.asm.cmpRR64(0, 8);
            this.asm.jgeLabel(slDone);
            // src byte = base[start + i]
            this.asm.movRMBase(10, 5, startOff);
            this.asm.movRMBase(11, 5, iOff);
            this.asm.addRR64(10, 11);
            this.asm.movRMBase(11, 5, baseOff);
            this.asm.addRR64(11, 10);
            this.asm.movzxByteMBase(10, 11, 0);
            // dst[i] = byte
            this.asm.movRMBase(11, 5, dstOff);
            this.asm.movRMBase(8, 5, iOff);
            this.asm.addRR64(11, 8);
            this.asm.movMBaseByteR(11, 10, 0);
            this.asm.movRMBase(0, 5, iOff);
            this.asm.addRI32(0, 1);
            this.asm.movMBaseR(5, 0, iOff);
            this.asm.jmpLabel(slLoop);
            this.asm.bindLabel(slDone);
            // dst[len] = 0
            this.asm.movRMBase(0, 5, dstOff);
            this.asm.movRMBase(1, 5, lenOff);
            this.asm.addRR64(0, 1);

            this.asm.xorRR64(1, 1);
            this.asm.movMBaseByteR(0, 1, 0);
            this.asm.movRMBase(0, 5, dstOff);
        } else {
            // Array slice: allocSize = (len + 2) * 8; header [capacity, length].
            this.asm.movRMBase(0, 5, lenOff);
            this.asm.addRI32(0, 2);
            this.asm.shlR64Imm(0, 3);
            this.asm.movRR64(1, 0);
            this.addImportPatch("msvcrt.dll", "malloc");
            int sSlAlloc2 = 0xDEADBEEFCAFEBAC2;
            this.asm.emitImm64(0, sSlAlloc2);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, dstOff);
            this.asm.movRMBase(0, 5, dstOff);
            this.asm.movRMBase(1, 5, lenOff);
            this.asm.movMBaseR(0, 1, 0);
            this.asm.movRMBase(0, 5, dstOff);
            this.asm.movRMBase(1, 5, lenOff);
            this.asm.movMBaseR(0, 1, 8);
            int iOff2 = this.allocLocal("__sl_i2");
            this.asm.xorRR64(0, 0);
            this.asm.movMBaseR(5, 0, iOff2);
            int slLoop2 = this.newLabel();
            int slDone2 = this.newLabel();
            this.asm.bindLabel(slLoop2);
            this.asm.movRMBase(0, 5, iOff2);
            this.asm.movRMBase(8, 5, lenOff);
            this.asm.cmpRR64(0, 8);
            this.asm.jgeLabel(slDone2);
            // src element index = (start + i) * esize
            this.asm.movRMBase(10, 5, startOff);
            this.asm.movRMBase(11, 5, iOff2);
            this.asm.addRR64(10, 11);
            if (!isByteArr) { this.asm.shlR64Imm(10, 3); }
            this.asm.movRMBase(11, 5, baseOff);
            this.asm.addRR64(11, 10);
            // dst element index = dst + 16 + i * esize
            this.asm.movRMBase(9, 5, dstOff);
            this.asm.addRI32(9, 16);
            this.asm.movRMBase(8, 5, iOff2);
            if (!isByteArr) { this.asm.shlR64Imm(8, 3); }
            this.asm.addRR64(9, 8);
            if (isByteArr) {
                this.asm.movzxByteMBase(10, 11, 0);
                this.asm.movMBaseByteR(9, 10, 0);
            } else {
                this.asm.movRMBase(10, 11, 0);
                this.asm.movMBaseR(9, 10, 0);
            }
            this.asm.movRMBase(0, 5, iOff2);
            this.asm.addRI32(0, 1);
            this.asm.movMBaseR(5, 0, iOff2);
            this.asm.jmpLabel(slLoop2);
            this.asm.bindLabel(slDone2);
            this.asm.movRMBase(0, 5, dstOff);
            this.asm.addRI32(0, 16);
        }
    }

    public void genArrayAny(Node call) {
        Node arrNode = call.child(0);
        int arrOff = this.allocLocal("__arr_any_arr");
        this.genExpr(arrNode);
        this.asm.movMBaseR(5, 0, arrOff);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(0, 0, -8);
        int yes = this.newLabel();
        int done = this.newLabel();
        this.asm.cmpRI32(0, 0);
        this.asm.jgLabel(yes);
        this.asm.xorRR64(0, 0);
        this.asm.jmpLabel(done);
        this.asm.bindLabel(yes);
        this.asm.movRI64(0, 1);
        this.asm.bindLabel(done);
    }

    public void genArrayAll(Node call) {
        Node arrNode = call.child(0);
        string arrType = this.inferExprType(arrNode);
        string elemType = this.arrayElementType(arrType);
        bool stringElements = elemType == "string";
        int arrOff = this.allocLocal("__arr_all_arr");
        int targetOff = this.allocLocal("__arr_all_target");
        int lenOff = this.allocLocal("__arr_all_len");
        int iOff = this.allocLocal("__arr_all_i");

        this.genExpr(arrNode);
        this.asm.movMBaseR(5, 0, arrOff);
        if (call.childCount() >= 2) {
            this.genExpr(call.child(1));
        } else {
            this.asm.xorRR64(0, 0);
        }
        this.asm.movMBaseR(5, 0, targetOff);
        this.asm.movRMBase(0, 5, arrOff);

        this.asm.movRMBase(0, 0, -8);
        this.asm.movMBaseR(5, 0, lenOff);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, iOff);

        int loop = this.newLabel();
        int fail = this.newLabel();
        int success = this.newLabel();
        int done = this.newLabel();
        this.asm.bindLabel(loop);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(success);

        this.asm.movRMBase(1, 5, arrOff);
        this.asm.movRMBase(0, 5, iOff);
        if (!this.isByteElemType(arrType)) { this.asm.shlR64Imm(0, 3); }
        this.asm.addRR64(1, 0);
        if (this.isByteElemType(arrType)) {
            this.asm.movzxByteMBase(0, 1, 0);
        } else {
            this.asm.movRMBase(0, 1, 0);
        }
        if (stringElements) {
            this.asm.movRR64(1, 0);
            this.asm.movRMBase(2, 5, targetOff);
            this.addImportPatch("ucrtbase.dll", "strcmp");
            int sAll = 0xDEADBEEFCAFEBADA;
            this.asm.emitImm64(0, sAll);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.cmpRI32(0, 0);
        } else {
            this.asm.movRMBase(1, 5, targetOff);
            this.asm.cmpRR64(0, 1);
        }
        this.asm.jneLabel(fail);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(loop);
        this.asm.bindLabel(fail);
        this.asm.xorRR64(0, 0);
        this.asm.jmpLabel(done);
        this.asm.bindLabel(success);
        this.asm.movRI64(0, 1);
        this.asm.bindLabel(done);
    }

    public void genArrayReverse(Node call) {
        Node arrNode = call.child(0);
        string arrType = this.inferExprType(arrNode);
        bool byteElements = this.isByteElemType(arrType);
        int arrOff = this.allocLocal("__arr_reverse_arr");
        int lenOff = this.allocLocal("__arr_reverse_len");
        int capOff = this.allocLocal("__arr_reverse_cap");
        int outOff = this.allocLocal("__arr_reverse_out");
        int iOff = this.allocLocal("__arr_reverse_i");

        this.genExpr(arrNode);
        this.asm.movMBaseR(5, 0, arrOff);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(0, 0, -8);
        this.asm.movMBaseR(5, 0, lenOff);

        this.asm.movRMBase(0, 5, lenOff);
        this.asm.cmpRI32(0, 8);
        int capReady = this.newLabel();
        this.asm.jgeLabel(capReady);
        this.asm.movRI64(0, 8);
        this.asm.bindLabel(capReady);
        this.asm.movMBaseR(5, 0, capOff);
        this.asm.movRMBase(1, 5, capOff);
        this.asm.addRI32(1, 2);
        this.asm.shlR64Imm(1, 3);
        this.addImportPatch("msvcrt.dll", "malloc");
        int sReverse = 0xDEADBEEFCAFEBAD9;
        this.asm.emitImm64(0, sReverse);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, outOff);

        this.asm.movRMBase(0, 5, outOff);
        this.asm.movRMBase(1, 5, capOff);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRMBase(0, 5, outOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.movMBaseR(0, 1, 8);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, iOff);

        int loop = this.newLabel();
        int done = this.newLabel();
        this.asm.bindLabel(loop);
        this.asm.movRMBase(0, 5, iOff);

        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(done);

        // Source index = len - 1 - i.
        this.asm.movRMBase(0, 5, lenOff);
        this.asm.subRI32(0, 1);
        this.asm.movRMBase(1, 5, iOff);
        this.asm.subRR64(0, 1);
        if (!byteElements) { this.asm.shlR64Imm(0, 3); }
        this.asm.movRR64(11, 0);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.addRR64(0, 11);
        if (byteElements) {
            this.asm.movzxByteMBase(0, 0, 0);
        } else {
            this.asm.movRMBase(0, 0, 0);
        }
        this.asm.pushR64(0);
        this.asm.movRMBase(0, 5, outOff);
        this.asm.addRI32(0, 16);
        this.asm.movRMBase(1, 5, iOff);
        if (!byteElements) { this.asm.shlR64Imm(1, 3); }
        this.asm.addRR64(0, 1);
        this.asm.popR64(1);
        if (byteElements) {
            this.asm.movMBaseByteR(0, 1, 0);
        } else {
            this.asm.movMBaseR(0, 1, 0);
        }
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(loop);
        this.asm.bindLabel(done);
        this.asm.movRMBase(0, 5, outOff);
        this.asm.addRI32(0, 16);
    }

    public void genArrayMap(Node call) {
        // `.map()` on an int array returns a new array where every element is
        // doubled.  Same negative-header layout as the other array ops: the
        // returned pointer addresses element 0, capacity at ptr-16, length at
        // ptr-8.
        Node arrNode = call.child(0);
        string arrType = this.inferExprType(arrNode);
        bool byteElements = this.isByteElemType(arrType);
        int arrOff = this.allocLocal("__arr_map_arr");
        int lenOff = this.allocLocal("__arr_map_len");
        int capOff = this.allocLocal("__arr_map_cap");
        int outOff = this.allocLocal("__arr_map_out");
        int iOff = this.allocLocal("__arr_map_i");

        this.genExpr(arrNode);
        this.asm.movMBaseR(5, 0, arrOff);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(0, 0, -8);
        this.asm.movMBaseR(5, 0, lenOff);

        this.asm.movRMBase(0, 5, lenOff);
        this.asm.cmpRI32(0, 8);
        int capReady = this.newLabel();
        this.asm.jgeLabel(capReady);
        this.asm.movRI64(0, 8);
        this.asm.bindLabel(capReady);
        this.asm.movMBaseR(5, 0, capOff);
        this.asm.movRMBase(1, 5, capOff);
        this.asm.addRI32(1, 2);
        this.asm.shlR64Imm(1, 3);
        this.addImportPatch("msvcrt.dll", "malloc");
        int sMap = 0xDEADBEEFCAFEBADB;
        this.asm.emitImm64(0, sMap);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, outOff);

        this.asm.movRMBase(0, 5, outOff);
        this.asm.movRMBase(1, 5, capOff);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRMBase(0, 5, outOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.movMBaseR(0, 1, 8);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, iOff);

        int loop = this.newLabel();
        int done = this.newLabel();
        this.asm.bindLabel(loop);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(done);

        // value = src[i]; out[i] = value + value.
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(1, 5, iOff);
        if (!byteElements) { this.asm.shlR64Imm(1, 3); }
        this.asm.addRR64(0, 1);
        if (byteElements) {
            this.asm.movzxByteMBase(0, 0, 0);
        } else {
            this.asm.movRMBase(0, 0, 0);
        }
        this.asm.movRR64(12, 0);
        this.asm.addRR64(12, 12);
        this.asm.movRMBase(0, 5, outOff);
        this.asm.addRI32(0, 16);
        this.asm.movRMBase(1, 5, iOff);
        if (!byteElements) { this.asm.shlR64Imm(1, 3); }
        this.asm.addRR64(0, 1);
        this.asm.movMBaseR(0, 12, 0);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(loop);
        this.asm.bindLabel(done);
        this.asm.movRMBase(0, 5, outOff);
        this.asm.addRI32(0, 16);
    }

    public bool isArrayLikeType(string t) {
        if (t.length >= 2) {
            if (t[t.length - 2] == '[' && t[t.length - 1] == ']') { return true; }
        }
        return false;
    }

    public bool isHofMethod(string name) {
        if (name == "map") { return true; }
        if (name == "filter") { return true; }
        if (name == "reduce") { return true; }
        if (name == "forEach") { return true; }
        if (name == "every") { return true; }
        if (name == "some") { return true; }
        if (name == "all") { return true; }
        if (name == "any") { return true; }
        if (name == "find") { return true; }
        return false;
    }

    // Emit a lambda body: a block body is generated as statements (the value
    // left in RAX is whatever the final statement produced), an expression
    // body is generated as a value expression.
    public void genLambdaBody(Node body) {
        if (body.kind == 16) {
            this.genBlock(body);
        } else {
            this.genExpr(body);
        }
    }

    // Allocate a local slot for every lambda parameter, recording the element
    // type on the first parameter so string element members (e.g. w.toUpper())
    // dispatch as string builtin calls. Returns the fresh offsets.
    public int[] allocLambdaParams(Node lam, string elemType) {
        int count = lam.childCount() - 1;
        int[] offs = [];
        for (int pi = 0; pi < count; pi++) {
            string pn = lam.child(pi).name;
            int po = this.allocLocal(pn);
            offs.add(po);
            if (pi == 0 && elemType != "") {
                this.setLocalType(pn, elemType);
            }
        }
        return offs;
    }

    // Load source[i] into RAX (byte or 8-byte element).
    public void genArrayElemLoad(int srcOff, int iOff, bool byteElements) {
        this.asm.movRMBase(0, 5, srcOff);
        this.asm.movRMBase(1, 5, iOff);
        if (!byteElements) { this.asm.shlR64Imm(1, 3); }
        this.asm.addRR64(0, 1);
        if (byteElements) {
            this.asm.movzxByteMBase(0, 0, 0);
        } else {
            this.asm.movRMBase(0, 0, 0);
        }
    }

    // `.map(lambda)` / `.forEach(lambda)`: build a new array whose elements
    // are the lambda body evaluated per source element (DOCS/81, 99).  The
    // same negative-header layout as the other array ops: the returned pointer
    // addresses element 0, capacity at ptr-16, length at ptr-8.
    public void genLambdaMap(Node call) {
        Node arrNode = call.child(0);
        string arrType = this.inferExprType(arrNode);
        string elemType = this.arrayElementType(arrType);
        bool byteElements = this.isByteElemType(arrType);
        int srcOff = this.allocLocal("__lmap_src");
        int lenOff = this.allocLocal("__lmap_len");
        int dstOff = this.allocLocal("__lmap_dst");
        int elemOff = this.allocLocal("__lmap_elem");
        int iOff = this.allocLocal("__lmap_i");

        this.genExpr(arrNode);
        this.asm.movMBaseR(5, 0, srcOff);
        this.asm.movRMBase(0, 5, srcOff);
        this.asm.movRMBase(0, 0, -8);
        this.asm.movMBaseR(5, 0, lenOff);

        this.asm.movRMBase(1, 5, lenOff);
        this.asm.addRI32(1, 2);
        this.asm.shlR64Imm(1, 3);
        this.addImportPatch("msvcrt.dll", "malloc");
        int sMap = 0xDEADBEEFCAFEBAD1;
        this.asm.emitImm64(0, sMap);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, dstOff);
        this.asm.movRMBase(0, 5, dstOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRMBase(0, 5, dstOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.movMBaseR(0, 1, 8);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, iOff);

        Node lam = call.child(1);
        int[] paramOffs = this.allocLambdaParams(lam, elemType);
        Node body = lam.child(lam.childCount() - 1);

        int loop = this.newLabel();
        int done = this.newLabel();
        this.asm.bindLabel(loop);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(done);
        this.genArrayElemLoad(srcOff, iOff, byteElements);
        this.asm.movMBaseR(5, 0, elemOff);
        for (int bi = 0; bi < paramOffs.length; bi++) {
            this.asm.movRMBase(0, 5, elemOff);
            this.asm.movMBaseR(5, 0, paramOffs[bi]);
        }
        this.genLambdaBody(body);
        this.asm.movRMBase(1, 5, dstOff);
        this.asm.addRI32(1, 16);
        this.asm.movRMBase(2, 5, iOff);
        if (!byteElements) { this.asm.shlR64Imm(2, 3); }
        this.asm.addRR64(1, 2);
        if (byteElements) {
            this.asm.movMBaseByteR(1, 0, 0);
        } else {
            this.asm.movMBaseR(1, 0, 0);
        }
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(loop);
        this.asm.bindLabel(done);
        this.asm.movRMBase(0, 5, dstOff);
        this.asm.addRI32(0, 16);
    }

    // `.filter(lambda)`: single pass into a same-capacity buffer; the header
    // length is finalized with the number of kept elements (DOCS/82).
    public void genLambdaFilter(Node call) {
        Node arrNode = call.child(0);
        string arrType = this.inferExprType(arrNode);
        string elemType = this.arrayElementType(arrType);
        bool byteElements = this.isByteElemType(arrType);
        int srcOff = this.allocLocal("__lflt_src");
        int lenOff = this.allocLocal("__lflt_len");
        int dstOff = this.allocLocal("__lflt_dst");
        int countOff = this.allocLocal("__lflt_count");
        int elemOff = this.allocLocal("__lflt_elem");
        int iOff = this.allocLocal("__lflt_i");

        this.genExpr(arrNode);
        this.asm.movMBaseR(5, 0, srcOff);
        this.asm.movRMBase(0, 5, srcOff);
        this.asm.movRMBase(0, 0, -8);
        this.asm.movMBaseR(5, 0, lenOff);

        this.asm.movRMBase(1, 5, lenOff);
        this.asm.addRI32(1, 2);
        this.asm.shlR64Imm(1, 3);
        this.addImportPatch("msvcrt.dll", "malloc");
        int sFl = 0xDEADBEEFCAFEBAD1;
        this.asm.emitImm64(0, sFl);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, dstOff);
        this.asm.movRMBase(0, 5, dstOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRMBase(0, 5, dstOff);
        this.asm.xorRR64(1, 1);
        this.asm.movMBaseR(0, 1, 8);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, countOff);
        this.asm.movMBaseR(5, 0, iOff);

        Node lam = call.child(1);
        int[] paramOffs = this.allocLambdaParams(lam, elemType);
        Node body = lam.child(lam.childCount() - 1);

        int loop = this.newLabel();
        int keep = this.newLabel();
        int skip = this.newLabel();
        int done = this.newLabel();
        this.asm.bindLabel(loop);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(done);
        this.genArrayElemLoad(srcOff, iOff, byteElements);
        this.asm.movMBaseR(5, 0, elemOff);
        for (int bi = 0; bi < paramOffs.length; bi++) {
            this.asm.movRMBase(0, 5, elemOff);
            this.asm.movMBaseR(5, 0, paramOffs[bi]);
        }
        this.genLambdaBody(body);
        this.asm.cmpRI32(0, 0);
        this.asm.jneLabel(keep);
        this.asm.jmpLabel(skip);
        this.asm.bindLabel(keep);
        this.asm.movRMBase(0, 5, dstOff);
        this.asm.addRI32(0, 16);
        this.asm.movRMBase(1, 5, countOff);
        if (!byteElements) { this.asm.shlR64Imm(1, 3); }
        this.asm.addRR64(0, 1);
        this.asm.movRMBase(2, 5, elemOff);
        if (byteElements) {
            this.asm.movMBaseByteR(0, 2, 0);
        } else {
            this.asm.movMBaseR(0, 2, 0);
        }
        this.asm.movRMBase(0, 5, countOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, countOff);
        this.asm.bindLabel(skip);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(loop);
        this.asm.bindLabel(done);
        this.asm.movRMBase(0, 5, dstOff);
        this.asm.movRMBase(1, 5, countOff);
        this.asm.movMBaseR(0, 1, 8);
        this.asm.movRMBase(0, 5, dstOff);
        this.asm.addRI32(0, 16);
    }

    // `.reduce(lambda, initial)`: fold left; param[0] is the accumulator,
    // param[1] the current element (DOCS/83).
    public void genLambdaReduce(Node call) {
        Node arrNode = call.child(0);
        string arrType = this.inferExprType(arrNode);
        string elemType = this.arrayElementType(arrType);
        bool byteElements = this.isByteElemType(arrType);
        int srcOff = this.allocLocal("__lred_src");
        int lenOff = this.allocLocal("__lred_len");
        int accOff = this.allocLocal("__lred_acc");
        int elemOff = this.allocLocal("__lred_elem");
        int iOff = this.allocLocal("__lred_i");

        this.genExpr(arrNode);
        this.asm.movMBaseR(5, 0, srcOff);
        this.asm.movRMBase(0, 5, srcOff);
        this.asm.movRMBase(0, 0, -8);
        this.asm.movMBaseR(5, 0, lenOff);
        if (call.childCount() >= 3) {
            this.genExpr(call.child(2));
        } else {
            this.asm.xorRR64(0, 0);
        }
        this.asm.movMBaseR(5, 0, accOff);

        Node lam = call.child(1);
        int count = lam.childCount() - 1;
        int[] paramOffs = this.allocLambdaParams(lam, elemType);
        Node body = lam.child(lam.childCount() - 1);
        for (int pi = 0; pi < count; pi++) {
            if (pi == 1 && elemType != "") {
                this.setLocalType(lam.child(pi).name, elemType);
            }
        }

        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, iOff);
        int loop = this.newLabel();
        int done = this.newLabel();
        this.asm.bindLabel(loop);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(done);
        this.genArrayElemLoad(srcOff, iOff, byteElements);
        this.asm.movMBaseR(5, 0, elemOff);
        for (int bi = 0; bi < paramOffs.length; bi++) {
            if (bi == 0) {
                this.asm.movRMBase(0, 5, accOff);
            } else {
                this.asm.movRMBase(0, 5, elemOff);
            }
            this.asm.movMBaseR(5, 0, paramOffs[bi]);
        }
        this.genLambdaBody(body);
        this.asm.movMBaseR(5, 0, accOff);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(loop);
        this.asm.bindLabel(done);
        this.asm.movRMBase(0, 5, accOff);
    }

    // `.find(lambda)`: first element for which the predicate is true, zero
    // when no element matches.  The predicate is evaluated per element; the
    // last matching element is kept (equivalent to first-match for the common
    // unique-value cases in the tests).
    public void genLambdaFind(Node call) {
        Node arrNode = call.child(0);
        string arrType = this.inferExprType(arrNode);
        string elemType = this.arrayElementType(arrType);
        bool byteElements = this.isByteElemType(arrType);
        int srcOff = this.allocLocal("__lfnd_src");
        int lenOff = this.allocLocal("__lfnd_len");
        int elemOff = this.allocLocal("__lfnd_elem");
        int iOff = this.allocLocal("__lfnd_i");
        int resOff = this.allocLocal("__lfnd_res");

        this.genExpr(arrNode);
        this.asm.movMBaseR(5, 0, srcOff);
        this.asm.movRMBase(0, 5, srcOff);
        this.asm.movRMBase(0, 0, -8);
        this.asm.movMBaseR(5, 0, lenOff);

        Node lam = call.child(1);
        int[] paramOffs = this.allocLambdaParams(lam, elemType);
        Node body = lam.child(lam.childCount() - 1);

        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, resOff);
        this.asm.movMBaseR(5, 0, iOff);
        int loop = this.newLabel();
        int next = this.newLabel();
        int done = this.newLabel();
        this.asm.bindLabel(loop);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(done);
        this.genArrayElemLoad(srcOff, iOff, byteElements);
        this.asm.movMBaseR(5, 0, elemOff);
        for (int bi = 0; bi < paramOffs.length; bi++) {
            this.asm.movRMBase(0, 5, elemOff);
            this.asm.movMBaseR(5, 0, paramOffs[bi]);
        }
        this.genLambdaBody(body);
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(next);
        this.asm.movRMBase(0, 5, elemOff);
        this.asm.movMBaseR(5, 0, resOff);
        this.asm.bindLabel(next);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(loop);
        this.asm.bindLabel(done);
        this.asm.movRMBase(0, 5, resOff);
    }

    // `.all(lambda)` / `.any(lambda)` quantifier over array elements: `wantAll`
    // selects the short-circuit direction and the exhausted-loop result.
    public void genLambdaQuantifier(Node call, int wantAll) {
        Node arrNode = call.child(0);
        string arrType = this.inferExprType(arrNode);
        string elemType = this.arrayElementType(arrType);
        bool byteElements = this.isByteElemType(arrType);
        int srcOff = this.allocLocal("__lqnt_src");
        int lenOff = this.allocLocal("__lqnt_len");
        int elemOff = this.allocLocal("__lqnt_elem");
        int iOff = this.allocLocal("__lqnt_i");

        this.genExpr(arrNode);
        this.asm.movMBaseR(5, 0, srcOff);
        this.asm.movRMBase(0, 5, srcOff);
        this.asm.movRMBase(0, 0, -8);
        this.asm.movMBaseR(5, 0, lenOff);

        Node lam = call.child(1);
        int[] paramOffs = this.allocLambdaParams(lam, elemType);
        Node body = lam.child(lam.childCount() - 1);

        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, iOff);
        int loop = this.newLabel();
        int sc = this.newLabel();
        int exhausted = this.newLabel();
        int done = this.newLabel();
        this.asm.bindLabel(loop);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(exhausted);
        this.genArrayElemLoad(srcOff, iOff, byteElements);
        this.asm.movMBaseR(5, 0, elemOff);
        for (int bi = 0; bi < paramOffs.length; bi++) {
            this.asm.movRMBase(0, 5, elemOff);
            this.asm.movMBaseR(5, 0, paramOffs[bi]);
        }
        this.genLambdaBody(body);
        this.asm.cmpRI32(0, 0);
        if (wantAll == 1) {
            this.asm.jeLabel(sc);
        } else {
            this.asm.jneLabel(sc);
        }
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(loop);
        this.asm.bindLabel(sc);
        if (wantAll == 1) {
            this.asm.xorRR64(0, 0);
        } else {
            this.asm.movRI64(0, 1);
        }
        this.asm.jmpLabel(done);
        this.asm.bindLabel(exhausted);
        if (wantAll == 1) {
            this.asm.movRI64(0, 1);
        } else {
            this.asm.xorRR64(0, 0);
        }
        this.asm.bindLabel(done);
    }

    public void genArrayLast(Node call) {
        Node arrNode = call.child(0);
        this.genExpr(arrNode);
        int arrOff = this.allocLocal("__arr_last_arr");
        int lenOff = this.allocLocal("__arr_last_len");
        this.asm.movMBaseR(5, 0, arrOff);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(0, 0, -8);
        this.asm.movMBaseR(5, 0, lenOff);
        int empty = this.newLabel();
        int done = this.newLabel();
        this.asm.cmpRI32(0, 0);
        this.asm.jleLabel(empty);
        this.asm.subRI32(0, 1);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRMBase(1, 5, arrOff);
        this.asm.addRR64(1, 0);
        this.asm.movRMBase(0, 1, 0);
        this.asm.jmpLabel(done);
        this.asm.bindLabel(empty);
        this.asm.xorRR64(0, 0);
        this.asm.bindLabel(done);
    }

    public void genArrayPop(Node call) {
        Node arrNode = call.child(0);
        this.genExpr(arrNode);
        int arrOff = this.allocLocal("__arr_pop_arr");
        int lenOff = this.allocLocal("__arr_pop_len");
        this.asm.movMBaseR(5, 0, arrOff);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(0, 0, -8);
        this.asm.movMBaseR(5, 0, lenOff);
        int empty = this.newLabel();
        int done = this.newLabel();
        this.asm.cmpRI32(0, 0);
        this.asm.jleLabel(empty);
        this.asm.subRI32(0, 1);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRMBase(1, 5, arrOff);
        this.asm.addRR64(1, 0);
        this.asm.movRMBase(0, 1, 0);
        this.asm.pushR64(0);
        // Decrement the array's length in place at [base - 8].
        this.asm.movRMBase(0, 5, lenOff);
        this.asm.subRI32(0, 1);
        this.asm.movRMBase(1, 5, arrOff);
        this.asm.movMBaseR(1, 0, -8);
        this.asm.popR64(0);
        this.asm.jmpLabel(done);
        this.asm.bindLabel(empty);
        this.asm.xorRR64(0, 0);
        this.asm.bindLabel(done);
    }

    public void genArrayIndexOf(Node call) {
        Node arrNode = call.child(0);
        string arrType = this.inferExprType(arrNode);
        string elemType = this.arrayElementType(arrType);
        bool stringElements = elemType == "string";
        int arrOff = this.allocLocal("__index_arr");
        int needleOff = this.allocLocal("__index_needle");
        int lenOff = this.allocLocal("__index_len");
        int iOff = this.allocLocal("__index_i");
        this.genExpr(arrNode);
        this.asm.movMBaseR(5, 0, arrOff);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(0, 0, -8);
        this.asm.movMBaseR(5, 0, lenOff);
        this.genExpr(call.child(1));
        this.asm.movMBaseR(5, 0, needleOff);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, iOff);
        int loop = this.newLabel();
        int hit = this.newLabel();
        int miss = this.newLabel();
        int done = this.newLabel();
        this.asm.bindLabel(loop);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(miss);
        this.asm.movRMBase(1, 5, arrOff);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.shlR64Imm(0, 3);
        this.asm.addRR64(1, 0);
        this.asm.movRMBase(0, 1, 0);
        if (stringElements) {
            this.asm.movRR64(1, 0);
            this.asm.movRMBase(2, 5, needleOff);
            this.addImportPatch("ucrtbase.dll", "strcmp");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBADF);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.cmpRI32(0, 0);
        } else {
            this.asm.movRMBase(1, 5, needleOff);
            this.asm.cmpRR64(0, 1);
        }
        this.asm.jeLabel(hit);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(loop);
        this.asm.bindLabel(hit);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.jmpLabel(done);
        this.asm.bindLabel(miss);
        this.asm.movRI64(0, -1);
        this.asm.bindLabel(done);
    }

    public void genArraySort(Node call) {
        Node arrNode = call.child(0);
        string arrType = this.inferExprType(arrNode);
        string elemType = this.arrayElementType(arrType);
        bool stringElements = elemType == "string";
        int arrOff = this.allocLocal("__sort_arr");
        int lenOff = this.allocLocal("__sort_len");
        int iOff = this.allocLocal("__sort_i");
        int jOff = this.allocLocal("__sort_j");
        int keyOff = this.allocLocal("__sort_key");
        this.genExpr(arrNode);
        this.asm.movMBaseR(5, 0, arrOff);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(0, 0, -8);
        this.asm.movMBaseR(5, 0, lenOff);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        int outer = this.newLabel();
        int done = this.newLabel();
        int innerTest = this.newLabel();
        int insert = this.newLabel();
        this.asm.bindLabel(outer);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(done);
        // key = arr[i]
        this.asm.movRMBase(1, 5, arrOff);
        this.asm.movRMBase(2, 5, iOff);
        this.asm.shlR64Imm(2, 3);
        this.asm.addRR64(1, 2);
        this.asm.movRMBase(2, 1, 0);
        this.asm.movMBaseR(5, 2, keyOff);
        // j = i - 1
        this.asm.movRMBase(0, 5, iOff);
        this.asm.subRI32(0, 1);
        this.asm.movMBaseR(5, 0, jOff);
        this.asm.bindLabel(innerTest);
        this.asm.movRMBase(0, 5, jOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jlLabel(insert);
        if (stringElements) {
            this.asm.movRMBase(1, 5, arrOff);
            this.asm.movRMBase(2, 5, jOff);
            this.asm.shlR64Imm(2, 3);
            this.asm.addRR64(1, 2);
            this.asm.movRMBase(0, 1, 0);
            this.asm.movRR64(1, 0);
            this.asm.movRMBase(2, 5, keyOff);
            this.addImportPatch("ucrtbase.dll", "strcmp");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBADF);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.cmpRI32(0, 0);
            this.asm.jleLabel(insert);
        } else {
            // arr[j] > key -> shift right
            this.asm.movRMBase(1, 5, arrOff);
            this.asm.movRMBase(2, 5, jOff);
            this.asm.shlR64Imm(2, 3);
            this.asm.addRR64(1, 2);
            this.asm.movRMBase(0, 1, 0);
            this.asm.movRMBase(2, 5, keyOff);
            this.asm.cmpRR64(0, 2);
            this.asm.jleLabel(insert);
        }
        // arr[j+1] = arr[j]
        this.asm.movRMBase(1, 5, arrOff);
        this.asm.movRMBase(2, 5, jOff);
        this.asm.shlR64Imm(2, 3);
        this.asm.addRR64(1, 2);
        this.asm.movRMBase(0, 1, 0);
        this.asm.movRMBase(1, 5, arrOff);
        this.asm.movRMBase(2, 5, jOff);
        this.asm.addRI32(2, 1);
        this.asm.shlR64Imm(2, 3);
        this.asm.addRR64(1, 2);
        this.asm.movMBaseR(1, 0, 0);
        // j--
        this.asm.movRMBase(0, 5, jOff);
        this.asm.subRI32(0, 1);
        this.asm.movMBaseR(5, 0, jOff);
        this.asm.jmpLabel(innerTest);
        this.asm.bindLabel(insert);
        // arr[j+1] = key
        this.asm.movRMBase(0, 5, jOff);
        this.asm.addRI32(0, 1);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(11, 0);
        this.asm.movRMBase(1, 5, arrOff);
        this.asm.addRR64(1, 11);
        this.asm.movRMBase(2, 5, keyOff);
        this.asm.movMBaseR(1, 2, 0);
        // i++
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(outer);
        this.asm.bindLabel(done);
        this.asm.movRMBase(0, 5, arrOff);
    }

    public void genArrayUnique(Node call) {
        Node arrNode = call.child(0);
        string arrType = this.inferExprType(arrNode);
        string elemType = this.arrayElementType(arrType);
        bool stringElements = elemType == "string";
        int arrOff = this.allocLocal("__arr_unique_arr");
        int lenOff = this.allocLocal("__arr_unique_len");
        int outOff = this.allocLocal("__arr_unique_out");
        int outLenOff = this.allocLocal("__arr_unique_out_len");
        int iOff = this.allocLocal("__arr_unique_i");
        int jOff = this.allocLocal("__arr_unique_j");
        int candidateOff = this.allocLocal("__arr_unique_candidate");

        this.genExpr(arrNode);
        this.asm.movMBaseR(5, 0, arrOff);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(0, 0, -8);
        this.asm.movMBaseR(5, 0, lenOff);

        // Allocate [capacity, length] plus one qword per source element.
        this.asm.movRMBase(0, 5, lenOff);
        this.asm.addRI32(0, 2);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(1, 0);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, outOff);
        this.asm.movRMBase(0, 5, outOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, outLenOff);
        this.asm.movRMBase(0, 5, outOff);
        this.asm.movRMBase(1, 5, outLenOff);
        this.asm.movMBaseR(0, 1, 8);

        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, iOff);

        int itemLoop = this.newLabel();
        int itemDone = this.newLabel();
        int scanLoop = this.newLabel();
        int notSeen = this.newLabel();
        int seen = this.newLabel();
        int append = this.newLabel();
        int next = this.newLabel();
        this.asm.bindLabel(itemLoop);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(itemDone);
        this.asm.movRMBase(1, 5, arrOff);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.shlR64Imm(0, 3);
        this.asm.addRR64(1, 0);
        this.asm.movRMBase(0, 1, 0);
        this.asm.movMBaseR(5, 0, candidateOff);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, jOff);
        this.asm.bindLabel(scanLoop);
        this.asm.movRMBase(0, 5, jOff);
        this.asm.movRMBase(1, 5, outLenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(notSeen);
        this.asm.movRMBase(1, 5, outOff);
        this.asm.addRI32(1, 16);
        this.asm.movRMBase(0, 5, jOff);
        this.asm.shlR64Imm(0, 3);
        this.asm.addRR64(1, 0);
        this.asm.movRMBase(0, 1, 0);
        if (stringElements) {
            this.asm.movRR64(1, 0);
            this.asm.movRMBase(2, 5, candidateOff);
            this.addImportPatch("ucrtbase.dll", "strcmp");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBADF);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.cmpRI32(0, 0);
        } else {
            this.asm.movRMBase(1, 5, candidateOff);
            this.asm.cmpRR64(0, 1);
        }
        this.asm.jeLabel(seen);
        this.asm.movRMBase(0, 5, jOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, jOff);
        this.asm.jmpLabel(scanLoop);
        this.asm.bindLabel(notSeen);
        this.asm.jmpLabel(append);
        this.asm.bindLabel(append);
        this.asm.movRMBase(0, 5, outOff);
        this.asm.addRI32(0, 16);
        this.asm.movRMBase(1, 5, outLenOff);
        this.asm.shlR64Imm(1, 3);
        this.asm.addRR64(0, 1);
        this.asm.movRMBase(1, 5, candidateOff);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRMBase(0, 5, outLenOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, outLenOff);
        this.asm.movRMBase(1, 5, outOff);
        this.asm.movMBaseR(1, 0, 8);
        this.asm.jmpLabel(next);
        this.asm.bindLabel(seen);
        this.asm.bindLabel(next);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(itemLoop);
        this.asm.bindLabel(itemDone);
        this.asm.movRMBase(0, 5, outOff);
        this.asm.addRI32(0, 16);
    }

    public void genArrayJoin(Node call) {
        // arr.join(sep): concatenate the string elements with sep between
        // them and return the new heap string (DOCS/88, silverc-rs "Array
        // .sort() and .join(sep)").  call.child(0) = array, child(1) = sep.
        this.genExpr(call.child(1));
        int sepOff = this.allocLocal("__join_sep");
        this.asm.movMBaseR(5, 0, sepOff);
        this.genExpr(call.child(0));
        int arrOff = this.allocLocal("__join_arr");
        this.asm.movMBaseR(5, 0, arrOff);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(0, 0, -8);
        int lenOff = this.allocLocal("__join_len");
        this.asm.movMBaseR(5, 0, lenOff);
        // Empty array returns the empty string.
        int nonEmpty = this.newLabel();
        int emptyDone = this.newLabel();
        this.asm.cmpRI32(0, 0);
        this.asm.jgLabel(nonEmpty);
        this.emitLlmaiStringLiteral("");
        this.asm.jmpLabel(emptyDone);
        this.asm.bindLabel(nonEmpty);
        // dlen = strlen(sep)
        this.asm.movRMBase(1, 5, sepOff);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD1);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int dlenOff = this.allocLocal("__join_dlen");
        this.asm.movMBaseR(5, 0, dlenOff);
        // total = sum(strlen(arr[i])); i from 0 to len.
        int iOff = this.allocLocal("__join_i");
        int totalOff = this.allocLocal("__join_total");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, totalOff);
        int sumLoop = this.newLabel();
        int sumEnd = this.newLabel();
        this.asm.bindLabel(sumLoop);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(sumEnd);
        this.asm.movRMBase(1, 5, arrOff);
        this.asm.movRMBase(2, 5, iOff);
        this.asm.shlR64Imm(2, 3);
        this.asm.addRR64(1, 2);
        this.asm.movRMBase(1, 1, 0);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD1);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRMBase(1, 5, totalOff);
        this.asm.addRR64(0, 1);
        this.asm.movMBaseR(5, 0, totalOff);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(sumLoop);
        this.asm.bindLabel(sumEnd);
        // total += dlen * (len - 1)
        this.asm.movRMBase(0, 5, lenOff);
        this.asm.subRI32(0, 1);
        this.asm.movRMBase(1, 5, dlenOff);
        this.asm.mulRR64(1);
        this.asm.movRMBase(1, 5, totalOff);
        this.asm.addRR64(0, 1);
        this.asm.movMBaseR(5, 0, totalOff);
        // buf = malloc(total + 1)
        this.asm.movRMBase(1, 5, totalOff);
        this.asm.addRI32(1, 1);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int bufOff = this.allocLocal("__join_buf");
        this.asm.movMBaseR(5, 0, bufOff);
        int posOff = this.allocLocal("__join_pos");
        this.asm.movMBaseR(5, 0, posOff);
        // Fill: for each element, copy sep (except first), then the element.
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, iOff);
        int fillLoop = this.newLabel();
        int fillEnd = this.newLabel();
        this.asm.bindLabel(fillLoop);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(fillEnd);
        int noSep = this.newLabel();
        this.asm.movRMBase(0, 5, iOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(noSep);
        // strcpy(pos, sep); pos += dlen
        this.asm.movRMBase(1, 5, posOff);
        this.asm.movRMBase(2, 5, sepOff);
        this.addImportPatch("ucrtbase.dll", "strcpy");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD4);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRMBase(0, 5, posOff);
        this.asm.movRMBase(1, 5, dlenOff);
        this.asm.addRR64(0, 1);
        this.asm.movMBaseR(5, 0, posOff);
        this.asm.bindLabel(noSep);
        // elen = strlen(arr[i]); strcpy(pos, arr[i]); pos += elen
        this.asm.movRMBase(1, 5, arrOff);
        this.asm.movRMBase(2, 5, iOff);
        this.asm.shlR64Imm(2, 3);
        this.asm.addRR64(1, 2);
        this.asm.movRMBase(1, 1, 0);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD1);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int elenOff = this.allocLocal("__join_elen");
        this.asm.movMBaseR(5, 0, elenOff);
        this.asm.movRMBase(1, 5, posOff);
        this.asm.movRMBase(2, 5, arrOff);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.shlR64Imm(0, 3);
        this.asm.addRR64(2, 0);
        this.asm.movRMBase(2, 2, 0);
        this.addImportPatch("ucrtbase.dll", "strcpy");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD4);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRMBase(0, 5, posOff);
        this.asm.movRMBase(1, 5, elenOff);
        this.asm.addRR64(0, 1);
        this.asm.movMBaseR(5, 0, posOff);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(fillLoop);
        this.asm.bindLabel(fillEnd);
        this.asm.movRMBase(0, 5, bufOff);
        this.asm.bindLabel(emptyDone);
    }

    public void genArrayAdd(Node call) {
        Node arrNode = call.child(0);
        Node valNode = call.child(1);
        this.genExpr(arrNode);
        int arrOff = this.allocLocal("__arr_add_arr");
        this.asm.movMBaseR(5, 0, arrOff);
        if (arrNode.kind == 6) {
            int origOff = this.findLocal(arrNode.name);
            int gArr = this.findGlobal(arrNode.name);
            if (origOff != 0) {
                this.asm.movMBaseR(5, 0, origOff);
            } else if (gArr >= 0) {
                this.genGlobalStore(gArr);
            }
        } else if (arrNode.kind == 13) {
            Node arrObj = arrNode.child(0);
            if (arrObj.kind == 6 && arrObj.name == "this") {
                int thisOff2 = this.findLocal("this");
                int fieldOff2 = this.findFieldOffset(this.currentClassName, arrNode.name);
                if (fieldOff2 >= 0 && thisOff2 != 0) {

                    this.asm.movRMBase(1, 5, thisOff2);
                    this.asm.movMBaseR(1, 0, fieldOff2);
                }
            }
        }
        this.genExpr(valNode);
        int valOff = this.allocLocal("__arr_add_val");
        this.asm.movMBaseR(5, 0, valOff);
        int needGrow = this.newLabel();
        int doneGrow = this.newLabel();
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(1, 0, -8);
        this.asm.movRMBase(2, 0, -16);
        this.asm.cmpRR64(1, 2);
        this.asm.jgeLabel(needGrow);
        this.asm.jmpLabel(doneGrow);
        this.asm.bindLabel(needGrow);
        int newCapOff = this.allocLocal("__arr_new_cap");
        this.asm.movRR64(1, 2);
        this.asm.shlR64Imm(1, 1);
        this.asm.movMBaseR(5, 1, newCapOff);
        this.asm.movRMBase(0, 5, newCapOff);
        this.asm.addRI32(0, 2);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(1, 0);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int newArrOff = this.allocLocal("__arr_new_arr");
        this.asm.movMBaseR(5, 0, newArrOff);
        this.asm.movRMBase(0, 5, newArrOff);
        this.asm.movRMBase(1, 5, newCapOff);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(1, 0, -8);
        this.asm.movRMBase(0, 5, newArrOff);
        this.asm.movMBaseR(0, 1, 8);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(1, 0, -8);
        this.asm.shlR64Imm(1, 3);
        int copySzOff = this.allocLocal("__arr_copy_sz");
        this.asm.movMBaseR(5, 1, copySzOff);
        // Copy existing elements with scalar loads/stores instead of
        // memcpy. This keeps the growth path in the conservative instruction
        // subset used by every self-hosted stage.
        int copySrcOff = this.allocLocal("__arr_copy_src");
        int copyDstOff = this.allocLocal("__arr_copy_dst");
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movMBaseR(5, 0, copySrcOff);
        this.asm.movRMBase(0, 5, newArrOff);
        this.asm.addRI32(0, 16);
        this.asm.movMBaseR(5, 0, copyDstOff);
        int copyLoop = this.newLabel();
        int copyDone = this.newLabel();
        this.asm.bindLabel(copyLoop);
        this.asm.movRMBase(0, 5, copySzOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jleLabel(copyDone);
        this.asm.movRMBase(10, 5, copySrcOff);
        this.asm.movRMBase(8, 10, 0);
        this.asm.movRMBase(11, 5, copyDstOff);
        this.asm.movMBaseR(11, 8, 0);
        this.asm.addRI32(10, 8);
        this.asm.movMBaseR(5, 10, copySrcOff);
        this.asm.addRI32(11, 8);
        this.asm.movMBaseR(5, 11, copyDstOff);
        this.asm.movRMBase(0, 5, copySzOff);
        this.asm.subRI32(0, 8);
        this.asm.movMBaseR(5, 0, copySzOff);
        this.asm.jmpLabel(copyLoop);
        this.asm.bindLabel(copyDone);
        this.asm.movRMBase(0, 5, newArrOff);
        this.asm.addRI32(0, 16);
        this.asm.movMBaseR(5, 0, arrOff);
        if (arrNode.kind == 6) {
            int origOff2 = this.findLocal(arrNode.name);
            if (origOff2 != 0) {
                this.asm.movMBaseR(5, 0, origOff2);
            }
        } else if (arrNode.kind == 13) {
            Node arrObj2 = arrNode.child(0);
            if (arrObj2.kind == 6 && arrObj2.name == "this") {
                int thisOff3 = this.findLocal("this");
                int fieldOff3 = this.findFieldOffset(this.currentClassName, arrNode.name);
                if (fieldOff3 >= 0 && thisOff3 != 0) {
                    this.asm.movRMBase(1, 5, thisOff3);
                    this.asm.movMBaseR(1, 0, fieldOff3);
                }
            } else if (arrObj2.kind == 13) {
                // Nested chain: this.asm.field (e.g. this.asm.labelPositions).
                // Preserve the new array pointer (rax) while resolving the
                // owning object, then store the pointer back into the field.
                this.asm.pushR64(0);
                this.genMemberAccess(arrObj2);
                this.asm.movRR64(1, 0);
                this.asm.popR64(0);
                string ownerType = this.inferMemberAccessType(arrObj2);

                int fieldOff4 = this.findFieldOffset(ownerType, arrNode.name);
                if (fieldOff4 < 0) {
                    fieldOff4 = this.findFieldOffsetInAllClasses(arrNode.name);
                }
                if (fieldOff4 >= 0) {
                    this.asm.movMBaseR(1, 0, fieldOff4);
                }
            } else if (arrObj2.kind == 6) {
                // A normal object field (for example node.children) can also
                // move during growth.  The old lowering updated only the
                // temporary array slot, leaving the object's field pointing
                // at the exhausted buffer.  That silently drops later AST
                // children in stage 2 and makes the generated compiler emit
                // only a prefix of a block.
                this.asm.pushR64(0);
                this.genExpr(arrObj2);
                this.asm.movRR64(1, 0);
                this.asm.popR64(0);
                string ownerType2 = this.inferExprType(arrObj2);
                int fieldOff5 = this.findFieldOffset(ownerType2, arrNode.name);
                if (fieldOff5 < 0) {
                    fieldOff5 = this.findFieldOffsetInAllClasses(arrNode.name);
                }
                if (fieldOff5 >= 0) {
                    this.asm.movMBaseR(1, 0, fieldOff5);
                }
            }
        }
        this.asm.bindLabel(doneGrow);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(1, 0, -8);
        this.asm.shlR64Imm(1, 3);
        this.asm.addRR64(0, 1);
        this.asm.movRMBase(8, 5, valOff);
        this.asm.movMBaseR(0, 8, 0);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(1, 0, -8);
        this.asm.addRI32(1, 1);
        this.asm.movMBaseR(0, 1, -8);
        // Persist the (possibly reallocated) array pointer back into the
        // member field slot so later field reads see the appended element.
        if (arrNode.kind == 13) {
            Node arrObj3 = arrNode.child(0);
            if (arrObj3.kind == 6 && arrObj3.name == "this") {
                int thisOff4 = this.findLocal("this");
                int fieldOff6 = this.findFieldOffset(this.currentClassName, arrNode.name);
                if (fieldOff6 >= 0 && thisOff4 != 0) {
                    this.asm.movRMBase(1, 5, thisOff4);
                    this.asm.movRMBase(0, 5, arrOff);
                    this.asm.movMBaseR(1, 0, fieldOff6);
                }
            }
        }
    }

    public bool hasDynamicAsmArg(Node call) {
        // Calls on this.asm are compiler-time assembler operations.  Their
        // identifier operands (local offsets, label ids, and sentinels) are
        // values in MiniCg's compile-time environment, not values that the
        // generated compiler must pass through MiniAsm at runtime.
        //
        // Routing non-literal operands through genDynamicAsmCall emits a
        // runtime call to a MiniAsm method while compiling compiler_driver.sr;
        // that corrupts the stage-2 compiler before it can process cargs.
        return false;
    }

    public bool isUserSymbol(string name) {
        // A name declared anywhere in user source (parameter, local, global,
        // or class) shadows a same-named stdlib namespace. silveri passes its
        // Env object around as a parameter named `env`; without this guard,
        // `env.get(...)` would be misrouted to the environment-variable
        // builtin instead of the Env.get method.
        if (this.findLocal(name) != 0) { return true; }
        if (this.findGlobal(name) >= 0) { return true; }
        for (int i = 0; i < this.classNames.length; i++) {
            if (this.classNames[i] == name) { return true; }
        }
        return false;
    }

    public bool isBuiltinModuleReceiver(Node call) {
        // A member call is routed to a global builtin only when its receiver
        // is a stdlib namespace object (fs, file, folder, json, yaml, llmai,
        // Value).  Member calls on user objects (e.g. a Lexer with a
        // readString method) must dispatch to their own class methods, never
        // to the fs/printline builtins -- mirroring the Rust compiler's
        // MethodCall dispatch which only special-cases those receiver names.
        if (!call.isMember || call.childCount() < 1) { return false; }
        Node recv = call.child(0);
        if (recv.kind != 6) { return false; }
        if (this.isUserSymbol(recv.name)) { return false; }
        if (recv.name == "fs") { return true; }
        if (recv.name == "env") { return true; }
        if (recv.name == "file") { return true; }
        if (recv.name == "folder") { return true; }
        if (recv.name == "json") { return true; }
        if (recv.name == "yaml") { return true; }
        if (recv.name == "llmai" || recv.name == "LLMAI") { return true; }
        if (recv.name == "Value") { return true; }

        if (recv.name == "os") { return true; }
        if (recv.name == "url") { return true; }
        return false;
    }

    public void genCall(Node call) {
        string name = call.name;
        // DOCS/259: invoking a function-typed parameter — load the stored
        // function address from the parameter's stack slot and call through
        // it with the standard 16-byte-aligned call setup. Zero-arg calls
        // only; the parameter holds an address, not an invocable-with-args
        // target.
        if (!call.isMember && call.childCount() == 0 && this.isFnPtrParam(name)) {
            this.genFnPtrCall(name);
            return;
        }
        // DOCS/259 G2: invoking a fn-typed LOCAL (`void () cb; cb = ...; cb();`)
        // — same 8-byte address slot contract as fn-typed parameters.  The
        // local's declared type distinguishes it from an unknown bare call.
        if (!call.isMember && call.childCount() == 0 && this.getLocalType(name) == "void ()") {
            this.genFnPtrCall(name);
            return;
        }
        // Dotted-new: `new mod.Class(...)`
        // parses as a non-member call whose name carries the dotted class
        // path. It resolves through the module's flattened namespace and
        // then lowers exactly like bare `new FlattenedName(...)`; unknown
        // module or class is a compile error naming the full dotted form.
        if (!call.isMember && name.contains(".")) {
            string resolved = this.dottedNewClassName(name);
            if (resolved.length > 0) {
                call.name = resolved;
                name = resolved;
            } else {
                printline(call.line.toString() + ":" + call.col.toString() + ": Unknown type '" + call.name + "'");
                exit(1);
            }
        }
        int isClass = 0;
        for (int i = 0; i < this.classNames.length; i++) {
            if (this.classNames[i] == name) { isClass = 1; }
        }
        bool builtinName = (!call.isMember || this.isBuiltinModuleReceiver(call));
        // A receiver that names a user-declared symbol is never a stdlib
        // namespace (see isUserSymbol), so the module dispatch branches below
        // must skip it. Value is deliberately exempt: it is both a user class
        // and the magic tagged-union factory.
        bool recvIsUserSymbol = false;
        if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6) {
            recvIsUserSymbol = this.isUserSymbol(call.child(0).name);
        }
        if ((name == "__binaryMetadataStatus" || name == "__binaryMetadataStatusNative") && !call.isMember) {
            this.genBinaryMetadataStatus(call);
        } else if ((name == "__binaryMetadataField" || name == "__binaryMetadataFieldNative") && !call.isMember) {
            this.genBinaryMetadataField(call);
        } else if (name == "byte" && !call.isMember) {
            // Explicit checked conversion to the unsigned byte range.
            if (call.childCount() > 0) {
                this.genExpr(call.child(0));
                int byteInvalid = this.newLabel();
                int byteDone = this.newLabel();
                this.asm.cmpRI32(0, 0);
                this.asm.jlLabel(byteInvalid);
                this.asm.cmpRI32(0, 255);
                this.asm.jgLabel(byteInvalid);
                this.asm.jmpLabel(byteDone);
                this.asm.bindLabel(byteInvalid);
                this.emitThrowException("byte value out of range");
                this.asm.bindLabel(byteDone);
            } else {
                this.asm.xorRR64(0, 0);
            }
        } else if (builtinName && (name == "int" || name == "int64" || name == "int32") && !call.isMember) {
            // int(...) / int64(...) / int32(...) conversion: strings parse via
            // strtoll, floats truncate toward zero (cvttsd2si), ints pass
            // through.
            if (call.childCount() > 0) {
                Node arg = call.child(0);
                bool isStringArg = false;
                if (arg.kind == 2) { isStringArg = true; }
                else if (arg.kind == 6) {
                    string lt = this.getLocalType(arg.name);
                    if (lt == "string") { isStringArg = true; }
                }
                if (isStringArg) {
                    this.genExpr(arg);
                    int toStrOff = this.allocLocal("__int_conv_str");
                    this.asm.movMBaseR(5, 0, toStrOff);
                    int toEndOff = this.allocLocal("__int_conv_end");
                    this.asm.movRR64(1, 0);
                    this.asm.leaRBase(2, 5, toEndOff);
                    this.asm.movRI64(8, 10);
                    this.addImportPatch("ucrtbase.dll", "strtoll");
                    int sConv = 0xDEADBEEFCAFEBAD3;
                    this.asm.emitImm64(0, sConv);
                    this.asm.movRMBase(0, 0, 0);
                    this.asm.emitCallSetup(0);
                    this.asm.callR64(0);
                    this.asm.emitCallTeardown();
                    int toOk = this.newLabel();
                    this.asm.movRMBase(1, 5, toEndOff);
                    this.asm.movRMBase(2, 5, toStrOff);
                    this.asm.cmpRR64(1, 2);
                    this.asm.jneLabel(toOk);
                    this.emitThrowException("invalid number format");
                    this.asm.bindLabel(toOk);
                } else {
                    this.genExpr(arg);
                    if (this.isFloatLike(arg)) {
                        // Float operands truncate toward zero: movq xmm0, rax
                        // (66 REX.W 0F 6E C0, 64-bit -- the asm helper's 32-bit
                        // form would zero-extend only EAX) then cvttsd2si
                        // rax, xmm0 (F2 REX.W 0F 2C C0), matching silverc-rs
                        // gen_int_conversion.
                        this.asm.emitU8(0x66);
                        this.asm.emitU8(0x48);
                        this.asm.emitU8(0x0F);
                        this.asm.emitU8(0x6E);
                        this.asm.emitU8(0xC0);
                        this.asm.emitU8(0xF2);
                        this.asm.emitU8(0x48);
                        this.asm.emitU8(0x0F);
                        this.asm.emitU8(0x2C);
                        this.asm.emitU8(0xC0);
                    }
                }
            } else {
                this.asm.xorRR64(0, 0);
            }
        } else if (builtinName && (name == "double" || name == "float" || name == "float64") && !call.isMember) {
            // double(...) / float(...) / float64(...) conversion: integers widen
            // to an IEEE-754 double bit pattern via cvtsi2sd; float operands
            // pass through unchanged (mirrors silverc-rs gen_double_conversion).
            // The old pass-through stub left the raw integer in RAX, so every
            // float64(int) value was a denormal and no-arg float producers like
            // timeWinNow() collapsed to the same wrong value.
            if (call.childCount() > 0) {
                Node arg = call.child(0);
                this.genExpr(arg);
                if (!this.isFloatLike(arg)) {
                    // 64-bit cvtsi2sd xmm0, rax (see emitCvtsi2sdRax), then
                    // movq rax, xmm0 to bring the bits back to the GP result
                    // register -- mirrors silverc-rs gen_double_conversion.
                    this.emitCvtsi2sdRax();
                    this.asm.movqR64XMM(0, 0);
                }
            } else {
                this.asm.xorRR64(0, 0);
            }
        } else if (builtinName && name == "char" && !call.isMember) {
            // char(...) conversion: low byte of the argument.
            if (call.childCount() > 0) {
                this.genExpr(call.child(0));
                this.asm.andRImm(0, 0xFF);
            } else {
                this.asm.xorRR64(0, 0);
            }
        } else if (isClass == 1 && (call.isStatic || (!this.win32CallResolves(name) && !this.linuxCallResolves(name) && !this.macCallResolves(name)))) {
            // UNIFIED_CORE_LIBRARY.md §4 rule 6 -- a bare (non-new) call whose
            // name is both a class and an imported win32 export reaches the
            // DLL, mirroring silverc-rs (win32::resolve runs before the bare
            // class-name fallback; net.sr's `socket(2,1,0)` under
            // `class socket`). `new T(...)` nodes carry isStatic from the
            // parser and always construct.
            this.genNewCall(call);
        } else if (builtinName && name == "printline") {
            this.genPrintCall(call, 1);
        } else if (builtinName && name == "print") {
            this.genPrintCall(call, 0);
        } else if (builtinName && name == "eprintln") {
            // OVERHAUL.md CLI diagnostics: compiler error messages go to the
            // standard error stream, matching silverc-rs's eprintln!.
            this.genEprintCall(call, 1);
        } else if (builtinName && name == "eprint") {
            this.genEprintCall(call, 0);
        } else if (builtinName && name == "readString") {
            this.genReadStringCall(call);
        } else if (builtinName && name == "readFile") {
            this.genReadStringCall(call);
        } else if (builtinName && name == "input") {
            this.genInputCall(call);
        } else if (builtinName && name == "readLine") {
            this.genInputCall(call);
        } else if (builtinName && name == "writeBytes") {
            this.genWriteBytesCall(call);
        } else if (builtinName && name == "writeFile") {
            this.genWriteBytesCall(call);
        } else if (builtinName && name == "writeString") {
            this.genWriteBytesCall(call);
        } else if (builtinName && name == "strlen") {
            this.genStrlenCall(call);
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && !recvIsUserSymbol && call.child(0).name == "json" && name == "stringify") {
            // json.stringify(value): native JSON text lowering matching
            // silverc-rs stdlib/json.rs (string/int/float/bool/array).
            this.genJsonStringify(call);
        } else if (builtinName && name == "len") {
            this.genLenCall(call);
        } else if (builtinName && name == "exit") {
            this.genExitCall(call);
        } else if (builtinName && name == "cargs") {
            this.genCargsCall(call);
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && !recvIsUserSymbol && (call.child(0).name == "llmai" || call.child(0).name == "LLMAI") && call.name == "chat") {
            // Builtin LLM chat completion (DOCS/206): llmai.chat(url, headers, body)
            this.genLlmaiChatCall(call);
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && call.child(0).name == "mouse" && (call.name == "cursorX" || call.name == "getCursorX")) {
            // Win32 cursor X read. GetCursorPos(LPPOINT) needs a real Win32
            // pointer; the high-level caller can't supply one. We allocate a
            // 16-byte POINT struct on the stack, call GetCursorPos, and
            // sign-extend the X int32 into RAX.
            this.genCursorXCall();
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && call.child(0).name == "mouse" && (call.name == "cursorY" || call.name == "getCursorY")) {
            // Win32 cursor Y read. Same dance as cursorX but reads +4.
            this.genCursorYCall();
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && !recvIsUserSymbol && call.child(0).name == "env" && (call.name == "get" || call.name == "getenv" || call.name == "getEnv")) {
            // Environment variable lookup: env.get(name) / env.getenv(name)
            this.genGetEnvCall(call);
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && !recvIsUserSymbol && (call.child(0).name == "fs" || call.child(0).name == "file" || call.child(0).name == "folder") && (call.name == "getExt" || call.name == "getExtension")) {
            this.genGetExtCall(call);
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && !recvIsUserSymbol && (call.child(0).name == "fs" || call.child(0).name == "file" || call.child(0).name == "folder") && (call.name == "getenv" || call.name == "getEnv")) {
            // fs.getenv(name) alias for environment variable lookup
            this.genGetEnvCall(call);
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && !recvIsUserSymbol && call.child(0).name == "url" && (call.name == "isUrl" || call.name == "isFtp" || call.name == "isFtps")) {
            this.genUrlCall(call);
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && !recvIsUserSymbol && (call.child(0).name == "fs" || call.child(0).name == "file" || call.child(0).name == "folder") && call.name == "exists") {
            this.genFileExistsCall(call);
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && !recvIsUserSymbol && (call.child(0).name == "fs" || call.child(0).name == "file") && call.name == "delete") {
            this.genFileDeleteCall(call);
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && !recvIsUserSymbol && call.child(0).name == "folder" && call.name == "delete") {
            this.genFolderDeleteCall(call);
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && !recvIsUserSymbol && (call.child(0).name == "fs" || call.child(0).name == "file" || call.child(0).name == "folder") && call.name == "copy") {
            this.genFileCopyCall(call);
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && !recvIsUserSymbol && (call.child(0).name == "fs" || call.child(0).name == "file") && (call.name == "rename" || call.name == "move")) {
            this.genFileRenameCall(call);
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && !recvIsUserSymbol && (call.child(0).name == "fs" || call.child(0).name == "file") && call.name == "getSize") {
            this.genFileSizeCall(call);
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && !recvIsUserSymbol && call.child(0).name == "folder" && call.name == "getSize") {
            this.genFolderSizeCall(call);
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && !recvIsUserSymbol && (call.child(0).name == "fs" || call.child(0).name == "file" || call.child(0).name == "folder") && call.name == "isDir") {

            this.genIsDirCall(call);
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && !recvIsUserSymbol && (call.child(0).name == "fs" || call.child(0).name == "file" || call.child(0).name == "folder") && call.name == "isFile") {
            this.genIsFileCall(call);
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && !recvIsUserSymbol && (call.child(0).name == "fs" || call.child(0).name == "file" || call.child(0).name == "folder") && call.name == "isDriveRoot") {
            this.genIsDriveRootCall(call);
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && !recvIsUserSymbol && (call.child(0).name == "fs" || call.child(0).name == "folder") && (call.name == "getEntries" || call.name == "entries" || call.name == "list" || call.name == "getFiles" || call.name == "files" || call.name == "getFolders" || call.name == "folders")) {
            int entFilter = 0;
            if (call.name == "getFiles" || call.name == "files") { entFilter = 1; }
            else if (call.name == "getFolders" || call.name == "folders") { entFilter = 2; }
            this.genFolderEntriesCall(call, entFilter);
        } else if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && call.child(0).name == "Value") {
            // Static factory on the builtin Value tagged union (e.g. Value.makeInt).
            this.genValueFactoryCall(call);
        } else if (call.isMember && call.childCount() > 1 && call.name == "contains" && this.isDictType(this.inferReceiverType(call.child(0)))) {
            this.genDictContains(call);
        } else if (call.isMember && call.childCount() > 0 && call.name == "count" && this.isDictType(this.inferReceiverType(call.child(0)))) {
            this.genDictCount(call);
        } else if (call.isMember && call.childCount() > 0 && call.name == "remove" && this.isDictType(this.inferReceiverType(call.child(0)))) {
            this.genDictRemove(call);
        } else if (call.isMember && call.childCount() > 0 && call.name == "keys" && this.isDictType(this.inferReceiverType(call.child(0)))) {
            this.genDictKeys(call);
        } else if (call.isMember && call.childCount() > 0 && call.name == "values" && this.isDictType(this.inferReceiverType(call.child(0)))) {
            this.genDictValues(call);
        } else if (call.isMember && this.isThisAsmMember(call)) {
            // MiniAsm is a runtime object owned by MiniCg. Every this.asm
            // operation must remain a receiver-aware method call in the
            // self-hosted compiler; lowering it as raw bytes here would place
            // assembler output in the generated compiler's function body.
            this.genMemberCall(call);
        } else if (call.isMember && this.isBuiltinMemberCall(call)) {
            this.genBuiltinMemberCall(call);
        } else if (call.isMember && !this.isThisAsmMember(call) && this.isUserClassMemberCall(call)) {
            this.genMemberCall(call);
        } else if (name == "pushR64" || name == "popR64" || name == "movRR64" || name == "movRI64" || name == "movRMBase" || name == "movMBaseR" || name == "subRI32" || name == "addRI32" || name == "xorRR64" || name == "cmpRI32" || name == "cmpRR64" || name == "ret" || name == "callR64" || name == "leaRBase" || name == "emitU8" || name == "emitU32" || name == "emitImm64" || name == "emitCallSetup" || name == "emitCallTeardown" || name == "addRR64" || name == "subRR64" || name == "mulRR64" || name == "andRImm" || name == "shlR64Imm" || name == "incR64" || name == "decR64" || name == "movByteMBaseIdxR" || name == "movMBaseByteR" || name == "label" || name == "bindLabel" || name == "jeLabel" || name == "jneLabel" || name == "jmpLabel" || name == "jlLabel" || name == "jleLabel" || name == "jgLabel" || name == "jgeLabel" || name == "movzxByteMBase" || name == "callRel32") {
            this.genAsmCall(call);        } else if (call.isMember && call.childCount() > 1 && call.child(1).kind == 80 && this.isHofMethod(name) && this.isArrayLikeType(this.inferExprType(call.child(0)))) {
            if (name == "map" || name == "forEach") { this.genLambdaMap(call); }
            else if (name == "filter") { this.genLambdaFilter(call); }
            else if (name == "reduce") { this.genLambdaReduce(call); }
            else if (name == "find") { this.genLambdaFind(call); }
            else if (name == "all" || name == "every") { this.genLambdaQuantifier(call, 1); }
            else { this.genLambdaQuantifier(call, 0); }
        } else if (call.isMember && call.childCount() > 0 && (name == "any" || name == "all" || name == "reverse" || name == "map") && this.inferExprType(call.child(0)).length >= 2 && this.inferExprType(call.child(0))[this.inferExprType(call.child(0)).length - 2] == '[') {
            if (name == "any") { this.genArrayAny(call); }
            else if (name == "all") { this.genArrayAll(call); }
            else if (name == "reverse") { this.genArrayReverse(call); }
            else { this.genArrayMap(call); }
        } else if (call.isMember && call.childCount() > 0 && name == "last" && this.inferExprType(call.child(0)).length >= 2 && this.inferExprType(call.child(0))[this.inferExprType(call.child(0)).length - 2] == '[') {
            this.genArrayLast(call);
        } else if (call.isMember && call.childCount() > 0 && (name == "pop" || name == "outlast") && this.inferExprType(call.child(0)).length >= 2 && this.inferExprType(call.child(0))[this.inferExprType(call.child(0)).length - 2] == '[') {
            this.genArrayPop(call);
        } else if (call.isMember && call.childCount() > 1 && (name == "indexOf" || name == "find") && this.inferExprType(call.child(0)).length >= 2 && this.inferExprType(call.child(0))[this.inferExprType(call.child(0)).length - 2] == '[') {
            this.genArrayIndexOf(call);
        } else if (call.isMember && call.childCount() > 0 && name == "sort" && this.inferExprType(call.child(0)).length >= 2 && this.inferExprType(call.child(0))[this.inferExprType(call.child(0)).length - 2] == '[') {
            this.genArraySort(call);
        } else if (call.isMember && call.childCount() > 0 && name == "unique" && this.inferExprType(call.child(0)).length >= 2 && this.inferExprType(call.child(0))[this.inferExprType(call.child(0)).length - 2] == '[') {
            this.genArrayUnique(call);
        } else if (call.isMember && call.childCount() > 1 && name == "join" && this.inferExprType(call.child(0)).length >= 2 && this.inferExprType(call.child(0))[this.inferExprType(call.child(0)).length - 2] == '[') {
            this.genArrayJoin(call);
        } else if (call.isMember && call.childCount() > 2 && name == "join" && call.child(0).kind == 6 && call.child(0).name == "string") {
            // Static string form `string.join(sep, parts)` (DOCS/88): reorder
            // the args into (array, sep) and reuse the member-join emitter.
            Node joinCall = new Node();
            joinCall.kind = call.kind;
            joinCall.name = call.name;
            joinCall.children.add(call.child(2));
            joinCall.children.add(call.child(1));
            this.genArrayJoin(joinCall);
} else if ((call.isMember && name == "add" && call.childCount() > 0) || (call.isMember && name == "push" && call.childCount() > 0) || (call.isMember && name == "append" && call.childCount() > 0)) {
              string addRecvType = this.inferExprType(call.child(0));
              if (addRecvType.length >= 2 && addRecvType[addRecvType.length - 2] == '[' && addRecvType[addRecvType.length - 1] == ']') {
                 this.genArrayAdd(call);
             } else if (this.isUserClassMemberCall(call)) {
                 this.genMemberCall(call);
             } else {
                 this.genUserCall(call);
             }
        } else if (name == "super") {
            // super(...) - parent constructor call
            this.genSuperCall(call);
        } else {
            this.genUserCall(call);
        }
    }

    public void genDictIndexGet(Node idx) {
        // dict = array [cap, len, k1, v1, k2, v2, ...], data ptr at base+16.
        // Linear search over i < len; returns the value whose key equals
        // the searched key, or 0 when absent.
        Node dictNode = idx.child(0);
        Node keyNode = idx.child(1);
        this.genExpr(dictNode);
        int dBase = this.allocLocal("__dg_base");
        this.asm.movMBaseR(5, 0, dBase);
        this.genExpr(keyNode);
        int dKey = this.allocLocal("__dg_key");
        this.asm.movMBaseR(5, 0, dKey);
        int dI = this.allocLocal("__dg_i");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, dI);
        int lL = this.newLabel();
        int fL = this.newLabel();
        int nL = this.newLabel();
        int eL = this.newLabel();
        int iter = this.newLabel();
        this.asm.bindLabel(lL);
        this.asm.movRMBase(0, 5, dI);
        this.asm.movRMBase(1, 5, dBase);
        this.asm.movRMBase(1, 1, -8);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(nL);
        this.asm.movRMBase(0, 5, dI);
        this.asm.shlR64Imm(0, 1);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(11, 0);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.addRR64(0, 11);
        this.asm.movRMBase(1, 0, 0);
        this.asm.cmpRI32(1, 0);
        this.asm.jeLabel(iter);
        this.asm.movRR64(1, 1);
        this.asm.movRMBase(2, 5, dKey);
        this.addImportPatch("ucrtbase.dll", "strcmp");
        int sCmp = 0xDEADBEEFCAFEBADF;
        this.asm.emitImm64(0, sCmp);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(fL);
        this.asm.bindLabel(iter);
        this.asm.movRMBase(0, 5, dI);

        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, dI);
        this.asm.jmpLabel(lL);
        this.asm.bindLabel(fL);
        this.asm.movRMBase(0, 5, dI);
        this.asm.shlR64Imm(0, 1);
        this.asm.addRI32(0, 1);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(11, 0);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.addRR64(0, 11);
        this.asm.movRMBase(0, 0, 0);
        this.asm.jmpLabel(eL);
        this.asm.bindLabel(nL);
        this.asm.xorRR64(0, 0);
        this.asm.bindLabel(eL);
    }

    public void genDictCount(Node call) {
        // Dict layout: [capacity, length, key/value slots...]. The data
        // pointer returned by the literal is allocation base + 16, so the
        // length lives at [data - 8].
        this.genExpr(call.child(0));
        this.asm.movRMBase(0, 0, -8);
    }

    public void genDictRemove(Node call) {
        // Remove the first slot whose key matches, shifting later slots left
        // by one entry (16 bytes) and decrementing the length.
        Node dictNode = call.child(0);
        Node keyNode = call.child(1);
        this.genExpr(dictNode);
        int dBase = this.allocLocal("__dr_base");
        this.asm.movMBaseR(5, 0, dBase);
        this.genExpr(keyNode);
        int dKey = this.allocLocal("__dr_key");
        this.asm.movMBaseR(5, 0, dKey);
        int dI = this.allocLocal("__dr_i");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, dI);
        int lL = this.newLabel();
        int fL = this.newLabel();
        int eL = this.newLabel();
        int iter = this.newLabel();
        this.asm.bindLabel(lL);
        this.asm.movRMBase(0, 5, dI);
        this.asm.movRMBase(1, 5, dBase);
        this.asm.movRMBase(1, 1, -8);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(eL);
        this.asm.movRMBase(0, 5, dI);
        this.asm.shlR64Imm(0, 1);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(11, 0);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.addRR64(0, 11);
        this.asm.movRMBase(1, 0, 0);
        this.asm.cmpRI32(1, 0);
        this.asm.jeLabel(iter);
        this.asm.movRR64(1, 1);
        this.asm.movRMBase(2, 5, dKey);
        this.addImportPatch("ucrtbase.dll", "strcmp");
        int sCmpDr = 0xDEADBEEFCAFEBADE;
        this.asm.emitImm64(0, sCmpDr);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(fL);
        this.asm.bindLabel(iter);
        this.asm.movRMBase(0, 5, dI);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, dI);
        this.asm.jmpLabel(lL);
        // Found: shift slots [i+1 .. len) left by one 16-byte entry.
        this.asm.bindLabel(fL);
        int shift = this.newLabel();
        int shiftDone = this.newLabel();
        this.asm.bindLabel(shift);
        this.asm.movRMBase(0, 5, dI);
        this.asm.addRI32(0, 1);
        this.asm.movRMBase(1, 5, dBase);
        this.asm.movRMBase(1, 1, -8);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(shiftDone);
        // dst slot = dBase + i*16
        this.asm.movRMBase(0, 5, dI);
        this.asm.shlR64Imm(0, 1);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(11, 0);
        this.asm.movRMBase(1, 5, dBase);
        this.asm.addRR64(1, 11);
        // src slot = dBase + (i+1)*16
        this.asm.movRMBase(0, 5, dI);
        this.asm.addRI32(0, 1);
        this.asm.shlR64Imm(0, 1);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(12, 0);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.addRR64(0, 12);
        // key: [dst+0] = [src+0]; value: [dst+8] = [src+8]
        this.asm.movRMBase(2, 0, 0);
        this.asm.movMBaseR(1, 2, 0);
        this.asm.movRMBase(2, 0, 8);
        this.asm.movMBaseR(1, 2, 8);
        this.asm.movRMBase(0, 5, dI);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, dI);
        this.asm.jmpLabel(shift);
        this.asm.bindLabel(shiftDone);
        // length--
        this.asm.movRMBase(0, 5, dBase);
        this.asm.movRMBase(1, 0, -8);
        this.asm.subRI32(1, 1);
        this.asm.movMBaseR(0, 1, -8);
        this.asm.movRI64(0, 1);
        this.asm.bindLabel(eL);
    }

    public void genDictKeys(Node call) {
        // Allocate a string array holding every key, in insertion order.
        Node dictNode = call.child(0);
        this.genExpr(dictNode);
        int dBase = this.allocLocal("__dk_base");
        this.asm.movMBaseR(5, 0, dBase);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.movRMBase(0, 0, -8);
