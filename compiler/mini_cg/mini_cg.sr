        int pathIdx = 1;
        if (call.childCount() <= pathIdx) { this.asm.xorRR64(0, 0); return; }
        this.genExpr(call.child(pathIdx));
        this.asm.emitCallSetup(0);
        this.asm.movRR64(1, 0);
        this.addImportPatch("kernel32.dll", "DeleteFileA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }

    // LINUX SysV backend (additive): unlink(path) via libc, mirroring
