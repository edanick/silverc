// ============================================================================
// SHARED CORE - MiniCg native code generator (the .text emitter).
// ============================================================================
// Three-file layout (compiler/mini_cg/):
//   mini_cg.sr (this file) - shared core: `class MiniCg` props + construct,
//     shared emitters, and one-line delegation wrappers for every backend
//     helper. All existing call sites stay untouched: they keep calling
//     `this.<name>(...)` on MiniCg and the wrapper forwards to the backend.
//   linux.sr - `class MiniCgLinux`: SysV-only helpers (46 methods: grant
//     tables, ELF addressing, SysV ABI tails, genLinux* file/os/input/print
//     tails). UNGATED so the helpers exist on both targets; they are simply
//     never CALLED on Windows.
//   windows.sr - `class MiniCgWindows`: Win64-only helpers (18 methods: win32
//     grant tables plus ExitProcess/cursor/version emitters). UNGATED for the
//     same reason; never CALLED on Linux.
//   mac.sr - `class MiniCgMac`: AAPCS64-only helpers (28 methods: AAPCS64
//     policy + Mach-O addressing, mac grant tables, libSystem remaps).
//     UNGATED for the same reason; never CALLED on Win64/SysV paths.
//
// Delegation shape: helpers that touch core state take `MiniCg cg` as their
// first parameter and read/write it as `cg.*` (calls to staying core methods
// likewise go through `cg.`); calls to same-backend helpers stay `this.`
// (with `cg` forwarded when the callee needs it); pure helpers (string
// tables, address arithmetic) take no `cg` and compare with the unified
// `==`. There is deliberately NO duplicate `class MiniCg` in
// the backends: the type checker overwrites same-name classes, which would
// corrupt field offsets - helpers + delegation instead.
//
// What STAYS in this core file untouched:
//   * every SHARED / SHARED_WITH_ON method;
//   * all same-name #on twins, kept paired and region-gated (emitRtStateAddr,
//     emitRuntimeFunctions, emitRuntimeEntryStub, appendRuntimeData,
//     patchRuntimeRefs, genBinaryMetadataStatus, genBinaryMetadataField);
//   * the 17 B3 remap-shared emitters whose msvcrt/ucrtbase DLLs remap inside
//     addImportPatch (genStmt, genByteArrayLiteral, genStructLiteral, genExpr,
//     genMatchPattern, genMemberAccess, genSlice, genArrayAll, genArrayReverse,
//     genArrayMap, genLambdaMap, genLambdaFilter, genArrayIndexOf,
//     genArraySort, genArrayUnique, genArrayJoin, genArrayAdd);
//   * the trailing PeImport / PeDllGroup helper classes.
// ============================================================================

class StrEntry {
    public prop string text;
    public prop int dataOffset;

    construct (string text) {
        this.text = text;
        this.dataOffset = 0;
    }
}

class MiniCg {
    public prop MiniAsm asm;
    public prop StrEntry[] strings;
    public prop int[] stringData;
    public prop int mainLabelOffset;
    public prop string[] funcNames;
    public prop string[] funcClasses;
    public prop string[] constNames;
    public prop int[] constValues;
    public prop string[] constStringValues;
    public prop int[] constIsString;
    public prop string[] funcRetTypes;
    public prop int[] funcOffsets;
    public prop int[] funcParamStarts;
    public prop int[] funcParamCounts;
    public prop int[] funcParamHasDefaults;
    public prop Node[] funcParamDefaults;
    public prop int[] funcHasVariadic;
    public prop string[] funcParamTypes;
    public prop int[] localOffsets;
    public prop string[] localNames;
    public prop int stackSize;
    public prop int[] stringPatchOffsets;
    public prop int[] stringPatchIndices;
    public prop int[] importPatchOffsets;
    public prop int[] importPatchDllIndices;
    public prop int[] importPatchFuncIndices;

    public prop string[] importDlls;
    public prop string[] importFuncs;
    // DOCS/213 -- win32 module grants. win32Dlls lists DLLs opened in full
    // via `import * from win32.<mod>;` / `import <mod> from win32;`.
    // win32Grants lists single exports as "dll|name" entries granted via
    // `import Name from win32.<mod>;`. When win32Error is set after
    // genProgram the compilation used a Win32 function whose module was not
    // imported and the driver must abort.
    public prop string[] win32Dlls;
    public prop string[] win32Grants;
    // Aliased single-export grants
    // (`import { X as Y } from win32.<mod>;`) as parallel arrays. A grant
    // answers to the LOCAL call name only; the PE import keeps the real
    // export. Aliased exports never enter win32Grants, so they cannot
    // widen access to the rest of the DLL.
    public prop string[] win32AliasLocals;
    public prop string[] win32AliasExports;
    public prop string[] win32AliasDlls;
    public prop bool win32Error;
    public prop string win32ErrorMessage;
    // LINUX SysV backend target (additive, LINUX.md Phase C): "" = unset,
    // which behaves as WINDOWS. The driver sets it once per compilation via
    // ppTargetOsFor(flags.targetOs), so --os WINDOWS emission is unchanged.
    public prop string targetOs;
    // LINUX.md Phase C -- linux module grants, mirroring the win32 trio
    // above. linuxLibs lists fully opened libs (libc.so.6, ...);
    // linuxGrants lists single exports as "lib|name"; the alias trio answers
    // to the LOCAL call name only (`import { X as Y } from linux.libc;`).
    public prop string[] linuxLibs;
    public prop string[] linuxGrants;
    public prop string[] linuxAliasLocals;
    public prop string[] linuxAliasExports;
    public prop string[] linuxAliasLibs;
    // MAC.md Phase C -- mac module grants, mirroring the linux trio above.
    // macLibs lists fully opened libs (/usr/lib/libSystem.B.dylib, ...);
    // macGrants lists single exports as "lib|name"; the alias trio answers
    // to the LOCAL call name only (`import { X as Y } from mac.libsystem;`).
    // UNGATED (like linux): helpers exist on all targets, never CALLED on
    // Win64/SysV paths, so --os windows/--os linux outputs stay byte-identical.
    public prop string[] macLibs;
    public prop string[] macGrants;
    public prop string[] macAliasLocals;
    public prop string[] macAliasExports;
    public prop string[] macAliasLibs;
    // DOCS/261 -- per-project custom native modules (`.srp` `nativeModules`).
    // Empty when the manifest declares none (absent key = no change). Bare
    // names resolve per targetOs with no `#on` regions; fixed tables above
    // and their std-internal visibility are untouched; custom grants skip
    // the std-internal rule (manifest opt-in). Declared-but-unused emits no
    // import entries; only called functions do (lazy).
    public prop NativeModules customNative;
    public prop int[] loopStartStack;
    public prop int[] loopEndStack;
    public prop int[] loopContinueStack;
    public prop int labelCounter;
    public prop int[] stringOffsets;
    // Retained for self-hosting object-layout compatibility.  Member-call
    // code uses scratchBaseOffset directly, but preserving this field and its
    // reserved entries keeps MiniCg's generated layout stable across stages.
    public prop int[] funcCallArgTemps;
    public prop int scratchBaseOffset;
    public prop int funcCallArgCount;
    public prop int retValOff;
    public prop string[] classNames;
    public prop string[] classParentClasses;
    public prop string[] enumNames;
    public prop int[] classFieldStarts;
    public prop int[] classFieldCounts;
    public prop string[] classFieldNames;
    public prop int[] classFieldOffsets;
    public prop string[] classFieldTypes;
    public prop string[] methodClassNames;
    public prop string[] methodNames;
    public prop string currentClassName;
    public prop string currentFunctionName;
    public prop bool dynamicAsmActive;
    public prop string[] localTypes;
    public prop int[] forwardCalls;
    public prop string[] forwardCallNames;
    public prop string[] forwardCallClasses;
    public prop int currentReturnLabel;
    public prop int currentExcHandler;
    public prop int currentCatch;
    public prop int currentFinally;
    public prop int currentFinallyRetVal;
    public prop int currentFinallyRetFlag;
    public prop bool currentIsMain;
    public prop bool hasMain;
    public prop string[] globalNames;
    public prop string[] globalTypes;
    public prop int[] globalOffsets;
    public prop Node[] globalInits;
    public prop int[] globalPatchOffsets;
    public prop int[] globalPatchIndices;
    public prop int globalAreaSize;
    public prop int entryOffset;
    public prop int[] liveSlots;
    public prop bool[] liveSlotIsArray;
    public prop int qcTempCounter;
    // OVERHAUL.md threading module: effective worker count for this
    // compilation (total - 2 by default or the explicit --threads N).
    public prop int threadCount;
    // OVERHAUL.md --runtime: embed the Silver runtime (allocator + GC
    // scaffolding) into the emitted program and route HeapAlloc calls
    // through the embedded bump allocator.
    public prop bool runtimeMode;
    public prop int rtInitOffset;
    public prop int rtAllocOffset;
    public prop int rtGcOffset;
    public prop int runtimeEntryOffset;
    public prop int[] rtStatePatchOffsets;
    public prop int[] heapAllocPatchPos;
    public prop int rtStateDataOff;
    public prop int rtPtrSlotDataOff;
    // Reference parameters (DOCS/34, `&arg` call sites). refCalleeNames/
    // refCalleeParams record (callee name, param index) for every call that
    // passes a `&arg`; refParams holds the current function's ref-bound param
    // names so reads dereference and writes store through the caller's slot.
    public prop string[] refCalleeNames;
    public prop int[] refCalleeParams;
    public prop string[] refParams;

    // DOCS/259 -- anonymous function arguments `(void () { ... })`. Each
    // expression occurrence queues a standalone generated function (name,
    // label, body block) that is emitted after all program functions; the
    // expression itself evaluates to the generated function's address via an
    // absolute-VA placeholder patched at layout time. Bodies may queue
    // further anonymous functions, so the queue drains until empty.
    public prop int anonCounter;
    public prop bool inAnonBody;
    public prop string[] pendingAnonNames;
    public prop int[] pendingAnonLabels;
    public prop Node[] pendingAnonBodies;
    // (label id, imm64 patch position) pairs for `mov rax, <anon address>`
    // placeholders, patched to IMAGE_BASE + text_rva + label position.
    public prop int[] anonRelocLabelIds;
    public prop int[] anonRelocPatchOffsets;
    // Function-typed parameters (`void () name`) of the function currently
    // being emitted; invoking one emits an indirect call through the
    // parameter slot's stored address.
    public prop string[] fnPtrParamNames;

    // Overload dispatch by argument count: resolved function index of every forward call so same-named overload
    // entries patch to their own body instead of the last declaration's.
    public prop int[] forwardCallFuncIdxs;

    // Source-module names seen in
    // `import * from X;` / `import { n } from X;` statements. Dotted-new
    // (`new mod.Class(...)`) resolves through these.
    public prop string[] userModuleNames;

    // Optional codegen progress reporter: when non-null the driver calls
    // codegenTick after each function body is generated so long compiles
    // show movement.
    public prop ProgressReporter progress;
    public prop MiniCgLinux linuxBackend;
    public prop MiniCgWindows windowsBackend;
    public prop MiniCgMac macBackend;

    construct (MiniAsm asm) {
        this.asm = asm;
        this.strings = [];
        this.stringData = [];
        this.mainLabelOffset = 0;
        this.funcNames = [];
        this.funcClasses = [];
        this.constNames = [];
        this.constValues = [];
        this.constStringValues = [];
        this.constIsString = [];
        this.funcRetTypes = [];
        this.funcOffsets = [];
        this.funcParamStarts = [];
        this.funcParamCounts = [];
        this.funcParamHasDefaults = [];
        this.funcParamDefaults = [];
        this.funcHasVariadic = [];
        this.funcParamTypes = [];
        this.localOffsets = [];
        this.localNames = [];
        this.stackSize = 0;
        this.stringPatchOffsets = [];
        this.stringPatchIndices = [];
        this.importPatchOffsets = [];
        this.importPatchDllIndices = [];
        this.importPatchFuncIndices = [];
        this.importDlls = [];
        this.importFuncs = [];
        this.win32Dlls = [];
        this.win32Grants = [];
        this.win32AliasLocals = [];
        this.win32AliasExports = [];
        this.win32AliasDlls = [];
        this.win32Error = false;
        this.win32ErrorMessage = "";
        this.targetOs = "";
        this.linuxLibs = [];
        this.linuxGrants = [];
        this.linuxAliasLocals = [];
        this.linuxAliasExports = [];
        this.linuxAliasLibs = [];
        this.macLibs = [];
        this.macGrants = [];
        this.macAliasLocals = [];
        this.macAliasExports = [];
        this.macAliasLibs = [];
        this.customNative = new NativeModules();
        this.loopStartStack = [];
        this.loopEndStack = [];
        this.loopContinueStack = [];
        this.labelCounter = 0;
        this.stringOffsets = [];
        this.funcCallArgTemps = [];
        this.funcCallArgCount = 0;
        this.retValOff = 0;
        this.classNames = [];
        this.classParentClasses = [];
        this.enumNames = [];
        this.classFieldStarts = [];
        this.classFieldCounts = [];
        this.classFieldNames = [];
        this.classFieldOffsets = [];
        this.classFieldTypes = [];
        this.methodClassNames = [];
        this.methodNames = [];
        this.currentClassName = "";
        this.currentFunctionName = "";
        this.dynamicAsmActive = false;
        this.hasMain = false;
        this.localTypes = [];
        this.forwardCalls = [];

        this.forwardCallNames = [];
        this.forwardCallClasses = [];
        this.forwardCallFuncIdxs = [];
        this.globalNames = [];
        this.globalTypes = [];
        this.globalOffsets = [];
        this.globalInits = [];
        this.globalPatchOffsets = [];
        this.globalPatchIndices = [];
        this.globalAreaSize = 0;
        this.entryOffset = 0;
        this.liveSlots = [];
        this.liveSlotIsArray = [];
        this.qcTempCounter = 0;
        this.currentExcHandler = -1;
        this.currentCatch = -1;
        this.currentFinally = -1;
        this.currentFinallyRetVal = 0;
        this.currentFinallyRetFlag = 0;
        this.threadCount = 1;
        this.runtimeMode = false;
        this.rtInitOffset = -1;
        this.rtAllocOffset = -1;
        this.rtGcOffset = -1;
        this.runtimeEntryOffset = -1;
        this.rtStatePatchOffsets = [];
        this.heapAllocPatchPos = [];
        this.rtStateDataOff = 0;
        this.rtPtrSlotDataOff = 0;
        this.refCalleeNames = [];
        this.refCalleeParams = [];
        this.refParams = [];
        this.progress = null;
        this.anonCounter = 0;
        this.inAnonBody = false;
        this.pendingAnonNames = [];
        this.pendingAnonLabels = [];
        this.pendingAnonBodies = [];
        this.anonRelocLabelIds = [];
        this.anonRelocPatchOffsets = [];
        this.fnPtrParamNames = [];
        this.userModuleNames = [];
        this.linuxBackend = new MiniCgLinux();
        this.windowsBackend = new MiniCgWindows();
        this.macBackend = new MiniCgMac();
    }

    public void collectClassLayouts(Node[] program) {
        // First pass: collect all class and struct names so parent references
        // work. Structs (kind 101) share the same layout tables as classes:
        // their fields are parsed as identifier-less kind-0 nodes, so the
        // field-collection pass below reads typeHint/name directly.
        for (int i = 0; i < program.length; i++) {
            Node item = program[i];
            if (item.kind == 102 || item.kind == 101) {
                this.classNames.add(item.name);
                this.classParentClasses.add(item.parentClass);
                this.classFieldStarts.add(0);
                this.classFieldCounts.add(0);
            }
        }
        // Second pass: collect fields and methods with inheritance. Structs
        // (kind 101) have no inheritance and no methods; only their fields.
        int classIdx = 0;
        for (int i = 0; i < program.length; i++) {
            Node item = program[i];
            if (item.kind == 102) {
                int start = this.classFieldNames.length;
                int cnt = 0;
                if (item.parentClass != "") {
                    int parentIdx = -1;
                    for (int pi = 0; pi < this.classNames.length; pi++) {
                        if (this.classNames[pi] == item.parentClass) {
                            parentIdx = pi;
                        }
                    }
                    if (parentIdx >= 0) {
                        int pStart = this.classFieldStarts[parentIdx];
                        int pCnt = this.classFieldCounts[parentIdx];
                        for (int pj = 0; pj < pCnt; pj++) {
                            this.classFieldNames.add(this.classFieldNames[pStart + pj]);
                            this.classFieldOffsets.add(cnt * 8);
                            this.classFieldTypes.add(this.classFieldTypes[pStart + pj]);
                            cnt++;
                        }
                    }
                }
                for (int j = 0; j < item.childCount(); j++) {
                    Node member = item.child(j);
                    if (member.kind == 50) {
                        this.classFieldNames.add(member.name);
                        this.classFieldOffsets.add(cnt * 8);
                        this.classFieldTypes.add(member.typeHint);
                        cnt++;
                    }
                }
                this.classFieldStarts[classIdx] = start;
                this.classFieldCounts[classIdx] = cnt;
                for (int j = 0; j < item.childCount(); j++) {
                    Node member = item.child(j);
                    if (member.kind == 100) {
                        this.methodNames.add(member.name);
                        this.methodClassNames.add(item.name);
                    }
                }
                if (item.parentClass != "") {
                    int parentIdx = -1;
                    for (int pi = 0; pi < this.classNames.length; pi++) {
                        if (this.classNames[pi] == item.parentClass) {
                            parentIdx = pi;
                        }
                    }
                    if (parentIdx >= 0) {
                        int savedLen = this.methodNames.length;
                        for (int mi = 0; mi < savedLen; mi++) {
                            if (this.methodClassNames[mi] == item.parentClass && this.methodClassNames[mi] != "") {
                                bool hasOverride = false;
                                for (int mj = 0; mj < this.methodNames.length; mj++) {
                                    if (this.methodClassNames[mj] == item.name && this.methodNames[mj] == this.methodNames[mi]) {
                                        hasOverride = true;
                                    }
                                }
                if (!hasOverride) {
                    this.methodNames.add(this.methodNames[mi]);
                    this.methodClassNames.add(item.name);
                }
                            }
                        }
                    }
                }
                classIdx++;
            } else if (item.kind == 101) {
                // Struct layout: fields only, no inheritance or methods.
                int start = this.classFieldNames.length;
                int cnt = 0;
                for (int j = 0; j < item.childCount(); j++) {
                    Node member = item.child(j);
                    this.classFieldNames.add(member.name);
                    this.classFieldOffsets.add(cnt * 8);
                    this.classFieldTypes.add(member.typeHint);
                    cnt++;
                }
                this.classFieldStarts[classIdx] = start;
                this.classFieldCounts[classIdx] = cnt;
                classIdx++;
            }
        }
    }

    public bool isDictType(string t) {
        if (t.length >= 4) {
            if (t[0] == 'd' && t[1] == 'i' && t[2] == 'c' && t[3] == 't') { return true; }
        }
        return false;
    }

    public string dictValueType(string t) {
        int len = t.length;
        int i = 5;
        int depth = 1;
        bool inVal = false;
        string result = "";
        while (i < len) {
            if (t[i] == '<') { depth++; }
            else if (t[i] == '>') {
                depth--;
                if (depth == 0) { return result; }
            } else if (t[i] == ',' && depth == 1) {
                inVal = true;
            } else if (inVal) {
                result += t[i];
            }
            i++;
        }
        return result;
    }

    public string inferReceiverType(Node expr) {
        if (expr.kind == 6) {
            if (expr.name == "this") { return this.currentClassName; }
            return this.getLocalType(expr.name);
        }
        return this.inferExprType(expr);
    }

    public bool isClassName(string t) {
        if (t == "") { return false; }
        for (int i = 0; i < this.classNames.length; i++) {
            if (this.classNames[i] == t) { return true; }
        }
        return false;
    }

    // True when `name` starts with `<module>.` for a known user module.
    // The module part compares
    // case-insensitively, mirroring the Rust compiler's has_user_module
    // (import site and call site may differ in casing).
    public bool isUserModulePrefix(string name) {
        for (int i = 0; i < this.userModuleNames.length; i++) {
            string m = this.userModuleNames[i];
            if (name.length <= m.length) { continue; }
            if (name[m.length] != '.') { continue; }
            if (string.equals(projectSlice(name, 0, m.length), m, StringCase.INSENSITIVE)) { return true; }
        }
        return false;
    }

    // Dotted-new resolution: project modules are flattened into one
    // namespace, so `new mod.Class(args)` denotes the class `Class`
    // exported by module `mod`. Any chain depth resolves through its last
    // segment: the module part is the longest known module prefix, the
    // class is the rest. Returns "" for bare names and unknown dotted
    // names (bare paths are completely unchanged).
    public string dottedNewClassName(string name) {
        if (!this.isUserModulePrefix(name)) { return ""; }
        string[] segs = [];
        string cur = "";
        for (int i = 0; i < name.length; i++) {
            if (name[i] == '.') { segs.add(cur); cur = ""; }
            else { cur += name[i]; }
        }
        segs.add(cur);
        if (segs.length < 2) { return ""; }
        for (int k = segs.length - 1; k >= 1; k--) {
            string module = "";
            for (int a = 0; a < k; a++) {
                if (a > 0) { module += "."; }
                module += segs[a];
            }
            string cls = "";
            for (int b = k; b < segs.length; b++) {
                if (b > k) { cls += "."; }
                cls += segs[b];
            }
            if (this.hasUserModuleName(module) && this.isClassName(cls)) {
                return cls;
            }
        }
        return "";
    }

    public bool hasUserModuleName(string name) {
        for (int i = 0; i < this.userModuleNames.length; i++) {
            if (string.equals(this.userModuleNames[i], name, StringCase.INSENSITIVE)) { return true; }
        }
        return false;
    }

    // Built-in stdlib module names never carry user Silver classes, so they
    // are not user modules (mirrors the Rust compiler's STDLIB_MODULES
    // exclusion in user-module registration).
    private bool isStdlibModuleName(string name) {
        string[] stdlibModules = ["math", "fs", "file", "folder", "json", "http", "llmai", "LLMAI", "env", "url", "hash", "path", "keyboard", "mouse", "bom", "binary_metadata", "process", "console", "gui", "registry", "os"];
        for (int i = 0; i < stdlibModules.length; i++) {
            if (stdlibModules[i] == name) { return true; }
        }
        return false;
    }

    // Mirror of rs find_class_for_expr: the class name an expression's value
    // belongs to, for Assign-time var->class registration. Resolves through
    // the local/global type table, the class field tables and inferExprType
    // (which already resolves `new C(...)` - a non-member call named after
    // the class - to C).
    public string findClassForExpr(Node expr) {
        if (expr.kind == 6) {
            if (expr.name == "this") {
                if (this.currentClassName != "") { return this.currentClassName; }
            }
            string t = this.getLocalType(expr.name);
            if (this.isClassName(t)) { return t; }
            if (this.isClassName(expr.name)) { return expr.name; }
            if (this.currentClassName != "") {
                string ft = this.findFieldType(this.currentClassName, expr.name);
                if (this.isClassName(ft)) { return ft; }
            }
            return "";
        }
        if (expr.kind == 13) {
            if (expr.childCount() > 0) {
                string ot = this.inferExprType(expr.child(0));
                if (ot != "") {
                    string ft = this.findFieldType(ot, expr.name);
                    if (this.isClassName(ft)) { return ft; }
                }
            }
            return "";
        }
        if (expr.kind == 24) {
            if (expr.childCount() > 0) {
                string et = this.arrayElementType(this.inferExprType(expr.child(0)));
                if (this.isClassName(et)) { return et; }
            }
            return "";
        }
        if (expr.kind == 10) {
            string t = this.inferExprType(expr);
            if (this.isClassName(t)) { return t; }
            if (!expr.isMember) {
                // Class-returning user function (mirrors rs FunctionCall arm
                // via func_return_structs).
                for (int ri = 0; ri < this.funcNames.length; ri++) {
                    if (this.funcNames[ri] == expr.name && this.funcClasses[ri] == "") {
                        string rt = this.funcRetTypes[ri];
                        if (this.isClassName(rt)) { return rt; }
                        break;
                    }
                }
            }
            return "";
        }
        return "";
    }

    public int findFieldOffset(string className, string fieldName) {
        int start = -1;
        int cnt = 0;
        for (int i = 0; i < this.classNames.length; i++) {
            if ((this.classNames[i] == className || className == this.classNames[i] + "?")) {
                start = this.classFieldStarts[i];
                cnt = this.classFieldCounts[i];
            }
        }
        if (start < 0) { return -1; }
        for (int i = 0; i < cnt; i++) {
            if (this.classFieldNames[start + i] == fieldName) {
                return this.classFieldOffsets[start + i];
            }
        }
        return -1;
    }

    public string findFieldType(string className, string fieldName) {
        int start = -1;
        int cnt = 0;
        for (int i = 0; i < this.classNames.length; i++) {
            if ((this.classNames[i] == className || className == this.classNames[i] + "?")) {
                start = this.classFieldStarts[i];
                cnt = this.classFieldCounts[i];
            }
        }
        if (start < 0) { return ""; }
        for (int i = 0; i < cnt; i++) {
            if (this.classFieldNames[start + i] == fieldName) {
                return this.classFieldTypes[start + i];
            }
        }
        return "";
    }

    public string getLocalType(string name) {
        for (int i = this.localNames.length - 1; i >= 0; i--) {
            if (this.localNames[i] == name) {
                if (i < this.localTypes.length) {
                    return this.localTypes[i];
                }
                return "";
            }
        }
        for (int i = 0; i < this.globalNames.length; i++) {
            if (this.globalNames[i] == name) {
                if (i < this.globalTypes.length) {
                    return this.globalTypes[i];
                }

                return "";
            }
        }
        return "";
    }

    public void setLocalType(string name, string typeName) {
        for (int i = this.localNames.length - 1; i >= 0; i--) {
            if (this.localNames[i] == name) {
                while (this.localTypes.length <= i) {
                    this.localTypes.add("");
                }
                this.localTypes[i] = typeName;
                return;
            }
        }
    }

    public void setLocalOffset(string name, int off) {
        for (int i = this.localNames.length - 1; i >= 0; i--) {
            if (this.localNames[i] == name) {
                this.localOffsets[i] = off;
                return;
            }
        }
    }

    public string arrayElementType(string arrType) {
        // Element type of a declared array type.  Type names are built as
        // `base + "[]"*n` (see parseVarDecl), so the element type of `T[]` is
        // `T` and the element type of `T[][]` is `T[]`.  Strip exactly ONE
        // trailing `[]` pair; the old scan stopped at the FIRST pair, which
        // collapsed `string[][]` to `string` and made `m[1][0]` infer as a
        // character (byte load) instead of a string pointer.
        if (arrType.length >= 2) {
            int len = arrType.length;
            if (arrType[len - 2] == '[' && arrType[len - 1] == ']') {
                string result = "";
                for (int i = 0; i < len - 2; i++) {
                    result += arrType[i];
                }
                return result;
            }
        }
        return arrType;
    }

    public int newLabel() {
        int id = this.asm.labelPositions.length;
        this.asm.labelPositions.add(-1);
        return id;
    }

    public int addString(string s) {
        for (int i = 0; i < this.strings.length; i++) {
            StrEntry se = this.strings[i];
            if (se.text == s) {
                return i;
            }
        }
        int off = this.stringData.length;
        for (int i = 0; i < s.length; i++) {
            int ch = s[i];
            this.stringData.add(ch);
        }
        this.stringData.add(0);
        StrEntry e;
        e = new StrEntry(s);
        e.dataOffset = off;
        this.strings.add(e);
        return this.strings.length - 1;
    }

    public int[] getStringData() {
        return this.stringData;
    }

    public int findImport(string dll, string name) {
        for (int i = 0; i < this.importDlls.length; i++) {
            if (this.importDlls[i] == dll && this.importFuncs[i] == name) {
                return i;
            }
        }
        this.importDlls.add(dll);
        this.importFuncs.add(name);
        return this.importDlls.length - 1;
    }

    public int addImportPatch(string dll, string name) {
        // LINUX SysV backend (additive): same-shape libc calls keep their
        // Win64-regged emission here and are shuffled into SysV position
        // below, so the ~200 existing call sites need no per-site edits.
        // Dedicated-branch sites (HeapAlloc, cargs, eprint/input) and
        // already-SysV sites (ext-path linux imports, print tails) bypass
        // the shuffle via addImportPatchDirect.
        if (this.isLinuxTarget()) {
            string lib = this.linuxImportLib(dll);
            string lname = this.linuxImportName(dll, name);
            if (lib.length > 0 && lname.length > 0) {
                dll = lib;
                name = lname;
            }
            this.shuffleWin64ToSysv();
        }
        // MAC AAPCS64 backend (additive, code-only): libSystem patch sites
        // mirroring macos.rs grants (MAC.md section 6). v1 records the bind
        // (GOT/stub patch sites for the Mach-O emitter) without shuffling:
        // full AAPCS64 X0-X7/V0-V7 lowering is hardware-gated, and the v1
        // Mach-O emitter ignores bodies (fixed exit stub), so x64-regged
        // emission here is discarded on the MAC path. Win64/SysV paths never
        // observe isMacTarget()==true, so those outputs stay byte-identical.
        if (this.isMacTarget()) {
            string mlib = this.macImportLib(dll);
            string mname = this.macImportName(dll, name);
            if (mlib.length > 0 && mname.length > 0) {
                dll = mlib;
                name = mname;
            }
        }
        int idx = this.findImport(dll, name);
        this.importPatchOffsets.add(this.asm.buf.length + 2);
        this.importPatchDllIndices.add(-1);
        this.importPatchFuncIndices.add(idx);
        // OVERHAUL.md --runtime: remember every HeapAlloc reference so the
        // driver can repoint it at the embedded __silver_rt_alloc slot after
        // the ordinary IAT patch pass.
        if (this.runtimeMode && name == "HeapAlloc" && dll == "kernel32.dll") {
            this.heapAllocPatchPos.add(this.asm.buf.length + 2);
        }
        return idx;
    }

    // ------------------------------------------------------------------
    // LINUX SysV backend, additive (LINUX.md Phase C, mirrors silverc-rs
    // codegen.rs TargetOs::Linux branches). Every method here is either a
    // pure target query (no emission) or a Linux branch beside an unchanged
    // WINDOWS default, so --os WINDOWS emission stays byte-identical.
    // SysV argument registers RDI/RSI/RDX/RCX/R8/R9 are asm regs 7/6/2/1/8/9.
    // ------------------------------------------------------------------

    // True when this compilation targets Linux (driver sets targetOs via
    // ppTargetOsFor; "" behaves as WINDOWS).
    public bool isLinuxTarget() {
        return this.targetOs == "LINUX";
    }

    // True when compiling for macOS (AAPCS64 ABI + Mach-O output). All macOS
    // branches hang off this helper so Win64/SysV paths stay byte-identical
    // when false (mirrors silverc-rs is_mac()).
    public bool isMacTarget() {
        return this.targetOs == "MAC";
    }

    // --- AAPCS64 policy (MAC.md section 8, macOS ARM64 only, code-only) ---
    // Integer args X0-X7, float args V0-V7 (same slots as ints, like SysV),
    // stack args at [SP+0] at call, 16-byte SP at ALL times (faults otherwise),
    // X29/X30 frame chain, NO red zone in v1, returns X0 (+X1 pairs, V0 floats),
    // varargs per AAPCS64 (no AL convention), objc_msgSend like a normal C
    // call (self X0, _cmd X1). Cooperative __exc_* protocol is kept (OS/CPU
    // independent). Full per-construct lowering is hardware-gated (MAC.md s10);
    // these helpers pin the policy for the Mach-O entry stub; Win64/SysV paths
    // never consult them, so those outputs are byte-identical with or without.
    public int aapcsRegCount() {
        return this.macBackend.aapcsRegCount();
    }

    public int aapcsStackBase() {
        return this.macBackend.aapcsStackBase();
    }

    public int aapcsFirstArgReg() {
        return this.macBackend.aapcsFirstArgReg();
    }

    public int aapcsIncomingStackOffset(int i) {
        return this.macBackend.aapcsIncomingStackOffset(i);
    }

    // Integer/pointer argument registers: 4 on Win64 (RCX/RDX/R8/R9),
    // 6 on SysV (RDI/RSI/RDX/RCX/R8/R9), 8 on AAPCS64 (X0-X7).
    public int abiRegCount() {
        if (this.isMacTarget()) { return 8; }
        if (this.isLinuxTarget()) { return 6; }
        return 4;
    }

    // Outgoing stack-argument base: 32 (Win64 shadow space) on WINDOWS,
    // 0 on SysV and AAPCS64 (no shadow space).
    public int abiStackBase() {
        if (this.isMacTarget()) { return 0; }
        if (this.isLinuxTarget()) { return 0; }
        return 32;
    }

    // First integer/pointer argument register: RCX (1) on WINDOWS,
    // RDI (7) on SysV, X0 (0) on AAPCS64.
    public int abiFirstArgReg() {
        if (this.isMacTarget()) { return 0; }
        if (this.isLinuxTarget()) { return 7; }
        return 1;
    }

    // The i-th SysV argument register (RDI/RSI/RDX/RCX/R8/R9).
    public int sysvRegAt(int i) {
        return this.linuxBackend.sysvRegAt(i);
    }

    // The i-th AAPCS64 argument register (X0-X7, A64 indices).
    public int aapcsRegAt(int i) {
        return this.macBackend.aapcsRegAt(i);
    }

    // ABI call-setup dispatch (mirrors silverc-rs emit_aligned_call_setup /
    // emit_sysv_call_setup): SysV anchors RSP in R13, 16-aligns, and reserves
    // only the requested outgoing stack space (16-rounded, no 32-byte
    // shadow). The WINDOWS path calls the historical shape unchanged.
    // Teardown is shared (mov RSP,R13 + pop R13) on both targets.
    public void emitAbiCallSetup(int extraBytes) {
        if (this.isLinuxTarget()) {
            this.asm.pushR64(13);
            this.asm.movRR64(13, 4);
            this.asm.andRImm(4, -16);
            // LINUX SysV backend: reserve 8 slack bytes above the argument
            // spill area. Spills live at [RSP+8k] and the pushed-R13 save
            // slot sits at [R13]; without slack, alignment rounding can place
            // a spill exactly on the slot (nested multi-arg calls corrupted
            // R13, then teardown restored RSP from garbage). +8 guarantees
            // the slot stays strictly above every spill on both parities.
            int alignedTotal = ((extraBytes + 8 + 15) / 16) * 16;
            this.asm.subRI32(4, alignedTotal);
            return;
        }
        this.asm.emitCallSetup(extraBytes);
    }

    public void emitAbiCallTeardown() {
        this.asm.emitCallTeardown();
    }

    // Shuffle the Win64 argument registers into SysV position at an import
    // call boundary: RCX->RDI, RDX->RSI, R8->RDX, R9->RCX. Order-safe (every
    // destination is written after its source was consumed). RDI/RSI are
    // caller-saved in both ABIs so no live value is lost; RAX is untouched
    // so a staged movabs address or AL count survives.
    public void shuffleWin64ToSysv() {
        this.asm.movRR64(7, 1);
        this.asm.movRR64(6, 2);
        this.asm.movRR64(2, 8);
        this.asm.movRR64(1, 9);
    }

    // LINUX.md §6: backing shared lib for a win32 DLL on the Linux target.
    // "" keeps the original pair (dedicated branch, or an honest loader
    // failure for Windows-only APIs with no Linux equivalent).
    public string linuxImportLib(string dll) {
        return this.linuxBackend.linuxImportLib(dll);
    }

    // LINUX.md §6: libc equivalent of one win32 export. "" keeps the
    // original pair: HeapAlloc/GetProcessHeap/SetConsoleOutputCP (dedicated
    // branches), GetStdHandle/GetCommandLineA (dedicated branches), and
    // Windows-only APIs (process/registry/toast/wininet/X11 gaps, listed in
    // the commit notes) that fail loudly at load when actually called.
    public string linuxImportName(string dll, string name) {
        return this.linuxBackend.linuxImportName(dll, name);
    }

    // MAC.md §6: backing libSystem lib for a win32 DLL on the MAC target.
    // "" keeps the original pair (dedicated branch, or honest loader failure
    // for Windows-only APIs with no Darwin equivalent). Mirrors linuxImportLib
    // shape; the owner lib is libSystem, never libc.so.6.
    public string macImportLib(string dll) {
        return this.macBackend.macImportLib(dll);
    }

    // MAC.md §6: libSystem equivalent of one win32 export. POSIX-shared names
    // keep their spelling (different dylib owner); Linux-only spellings
    // (getrandom, fork/execve, gettid, sysinfo) are deliberately ABSENT (s9);
    // Darwin-only spellings (posix_spawn, sysctlbyname, getentropy, ...) are
    // called directly from std #on MAC regions via mac grants, never through
    // this Win32 remap. "" keeps the original pair (dedicated branches for
    // HeapAlloc/mmap, GetStdHandle fd 0/1/2, etc.; Windows-only gaps fail loud).
    public string macImportName(string dll, string name) {
        return this.macBackend.macImportName(dll, name);
    }

    // Import-patch core WITHOUT the register shuffle, for call sites that
    // already marshal SysV registers (ext-path linux imports, print/printf
    // tails, heap helpers). Mapping + dedup + recording match addImportPatch.
    public int addImportPatchDirect(string dll, string name) {
        if (this.isLinuxTarget()) {
            string lib = this.linuxImportLib(dll);
            string lname = this.linuxImportName(dll, name);
            if (lib.length > 0 && lname.length > 0) {
                dll = lib;
                name = lname;
            }
        }
        int idx = this.findImport(dll, name);
        this.importPatchOffsets.add(this.asm.buf.length + 2);
        this.importPatchDllIndices.add(-1);
        this.importPatchFuncIndices.add(idx);
        return idx;
    }

