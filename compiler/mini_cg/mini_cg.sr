    public void genDictIndexSet(Node bin) {
        Node lhs = bin.child(0);
        Node rhs = bin.child(1);
        Node dictNode = lhs.child(0);
        Node keyNode = lhs.child(1);
        this.genExpr(dictNode);
        int dBase = this.allocLocal("__ds_base");
        this.asm.movMBaseR(5, 0, dBase);
        this.genExpr(keyNode);
        int dKey = this.allocLocal("__ds_key");
        this.asm.movMBaseR(5, 0, dKey);
        this.genExpr(rhs);
        int dVal = this.allocLocal("__ds_val");
        this.asm.movMBaseR(5, 0, dVal);
        int dI = this.allocLocal("__ds_i");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, dI);
        int slotKind = 0;
        int slotOff = 0;
        int slotOff2 = 0;
        if (dictNode.kind == 6) {
            slotKind = 1;
            slotOff = this.findLocal(dictNode.name);
        } else if (dictNode.kind == 13 && dictNode.childCount() > 0) {
            Node dobj = dictNode.child(0);
            if (dobj.kind == 6 && dobj.name == "this") {
                slotKind = 2;
                slotOff = this.findLocal("this");
                slotOff2 = this.findFieldOffset(this.currentClassName, dictNode.name);
            } else if (dobj.kind == 6) {
                slotKind = 3;
                slotOff = this.findLocal(dobj.name);
                slotOff2 = this.findFieldOffset(this.getLocalType(dobj.name), dictNode.name);
            }
        }
        int lL = this.newLabel();
        int fL = this.newLabel();
        int aL = this.newLabel();
        int eL = this.newLabel();
        int nG = this.newLabel();
        int iter = this.newLabel();
        this.asm.bindLabel(lL);
        this.asm.movRMBase(0, 5, dI);
        this.asm.movRMBase(1, 5, dBase);
        this.asm.movRMBase(1, 1, -8);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(aL);
        this.asm.movRMBase(0, 5, dI);
        this.asm.shlR64Imm(0, 1);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(11, 0);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.addRR64(0, 11);
        this.asm.movRMBase(1, 0, 0);
        this.asm.cmpRI32(1, 0);
        this.asm.jeLabel(iter);
        this.asm.movRR64(1, 1);
        this.asm.movRMBase(2, 5, dKey);
        this.addImportPatch("ucrtbase.dll", "strcmp");
        int sCmp2 = 0xDEADBEEFCAFEBADE;
        this.asm.emitImm64(0, sCmp2);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(fL);
        this.asm.bindLabel(iter);
        this.asm.movRMBase(0, 5, dI);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, dI);
        this.asm.jmpLabel(lL);
        this.asm.bindLabel(fL);
        this.asm.movRMBase(0, 5, dI);
        this.asm.shlR64Imm(0, 1);
        this.asm.addRI32(0, 1);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(11, 0);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.addRR64(0, 11);
        this.asm.movRMBase(1, 5, dVal);
        this.asm.movMBaseR(0, 1, 0);

        this.asm.jmpLabel(eL);
        this.asm.bindLabel(aL);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.movRMBase(1, 0, -16);
        this.asm.movRMBase(2, 0, -8);
        this.asm.cmpRR64(2, 1);
        this.asm.jlLabel(nG);
        int ncO = this.allocLocal("__ds_nc");
        this.asm.movRMBase(0, 5, dBase);
        this.asm.movRMBase(0, 0, -16);
        this.asm.shlR64Imm(0, 1);
        this.asm.movMBaseR(5, 0, ncO);
        // Each dictionary entry occupies two 8-byte words, in addition to
        // the 16-byte header.  Allocate the full new capacity, not the array
        // sized `(capacity + 2) * 8` used by ordinary arrays.
        this.asm.movRMBase(0, 5, ncO);
        this.asm.shlR64Imm(0, 4);
        this.asm.addRI32(0, 16);
        this.asm.movRR64(1, 0);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int naO = this.allocLocal("__ds_na");
        this.asm.movMBaseR(5, 0, naO);
        // Preserve the old logical length; the new allocation must initialize
        // both header words before it becomes the active dictionary pointer.
        int oldLenO = this.allocLocal("__ds_old_len");
        this.asm.movRMBase(0, 5, dBase);
        this.asm.movRMBase(0, 0, -8);
        this.asm.movMBaseR(5, 0, oldLenO);
        int cpI = this.allocLocal("__ds_cpi");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, cpI);
        int cpL = this.newLabel();
        int cpE = this.newLabel();
        this.asm.bindLabel(cpL);
        this.asm.movRMBase(0, 5, cpI);
        this.asm.movRMBase(1, 5, dBase);
        this.asm.movRMBase(1, 1, -8);
        this.asm.shlR64Imm(1, 1);
        this.asm.addRI32(1, 2);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(cpE);
        this.asm.movRMBase(0, 5, cpI);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(11, 0);
        // dBase points at the old data area (allocation base + 16), while
        // naO is the new allocation base.  Keep the header out of the copied
        // key/value slots by biasing the destination by 16 bytes.
        this.asm.movRMBase(0, 5, dBase);
        this.asm.addRR64(0, 11);
        this.asm.movRMBase(1, 0, 0);
        this.asm.movRMBase(0, 5, naO);
        this.asm.addRI32(0, 16);
        this.asm.addRR64(0, 11);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRMBase(0, 5, cpI);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, cpI);
        this.asm.jmpLabel(cpL);
        this.asm.bindLabel(cpE);
        this.asm.movRMBase(0, 5, naO);
        this.asm.movRMBase(1, 5, ncO);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRMBase(0, 5, naO);
        this.asm.movRMBase(1, 5, oldLenO);
        this.asm.movMBaseR(0, 1, 8);
        if (slotKind == 1) {
            this.asm.movRMBase(0, 5, naO);
            this.asm.addRI32(0, 16);
            this.asm.movMBaseR(5, 0, slotOff);
        } else if (slotKind == 2) {
            this.asm.movRMBase(1, 5, slotOff);
            this.asm.movRMBase(0, 5, naO);
            this.asm.addRI32(0, 16);
            this.asm.movMBaseR(1, 0, slotOff2);
        } else if (slotKind == 3) {
            this.asm.movRMBase(1, 5, slotOff);
            this.asm.movRMBase(0, 5, naO);
            this.asm.addRI32(0, 16);
            this.asm.movMBaseR(1, 0, slotOff2);
        }
        this.asm.movRMBase(0, 5, naO);
        this.asm.addRI32(0, 16);
        this.asm.movMBaseR(5, 0, dBase);
        this.asm.bindLabel(nG);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.movRMBase(1, 0, -8);
        this.asm.shlR64Imm(1, 1);
        this.asm.shlR64Imm(1, 3);
        this.asm.addRR64(0, 1);
        this.asm.movRMBase(1, 5, dKey);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRMBase(1, 5, dVal);
        this.asm.movMBaseR(0, 1, 8);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.movRMBase(1, 0, -8);

        this.asm.addRI32(1, 1);
        this.asm.movMBaseR(0, 1, -8);
        this.asm.movRI64(0, 0);
        this.asm.bindLabel(eL);
    }

    public void genDictContains(Node call) {
        Node dictNode = call.child(0);
        Node keyNode = call.child(1);
        this.genExpr(dictNode);
        int dBase = this.allocLocal("__dc_base");
        this.asm.movMBaseR(5, 0, dBase);
        this.genExpr(keyNode);
        int dKey = this.allocLocal("__dc_key");
        this.asm.movMBaseR(5, 0, dKey);
        int dI = this.allocLocal("__dc_i");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, dI);
        int lL = this.newLabel();
        int fL = this.newLabel();
        int nL = this.newLabel();
        int eL = this.newLabel();
        int iter = this.newLabel();
        this.asm.bindLabel(lL);
        this.asm.movRMBase(0, 5, dI);
        this.asm.movRMBase(1, 5, dBase);
        this.asm.movRMBase(1, 1, -8);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(nL);
        this.asm.movRMBase(0, 5, dI);
        this.asm.shlR64Imm(0, 1);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(11, 0);
        this.asm.movRMBase(0, 5, dBase);
        this.asm.addRR64(0, 11);
        this.asm.movRMBase(1, 0, 0);
        this.asm.cmpRI32(1, 0);
        this.asm.jeLabel(iter);
        this.asm.movRR64(1, 1);
        this.asm.movRMBase(2, 5, dKey);
        this.addImportPatch("ucrtbase.dll", "strcmp");
        int sCmp3 = 0xDEADBEEFCAFEBADD;
        this.asm.emitImm64(0, sCmp3);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(fL);
        this.asm.bindLabel(iter);
        this.asm.movRMBase(0, 5, dI);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, dI);
        this.asm.jmpLabel(lL);
        this.asm.bindLabel(fL);
        this.asm.movRI64(0, 1);
        this.asm.jmpLabel(eL);
        this.asm.bindLabel(nL);
        this.asm.xorRR64(0, 0);
        this.asm.bindLabel(eL);
    }

    public void genValueFactoryCall(Node call) {
        // Value.makeXxx(...) builtin tagged-union factory: allocate a 112-byte
        // zeroed block, set the tag and payload at the fixed Value offsets.
        string m = call.name;
        this.asm.emitImm64(1, 112);
        this.addImportPatch("msvcrt.dll", "malloc");
        int sV0 = 0xDEADBEEFCAFEBAB0;
        this.asm.emitImm64(0, sV0);
        this.asm.movRMBase(11, 0, 0);
        this.asm.xorRR64(0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(11);
        this.asm.emitCallTeardown();
        int vP = this.allocLocal("__val_ptr");
        this.asm.movMBaseR(5, 0, vP);
        for (int zi = 0; zi < 14; zi++) {
            this.asm.movRMBase(0, 5, vP);
            this.asm.movRI64(1, 0);
            this.asm.movMBaseR(0, 1, zi * 8);
        }
        int[] vArgs = [];
        // child(0) is the `Value` receiver; arguments start at child(1).
        for (int ai = 1; ai < call.childCount(); ai++) {
            this.genExpr(call.child(ai));
            int t = this.allocLocal("__val_arg");
            this.asm.movMBaseR(5, 0, t);
            vArgs.add(t);
        }
        int tag = 0;
        int fOff = 8;
        if (m == "makeInt") { tag = 1; fOff = 8; }
        else if (m == "makeFloat") { tag = 2; fOff = 16; }
        else if (m == "makeBool") { tag = 3; fOff = 24; }
        else if (m == "makeString") { tag = 4; fOff = 32; }
        else if (m == "makeChar") { tag = 5; fOff = 40; }
        else if (m == "makeArray") { tag = 6; fOff = 48; }
        else if (m == "makeTuple") { tag = 7; fOff = 48; }
        else if (m == "makeObject") { tag = 8; fOff = 56; }

        else if (m == "makeFunc") { tag = 9; fOff = 72; }
        else if (m == "makeBuiltin") { tag = 10; fOff = 72; }
        else if (m == "makeClassInst") { tag = 12; fOff = 56; }
        else if (m == "makeEnumVal") { tag = 13; fOff = 64; }
        else if (m == "makeDict") { tag = 15; fOff = 56; }
        this.asm.movRMBase(0, 5, vP);
        this.asm.movRI64(1, tag);
        this.asm.movMBaseR(0, 1, 0);
        if (vArgs.length > 0) {
            this.asm.movRMBase(0, 5, vP);
            this.asm.movRMBase(1, 5, vArgs[0]);
            this.asm.movMBaseR(0, 1, fOff);
        }
        if (m == "makeEnumVal") {
            if (vArgs.length > 1) {
                this.asm.movRMBase(0, 5, vP);
                this.asm.movRMBase(1, 5, vArgs[1]);
                this.asm.movMBaseR(0, 1, 32);
            }
        }
        // makeObject / makeClassInst carry a second argument: the type name
        // stored at the typeName offset (64).
        if (m == "makeObject" || m == "makeClassInst") {
            if (vArgs.length > 1) {
                this.asm.movRMBase(0, 5, vP);
                this.asm.movRMBase(1, 5, vArgs[1]);
                this.asm.movMBaseR(0, 1, 64);
            }
        }
        // strVal = "" so printing or concatenating a value that never received
        // a string payload cannot dereference a null pointer. makeString and
        // makeEnumVal already store their string payload at the strVal offset
        // (32), so skip the default there to avoid overwriting it.
        if (m != "makeString" && m != "makeEnumVal") {
            this.asm.movRMBase(0, 5, vP);
            this.asm.pushR64(0);
            Node es = new Node(); es.kind = 2; es.strVal = "";
            this.genExpr(es);
            this.asm.movRR64(1, 0);
            this.asm.popR64(0);
            this.asm.movMBaseR(0, 1, 32);
        }
        this.asm.movRMBase(0, 5, vP);
    }

    public string parentClassName(string className) {
        for (int i = 0; i < this.classNames.length; i++) {
            if (this.classNames[i] == className) {
                return this.classParentClasses[i];
            }
        }
        return "";
    }

    public int findConstructor(string className, int nargs) {
        int ctorIdx = -1;
        // Exact-arity match first: `new Env()` must select the no-arg
        // constructor, not a later overload (e.g. Env(Env? parent)) whose
        // garbage argument would leave fields non-null and recurse forever.
        for (int i = 0; i < this.funcNames.length; i++) {
            if (this.funcNames[i] == "construct" && this.funcClasses[i] == className) {
                if (i < this.funcParamCounts.length && this.funcParamCounts[i] == nargs) {
                    ctorIdx = i;
                }
            }
        }
        // Fall back to a constructor whose trailing parameters all have defaults.
        if (ctorIdx < 0) {
            for (int i = 0; i < this.funcNames.length; i++) {
                if (this.funcNames[i] == "construct" && this.funcClasses[i] == className) {
                    int pc = (i < this.funcParamCounts.length) ? this.funcParamCounts[i] : 0;
                    int ps = (i < this.funcParamStarts.length) ? this.funcParamStarts[i] : 0;
                    bool allDefault = true;
                    for (int di = nargs; di < pc; di++) {
                        if (ps + di >= this.funcParamHasDefaults.length || this.funcParamHasDefaults[ps + di] != 1) {
                            allDefault = false;
                        }
                    }
                    if (allDefault) { ctorIdx = i; }
                }
            }
        }
        // Last-resort fallback: any constructor of the class.
        if (ctorIdx < 0) {
            for (int i = 0; i < this.funcNames.length; i++) {
                if (this.funcNames[i] == "construct" && this.funcClasses[i] == className) {
                    ctorIdx = i;
                }
            }
        }
        return ctorIdx;
    }

public void genNewCall(Node call) {
    int size = 16;
    for (int i = 0; i < this.classNames.length; i++) {
        if (this.classNames[i] == call.name) {
            int cnt = this.classFieldCounts[i];
            size = cnt * 8;
            if (size < 16) { size = 16; }

        }
    }
    this.asm.emitImm64(1, size);
    this.addImportPatch("msvcrt.dll", "malloc");
    int s4 = 0xDEADBEEFCAFEBAB0;            this.asm.emitImm64(0, s4);
            this.asm.movRMBase(11, 0, 0);
            this.asm.xorRR64(0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(11);
            this.asm.emitCallTeardown();
            int tmpOff = this.allocLocal("__new_tmp");
    this.asm.movMBaseR(5, 0, tmpOff);
    int[] argRegs = [1, 2, 8, 9];
    int nargs = call.childCount();
    int[] argTemps = [];
    for (int i = 0; i < nargs; i++) {
        bool convertedMessageArray = false;
        // ChatCompletionRequest's second parameter is ChatMessage[]. Lower
        // anonymous `{role: ..., content: ...}` entries to actual objects.
        bool hasAnonymousMessage = false;                if (call.child(i).kind == 19 && call.child(i).childCount() > 0) {
            if (call.child(i).child(0).kind == 66 || call.child(i).child(0).kind == 74) { hasAnonymousMessage = true; }
        }
        if (call.name == "ChatCompletionRequest" && i == 1 && hasAnonymousMessage) {
            int count = call.child(i).childCount();
            int capacity = 8;
            int allocSize = (capacity + 2) * 8;
            this.asm.emitImm64(1, allocSize);
            this.addImportPatch("msvcrt.dll", "malloc");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            int msgArr = this.allocLocal("__msg_arr");
            this.asm.movMBaseR(5, 0, msgArr);
            this.asm.movRMBase(0, 5, msgArr);
            this.asm.emitImm64(1, capacity);
            this.asm.movMBaseR(0, 1, 0);
            this.asm.movRMBase(0, 5, msgArr);
            this.asm.emitImm64(1, count);
            this.asm.movMBaseR(0, 1, 8);
            for (int mi = 0; mi < count; mi++) {
                Node literal = call.child(i).child(mi);
                Node fake = new Node(); fake.kind = 10; fake.name = "ChatMessage";
                for (int mf = 0; mf < literal.childCount(); mf++) {
                    Node pair = literal.child(mf);
                    if (pair.kind == 18 && pair.childCount() > 1) {
                        fake.children.add(pair.child(1));
                    }
                }
                this.genNewCall(fake);
                this.asm.movRMBase(1, 5, msgArr);
                this.asm.movMBaseR(1, 0, 16 + mi * 8);
            }
            this.asm.movRMBase(0, 5, msgArr);
            this.asm.addRI32(0, 16);
            convertedMessageArray = true;
        }
        if (!convertedMessageArray) {
            this.genExpr(call.child(i));
        }
        int t = this.allocLocal("__na");
        this.asm.movMBaseR(5, 0, t);
        argTemps.add(t);
    }
    int ctorIdx = this.findConstructor(call.name, nargs);
    if (ctorIdx < 0) {
        // Inherit the nearest ancestor's constructor when this class defines
        // none of its own (e.g. `new ValueException(...)` when
        // `ValueException extends Exception` has no construct).
        string current = call.name;
        for (int guard = 0; guard < this.classNames.length; guard++) {
            string parent = this.parentClassName(current);
            if (parent == "") { break; }
            ctorIdx = this.findConstructor(parent, nargs);
            if (ctorIdx >= 0) { break; }
            current = parent;
        }
    }
    if (ctorIdx >= 0 && ctorIdx < this.funcOffsets.length) {
        int paramCount = this.funcParamCounts[ctorIdx];
        int paramStart = this.funcParamStarts[ctorIdx];
        for (int di = nargs; di < paramCount; di++) {
            int defaultIndex = paramStart + di;
            if (defaultIndex < this.funcParamDefaults.length) {
                this.genExpr(this.funcParamDefaults[defaultIndex]);
            } else {
                this.asm.xorRR64(0, 0);
            }
            int dt = this.allocLocal("__nd");
            this.asm.movMBaseR(5, 0, dt);
            argTemps.add(dt);
        }
        nargs = argTemps.length;
        // Constructor ABI: RCX = `this` (the new instance), RDX/R8/R9 = first
        // three declared params, params 4+ go on the caller stack after the
        // 32-byte shadow space ([RSP+32], [RSP+40], ...).  Spill every
        // argument to the shadow/stack slots first (nested call in a later
        // argument would clobber the volatile argument registers), then load
        // the registers.
        // LINUX SysV backend (additive): RDI = `this`, RSI/RDX/RCX/R8/R9 =
        // first five declared params, params 6+ at [RSP+0] (no shadow).
        // Slot counts include `this` on both targets.
        int ctorSlots = nargs + 1;
        int ctorNreg = 4;
        int ctorBase = 32;
        if (this.isLinuxTarget()) {
            ctorNreg = 6;
            ctorBase = 0;
        }
        int extraStack = 0;
        if (ctorSlots > ctorNreg) { extraStack = (ctorSlots - ctorNreg) * 8; }
        // LINUX: spills cover every slot ([RSP+8k] for this + all args), not
        // just stack overflow, so reserve all of them (setup slack keeps the
        // pushed-R13 save slot strictly above the spill area on both parities).
        if (this.isLinuxTarget()) { extraStack = ctorSlots * 8; }
        this.emitAbiCallSetup(extraStack);
        this.asm.movRMBase(0, 5, tmpOff);
        this.asm.movMBaseR(4, 0, 0);
        for (int i = 0; i < nargs; i++) {
            this.asm.movRMBase(0, 5, argTemps[i]);
            if (i + 1 < ctorNreg) {
                this.asm.movMBaseR(4, 0, (i + 1) * 8);
            } else {
                this.asm.movMBaseR(4, 0, ctorBase + (i + 1 - ctorNreg) * 8);
            }
        }
        int ctorThisReg = 1;
        if (this.isLinuxTarget()) { ctorThisReg = 7; }
        this.asm.movRMBase(ctorThisReg, 5, tmpOff);
        for (int i = 0; i < nargs && i + 1 < ctorNreg; i++) {
            if (this.isLinuxTarget()) {
                this.asm.movRMBase(this.sysvRegAt(i + 1), 5, argTemps[i]);
            } else {
                this.asm.movRMBase(argRegs[i + 1], 5, argTemps[i]);
            }
        }
        if (this.funcOffsets[ctorIdx] >= 0) {
            int targetOff = this.funcOffsets[ctorIdx];
            int callPos = this.asm.buf.length;
            int rel32 = targetOff - (callPos + 5);
            this.asm.callRel32(rel32);
        } else {
            this.asm.callRel32(0);
            this.forwardCalls.add(this.asm.buf.length - 4);
            this.forwardCallFuncIdxs.add(-1);
            this.forwardCallNames.add("construct");
            this.forwardCallClasses.add(this.funcClasses[ctorIdx]);
        }
        this.emitAbiCallTeardown();
    }
    this.asm.movRMBase(0, 5, tmpOff);
}

    public void genSuperCall(Node call) {
        // super(arg0, arg1, ...) - call parent class constructor with `this`.
        // Only valid inside a class constructor.
        if (this.currentFunctionName != "construct") { return; }

        // Find parent class of the current class.
        string parentClass = "";
        for (int i = 0; i < this.classNames.length; i++) {
            if (this.classNames[i] == this.currentClassName) {
                parentClass = this.classParentClasses[i];
            }
        }
        if (parentClass == "") { return; }

        // Find parent's construct function.
        int ctorIdx = -1;
        for (int i = 0; i < this.funcNames.length; i++) {
            if (this.funcNames[i] == "construct" && this.funcClasses[i] == parentClass) {
                ctorIdx = i;
            }
        }
        if (ctorIdx < 0 || ctorIdx >= this.funcOffsets.length) { return; }

        // Evaluate super() arguments into temporary stack slots.
        int nargs = call.childCount();
        int[] argTemps = [];
        for (int i = 0; i < nargs; i++) {
            this.genExpr(call.child(i));
            int t = this.allocLocal("__sa");
            this.asm.movMBaseR(5, 0, t);
            argTemps.add(t);
        }

        // Set up the call: R1 = this, R2..R9 = args 0-2, stack = rest.
        // LINUX SysV backend (additive): RDI = this, RSI/RDX/RCX/R8/R9 =
        // args 0-4, stack = rest at [RSP+0]. Slot counts include `this`.
        int[] argRegs = [1, 2, 8, 9];
        int superSlots = nargs + 1;
        int superNreg = 4;
        int superBase = 32;
        if (this.isLinuxTarget()) {
            superNreg = 6;
            superBase = 0;
        }
        int extraStack = 0;
        if (superSlots > superNreg) { extraStack = (superSlots - superNreg) * 8; }
        this.emitAbiCallSetup(extraStack);
        // Load `this` directly from its local slot into R1.
        int superThisReg = 1;
        if (this.isLinuxTarget()) { superThisReg = 7; }
        this.asm.movRMBase(superThisReg, 5, this.findLocal("this"));   // R1 = this
        for (int i = 0; i < nargs; i++) {
            if (i + 1 < superNreg) {
                if (this.isLinuxTarget()) {
                    this.asm.movRMBase(this.sysvRegAt(i + 1), 5, argTemps[i]);
                } else {
                    this.asm.movRMBase(argRegs[i + 1], 5, argTemps[i]);
                }
            } else {
                this.asm.movRMBase(0, 5, argTemps[i]);
                this.asm.movMBaseR(4, 0, superBase + (i + 1 - superNreg) * 8);
            }
        }

        // Call the parent constructor.
        int targetOff = this.funcOffsets[ctorIdx];
        if (targetOff >= 0) {
            int callPos = this.asm.buf.length;
            int rel32 = targetOff - (callPos + 5);
            this.asm.callRel32(rel32);
        } else {
            this.asm.callRel32(0);
            this.forwardCalls.add(this.asm.buf.length - 4);
            this.forwardCallFuncIdxs.add(-1);
            this.forwardCallNames.add("construct");
            this.forwardCallClasses.add(parentClass);
        }
        this.emitAbiCallTeardown();
    }

    public int asmOperand(Node expr) {
        if (expr.kind == 0) { return expr.intVal; }
        if (expr.kind == 6) { return this.findLocal(expr.name); }

        return 0;
    }

    public int asmArg(int[] args, int i) {
        if (i >= 0 && i < args.length) {
            return args[i];
        }
        return 0;
    }

    public void genAsmCall(Node call) {
        string name = call.name;
        if (name == "ret") {
            this.asm.ret();
            return;
        }
        if (name == "label") {
            string lbl = "";
            if (call.childCount() > 0 && call.child(0).kind == 2) {
                lbl = call.child(0).strVal;
            }
            this.asm.label(lbl);
            return;
        }
        if (name == "bindLabel") {
            int id = 0;
            if (call.childCount() > 0) {
                id = this.asmOperand(call.child(0));
            }
            this.asm.bindLabel(id);
            return;
        }
        if (name == "emitImm64") {
            int reg = 0;
            int64 imm = 0;
            if (call.childCount() > 1) {
                reg = this.asmOperand(call.child(1));
            }
            if (call.childCount() > 2) {
                Node immNode = call.child(2);
                if (immNode.kind == 0) {
                    imm = immNode.intVal;
                } else if (immNode.kind == 6) {
                    imm = this.findLocal(immNode.name);
                }
            }
            this.asm.emitImm64(reg, imm);
            return;
        }
        // NOTE: avoid `continue` inside this for-loop on purpose: old compiler
        // builds miscompile continue-in-for (they skip the increment), which
        // breaks self-hosting bootstrap. Use if/else instead.
        int[] args = [];
        for (int i = 0; i < call.childCount(); i++) {
            Node c = call.child(i);
            if (c.kind != 13) {
                args.add(this.asmOperand(c));
            }
        }
        if (name == "pushR64") { this.asm.pushR64(this.asmArg(args, 0)); }
        else if (name == "popR64") { this.asm.popR64(this.asmArg(args, 0)); }
        else if (name == "movRR64") { this.asm.movRR64(this.asmArg(args, 0), this.asmArg(args, 1)); }
        else if (name == "movRI64") {
            int64 v = 0;
            if (call.childCount() > 1) { v = this.asmOperand(call.child(1)); }
            this.asm.movRI64(this.asmArg(args, 0), v);
        }
        else if (name == "movRMBase") { this.asm.movRMBase(this.asmArg(args, 0), this.asmArg(args, 1), this.asmArg(args, 2)); }
        else if (name == "movMBaseR") { this.asm.movMBaseR(this.asmArg(args, 0), this.asmArg(args, 1), this.asmArg(args, 2)); }
        else if (name == "subRI32") { this.asm.subRI32(this.asmArg(args, 0), this.asmArg(args, 1)); }
        else if (name == "addRI32") { this.asm.addRI32(this.asmArg(args, 0), this.asmArg(args, 1)); }
        else if (name == "xorRR64") { this.asm.xorRR64(this.asmArg(args, 0), this.asmArg(args, 1)); }
        else if (name == "cmpRI32") { this.asm.cmpRI32(this.asmArg(args, 0), this.asmArg(args, 1)); }
        else if (name == "cmpRR64") { this.asm.cmpRR64(this.asmArg(args, 0), this.asmArg(args, 1)); }
        else if (name == "callR64") { this.asm.callR64(this.asmArg(args, 0)); }
        else if (name == "leaRBase") { this.asm.leaRBase(this.asmArg(args, 0), this.asmArg(args, 1), this.asmArg(args, 2)); }
        else if (name == "emitU8") { this.asm.emitU8(this.asmArg(args, 0)); }
        else if (name == "emitU32") { this.asm.emitU32(this.asmArg(args, 0)); }
        else if (name == "emitImm64") { this.asm.emitImm64(this.asmArg(args, 0), this.asmArg(args, 1)); }
        else if (name == "emitCallSetup") { this.asm.emitCallSetup(this.asmArg(args, 0)); }
        else if (name == "emitCallTeardown") { this.asm.emitCallTeardown(); }
        else if (name == "addRR64") { this.asm.addRR64(this.asmArg(args, 0), this.asmArg(args, 1)); }
        else if (name == "subRR64") { this.asm.subRR64(this.asmArg(args, 0), this.asmArg(args, 1)); }
        else if (name == "mulRR64") { this.asm.mulRR64(this.asmArg(args, 0)); }
        else if (name == "andRImm") { this.asm.andRImm(this.asmArg(args, 0), this.asmArg(args, 1)); }
        else if (name == "shlR64Imm") { this.asm.shlR64Imm(this.asmArg(args, 0), this.asmArg(args, 1)); }
        else if (name == "incR64") { this.asm.incR64(this.asmArg(args, 0)); }
        else if (name == "decR64") { this.asm.decR64(this.asmArg(args, 0)); }
        else if (name == "movByteMBaseIdxR") { this.asm.movByteMBaseIdxR(this.asmArg(args, 0), this.asmArg(args, 1), this.asmArg(args, 2)); }
        else if (name == "movMBaseByteR") { this.asm.movMBaseByteR(this.asmArg(args, 0), this.asmArg(args, 1), this.asmArg(args, 2)); }
        else if (name == "jeLabel") { this.asm.jeLabel(this.asmArg(args, 0)); }
        else if (name == "jneLabel") { this.asm.jneLabel(this.asmArg(args, 0)); }
        else if (name == "jmpLabel") { this.asm.jmpLabel(this.asmArg(args, 0)); }
        else if (name == "jlLabel") { this.asm.jlLabel(this.asmArg(args, 0)); }
        else if (name == "jleLabel") { this.asm.jleLabel(this.asmArg(args, 0)); }
        else if (name == "jgLabel") { this.asm.jgLabel(this.asmArg(args, 0)); }
        else if (name == "jgeLabel") { this.asm.jgeLabel(this.asmArg(args, 0)); }
        else if (name == "movzxByteMBase") { this.asm.movzxByteMBase(this.asmArg(args, 0), this.asmArg(args, 1), this.asmArg(args, 2)); }
        else if (name == "callRel32") { this.asm.callRel32(this.asmArg(args, 0)); }
    }

    // WINDOWS-TARGET: the PE VERSIONINFO bridge. The self-hosted backend uses
    // the same version.dll APIs as silverc-rs, but emits them through its
    // normal import-patch mechanism.
    #on WINDOWS
    // DOCS/251 -- native PE VERSIONINFO bridge. The self-hosted backend uses
    // the same version.dll APIs as silverc-rs, but emits them through its
    // normal import-patch mechanism.
    public void genBinaryMetadataStatus(Node call) {
        if (call.childCount() < 1) {
            this.asm.xorRR64(0, 0);
            return;
        }
        this.genExpr(call.child(0));
        int pathOff = this.allocLocal("__binary_metadata_status_path");
        this.asm.movMBaseR(5, 0, pathOff);

        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, pathOff);
        this.asm.xorRR64(2, 2);
        this.addImportPatch("version.dll", "GetFileVersionInfoSizeA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int sizeOff = this.allocLocal("__binary_metadata_status_size");
        this.asm.movMBaseR(5, 0, sizeOff);
        int yes = this.newLabel();
        int done = this.newLabel();
        this.asm.cmpRI32(0, 0);
        this.asm.jneLabel(yes);
        this.asm.xorRR64(0, 0);
        this.asm.jmpLabel(done);
        this.asm.bindLabel(yes);
        this.asm.movRI64(0, 1);
        this.asm.bindLabel(done);
    }

    public void genBinaryMetadataField(Node call) {
        if (call.childCount() < 2) {
            this.emitLlmaiEmptyString();
            return;
        }
        this.genExpr(call.child(0));
        int pathOff = this.allocLocal("__binary_metadata_field_path");
        this.asm.movMBaseR(5, 0, pathOff);
        this.genExpr(call.child(1));
        int keyOff = this.allocLocal("__binary_metadata_field_key");
        this.asm.movMBaseR(5, 0, keyOff);

        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, pathOff);
        this.asm.xorRR64(2, 2);
        this.addImportPatch("version.dll", "GetFileVersionInfoSizeA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int sizeOff = this.allocLocal("__binary_metadata_field_size");
        this.asm.movMBaseR(5, 0, sizeOff);
        int failed = this.newLabel();
        int done = this.newLabel();
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(failed);

        this.emitLlmaiHeapAlloc(sizeOff);
        int dataOff = this.allocLocal("__binary_metadata_field_data");
        this.asm.movMBaseR(5, 0, dataOff);

        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, pathOff);
        this.asm.xorRR64(2, 2);
        this.asm.movRMBase(8, 5, sizeOff);
        this.asm.movRMBase(9, 5, dataOff);
        this.addImportPatch("version.dll", "GetFileVersionInfoA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(failed);

        // `language` is represented by the selected initial translation.
        // 0409/04B0 is the standard en-US VERSIONINFO table.
        if (call.child(1).kind == 2 && call.child(1).strVal == "language") {
            this.emitLlmaiStringLiteral("en-US");
            this.asm.jmpLabel(done);
        }

        int querySize = this.allocLocal("__binary_metadata_field_query_size");
        this.asm.movRI64(0, 256);
        this.asm.movMBaseR(5, 0, querySize);
        this.emitLlmaiHeapAlloc(querySize);
        int queryOff = this.allocLocal("__binary_metadata_field_query");
        this.asm.movMBaseR(5, 0, queryOff);
        this.emitLlmaiStringLiteral("\\\\StringFileInfo\\\\040904b0\\\\");
        int baseOff = this.allocLocal("__binary_metadata_field_base");
        this.asm.movMBaseR(5, 0, baseOff);

        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, queryOff);
        this.asm.movRMBase(2, 5, baseOff);
        this.addImportPatch("msvcrt.dll", "strcpy");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, queryOff);
        this.asm.movRMBase(2, 5, keyOff);
        this.addImportPatch("msvcrt.dll", "strcat");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int valueOff = this.allocLocal("__binary_metadata_field_value");
        int lenOff = this.allocLocal("__binary_metadata_field_len");
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, dataOff);
        this.asm.movRMBase(2, 5, queryOff);
        this.asm.leaRBase(8, 5, valueOff);
        this.asm.leaRBase(9, 5, lenOff);
        this.addImportPatch("version.dll", "VerQueryValueA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(failed);
        this.asm.movRMBase(0, 5, valueOff);
        this.asm.jmpLabel(done);

        this.asm.bindLabel(failed);
        this.emitLlmaiEmptyString();
        this.asm.bindLabel(done);
    }
    #off
    #on LINUX
    // Linux backend: no VERSIONINFO bridge (PE-only resource). Status
    // reports 0 (absent) and field yields the empty string, so metadata
    // queries degrade exactly like a version-less PE on WINDOWS. A future
    // ELF story (.note sections or the baked manifest) keeps these
    // signatures.
    public void genBinaryMetadataStatus(Node call) {
        this.asm.xorRR64(0, 0);
    }

    public void genBinaryMetadataField(Node call) {
        this.emitLlmaiEmptyString();
    }
    #off

    // True when a bare call to `name`
    // resolves as an imported win32 export: the export sits in a fully
    // imported DLL's table, or a single-export grant (plain or aliased by
    // its local name) covers it. Mirrors silverc-rs gen_call, where
    // win32::resolve runs BEFORE the bare static-method fallback so a
    // same-named class method (net.sr's socket.send / listener.accept)
    // never hijacks another module's ws2_32 call.
    public bool win32CallResolves(string name) {
        return this.windowsBackend.win32CallResolves(this, name);
    }

    // DOCS/261 custom resolve for the generic dispatcher below: the owning
    // file of a plain (non-aliased) custom grant answering to `name`, or ""
    // when none. Fixed full-DLL tables are NOT consulted here (the hardcoded
    // chain above owns them); custom dll/lib strings are generic and never
    // appear there. Aliased grants answer only via the alias loops.
    public string win32CustomResolveDll(string name) {
        for (int g = 0; g < this.win32Grants.length; g++) {
            string grant = this.win32Grants[g];
            if (grant.length > name.length + 1 && projectSlice(grant, grant.length - name.length, grant.length) == name && grant[grant.length - name.length - 1] == '|') {
                return projectSlice(grant, 0, grant.length - name.length - 1);
            }
        }
        return "";
    }

    // Ungated linux twin of the above (custom grants emit on both targets,
    // mirroring silverc-rs where win32::resolve and linux::resolve both run
    // regardless of `--os`). Fixed linux tables stay gated behind
    // linuxCallResolves/isLinuxTarget; only custom libs resolve here.
    public string linuxCustomResolveLibUngated(string name) {
        for (int g = 0; g < this.linuxGrants.length; g++) {
            string grant = this.linuxGrants[g];
            if (grant.length > name.length + 1 && projectSlice(grant, grant.length - name.length, grant.length) == name && grant[grant.length - name.length - 1] == '|') {
                return projectSlice(grant, 0, grant.length - name.length - 1);
            }
        }
        return "";
    }

    // Overload dispatch by argument count:
    // the LAST declared overload of `name` (class `cls`, "" for globals)
    // whose parameter list accepts `nargs` arguments. The variadic tail is
    // itself optional (required = non-default count among the fixed prefix);
    // same-arity ties keep the last declaration. -1 when nothing matches.
    public int selectOverloadIdx(string name, string cls, int nargs) {
        int best = -1;
        for (int i = 0; i < this.funcNames.length; i++) {
            if (this.funcNames[i] == name && this.funcClasses[i] == cls) {
                int pc = (i < this.funcParamCounts.length) ? this.funcParamCounts[i] : -1;
                if (pc < 0) { continue; }
                int pStart = this.funcParamStarts[i];
                bool variadic = i < this.funcHasVariadic.length && this.funcHasVariadic[i] == 1;
                int fixedLen = pc;
                if (variadic && pc > 0) { fixedLen = pc - 1; }
                int minArgs = 0;
                for (int k = 0; k < fixedLen; k++) {
                    if (pStart + k < this.funcParamHasDefaults.length && this.funcParamHasDefaults[pStart + k] == 0) { minArgs++; }
                }
                bool accepts;
                if (variadic) {
                    accepts = nargs >= minArgs;
                } else {
                    accepts = nargs >= minArgs && nargs <= pc;
                }
                if (accepts) { best = i; }
            }
        }
        return best;
    }

    // LINUX SysV backend (additive): marshal ext-path arguments into SysV
    // registers (RDI/RSI/RDX/RCX/R8/R9, stack at [RSP+0]) and call a granted
    // linux import through the ELF GOT. Mirrors the win32 ext-path shape
    // below minus the shadow space.
    public void genLinuxImportCall(Node call, int argStart, string lib, string libFn) {
        int extArgCount = call.childCount() - argStart;
        int nreg = this.abiRegCount();
        int stackBase = this.abiStackBase();
        int extStack = 0;
        if (extArgCount > nreg) { extStack = (extArgCount - nreg) * 8; }
        // Spills cover every argument ([RSP+8i]), so reserve all of them.
        if (this.isLinuxTarget()) { extStack = extArgCount * 8; }
        this.emitAbiCallSetup(extStack);
        int nargs2 = extArgCount;
        if (nargs2 > nreg) { nargs2 = nreg; }
        // Spill every argument to the outgoing slots before loading the
        // argument registers (nested calls clobber volatile regs).
        for (int i = 0; i < extArgCount; i++) {
            this.genExpr(call.child(i + argStart));
            if (i < nreg) {
                this.asm.movMBaseR(4, 0, i * 8);
            } else {
                this.asm.movMBaseR(4, 0, stackBase + (i - nreg) * 8);
            }
        }
        for (int i = 0; i < nargs2; i++) {
            this.asm.movRMBase(this.sysvRegAt(i), 4, i * 8);
        }
        this.addImportPatchDirect(lib, libFn);
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.emitAbiCallTeardown();
    }

    public void genUserCall(Node call) {
        string name = call.name;
        // Module-qualified call (e.g. json_runtime.get(x, "y") inside a class
        // method). The receiver is an identifier that is neither a user-class
        // instance nor `this`, so it names a module: the target must resolve
        // to the GLOBAL function, never to a method of the current class

        // (SessionStore.get would otherwise shadow json_runtime.get).
        bool isModuleCall = false;
        if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6) {
            string recvType = this.inferExprType(call.child(0));
            bool recvIsClass = false;
            for (int ci = 0; ci < this.classNames.length; ci++) {
                if ((this.classNames[ci] == recvType || recvType == this.classNames[ci] + "?")) { recvIsClass = true; }
            }
            // Any receiver that is not a class instance and not `this` names a
            // module: the call must resolve to the GLOBAL function (e.g.
            // json_runtime.get, fs.read). An unknown identifier has recvType
            // "" which is exactly the module case. Class methods of the
            // current class must NOT shadow global functions here.
            if (!recvIsClass && recvType != "this") {
                isModuleCall = true;
            }
        }
        int funcIdx = -1;
        // Count the explicit arguments the call passes to a GLOBAL function.
        // A member call on a non-class identifier (module receiver, e.g.
        // path.join(...)) drops that receiver; plain calls keep every child.
        // Method calls (current-class) are resolved by the first loop and pass
        // `this` implicitly, so their arity is never compared against nargs.
        int nargs = call.childCount();
        if (call.isMember && call.childCount() > 0 && call.child(0).kind == 6) {
            string rt0 = this.inferExprType(call.child(0));
            bool rt0IsClass = false;
            for (int ci2 = 0; ci2 < this.classNames.length; ci2++) {
                if ((this.classNames[ci2] == rt0 || rt0 == this.classNames[ci2] + "?")) { rt0IsClass = true; }
            }
            if (!rt0IsClass && rt0 != "this") {
                nargs = call.childCount() - 1;
            }
        }
        // Scope 1: current-class methods (and globals when generating a
        // plain function, whose currentClassName is ""). Overload dispatch
        // by argument count: when the
        // scope declares this name more than once, the call resolves to
        // the LAST declaration accepting the argument count; a count no
        // overload accepts is a compile error. A single declaration keeps
        // the legacy last-match behavior.
        int s1Matched = -1;
        int s1Count = 0;
        for (int i = 0; i < this.funcNames.length; i++) {
            if (!isModuleCall && this.funcNames[i] == name && this.funcClasses[i] == this.currentClassName) {
                s1Matched = i;
                s1Count++;
            }
        }
        if (s1Count > 1) {
            funcIdx = this.selectOverloadIdx(name, this.currentClassName, nargs);
            if (funcIdx < 0) {
                // UNIFIED_CORE_LIBRARY.md §4 rule 6: when no class-method
                // overload accepts the argument count but the name resolves
                // as an imported win32 export, fall through to the DLL path
                // instead of aborting (mirrors the silverc-rs dispatcher).
                if (this.win32CallResolves(name) || this.linuxCallResolves(name) || this.macCallResolves(name)) { funcIdx = -1; } else {
                printline("no overload of '" + name + "' takes " + nargs.toString() + " argument(s)");
                exit(1);
                return;
                }
            }
        } else {
            funcIdx = s1Matched;
        }
        // Scope 2: globals (module-qualified calls, or names the current
        // class does not declare). Same overload rule; a single global
        // keeps the legacy behavior of the old closest-arity scan.
        if (funcIdx < 0) {
            int s2Matched = -1;
            int s2Count = 0;
            for (int i = 0; i < this.funcNames.length; i++) {
                if (this.funcNames[i] == name && this.funcClasses[i] == "") {
                    s2Matched = i;
                    s2Count++;
                }
            }
            if (s2Count > 1) {
                funcIdx = this.selectOverloadIdx(name, "", nargs);
                if (funcIdx < 0) {
                    // UNIFIED_CORE_LIBRARY.md §4 rule 6 -- resolution prefers
                    // the DLL export inside regions: when NO user overload of
                    // the name accepts the argument count but the name is an
                    // imported win32 export, the call reaches the DLL
                    // (net.sr's bare connect/listen call sites). A
                    // same-arity user declaration still wins.
                    if (this.win32CallResolves(name) || this.linuxCallResolves(name) || this.macCallResolves(name)) { funcIdx = -1; } else {
                    printline("no overload of '" + name + "' takes " + nargs.toString() + " argument(s)");
                    exit(1);
                    return;
                    }
                }
            } else {
                funcIdx = s2Matched;
            }
        }
        if (funcIdx < 0) {
            for (int i = 0; i < this.funcNames.length; i++) {
                if (this.funcNames[i] == name) {
                    // A bare call that
                    // resolves as an imported win32 export must reach the
                    // DLL (silverc-rs checks win32::resolve before the bare
                    // static-method fallback), never a same-named class
                    // method from another module of the aggregate.
                    if (this.funcClasses[i] != "" && (this.win32CallResolves(name) || this.linuxCallResolves(name) || this.macCallResolves(name))) { continue; }
                    funcIdx = i;
                }
            }
        }
        string lookupClass = "";
        if (funcIdx >= 0) {
            lookupClass = this.funcClasses[funcIdx];
        }
        // Module-qualified global call (e.g. json_runtime.parse(raw)) parses as
        // a member call whose child(0) is the module identifier. When the
        // resolved function is a plain global function (no owning class), drop
        // that receiver so it isn't evaluated as argument 0.
        int argStart = 0;
        if (isModuleCall || (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && lookupClass == "")) {
            argStart = 1;
        }
        // UNIFIED_CORE_LIBRARY.md §4 rule 6 -- a resolved GLOBAL whose
        // parameter count does not accept the call's argument count must not
        // swallow a call whose name also resolves as an imported win32
        // export: re-clear funcIdx so the call falls through to the DLL
        // classification below (net.sr's bare connect/listen in module-
        // qualified form). argStart is known only here, so this is the
        // earliest point the check can use the module-qualified arg count.
        if (funcIdx >= 0 && lookupClass == "" && (this.win32CallResolves(name) || this.linuxCallResolves(name) || this.macCallResolves(name))) {
            int callArgs = call.childCount() - argStart;
            if (callArgs < 0) { callArgs = 0; }
            int pc = (funcIdx < this.funcParamCounts.length) ? this.funcParamCounts[funcIdx] : -1;
            if (pc < 0) {
                funcIdx = -1;
            } else {
                bool variadic = funcIdx < this.funcHasVariadic.length && this.funcHasVariadic[funcIdx] == 1;
                bool accepts;
                if (variadic) { accepts = callArgs >= pc - 1; } else { accepts = callArgs == pc; }
                if (!accepts) { funcIdx = -1; }
            }
        }
        if (funcIdx >= 0 && funcIdx < this.funcOffsets.length) {
            int targetOff = this.funcOffsets[funcIdx];
            int[] argRegs = [1, 2, 8, 9];
            int explicitArgs = call.childCount() - argStart;
            if (explicitArgs < 0) { explicitArgs = 0; }
            Node packedArg = null;
            int packIndex = -1;
            int totalArgs = explicitArgs;
            if (funcIdx < this.funcParamCounts.length) {
                int paramCount = this.funcParamCounts[funcIdx];
                int paramStart = this.funcParamStarts[funcIdx];
                bool variadicFn = funcIdx < this.funcHasVariadic.length && this.funcHasVariadic[funcIdx] == 1;
                int fixedCount = paramCount - 1;
                if (fixedCount < 0) { fixedCount = 0; }
                if (variadicFn && explicitArgs >= fixedCount) {
                    // Variadic tail: pack the trailing call-site arguments
                    // into a single array literal (DOCS/112).  Zero variadic
                    // arguments still pass an empty array.
                    Node arr = new Node(); arr.kind = 19;
                    for (int ai = fixedCount; ai < explicitArgs; ai++) {
                        arr.children.add(call.child(ai + argStart));
                    }
                    packedArg = arr;
                    packIndex = fixedCount;
                    explicitArgs = paramCount;
                    totalArgs = paramCount;
                }
                while (totalArgs < paramCount && totalArgs + paramStart < this.funcParamHasDefaults.length && this.funcParamHasDefaults[totalArgs + paramStart] == 1) {
                    totalArgs++;
                }
            }
            // A bare call to a static method (e.g. stringMethod(...) inside
            // BuiltinMethods) still uses the method ABI: RCX is the unused
            // `this` slot and the declared parameters follow in RDX/R8/R9.
            // Without the bias the arguments shift one register and corrupt
            // string/object parameters.
            bool staticMethodCall = lookupClass != "";
            int slotBias = 0;
            if (staticMethodCall) { slotBias = 1; }
            int slotTotal = totalArgs + slotBias;
            // LINUX SysV backend (additive): 6 register slots, no shadow.
            int callNreg = this.abiRegCount();
            int callBase = this.abiStackBase();
            int extraStack = 0;
            if (slotTotal > callNreg) { extraStack = (slotTotal - callNreg) * 8; }
            // LINUX: spills cover every slot, so reserve all of them (see
            // emitAbiCallSetup slack note).
            if (this.isLinuxTarget()) { extraStack = slotTotal * 8; }
            this.emitAbiCallSetup(extraStack);
            if (staticMethodCall) {
                this.asm.xorRR64(0, 0);
                this.asm.movMBaseR(4, 0, 0);
            }
            // Evaluate every argument into RAX and spill it to the shadow
            // space / stack-arg slots BEFORE loading the argument registers.
            // Spilling first is required: a nested call in a later argument
            // would otherwise clobber the volatile argument registers
            // (rcx/rdx/r8/r9) already holding earlier arguments.
            for (int i = 0; i < totalArgs; i++) {
                if (i < explicitArgs) {
                    if (packedArg != null && i == packIndex) {
                        this.genExpr(packedArg);
                    } else {
                        this.genExpr(call.child(i + argStart));
                    }
                } else if (funcIdx < this.funcParamStarts.length && this.funcParamStarts[funcIdx] + i < this.funcParamDefaults.length) {
                    this.genExpr(this.funcParamDefaults[this.funcParamStarts[funcIdx] + i]);
                } else {
                    this.asm.xorRR64(0, 0);
                }
                int slot = i + slotBias;
                if (slot < callNreg) {
                    this.asm.movMBaseR(4, 0, slot * 8);
                } else {
                    this.asm.movMBaseR(4, 0, callBase + (slot - callNreg) * 8);
                }
            }
            for (int i = 0; i < slotTotal && i < callNreg; i++) {
                if (this.isLinuxTarget()) {
                    this.asm.movRMBase(this.sysvRegAt(i), 4, i * 8);
                } else {
                    this.asm.movRMBase(argRegs[i], 4, i * 8);
                }
            }

            if (targetOff >= 0) {
                int callPos = this.asm.buf.length;
                int rel32 = targetOff - (callPos + 5);
                this.asm.callRel32(rel32);
            } else {
                this.asm.callRel32(0);
                this.forwardCalls.add(this.asm.buf.length - 4);
                this.forwardCallFuncIdxs.add(funcIdx);
                this.forwardCallNames.add(name);
                this.forwardCallClasses.add(lookupClass);
            }
            this.emitAbiCallTeardown();
            this.emitExcCheck();
            return;
        }
        // These helpers have an out-parameter internally and therefore cannot
        // use the ordinary four-register external-call path. Handle them
        // before argument marshalling so they pass a real POINT pointer.
        if (name == "GetCursorX") {
            this.genCursorXCall();
            this.emitExcCheck();
            return;
        } else if (name == "GetCursorY") {
            this.genCursorYCall();
            this.emitExcCheck();
            return;
        } else if (name == "GetCursorPos") {
            // GetCursorPos writes an 8-byte POINT (two int32 coordinates),
            // while Silver's `int pos[2]` is an array of 8-byte slots.  Do not
            // pass the array pointer directly: Win32 would write packed int32
            // values and the generated array reads would interpret the second
            // coordinate as part of the first slot.  Use a real POINT local,
            // then widen and copy both coordinates into the caller's array.
            this.genCursorPosCall(call, argStart);
            this.emitExcCheck();
            return;
        }
        // LINUX SysV backend (additive): a free-function call into a granted
        // linux module (linux.libc/libX11/libXtst) emits a self-contained
        // SysV import call through the ELF GOT here and returns (mirrors
        // silverc-rs routing linux.libc calls through its import-call
        // shape). It runs BEFORE the Win64 pre-spill below so no outer call
        // frame leaks. Unresolved names fall through to the win32 chain,
        // whose mapping still translates same-shape libc names; a
        // known-but-ungranted linux export is the same DOCS/213 error as its
        // win32 counterpart.
        if (this.isLinuxTarget()) {
            string linuxLib = this.linuxResolveLib(name);
            string linuxFn = name;
            string linuxAliasLib = this.linuxResolveAliasLib(name);
            if (linuxAliasLib.length > 0) {
                linuxLib = linuxAliasLib;
                linuxFn = this.linuxResolveExport(name);
            }
            if (linuxLib.length > 0) {
                if (!this.linuxAllowed(linuxLib, linuxFn)) {
                    printline("Error: linux function '" + name + "' used without importing its module (add: import * from linux." + this.linuxModuleOf(linuxLib) + ";)");
                    exit(1);
                    return;
                }
                this.genLinuxImportCall(call, argStart, linuxLib, linuxFn);
                this.emitExcCheck();
                return;
            }
            if (this.linuxKnownExport(name)) {
                printline("Error: linux function '" + name + "' used without importing its module (add: import * from linux." + this.linuxModuleOf(this.linuxBareLib(name)) + ";)");
                exit(1);
                return;
            }
        }
        // MAC AAPCS64 backend (additive, code-only): libSystem/objc calls ride
        // the mac grants (mirrors the linux block above). v1 records the bind
        // for the Mach-O emitter and returns: full X0-X7/V0-V7 + stub + GOT
        // emission is hardware-gated (s10), and the v1 Mach-O emitter ignores
        // bodies (fixed exit stub), so x64-regged emission here would be
        // discarded. Win64/SysV paths never observe isMacTarget()==true.
        if (this.isMacTarget()) {
            string macLib = this.macResolveLib(name);
            string macFn = name;
            for (int ma = 0; ma < this.macAliasLocals.length; ma++) {
                if (this.macAliasLocals[ma] == name) {
                    macLib = this.macAliasLibs[ma];
                    macFn = this.macAliasExports[ma];
                    break;
                }
            }
            if (macLib.length == 0) {
                string bare = this.macBareLib(name);
                if (bare.length > 0) { macLib = bare; macFn = name; }
            }
            if (macLib.length > 0) {
                if (!this.macAllowed(macLib, macFn)) {
                    printline("Error: mac function '" + name + "' used without importing its module (add: import * from mac." + this.macModuleOf(macLib) + ";)");
                    exit(1);
                    return;
                }
                this.findImport(macLib, macFn);
                this.asm.nop();
                this.emitExcCheck();
                return;
            }
            if (this.macKnownExport(name)) {
                printline("Error: mac function '" + name + "' used without importing its module (add: import * from mac." + this.macModuleOf(this.macBareLib(name)) + ";)");
                exit(1);
                return;
            }
        }
        int extArgCount = call.childCount() - argStart;
        // LINUX SysV backend (additive): 6 register slots, no shadow. The
        // WINDOWS counts below are unchanged; the bridge teardowns below
        // pair with either setup (teardown is shared).
        int extNreg = this.abiRegCount();
        int extBase = this.abiStackBase();
        int extStack = 0;
        if (extArgCount > extNreg) { extStack = (extArgCount - extNreg) * 8; }
        // LINUX: spills cover every argument, so reserve all of them.
        if (this.isLinuxTarget()) { extStack = extArgCount * 8; }
        // MAC: same spill cover (8 AAPCS regs); full X0-X7 lowering is gated,
        // v1 bodies are discarded by the Mach-O emitter, so this only keeps
        // the buffer monotonic on the MAC path.
        if (this.isMacTarget()) { extStack = extArgCount * 8; }
        this.emitAbiCallSetup(extStack);
        int[] argRegs2 = [1, 2, 8, 9];
        int nargs2 = extArgCount;
        if (nargs2 > extNreg) { nargs2 = extNreg; }
        // Spill every argument to the shadow space / stack slots before
        // loading the argument registers (nested calls clobber volatile regs).
        for (int i = 0; i < extArgCount; i++) {
            this.genExpr(call.child(i + argStart));
            if (i < extNreg) {
                this.asm.movMBaseR(4, 0, i * 8);
            } else {
                // Win64: args 5+ go at [rsp+32], [rsp+40], ... (same layout as
                // internal function calls above). Storing instead of pushing keeps
                // the argument order correct (pushing reversed the order).
                this.asm.movMBaseR(4, 0, extBase + (i - extNreg) * 8);
            }
        }
        for (int i = 0; i < nargs2; i++) {
            if (this.isLinuxTarget()) {
                this.asm.movRMBase(this.sysvRegAt(i), 4, i * 8);
            } else {
                this.asm.movRMBase(argRegs2[i], 4, i * 8);
            }
        }
        // DOCS/247 — nativeToastShow is a synthetic bridge that the silverc-rs
        // codegen translates into real Win32 DLL calls.  In the self-hosted
        // backend it is a no-op: notifications.sr `show` already printed the
        // canonical NOTIFY: parity line, so just return 0 and let the caller
        // continue.
        if (name == "nativeToastShow") {
            this.asm.xorRR64(0, 0);
            this.asm.emitCallTeardown();
            return;
        }
        // DOCS/249 -- system tray icon bridges. silverc-rs emits the real
        // shell32!Shell_NotifyIconA + NOTIFYICONDATAA sequence for these; in
        // the self-hosted backend they are no-ops (return 0) so the
        // TrayIcon class in std/system_tray.sr links and runs without a
        // native tray shell.
        if (name == "trayAdd" || name == "traySetTooltip" || name == "trayDelete" || name == "trayRemove" || name == "traySetMenu" || name == "trayRunLoop" || name == "trayPollMenu" || name == "trayPollClick") {
            this.asm.xorRR64(0, 0);
            this.asm.emitCallTeardown();
            return;
        }
        // DOCS/250 -- Windows registry bridges. silverc-rs emits the real
        // advapi32 Reg* sequence for these; the self-hosted backend links them
        // as no-ops so the RegistryKey class in std/registry.sr compiles and
        // runs anywhere. String-returning bridges yield the empty string;
        // everything else returns 0.
        if (name == "regGetString" || name == "regEnumSubKeyName" || name == "regEnumValueName") {
            int strIdx = this.addString("");
            int sp = this.asm.buf.length;
            this.asm.emitImm64(0, 0);
            this.stringPatchOffsets.add(sp + 2);
            this.stringPatchIndices.add(strIdx);
            this.asm.emitCallTeardown();
            return;
        }
        if (name == "regOpen" || name == "regCreate" || name == "regClose" || name == "regSubKey" || name == "regSetString" || name == "regGetInt" || name == "regSetInt" || name == "regGetInt64" || name == "regSetInt64" || name == "regDeleteValue" || name == "regDeleteKey" || name == "regValueExists" || name == "regSubKeyCount" || name == "regValueCount") {
            this.asm.xorRR64(0, 0);
            this.asm.emitCallTeardown();
            return;
        }
        // DOCS/248 -- bare window-GUI bridges (guiCreateWindow/guiShow/... and
        // loadIcon). silverc-rs emits the real user32 sequence for these; the
        // self-hosted backend's std/gui.sr drives user32 directly instead, so
        // these names have no source-level caller in this checkout. They are
        // still routed here (instead of falling into the internal forward-call
        // path) so a program written against silverc-rs/std/gui.sr compiles
        // deterministically: every bridge yields 0, which the Window class
        // guards treat as "no window".
        if (name == "guiCreateWindow" || name == "guiShow" || name == "guiHide" || name == "guiMaximize" || name == "guiMinimize" || name == "guiSetTitle" || name == "guiClose" || name == "guiRunLoop" || name == "guiSetIcon" || name == "loadIcon") {
            this.asm.xorRR64(0, 0);
            this.asm.emitCallTeardown();
            return;
        }
        // Private interpreter bridge (silveri/src/builtins.sr): silverc-rs
        // serializes foreground-process metadata as
        // path\x1ffilename\x1ftitle\x1fpid\x1fwindowHandle. The self-hosted
        // backend has no consumer for that contract today; return the empty
        // string so the call site never lands on the unpatched forward-call
        // path with a garbage pointer.
        if (name == "getFocusedProcessDataNative") {
            int strIdx = this.addString("");
            int sp = this.asm.buf.length;
            this.asm.emitImm64(0, 0);
            this.stringPatchOffsets.add(sp + 2);
            this.stringPatchIndices.add(strIdx);
            this.asm.emitCallTeardown();
            return;
        }
        // std/os.sr defines `osType()` as plain Silver, but the `os` module
        // is builtin-reserved in the self-hosted compiler, so its source is
        // never collected; the backend provides the native os.type contract:
        // the compile-time constant OSTypes.WINDOWS (0) on this Windows-only
        // backend.
        if (name == "osType") {
            // LINUX SysV backend (additive): OSTypes.LINUX (1) on the Linux
            // target; OSTypes.WINDOWS (0) otherwise (unchanged).
            // MAC AAPCS64 backend (additive, code-only): OSTypes.DARWIN (2)
            // on the MAC target (MAC.md 1b, value 2, order untouched).
            if (this.isMacTarget()) {
                this.asm.movRI64(0, 2);
            } else if (this.isLinuxTarget()) {
                this.asm.movRI64(0, 1);
            } else {
                this.asm.xorRR64(0, 0);
            }
            this.asm.emitCallTeardown();
            return;
        }
        bool isWin32 = false;
        string win32Dll = "";
        if (name == "FindFirstFileA" || name == "FindNextFileA" || name == "FindClose" || name == "GetFileTime" || name == "DeleteFileA" || name == "MoveFileA" || name == "GetFileAttributesA" || name == "CreateDirectoryA" || name == "RemoveDirectoryA" || name == "SetCurrentDirectoryA" || name == "CreateProcessA" || name == "WaitForSingleObject" || name == "GetStdHandle" || name == "SetConsoleTextAttribute" || name == "GetConsoleScreenBufferInfo" || name == "SetConsoleCursorPosition" || name == "GetModuleHandleA" || name == "LoadLibraryA" || name == "GetProcAddress" || name == "Sleep" || name == "GetTickCount" || name == "GetLastError" || name == "GetCurrentDirectoryA" || name == "WriteConsoleA" || name == "ReadConsoleA" || name == "GetConsoleMode" || name == "SetConsoleMode" || name == "CreatePipe" || name == "GetExitCodeProcess" || name == "CreateFileA" || name == "GetFileSize" || name == "ReadFile" || name == "WriteFile" || name == "CloseHandle" || name == "GetFileAttributesW" || name == "SetFilePointer" || name == "GetCurrentProcessId" || name == "GetCurrentProcess" || name == "GetCurrentThreadId" || name == "GetCurrentThread" || name == "GetEnvironmentVariableA" || name == "GetEnvironmentVariableW" || name == "SetEnvironmentVariableA" || name == "SetEnvironmentVariableW" || name == "ExpandEnvironmentStringsA" || name == "GetEnvironmentStringsA" || name == "FreeEnvironmentStringsA" || name == "GetTempPathA" || name == "GetComputerNameA" || name == "CopyFileA" || name == "SetFileAttributesA" || name == "GetFullPathNameA" || name == "GetModuleFileNameA" || name == "QueryPerformanceCounter" || name == "QueryPerformanceFrequency" || name == "GetTickCount64" || name == "TerminateProcess" || name == "OpenProcess" || name == "GetProcessId" || name == "FlushFileBuffers" || name == "GetFileSizeEx" || name == "CreateProcessW" || name == "CreateProcess" || name == "GetVersionExA" || name == "GetSystemDirectoryA" || name == "GetWindowsDirectoryA" || name == "GetLocalTime" || name == "GetSystemTime" || name == "OutputDebugStringA" || name == "IsDebuggerPresent" || name == "GetCommandLineA" || name == "GlobalAlloc" || name == "GlobalFree" || name == "VirtualAlloc" || name == "VirtualFree" || name == "HeapFree" || name == "GetProcessHeap" || name == "lstrlenA" || name == "lstrcpyA" || name == "lstrcatA" || name == "lstrcmpA" || name == "SetThreadPriority" || name == "QueryFullProcessImageNameA" || name == "GetSystemInfo" || name == "GlobalMemoryStatusEx" || name == "GetDiskFreeSpaceExA" || name == "GetUserDefaultUILanguage") {
            isWin32 = true;
            win32Dll = "kernel32.dll";
        } else if (name == "RegOpenKeyExA" || name == "RegQueryValueExA" || name == "RegCloseKey" || name == "GetUserNameA") {
            // advapi32 names the
            // std modules call as plain bare functions (the registry backend,
            // and sysinfo's cpuModel/username readers). GetUserNameA is
            // classified here, not kernel32: kernel32.dll does not export it
            // (its home is advapi32.dll), so an exe importing it from
            // kernel32 dies at load with STATUS_ENTRYPOINT_NOT_FOUND.
            isWin32 = true;
            win32Dll = "advapi32.dll";
        } else if (name == "GetFileVersionInfoSizeA" || name == "GetFileVersionInfoA" || name == "VerQueryValueA") {
            // DOCS/251 -- Windows VERSIONINFO APIs live in version.dll.
            isWin32 = true;
            win32Dll = "version.dll";
        } else if (name == "memcpy" || name == "memset" || name == "memmove" || name == "memcmp" || name == "strlen" || name == "strcmp" || name == "strchr" || name == "strstr" || name == "strrchr" || name == "strcpy" || name == "strcat" || name == "strncmp" || name == "strncat" || name == "strncpy" || name == "strcat" || name == "strtok" || name == "strpbrk" || name == "strspn" || name == "strcspn" || name == "atoi" || name == "atol" || name == "atoll" || name == "strtol" || name == "strtoll" || name == "malloc" || name == "free" || name == "realloc" || name == "calloc" || name == "printf" || name == "fprintf" || name == "sprintf" || name == "sscanf" || name == "fopen" || name == "fclose" || name == "fread" || name == "fwrite" || name == "fflush" || name == "fgets" || name == "fputs" || name == "fseek" || name == "ftell" || name == "system" || name == "getenv" || name == "putenv" || name == "time" || name == "rand" || name == "srand" || name == "abs" || name == "labs" || name == "toupper" || name == "tolower" || name == "isalpha" || name == "isdigit" || name == "isspace" || name == "isprint" || name == "isalnum" || name == "isxdigit" || name == "isupper" || name == "islower") {
            isWin32 = true;
            win32Dll = "msvcrt.dll";
        } else if (name == "socket" || name == "bind" || name == "listen" || name == "accept" || name == "recv" || name == "send" || name == "closesocket" || name == "setsockopt" || name == "WSAStartup" || name == "WSACleanup" || name == "htons" || name == "inet_addr" || name == "getaddrinfo" || name == "freeaddrinfo" || name == "ioctlsocket" || name == "select" || name == "connect" || name == "shutdown" || name == "WSAGetLastError") {
            isWin32 = true;
            win32Dll = "ws2_32.dll";
        } else if (name == "InternetOpenA" || name == "InternetConnectA" || name == "InternetOpenUrlA" || name == "InternetReadFile" || name == "InternetReadFileExA" || name == "InternetCloseHandle" || name == "HttpSendRequestA" || name == "HttpSendRequestExA" || name == "InternetQueryDataAvailable" || name == "InternetSetOptionA" || name == "InternetQueryOptionA" || name == "HttpQueryInfoA" || name == "InternetWriteFile" || name == "InternetGetConnectedState" || name == "InternetCrackUrlA" || name == "InternetCanonicalizeUrlA" || name == "InternetSetStatusCallback") {
            isWin32 = true;
            win32Dll = "wininet.dll";
        } else if (name == "ShellExecuteA" || name == "ShellExecuteW" || name == "ShellExecuteExA" || name == "ShellExecuteExW") {
            isWin32 = true;
            win32Dll = "shell32.dll";
        } else if (name == "WinHttpOpen" || name == "WinHttpConnect" || name == "WinHttpOpenRequest" || name == "WinHttpSendRequest" || name == "WinHttpReceiveResponse" || name == "WinHttpReadData" || name == "WinHttpCloseHandle" || name == "WinHttpQueryHeaders" || name == "WinHttpQueryDataAvailable" || name == "WinHttpSetOption") {
            isWin32 = true;
            win32Dll = "winhttp.dll";
        } else if (name == "keybd_event" || name == "VkKeyScanA" || name == "GetKeyState" || name == "GetAsyncKeyState" || name == "GetKeyboardState" || name == "SetKeyboardState" || name == "MapVirtualKeyA" || name == "SendInput") {
            // Win32 keyboard - user32.dll (DOCS/229, mirrors silverc-rs
            // keyboard.rs + the user32 dispatcher added later).
            isWin32 = true;
            win32Dll = "user32.dll";
        } else if (name == "mouse_event" || name == "GetCursorPos" || name == "GetCursorX" || name == "GetCursorY" || name == "SetCursorPos" || name == "SetCursor" || name == "ClipCursor" || name == "GetClipCursor" || name == "GetDoubleClickTime" || name == "SetDoubleClickTime" || name == "GetForegroundWindow" || name == "GetWindowTextA" || name == "GetWindowThreadProcessId") {
            // Win32 mouse / cursor - same user32.dll but a distinct elif so
            // the keyboard importer above cannot silently absorb a typo, and
            // so mouse-specific extensions (SetCursor, ClipCursor) can be
            // added without touching the keyboard list.
            isWin32 = true;
            win32Dll = "user32.dll";
        } else if (name == "RegisterHotKey" || name == "UnregisterHotKey" || name == "MessageBeep" || name == "RegisterRawInputDevices" || name == "GetRawInputData" || name == "GetRawInputDeviceList") {
            // Hotkeys + raw input on user32.dll. Kept separate from the
            // keyboard / mouse sections so future raw-input work can land in
            // its own block.
            isWin32 = true;
            win32Dll = "user32.dll";
        } else if (name == "RegisterClassExA" || name == "CreateWindowExA" || name == "ShowWindow" || name == "UpdateWindow" || name == "SetWindowTextA" || name == "DestroyWindow" || name == "GetMessageA" || name == "TranslateMessage" || name == "DispatchMessageA" || name == "DefWindowProcA" || name == "PostQuitMessage" || name == "GetSystemMetrics" || name == "LoadIconA" || name == "LoadCursorA" || name == "LoadImageA" || name == "SendMessageA") {
            // DOCS/248 -- window GUI on user32.dll. The Window class in
            // std/gui.sr calls these directly; the generic dispatcher emits
            // the IAT call with the arguments spilled in Win64 order.
            isWin32 = true;
            win32Dll = "user32.dll";
        }
        // DOCS/261 custom fallback (additive, fixed chain above untouched):
        // plain custom grants answer by local name on both targets (mirroring
        // silverc-rs where win32::resolve and linux::resolve both run
        // regardless of `--os`). Fixed behavior is byte-identical when no
        // custom is declared (both resolvers return "").
        if (!isWin32) {
            string custWin = this.win32CustomResolveDll(name);
            if (custWin.length > 0) {
                isWin32 = true;
                win32Dll = custWin;
            } else {
                string custLin = this.linuxCustomResolveLibUngated(name);
                if (custLin.length > 0) {
                    isWin32 = true;
                    win32Dll = custLin;
                }
            }
        }
        // kernel32 exports CreateProcessA/CreateProcessW, never bare
        // CreateProcess (that spelling exists only as a C macro).  Map it to
        // the ANSI import so source like std/process.sr links and runs.
        string importName = name;
        if (name == "CreateProcess") { importName = "CreateProcessA"; }
        // Aliased win32 grants. Resolution
        // order mirrors silverc-rs win32::resolve: full-DLL tables and plain
        // single-export grants answer first, aliased grants second, matched
        // by the LOCAL call name only. The PE import keeps the real export,
        // so aliasing one export never grants the rest of the DLL.
        // DOCS/261: custom linux aliases answer here too so prefixed linux
        // customs emit on WINDOWS targets (PE with .so NEEDED, Win64 ABI).
        bool plainWin32Allowed = false;
        if (isWin32) {
            plainWin32Allowed = this.win32Allowed(win32Dll, importName);
            // DOCS/261: win32Dll may actually be a linux lib for custom linux
            // plain grants on WINDOWS targets (PE with .so NEEDED). Fixed
            // behavior unchanged (linuxAllowed is false for fixed win dlls).
            if (!plainWin32Allowed) {
                if (this.linuxAllowed(win32Dll, importName)) { plainWin32Allowed = true; }
            }
        }
        string aliasDll = "";
        string aliasExport = "";
        if (!plainWin32Allowed) {
            for (int g = 0; g < this.win32AliasLocals.length; g++) {
                if (this.win32AliasLocals[g] == name) {
                    aliasDll = this.win32AliasDlls[g];
                    aliasExport = this.win32AliasExports[g];
                }
            }
            if (aliasDll.length == 0) {
                for (int a2 = 0; a2 < this.linuxAliasLocals.length; a2++) {
                    if (this.linuxAliasLocals[a2] == name) {
                        aliasDll = this.linuxAliasLibs[a2];
                        aliasExport = this.linuxAliasExports[a2];
                    }
                }
            }
        }
        if (isWin32) {
            if (!plainWin32Allowed) {
                if (aliasDll.length > 0) {
                    // LINUX: pre-spilled args are already SysV (see above),
                    // so record Direct (no shuffle). WINDOWS unchanged.
                    if (this.isLinuxTarget()) {
                        this.addImportPatchDirect(aliasDll, aliasExport);
                    } else {
                        this.addImportPatch(aliasDll, aliasExport);
                    }
                    this.asm.emitImm64(0, 0);
                    this.asm.movRMBase(0, 0, 0);
                    this.asm.callR64(0);
                    this.emitAbiCallTeardown();
                    return;
                }
                // DOCS/213 -- the owning win32 module was not imported.
                printline("Error: Win32 function '" + name + "' used without importing its module (add: import * from win32." + this.win32ModuleOf(win32Dll) + ";)");
                exit(1);
            }
            // LINUX: Direct (regs already SysV); the mapping still
            // translates same-shape libc names. WINDOWS unchanged.
            if (this.isLinuxTarget()) {
                this.addImportPatchDirect(win32Dll, importName);
            } else {
                this.addImportPatch(win32Dll, importName);
            }
            this.asm.emitImm64(0, 0);
            this.asm.movRMBase(0, 0, 0);
            this.asm.callR64(0);
        } else if (aliasDll.length > 0) {
            if (this.isLinuxTarget()) {
                this.addImportPatchDirect(aliasDll, aliasExport);
            } else {
                this.addImportPatch(aliasDll, aliasExport);
            }
            this.asm.emitImm64(0, 0);
            this.asm.movRMBase(0, 0, 0);
            this.asm.callR64(0);
        } else {
            this.asm.callRel32(0);

            this.forwardCalls.add(this.asm.buf.length - 4);
            this.forwardCallFuncIdxs.add(-1);
            this.forwardCallNames.add(name);
            this.forwardCallClasses.add("");
        }
        this.emitAbiCallTeardown();
    }

    public bool isThisAsmMember(Node call) {
        if (call.childCount() < 1) { return false; }
        Node recv = call.child(0);
        if (recv.kind != 13) { return false; }
        Node recvObj = recv.child(0);
        if (recvObj.kind != 6) { return false; }
        if (recvObj.name != "this") { return false; }
        if (recv.name != "asm") { return false; }
        return true;
    }

    public bool isUserClassMemberCall(Node call) {
        if (call.childCount() < 1) { return false; }
        Node recv = call.child(0);
        // A receiver that is a bare class name is a STATIC method call
        // (e.g. BuiltinMethods.callMethod / Foo.greet). It must use the
        // method ABI (this in RCX, params in RDX/R8/R9) like an instance
        // call; treating it as a module call would shift every argument one
        // register and corrupt string/object parameters.
        if (recv.kind == 6) {
            for (int i = 0; i < this.classNames.length; i++) {
                if (this.classNames[i] == recv.name) { return true; }
            }
        }
        string recvClass = this.inferExprType(recv);
        for (int i = 0; i < this.classNames.length; i++) {
            if ((this.classNames[i] == recvClass || recvClass == this.classNames[i] + "?")) { return true; }
        }
        return false;
    }

    public void genDynamicAsmCall(Node call) {
        string name = call.name;
        int funcIdx = -1;
        for (int i = 0; i < this.funcNames.length; i++) {
            if (this.funcNames[i] == name && this.funcClasses[i] == "MiniAsm") {
                funcIdx = i;
            }
        }
        if (funcIdx < 0) { return; }

        bool savedDynamicAsmActive = this.dynamicAsmActive;
        this.dynamicAsmActive = true;
        int recvOff = this.allocLocal("__asm_recv");
        this.genExpr(call.child(0));
        this.asm.movMBaseR(5, 0, recvOff);
        int[] argTemps = [];
        for (int i = 1; i < call.childCount(); i++) {
            this.genExpr(call.child(i));
            int argOff = this.allocLocal("__asm_arg");
            this.asm.movMBaseR(5, 0, argOff);
            argTemps.add(argOff);
        }

        int explicitCount = argTemps.length;
        // LINUX SysV backend (additive): the receiver rides RDI with five
        // following register slots (RSI/RDX/RCX/R8/R9), stack at [RSP+0].
        int dynSlots = explicitCount + 1;
        int dynNreg = this.abiRegCount();
        int dynBase = this.abiStackBase();
        int extraStack = 0;
        if (dynSlots > dynNreg) { extraStack = (dynSlots - dynNreg) * 8; }
        this.emitAbiCallSetup(extraStack);
        int dynRecvReg = 1;
        if (this.isLinuxTarget()) { dynRecvReg = 7; }
        this.asm.movRMBase(dynRecvReg, 5, recvOff);
        int[] argRegs = [2, 8, 9];
        for (int i = 0; i < explicitCount; i++) {
            if (i + 1 < dynNreg) {
                if (this.isLinuxTarget()) {
                    this.asm.movRMBase(this.sysvRegAt(i + 1), 5, argTemps[i]);
                } else {
                    this.asm.movRMBase(argRegs[i], 5, argTemps[i]);
                }
            } else {
                this.asm.movRMBase(0, 5, argTemps[i]);
                this.asm.movMBaseR(4, 0, dynBase + (i + 1 - dynNreg) * 8);
            }
        }
        int targetOff = this.funcOffsets[funcIdx];
        if (targetOff >= 0) {
            int callPos = this.asm.buf.length;
            int rel32 = targetOff - (callPos + 5);
            this.asm.callRel32(rel32);
        } else {
            this.asm.callRel32(0);
            this.forwardCalls.add(this.asm.buf.length - 4);
            this.forwardCallFuncIdxs.add(-1);
            this.forwardCallNames.add(name);
            this.forwardCallClasses.add("MiniAsm");
        }
        this.emitAbiCallTeardown();
        this.dynamicAsmActive = savedDynamicAsmActive;
    }

    public bool isBuiltinMemberCall(Node call) {
        if (!call.isMember || call.childCount() < 1) { return false; }
        string name = call.name;
        string recvType = this.inferExprType(call.child(0));
        if (name == "toString") {
            if (recvType == "string" || recvType == "char" || recvType == "int" || recvType == "int32" || recvType == "int64" || recvType == "uint" || recvType == "bool" || recvType == "float64") {
                return true;
            }
        }
        // Primitive no-op casts: toInt/toInt64/toNumber on integral/char/bool

        // receivers and toFloat/toFloat64 on float receivers lower to a bare
        // reload of the operand. Without this, `idx.toInt().toInt()` (common in
        // silveri) routed through genUserCall and corrupted RAX when the
        // receiver was itself a call expression.
        if (name == "toInt" || name == "toInt64" || name == "toNumber") {
            if (recvType == "int" || recvType == "int32" || recvType == "int64" || recvType == "bool" || recvType == "char") {
                return true;
            }
        }
        if (name == "toFloat" || name == "toFloat64") {
            if (recvType == "float" || recvType == "float64"
                || recvType == "int" || recvType == "int32" || recvType == "int64"
                || recvType == "uint" || recvType == "bool" || recvType == "char") {
                return true;
            }
        }
        if (recvType == "string") {
            if (name == "contains" || name == "trim" || name == "trimEnd" || name == "trimStart" || name == "trimLeft" || name == "trimRight" || name == "split" || name == "lines" || name == "startsWith" || name == "endsWith" || name == "indexOf" || name == "find" || name == "substr" || name == "substring" || name == "toLower" || name == "lower" || name == "toUpper" || name == "upper" || name == "replace" || name == "pad" || name == "padLeft" || name == "padRight" || name == "slugify" || name == "length" || name == "toInt64" || name == "toInt" || name == "toNumber" || name == "toBytes") {
                return true;
            }
        }
        if (recvType == "char") {
            if (name == "isDigit" || name == "isAlpha" || name == "isAlphaNum" || name == "isLower" || name == "isUpper" || name == "isWhiteSpace") {
                return true;
            }
        }
        return false;
    }

    public void genBuiltinMemberCall(Node call) {
        Node recv = call.child(0);
        string name = call.name;
        string recvType = this.inferExprType(recv);
        if (name == "toString") {
            if (recvType == "string") {
                this.genExpr(recv);
            } else if (this.isCharExpr(recv)) {
                this.genCharToString(recv);
            } else if (recvType == "float" || recvType == "float64" || recvType == "double") {
                this.genFloatToString(recv);
            } else if (call.childCount() >= 2 && call.child(1).kind == 2) {
                this.genIntToStringRadix(recv, call.child(1).strVal);
            } else {
                this.genIntToString(recv);
            }
            return;
        }
        if (name == "toInt" || name == "toInt64" || name == "toNumber") {
            if (recvType == "int" || recvType == "int32" || recvType == "int64" || recvType == "bool" || recvType == "char") {
                this.genExpr(recv);
                return;
            }
        }
        if (name == "toFloat" || name == "toFloat64") {
            if (recvType == "float" || recvType == "float64") {
                this.genExpr(recv);
                return;
            }
            if (recvType == "int" || recvType == "int32" || recvType == "int64" || recvType == "uint" || recvType == "bool" || recvType == "char") {
                // int -> double: 64-bit cvtsi2sd xmm0, rax (see
                // emitCvtsi2sdRax) then movq rax, xmm0.
                this.genExpr(recv);
                this.emitCvtsi2sdRax();
                this.asm.movqR64XMM(0, 0);
                return;
            }
        }
        if (name == "length") {
            // string.length() - call form of the .length field access.
            this.genExpr(recv);
            this.asm.movRR64(1, 0);
            this.addImportPatch("ucrtbase.dll", "strlen");
            int sLenM = 0xDEADBEEFCAFEBAC1;
            this.asm.emitImm64(0, sLenM);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            return;
        }
        if (name == "toBytes") {
            // string.toBytes(): one byte of the NUL-terminated source per
            // element. Mirrors the silverc-rs emitter's semantics, lowered to
            // the self-host's dynamic byte[] layout (capacity qword at +0,
            // length qword at +8, element bytes from +16, array value =
            // alloc+16, bounds check reads length at ptr[-8]).
            this.genExpr(recv);
            int tbRecv = this.allocLocal("__tb_recv");
            this.asm.movMBaseR(5, 0, tbRecv);
            // RAX = strlen(recv)
            this.asm.movRMBase(1, 5, tbRecv);
            this.addImportPatch("ucrtbase.dll", "strlen");
            int tbSL = 0xDEADBEEFCAFEBAD1;
            this.asm.emitImm64(0, tbSL);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            int tbLen = this.allocLocal("__tb_len");
            this.asm.movMBaseR(5, 0, tbLen);
            // capacity = max(len, 8), mirroring the dynamic new-array lowering
            int tbCap = this.allocLocal("__tb_cap");
            int tbGe8 = this.newLabel();
            int tbCapDone = this.newLabel();
            this.asm.movRMBase(0, 5, tbLen);
            this.asm.cmpRI32(0, 8);
            this.asm.jgeLabel(tbGe8);
            this.asm.movRI64(0, 8);
            this.asm.jmpLabel(tbCapDone);
            this.asm.bindLabel(tbGe8);
            this.asm.movRMBase(0, 5, tbLen);
            this.asm.bindLabel(tbCapDone);
            this.asm.movMBaseR(5, 0, tbCap);
            // size = (cap + 2) * 8 in RCX; alloc via malloc (same import path
            // as the substr/string-repeat lowerings).
            this.asm.movRMBase(0, 5, tbCap);
            this.asm.addRI32(0, 2);
            this.asm.shlR64Imm(0, 3);
            this.asm.movRR64(1, 0);
            this.addImportPatch("msvcrt.dll", "malloc");
            int tbMA = 0xDEADBEEFCAFEBADE;
            this.asm.emitImm64(0, tbMA);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            int tbHdr = this.allocLocal("__tb_hdr");
            this.asm.movMBaseR(5, 0, tbHdr);
            // header: capacity at +0, length at +8
            this.asm.movRMBase(1, 5, tbCap);
            this.asm.movRMBase(0, 5, tbHdr);
            this.asm.movMBaseR(0, 1, 0);
            this.asm.movRMBase(1, 5, tbLen);
            this.asm.movRMBase(0, 5, tbHdr);
            this.asm.movMBaseR(0, 1, 8);
            // fill loop: byte [hdr + 16 + i] = src[i] for i < len
            int tbI = this.allocLocal("__tb_i");
            this.asm.xorRR64(0, 0);
            this.asm.movMBaseR(5, 0, tbI);
            int tbLoop = this.newLabel();
            int tbEnd = this.newLabel();
            this.asm.bindLabel(tbLoop);
            this.asm.movRMBase(0, 5, tbI);
            this.asm.movRMBase(2, 5, tbLen);
            this.asm.cmpRR64(0, 2);
            this.asm.jgeLabel(tbEnd);
            // RCX = movzx byte [src + i]
            this.asm.movRMBase(1, 5, tbRecv);
            this.asm.movRMBase(0, 5, tbI);
            this.asm.addRR64(1, 0);
            this.asm.movzxByteMBase(1, 1, 0);
            // byte [hdr + 16 + i] = CL
            this.asm.movRMBase(0, 5, tbHdr);
            this.asm.addRI32(0, 16);
            this.asm.movRMBase(2, 5, tbI);
            this.asm.addRR64(0, 2);
            this.asm.movMBaseByteR(0, 1, 0);
            this.asm.movRMBase(0, 5, tbI);
            this.asm.incR64(0);
            this.asm.movMBaseR(5, 0, tbI);
            this.asm.jmpLabel(tbLoop);
            this.asm.bindLabel(tbEnd);
            // RAX = data base (element 0) = hdr + 16
            this.asm.movRMBase(0, 5, tbHdr);
            this.asm.addRI32(0, 16);
            return;
        }
        if (name == "contains") {
            if (call.childCount() < 2) { this.asm.xorRR64(0, 0); return; }
            int recvOff = this.allocLocal("__contains_recv");
            this.genExpr(recv);
            this.asm.movMBaseR(5, 0, recvOff);
            this.genExpr(call.child(1));
            this.asm.movRR64(2, 0);
            this.asm.movRMBase(1, 5, recvOff);
            this.addImportPatch("ucrtbase.dll", "strstr");
            int sContains = 0xDEADBEEFCAFEBAD7;
            this.asm.emitImm64(0, sContains);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            int notFound = this.newLabel();
            int containsDone = this.newLabel();
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(notFound);
            this.asm.movRI64(0, 1);
            this.asm.jmpLabel(containsDone);
            this.asm.bindLabel(notFound);
            this.asm.xorRR64(0, 0);
            this.asm.bindLabel(containsDone);
            return;
        }
        if (name == "toInt64" || name == "toInt" || name == "toNumber") {
            // Convert a string to an integer via strtoll().  When no digit is
            // consumed (endptr still points at the original string) the input
            // is not numeric and a FormatException is thrown.
            if (call.childCount() < 1) { this.asm.xorRR64(0, 0); return; }
            this.genExpr(recv);

            int toStrOff = this.allocLocal("__toint_str");
            this.asm.movMBaseR(5, 0, toStrOff);
            int toEndOff = this.allocLocal("__toint_end");
            this.asm.movRR64(1, 0);
            this.asm.leaRBase(2, 5, toEndOff);
            this.asm.movRI64(8, 10);
            this.addImportPatch("ucrtbase.dll", "strtoll");
            int sToI = 0xDEADBEEFCAFEBAD3;
            this.asm.emitImm64(0, sToI);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            int toOk = this.newLabel();
            this.asm.movRMBase(1, 5, toEndOff);
            this.asm.movRMBase(2, 5, toStrOff);
            this.asm.cmpRR64(1, 2);
            this.asm.jneLabel(toOk);
            this.emitThrowException("invalid number format");
            this.asm.bindLabel(toOk);
            return;
        }
        if (name == "trim" || name == "trimEnd" || name == "trimRight" || name == "trimStart" || name == "trimLeft") {
            int tMode = 0;
            if (name == "trim") { tMode = 2; }
            else if (name == "trimStart" || name == "trimLeft") { tMode = 1; }
            if (call.childCount() >= 2) {
                this.genTrimCore(recv, call.child(1), 1, tMode);
            } else {
                this.genTrimCore(recv, call.child(0), 0, tMode);
            }
            return;
        }
        if (name == "startsWith") {
            if (call.childCount() < 2) { this.asm.xorRR64(0, 0); return; }
            int swRecv = this.allocLocal("__starts_recv");
            int swPrefix = this.allocLocal("__starts_prefix");
            int swRecvLen = this.allocLocal("__starts_recv_len");
            int swPrefixLen = this.allocLocal("__starts_prefix_len");
            int swI = this.allocLocal("__starts_i");
            this.genExpr(recv);
            this.asm.movMBaseR(5, 0, swRecv);
            this.genExpr(call.child(1));
            this.asm.movMBaseR(5, 0, swPrefix);

            this.asm.movRMBase(1, 5, swRecv);
            this.addImportPatch("ucrtbase.dll", "strlen");
            int sSwLen1 = 0xDEADBEEFCAFEBAD9;
            this.asm.emitImm64(0, sSwLen1);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, swRecvLen);

            this.asm.movRMBase(1, 5, swPrefix);
            this.addImportPatch("ucrtbase.dll", "strlen");
            int sSwLen2 = 0xDEADBEEFCAFEBADA;
            this.asm.emitImm64(0, sSwLen2);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, swPrefixLen);

            int swFalse = this.newLabel();
            int swLoop = this.newLabel();
            int swTrue = this.newLabel();
            int swDone = this.newLabel();
            this.asm.movRMBase(0, 5, swPrefixLen);
            this.asm.movRMBase(1, 5, swRecvLen);
            this.asm.cmpRR64(0, 1);
            this.asm.jgLabel(swFalse);
            this.asm.xorRR64(0, 0);
            this.asm.movMBaseR(5, 0, swI);
            this.asm.bindLabel(swLoop);
            this.asm.movRMBase(0, 5, swI);
            this.asm.movRMBase(1, 5, swPrefixLen);
            this.asm.cmpRR64(0, 1);
            this.asm.jgeLabel(swTrue);
            this.asm.movRMBase(11, 5, swI);
            this.asm.movRMBase(0, 5, swRecv);
            this.asm.addRR64(0, 11);
            this.asm.movzxByteMBase(0, 0, 0);
            this.asm.movRR64(1, 0);
            this.asm.movRMBase(0, 5, swPrefix);
            this.asm.addRR64(0, 11);
            this.asm.movzxByteMBase(0, 0, 0);
            this.asm.cmpRR64(0, 1);
            this.asm.jneLabel(swFalse);
            this.asm.movRMBase(0, 5, swI);
            this.asm.addRI32(0, 1);
            this.asm.movMBaseR(5, 0, swI);
            this.asm.jmpLabel(swLoop);
            this.asm.bindLabel(swTrue);
            this.asm.movRI64(0, 1);
            this.asm.jmpLabel(swDone);
            this.asm.bindLabel(swFalse);
            this.asm.xorRR64(0, 0);
            this.asm.bindLabel(swDone);

            return;
        }
        if (name == "endsWith") {
            if (call.childCount() < 2) { this.asm.xorRR64(0, 0); return; }
            int ewRecv = this.allocLocal("__ends_recv");
            int ewSuffix = this.allocLocal("__ends_suffix");
            int ewRecvLen = this.allocLocal("__ends_rlen");
            int ewSuffixLen = this.allocLocal("__ends_slen");
            int ewI = this.allocLocal("__ends_i");
            int ewOff = this.allocLocal("__ends_off");
            this.genExpr(recv);
            this.asm.movMBaseR(5, 0, ewRecv);
            this.genExpr(call.child(1));
            this.asm.movMBaseR(5, 0, ewSuffix);
            // strlen recv
            this.asm.movRMBase(1, 5, ewRecv);
            this.addImportPatch("ucrtbase.dll", "strlen");
            int ewSL1 = 0xDEADBEEFCAFEBADB;
            this.asm.emitImm64(0, ewSL1);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, ewRecvLen);
            // strlen suffix
            this.asm.movRMBase(1, 5, ewSuffix);
            this.addImportPatch("ucrtbase.dll", "strlen");
            int ewSL2 = 0xDEADBEEFCAFEBADC;
            this.asm.emitImm64(0, ewSL2);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, ewSuffixLen);
            // if suffixLen > recvLen, return false
            int ewFalse = this.newLabel();
            int ewTrue = this.newLabel();
            int ewDone = this.newLabel();
            this.asm.movRMBase(0, 5, ewSuffixLen);
            this.asm.movRMBase(1, 5, ewRecvLen);
            this.asm.cmpRR64(0, 1);
            this.asm.jgLabel(ewFalse);
            // offset = recvLen - suffixLen
            this.asm.movRMBase(0, 5, ewRecvLen);
            this.asm.movRMBase(1, 5, ewSuffixLen);
            this.asm.subRR64(0, 1);
            this.asm.movMBaseR(5, 0, ewOff);
            // i = 0
            this.asm.xorRR64(0, 0);
            this.asm.movMBaseR(5, 0, ewI);
            int ewLoop = this.newLabel();
            this.asm.bindLabel(ewLoop);
            this.asm.movRMBase(0, 5, ewI);
            this.asm.movRMBase(1, 5, ewSuffixLen);
            this.asm.cmpRR64(0, 1);
            this.asm.jgeLabel(ewTrue);
            // compare recv[offset+i] with suffix[i]
            this.asm.movRMBase(11, 5, ewOff);
            this.asm.movRMBase(0, 5, ewI);
            this.asm.addRR64(11, 0);
            this.asm.movRMBase(0, 5, ewRecv);
            this.asm.addRR64(0, 11);
            this.asm.movzxByteMBase(0, 0, 0);
            this.asm.movRR64(1, 0);
            this.asm.movRMBase(11, 5, ewI);
            this.asm.movRMBase(0, 5, ewSuffix);
            this.asm.addRR64(0, 11);
            this.asm.movzxByteMBase(0, 0, 0);
            this.asm.cmpRR64(0, 1);
            this.asm.jneLabel(ewFalse);
            this.asm.movRMBase(0, 5, ewI);
            this.asm.addRI32(0, 1);
            this.asm.movMBaseR(5, 0, ewI);
            this.asm.jmpLabel(ewLoop);
            this.asm.bindLabel(ewTrue);
            this.asm.movRI64(0, 1);
            this.asm.jmpLabel(ewDone);
            this.asm.bindLabel(ewFalse);
            this.asm.xorRR64(0, 0);
            this.asm.bindLabel(ewDone);
            return;
        }
        if (name == "indexOf" || name == "find") {
            if (call.childCount() < 2) { this.asm.movRI64(0, -1); return; }
            int ioRecv = this.allocLocal("__index_recv");
            int ioNeedle = this.allocLocal("__index_needle");
            this.genExpr(recv);
            this.asm.movMBaseR(5, 0, ioRecv);
            this.genExpr(call.child(1));
            this.asm.movMBaseR(5, 0, ioNeedle);
            // Optional start offset: search from recv+start instead of recv.
            if (call.childCount() >= 3) {
                int ioStart = this.allocLocal("__index_start");
                this.genExpr(call.child(2));
                this.asm.movMBaseR(5, 0, ioStart);
                this.asm.movRMBase(0, 5, ioRecv);
                this.asm.movRMBase(11, 5, ioStart);
                this.asm.addRR64(0, 11);
                this.asm.movRMBase(1, 5, ioRecv);
                this.asm.addRR64(1, 11);

            } else {
                this.asm.movRMBase(1, 5, ioRecv);
            }
            this.asm.movRMBase(2, 5, ioNeedle);
            this.addImportPatch("ucrtbase.dll", "strstr");
            int ioSS = 0xDEADBEEFCAFEBADD;
            this.asm.emitImm64(0, ioSS);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            int ioFound = this.newLabel();
            int ioDone = this.newLabel();
            this.asm.cmpRI32(0, 0);
            this.asm.jneLabel(ioFound);
            this.asm.movRI64(0, -1);
            this.asm.jmpLabel(ioDone);
            this.asm.bindLabel(ioFound);
            this.asm.movRMBase(1, 5, ioRecv);
            this.asm.subRR64(0, 1);
            this.asm.bindLabel(ioDone);
            return;
        }
        if (name == "substr" || name == "substring") {
            // substr(start) / substr(start, len) - allocate a new NUL-terminated copy.
            int sbRecv = this.allocLocal("__sub_recv");
            int sbStart = this.allocLocal("__sub_start");
            int sbLen = this.allocLocal("__sub_len");
            int sbTotal = this.allocLocal("__sub_total");
            int sbDst = this.allocLocal("__sub_dst");
            int sbI = this.allocLocal("__sub_i");
            this.genExpr(recv);
