            this.asm.movMBaseR(5, 0, spPos);
            this.asm.movRI64(0, 0);
            this.asm.movMBaseR(5, 0, spIdx);
            int spPassL = this.newLabel();
            int spPassD = this.newLabel();
            this.asm.bindLabel(spPassL);
            this.asm.movRMBase(0, 5, spIdx);
            this.asm.movRMBase(1, 5, spCnt);
            this.asm.cmpRR64(0, 1);
            this.asm.jgeLabel(spPassD);
            this.asm.movRMBase(1, 5, spPos);
            this.asm.movRMBase(2, 5, spD);
            this.addImportPatch("ucrtbase.dll", "strstr");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD0);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, spFnd);
            int spLast = this.newLabel();
            int spAlloc = this.newLabel();
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(spLast);
            // found a delimiter: part length = fnd - pos
            this.asm.movRMBase(0, 5, spFnd);
            this.asm.movRMBase(1, 5, spPos);
            this.asm.subRR64(0, 1);
            this.asm.movMBaseR(5, 0, spWr);
            this.asm.jmpLabel(spAlloc);
            this.asm.bindLabel(spLast);
            // last part: part length = strlen(pos)
            this.asm.movRMBase(1, 5, spPos);
            this.addImportPatch("ucrtbase.dll", "strlen");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBAE1);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, spWr);
            this.asm.bindLabel(spAlloc);
            this.asm.movRMBase(0, 5, spWr);
            this.asm.addRI32(0, 1);
            this.asm.movRR64(1, 0);
            this.addImportPatch("msvcrt.dll", "malloc");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD1);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, spBuf);
            this.asm.movRMBase(1, 5, spPos);
            this.asm.movRMBase(2, 5, spBuf);
            this.asm.movRMBase(3, 5, spWr);
            int spCpL = this.newLabel();
            int spCpD = this.newLabel();
            this.asm.xorRR64(10, 10);
            this.asm.bindLabel(spCpL);
            this.asm.cmpRR64(10, 3);
            this.asm.jgeLabel(spCpD);
            this.asm.movzxByteMBase(0, 1, 0);
            this.asm.movMBaseByteR(2, 0, 0);
            this.asm.addRI32(1, 1);
            this.asm.addRI32(2, 1);
            this.asm.addRI32(10, 1);
            this.asm.jmpLabel(spCpL);
            this.asm.bindLabel(spCpD);
            this.asm.movRMBase(0, 5, spBuf);
            this.asm.movRMBase(1, 5, spWr);
            this.asm.addRR64(0, 1);
            this.asm.xorRR64(2, 2);
            this.asm.movMBaseByteR(0, 2, 0);
            // store element: arr[idx] = buf
            this.asm.movRMBase(0, 5, spBuf);
            this.asm.movRMBase(1, 5, spIdx);

            this.asm.shlR64Imm(1, 3);
            this.asm.addRI32(1, 16);
            this.asm.movRMBase(2, 5, spArr);
            this.asm.addRR64(1, 2);
            this.asm.movMBaseR(1, 0, 0);
            // advance past delimiter (or finish on the last part)
            this.asm.movRMBase(0, 5, spFnd);
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(spPassD);
            this.asm.movRMBase(1, 5, spDL);
            this.asm.addRR64(0, 1);
            this.asm.movMBaseR(5, 0, spPos);
            this.asm.movRMBase(0, 5, spIdx);
            this.asm.addRI32(0, 1);
            this.asm.movMBaseR(5, 0, spIdx);
            this.asm.jmpLabel(spPassL);
            this.asm.bindLabel(spPassD);
            this.asm.movRMBase(0, 5, spArr);
            this.asm.addRI32(0, 16);
            return;
        }
        if (name == "isAlpha" || name == "isAlphaNum" || name == "isDigit" || name == "isLower" || name == "isUpper" || name == "isWhiteSpace") {
            this.genExpr(recv);
            this.asm.movRR64(1, 0);
            int cYes = this.newLabel();
            int cEnd = this.newLabel();
            int cNo = this.newLabel();
            if (name == "isDigit") {
                this.asm.cmpRI32(1, 48);
                this.asm.jlLabel(cNo);
                this.asm.cmpRI32(1, 57);
                this.asm.jleLabel(cYes);
            } else if (name == "isWhiteSpace") {
                this.asm.cmpRI32(1, 32);
                this.asm.jeLabel(cYes);
                this.asm.cmpRI32(1, 9);
                this.asm.jeLabel(cYes);
                this.asm.cmpRI32(1, 10);
                this.asm.jeLabel(cYes);
                this.asm.cmpRI32(1, 13);
                this.asm.jeLabel(cYes);
            } else if (name == "isLower") {
                this.asm.cmpRI32(1, 97);
                this.asm.jlLabel(cNo);
                this.asm.cmpRI32(1, 122);
                this.asm.jleLabel(cYes);
            } else if (name == "isUpper") {
                this.asm.cmpRI32(1, 65);
                this.asm.jlLabel(cNo);
                this.asm.cmpRI32(1, 90);
                this.asm.jleLabel(cYes);
            } else if (name == "isAlpha") {
                int lo1 = this.newLabel();
                this.asm.cmpRI32(1, 65);
                this.asm.jlLabel(lo1);
                this.asm.cmpRI32(1, 90);
                this.asm.jleLabel(cYes);
                this.asm.bindLabel(lo1);
                this.asm.cmpRI32(1, 97);
                this.asm.jlLabel(cNo);
                this.asm.cmpRI32(1, 122);
                this.asm.jleLabel(cYes);
            } else if (name == "isAlphaNum") {
                int midNo = this.newLabel();
                this.asm.cmpRI32(1, 48);
                this.asm.jlLabel(midNo);
                this.asm.cmpRI32(1, 57);
                this.asm.jleLabel(cYes);
                this.asm.bindLabel(midNo);
                this.asm.cmpRI32(1, 65);
                this.asm.jlLabel(cNo);
                this.asm.cmpRI32(1, 90);
                this.asm.jleLabel(cYes);
                this.asm.cmpRI32(1, 97);
                this.asm.jlLabel(cNo);
                this.asm.cmpRI32(1, 122);
                this.asm.jleLabel(cYes);
            }
            this.asm.bindLabel(cNo);
            this.asm.movRI64(0, 0);
            this.asm.jmpLabel(cEnd);
            this.asm.bindLabel(cYes);
            this.asm.movRI64(0, 1);
            this.asm.bindLabel(cEnd);
            return;
        }
    }

    public void genTrimEnd(Node recv) {
        int srcOff = this.allocLocal("__trim_src");
        int lenOff = this.allocLocal("__trim_len");
        int iOff = this.allocLocal("__trim_i");
        int outOff = this.allocLocal("__trim_out");
        this.genExpr(recv);
        this.asm.movMBaseR(5, 0, srcOff);
        this.asm.movRMBase(1, 5, srcOff);
        this.addImportPatch("ucrtbase.dll", "strlen");
        int sTrimLen = 0xDEADBEEFCAFEBAD8;
        this.asm.emitImm64(0, sTrimLen);
        this.asm.movRMBase(0, 0, 0);

        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, lenOff);

        int trimLoop = this.newLabel();
        int trimDone = this.newLabel();
        int trimKeep = this.newLabel();
        this.asm.bindLabel(trimLoop);
        this.asm.movRMBase(0, 5, lenOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jleLabel(trimDone);
        this.asm.subRI32(0, 1);
        this.asm.movRMBase(1, 5, srcOff);
        this.asm.addRR64(1, 0);
        this.asm.movzxByteMBase(2, 1, 0);
        this.asm.cmpRI32(2, 32);
        this.asm.jeLabel(trimKeep);
        this.asm.cmpRI32(2, 9);
        this.asm.jeLabel(trimKeep);
        this.asm.cmpRI32(2, 10);
        this.asm.jeLabel(trimKeep);
        this.asm.cmpRI32(2, 13);
        this.asm.jneLabel(trimDone);
        this.asm.bindLabel(trimKeep);
        this.asm.movMBaseR(5, 0, lenOff);
        this.asm.jmpLabel(trimLoop);
        this.asm.bindLabel(trimDone);

        this.asm.movRMBase(1, 5, lenOff);
        this.asm.addRI32(1, 1);
        this.addImportPatch("msvcrt.dll", "malloc");
        int sTrimAlloc = 0xDEADBEEFCAFEBAD9;
        this.asm.emitImm64(0, sTrimAlloc);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, outOff);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, iOff);
        int copyLoop = this.newLabel();
        int copyDone = this.newLabel();
        this.asm.bindLabel(copyLoop);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(copyDone);
        this.asm.movRMBase(1, 5, srcOff);
        this.asm.addRR64(1, 0);
        this.asm.movzxByteMBase(2, 1, 0);
        this.asm.movRMBase(1, 5, outOff);
        this.asm.addRR64(1, 0);
        this.asm.movMBaseByteR(1, 2, 0);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(copyLoop);
        this.asm.bindLabel(copyDone);
        this.asm.movRMBase(0, 5, outOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.addRR64(0, 1);
        this.asm.xorRR64(2, 2);
        this.asm.movMBaseByteR(0, 2, 0);
        this.asm.movRMBase(0, 5, outOff);
    }

    // mode: 0 = trim end, 1 = trim start, 2 = trim both.
    // hasSet: 0 = whitespace, 1 = use setNode as the set of trim characters.
    public void genTrimCore(Node recv, Node setNode, int hasSet, int mode) {
        int srcOff = this.allocLocal("__trim_src");
        int lenOff = this.allocLocal("__trim_len");
        int setOff = this.allocLocal("__trim_set");
        int startOff = this.allocLocal("__trim_start");
        int endOff = this.allocLocal("__trim_end");
        int iOff = this.allocLocal("__trim_i");
        int outOff = this.allocLocal("__trim_out");

        this.genExpr(recv);
        this.asm.movMBaseR(5, 0, srcOff);
        if (hasSet == 1) {
            this.genExpr(setNode);
            this.asm.movMBaseR(5, 0, setOff);
        }

        // len = strlen(src)
        this.asm.movRMBase(1, 5, srcOff);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD8);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, lenOff);

        // start = 0, end = len
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, startOff);
        this.asm.movRMBase(0, 5, lenOff);
        this.asm.movMBaseR(5, 0, endOff);

        if (mode == 1 || mode == 2) {
            int sLoop = this.newLabel();
            int sDone = this.newLabel();
            int sSkip = this.newLabel();
            this.asm.bindLabel(sLoop);
            this.asm.movRMBase(0, 5, startOff);
            this.asm.movRMBase(1, 5, endOff);
            this.asm.cmpRR64(0, 1);
            this.asm.jgeLabel(sDone);
            this.asm.movRMBase(1, 5, srcOff);
            this.asm.movRMBase(0, 5, startOff);
            this.asm.addRR64(1, 0);
            this.asm.movzxByteMBase(2, 1, 0);
            if (hasSet == 1) {
                this.asm.movRMBase(1, 5, setOff);
                this.addImportPatch("ucrtbase.dll", "strchr");
                this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB1);
                this.asm.movRMBase(0, 0, 0);
                this.asm.emitCallSetup(0);
                this.asm.callR64(0);
                this.asm.emitCallTeardown();
                this.asm.cmpRI32(0, 0);
                this.asm.jneLabel(sSkip);
                this.asm.jmpLabel(sDone);
            } else {
                this.asm.cmpRI32(2, 32);
                this.asm.jeLabel(sSkip);
                this.asm.cmpRI32(2, 9);
                this.asm.jeLabel(sSkip);
                this.asm.cmpRI32(2, 10);
                this.asm.jeLabel(sSkip);
                this.asm.cmpRI32(2, 13);
                this.asm.jneLabel(sDone);
            }
            this.asm.bindLabel(sSkip);
            this.asm.movRMBase(0, 5, startOff);
            this.asm.addRI32(0, 1);
            this.asm.movMBaseR(5, 0, startOff);
            this.asm.jmpLabel(sLoop);
            this.asm.bindLabel(sDone);
        }

        if (mode == 0 || mode == 2) {
            int eLoop = this.newLabel();
            int eDone = this.newLabel();
            int eSkip = this.newLabel();
            this.asm.bindLabel(eLoop);
            this.asm.movRMBase(0, 5, endOff);
            this.asm.movRMBase(1, 5, startOff);
            this.asm.cmpRR64(0, 1);
            this.asm.jleLabel(eDone);
            this.asm.movRMBase(1, 5, srcOff);
            this.asm.movRMBase(0, 5, endOff);
            this.asm.subRI32(0, 1);
            this.asm.addRR64(1, 0);
            this.asm.movzxByteMBase(2, 1, 0);
            if (hasSet == 1) {
                this.asm.movRMBase(1, 5, setOff);
                this.addImportPatch("ucrtbase.dll", "strchr");
                this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB1);
                this.asm.movRMBase(0, 0, 0);
                this.asm.emitCallSetup(0);
                this.asm.callR64(0);
                this.asm.emitCallTeardown();
                this.asm.cmpRI32(0, 0);
                this.asm.jneLabel(eSkip);
                this.asm.jmpLabel(eDone);
            } else {
                this.asm.cmpRI32(2, 32);
                this.asm.jeLabel(eSkip);
                this.asm.cmpRI32(2, 9);
                this.asm.jeLabel(eSkip);
                this.asm.cmpRI32(2, 10);
                this.asm.jeLabel(eSkip);
                this.asm.cmpRI32(2, 13);
                this.asm.jneLabel(eDone);
            }
            this.asm.bindLabel(eSkip);
            this.asm.movRMBase(0, 5, endOff);
            this.asm.subRI32(0, 1);
            this.asm.movMBaseR(5, 0, endOff);
            this.asm.jmpLabel(eLoop);
            this.asm.bindLabel(eDone);
        }

        // newLen = end - start
        this.asm.movRMBase(0, 5, endOff);
        this.asm.movRMBase(1, 5, startOff);
        this.asm.subRR64(0, 1);
        this.asm.movMBaseR(5, 0, lenOff);

        // out = malloc(newLen + 1)
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.addRI32(1, 1);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD9);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);

        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, outOff);

        // copy src[start..end] to out
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, iOff);
        int cpLoop = this.newLabel();
        int cpDone = this.newLabel();
        this.asm.bindLabel(cpLoop);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(cpDone);
        this.asm.movRMBase(1, 5, srcOff);
        this.asm.movRMBase(0, 5, startOff);
        this.asm.addRR64(1, 0);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRR64(1, 0);
        this.asm.movzxByteMBase(2, 1, 0);
        this.asm.movRMBase(1, 5, outOff);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRR64(1, 0);
        this.asm.movMBaseByteR(1, 2, 0);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(cpLoop);
        this.asm.bindLabel(cpDone);

        // out[newLen] = 0
        this.asm.movRMBase(0, 5, outOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.addRR64(0, 1);
        this.asm.xorRR64(2, 2);
        this.asm.movMBaseByteR(0, 2, 0);
        this.asm.movRMBase(0, 5, outOff);
    }

    public void genMemberCall(Node call) {
        string name = call.name;
        Node recv = call.child(0);
        string recvClass = this.inferExprType(recv);
        // A bare class-name receiver (e.g. BuiltinMethods.callMethod(...)) has
        // no local type, so inferExprType returns "". Resolve it to the class
        // name itself: otherwise the exact-class search below fails and the
        // any-class fallback can bind an overloaded method name (e.g.
        // callMethod exists on both Evaluator and BuiltinMethods) to the wrong
        // function, corrupting every argument at the call site.
        if (recv.kind == 6) {
            for (int ci = 0; ci < this.classNames.length; ci++) {
                if (this.classNames[ci] == recv.name) { recvClass = recv.name; }
            }
        }
        int funcIdx = -1;
        // Overload dispatch by argument count:
        // among this class's same-named methods, the LAST declaration
        // accepting the explicit argument count (explicit = children minus
        // the receiver). Falls back to the legacy any-class scan only when
        // the receiver's class offers no declaration at all.
        int explicitUserArgs = call.childCount() - 1;
        if (explicitUserArgs < 0) { explicitUserArgs = 0; }
        bool haveExactClass = false;
        for (int i = 0; i < this.funcNames.length; i++) {
            if (this.funcNames[i] == name && (this.funcClasses[i] == recvClass || recvClass == this.funcClasses[i] + "?")) {
                haveExactClass = true;
            }
        }
        if (haveExactClass) {
            funcIdx = this.selectOverloadIdx(name, recvClass, explicitUserArgs);
        }
        // DOCS/259 G2: a zero-arg member call on a receiver whose class
        // declares a fn-typed field of that name (`this.cb()` / `obj.cb()`)
        // is an indirect call through the stored function address. Method
        // declarations win (checked above); class field tables already include
        // inherited fields, so the parent chain is covered.
        if (funcIdx < 0 && call.childCount() == 1) {
            string fieldType = this.findFieldType(recvClass, name);
            if (fieldType == "void ()") {
                int fnFieldOff = this.findFieldOffset(recvClass, name);
                if (fnFieldOff >= 0) {
                    this.genExpr(call.child(0));
                    this.asm.movRMBase(0, 0, fnFieldOff);
                    this.asm.movRR64(10, 0);
                    this.asm.emitCallSetup(0);
                    this.asm.callR64(10);
                    this.asm.emitCallTeardown();
                    this.emitExcCheck();
                    return;
                }
            }
        }
        if (funcIdx < 0) {
            for (int i = 0; i < this.funcNames.length; i++) {
                if (this.funcNames[i] == name) {
                    funcIdx = i;
                }
            }
        }
        string lookupClass = "";
        if (funcIdx >= 0) {
            lookupClass = this.funcClasses[funcIdx];
        }

        // Use slots reserved before the function prologue.  The old
        // per-call allocLocal and stack-spill variants either changed the
        // frame after prologue emission or depended on a volatile register
        // surviving nested generated calls.
        // Member-call child(0) is the receiver, not a declared method
        // parameter.  The receiver uses the method ABI's RCX slot; declared
        // parameters begin at child(1) and use RDX/R8/R9/stack.
        int explicitArgs = call.childCount() - 1;
        if (explicitArgs < 0) { explicitArgs = 0; }
        int totalUserArgs = explicitArgs;
        Node packedArg = null;
        int packIndex = -1;
        if (funcIdx >= 0 && funcIdx < this.funcParamCounts.length) {
            int paramCount = this.funcParamCounts[funcIdx];
            int paramStart = this.funcParamStarts[funcIdx];
            bool variadicFn = funcIdx < this.funcHasVariadic.length && this.funcHasVariadic[funcIdx] == 1;
            int fixedCount = paramCount - 1;
            if (fixedCount < 0) { fixedCount = 0; }
            if (variadicFn && explicitArgs >= fixedCount) {
                // Variadic tail: pack the trailing call-site arguments into
                // a single array literal (DOCS/112).  child(1..) are the
                // declared arguments, so child(1) is the first one.
                Node arr = new Node(); arr.kind = 19;
                for (int ai = fixedCount; ai < explicitArgs; ai++) {
                    arr.children.add(call.child(ai + 1));
                }
                packedArg = arr;
                packIndex = fixedCount + 1;
                explicitArgs = paramCount;
                totalUserArgs = paramCount;
            }
            while (totalUserArgs < paramCount && totalUserArgs + paramStart < this.funcParamHasDefaults.length && this.funcParamHasDefaults[totalUserArgs + paramStart] == 1) {
                totalUserArgs++;
            }
        }
        int totalArgs = totalUserArgs + 1;
        int scratchBase = this.funcCallArgCount;

        if (scratchBase + totalArgs > 64) {
            printline("too many nested call arguments");
            exit(1);
            return;
        }
        this.funcCallArgCount += totalArgs;
        for (int i = 0; i < totalArgs; i++) {
            if (i == 0) {
                this.genExpr(call.child(0));

            } else if (i <= explicitArgs) {
                if (packedArg != null && i == packIndex) {
                    this.genExpr(packedArg);
                } else {
                    this.genExpr(call.child(i));
                }
            } else if (funcIdx >= 0 && funcIdx < this.funcParamStarts.length) {
                int defaultIndex = this.funcParamStarts[funcIdx] + i - 1;
                if (defaultIndex < this.funcParamDefaults.length) {
                    this.genExpr(this.funcParamDefaults[defaultIndex]);
                } else {
                    this.asm.xorRR64(0, 0);
                }
            } else {
                this.asm.xorRR64(0, 0);
            }
            int argOff = this.scratchBaseOffset - (8 * (scratchBase + i));
            this.asm.movMBaseR(5, 0, argOff);
        }

        int extraStack = 0;
        // LINUX SysV backend (additive): 6 register slots (RDI = `this`),
        // no shadow. The WINDOWS counts below are unchanged.
        int memberNreg = this.abiRegCount();
        int memberBase = this.abiStackBase();
        if (totalArgs > memberNreg) {
            extraStack = (totalArgs - memberNreg) * 8;
        }
        this.emitAbiCallSetup(extraStack);
        // Methods use RCX for `this`, then RDX/R8/R9 for declared parameters.
        // Further parameters are placed after Win64 shadow space at [RSP+32].
        int[] argRegs = [1, 2, 8, 9];
        int regArgs = totalArgs;
        if (regArgs > memberNreg) { regArgs = memberNreg; }
        for (int i = 0; i < regArgs; i++) {
            int argOff = this.scratchBaseOffset - (8 * (scratchBase + i));
            if (this.isLinuxTarget()) {
                this.asm.movRMBase(this.sysvRegAt(i), 5, argOff);
            } else {
                this.asm.movRMBase(argRegs[i], 5, argOff);
            }
        }
        for (int i = memberNreg; i < totalArgs; i++) {
            int argOff = this.scratchBaseOffset - (8 * (scratchBase + i));
            this.asm.movRMBase(0, 5, argOff);
            this.asm.movMBaseR(4, 0, memberBase + (i - memberNreg) * 8);
        }

        if (funcIdx >= 0 && funcIdx < this.funcOffsets.length) {
            int targetOff = this.funcOffsets[funcIdx];
            if (targetOff >= 0) {
                int callPos = this.asm.buf.length;
                int rel32 = targetOff - (callPos + 5);
                this.asm.callRel32(rel32);
            } else {
                this.asm.callRel32(0);
                this.forwardCalls.add(this.asm.buf.length - 4);
                this.forwardCallFuncIdxs.add(funcIdx);
                this.forwardCallNames.add(name);
                this.forwardCallClasses.add(lookupClass);
            }
        } else {
            this.asm.callRel32(0);
            this.forwardCalls.add(this.asm.buf.length - 4);
            this.forwardCallFuncIdxs.add(-1);
            this.forwardCallNames.add(name);
            this.forwardCallClasses.add(lookupClass);
        }
        this.emitAbiCallTeardown();
        this.funcCallArgCount = scratchBase;
    }

    // cvtsi2sd xmm0, rax (F2 REX.W 0F 2A C0): signed 64-bit int -> double.
    // Emitted inline because the asm-layer cvtsi2sdXMM helper omits REX.W and
    // would read only EAX, truncating int64 operands above 2^31.
    public void emitCvtsi2sdRax() {
        this.asm.emitU8(0xF2);
        this.asm.emitU8(0x48);
        this.asm.emitU8(0x0F);
        this.asm.emitU8(0x2A);
        this.asm.emitU8(0xC0);
    }

    // CVTSI2SD xmm, r64 (F2 REX.W 0F 2A /r) with computed ModRM: the reg
    // field is the destination XMM (REX.R-extendable), rm the source GP
    // register.  Emitted inline because the asm-layer cvtsi2sdXMM omits
    // REX.W and would read only the low 32 bits of the GP register.
    public void emitCvtsi2sdXmmGpr(int xmm, int r64) {
        this.asm.emitU8(0xF2);
        int rex = 0x48;
        if (xmm > 7) { rex = rex | 0x04; }
        if (r64 > 7) { rex = rex | 0x01; }
        this.asm.emitU8(rex);
        this.asm.emitU8(0x0F);
        this.asm.emitU8(0x2A);
        this.asm.emitU8(0xC0 | ((xmm & 7) << 3) | (r64 & 7));
    }

    // MOVQ xmm, r64 (66 REX.W 0F 6E /r): full 64-bit GP -> XMM bit-pattern
    // copy.  The asm-layer movqXMMR64 omits REX.W, which demotes the opcode
    // to MOVD (low 32 bits only, zero-extended) and silently corrupts
    // float64 bit patterns whose low dword is zero (e.g. -1.0, 1.0); mirror
    // silverc-rs x64.rs movq_xmm_gpr, which always emits REX.W.
    public void emitMovqXmmGpr(int xmm, int r64) {
        this.asm.emitU8(0x66);
        int rex = 0x48;
        if (xmm > 7) { rex = rex | 0x04; }
        if (r64 > 7) { rex = rex | 0x01; }
        this.asm.emitU8(rex);
        this.asm.emitU8(0x0F);
        this.asm.emitU8(0x6E);
        this.asm.emitU8(0xC0 | ((xmm & 7) << 3) | (r64 & 7));
    }

    // Unsigned conditional jump (0F 8x rel32) for ucomisd flag semantics:
    // opcode2 0x82=jb, 0x86=jbe, 0x87=ja, 0x83=jae.  The asm layer only
    // exposes signed variants (jl/jle/jg/jge), so emit inline with the same
    // addReloc pattern as mini_asm's Label helpers.
    public void emitJccRel32(int opcode2, int labelId) {
        this.asm.emitU8(0x0F);
        this.asm.emitU8(opcode2);
        this.asm.addReloc(labelId, this.asm.buf.length, 1);
        this.asm.emitU32(0);
    }

    public void genFloatBinary(Node bin) {
        // Float arithmetic (+, -, *, /) on IEEE-754 double bits carried in GP
        // registers.  Operands are loaded into XMM0/XMM1, computed with SSE2
        // scalar-double instructions, and the result bits returned in RAX.
        // Integer operands are widened with cvtsi2sd (int -> double).
        int fop = bin.op;
        int lOff = this.allocLocal("__fbin_l");
        int rOff = this.allocLocal("__fbin_r");
        bool lFlt = this.isFloatLike(bin.child(0));
        bool rFlt = this.isFloatLike(bin.child(1));
        this.genExpr(bin.child(0));
        if (lFlt) { this.asm.movMBaseR(5, 0, lOff); }
        else { this.emitCvtsi2sdRax(); this.asm.movsdBaseXMM(5, 0, lOff); }
        this.genExpr(bin.child(1));
        if (rFlt) { this.asm.movMBaseR(5, 0, rOff); }
        else { this.emitCvtsi2sdRax(); this.asm.movsdBaseXMM(5, 0, rOff); }
        this.asm.movsdXMMBase(0, 5, lOff);
        this.asm.movsdXMMBase(1, 5, rOff);
        if (fop == 1) { this.asm.addsdXMM(0, 1); }
        else if (fop == 2) { this.asm.subsdXMM(0, 1); }
        else if (fop == 3) { this.asm.mulsdXMM(0, 1); }
        else if (fop == 4) { this.asm.divsdXMM(0, 1); }
        this.asm.movsdBaseXMM(5, 0, lOff);
        this.asm.movqR64XMM(0, 0);
    }

    public void genBinary(Node bin) {
        if (bin.childCount() < 2) { return; }
        int op = bin.op;
        if (op == 25) {
            this.genExpr(bin.child(0));
            this.asm.pushR64(0);
            int fallback = this.newLabel();
            int done = this.newLabel();
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(fallback);
            this.asm.popR64(0);
            this.asm.jmpLabel(done);
            this.asm.bindLabel(fallback);
            this.asm.popR64(1);
            this.genExpr(bin.child(1));
            this.asm.bindLabel(done);
            return;
        }
        if (op == 20) {
            this.genAssign(bin);
            return;
        }
        if (op == 35 || op == 36) {
            this.genPostIncDec(bin, op == 35);
            return;
        }
        if (op == 27) {
            this.genRangeArray(bin);
            return;
        }
        if (op == 26) {
            string rptLt = this.inferExprType(bin.child(0));
            if (rptLt == "string") {
                this.genStringRepeat(bin);
                return;
            }
        }
        if (op >= 14 && op <= 17) {
            this.genCompoundAssign(bin, op);
            return;
        }
        if (op >= 29 && op <= 34) {
            this.genCompoundAssign(bin, op);
            return;
        }
        if (op == 1) {
            string lt = this.inferExprType(bin.child(0));
            string rt = this.inferExprType(bin.child(1));
            // Only a real string operand makes `+` string concatenation.
            // A char operand alone (`'a' + 1`, `'a' + 'b'`) is integer
            // arithmetic on the code point; treating char as string there
            // silently produced garbage from the string-concat path.
            if (lt == "string" || rt == "string") {
                this.genStringConcat(bin);
                return;
            }
        }
        // Strings are pointers, so pointer comparison is not value equality.
        // Lower string equality through strcmp while leaving numeric/char
        // comparisons on the ordinary integer path below.
        if (op == 5 || op == 6) {

            string eqLt = this.inferExprType(bin.child(0));
            string eqRt = this.inferExprType(bin.child(1));
            if (eqLt == "string" && eqRt == "string") {
                this.genExpr(bin.child(0));
                this.asm.pushR64(0);
                this.genExpr(bin.child(1));
                this.asm.movRR64(2, 0);
                this.asm.popR64(1);
                this.addImportPatch("ucrtbase.dll", "strcmp");
                int sEq = 0xDEADBEEFCAFEBAD8;
                this.asm.emitImm64(0, sEq);
                this.asm.movRMBase(0, 0, 0);
                this.asm.emitCallSetup(0);
                this.asm.callR64(0);
                this.asm.emitCallTeardown();
                this.asm.cmpRI32(0, 0);
                int eqTrue = this.newLabel();
                int eqDone = this.newLabel();
                if (op == 5) { this.asm.jeLabel(eqTrue); }
                else { this.asm.jneLabel(eqTrue); }
                this.asm.xorRR64(0, 0);
                this.asm.jmpLabel(eqDone);
                this.asm.bindLabel(eqTrue);
                this.asm.movRI64(0, 1);
                this.asm.bindLabel(eqDone);
                return;
            }
        }
        // Logical && and || are SHORT-CIRCUIT: the right operand is only
        // evaluated when the left operand does not decide the result.
        // Evaluating both operands unconditionally (as the generic path
        // below does) diverges from the Rust frontend and lets later
        // self-hosted stages run type-inference calls inside `elif` guards
        // that short-circuit semantics would skip, crashing on member-call
        // dispatch (e.g. `x.add(v)` evaluating inferExprType on the receiver
        // and then string-indexing the result).
        if (op == 11) {
            int fAnd = this.newLabel();
            int dAnd = this.newLabel();
            this.genExpr(bin.child(0));
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(fAnd);
            this.genExpr(bin.child(1));
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(fAnd);
            this.asm.movRI64(0, 1);
            this.asm.jmpLabel(dAnd);
            this.asm.bindLabel(fAnd);
            this.asm.movRI64(0, 0);
            this.asm.bindLabel(dAnd);
            return;
        }
        if (op == 12) {
            int tOr = this.newLabel();
            int dOr = this.newLabel();
            this.genExpr(bin.child(0));
            this.asm.cmpRI32(0, 0);
            this.asm.jneLabel(tOr);
            this.genExpr(bin.child(1));
            this.asm.cmpRI32(0, 0);
            this.asm.jneLabel(tOr);
            this.asm.movRI64(0, 0);
            this.asm.jmpLabel(dOr);
            this.asm.bindLabel(tOr);
            this.asm.movRI64(0, 1);
            this.asm.bindLabel(dOr);
            return;
        }
        // Float arithmetic: when either operand is a float, lower +, -, *, /
        // through SSE2 scalar-double instructions instead of the integer ALU
        // (which would combine the raw IEEE-754 bit patterns).
        if (op >= 1 && op <= 4) {
            if (this.isFloatLike(bin.child(0)) || this.isFloatLike(bin.child(1))) {
                this.genFloatBinary(bin);
                return;
            }
        }
        this.genExpr(bin.child(0));
        this.asm.pushR64(0);
        this.genExpr(bin.child(1));
        this.asm.movRR64(1, 0);
        this.asm.popR64(0);
        if (op == 1) {
            this.asm.addRR64(0, 1);
        } else if (op == 2) {
            this.asm.subRR64(0, 1);
        } else if (op == 3) {
            this.asm.mulRR64(1);
        } else if (op == 4) {
            this.emitDivisorCheck();
            this.asm.cqo();
            this.asm.idivR64(1);
        } else if (op == 13) {
            this.emitDivisorCheck();
            this.asm.cqo();
            this.asm.idivR64(1);
            this.asm.movRR64(0, 2);
        } else if (op == 18) {
            // << : shl rax, cl (RAX=lhs, RCX=rhs count)
            this.asm.shlRCl64(0);
        } else if (op == 19) {
            // >> : shr rax, cl
            this.asm.shrRCl64(0);
        } else if (op == 22) {
            // & : bitwise and
            this.asm.andRR64(0, 1);
        } else if (op == 23) {
            // | : bitwise or
            this.asm.orRR64(0, 1);
        } else if (op == 24) {
            // ^ : bitwise xor
            this.asm.xorRR64(0, 1);
        } else if (op == 28) {
            // << : move-init value copy; the destination takes the RHS value.
            this.asm.movRR64(0, 1);
    } else if (op >= 5 && op <= 10) {
            // Float comparisons must order by VALUE, not by IEEE-754 bit
            // pattern: integer cmp misorders negatives with different
            // exponents and disagrees with ucomisd's NaN flag semantics.
            // Mirror silverc-rs codegen.rs exactly: ucomisd xmm0(lhs),
            // xmm1(rhs), then Eq->je, Ne->jne, Lt->jb, Le->jbe, Gt->ja,
            // Ge->jae (the unsigned jcc read CF/ZF, which ucomisd sets per
            // the IEEE-754 unordered rules).  Integer operands on either
            // side are widened with cvtsi2sd.
            bool cmpFlt = this.isFloatLike(bin.child(0)) || this.isFloatLike(bin.child(1));
            if (cmpFlt) {
                if (this.isFloatLike(bin.child(0))) { this.emitMovqXmmGpr(0, 0); }
                else { this.emitCvtsi2sdRax(); }
                if (this.isFloatLike(bin.child(1))) { this.emitMovqXmmGpr(1, 1); }
                else { this.emitCvtsi2sdXmmGpr(1, 1); }
                this.asm.ucomisdXMM(0, 1);
            } else {
                this.asm.cmpRR64(0, 1);
            }
            int t = this.newLabel();
            int e = this.newLabel();
            if (op == 5) { this.asm.jeLabel(t); }
            else if (op == 6) { this.asm.jneLabel(t); }
            else if (op == 7) { if (cmpFlt) { this.emitJccRel32(0x82, t); } else { this.asm.jlLabel(t); } }
            else if (op == 8) { if (cmpFlt) { this.emitJccRel32(0x86, t); } else { this.asm.jleLabel(t); } }
            else if (op == 9) { if (cmpFlt) { this.emitJccRel32(0x87, t); } else { this.asm.jgLabel(t); } }
            else if (op == 10) { if (cmpFlt) { this.emitJccRel32(0x83, t); } else { this.asm.jgeLabel(t); } }
            this.asm.movRI64(0, 0);
            this.asm.jmpLabel(e);
            this.asm.bindLabel(t);
            this.asm.movRI64(0, 1);
            this.asm.bindLabel(e);
        }
    }

    public void genCompoundAssign(Node bin, int op) {
        Node lhs = bin.child(0);
        Node rhs = bin.child(1);
        if (lhs.kind == 6) {
            this.requireResolvableAssignTarget(lhs);
            this.rejectGlobalWriteInAnonBody(lhs);
            int off = this.findLocal(lhs.name);
            int gi = this.findGlobal(lhs.name);
            int fieldOff = -1;
            if (off == 0 && gi < 0 && this.currentClassName != "") {
                // Bare class field compound assign: `field += x` resolves to
                // `this.field += x` (parity with silverc-rs).
                fieldOff = this.findFieldOffset(this.currentClassName, lhs.name);
            }
            if (op == 14 && fieldOff >= 0) {
                string bfT = this.findFieldType(this.currentClassName, lhs.name);
                if (bfT == "string") {
                    // Bare string field `s += x`: the getLocalType string
                    // check below only sees locals/globals, so the generic
                    // path would integer-add heap pointers and fault on the
                    // next use. Build a synthetic this.field lhs and run the
                    // concat machinery (mirrors silverc-rs bare-field string
                    // dispatch). The old buffer is not freed — same ownership
                    // as string-local +=.
                    Node synthMember = new Node();
                    synthMember.kind = 13;
                    synthMember.name = lhs.name;
                    Node thisNode = new Node();
                    thisNode.kind = 6;
                    thisNode.name = "this";
                    synthMember.children = [thisNode];
                    Node concatBin = new Node();
                    concatBin.children = [synthMember, rhs];
                    this.genStringConcat(concatBin);
                    int thisOff = this.findLocal("this");
                    if (thisOff != 0) {
                        this.asm.pushR64(0);
                        this.asm.movRMBase(0, 5, thisOff);
                        this.asm.addRI32(0, fieldOff);
                        this.asm.popR64(1);
                        this.asm.movMBaseR(0, 1, 0);
                    } else {
                        this.asm.movMBaseR(5, 0, 0);
                    }
                    return;
                }
            }
            // Float LHS (local, bare field, or global): these hold IEEE-754
            // bit patterns; the integer ops below corrupt them (1.0 + 0.5 as
            // a bit add is garbage). Route through the SSE path — the same
            // XMM sequence as genFloatBinary (mirrors silverc-rs float
            // compound-assign dispatch).
            string lhsT = this.getLocalType(lhs.name);
            bool lhsFloat = lhsT == "float" || lhsT == "float64" || lhsT == "double";
            if (!lhsFloat && fieldOff >= 0) {
                string ffT = this.findFieldType(this.currentClassName, lhs.name);
                lhsFloat = ffT == "float" || ffT == "float64" || ffT == "double";
            }
            if (lhsFloat && (op == 14 || op == 15 || op == 16 || op == 17)) {
                if (off != 0) { this.asm.movRMBase(0, 5, off); }
                else if (gi >= 0) { this.genGlobalLoad(gi); }
                else if (fieldOff >= 0) {
                    int thisOff = this.findLocal("this");
                    if (thisOff != 0) {
                        this.asm.movRMBase(0, 5, thisOff);
                        this.asm.movRMBase(0, 0, fieldOff);
                    } else {
                        this.asm.xorRR64(0, 0);
                    }
                }
                if (this.isRefParam(lhs.name)) { this.asm.movRMBase(0, 0, 0); }
                int bitsOff = this.allocLocal("__fassign_lhs");
                this.asm.movMBaseR(5, 0, bitsOff);
                this.genExpr(rhs);
                this.asm.movRR64(1, 0);
                this.asm.movRMBase(0, 5, bitsOff);
                this.emitMovqXmmGpr(0, 0);
                if (this.isFloatLike(rhs)) {
                    this.emitMovqXmmGpr(1, 1);
                } else {
                    this.emitCvtsi2sdXmmGpr(1, 1);
                }
                if (op == 14) { this.asm.addsdXMM(0, 1); }
                else if (op == 15) { this.asm.subsdXMM(0, 1); }
                else if (op == 16) { this.asm.mulsdXMM(0, 1); }
                else if (op == 17) { this.asm.divsdXMM(0, 1); }
                this.asm.movqR64XMM(0, 0);
                if (off != 0) {
                    if (this.isRefParam(lhs.name)) {
                        this.asm.pushR64(0);
                        this.asm.movRMBase(0, 5, off);
                        this.asm.popR64(1);
                        this.asm.movMBaseR(0, 1, 0);
                    } else {
                        this.asm.movMBaseR(5, 0, off);
                    }
                }
                else if (gi >= 0) { this.genGlobalStore(gi); }
                else if (fieldOff >= 0) {
                    int thisOff = this.findLocal("this");
                    if (thisOff != 0) {
                        this.asm.pushR64(0);
                        this.asm.movRMBase(0, 5, thisOff);
                        this.asm.addRI32(0, fieldOff);
                        this.asm.popR64(1);
                        this.asm.movMBaseR(0, 1, 0);
                    } else {
                        this.asm.movMBaseR(5, 0, 0);
                    }
                }
                return;
            }
            if (op == 14) {
                string lt = this.getLocalType(lhs.name);
                if (lt == "string") {
                    this.genStringConcat(bin);
                    if (off != 0) {
                        if (this.isRefParam(lhs.name)) {
                            this.asm.pushR64(0);
                            this.asm.movRMBase(0, 5, off);
                            this.asm.popR64(1);
                            this.asm.movMBaseR(0, 1, 0);
                        } else {
                            this.asm.movMBaseR(5, 0, off);
                        }
                    }
                    else if (gi >= 0) { this.genGlobalStore(gi); }
                    else if (fieldOff >= 0) {
                        int thisOff = this.findLocal("this");
                        if (thisOff != 0) {
                            this.asm.pushR64(0);
                            this.asm.movRMBase(0, 5, thisOff);
                            this.asm.addRI32(0, fieldOff);
                            this.asm.popR64(1);
                            this.asm.movMBaseR(0, 1, 0);
                        } else {
                            this.asm.movMBaseR(5, 0, 0);
                        }
                    }
                    else { this.asm.movMBaseR(5, 0, 0); }
                    return;
                }
            }
            if (off != 0) { this.asm.movRMBase(0, 5, off); }
            else if (gi >= 0) { this.genGlobalLoad(gi); }
            else if (fieldOff >= 0) {
                int thisOff = this.findLocal("this");
                if (thisOff != 0) {
                    this.asm.movRMBase(0, 5, thisOff);
                    this.asm.movRMBase(0, 0, fieldOff);
                } else {
                    this.asm.xorRR64(0, 0);
                }
            }
            else { this.asm.movRMBase(0, 5, 0); }
            if (this.isRefParam(lhs.name)) {
                this.asm.movRMBase(0, 0, 0);
            }
            this.asm.pushR64(0);
            this.genExpr(rhs);
            this.asm.movRR64(1, 0);
            this.asm.popR64(0);
            if (op == 14) { this.asm.addRR64(0, 1); }
            else if (op == 15) { this.asm.subRR64(0, 1); }
            else if (op == 16) { this.asm.mulRR64(1); }
            else if (op == 17) { this.emitDivisorCheck(); this.asm.cqo(); this.asm.idivR64(1); }
            else if (op == 29) { this.emitDivisorCheck(); this.asm.cqo(); this.asm.idivR64(1); this.asm.movRR64(0, 2); }
            else if (op == 30) { this.asm.andRR64(0, 1); }
            else if (op == 31) { this.asm.orRR64(0, 1); }
            else if (op == 32) { this.asm.xorRR64(0, 1); }
            else if (op == 33) { this.asm.movRR64(11, 1); this.asm.shlRCl64(0); }
            else if (op == 34) { this.asm.movRR64(11, 1); this.asm.shrRCl64(0); }
            if (off != 0) {
                if (this.isRefParam(lhs.name)) {
                    this.asm.pushR64(0);
                    this.asm.movRMBase(0, 5, off);
                    this.asm.popR64(1);
                    this.asm.movMBaseR(0, 1, 0);
                } else {
                    this.asm.movMBaseR(5, 0, off);
                }
            }
            else if (gi >= 0) { this.genGlobalStore(gi); }
            else if (fieldOff >= 0) {
                int thisOff = this.findLocal("this");
                if (thisOff != 0) {
                    this.asm.pushR64(0);
                    this.asm.movRMBase(0, 5, thisOff);
                    this.asm.addRI32(0, fieldOff);
                    this.asm.popR64(1);
                    this.asm.movMBaseR(0, 1, 0);
                } else {
                    this.asm.movMBaseR(5, 0, 0);
                }
            }
            else { this.asm.movMBaseR(5, 0, 0); }
            return;
        }
        if (lhs.kind == 24 && lhs.childCount() >= 2) {
            Node arrNode = lhs.child(0);
            Node idxNode = lhs.child(1);
            // dict[k] op= r lowers to dict[k] = dict[k] op r (mirrors the
            // silverc-rs Index compound-assign arm).
            if (this.isDictType(this.inferReceiverType(arrNode))) {
                Node keyExpr = new Node();
                keyExpr.kind = 24;
                keyExpr.children.add(arrNode);
                keyExpr.children.add(idxNode);
                Node updated = new Node();
                updated.kind = 7;
                if (op == 14) { updated.op = 1; }
                else if (op == 15) { updated.op = 2; }
                else if (op == 16) { updated.op = 3; }
                else if (op == 17) { updated.op = 4; }
                else if (op == 29) { updated.op = 13; }
                else if (op == 30) { updated.op = 22; }
                else if (op == 31) { updated.op = 23; }
                else if (op == 32) { updated.op = 24; }
                else if (op == 33) { updated.op = 18; }
                else if (op == 34) { updated.op = 19; }
                else { updated.op = 1; }
                updated.children.add(keyExpr);
                updated.children.add(rhs);
                Node assignBin = new Node();
                assignBin.kind = 7;
                assignBin.op = 20;
                assignBin.children.add(lhs);
                assignBin.children.add(updated);
                this.genBinary(assignBin);
                return;
            }
            bool arrIsByte = false;
            if (arrNode.kind == 6) {
                arrIsByte = this.isByteElemType(this.getLocalType(arrNode.name));
            } else if (arrNode.kind == 13) {
                Node arrObj = arrNode.child(0);
                if (arrObj.kind == 6 && arrObj.name == "this") {
                    // Stable classification for self-hosted stages: resolve the
                    // field type from the class table instead of the recursive
                    // inferExprType path.
                    arrIsByte = this.isByteElemType(this.findFieldType(this.currentClassName, arrNode.name));
                } else {
                    arrIsByte = this.isByteElemType(this.inferExprType(arrNode));
                }
            } else if (arrNode.kind == 24) {
                arrIsByte = this.isByteElemType(this.inferExprType(arrNode));
            }
            if (arrIsByte) {
                // byte[]/char[] elements are byte-packed on self-host: keep
                // the byte RMW, but resolve the array base through genExpr so
                // GLOBAL arrays load through their storage slot too
                // (findLocal returns 0 for globals and [rbp+0] is the saved
                // frame pointer - mirroring the rs genExpr(arr) base rule).
                this.genExpr(arrNode);
                this.asm.pushR64(0);
                this.genExpr(idxNode);
                this.asm.movRR64(11, 0);
                this.asm.popR64(0);
                this.asm.addRR64(0, 11);
                this.asm.pushR64(0);
                this.asm.movzxByteMBase(0, 0, 0);
                this.asm.pushR64(0);
                this.genExpr(rhs);
                this.asm.movRR64(1, 0);
                this.asm.popR64(0);
                if (op == 14) { this.asm.addRR64(0, 1); }
                else if (op == 15) { this.asm.subRR64(0, 1); }
                else if (op == 16) { this.asm.mulRR64(1); }
                else if (op == 17) { this.emitDivisorCheck(); this.asm.cqo(); this.asm.idivR64(1); }
                else if (op == 29) { this.emitDivisorCheck(); this.asm.cqo(); this.asm.idivR64(1); this.asm.movRR64(0, 2); }
                else if (op == 30) { this.asm.andRR64(0, 1); }
                else if (op == 31) { this.asm.orRR64(0, 1); }
                else if (op == 32) { this.asm.xorRR64(0, 1); }
                else if (op == 33) { this.asm.movRR64(11, 1); this.asm.shlRCl64(0); }
                else if (op == 34) { this.asm.movRR64(11, 1); this.asm.shrRCl64(0); }
                this.asm.popR64(11);
                this.asm.movMBaseByteR(11, 0, 0);
                return;
            }
            // arr[i] op= rhs - read-modify-write through the element address,
            // mirroring the rs Index lowering: genExpr(arr) yields the
            // array base for locals AND globals (globals load through their
            // storage slot), idx*8 selects the slot. Without this arm the
            // statement silently no-ops or corrupts the frame
            // (`gdata[0] += 10` stored through [rbp+0]).
            this.genExpr(arrNode);
            this.asm.pushR64(0);
            this.genExpr(idxNode);
            this.asm.movRR64(1, 0);
            this.asm.shlR64Imm(1, 3);
            this.asm.popR64(0);
            this.asm.addRR64(0, 1);
            // Spill the element address: genExpr(rhs) is free to scratch
            // rax/r11 and may call.
            int addrOff = this.allocLocal("__idxassign_addr");
            this.asm.movMBaseR(5, 0, addrOff);
            Node lhsExpr = new Node();
            lhsExpr.kind = 24;
            lhsExpr.children.add(arrNode);
            lhsExpr.children.add(idxNode);
            if (op == 14 && this.isStringLike(lhsExpr)) {
                // String element: integer-add would combine heap pointers and
                // fault on next use. Concat through the shared machinery
                // (fresh heap buffer), then store back through the spilled
                // element address.
                Node concatBin = new Node();
                concatBin.kind = 7;
                concatBin.op = 1;
                concatBin.children.add(lhsExpr);
                concatBin.children.add(rhs);
                this.genStringConcat(concatBin);
                this.asm.movRMBase(1, 5, addrOff);
                this.asm.movMBaseR(1, 0, 0);
            } else if (this.isFloatLike(lhsExpr) && (op == 14 || op == 15 || op == 16 || op == 17)) {
                // Float element: SSE op on the double bits stored in the
                // slot, store the bits back (same XMM sequence as
                // genFloatBinary / the rs float element path).
                this.asm.movRMBase(0, 5, addrOff);
                this.asm.movRMBase(0, 0, 0);
                int bitsOff = this.allocLocal("__fassign_lhs");
                this.asm.movMBaseR(5, 0, bitsOff);
                this.genExpr(rhs);
                this.asm.movRR64(1, 0);
                this.asm.movRMBase(0, 5, bitsOff);
                this.emitMovqXmmGpr(0, 0);
                if (this.isFloatLike(rhs)) {
                    this.emitMovqXmmGpr(1, 1);
                } else {
                    this.emitCvtsi2sdXmmGpr(1, 1);
                }
                if (op == 14) { this.asm.addsdXMM(0, 1); }
                else if (op == 15) { this.asm.subsdXMM(0, 1); }
                else if (op == 16) { this.asm.mulsdXMM(0, 1); }
                else if (op == 17) { this.asm.divsdXMM(0, 1); }
                this.asm.movqR64XMM(0, 0);
                this.asm.movRMBase(1, 5, addrOff);
                this.asm.movMBaseR(1, 0, 0);
            } else {
                // Integer/bool/pointer element: load, op, store.
                this.asm.movRMBase(0, 5, addrOff);
                this.asm.movRMBase(0, 0, 0);
                this.asm.pushR64(0);
                this.genExpr(rhs);
                this.asm.movRR64(1, 0);
                this.asm.popR64(0);
                if (op == 14) { this.asm.addRR64(0, 1); }
                else if (op == 15) { this.asm.subRR64(0, 1); }
                else if (op == 16) { this.asm.mulRR64(1); }
                else if (op == 17) { this.emitDivisorCheck(); this.asm.cqo(); this.asm.idivR64(1); }
                else if (op == 29) { this.emitDivisorCheck(); this.asm.cqo(); this.asm.idivR64(1); this.asm.movRR64(0, 2); }
                else if (op == 30) { this.asm.andRR64(0, 1); }
                else if (op == 31) { this.asm.orRR64(0, 1); }
                else if (op == 32) { this.asm.xorRR64(0, 1); }
                else if (op == 33) { this.asm.movRR64(11, 1); this.asm.shlRCl64(0); }
                else if (op == 34) { this.asm.movRR64(11, 1); this.asm.shrRCl64(0); }
                this.asm.movRMBase(1, 5, addrOff);
                this.asm.movMBaseR(1, 0, 0);
            }
            return;
        }
        if (lhs.kind == 13 && lhs.childCount() >= 1) {
            Node obj = lhs.child(0);
            string fieldName = lhs.name;
            if (obj.kind == 6 && obj.name == "this") {
                int thisOff = this.findLocal("this");
                int fieldOff = this.findFieldOffset(this.currentClassName, fieldName);
                if (fieldOff < 0) { this.genExpr(rhs); return; }
                string fT = this.findFieldType(this.currentClassName, fieldName);
                if ((fT == "float" || fT == "float64" || fT == "double")
                    && (op == 14 || op == 15 || op == 16 || op == 17)) {
                    // Float field compound-assign: the field holds IEEE-754
                    // bits; the integer ops below corrupt them. Run the same
                    // XMM sequence as genFloatBinary on this+fieldOff
                    // (mirrors silverc-rs MemberAccess float dispatch).
                    int bitsOff = this.allocLocal("__fassign_lhs");
                    this.asm.movRMBase(0, 5, thisOff);
                    this.asm.movRMBase(0, 0, fieldOff);
                    this.asm.movMBaseR(5, 0, bitsOff);
                    this.genExpr(rhs);
                    this.asm.movRR64(1, 0);
                    this.asm.movRMBase(0, 5, bitsOff);
                    this.emitMovqXmmGpr(0, 0);
                    if (this.isFloatLike(rhs)) {
                        this.emitMovqXmmGpr(1, 1);
                    } else {
                        this.emitCvtsi2sdXmmGpr(1, 1);
                    }
                    if (op == 14) { this.asm.addsdXMM(0, 1); }
                    else if (op == 15) { this.asm.subsdXMM(0, 1); }
                    else if (op == 16) { this.asm.mulsdXMM(0, 1); }
                    else if (op == 17) { this.asm.divsdXMM(0, 1); }
                    this.asm.movqR64XMM(0, 0);
                    this.asm.movRMBase(10, 5, thisOff);
                    this.asm.addRI32(10, fieldOff);
                    this.asm.movMBaseR(10, 0, 0);
                    return;
                }
                if (fT == "string" && op == 14) {
                    // String field compound-assign: integer-add would combine
                    // heap pointers and fault on next use. Run the concat
                    // machinery (fresh buffer in rax) with the this.field lhs
                    // node, then store back through this+fieldOff. The old
                    // buffer is not freed — same ownership as string-local
                    // += and plain field assignment (mirrors silverc-rs).
                    this.genStringConcat(bin);
                    this.asm.movRMBase(10, 5, thisOff);
                    this.asm.addRI32(10, fieldOff);
                    this.asm.movMBaseR(10, 0, 0);
                    return;
                }
                this.asm.movRMBase(0, 5, thisOff);
                this.asm.movRMBase(0, 0, fieldOff);
                this.asm.pushR64(0);
                this.genExpr(rhs);
                this.asm.movRR64(1, 0);
                this.asm.popR64(0);
                if (op == 14) { this.asm.addRR64(0, 1); }
                else if (op == 15) { this.asm.subRR64(0, 1); }
                else if (op == 16) { this.asm.mulRR64(1); }
                else if (op == 17) { this.emitDivisorCheck(); this.asm.cqo(); this.asm.idivR64(1); }
                else if (op == 29) { this.emitDivisorCheck(); this.asm.cqo(); this.asm.idivR64(1); this.asm.movRR64(0, 2); }
                else if (op == 30) { this.asm.andRR64(0, 1); }
                else if (op == 31) { this.asm.orRR64(0, 1); }
                else if (op == 32) { this.asm.xorRR64(0, 1); }
                else if (op == 33) { this.asm.movRR64(11, 1); this.asm.shlRCl64(0); }
                else if (op == 34) { this.asm.movRR64(11, 1); this.asm.shrRCl64(0); }
                this.asm.movRMBase(10, 5, thisOff);
                this.asm.addRI32(10, fieldOff);
                this.asm.movMBaseR(10, 0, 0);
                return;
            }
            if (obj.kind == 6) {
                // obj.field op= rhs with a variable receiver: load the
                // receiver, read the current field value, apply the op to the
                // evaluated RHS, and store the result back through the same
                // receiver. The generic fallthrough below only evaluated the
                // RHS and discarded it, so every `obj.field += x` silently
                // kept the old value. Mirrors silverc-rs gen_binary's
                // MemberAccess compound-assignment branch (load current value,
                // push, evaluate RHS, integer op, store back).
                string varType = this.getLocalType(obj.name);
                int off = this.findLocal(obj.name);
                int gi = this.findGlobal(obj.name);
                string lookupType = varType;
                string elemType = this.arrayElementType(varType);
                if (elemType != "") { lookupType = elemType; }
                int fieldOff = this.findFieldOffset(lookupType, fieldName);
                if (fieldOff < 0) {
                    fieldOff = this.findFieldOffsetInAllClasses(fieldName);
                }
                string varFieldT = this.findFieldType(lookupType, fieldName);
                if ((varFieldT == "float" || varFieldT == "float64" || varFieldT == "double")
                    && (op == 14 || op == 15 || op == 16 || op == 17)
                    && fieldOff >= 0 && (off != 0 || gi >= 0)) {
                    // Float field compound-assign through a variable
                    // receiver: the field holds IEEE-754 bits; the integer
                    // ops below corrupt them. Spill the receiver (rax is
                    // scratch across genExpr), load the double bits, run the
                    // same XMM sequence as genFloatBinary, store the bits
                    // back through the spilled receiver (mirrors
                    // silverc-rs).
                    int objOff = this.allocLocal("__fassign_obj");
                    int bitsOff = this.allocLocal("__fassign_lhs");
                    if (off != 0) {
                        this.asm.movRMBase(0, 5, off);
                    } else {
                        this.genGlobalLoad(gi);
                    }
                    this.asm.movMBaseR(5, 0, objOff);
                    this.asm.movRMBase(0, 0, fieldOff);
                    this.asm.movMBaseR(5, 0, bitsOff);
                    this.genExpr(rhs);
                    this.asm.movRR64(1, 0);
                    this.asm.movRMBase(0, 5, bitsOff);
                    this.emitMovqXmmGpr(0, 0);
                    if (this.isFloatLike(rhs)) {
                        this.emitMovqXmmGpr(1, 1);
                    } else {
                        this.emitCvtsi2sdXmmGpr(1, 1);
                    }
                    if (op == 14) { this.asm.addsdXMM(0, 1); }
                    else if (op == 15) { this.asm.subsdXMM(0, 1); }
                    else if (op == 16) { this.asm.mulsdXMM(0, 1); }
                    else if (op == 17) { this.asm.divsdXMM(0, 1); }
                    this.asm.movqR64XMM(0, 0);
                    this.asm.movRMBase(11, 5, objOff);
                    this.asm.addRI32(11, fieldOff);
                    this.asm.movMBaseR(11, 0, 0);
                    return;
                }
                if (varFieldT == "string" && op == 14
                    && fieldOff >= 0 && (off != 0 || gi >= 0)) {
                    // String field compound-assign through a variable
                    // receiver: integer-add would combine heap pointers and
                    // fault on next use. Spill the receiver, run the concat
                    // machinery (fresh heap buffer in rax), then store back
                    // through the spilled receiver + fieldOff. The old
                    // buffer is not freed — same ownership as string-local
                    // += and plain field assignment (mirrors silverc-rs).
                    int objOff = this.allocLocal("__strassign_obj");
                    if (off != 0) {
                        this.asm.movRMBase(0, 5, off);
                    } else {
                        this.genGlobalLoad(gi);
                    }
                    this.asm.movMBaseR(5, 0, objOff);
                    this.genStringConcat(bin);
                    this.asm.movRMBase(11, 5, objOff);
                    this.asm.addRI32(11, fieldOff);
                    this.asm.movMBaseR(11, 0, 0);
                    return;
                }
                if (fieldOff >= 0 && (off != 0 || gi >= 0)) {
                    if (off != 0) {
                        this.asm.movRMBase(0, 5, off);
                    } else {
                        this.genGlobalLoad(gi);
                    }
                    this.asm.pushR64(0);
                    this.asm.movRMBase(0, 0, fieldOff);
                    this.asm.pushR64(0);
                    this.genExpr(rhs);
                    this.asm.movRR64(1, 0);
                    this.asm.popR64(0);
                    if (op == 14) { this.asm.addRR64(0, 1); }
                    else if (op == 15) { this.asm.subRR64(0, 1); }
                    else if (op == 16) { this.asm.mulRR64(1); }
                    else if (op == 17) { this.emitDivisorCheck(); this.asm.cqo(); this.asm.idivR64(1); }
                    else if (op == 29) { this.emitDivisorCheck(); this.asm.cqo(); this.asm.idivR64(1); this.asm.movRR64(0, 2); }
                    else if (op == 30) { this.asm.andRR64(0, 1); }
                    else if (op == 31) { this.asm.orRR64(0, 1); }
                    else if (op == 32) { this.asm.xorRR64(0, 1); }
                    else if (op == 33) { this.asm.movRR64(11, 1); this.asm.shlRCl64(0); }
                    else if (op == 34) { this.asm.movRR64(11, 1); this.asm.shrRCl64(0); }
                    this.asm.popR64(11);
                    this.asm.addRI32(11, fieldOff);
                    this.asm.movMBaseR(11, 0, 0);
                    return;
                }
            }
            if (obj.kind == 13) {
                // Nested member chain compound assign (e.g. this.inner.x += 1)
                string ownerType = this.inferMemberAccessType(obj);
                int fieldOff = this.findFieldOffset(ownerType, fieldName);
                if (fieldOff < 0) {
                    fieldOff = this.findFieldOffsetInAllClasses(fieldName);
                }
                if (fieldOff >= 0) {
                    this.genExpr(obj);
                    this.asm.pushR64(0);
                    this.genExpr(lhs);
                    this.asm.pushR64(0);
                    this.genExpr(rhs);
                    this.asm.movRR64(1, 0);
                    this.asm.popR64(0);
                    if (op == 14) { this.asm.addRR64(0, 1); }
                    else if (op == 15) { this.asm.subRR64(0, 1); }
                    else if (op == 16) { this.asm.mulRR64(1); }
                    else if (op == 17) { this.emitDivisorCheck(); this.asm.cqo(); this.asm.idivR64(1); }
                    else if (op == 29) { this.emitDivisorCheck(); this.asm.cqo(); this.asm.idivR64(1); this.asm.movRR64(0, 2); }
                    else if (op == 30) { this.asm.andRR64(0, 1); }
                    else if (op == 31) { this.asm.orRR64(0, 1); }
                    else if (op == 32) { this.asm.xorRR64(0, 1); }
                    else if (op == 33) { this.asm.movRR64(11, 1); this.asm.shlRCl64(0); }
                    else if (op == 34) { this.asm.movRR64(11, 1); this.asm.shrRCl64(0); }
                    this.asm.popR64(11);
                    this.asm.addRI32(11, fieldOff);
                    this.asm.movMBaseR(11, 0, 0);
                } else {
                    this.genExpr(rhs);
                }
                return;
            }
        }
        this.genExpr(rhs);
    }

    public void genAssign(Node bin) {
        Node lhs = bin.child(0);
        Node rhs = bin.child(1);
        if (lhs.kind == 13 && lhs.childCount() >= 1) {
            Node titleObj = lhs.child(0);
            if (titleObj.kind == 6 && titleObj.name == "console" && lhs.name == "title") {
                Node titleCall = new Node();
                titleCall.kind = 10;
                titleCall.name = "setTitle";
                titleCall.children = [rhs];
                this.genCall(titleCall);
                return;
            }
        }
        if (lhs.kind == 6) {
            this.requireResolvableAssignTarget(lhs);
            this.rejectGlobalWriteInAnonBody(lhs);
            int off = this.findLocal(lhs.name);
            int gi = this.findGlobal(lhs.name);
            if (rhs.kind == 74) {
                // Struct literal assigned to an existing struct variable:
                // build a fresh struct object with the variable's type.
                string lhsType = this.getLocalType(lhs.name);
                if (lhsType == "") { lhsType = this.getLocalType(lhs.name); }
                this.genStructLiteral(rhs, lhsType);
            } else {
                this.genExpr(rhs);
                this.coerceStoreToDouble(lhs, rhs);
            }
            // Declared-then-assigned objects (`FBox b; b = new FBox();`) and
            // untyped vars (`var v; v = new C();`) get their class registered
            // here, mirroring the rs Assign-time registration. rs
            // registers unless struct_vars already holds the name, and
            // struct_vars only ever holds class names, so the sh equivalent
            // guard is "the current type is not already a registered class".
            // Without it member accesses on the variable see no receiver
            // class: string fields stringify as the raw pointer and float
            // fields print as the bit pattern.
            string assignCurT = this.getLocalType(lhs.name);
            if (rhs.kind == 10 && !rhs.isMember && this.isClassName(rhs.name)) {
                if (off != 0 && !this.isClassName(assignCurT)) {
                    this.setLocalType(lhs.name, rhs.name);
                }
            } else if (rhs.kind == 10 && !rhs.isMember) {
                // Dotted-new assign: register the flattened class the same
                // way bare `v = new C()` does above.
                string dottedCls = this.dottedNewClassName(rhs.name);
                if (dottedCls.length > 0 && off != 0 && !this.isClassName(assignCurT)) {
                    this.setLocalType(lhs.name, dottedCls);
                }
            } else if (off != 0 && !this.isClassName(assignCurT)) {
                string rhsClass = this.findClassForExpr(rhs);
                if (rhsClass != "") {
                    this.setLocalType(lhs.name, rhsClass);
                }
            }
            if (off != 0) {
                if (this.isRefParam(lhs.name)) {
                    // Write through the reference to the caller's slot.
                    this.asm.pushR64(0);
                    this.asm.movRMBase(0, 5, off);
                    this.asm.popR64(1);
                    this.asm.movMBaseR(0, 1, 0);
                } else {
                    this.asm.movMBaseR(5, 0, off);
                }
            } else if (gi >= 0) {
                this.genGlobalStore(gi);
            } else if (this.currentClassName != "") {
                // Bare class field write: `field = value` inside a method
                // resolves to `this.field = value` (parity with silverc-rs).
                // The old fallback stored to [rbp+0], clobbering the saved
                // frame pointer and crashing on return.
                int fieldOff = this.findFieldOffset(this.currentClassName, lhs.name);
                if (fieldOff >= 0) {
                    int thisOff = this.findLocal("this");
                    if (thisOff != 0) {
                        this.asm.pushR64(0);
                        this.asm.movRMBase(0, 5, thisOff);
                        this.asm.addRI32(0, fieldOff);
                        this.asm.popR64(1);
                        this.asm.movMBaseR(0, 1, 0);
                    } else {
                        this.asm.movMBaseR(5, 0, 0);
                    }
                } else {
                    this.asm.movMBaseR(5, 0, 0);
                }
            } else {
                this.asm.movMBaseR(5, 0, 0);
            }
            return;
        }
        if (lhs.kind == 13 && lhs.childCount() >= 1) {
            Node obj = lhs.child(0);
            string fieldName = lhs.name;
            if (obj.kind == 6 && obj.name == "this") {
                int thisOff = this.findLocal("this");
                int fieldOff = this.findFieldOffset(this.currentClassName, fieldName);
                if (fieldOff < 0) {
                    this.genExpr(rhs);
                    return;
                }

                this.genExpr(rhs);
                this.coerceStoreToDouble(lhs, rhs);
                this.asm.pushR64(0);
                this.asm.movRMBase(0, 5, thisOff);
                this.asm.addRI32(0, fieldOff);
                this.asm.popR64(1);
                this.asm.movMBaseR(0, 1, 0);
                return;
            }
            if (obj.kind == 6) {
                string varType = this.getLocalType(obj.name);
                int off = this.findLocal(obj.name);
                int gi = this.findGlobal(obj.name);
                string lookupType = varType;
                string elemType = this.arrayElementType(varType);
                if (elemType != "") { lookupType = elemType; }
                int fieldOff = this.findFieldOffset(lookupType, fieldName);
                if (fieldOff < 0) {
                    this.genExpr(rhs);
                    return;
                }
                this.genExpr(rhs);
                this.coerceStoreToDouble(lhs, rhs);
                this.asm.pushR64(0);
                if (off != 0) {
                    this.asm.movRMBase(0, 5, off);
                } else if (gi >= 0) {
                    // Global object field write: load the object pointer from
                    // its global slot (findLocal returns 0 for globals, which
                    // would dereference [rbp+0] - the saved rbp - and crash).
                    this.genGlobalLoad(gi);
                } else {
                    this.asm.movRMBase(0, 5, 0);
                }
                this.asm.addRI32(0, fieldOff);
                this.asm.popR64(1);
                this.asm.movMBaseR(0, 1, 0);
                return;
            }
            if (obj.kind == 13) {
                // Nested member chain (e.g. this.inner.arr = rhs): evaluate the
                // owner object, then store the value into its field slot.
                string ownerType = this.inferMemberAccessType(obj);
                int fieldOff = this.findFieldOffset(ownerType, fieldName);
                if (fieldOff < 0) {
                    fieldOff = this.findFieldOffsetInAllClasses(fieldName);
                }
                if (fieldOff >= 0) {
                    this.genExpr(obj);
                    this.asm.pushR64(0);
                    this.genExpr(rhs);
                    this.coerceStoreToDouble(lhs, rhs);
                    this.asm.movRR64(12, 0);
                    this.asm.popR64(0);
                    this.asm.addRI32(0, fieldOff);
                    this.asm.movMBaseR(0, 12, 0);
                } else {
                    this.genExpr(rhs);
                }
                return;
            }
        }
        if (lhs.kind == 24 && lhs.childCount() >= 2) {
            Node arrNode = lhs.child(0);
            Node idxNode = lhs.child(1);
            if (this.isDictType(this.inferReceiverType(arrNode))) {
                this.genDictIndexSet(bin);
                return;
            }
            bool arrIsByte = false;
            if (arrNode.kind == 6) {
                arrIsByte = this.isByteElemType(this.getLocalType(arrNode.name));
            } else if (arrNode.kind == 13) {
                Node arrObj = arrNode.child(0);
                if (arrObj.kind == 6 && arrObj.name == "this") {
                    // Classify from the class field table directly.  The
                    // recursive inferExprType path is not stable in later
                    // self-hosted stages (see genArrayIndex), so `this.field`
                    // array stores must resolve the element size here.
                    arrIsByte = this.isByteElemType(this.findFieldType(this.currentClassName, arrNode.name));
                } else {
                    arrIsByte = this.isByteElemType(this.inferExprType(arrNode));
                }
            }
            if (arrNode.kind == 6 && this.findLocal(arrNode.name) != 0) {
                int arrOff = this.findLocal(arrNode.name);
                this.genExpr(idxNode);
                this.asm.pushR64(0);
                this.genExpr(rhs);
                this.coerceStoreToDouble(lhs, rhs);
                this.asm.pushR64(0);
                this.asm.movRMBase(11, 5, arrOff);
                this.asm.popR64(12);
                this.asm.popR64(0);
                if (!arrIsByte) { this.asm.shlR64Imm(0, 3); }
                this.asm.addRR64(11, 0);
                if (arrIsByte) {
                    this.asm.movMBaseByteR(11, 12, 0);
                } else {
                    this.asm.movMBaseR(11, 12, 0);
                }
                this.asm.movRI64(0, 0);
                return;
            } else {
                // Mirror the rs plain-assign Index lowering: gen_expr(arr)
                // yields the array base for locals AND globals (globals load
                // through their storage slot). The old findLocal-only arm
                // stored globals through [rbp+0] - the saved rbp - and
                // crashed on return.
                this.genExpr(arrNode);
                this.asm.pushR64(0);
                this.genExpr(idxNode);
                if (!arrIsByte) { this.asm.shlR64Imm(0, 3); }
                this.asm.movRR64(11, 0);
                this.asm.popR64(0);
                this.asm.addRR64(0, 11);
                this.asm.pushR64(0);
                this.genExpr(rhs);
                this.coerceStoreToDouble(lhs, rhs);
                this.asm.movRR64(12, 0);
                this.asm.popR64(0);
                if (arrIsByte) {
                    this.asm.movMBaseByteR(0, 12, 0);
                } else {
                    this.asm.movMBaseR(0, 12, 0);
                }
                this.asm.movRI64(0, 0);
                return;
            }
        }
        this.genExpr(rhs);
    }

    public void genPostIncDec(Node bin, bool plus) {
        // Post-increment `x++` / post-decrement `x--` must evaluate to the
        // OLD value of the target while storing old +/- 1 (parity with the
        // Rust bootstrap's PostInc/PostDec codegen). The old value is stashed
        // on the runtime stack before the store and restored into RAX after.
        Node lhs = bin.child(0);
        if (lhs.kind == 6) {
            this.requireResolvableAssignTarget(lhs);
            this.rejectGlobalWriteInAnonBody(lhs);
            int off = this.findLocal(lhs.name);
            int gi = this.findGlobal(lhs.name);
            if (off != 0) {
                this.asm.movRMBase(0, 5, off);
                if (this.isRefParam(lhs.name)) { this.asm.movRMBase(0, 0, 0); }
                this.asm.pushR64(0);
                if (plus) { this.asm.addRI32(0, 1); }
                else { this.asm.subRI32(0, 1); }
                if (this.isRefParam(lhs.name)) {
                    this.asm.pushR64(0);
                    this.asm.movRMBase(0, 5, off);
                    this.asm.popR64(1);
                    this.asm.movMBaseR(0, 1, 0);
                } else {
                    this.asm.movMBaseR(5, 0, off);
                }
                this.asm.popR64(0);
                return;
            }
            if (gi >= 0) {
                this.genGlobalLoad(gi);
                this.asm.pushR64(0);
                if (plus) { this.asm.addRI32(0, 1); }
                else { this.asm.subRI32(0, 1); }
                this.genGlobalStore(gi);
                this.asm.popR64(0);
                return;
            }
            if (this.currentClassName != "") {
                int fieldOff = this.findFieldOffset(this.currentClassName, lhs.name);
                int thisOff = this.findLocal("this");
                if (fieldOff >= 0 && thisOff != 0) {
                    this.asm.movRMBase(0, 5, thisOff);
                    this.asm.movRMBase(0, 0, fieldOff);
                    this.asm.pushR64(0);
                    if (plus) { this.asm.addRI32(0, 1); }
                    else { this.asm.subRI32(0, 1); }
                    this.asm.pushR64(0);
                    this.asm.movRMBase(10, 5, thisOff);
                    this.asm.addRI32(10, fieldOff);
                    this.asm.popR64(1);
                    this.asm.movMBaseR(10, 1, 0);
                    this.asm.popR64(0);
                    return;
                }
            }
        }
        if (lhs.kind == 13 && lhs.childCount() >= 1) {
            Node obj = lhs.child(0);
            int fieldOff = -1;
            int objOff = 0;
            int objGi = -1;
            if (obj.kind == 6 && obj.name == "this") {
                int thisOff = this.findLocal("this");
                fieldOff = this.findFieldOffset(this.currentClassName, lhs.name);
                objOff = thisOff;
            } else if (obj.kind == 6) {
                string varType = this.getLocalType(obj.name);
                string lookupType = varType;
                string elemType = this.arrayElementType(varType);
                if (elemType != "") { lookupType = elemType; }
                fieldOff = this.findFieldOffset(lookupType, lhs.name);
                objOff = this.findLocal(obj.name);
                objGi = this.findGlobal(obj.name);
            }
            if (fieldOff >= 0 && objOff != 0) {
                this.asm.movRMBase(0, 5, objOff);
                this.asm.movRMBase(0, 0, fieldOff);
                this.asm.pushR64(0);
                if (plus) { this.asm.addRI32(0, 1); }
                else { this.asm.subRI32(0, 1); }
                this.asm.pushR64(0);
                this.asm.movRMBase(10, 5, objOff);
                this.asm.addRI32(10, fieldOff);
                this.asm.popR64(1);
                this.asm.movMBaseR(10, 1, 0);
                this.asm.popR64(0);
                return;
            }
            if (fieldOff >= 0 && objGi >= 0) {
                this.genGlobalLoad(objGi);
                this.asm.movRMBase(0, 0, fieldOff);
                this.asm.pushR64(0);
                if (plus) { this.asm.addRI32(0, 1); }
                else { this.asm.subRI32(0, 1); }
                this.asm.pushR64(0);
                this.genGlobalLoad(objGi);
                this.asm.addRI32(0, fieldOff);
                this.asm.popR64(1);
                this.asm.movMBaseR(0, 1, 0);
                this.asm.popR64(0);
                return;
            }
        }
        // Non-identifier lvalues (array elements, nested member chains) fall
        // back to compound-assignment semantics; the value yielded is the
        // updated one, mirroring the Rust bootstrap.
        if (plus) { this.genCompoundAssign(bin, 14); }
        else { this.genCompoundAssign(bin, 15); }
    }

    public void genRangeArray(Node bin) {
        // `a..b` builds an int array a, a+1, ..., b-1 (end exclusive), using
        // the same negative-header layout as array literals: the returned
        // pointer addresses element 0, with capacity at ptr-16 and length at
        // ptr-8.
        this.genExpr(bin.child(0));
        int startOff = this.allocLocal("__range_start");
        this.asm.movMBaseR(5, 0, startOff);
        this.genExpr(bin.child(1));
        int endOff = this.allocLocal("__range_end");
        this.asm.movMBaseR(5, 0, endOff);
        this.asm.movRMBase(0, 5, endOff);
        this.asm.movRMBase(1, 5, startOff);
        this.asm.subRR64(0, 1);
        int negLbl = this.newLabel();
        int lenDone = this.newLabel();
        this.asm.cmpRI32(0, 0);
        this.asm.jlLabel(negLbl);
        this.asm.jmpLabel(lenDone);
        this.asm.bindLabel(negLbl);
        this.asm.movRI64(0, 0);
        this.asm.bindLabel(lenDone);
        int lenOff = this.allocLocal("__range_len");
        this.asm.movMBaseR(5, 0, lenOff);
        int capGe = this.newLabel();
        int capDone = this.newLabel();
        this.asm.movRMBase(0, 5, lenOff);
        this.asm.cmpRI32(0, 8);
        this.asm.jgeLabel(capGe);
        this.asm.movRI64(0, 8);
        this.asm.jmpLabel(capDone);
        this.asm.bindLabel(capGe);
        this.asm.bindLabel(capDone);
        int capOff = this.allocLocal("__range_cap");
        this.asm.movMBaseR(5, 0, capOff);
        this.asm.movRMBase(0, 5, capOff);
        this.asm.addRI32(0, 2);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(1, 0);
        this.addImportPatch("msvcrt.dll", "malloc");
        int sRange = 0xDEADBEEFCAFEBAB0;
        this.asm.emitImm64(0, sRange);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int arrOff = this.allocLocal("__range_arr");
        this.asm.movMBaseR(5, 0, arrOff);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(1, 5, capOff);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.movMBaseR(0, 1, 8);
        int iOff = this.allocLocal("__range_i");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, iOff);
        int loopStart = this.newLabel();
        int loopEnd = this.newLabel();
        this.asm.bindLabel(loopStart);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(loopEnd);
        this.asm.movRMBase(0, 5, startOff);
        this.asm.movRMBase(1, 5, iOff);
        this.asm.addRR64(0, 1);
        this.asm.movRMBase(11, 5, arrOff);
        this.asm.addRI32(11, 16);
        this.asm.movRMBase(12, 5, iOff);
        this.asm.shlR64Imm(12, 3);
        this.asm.addRR64(11, 12);
        this.asm.movMBaseR(11, 0, 0);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(loopStart);
        this.asm.bindLabel(loopEnd);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.addRI32(0, 16);
    }

    public void addFormatStr(string fmt) {
        int fmtIdx = this.addString(fmt);
        int sp = this.asm.buf.length;
        this.asm.emitImm64(0, 0);
        int fmtPatchPos = sp + 2;
        this.stringPatchOffsets.add(fmtPatchPos);
        this.stringPatchIndices.add(fmtIdx);
        this.asm.movRR64(1, 0);
    }

    public bool isByteElemType(string t) {
        // True when an array type stores single bytes per element (byte[],
        // char[], and the internal string representation).  Such arrays must
        // be indexed without the *8 scaling used for 64-bit element types and
        // accessed with byte loads/stores instead of full-width moves.
        if (t == "byte[]") { return true; }
        if (t == "char[]") { return true; }
        if (t == "string") { return true; }
        return false;
    }

    public bool isStringLike(Node expr) {
        // Characters are represented as integer code points in the native
        // printf path.  Treat only actual strings as `%s`; passing a char
        // value to `%s` makes printf dereference the code point as a pointer.
        if (expr.kind == 2) { return true; }
        if (expr.kind == 6) {
            string t = this.getLocalType(expr.name);
            if (t == "") {
                for (int ci = 0; ci < this.constNames.length; ci++) {
                    if (this.constNames[ci] == expr.name) {
                        if (ci < this.constStringValues.length && this.constStringValues[ci] != "") {
                            return true;
                        }
                    }
                }
            }
            return t == "string";
        }
        if (expr.kind == 13) {
            string t = this.inferMemberAccessType(expr);
            return t == "string";
        }
        if (expr.kind == 24) {
            string t = this.inferExprType(expr);
            return t == "string";
        }
        if (expr.kind == 67) {
            // A slice `s[a..b]` of a string is a string; its kind (67) is not
            // otherwise recognized here, so without this case printline fell
            // back to %lld and printed the raw slice pointer.
            string t = this.inferExprType(expr);
            return t == "string";
        }
        if (expr.kind == 10) {
            string t = this.inferExprType(expr);
            return t == "string";
        }
        if (expr.kind == 7) {
            int op = expr.op;
            if (op == 1) {
                if (this.isStringLike(expr.child(0))) { return true; }
                if (this.isStringLike(expr.child(1))) { return true; }
            }
        }
        if (expr.kind == 69) {
            return true;
        }
        return false;
    }

    public bool isCharExpr(Node expr) {
        if (expr.kind == 3) { return true; }
        if (expr.kind == 6) {
            string t = this.getLocalType(expr.name);
            return t == "char" || t == "char?";
        }
        if (expr.kind == 24) {
            if (expr.childCount() > 0) { return this.inferExprType(expr.child(0)) == "string"; }
            return false;
        }
        if (expr.kind == 23) {
            if (expr.childCount() > 0) { return this.isCharExpr(expr.child(0)); }
            return false;
        }
        if (expr.kind == 10) {
            if (!expr.isMember && expr.name == "char") { return true; }
            return this.inferExprType(expr) == "char";
        }
        return false;
    }

    public bool isFloatLike(Node expr) {
        // True for expressions that evaluate to a float64/float/double: float
        // literals (kind 1), float locals/fields, and arithmetic on floats.
        // These must be printed with %g (the IEEE-754 bits travel in the same
        // GP register as an integer; the shadow stack lets printf read them as
        // a double), matching silverc-rs's "varargs FP in the positional GP
        // register" convention.
        if (expr.kind == 1) { return true; }
        if (expr.kind == 6) {
            string t = this.getLocalType(expr.name);
            if (t == "float" || t == "float64" || t == "double") { return true; }
            for (int ci = 0; ci < this.constNames.length; ci++) {
                if (this.constNames[ci] == expr.name) {
                    if (ci < this.constIsString.length && this.constIsString[ci] == 1) { return false; }
                    return false;
                }
            }
            return false;
        }
        if (expr.kind == 13) {
            string t = this.inferMemberAccessType(expr);
            return t == "float" || t == "float64" || t == "double";
        }
        if (expr.kind == 24) {
            string t = this.inferExprType(expr);
            if (t == "float" || t == "float64" || t == "double") { return true; }
            // Element reads on arrays whose declared element type is float64
            // hold double bit patterns too (mirrors the rs is_float_expr
            // Index arm). inferExprType covers local/global declared types;
            // bare class fields (`farr[i]` meaning this.farr) and member
            // receivers (`this.farr[i]`, `obj.farr[i]`, including objects
            // whose class was only registered at assignment time) resolve
            // through the class field tables here.
            if (expr.childCount() > 0) {
                Node arrNode = expr.child(0);
                string ft = "";
                if (arrNode.kind == 6) {
                    if (this.currentClassName != "") {
                        ft = this.findFieldType(this.currentClassName, arrNode.name);
                    }
                } else if (arrNode.kind == 13 && arrNode.childCount() > 0) {
                    string ownerT = this.inferReceiverType(arrNode.child(0));
                    if (ownerT != "") {
                        ft = this.findFieldType(ownerT, arrNode.name);
                    }
                }
                if (ft.length >= 2 && ft[ft.length - 2] == '[' && ft[ft.length - 1] == ']') {
                    string inner = this.arrayElementType(ft);
                    if (inner == "float" || inner == "float64" || inner == "double") { return true; }
                }
            }
        }
        if (expr.kind == 7) {
            int fop = expr.op;
            if (fop == 1 || fop == 2 || fop == 3 || fop == 4 || fop == 13) {
                if (this.isFloatLike(expr.child(0))) { return true; }
                if (this.isFloatLike(expr.child(1))) { return true; }
            }
        }
        if (expr.kind == 23) {
            if (expr.childCount() > 0) { return this.isFloatLike(expr.child(0)); }
        }
        if (expr.kind == 8) {
            // Unary minus of a float operand is a float (sign-bit flip),
            // matching silverc-rs is_float_expr(UnaryOp::Neg).
            if (expr.op == 0 && expr.childCount() > 0) { return this.isFloatLike(expr.child(0)); }
        }
        if (expr.kind == 10 || expr.kind == 9) {
            string cn = expr.name;
            // float(x) / float64(x) / double(x) free conversions produce an
            // IEEE-754 double bit pattern. silverc-rs's parser normalizes all
            // three spellings to double() and is_float_expr matches them here.
            if (!expr.isMember && (cn == "float" || cn == "double" || cn == "float64")) { return true; }
            if ((cn == "toFloat" || cn == "toFloat64") && expr.isMember && expr.childCount() > 0) {
                string crt = this.inferExprType(expr.child(0));
                if (crt == "float" || crt == "float64" || crt == "double"
                    || crt == "int" || crt == "int32" || crt == "int64"
                    || crt == "uint" || crt == "bool" || crt == "char") {
                    return true;
                }
            }
            // Free function / member call whose declared return type is a
            // float (e.g. the interpreter's valueToFloat / floatStrToF64):
            // the result travels as IEEE-754 bits and must be printed with %g.
            for (int ri = 0; ri < this.funcNames.length; ri++) {
                if (this.funcNames[ri] == cn && this.funcClasses[ri] == "") {
                    string frt = this.funcRetTypes[ri];
                    if (frt == "float" || frt == "float64" || frt == "double") {
                        return true;
                    }
                    break;
                }
            }
        }
        return false;
    }

    // True when an integer value must be widened before it lands in a
    // float64 slot: the value expression is not already a double, and is not
    // a string/char (those never convert).  Shared by the two coercion
    // helpers below so declaration and assignment agree.
    public bool floatStoreNeedsWiden(Node rhs) {
        if (this.isFloatLike(rhs)) { return false; }
        if (this.isStringLike(rhs)) { return false; }
        string rt = this.inferExprType(rhs);
        if (rt == "string") { return false; }
        if (rt == "char") { return false; }
        return true;
    }

    // Convert the integer already in RAX to its IEEE-754 double bit pattern
    // when the assignment destination is a declared float64 slot.  Mirrors
    // silverc-rs coerce_int_rhs_to_float: without it `d = n`, `obj.f = n` and
    // `pts[i] = n` stored the raw integer into a double slot and every later
    // read came back a denormal (3 read back as 1.4822e-323).  isFloatLike
    // resolves the destination's declared type through the same local/field/
    // array tables the read path uses, so the two directions cannot disagree.
    public void coerceStoreToDouble(Node lhs, Node rhs) {
        if (!this.isFloatLike(lhs)) { return; }
        if (!this.floatStoreNeedsWiden(rhs)) { return; }
        this.emitCvtsi2sdRax();
        this.asm.movqR64XMM(0, 0);
    }

    // Same conversion driven by a declared type name rather than an lhs node:
    // the `double d = n;` declaration path knows its destination only from the
    // statement's type hint.
    public void coerceDeclToDouble(string declType, Node rhs) {
        bool isFlt = declType == "float";
        if (declType == "float64") { isFlt = true; }
        if (declType == "double") { isFlt = true; }
        if (!isFlt) { return; }
        if (!this.floatStoreNeedsWiden(rhs)) { return; }
        this.emitCvtsi2sdRax();
        this.asm.movqR64XMM(0, 0);
    }

    // LINUX SysV backend (additive): shared float-aware variadic tail for
    // printf (one fixed arg: RDI=fmt) and sprintf (two: RDI=dest, RSI=fmt).
    // GP values fill the remaining registers, floats ride XMM0-7, the rest
    // spills at [RSP+0]; AL carries the live XMM count through an R10-staged
    // call (mirrors silverc-rs emit_printf_call / interp emission).
    public void emitLinuxVariadicTail(string lib, string fn, int[] fixedOffs, int[] valOffs, Node[] vals) {
        this.linuxBackend.emitLinuxVariadicTail(this, lib, fn, fixedOffs, valOffs, vals);
    }

    // LINUX SysV backend (additive): sprintf(buf, fmt, value) where RCX=buf,
    // RDX=fmt, R8=value-bits are already staged (join/float paths below).
    // Shuffles to RDI/RSI/RDX, stages XMM0 + AL for %g floats, and calls
    // through an R10-staged GOT slot.
    public void emitLinuxSprintfStaged(bool isFloat) {
        this.linuxBackend.emitLinuxSprintfStaged(this, isFloat);
    }

    public void genPrintCall(Node call, bool newline) {
        if (call.childCount() < 1) { return; }
        Node arg = call.child(0);
        bool fltArg = false;
        if (arg.kind == 2) {
            string s = arg.strVal;
            if (newline) { s += "\n"; }
            int strIdx = this.addString(s);
            int sp = this.asm.buf.length;
            this.asm.emitImm64(0, 0);

            int strPatchPos = sp + 2;
            this.stringPatchOffsets.add(strPatchPos);
            this.stringPatchIndices.add(strIdx);
            this.asm.movRR64(1, 0);
        } else if (arg.kind == 69) {
            // Interpolated string `$"text {expr} ..."`: children are literal
            // text nodes (kind 2) interleaved with expression nodes.  Build a
            // printf format string (escaping `%` and using %lld/%s per part),
            // spill the evaluated expressions, then call printf.
            string fmt = "";
            Node[] exprs = [];
            for (int pi = 0; pi < arg.childCount(); pi++) {
                Node part = arg.child(pi);
                if (part.kind == 2) {
                    string txt = part.strVal;
                    for (int ci = 0; ci < txt.length; ci++) {
                        if (txt[ci] == '%') { fmt += "%%"; }
                        else { fmt += charToString(txt[ci]); }
                    }
                } else {
                    if (this.isStringLike(part)) { fmt += "%s"; }
                    else if (this.isFloatLike(part)) { fmt += "%g"; }
                    else { fmt += "%lld"; }
                    exprs.add(part);
                }
            }
            if (newline) { fmt += "\n"; }
            int strIdx = this.addString(fmt);
            int sp0 = this.asm.buf.length;
            this.asm.emitImm64(0, 0);
            this.stringPatchOffsets.add(sp0 + 2);
            this.stringPatchIndices.add(strIdx);
            int fmtOff = this.allocLocal("__interp_fmt");
            this.asm.movMBaseR(5, 0, fmtOff);
            int[] argOffs = [];
            for (int ei = 0; ei < exprs.length; ei++) {
                this.genExpr(exprs[ei]);
                int ao = this.allocLocal("__interp_arg");
                this.asm.movMBaseR(5, 0, ao);
                argOffs.add(ao);
            }
            int extraStack = 0;
            if (exprs.length > 3) { extraStack = (exprs.length - 3) * 8; }
            // LINUX SysV backend (additive): float-aware variadic tail
            // (RDI=fmt, GP/XMM split, AL count). WINDOWS below unchanged.
            if (this.isLinuxTarget()) {
                int[] fixedOffs = [];
                fixedOffs.add(fmtOff);
                this.emitLinuxVariadicTail("libc.so.6", "printf", fixedOffs, argOffs, exprs);
            } else {
                this.asm.emitCallSetup(extraStack);
                this.asm.movRMBase(1, 5, fmtOff);
                int[] argRegs = [2, 8, 9];
                for (int ai = 0; ai < exprs.length && ai < 3; ai++) {
                    this.asm.movRMBase(argRegs[ai], 5, argOffs[ai]);
                }
                for (int ai = 3; ai < exprs.length; ai++) {
                    this.asm.movRMBase(0, 5, argOffs[ai]);
                    this.asm.movMBaseR(4, 0, 32 + (ai - 3) * 8);
                }
                this.addImportPatch("msvcrt.dll", "printf");
                int s1 = 0xDEADBEEFCAFEBAD0;
                this.asm.emitImm64(0, s1);
                this.asm.movRMBase(0, 0, 0);
                this.asm.callR64(0);
                this.asm.emitCallTeardown();
            }
        } else {
            this.genExpr(arg);
            bool charLike = this.isCharExpr(arg);
            if (charLike) { this.asm.andRImm(0, 0xFF); }
            this.asm.pushR64(0);
            bool strLike = this.isStringLike(arg);
            bool fltLike = this.isFloatLike(arg);
            if (fltLike) { fltArg = true; }
            if (newline) {
                if (strLike) { this.addFormatStr("%s\n"); }
                else if (fltLike) { this.addFormatStr("%g\n"); }
                else if (charLike) { this.addFormatStr("%c\n"); }
                else { this.addFormatStr("%lld\n"); }
            } else {
                if (strLike) { this.addFormatStr("%s"); }
                else if (fltLike) { this.addFormatStr("%g"); }
                else if (charLike) { this.addFormatStr("%c"); }
                else { this.addFormatStr("%lld"); }
            }
            this.asm.popR64(2);
        }
        if (arg.kind != 69) {
        // The shared patch below serves both WINDOWS tails; the Linux tail
        // records its own Direct patch (a second record here would point at
        // stale bytes).
        if (!this.isLinuxTarget()) {
            this.addImportPatch("msvcrt.dll", "printf");
        }
        int s1 = 0xDEADBEEFCAFEBAD0;
        // LINUX SysV backend (additive): RDI=fmt, RSI=value, XMM0=value +
        // AL=1 for floats, AL=0 otherwise, through an R10-staged call.
        // Both WINDOWS shapes below are byte-identical to before.
        if (this.isLinuxTarget()) {
            this.asm.movRR64(7, 1);
            this.asm.movRR64(6, 2);
            if (fltArg) {
                this.emitMovqXmmGpr(0, 6);
            }
            this.emitAbiCallSetup(0);
            this.addImportPatchDirect("libc.so.6", "printf");
            this.asm.emitImm64(0, 0);
            this.asm.movRMBase(10, 0, 0);
            this.asm.xorRR64(0, 0);
            if (fltArg) {
                this.asm.incR64(0);
            }
            this.asm.callR64(10);
            this.emitAbiCallTeardown();
        } else if (fltArg) {
            // Varargs FP call: stage the printf pointer through R10 so the
            // AL vector-count immediate cannot clobber it, then set AL=1 --
            // mirrors silverc-rs emit_printf_call(1) byte for byte.
            this.asm.emitImm64(0, s1);
            this.asm.emitCallSetup(0);
            this.asm.movRMBase(10, 0, 0);
            this.asm.movRI64(0, 1);
            this.asm.callR64(10);
            this.asm.emitCallTeardown();
        } else {
            this.asm.emitImm64(0, s1);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
        }
        }
    }

    public void genEprintCall(Node call, bool newline) {
        // OVERHAUL.md CLI diagnostics: write one message to the standard
        // error handle (GetStdHandle(STD_ERROR_HANDLE) + WriteFile). Only
        // string arguments reach this path -- every compiler diagnostic is
        // built by string concatenation before printing.
        // LINUX SysV backend (additive): write(2, msg, len) instead.
        if (this.isLinuxTarget()) {
            this.genLinuxEprintCall(call, newline);
            return;
        }
        if (call.childCount() < 1) { return; }
        Node arg = call.child(0);
        this.genExpr(arg);
        int msgOff = this.allocLocal("__emsg");
        this.asm.movMBaseR(5, 0, msgOff);
        int lenOff = this.allocLocal("__elen");
        int hOff = this.allocLocal("__ehnd");
        int wroteOff = this.allocLocal("__ewrote");
        this.asm.movRMBase(1, 5, msgOff);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD1);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, lenOff);
        this.asm.emitCallSetup(0);
        this.asm.movRI64(1, -12);
        this.addImportPatch("kernel32.dll", "GetStdHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, hOff);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hOff);
        this.asm.movRMBase(2, 5, msgOff);
        this.asm.movRMBase(8, 5, lenOff);
        this.asm.leaRBase(9, 5, wroteOff);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(4, 0, 32);
        this.addImportPatch("kernel32.dll", "WriteFile");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        if (newline) {
            int nlIdx = this.addString("\n");
            int sp = this.asm.buf.length;
            this.asm.emitImm64(0, 0);
            this.stringPatchOffsets.add(sp + 2);
            this.stringPatchIndices.add(nlIdx);
            this.asm.emitCallSetup(0);
            this.asm.movRR64(2, 0);
            this.asm.movRMBase(1, 5, hOff);
            this.asm.movRI64(8, 1);
            this.asm.leaRBase(9, 5, wroteOff);
            this.asm.xorRR64(0, 0);
            this.asm.movMBaseR(4, 0, 32);
            this.addImportPatch("kernel32.dll", "WriteFile");
            this.asm.emitImm64(0, 0);
            this.asm.movRMBase(0, 0, 0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
        }
    }

    // LINUX SysV backend (additive): write(2, msg, len) (+ "\n"), mirroring
    // silverc-rs emit_stderr_write_linux. Only string arguments reach here.
    public void genLinuxEprintCall(Node call, bool newline) {
        this.linuxBackend.genLinuxEprintCall(this, call, newline);
    }

    public void genCharToString(Node expr) {
        this.genExpr(expr);
        int chOff = this.allocLocal("__c2s_ch");
        this.asm.movMBaseR(5, 0, chOff);
        this.asm.movRI64(1, 2);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRMBase(1, 5, chOff);
        this.asm.andRImm(1, 0xFF);
        this.asm.movMBaseByteR(0, 1, 0);
        this.asm.movRI64(2, 0);
        this.asm.movMBaseByteR(0, 2, 1);
    }

    public void genStringInterpValue(Node arg) {
        // Interpolated string `$"text {expr} ..."` as a general expression
        // (assigned to a variable, passed as an argument, ...): sprintf the
        // parts into a freshly malloc'd buffer and leave the buffer pointer in
        // RAX. Mirrors the Rust bootstrap's gen_string_interp_value.
        string fmt = "";
        Node[] exprs = [];
        for (int pi = 0; pi < arg.childCount(); pi++) {
            Node part = arg.child(pi);
            if (part.kind == 2) {
                string txt = part.strVal;
                for (int ci = 0; ci < txt.length; ci++) {
                    if (txt[ci] == '%') { fmt += "%%"; }
                    else { fmt += charToString(txt[ci]); }
                }
            } else {
                if (this.isStringLike(part)) { fmt += "%s"; }
                else if (this.isFloatLike(part)) { fmt += "%g"; }
                else { fmt += "%lld"; }
                exprs.add(part);
            }
        }
        int strIdx = this.addString(fmt);
        int sp = this.asm.buf.length;
        this.asm.emitImm64(0, 0);
        this.stringPatchOffsets.add(sp + 2);
        this.stringPatchIndices.add(strIdx);
        int fmtOff = this.allocLocal("__interp_val_fmt");
        this.asm.movMBaseR(5, 0, fmtOff);
        this.asm.movRI64(1, 512);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int bufOff = this.allocLocal("__interp_val_buf");
        this.asm.movMBaseR(5, 0, bufOff);
        int[] argOffs = [];
        for (int ei = 0; ei < exprs.length; ei++) {
            this.genExpr(exprs[ei]);
            int ao = this.allocLocal("__interp_val_arg");
            this.asm.movMBaseR(5, 0, ao);
            argOffs.add(ao);
        }
        int extraStack = 0;
        if (exprs.length > 2) { extraStack = (exprs.length - 2) * 8; }
        // LINUX SysV backend (additive): float-aware variadic tail
        // (RDI=buf, RSI=fmt, GP/XMM split, AL count). WINDOWS below unchanged.
        if (this.isLinuxTarget()) {
            int[] fixedOffs = [];
            fixedOffs.add(bufOff);
            fixedOffs.add(fmtOff);
            this.emitLinuxVariadicTail("libc.so.6", "sprintf", fixedOffs, argOffs, exprs);
        } else {
            this.asm.emitCallSetup(extraStack);
            this.asm.movRMBase(1, 5, bufOff);
            this.asm.movRMBase(2, 5, fmtOff);
            int[] argRegs = [8, 9];
            for (int ai = 0; ai < exprs.length && ai < 2; ai++) {
                this.asm.movRMBase(argRegs[ai], 5, argOffs[ai]);
            }
            for (int ai = 2; ai < exprs.length; ai++) {
                this.asm.movRMBase(0, 5, argOffs[ai]);
                this.asm.movMBaseR(4, 0, 32 + (ai - 2) * 8);
            }
            this.addImportPatch("msvcrt.dll", "sprintf");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD6);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
        }
        this.asm.movRMBase(0, 5, bufOff);
    }

    // ---- json.stringify lowering (silverc-rs stdlib/json.rs parity) ----

    // Emit a NUL-terminated string literal address into RAX via the string
    // patch table.
    public void genJsonLit(string text) {
        int litIdx = this.addString(text);
        int sp = this.asm.buf.length;
        this.asm.emitImm64(0, 0);
        this.stringPatchOffsets.add(sp + 2);
        this.stringPatchIndices.add(litIdx);
    }

    // RAX holds a string; replace it with a heap copy wrapped in JSON
    // quotes: '"' text '"' NUL (no escaping, matching silverc-rs).
    public void genJsonQuote() {
        int srcOff = this.allocLocal("__jq_src");
        this.asm.movMBaseR(5, 0, srcOff);
        int lenOff = this.allocLocal("__jq_len");
        this.asm.movRMBase(1, 5, srcOff);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD1);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, lenOff);
        // buf = malloc(len + 3)
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.addRI32(1, 3);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int bufOff = this.allocLocal("__jq_buf");
        this.asm.movMBaseR(5, 0, bufOff);
        // buf[0] = '"'
        this.asm.movRMBase(1, 5, bufOff);
        this.asm.movRI64(2, 34);
        this.asm.movMBaseByteR(1, 2, 0);
        // memcpy(buf + 1, src, len)
        this.asm.movRMBase(1, 5, bufOff);
        this.asm.addRI32(1, 1);
        this.asm.movRMBase(2, 5, srcOff);
        this.asm.movRMBase(8, 5, lenOff);
        this.addImportPatch("msvcrt.dll", "memcpy");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAE0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        // buf[1 + len] = '"'
        this.asm.movRMBase(1, 5, bufOff);
        this.asm.addRI32(1, 1);
        this.asm.movRMBase(2, 5, lenOff);
        this.asm.addRR64(1, 2);
        this.asm.movRI64(2, 34);
        this.asm.movMBaseByteR(1, 2, 0);
        // buf[2 + len] = 0 (malloc memory is not zeroed)
        this.asm.movRMBase(1, 5, bufOff);
        this.asm.addRI32(1, 2);
        this.asm.movRMBase(2, 5, lenOff);
        this.asm.addRR64(1, 2);
        this.asm.xorRR64(2, 2);
        this.asm.movMBaseByteR(1, 2, 0);
        this.asm.movRMBase(0, 5, bufOff);
    }

    // json.stringify entry: classify the argument and lower to JSON text.
    // Mirrors silverc-rs stdlib/json.rs gen_json_stringify: string -> quoted,
    // float -> %g, bool literal -> true/false, array -> [...], integer-ish ->
    // decimal, anything else -> null.
    public void genJsonStringify(Node call) {
        if (call.childCount() < 2) { this.genJsonLit("null"); return; }
        Node arg = call.child(1);
        string t = this.inferExprType(arg);
        bool isArr = t.length >= 2 && t[t.length - 2] == '[' && t[t.length - 1] == ']';
        if (arg.kind == 2 || t == "string") {
            this.genExpr(arg);
            this.genJsonQuote();
            return;
        }
        if (t == "float" || t == "float64" || t == "double") {
            this.genFloatToString(arg);
            return;
        }
        if (arg.kind == 4) {
            // Boolean literal: boolVal = true -> "true", else "false".
            if (arg.boolVal) { this.genJsonLit("true"); }
            else { this.genJsonLit("false"); }
            return;
        }
        if (isArr) {
            this.genExpr(arg);
            this.genJsonArray(this.arrayElementType(t));
            return;
        }
        if (arg.kind == 19) {
            // Array literal: classify by literal children (rs array_join_elem).
            int count = arg.childCount();
            if (count == 0) { this.genJsonLit("[]"); return; }
            int allKind0 = 1;
            int allKind2 = 1;
            int allKind1 = 1;
            for (int ci = 0; ci < count; ci++) {
                int ck = arg.child(ci).kind;
                if (ck != 0) { allKind0 = 0; }
                if (ck != 2) { allKind2 = 0; }
                if (ck != 1) { allKind1 = 0; }
            }
            if (allKind2 == 1) {
                this.genExpr(arg);
                this.genJsonArray("string");
                return;
            }
            if (allKind1 == 1) {
                this.genExpr(arg);
                this.genJsonArray("float64");
                return;
            }
            if (allKind0 == 1) {
                this.genExpr(arg);
                this.genJsonArray("int");
                return;
            }
            this.genJsonLit("null");
            return;
        }
        if (t == "int" || t == "int32" || t == "int64" || t == "uint" || t == "bool" || t == "char") {
            // Integer-ish (and bool variables): decimal text, matching rs's
            // integer fallback path.
            this.genIntToString(arg);
            return;
        }
        this.genJsonLit("null");
    }

    // RAX holds an array data pointer; replace it with the JSON array text
    // "[elem,elem,...]".  Element rendering mirrors rs: string -> quoted
    // copy, float-ish -> %g, integer-ish -> %lld decimal.  byte[] arrays are
    // byte-packed on the self-host (elements at ptr+i), all other arrays use
    // 8-byte element slots.
    public void genJsonArray(string elemType) {
        bool strElem = elemType == "string";
        bool fltElem = elemType == "float" || elemType == "float64" || elemType == "double";
        bool intElem = elemType == "int" || elemType == "int32" || elemType == "int64" || elemType == "uint" || elemType == "byte";
        bool byteElem = elemType == "byte";
        int arrOff = this.allocLocal("__jsa_arr");
        this.asm.movMBaseR(5, 0, arrOff);
        // scratch = malloc(40) for per-element number text
        this.asm.movRI64(1, 40);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int scratchOff = this.allocLocal("__jsa_scr");
        this.asm.movMBaseR(5, 0, scratchOff);
        int elenOff = this.allocLocal("__jsa_elen");
        // len = [arr - 8]
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(0, 0, -8);
        int lenOff = this.allocLocal("__jsa_len");
        this.asm.movMBaseR(5, 0, lenOff);
        string fmtText = "%lld";
        if (fltElem) { fmtText = "%g"; }
        int fmtIdx = this.addString(fmtText);
        // ---- pass 1: total = 2 + commas + element text lengths ----
        int totalOff = this.allocLocal("__jsa_total");
        int iOff = this.allocLocal("__jsa_i");
        this.asm.movRI64(0, 2);
        this.asm.movMBaseR(5, 0, totalOff);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, iOff);
        int sumLoop = this.newLabel();
        int sumEnd = this.newLabel();
        this.asm.bindLabel(sumLoop);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(sumEnd);
        // rcx = elem = [arr + i*8]; byte[] arrays are byte-packed
        // (elements at arr+i) so they load with movzx instead.
        this.asm.movRMBase(1, 5, arrOff);
        this.asm.movRMBase(2, 5, iOff);
        if (byteElem) {
            this.asm.addRR64(1, 2);
            this.asm.movzxByteMBase(1, 1, 0);
        } else {
            this.asm.shlR64Imm(2, 3);
            this.asm.addRR64(1, 2);
            this.asm.movRMBase(1, 1, 0);
        }
        if (strElem) {
            this.addImportPatch("ucrtbase.dll", "strlen");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD1);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movRMBase(1, 5, totalOff);
            this.asm.addRI32(0, 2);
            this.asm.addRR64(0, 1);
            this.asm.movMBaseR(5, 0, totalOff);
        } else {
            this.asm.movRR64(9, 1);
            this.asm.movRMBase(1, 5, scratchOff);
            int sp1 = this.asm.buf.length;
            this.asm.emitImm64(0, 0);
            this.stringPatchOffsets.add(sp1 + 2);
            this.stringPatchIndices.add(fmtIdx);
            this.asm.movRR64(2, 0);
            this.asm.movRR64(8, 9);
            // LINUX SysV backend (additive): staged sprintf with XMM0/AL for
            // %g floats. WINDOWS tail below unchanged.
            if (this.isLinuxTarget()) {
                this.emitLinuxSprintfStaged(fltElem);
            } else {
                this.addImportPatch("msvcrt.dll", "sprintf");
                this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD6);
                this.asm.movRMBase(0, 0, 0);
                this.asm.emitCallSetup(0);
                this.asm.callR64(0);
                this.asm.emitCallTeardown();
            }
            this.asm.movRMBase(1, 5, scratchOff);
            this.addImportPatch("ucrtbase.dll", "strlen");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD1);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movRMBase(1, 5, totalOff);
            this.asm.addRR64(0, 1);
            this.asm.movMBaseR(5, 0, totalOff);
        }
        this.asm.movRMBase(0, 5, iOff);
        this.asm.cmpRI32(0, 0);
        int noComma1 = this.newLabel();
        this.asm.jeLabel(noComma1);
        this.asm.movRMBase(1, 5, totalOff);
        this.asm.addRI32(1, 1);
        this.asm.movMBaseR(5, 0, totalOff);
        this.asm.bindLabel(noComma1);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(sumLoop);
        this.asm.bindLabel(sumEnd);
        // ---- buf = malloc(total + 1); buf[0] = '['; pos = buf + 1 ----
        this.asm.movRMBase(1, 5, totalOff);
        this.asm.addRI32(1, 1);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int bufOff = this.allocLocal("__jsa_buf");
        int posOff = this.allocLocal("__jsa_pos");
        this.asm.movMBaseR(5, 0, bufOff);
        this.asm.movRMBase(1, 5, bufOff);
        this.asm.movRI64(2, 91);
        this.asm.movMBaseByteR(1, 2, 0);
        this.asm.movRMBase(0, 5, bufOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, posOff);
        // ---- pass 2: write elements separated by ',' ----
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, iOff);
        int fillLoop = this.newLabel();
        int fillEnd = this.newLabel();
        this.asm.bindLabel(fillLoop);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(fillEnd);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.cmpRI32(0, 0);
        int noComma2 = this.newLabel();
        this.asm.jeLabel(noComma2);
        this.asm.movRMBase(1, 5, posOff);
        this.asm.movRI64(2, 44);
        this.asm.movMBaseByteR(1, 2, 0);
        this.asm.movRMBase(0, 5, posOff);
        this.asm.incR64(0);
        this.asm.movMBaseR(5, 0, posOff);
        this.asm.bindLabel(noComma2);
        // rcx = elem = [arr + i*8]; byte[] arrays are byte-packed
        // (elements at arr+i) so they load with movzx instead.
        this.asm.movRMBase(1, 5, arrOff);
        this.asm.movRMBase(2, 5, iOff);
        if (byteElem) {
            this.asm.addRR64(1, 2);
            this.asm.movzxByteMBase(1, 1, 0);
        } else {
            this.asm.shlR64Imm(2, 3);
            this.asm.addRR64(1, 2);
            this.asm.movRMBase(1, 1, 0);
        }
        if (strElem) {
            // elen = strlen(elem) -> [elenOff]
            this.addImportPatch("ucrtbase.dll", "strlen");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD1);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, elenOff);
            // *pos++ = '"'
            this.asm.movRMBase(0, 5, posOff);
            this.asm.movRI64(2, 34);
            this.asm.movMBaseByteR(0, 2, 0);
            this.asm.movRMBase(0, 5, posOff);
            this.asm.incR64(0);
            this.asm.movMBaseR(5, 0, posOff);
            // memcpy(rcx = pos, rdx = elem, r8 = elen)
            this.asm.movRMBase(1, 5, posOff);
            this.asm.movRMBase(2, 5, arrOff);
            this.asm.movRMBase(0, 5, iOff);
            this.asm.shlR64Imm(0, 3);
            this.asm.addRR64(2, 0);
            this.asm.movRMBase(2, 2, 0);
            this.asm.movRMBase(8, 5, elenOff);
            this.addImportPatch("msvcrt.dll", "memcpy");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBAE0);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movRMBase(0, 5, posOff);
            this.asm.movRMBase(1, 5, elenOff);
            this.asm.addRR64(0, 1);
            this.asm.movMBaseR(5, 0, posOff);
            // *pos++ = '"'
            this.asm.movRMBase(0, 5, posOff);
            this.asm.movRI64(2, 34);
            this.asm.movMBaseByteR(0, 2, 0);
            this.asm.movRMBase(0, 5, posOff);
            this.asm.incR64(0);
            this.asm.movMBaseR(5, 0, posOff);
        } else {
            // sprintf(scratch, fmt, elem); elen = strlen(scratch)
            if (byteElem) {
                this.asm.movRMBase(9, 5, arrOff);
                this.asm.movRMBase(2, 5, iOff);
                this.asm.addRR64(9, 2);
                this.asm.movzxByteMBase(9, 9, 0);
            } else {
                this.asm.movRMBase(9, 5, arrOff);
                this.asm.movRMBase(2, 5, iOff);
                this.asm.shlR64Imm(2, 3);
                this.asm.addRR64(9, 2);
                this.asm.movRMBase(9, 9, 0);
            }
            this.asm.movRMBase(1, 5, scratchOff);
            int sp2 = this.asm.buf.length;
            this.asm.emitImm64(0, 0);
            this.stringPatchOffsets.add(sp2 + 2);
            this.stringPatchIndices.add(fmtIdx);
            this.asm.movRR64(2, 0);
            this.asm.movRR64(8, 9);
            // LINUX SysV backend (additive): staged sprintf with XMM0/AL for
            // %g floats. WINDOWS tail below unchanged.
            if (this.isLinuxTarget()) {
                this.emitLinuxSprintfStaged(fltElem);
            } else {
                this.addImportPatch("msvcrt.dll", "sprintf");
                this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD6);
                this.asm.movRMBase(0, 0, 0);
                this.asm.emitCallSetup(0);
                this.asm.callR64(0);
                this.asm.emitCallTeardown();
            }
            this.asm.movRMBase(1, 5, scratchOff);
            this.addImportPatch("ucrtbase.dll", "strlen");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD1);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, elenOff);
            // memcpy(rcx = pos, rdx = scratch, r8 = elen); pos += elen
            this.asm.movRMBase(1, 5, posOff);
            this.asm.movRMBase(2, 5, scratchOff);
            this.asm.movRMBase(8, 5, elenOff);
            this.addImportPatch("msvcrt.dll", "memcpy");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBAE0);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movRMBase(0, 5, posOff);
            this.asm.movRMBase(1, 5, elenOff);
            this.asm.addRR64(0, 1);
            this.asm.movMBaseR(5, 0, posOff);
        }
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(fillLoop);
        this.asm.bindLabel(fillEnd);
        // *pos++ = ']'; *pos = 0
        this.asm.movRMBase(0, 5, posOff);
        this.asm.movRI64(2, 93);
        this.asm.movMBaseByteR(0, 2, 0);
        this.asm.movRMBase(0, 5, posOff);
        this.asm.incR64(0);
        this.asm.movRI64(2, 0);
        this.asm.movMBaseByteR(0, 2, 0);
        this.asm.movRMBase(0, 5, bufOff);
    }

    public void genIntToStringRadix(Node expr, string selector) {
        this.genExpr(expr);
        int valOff = this.allocLocal("__i2s_radix_val");
        this.asm.movMBaseR(5, 0, valOff);
        this.asm.movRI64(1, 32);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int bufOff = this.allocLocal("__i2s_radix_buf");
        this.asm.movMBaseR(5, 0, bufOff);
        string fmt = "%lld";
        if (selector == "x") { fmt = "%llx"; }
        if (selector == "X") { fmt = "%llX"; }
        this.addFormatStr(fmt);
        this.asm.movRMBase(8, 5, valOff);
        this.asm.movRR64(2, 1);
        this.asm.movRMBase(1, 5, bufOff);
        this.addImportPatch("msvcrt.dll", "sprintf");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD6);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRMBase(0, 5, bufOff);
    }

    public void genIntToString(Node expr) {
        this.genExpr(expr);
        int valOff = this.allocLocal("__i2s_val");
        this.asm.movMBaseR(5, 0, valOff);
        this.asm.movRI64(1, 32);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int bufOff = this.allocLocal("__i2s_buf");
        this.asm.movMBaseR(5, 0, bufOff);
        this.addFormatStr("%lld");
        this.asm.movRMBase(8, 5, valOff);
        this.asm.movRR64(2, 1);
        this.asm.movRMBase(1, 5, bufOff);
        this.addImportPatch("msvcrt.dll", "sprintf");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD6);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRMBase(0, 5, bufOff);
    }

    public void genFloatToString(Node expr) {
        // float64/float/double .toString(): sprintf(buf, "%g", bits) where the
        // IEEE-754 bits travel in R8 (varargs FP in the positional GP register,
        // matching silverc-rs).  Returns the buffer pointer in RAX.
        this.genExpr(expr);
        int valOff = this.allocLocal("__f2s_val");
        this.asm.movMBaseR(5, 0, valOff);
        this.asm.movRI64(1, 64);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int bufOff = this.allocLocal("__f2s_buf");
        this.asm.movMBaseR(5, 0, bufOff);
        this.addFormatStr("%g");
        this.asm.movRMBase(8, 5, valOff);
        this.asm.movRR64(2, 1);
        this.asm.movRMBase(1, 5, bufOff);
        // LINUX SysV backend (additive): %g always needs XMM0/AL=1.
        if (this.isLinuxTarget()) {
            this.emitLinuxSprintfStaged(true);
        } else {
            this.addImportPatch("msvcrt.dll", "sprintf");
            this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD6);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
        }
        this.asm.movRMBase(0, 5, bufOff);
    }

    public void genStringRepeat(Node bin) {
        // lhs ... count: repeat lhs string count times, return new string.
        this.genExpr(bin.child(1));
        int cntOff = this.allocLocal("__rpt_cnt");
        this.asm.movMBaseR(5, 0, cntOff);
        this.genExpr(bin.child(0));
        int strOff = this.allocLocal("__rpt_str");
        this.asm.movMBaseR(5, 0, strOff);
        this.asm.movRMBase(1, 5, strOff);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD1);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int lenOff = this.allocLocal("__rpt_len");
        this.asm.movMBaseR(5, 0, lenOff);
        // count <= 0 returns the empty string.
        int zeroCnt = this.newLabel();
        int zeroDone = this.newLabel();
        this.asm.movRMBase(0, 5, cntOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jleLabel(zeroCnt);
        // allocSize = len * count + 1
        this.asm.movRMBase(1, 5, cntOff);
        this.asm.mulRR64(1);
        this.asm.addRI32(0, 1);
        this.asm.movRR64(1, 0);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int dstOff = this.allocLocal("__rpt_dst");
        this.asm.movMBaseR(5, 0, dstOff);
        int iOff = this.allocLocal("__rpt_i");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, iOff);
        int loop = this.newLabel();
        int done = this.newLabel();
        this.asm.bindLabel(loop);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, cntOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(done);
        // dst + i*len = str
        this.asm.movRMBase(1, 5, dstOff);
        this.asm.movRMBase(2, 5, iOff);
        this.asm.movRMBase(0, 5, lenOff);
        this.asm.mulRR64(2);
        this.asm.addRR64(1, 0);
        this.asm.movRMBase(2, 5, strOff);
        this.addImportPatch("ucrtbase.dll", "strcpy");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD4);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(loop);
        this.asm.bindLabel(done);
        this.asm.movRMBase(0, 5, dstOff);
        this.asm.jmpLabel(zeroDone);
        this.asm.bindLabel(zeroCnt);
        this.emitLlmaiEmptyString();
        this.asm.bindLabel(zeroDone);
    }

    public void genStringConcat(Node bin) {
        // CONTRACT: Silver strings are NUL-terminated char* end-to-end —
        // .length, comparisons, printline, fs and DLL interop are all
        // strlen-based. Concat therefore sizes and copies both operands by
        // strlen (strcpy/strcat below): an embedded NUL byte (char(0)) is
        // dropped and cannot round-trip. This is the documented limitation,
        // not a TODO — a true-length concat would need a length-header
        // representation (breaking every DLL interop) and would leave
        // .length/strcmp truncating (the forbidden half-fix). Binary
        // payloads (mysql/mongo wire parsing) must travel through int[]
        // buffers (see std/mysql.sr, std/mongo.sr).
        if (bin.childCount() < 2) { return; }
        string rt = this.inferExprType(bin.child(1));
        bool rtNullableChar = this.isCharExpr(bin.child(1));

        if (rtNullableChar) {
            this.genCharToString(bin.child(1));
        } else if (rt == "string") {
            this.genExpr(bin.child(1));
        } else if (this.isFloatLike(bin.child(1))) {
            // Float operands stringify with %g via sprintf (silverc-rs
            // gen_string_concat is_float_expr -> gen_float_format); routing
            // them through genIntToString printed the raw bit pattern.
            this.genFloatToString(bin.child(1));
        } else {
            this.genIntToString(bin.child(1));
        }
        int rhsOff = this.allocLocal("__cc_rhs");
        this.asm.movMBaseR(5, 0, rhsOff);
        string lt = this.inferExprType(bin.child(0));
        bool ltNullableChar = this.isCharExpr(bin.child(0));
        if (ltNullableChar) {
            this.genCharToString(bin.child(0));
        } else if (lt == "string") {
            this.genExpr(bin.child(0));
        } else if (this.isFloatLike(bin.child(0))) {
            this.genFloatToString(bin.child(0));
        } else {
            this.genIntToString(bin.child(0));
        }
        int lhsOff = this.allocLocal("__cc_lhs");
        this.asm.movMBaseR(5, 0, lhsOff);

        // Allocate exactly strlen(lhs) + strlen(rhs) + 1 bytes. The old
        // fixed 1024-byte buffer overflowed the heap whenever a
        // concatenated string exceeded 1 KiB (e.g. a large LLM response),
        // silently corrupting later allocations.
        this.asm.movRMBase(1, 5, lhsOff);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD1);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int lhsLenOff = this.allocLocal("__cc_lhslen");
        this.asm.movMBaseR(5, 0, lhsLenOff);

        this.asm.movRMBase(1, 5, rhsOff);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD1);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.movRMBase(1, 5, lhsLenOff);
        this.asm.addRR64(0, 1);
        this.asm.addRI32(0, 1);
        this.asm.movRR64(1, 0);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int newOff = this.allocLocal("__cc_new");
        this.asm.movMBaseR(5, 0, newOff);

        this.asm.movRMBase(1, 5, newOff);
        this.asm.movRMBase(2, 5, lhsOff);
        this.addImportPatch("ucrtbase.dll", "strcpy");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD4);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.movRMBase(1, 5, newOff);
        this.asm.movRMBase(2, 5, rhsOff);
        this.addImportPatch("ucrtbase.dll", "strcat");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD5);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.movRMBase(0, 5, newOff);
    }

    public void genStrlenCall(Node call) {
        if (call.childCount() < 1) { return; }
        this.genExpr(call.child(0));
        this.asm.movRR64(1, 0);
        this.addImportPatch("ucrtbase.dll", "strlen");
        int s2 = 0xDEADBEEFCAFEBAD1;
        this.asm.emitImm64(0, s2);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }

    // len(x): returns the number of elements in an array, or the byte length
    // of a string. Arrays store [capacity, length, ...] with the length at
    // base-8; strings are null-terminated so strlen() gives the length.
    public void genLenCall(Node call) {
        if (call.childCount() < 1) {
            this.asm.xorRR64(0, 0);
            return;
        }
        Node arg = call.child(0);
        this.genExpr(arg);
        string t = this.inferExprType(arg);

        bool isArr = t.length >= 2 && t[t.length - 2] == '[' && t[t.length - 1] == ']';
        if (isArr) {
            // rax = array data pointer; length is at [data - 8]
            this.asm.movRMBase(1, 0, -8);
            this.asm.movRR64(0, 1);
        } else {
            // String: strlen(ptr) with ptr in rcx
            this.asm.movRR64(1, 0);
            this.addImportPatch("ucrtbase.dll", "strlen");
            int s2 = 0xDEADBEEFCAFEBAD2;
            this.asm.emitImm64(0, s2);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
        }
    }

    public void genExitCall(Node call) {
        this.windowsBackend.genExitCall(this, call);
    }

    public void genCargsCall(Node call) {
        // LINUX SysV backend (additive): rebuild argv from the _start stack
        // captured in __linux_stack_top (same array layout, no exit in the
        // shared path). The WINDOWS command-line parser below is unchanged.
        if (this.isLinuxTarget()) {
            this.genLinuxCargsCall();
            return;
        }
        int cmdOff = this.allocLocal("__cargs_cmd");
        int lenOff = this.allocLocal("__cargs_len");
        int argcOff = this.allocLocal("__cargs_argc");
        int arrOff = this.allocLocal("__cargs_arr");
        int posOff = this.allocLocal("__cargs_pos");
        int inqOff = this.allocLocal("__cargs_inq");
        int intkOff = this.allocLocal("__cargs_intk");
        int tstartOff = this.allocLocal("__cargs_ts");
        int tlenOff = this.allocLocal("__cargs_tl");
        int bufOff = this.allocLocal("__cargs_buf");
        int allocSizeOff = this.allocLocal("__cargs_alloc_size");

        this.addImportPatch("kernel32.dll", "GetCommandLineA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, cmdOff);

        this.asm.movRMBase(1, 5, cmdOff);
        this.addImportPatch("ucrtbase.dll", "strlen");
        int sCL = 0xDEADBEEFCAFEBAD1;
        this.asm.emitImm64(0, sCL);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, lenOff);

        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, argcOff);
        this.asm.movMBaseR(5, 0, posOff);
        this.asm.movMBaseR(5, 0, inqOff);
        this.asm.movMBaseR(5, 0, intkOff);

        int cLoop = this.newLabel();
        int cDone = this.newLabel();
        int cInq = this.newLabel();
        int cSpace = this.newLabel();
        int cQuote = this.newLabel();
        int cQuoteInside = this.newLabel();
        int cTok = this.newLabel();
        int cNext = this.newLabel();

        this.asm.bindLabel(cLoop);
        this.asm.movRMBase(0, 5, posOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(cDone);
        this.asm.movRMBase(0, 5, cmdOff);
        this.asm.movRMBase(1, 5, posOff);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(2, 0, 0);
        this.asm.movRMBase(0, 5, inqOff);
        this.asm.cmpRI32(0, 1);
        this.asm.jeLabel(cInq);
        this.asm.cmpRI32(2, 0x20);
        this.asm.jeLabel(cSpace);
        this.asm.cmpRI32(2, 0x09);
        this.asm.jeLabel(cSpace);
        this.asm.cmpRI32(2, 0x22);
        this.asm.jeLabel(cQuote);
        this.asm.movRMBase(0, 5, intkOff);
        this.asm.cmpRI32(0, 0);

        this.asm.jneLabel(cNext);
        this.asm.bindLabel(cTok);
        this.asm.movRMBase(0, 5, argcOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, argcOff);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, intkOff);
        this.asm.jmpLabel(cNext);
        this.asm.bindLabel(cInq);
        this.asm.cmpRI32(2, 0x22);
        this.asm.jneLabel(cNext);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, inqOff);
        this.asm.jmpLabel(cNext);
        this.asm.bindLabel(cQuote);
        this.asm.movRMBase(0, 5, intkOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jneLabel(cQuoteInside);
        this.asm.movRMBase(0, 5, argcOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, argcOff);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, intkOff);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, inqOff);
        this.asm.jmpLabel(cNext);
        this.asm.bindLabel(cQuoteInside);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, inqOff);
        this.asm.jmpLabel(cNext);
        this.asm.bindLabel(cSpace);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, intkOff);
        this.asm.bindLabel(cNext);
        this.asm.movRMBase(0, 5, posOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, posOff);
        this.asm.jmpLabel(cLoop);
        this.asm.bindLabel(cDone);

        this.asm.movRMBase(0, 5, argcOff);
        this.asm.addRI32(0, 1);
        this.asm.shlR64Imm(0, 3);
        this.asm.pushR64(0);
        this.addImportPatch("kernel32.dll", "GetProcessHeap");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRR64(1, 0);
        this.asm.xorRR64(2, 2);
        this.asm.popR64(8);
        this.addImportPatch("kernel32.dll", "HeapAlloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, arrOff);
        this.asm.movRMBase(1, 5, argcOff);
        this.asm.movMBaseR(0, 1, 0);

        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, argcOff);
        this.asm.movMBaseR(5, 0, posOff);
        this.asm.movMBaseR(5, 0, inqOff);
        this.asm.movMBaseR(5, 0, intkOff);

        int pLoop = this.newLabel();
        int pDone = this.newLabel();
        int pInq = this.newLabel();
        int pSpace = this.newLabel();
        int pQuote = this.newLabel();
        int pQuoteInside = this.newLabel();
        int pTokStart = this.newLabel();
        int pTokBody = this.newLabel();
        int pTokEnd = this.newLabel();
        int pNext = this.newLabel();

        this.asm.bindLabel(pLoop);
        this.asm.movRMBase(0, 5, posOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(pDone);
        this.asm.movRMBase(0, 5, cmdOff);
        this.asm.movRMBase(1, 5, posOff);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(2, 0, 0);
        this.asm.movRMBase(0, 5, inqOff);
        this.asm.cmpRI32(0, 1);
        this.asm.jeLabel(pInq);
        this.asm.cmpRI32(2, 0x20);
        this.asm.jeLabel(pSpace);
        this.asm.cmpRI32(2, 0x09);
        this.asm.jeLabel(pSpace);
        this.asm.cmpRI32(2, 0x22);
        this.asm.jeLabel(pQuote);
        this.asm.movRMBase(0, 5, intkOff);
        this.asm.cmpRI32(0, 0);

        this.asm.jneLabel(pTokBody);
        this.asm.bindLabel(pTokStart);
        this.asm.movRMBase(0, 5, posOff);
        this.asm.movMBaseR(5, 0, tstartOff);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, tlenOff);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, intkOff);
        this.asm.jmpLabel(pNext);
        this.asm.bindLabel(pTokBody);
        this.asm.movRMBase(0, 5, tlenOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, tlenOff);
        this.asm.jmpLabel(pNext);
        this.asm.bindLabel(pInq);
        this.asm.cmpRI32(2, 0x22);
        this.asm.jneLabel(pTokBody);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, inqOff);
        this.asm.jmpLabel(pNext);
        this.asm.bindLabel(pQuote);
        this.asm.movRMBase(0, 5, intkOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jneLabel(pQuoteInside);
        this.asm.movRMBase(0, 5, posOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, tstartOff);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, tlenOff);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, intkOff);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, inqOff);
        this.asm.jmpLabel(pNext);
        this.asm.bindLabel(pQuoteInside);
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, inqOff);
        this.asm.jmpLabel(pNext);
        this.asm.bindLabel(pSpace);
        this.asm.movRMBase(0, 5, intkOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(pNext);
        this.asm.bindLabel(pTokEnd);
        this.asm.movRMBase(1, 5, tlenOff);
        this.asm.addRI32(1, 1);
        this.asm.movMBaseR(5, 1, allocSizeOff);
        this.addImportPatch("kernel32.dll", "GetProcessHeap");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRR64(1, 0);
        this.asm.xorRR64(2, 2);
        this.asm.movRMBase(8, 5, allocSizeOff);
        this.addImportPatch("kernel32.dll", "HeapAlloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, bufOff);
        int bCopy = this.newLabel();
        int bDone = this.newLabel();
        int bi = this.allocLocal("__cargs_bi");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, bi);
        this.asm.bindLabel(bCopy);
        this.asm.movRMBase(0, 5, bi);
        this.asm.movRMBase(1, 5, tlenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(bDone);
        this.asm.movRMBase(0, 5, cmdOff);
        this.asm.movRMBase(1, 5, tstartOff);
        this.asm.addRR64(0, 1);
        this.asm.movRMBase(1, 5, bi);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(2, 0, 0);
        this.asm.movRMBase(0, 5, bufOff);
        this.asm.movRMBase(1, 5, bi);
        this.asm.movByteMBaseIdxR(0, 1, 2);
        this.asm.movRMBase(0, 5, bi);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, bi);
        this.asm.jmpLabel(bCopy);
        this.asm.bindLabel(bDone);
        this.asm.movRMBase(0, 5, bufOff);
        this.asm.movRMBase(1, 5, tlenOff);
        this.asm.addRR64(0, 1);
        this.asm.movRI64(1, 0);
        this.asm.movByteMBaseIdxR(0, 1, 1);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.addRI32(0, 8);
        this.asm.movRMBase(1, 5, argcOff);
        this.asm.shlR64Imm(1, 3);
        this.asm.addRR64(0, 1);
        this.asm.movRMBase(1, 5, bufOff);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRMBase(0, 5, argcOff);
        this.asm.addRI32(0, 1);

        this.asm.movMBaseR(5, 0, argcOff);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, intkOff);
        this.asm.bindLabel(pNext);
        this.asm.movRMBase(0, 5, posOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, posOff);
        this.asm.jmpLabel(pLoop);
        this.asm.bindLabel(pDone);
        // The command line normally ends inside the final token, not on a
        // separator. Flush that token through the same allocation/copy path
        // used for space-delimited tokens before returning the array.
        this.asm.movRMBase(0, 5, intkOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jneLabel(pTokEnd);

        // Arrays point at their first element; the length word lives one
        // element before it.  HeapAlloc returned the header address, so skip
        // the length word before exposing the array to normal array code.
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.addRI32(0, 8);
    }

    public void genGetCommandLineCall(Node call) {
        // LINUX SysV backend (additive): argv[0] (program path) from the
        // captured _start stack. NOTE: GetCommandLineA returns the whole
        // command line; joining all argv entries stays a stage-1 gap.
        if (this.isLinuxTarget()) {
            this.emitLinuxStackTopLoad();
            this.asm.movRMBase(0, 0, 8);
            return;
        }
        this.addImportPatch("kernel32.dll", "GetCommandLineA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }

    // GetCursorX/GetCursorY are real native helpers. A POINT is two int32
    // values, so reserve two adjacent 8-byte locals, pass their address to
    // user32!GetCursorPos, and load the returned coordinate with MOVSXD.
    public void genCursorXCall() {
        this.windowsBackend.genCursorXCall(this);
    }

    public void genCursorYCall() {
        this.windowsBackend.genCursorYCall(this);
    }

    public void genCursorPosCall(Node call, int argStart) {
        this.windowsBackend.genCursorPosCall(this, call, argStart);
    }

    public void genGetEnvCall(Node call) {
        // LINUX SysV backend (additive): getenv(name) via libc. The WINDOWS
        // block below is byte-identical to before.
        if (this.isLinuxTarget()) {
            this.genLinuxGetEnvCall(call);
            return;
        }
        // The variable-name argument sits at child(1) for member calls
        // (`env.get(name)` where child(0) is the receiver) and at child(0) for
        // a global `getenv(name)` call.
        int keyIdx = 0;
        if (call.isMember) { keyIdx = 1; }
        if (call.childCount() <= keyIdx) { this.emitLlmaiStringLiteral(""); return; }
        this.genExpr(call.child(keyIdx));
        int keyOff = this.allocLocal("__env_key");
        this.asm.movMBaseR(5, 0, keyOff);

        // size = GetEnvironmentVariableA(key, NULL, 0): returns the required
        // buffer size including the NUL terminator, or 0 when unset.
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, keyOff);
        this.asm.xorRR64(2, 2);
        this.asm.xorRR64(8, 8);
        this.addImportPatch("kernel32.dll", "GetEnvironmentVariableA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int sizeOff = this.allocLocal("__env_size");
        this.asm.movMBaseR(5, 0, sizeOff);

        int notFound = this.asm.createLabel();
        int done = this.asm.createLabel();
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(notFound);

        // buf = HeapAlloc(GetProcessHeap(), 0, size)
        this.asm.emitCallSetup(0);
        this.emitGetProcessHeapCall();
        this.asm.emitCallTeardown();
        this.asm.emitCallSetup(0);
        this.asm.movRR64(1, 0);
        this.asm.xorRR64(2, 2);
        this.asm.movRMBase(8, 5, sizeOff);
        this.emitHeapAllocCall();
        this.asm.emitCallTeardown();
        int bufOff = this.allocLocal("__env_buf");
        this.asm.movMBaseR(5, 0, bufOff);

        // GetEnvironmentVariableA(key, buf, size) writes the value + NUL
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, keyOff);
        this.asm.movRMBase(2, 5, bufOff);
        this.asm.movRMBase(8, 5, sizeOff);
        this.addImportPatch("kernel32.dll", "GetEnvironmentVariableA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.movRMBase(0, 5, bufOff);
        this.asm.jmpLabel(done);
        this.asm.bindLabel(notFound);
        this.emitLlmaiStringLiteral("");
        this.asm.bindLabel(done);
    }

    // LINUX SysV backend (additive): getenv(name) via libc, mirroring
    // silverc/std/env.sr's LINUX posture (overlay + /proc fallback live at
    // Silver level; the native bridge only needs the direct pointer). A NULL
    // return (unset) yields "", otherwise the libc pointer is returned
    // directly (NUL-terminated, owned by libc, never freed). SysV regs +
    // addImportPatchDirect + emitAbiCallSetup/teardown.
    public void genLinuxGetEnvCall(Node call) {
        this.linuxBackend.genLinuxGetEnvCall(this, call);
    }

    // RAX = 1 when the string at strOff starts with `prefix`, else 0.
    public void emitPrefixCheck(int strOff, string prefix, int prefixLen) {
        this.emitLlmaiStringLiteral(prefix);
        int preOff = this.allocLocal("__url_pre");
        this.asm.movMBaseR(5, 0, preOff);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, strOff);
        this.asm.movRMBase(2, 5, preOff);
        this.asm.movRI64(8, prefixLen);
        this.addImportPatch("ucrtbase.dll", "strncmp");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int pNo = this.newLabel();
        int pDone = this.newLabel();
        this.asm.cmpRI32(0, 0);
        this.asm.jneLabel(pNo);
        this.asm.movRI64(0, 1);
        this.asm.jmpLabel(pDone);
        this.asm.bindLabel(pNo);
        this.asm.xorRR64(0, 0);
        this.asm.bindLabel(pDone);
    }

    public void genUrlCall(Node call) {
        string name = call.name;
        if (call.childCount() < 2) { this.asm.xorRR64(0, 0); return; }
        this.genExpr(call.child(1));
        int urlOff = this.allocLocal("__url_s");
        this.asm.movMBaseR(5, 0, urlOff);
        if (name == "isUrl") {
            this.emitPrefixCheck(urlOff, "http://", 7);
            int uYes = this.newLabel();
            int uDone = this.newLabel();
            this.asm.cmpRI32(0, 1);
            this.asm.jeLabel(uYes);
            this.emitPrefixCheck(urlOff, "https://", 8);
            this.asm.cmpRI32(0, 1);
            this.asm.jeLabel(uYes);
            this.asm.xorRR64(0, 0);
            this.asm.jmpLabel(uDone);
            this.asm.bindLabel(uYes);
            this.asm.movRI64(0, 1);
            this.asm.bindLabel(uDone);
        } else if (name == "isFtp") {
            // ftp:// but not ftps://
            this.emitPrefixCheck(urlOff, "ftps://", 7);
            int fNo = this.newLabel();
            int fDone = this.newLabel();
            this.asm.cmpRI32(0, 1);
            this.asm.jeLabel(fNo);
            this.emitPrefixCheck(urlOff, "ftp://", 6);
            this.asm.cmpRI32(0, 1);
            this.asm.jneLabel(fNo);
            this.asm.movRI64(0, 1);
            this.asm.jmpLabel(fDone);
            this.asm.bindLabel(fNo);

            this.asm.xorRR64(0, 0);
            this.asm.bindLabel(fDone);
        } else {
            this.emitPrefixCheck(urlOff, "ftps://", 7);
        }
    }

    public void genFileExistsCall(Node call) {
        int pathIdx = 1;
        if (call.childCount() <= pathIdx) { this.asm.xorRR64(0, 0); return; }
        this.genExpr(call.child(pathIdx));
        int pathOff = this.allocLocal("__fe_path");
        this.asm.movMBaseR(5, 0, pathOff);
        // LINUX SysV backend (additive): open-probe via libc (fd >= 0).
        // The WINDOWS block below is byte-identical to before.
        if (this.isLinuxTarget()) {
            this.genLinuxFileExists(pathOff);
            return;
        }
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, pathOff);
        this.addImportPatch("kernel32.dll", "GetFileAttributesA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int feNo = this.newLabel();
        int feDone = this.newLabel();
        this.asm.movRI64(1, 0xFFFFFFFF);
        this.asm.cmpRR64(0, 1);
        this.asm.jeLabel(feNo);
        this.asm.movRI64(0, 1);
        this.asm.jmpLabel(feDone);
        this.asm.bindLabel(feNo);
        this.asm.xorRR64(0, 0);
        this.asm.bindLabel(feDone);
    }

    // LINUX SysV backend (additive): file.exists via libc open (fd >= 0
    // probes the path), then close and report 1; a failed open reports 0.
    // Mirrors silverc-rs stdlib/fs.rs gen_file_exists_linux and the
    // genLinuxWriteBytesFile open/close shape (SysV regs RDI/RSI/RDX =
    // asm regs 7/6/2 + addImportPatchDirect + emitAbiCallSetup/teardown).
    public void genLinuxFileExists(int pathOff) {
        this.linuxBackend.genLinuxFileExists(this, pathOff);
    }

    public void genFileDeleteCall(Node call) {
        // LINUX SysV backend (additive): unlink(path) via libc. The WINDOWS
        // block below is byte-identical to before.
        if (this.isLinuxTarget()) {
            this.genLinuxFileDeleteCall(call);
