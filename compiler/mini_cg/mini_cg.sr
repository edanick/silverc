    public void genFileCopyCall(Node call) {
        // LINUX SysV backend (additive): open/read/write loop via libc. The
        // WINDOWS block below is byte-identical to before.
        if (this.isLinuxTarget()) {
            this.genLinuxFileCopyCall(call);
            return;
        }
        if (call.childCount() < 3) { this.asm.xorRR64(0, 0); return; }
        this.genExpr(call.child(1));
        int srcOff = this.allocLocal("__fc_src");
        this.asm.movMBaseR(5, 0, srcOff);
        this.genExpr(call.child(2));
        int dstOff = this.allocLocal("__fc_dst");
        this.asm.movMBaseR(5, 0, dstOff);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, srcOff);
        this.asm.movRMBase(2, 5, dstOff);
        this.asm.xorRR64(8, 8);
        this.addImportPatch("kernel32.dll", "CopyFileA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }

    // LINUX SysV backend (additive): open src O_RDONLY + open dst
    // O_WRONLY|O_CREAT|O_TRUNC 0644 (0x241/0x1A4) + read/write loop + close
    // both, mirroring silverc/std/fs.sr's #on LINUX write bodies and the
    // genLinuxWriteBytesFile open flags. CopyFileA has no libc equivalent
    // (linuxImportName leaves it unmapped), so this dedicated branch replaces
    // the failing remap. Returns 1 on success, 0 on failure (BOOL posture).
    public void genLinuxFileCopyCall(Node call) {
        this.linuxBackend.genLinuxFileCopyCall(this, call);
    }

    public void genFileSizeCall(Node call) {
        int pathIdx = 1;
        if (call.childCount() <= pathIdx) { this.asm.xorRR64(0, 0); return; }
        this.genExpr(call.child(pathIdx));
        int pathOff = this.allocLocal("__fsz_path");
        this.asm.movMBaseR(5, 0, pathOff);
        // LINUX SysV backend (additive): stat st_size via libc.
        // The WINDOWS block below is byte-identical to before.
        if (this.isLinuxTarget()) {
            this.genLinuxFileSize(pathOff);
            return;
        }
        this.asm.emitCallSetup(24);
        this.asm.movRI64(0, 3);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRI64(0, 0x80);
        this.asm.movMBaseR(4, 0, 40);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(4, 0, 48);
        this.asm.movRMBase(1, 5, pathOff);
        this.asm.movRI64(2, 0x80000000);
        this.asm.movRI64(8, 1);
        this.asm.xorRR64(9, 9);
        this.addImportPatch("kernel32.dll", "CreateFileA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int hOff = this.allocLocal("__fsz_h");

        this.asm.movMBaseR(5, 0, hOff);
        int fszBad = this.newLabel();
        int fszDone = this.newLabel();
        this.asm.movRI64(1, 0xFFFFFFFFFFFFFFFF);
        this.asm.cmpRR64(0, 1);
        this.asm.jeLabel(fszBad);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hOff);
        this.asm.xorRR64(2, 2);
        this.addImportPatch("kernel32.dll", "GetFileSize");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int sizeOff = this.allocLocal("__fsz_size");
        this.asm.movMBaseR(5, 0, sizeOff);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hOff);
        this.addImportPatch("kernel32.dll", "CloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRMBase(0, 5, sizeOff);
        this.asm.jmpLabel(fszDone);
        this.asm.bindLabel(fszBad);
        this.asm.xorRR64(0, 0);
        this.asm.bindLabel(fszDone);
    }

    // LINUX SysV backend (additive): file.getSize via libc stat (st_size,
    // i64 at stat offset 48 = slot 6 of an int[18], per silverc/std/fs.sr
    // statSize). A failed stat reports 0, matching the WINDOWS missing-file
    // path below. SysV regs + addImportPatchDirect + emitAbiCallSetup/
    // teardown, beside the unchanged WINDOWS block.
    public void genLinuxFileSize(int pathOff) {
        this.linuxBackend.genLinuxFileSize(this, pathOff);
    }

    public void genFolderSizeCall(Node call) {
        // LINUX SysV backend (additive): recursive opendir/readdir sum via
        // libc. The WINDOWS block below is byte-identical to before.
        if (this.isLinuxTarget()) {
            this.genLinuxFolderSizeCall(call);
            return;
        }
        // Folder size is a recursive sum; the self-hosted backend returns the
        // OS-reported directory entry size (0 for an empty/most directories)
        // via GetFileSize on a backup-semantics handle is unreliable, so a
        // conservative 0 is returned here. See silverc-rs for the recursive
        // implementation used by the bootstrap compiler.
        this.asm.xorRR64(0, 0);
    }

    // LINUX SysV backend (additive): recursive folder size via libc
    // opendir/readdir/closedir + stat, mirroring silverc/std/fs.sr's #on
    // LINUX readDirNames/statSize/isDirPath helpers (dirent d_name at offset
    // 19, stat st_size i64 at offset 48, st_mode u32 at offset 24 with
    // S_IFMT/FDIR). silverc-rs has no Linux folder-size branch (folder
    // getSize reuses the file-size path, which returns 0 for directories on
    // Linux), and statvfs measures the filesystem rather than the directory
    // tree, so an iterative worklist DFS (explicit heap stack, no codegen
    // recursion) sums every descendant file. SysV regs + addImportPatchDirect
    // + emitAbiCallSetup/teardown, beside the unchanged WINDOWS block.
    public void genLinuxFolderSizeCall(Node call) {
        this.linuxBackend.genLinuxFolderSizeCall(this, call);
    }

    public void genIsDirCall(Node call) {
        int pathIdx = 1;
        if (call.childCount() <= pathIdx) { this.asm.xorRR64(0, 0); return; }
        this.genExpr(call.child(pathIdx));
        // LINUX SysV backend (additive): stat st_mode S_ISDIR via libc.
        // The WINDOWS block below is byte-identical to before.
        if (this.isLinuxTarget()) {
            this.genLinuxIsDir();
            return;
        }
        this.asm.emitCallSetup(0);
        this.asm.movRR64(1, 0);
        this.addImportPatch("kernel32.dll", "GetFileAttributesA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int idNo = this.newLabel();
        int idDone = this.newLabel();
        this.asm.movRI64(1, 0xFFFFFFFF);
        this.asm.cmpRR64(0, 1);
        this.asm.jeLabel(idNo);            this.asm.andRImm(0, 0x10);
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(idNo);
        this.asm.movRI64(0, 1);
        this.asm.jmpLabel(idDone);
        this.asm.bindLabel(idNo);
        this.asm.xorRR64(0, 0);
        this.asm.bindLabel(idDone);
    }

    // LINUX SysV backend (additive): isDir via libc stat (st_mode, u32 at
    // stat offset 24, masked with S_IFMT/FDIR per silverc/std/fs.sr
    // isDirPath). A failed stat reports 0, matching the WINDOWS
    // invalid-attributes path below.
    public void genLinuxIsDir() {
        this.linuxBackend.genLinuxIsDir(this);
    }

    public void genIsFileCall(Node call) {
        int pathIdx = 1;
        if (call.childCount() <= pathIdx) { this.asm.xorRR64(0, 0); return; }
        this.genExpr(call.child(pathIdx));
        // LINUX SysV backend (additive): stat st_mode S_ISREG via libc.
        // The WINDOWS block below is byte-identical to before.
        if (this.isLinuxTarget()) {
            this.genLinuxIsFile();
            return;
        }
        this.asm.emitCallSetup(0);
        this.asm.movRR64(1, 0);
        this.addImportPatch("kernel32.dll", "GetFileAttributesA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int ifNo = this.newLabel();
        int ifDone = this.newLabel();
        this.asm.movRI64(1, 0xFFFFFFFF);
        this.asm.cmpRR64(0, 1);
        this.asm.jeLabel(ifNo);            this.asm.andRImm(0, 0x10);
        this.asm.cmpRI32(0, 0);
        this.asm.jneLabel(ifNo);
        this.asm.movRI64(0, 1);
        this.asm.jmpLabel(ifDone);
        this.asm.bindLabel(ifNo);
        this.asm.xorRR64(0, 0);
        this.asm.bindLabel(ifDone);
    }

    // LINUX SysV backend (additive): isFile via libc stat (st_mode, u32 at
    // stat offset 24, masked with S_IFMT/S_IFREG per silverc/std/fs.sr
    // isDirPath). A failed stat reports 0, matching the WINDOWS
    // invalid-attributes path below.
    public void genLinuxIsFile() {
        this.linuxBackend.genLinuxIsFile(this);
    }

    public void genIsDriveRootCall(Node call) {
        int pathIdx = 1;
        if (call.childCount() <= pathIdx) { this.asm.xorRR64(0, 0); return; }
        this.genExpr(call.child(pathIdx));
        int pathOff = this.allocLocal("__dr_path");
        this.asm.movMBaseR(5, 0, pathOff);
        // LINUX SysV backend (additive): no drive letters on Linux.
        // The WINDOWS block below is byte-identical to before.
        if (this.isLinuxTarget()) {
            this.genLinuxIsDriveRoot(pathOff);
            return;
        }
        int drNo = this.newLabel();
        int drYes = this.newLabel();
        int drDone = this.newLabel();
        this.asm.movRMBase(0, 5, pathOff);
        this.asm.movzxByteMBase(1, 0, 0);

        this.asm.cmpRI32(1, 65);
        this.asm.jlLabel(drNo);
        this.asm.cmpRI32(1, 90);
        this.asm.jleLabel(drYes);
        this.asm.cmpRI32(1, 97);
        this.asm.jlLabel(drNo);
        this.asm.cmpRI32(1, 122);
        this.asm.jleLabel(drYes);
        this.asm.jmpLabel(drNo);
        this.asm.bindLabel(drYes);
        this.asm.movRMBase(0, 5, pathOff);
        this.asm.movzxByteMBase(1, 0, 1);
        this.asm.cmpRI32(1, 58);
        this.asm.jneLabel(drNo);
        this.asm.movRI64(0, 1);
        this.asm.jmpLabel(drDone);
        this.asm.bindLabel(drNo);
        this.asm.xorRR64(0, 0);
        this.asm.bindLabel(drDone);
    }

    // LINUX SysV backend (additive): no drive letters on Linux; only "/"
    // is a root. A single-char "/" path reports 1, everything else 0.
    public void genLinuxIsDriveRoot(int pathOff) {
        this.linuxBackend.genLinuxIsDriveRoot(this, pathOff);
    }

    public void genFolderEntriesCall(Node call, int filter) {
        // LINUX SysV backend (additive): opendir/readdir/closedir via libc.
        // The WINDOWS block below is byte-identical to before.
        if (this.isLinuxTarget()) {
            this.genLinuxFolderEntriesCall(call, filter);
            return;
        }
        int pathIdx = 1;
        if (call.childCount() <= pathIdx) {
            this.emitEmptyStringArray();
            return;
        }
        this.genExpr(call.child(pathIdx));
        int dirOff = this.allocLocal("__fd_dir");
        this.asm.movMBaseR(5, 0, dirOff);

        // dlen = strlen(dir)
        this.asm.movRMBase(1, 5, dirOff);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int dlenOff = this.allocLocal("__fd_dlen");
        this.asm.movMBaseR(5, 0, dlenOff);

        // pattern = malloc(dlen + 3)
        this.asm.movRMBase(1, 5, dlenOff);
        this.asm.addRI32(1, 3);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int patOff = this.allocLocal("__fd_pat");
        this.asm.movMBaseR(5, 0, patOff);

        // memcpy(pattern, dir, dlen)
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, patOff);
        this.asm.movRMBase(2, 5, dirOff);
        this.asm.movRMBase(8, 5, dlenOff);
        this.addImportPatch("ucrtbase.dll", "memcpy");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        // pattern[dlen] = '\\', [dlen+1] = '*', [dlen+2] = 0
        this.asm.movRMBase(0, 5, patOff);
        this.asm.movRMBase(1, 5, dlenOff);
        this.asm.addRR64(0, 1);
        this.asm.movRI64(1, 92);
        this.asm.movMBaseByteR(0, 1, 0);
        this.asm.movRI64(1, 42);
        this.asm.movMBaseByteR(0, 1, 1);
        this.asm.movRI64(1, 0);
        this.asm.movMBaseByteR(0, 1, 2);

        // fd = malloc(320)
        this.asm.movRI64(1, 320);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int fdOff = this.allocLocal("__fd_fd");
        this.asm.movMBaseR(5, 0, fdOff);

        // h = FindFirstFileA(pattern, fd)
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, patOff);
        this.asm.movRMBase(2, 5, fdOff);
        this.addImportPatch("kernel32.dll", "FindFirstFileA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int hOff = this.allocLocal("__fd_h");
        this.asm.movMBaseR(5, 0, hOff);

        int noFiles = this.newLabel();

        int cntOff = this.allocLocal("__fd_cnt");
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, cntOff);
        this.asm.movRI64(1, 0xFFFFFFFFFFFFFFFF);
        this.asm.cmpRR64(0, 1);
        this.asm.jeLabel(noFiles);

        // Pass 1: count matching entries
        int p1Loop = this.newLabel();
        int p1Skip = this.newLabel();
        this.asm.bindLabel(p1Loop);
        this.emitEntryTest(fdOff, filter, p1Skip);
        this.asm.movRMBase(0, 5, cntOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, cntOff);
        this.asm.bindLabel(p1Skip);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hOff);
        this.asm.movRMBase(2, 5, fdOff);
        this.addImportPatch("kernel32.dll", "FindNextFileA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.cmpRI32(0, 0);
        this.asm.jneLabel(p1Loop);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hOff);
        this.addImportPatch("kernel32.dll", "FindClose");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        // arr = malloc((cnt + 2) * 8); [0]=cnt, [8]=cnt
        this.asm.movRMBase(0, 5, cntOff);
        this.asm.addRI32(0, 2);
        this.asm.shlR64Imm(0, 3);
        this.asm.movRR64(1, 0);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int arrOff = this.allocLocal("__fd_arr");
        this.asm.movMBaseR(5, 0, arrOff);
        this.asm.movRMBase(1, 5, cntOff);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRMBase(1, 5, cntOff);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movMBaseR(0, 1, 8);

        // Pass 2: re-find and fill
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, patOff);
        this.asm.movRMBase(2, 5, fdOff);
        this.addImportPatch("kernel32.dll", "FindFirstFileA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, hOff);
        this.asm.movRI64(1, 0xFFFFFFFFFFFFFFFF);
        this.asm.cmpRR64(0, 1);
        this.asm.jeLabel(noFiles);

        int widxOff = this.allocLocal("__fd_widx");
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, widxOff);
        int p2Loop = this.newLabel();
        int p2Skip = this.newLabel();
        this.asm.bindLabel(p2Loop);
        this.emitEntryTest(fdOff, filter, p2Skip);

        // namelen = strlen(fd + 44)
        this.asm.movRMBase(1, 5, fdOff);
        this.asm.addRI32(1, 44);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int nlenOff = this.allocLocal("__fd_nlen");
        this.asm.movMBaseR(5, 0, nlenOff);

        // buf = malloc(nlen + 1)
        this.asm.movRMBase(1, 5, nlenOff);
        this.asm.addRI32(1, 1);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int bufOff = this.allocLocal("__fd_buf");
        this.asm.movMBaseR(5, 0, bufOff);

        // memcpy(buf, fd+44, nlen); buf[nlen] = 0
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, bufOff);
        this.asm.movRMBase(2, 5, fdOff);
        this.asm.addRI32(2, 44);
        this.asm.movRMBase(8, 5, nlenOff);
        this.addImportPatch("ucrtbase.dll", "memcpy");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRMBase(0, 5, bufOff);
        this.asm.movRMBase(1, 5, nlenOff);
        this.asm.addRR64(0, 1);
        this.asm.movRI64(1, 0);
        this.asm.movMBaseByteR(0, 1, 0);

        // arr[16 + widx*8] = buf
        this.asm.movRMBase(0, 5, widxOff);
        this.asm.shlR64Imm(0, 3);
        this.asm.addRI32(0, 16);
        this.asm.movRMBase(1, 5, arrOff);
        this.asm.addRR64(1, 0);
        this.asm.movRMBase(0, 5, bufOff);
        this.asm.movMBaseR(1, 0, 0);

        this.asm.movRMBase(0, 5, widxOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, widxOff);

        this.asm.bindLabel(p2Skip);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hOff);
        this.asm.movRMBase(2, 5, fdOff);
        this.addImportPatch("kernel32.dll", "FindNextFileA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.cmpRI32(0, 0);
        this.asm.jneLabel(p2Loop);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hOff);
        this.addImportPatch("kernel32.dll", "FindClose");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.movRMBase(0, 5, arrOff);
        this.asm.addRI32(0, 16);
        int feDone = this.newLabel();
        this.asm.jmpLabel(feDone);
        this.asm.bindLabel(noFiles);
        this.emitEmptyStringArray();
        this.asm.bindLabel(feDone);
    }

    // LINUX SysV backend (additive): empty string array via libc malloc
    // (mirrors emitEmptyStringArray layout [8,0] +16 but through the SysV
    // heap helper, not the Win64 shuffle path).
    public void genLinuxEmptyStringArray() {
        this.linuxBackend.genLinuxEmptyStringArray(this);
    }

    // LINUX SysV backend (additive): branch to skip when the dirent at
    // nodeOff should be excluded: "." / ".." pseudo-entries (d_name at
    // offset 19, per silverc/std/fs.sr readDirNames) or entries failing
    // filter via d_type at offset 18 (4=dir, 8=file). Mirrors emitEntryTest
    // shape but for libc dirent instead of WIN32_FIND_DATA.
    public void emitLinuxDirentTest(int nodeOff, int filter, int skip) {
        this.linuxBackend.emitLinuxDirentTest(this, nodeOff, filter, skip);
    }

    // LINUX SysV backend (additive): folder entries via libc
    // opendir/readdir/closedir, skipping "." and ".." and applying filter
    // (0=all, 1=files, 2=folders) via d_type, mirroring silverc/std/fs.sr's
    // #on LINUX readDirNames body and the two-pass WINDOWS shape above
    // (count then fill, array header [cnt,cnt] +16). SysV regs +
    // addImportPatchDirect + emitAbiCallSetup/teardown.
    public void genLinuxFolderEntriesCall(Node call, int filter) {
        this.linuxBackend.genLinuxFolderEntriesCall(this, call, filter);
    }

    // Branch to `skip` when the entry described by findData at fdOff should be
    // excluded: "." / ".." pseudo-entries, or entries failing `filter`.
    public void emitEntryTest(int fdOff, int filter, int skip) {
        this.asm.movRMBase(0, 5, fdOff);
        this.asm.addRI32(0, 44);
        int checkFilter = this.newLabel();
        this.asm.movzxByteMBase(1, 0, 0);
        this.asm.cmpRI32(1, 46);
        this.asm.jneLabel(checkFilter);
        this.asm.movzxByteMBase(1, 0, 1);
        this.asm.cmpRI32(1, 0);
        this.asm.jeLabel(skip);
        this.asm.cmpRI32(1, 46);
        this.asm.jneLabel(checkFilter);
        this.asm.movzxByteMBase(1, 0, 2);
        this.asm.cmpRI32(1, 0);
        this.asm.jeLabel(skip);
        this.asm.bindLabel(checkFilter);
        if (filter == 1) {
            // files: skip directories (attribute 0x10 set)
            this.asm.movRMBase(0, 5, fdOff);
            this.asm.movRMBase(1, 0, 0);
            this.asm.andRImm(1, 0x10);
            this.asm.cmpRI32(1, 0);
            this.asm.jneLabel(skip);
        } else if (filter == 2) {
            // folders: skip files (attribute 0x10 not set)
            this.asm.movRMBase(0, 5, fdOff);
            this.asm.movRMBase(1, 0, 0);
            this.asm.andRImm(1, 0x10);
            this.asm.cmpRI32(1, 0);
            this.asm.jeLabel(skip);
        }
    }

    public void emitEmptyStringArray() {
        this.asm.movRI64(1, 80);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);

        this.asm.emitCallTeardown();
        this.asm.movRI64(1, 8);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRI64(1, 0);
        this.asm.movMBaseR(0, 1, 8);
        this.asm.addRI32(0, 16);
    }

    public void genOsVersionCall() {
        this.windowsBackend.genOsVersionCall(this);
    }

    public void genOsBuildCall() {
        this.windowsBackend.genOsBuildCall(this);
    }

    public void genGetExtCall(Node call) {
        // file.getExt(path) - returns extension after last dot.

        // Uses strrchr; returns a pointer into the original string.
        int pathIdx = 0;
        if (call.isMember) { pathIdx = 1; }
        if (call.childCount() <= pathIdx) { this.emitLlmaiStringLiteral(""); return; }

        this.genExpr(call.child(pathIdx));
        int pOff = this.allocLocal("__ge_p");
        this.asm.movMBaseR(5, 0, pOff);

        // strrchr(path, '.'). Same pattern as genStrlenCall.
        this.asm.movRR64(1, 0);
        this.asm.movRI64(2, 46);
        this.addImportPatch("ucrtbase.dll", "strrchr");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        // R0 = dot or NULL
        int dOff = this.allocLocal("__ge_d");
        this.asm.movMBaseR(5, 0, dOff);

        int geHas = this.newLabel();
        int geEnd = this.newLabel();
        this.asm.cmpRI32(0, 0);
        this.asm.jneLabel(geHas);

        // No dot
        this.emitLlmaiStringLiteral("");
        this.asm.jmpLabel(geEnd);

        // Has dot: return dot + 1
        this.asm.bindLabel(geHas);
        this.asm.movRMBase(0, 5, dOff);
        this.asm.movRI64(1, 1);
        this.asm.addRR64(0, 1);

        this.asm.bindLabel(geEnd);
    }

    public void genReadStringCall(Node call) {
        // The path argument sits at child(1) for member calls (`file.readString(p)`
        // where child(0) is the receiver) but at child(0) for the global
        // `readFile(p)` builtin.  Using the wrong slot silently skipped the
        // read and left garbage in RAX.
        int pathIdx = 0;
        if (call.isMember) { pathIdx = 1; }
        if (call.childCount() <= pathIdx) { return; }
        this.genExpr(call.child(pathIdx));
        int pathOff = this.allocLocal("__rs_path");
        this.asm.movMBaseR(5, 0, pathOff);
        // LINUX SysV backend (additive): stat-sized open/read/close via
        // libc (genLinuxReadStringFile). The WINDOWS block below is
        // byte-identical to before.
        if (this.isLinuxTarget()) {
            this.genLinuxReadStringFile(pathOff);
            return;
        }

        this.asm.emitCallSetup(24);
        this.asm.movRI64(0, 3);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRI64(0, 0x80);
        this.asm.movMBaseR(4, 0, 40);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(4, 0, 48);
        this.asm.movRMBase(1, 5, pathOff);
        this.asm.movRI64(2, 0x80000000);
        this.asm.movRI64(8, 1);
        this.asm.xorRR64(9, 9);
        this.addImportPatch("kernel32.dll", "CreateFileA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int hfileOff = this.allocLocal("__rs_hfile");
        this.asm.movMBaseR(5, 0, hfileOff);

        // CreateFileA returns INVALID_HANDLE_VALUE (-1) when the path does
        // not exist. Throw FileNotFoundException ("file not found"), matching
        // silverc-rs gen_read_string and the managed fs.readString.
        int rsEmpty = this.newLabel();
        int rsDone = this.newLabel();
        int rsCont = this.newLabel();
        this.asm.movRI64(1, 0xFFFFFFFFFFFFFFFF);
        this.asm.cmpRR64(0, 1);
        this.asm.jneLabel(rsCont);
        this.asm.jmpLabel(rsEmpty);
        this.asm.bindLabel(rsCont);

        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hfileOff);
        this.asm.xorRR64(2, 2);
        this.addImportPatch("kernel32.dll", "GetFileSize");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int sizeOff = this.allocLocal("__rs_size");
        this.asm.movMBaseR(5, 0, sizeOff);

        this.asm.emitCallSetup(0);
        this.emitGetProcessHeapCall();
        this.asm.emitCallTeardown();

        this.asm.emitCallSetup(0);
        this.asm.movRR64(1, 0);
        this.asm.xorRR64(2, 2);
        this.asm.movRMBase(8, 5, sizeOff);
        this.asm.addRI32(8, 1);
        this.emitHeapAllocCall();
        this.asm.emitCallTeardown();

        int bufOff = this.allocLocal("__rs_buf");
        this.asm.movMBaseR(5, 0, bufOff);

        int breadOff = this.allocLocal("__rs_bread");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, breadOff);

        this.asm.emitCallSetup(8);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRMBase(1, 5, hfileOff);
        this.asm.movRMBase(2, 5, bufOff);
        this.asm.movRMBase(8, 5, sizeOff);
        this.asm.leaRBase(9, 5, breadOff);
        this.addImportPatch("kernel32.dll", "ReadFile");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        // HeapAlloc reserves size + 1 bytes; terminate the source buffer so
        // string.length and the lexer never read past the bytes returned by
        // ReadFile.  This is essential when the next byte is non-zero in a
        // reused heap block, and keeps every bootstrap stage deterministic.
        this.asm.movRMBase(0, 5, bufOff);
        this.asm.movRMBase(1, 5, breadOff);
        this.asm.addRR64(0, 1);
        this.asm.movRI64(1, 0);
        this.asm.movMBaseByteR(0, 1, 0);

        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hfileOff);
        this.addImportPatch("kernel32.dll", "CloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.movRMBase(0, 5, bufOff);
        this.asm.jmpLabel(rsDone);
        this.asm.bindLabel(rsEmpty);
        this.emitThrowException("file not found");
        this.asm.bindLabel(rsDone);
    }

    // LINUX SysV backend (additive): readString via libc stat + open +
    // read + close (stat st_size at offset 48 sizes a heap buffer that is
    // NUL-terminated at the bytes read, mirroring the WINDOWS GetFileSize
    // + ReadFile shape below and silverc/std/fs.sr's LINUX readString
    // semantics). Missing files throw "file not found" like the WINDOWS
    // path; an empty file yields "". SysV regs + addImportPatchDirect +
    // emitAbiCallSetup/teardown, beside the unchanged WINDOWS block.
    public void genLinuxReadStringFile(int pathOff) {
        this.linuxBackend.genLinuxReadStringFile(this, pathOff);
    }

    // input() builtin: reads a line from stdin via GetStdHandle + ReadFile.
    // Modeled after genReadStringCall but uses the stdin handle instead of
    // CreateFileA, and a fixed-size (4096-byte) heap buffer.
    public void genInputCall(Node call) {
        // LINUX SysV backend (additive): read(0, buf, 4096) instead.
        if (this.isLinuxTarget()) {
            this.genLinuxInputCall();
            return;
        }
        // GetStdHandle(-10) -> stdin handle
        this.asm.emitCallSetup(0);
        this.asm.movRI64(1, -10);
        this.addImportPatch("kernel32.dll", "GetStdHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int hstdinOff = this.allocLocal("__in_hstdin");
        this.asm.movMBaseR(5, 0, hstdinOff);

        // Allocate a 4096-byte heap buffer
        int bufSize = 4096;
        int sizeOff = this.allocLocal("__in_size");
        this.asm.movRI64(0, bufSize);
        this.asm.movMBaseR(5, 0, sizeOff);

        this.asm.emitCallSetup(0);
        this.emitGetProcessHeapCall();
        this.asm.emitCallTeardown();

        this.asm.emitCallSetup(0);
        this.asm.movRR64(1, 0);
        this.asm.xorRR64(2, 2);
        this.asm.movRMBase(8, 5, sizeOff);
        this.emitHeapAllocCall();
        this.asm.emitCallTeardown();

        int bufOff = this.allocLocal("__in_buf");
        this.asm.movMBaseR(5, 0, bufOff);

        int breadOff = this.allocLocal("__in_bread");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, breadOff);

        // ReadFile(stdin, buf, 4096, &read, 0)
        this.asm.emitCallSetup(8);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRMBase(1, 5, hstdinOff);
        this.asm.movRMBase(2, 5, bufOff);
        this.asm.movRMBase(8, 5, sizeOff);
        this.asm.leaRBase(9, 5, breadOff);
        this.addImportPatch("kernel32.dll", "ReadFile");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        // Null-terminate the buffer at the bytes-read position
        this.asm.movRMBase(0, 5, bufOff);
        this.asm.movRMBase(1, 5, breadOff);
        this.asm.addRR64(0, 1);
        this.asm.movRI64(1, 0);
        this.asm.movMBaseByteR(0, 1, 0);

        // Return buffer pointer in RAX
        this.asm.movRMBase(0, 5, bufOff);
    }

    // LINUX SysV backend (additive): read(0, buf, 4096) into a heap buffer,
    // NUL-terminated at the bytes-read position. A negative read (error)
    // yields the empty string.
    public void genLinuxInputCall() {
        this.linuxBackend.genLinuxInputCall(this);
    }

    public void emitLlmaiStringLiteral(string s) {
        int strIdx = this.addString(s);
        int sp = this.asm.buf.length;
        this.asm.emitImm64(0, 0);
        int strPatchPos = sp + 2;
        this.stringPatchOffsets.add(strPatchPos);
        this.stringPatchIndices.add(strIdx);
    }

    // LINUX SysV backend (additive): HeapAlloc(handle, flags, size) with
    // size in R8 becomes malloc(R8) + memset zeroing (the HEAP_ZERO_MEMORY
    // contract). Mirrors silverc-rs emit_heap_alloc_linux. RCX/RDX are
    // ignored. Uses Direct imports (never the redirect slot, so a runtime
    // fallback through here cannot recurse). In runtimeMode the malloc
    // reference is recorded for the patchRuntimeRefs redirect.
    public void emitLinuxHeapAllocFromR8() {
        this.linuxBackend.emitLinuxHeapAllocFromR8(this);
    }

    // Call-site wrappers for the inline GetProcessHeap/HeapAlloc pairs: on
    // Linux take the malloc/free path, otherwise emit the historical Win64
    // 4-liner byte-identically (setup/teardown stay at the call sites).
    public void emitGetProcessHeapCall() {
        // No process-heap handle on Linux (malloc/free take none); a dummy
        // zero keeps the following mov RCX,RAX harmless. Mirrors silverc-rs
        // emit_get_process_heap.
        if (this.isLinuxTarget()) {
            this.asm.xorRR64(0, 0);
            return;
        }
        this.addImportPatch("kernel32.dll", "GetProcessHeap");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
    }

    public void emitHeapAllocCall() {
        // R8 = size on entry (both targets).
        if (this.isLinuxTarget()) {
            this.emitLinuxHeapAllocFromR8();
            return;
        }
        this.addImportPatch("kernel32.dll", "HeapAlloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
    }

    public void emitLlmaiHeapAlloc(int sizeOff) {
        // RAX = HeapAlloc(GetProcessHeap(), 0, [sizeOff])
        // LINUX SysV backend (additive): malloc + memset zeroing from the
        // size local (same HEAP_ZERO_MEMORY contract as the Win64 pair).
        if (this.isLinuxTarget()) {
            this.asm.movRMBase(8, 5, sizeOff);
            this.emitLinuxHeapAllocFromR8();
            return;
        }
        this.asm.emitCallSetup(0);
        this.addImportPatch("kernel32.dll", "GetProcessHeap");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.emitCallSetup(0);
        this.asm.movRR64(1, 0);
        this.asm.xorRR64(2, 2);
        this.asm.movRMBase(8, 5, sizeOff);
        this.addImportPatch("kernel32.dll", "HeapAlloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }

    public bool isLiveHeapType(string t) {
        if (t == "string" || t == "string?") { return true; }
        if (t.length >= 2) {
            if (t[t.length - 2] == '[' && t[t.length - 1] == ']') { return true; }
        }
        for (int ci = 0; ci < this.classNames.length; ci++) {
            if (this.classNames[ci] == t) { return true; }
        }
        return false;
    }

    public void registerLiveSlot(int off, string t) {
        this.liveSlots.add(off);
        bool isArr = false;
        if (t.length >= 2) {
            if (t[t.length - 2] == '[' && t[t.length - 1] == ']') { isArr = true; }
        }
        this.liveSlotIsArray.add(isArr);
    }

    public void emitLlmaiStringDup() {
        // RAX = source string; returns RAX = heap copy so a live string can be
        // freed at scope exit (string literals point at static data).
        int dupSrc = this.allocLocal("__dup_src");
        this.asm.movMBaseR(5, 0, dupSrc);
        this.asm.movRR64(1, 0);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD1);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.addRI32(0, 1);
        this.asm.movRR64(1, 0);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int dupNew = this.allocLocal("__dup_new");
        this.asm.movMBaseR(5, 0, dupNew);
        this.asm.movRMBase(1, 5, dupNew);
        this.asm.movRMBase(2, 5, dupSrc);
        this.addImportPatch("ucrtbase.dll", "strcpy");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD4);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRMBase(0, 5, dupNew);
    }

    public void emitLlmaiEmptyString() {
        int emptySize = this.allocLocal("__llmai_empty_size");
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, emptySize);
        this.emitLlmaiHeapAlloc(emptySize);
        this.asm.movRI64(1, 0);
        this.asm.movMBaseByteR(0, 1, 0);
    }

    public void emitLlmaiMemcpy(int dstOff, int srcOff, int lenOff, int idxOff) {
        // for idx in 0..len: dst[idx] = src[idx]
        int cpLoop = this.newLabel();
        int cpEnd = this.newLabel();
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, idxOff);
        this.asm.bindLabel(cpLoop);
        this.asm.movRMBase(0, 5, idxOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(cpEnd);
        // byte = src[idx]
        this.asm.movRMBase(0, 5, srcOff);
        this.asm.movRMBase(1, 5, idxOff);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(2, 0, 0);
        // dst[idx] = byte  (movByteMBaseIdxR encodes [base + index])
        this.asm.movRMBase(0, 5, dstOff);
        this.asm.movRMBase(1, 5, idxOff);
        this.asm.movByteMBaseIdxR(0, 1, 2);
        this.asm.movRMBase(0, 5, idxOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, idxOff);
        this.asm.jmpLabel(cpLoop);
        this.asm.bindLabel(cpEnd);
    }

    // llmai.chat(url, headers, body) -> raw HTTP response body string.
    // Emits a WinInet POST (ANSI versions, no UTF-16 conversion needed) with
    // the URL parsed at runtime: host/port/path are extracted from `url`.
    public void genLlmaiChatCall(Node call) {
        // LINUX SysV backend (additive): WinInet has no Linux equivalent.
        // Without this, the WinInet import patches below survive onto the
        // Linux target verbatim (linuxImportLib/linuxImportName leave
        // wininet.dll unmapped), yielding DT_NEEDED wininet.dll and a
        // binary that cannot load. Degrade gracefully like the http bridge
        // stubs: return a valid empty string (emitLlmaiEmptyString takes
        // the malloc path on Linux) and emit no WinInet calls. Full HTTPS
        // bridging is out of scope. WINDOWS emission below is untouched.
        if (this.isLinuxTarget()) {
            this.emitLlmaiEmptyString();
            return;
        }
        if (call.childCount() < 4) {
            this.emitLlmaiEmptyString();
            return;
        }
        this.genExpr(call.child(1));
        int urlOff = this.allocLocal("__llmai_url");
        this.asm.movMBaseR(5, 0, urlOff);

        this.genExpr(call.child(2));
        int hdrOff = this.allocLocal("__llmai_hdr");
        this.asm.movMBaseR(5, 0, hdrOff);
        this.genExpr(call.child(3));
        int bodyOff = this.allocLocal("__llmai_body");
        this.asm.movMBaseR(5, 0, bodyOff);

        int schemeOff = this.allocLocal("__llmai_scheme");
        int hstartOff = this.allocLocal("__llmai_hstart");
        int hlenOff = this.allocLocal("__llmai_hlen");
        int portOff = this.allocLocal("__llmai_port");
        int pathOff = this.allocLocal("__llmai_path");
        int jOff = this.allocLocal("__llmai_j");
        int kOff = this.allocLocal("__llmai_k");
        int hbufOff = this.allocLocal("__llmai_hbuf");
        int hinOff = this.allocLocal("__llmai_hin");
        int hcoOff = this.allocLocal("__llmai_hco");
        int hreOff = this.allocLocal("__llmai_hre");
        int resOff = this.allocLocal("__llmai_res");
        int resCapOff = this.allocLocal("__llmai_rescap");
        int resLenOff = this.allocLocal("__llmai_reslen");
        int chunkOff = this.allocLocal("__llmai_chunk");
        int breadOff = this.allocLocal("__llmai_bread");
        int tmpOff = this.allocLocal("__llmai_tmp");
        int idxOff = this.allocLocal("__llmai_idx");

        // ---- URL parse: p = strstr(url, "://") ----
        this.emitLlmaiStringLiteral("://");
        this.asm.movMBaseR(5, 0, schemeOff);
        this.asm.movRMBase(1, 5, urlOff);
        this.asm.movRMBase(2, 5, schemeOff);
        this.addImportPatch("msvcrt.dll", "strstr");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int noScheme = this.newLabel();
        int afterScheme = this.newLabel();
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(noScheme);
        this.asm.addRI32(0, 3);
        this.asm.movMBaseR(5, 0, hstartOff);
        this.asm.jmpLabel(afterScheme);
        this.asm.bindLabel(noScheme);
        this.asm.movRMBase(0, 5, urlOff);
        this.asm.movMBaseR(5, 0, hstartOff);
        this.asm.bindLabel(afterScheme);

        // ---- scan host: j=0; while host[j] not in {0, ':', '/'}: j++ ----
        int hostLoop = this.newLabel();
        int hostDone = this.newLabel();
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, jOff);
        this.asm.bindLabel(hostLoop);
        this.asm.movRMBase(0, 5, hstartOff);
        this.asm.movRMBase(1, 5, jOff);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(0, 0, 0);
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(hostDone);
        this.asm.cmpRI32(0, 58);
        this.asm.jeLabel(hostDone);
        this.asm.cmpRI32(0, 47);
        this.asm.jeLabel(hostDone);
        this.asm.movRMBase(0, 5, jOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, jOff);
        this.asm.jmpLabel(hostLoop);
        this.asm.bindLabel(hostDone);
        this.asm.movRMBase(0, 5, jOff);
        this.asm.movMBaseR(5, 0, hlenOff);

        // ---- default port: https -> 443, else 80 ----
        int notHttps = this.newLabel();
        int httpsDone = this.newLabel();
        this.asm.movRMBase(0, 5, urlOff);
        this.asm.movzxByteMBase(1, 0, 0);
        this.asm.cmpRI32(1, 104);
        this.asm.jneLabel(notHttps);
        this.asm.movRMBase(0, 5, urlOff);
        this.asm.movzxByteMBase(1, 0, 1);
        this.asm.cmpRI32(1, 116);
        this.asm.jneLabel(notHttps);
        this.asm.movRMBase(0, 5, urlOff);
        this.asm.movzxByteMBase(1, 0, 2);
        this.asm.cmpRI32(1, 116);
        this.asm.jneLabel(notHttps);
        this.asm.movRMBase(0, 5, urlOff);
        this.asm.movzxByteMBase(1, 0, 3);
        this.asm.cmpRI32(1, 112);
        this.asm.jneLabel(notHttps);
        this.asm.movRMBase(0, 5, urlOff);
        this.asm.movzxByteMBase(1, 0, 4);
        this.asm.cmpRI32(1, 115);
        this.asm.jneLabel(notHttps);
        this.asm.movRI64(0, 443);
        this.asm.movMBaseR(5, 0, portOff);
        this.asm.jmpLabel(httpsDone);

        this.asm.bindLabel(notHttps);
        this.asm.movRI64(0, 80);
        this.asm.movMBaseR(5, 0, portOff);
        this.asm.bindLabel(httpsDone);

        // ---- path handling ----
        this.emitLlmaiStringLiteral("/");
        this.asm.movMBaseR(5, 0, pathOff);
        int pathColon = this.newLabel();
        int pathSlash = this.newLabel();
        int pathNone = this.newLabel();
        int pathDone = this.newLabel();
        this.asm.movRMBase(0, 5, hstartOff);
        this.asm.movRMBase(1, 5, jOff);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(0, 0, 0);
        this.asm.cmpRI32(0, 58);
        this.asm.jeLabel(pathColon);
        this.asm.cmpRI32(0, 47);
        this.asm.jeLabel(pathSlash);
        this.asm.jmpLabel(pathNone);

        // ':' -> parse port digits, then find '/' at or after them
        this.asm.bindLabel(pathColon);
        this.asm.movRMBase(0, 5, jOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, kOff);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, portOff);
        int portLoop = this.newLabel();
        int portDone = this.newLabel();
        this.asm.bindLabel(portLoop);
        this.asm.movRMBase(0, 5, hstartOff);
        this.asm.movRMBase(1, 5, kOff);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(2, 0, 0);
        this.asm.cmpRI32(2, 48);
        this.asm.jlLabel(portDone);
        this.asm.cmpRI32(2, 57);
        this.asm.jgLabel(portDone);
        this.asm.movRMBase(0, 5, portOff);
        this.asm.movRI64(1, 10);
        this.asm.imulRR64(0, 1);
        this.asm.subRI32(2, 48);
        this.asm.addRR64(0, 2);
        this.asm.movMBaseR(5, 0, portOff);
        this.asm.movRMBase(0, 5, kOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, kOff);
        this.asm.jmpLabel(portLoop);
        this.asm.bindLabel(portDone);
        int pathFind = this.newLabel();
        int pathFindDone = this.newLabel();
        int pathFromK = this.newLabel();
        this.asm.bindLabel(pathFind);
        this.asm.movRMBase(0, 5, hstartOff);
        this.asm.movRMBase(1, 5, kOff);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(0, 0, 0);
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(pathFindDone);
        this.asm.cmpRI32(0, 47);
        this.asm.jeLabel(pathFromK);
        this.asm.movRMBase(0, 5, kOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, kOff);
        this.asm.jmpLabel(pathFind);
        this.asm.bindLabel(pathFindDone);
        this.asm.jmpLabel(pathDone);
        // '/' found after the port digits -> path = host + k
        this.asm.bindLabel(pathFromK);
        this.asm.movRMBase(0, 5, hstartOff);
        this.asm.movRMBase(1, 5, kOff);
        this.asm.addRR64(0, 1);
        this.asm.movMBaseR(5, 0, pathOff);
        this.asm.jmpLabel(pathDone);

        // '/' at host[j] -> path = host + j
        this.asm.bindLabel(pathSlash);
        this.asm.movRMBase(0, 5, hstartOff);
        this.asm.movRMBase(1, 5, jOff);
        this.asm.addRR64(0, 1);
        this.asm.movMBaseR(5, 0, pathOff);
        this.asm.jmpLabel(pathDone);

        // no path -> keep "/"
        this.asm.bindLabel(pathNone);
        this.asm.bindLabel(pathDone);

        // ---- copy host to a heap buffer: hbuf = HeapAlloc(hostLen + 1) ----
        this.asm.movRMBase(0, 5, hlenOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, tmpOff);
        this.emitLlmaiHeapAlloc(tmpOff);
        this.asm.movMBaseR(5, 0, hbufOff);
        this.emitLlmaiMemcpy(hbufOff, hstartOff, hlenOff, idxOff);
        this.asm.movRMBase(0, 5, hbufOff);
        this.asm.movRMBase(1, 5, hlenOff);
        this.asm.addRR64(0, 1);
        this.asm.movRI64(1, 0);

        this.asm.movMBaseByteR(0, 1, 0);

        // ---- InternetOpenA(NULL, 0, NULL, NULL, 0) ----
        this.asm.emitCallSetup(8);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.xorRR64(1, 1);
        this.asm.xorRR64(2, 2);
        this.asm.xorRR64(8, 8);
        this.asm.xorRR64(9, 9);
        this.addImportPatch("wininet.dll", "InternetOpenA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, hinOff);

        int failInet = this.newLabel();
        int failConn = this.newLabel();
        int failReq = this.newLabel();
        int failSend = this.newLabel();
        int readLoop = this.newLabel();
        int readDone = this.newLabel();
        int doneLbl = this.newLabel();

        this.asm.movRMBase(0, 5, hinOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(failInet);

        // ---- InternetConnectA(hin, host, port, NULL, NULL, HTTP(3), 0, 0) ----
        this.asm.emitCallSetup(32);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRI64(0, 3);
        this.asm.movMBaseR(4, 0, 40);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(4, 0, 48);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(4, 0, 56);
        this.asm.movRMBase(1, 5, hinOff);
        this.asm.movRMBase(2, 5, hbufOff);
        this.asm.movRMBase(8, 5, portOff);
        this.asm.xorRR64(9, 9);
        this.addImportPatch("wininet.dll", "InternetConnectA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, hcoOff);

        this.asm.movRMBase(0, 5, hcoOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(failConn);

        // ---- HttpOpenRequestA(hco, "POST", path, NULL, NULL, NULL, FLAGS, 0) ----
        this.emitLlmaiStringLiteral("POST");
        this.asm.movMBaseR(5, 0, tmpOff);
        this.asm.emitCallSetup(32);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(4, 0, 40);
        this.asm.movRI64(0, 0x84800200);
        this.asm.movMBaseR(4, 0, 48);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(4, 0, 56);
        this.asm.movRMBase(1, 5, hcoOff);
        this.asm.movRMBase(2, 5, tmpOff);
        this.asm.movRMBase(8, 5, pathOff);
        this.asm.xorRR64(9, 9);
        this.addImportPatch("wininet.dll", "HttpOpenRequestA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, hreOff);

        this.asm.movRMBase(0, 5, hreOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(failReq);

        // ---- strlen(body) ----
        this.asm.movRMBase(1, 5, bodyOff);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, tmpOff);

        // ---- HttpSendRequestA(hre, headers, -1, body, strlen(body)) ----
        this.asm.emitCallSetup(8);
        this.asm.movRMBase(0, 5, tmpOff);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRMBase(1, 5, hreOff);
        this.asm.movRMBase(2, 5, hdrOff);
        this.asm.movRI64(8, 0xFFFFFFFF);
        this.asm.movRMBase(9, 5, bodyOff);
        this.addImportPatch("wininet.dll", "HttpSendRequestA");

        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(failSend);

        // ---- allocate result (8192) and chunk (4096) ----
        this.asm.movRI64(0, 8192);
        this.asm.movMBaseR(5, 0, resCapOff);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, resLenOff);
        this.asm.movRI64(0, 8192);
        this.asm.movMBaseR(5, 0, tmpOff);
        this.emitLlmaiHeapAlloc(tmpOff);
        this.asm.movMBaseR(5, 0, resOff);
        this.asm.movRI64(0, 4096);
        this.asm.movMBaseR(5, 0, tmpOff);
        this.emitLlmaiHeapAlloc(tmpOff);
        this.asm.movMBaseR(5, 0, chunkOff);

        // ---- read loop ----
        this.asm.bindLabel(readLoop);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, breadOff);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hreOff);
        this.asm.movRMBase(2, 5, chunkOff);
        this.asm.movRI64(8, 4096);
        this.asm.leaRBase(9, 5, breadOff);
        this.addImportPatch("wininet.dll", "InternetReadFile");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(readDone);
        this.asm.movRMBase(0, 5, breadOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(readDone);

        // need to grow? resLen + bread >= resCap
        int noGrow = this.newLabel();
        int growCapLoop = this.newLabel();
        int growCapDone = this.newLabel();
        this.asm.movRMBase(0, 5, resLenOff);
        this.asm.movRMBase(1, 5, breadOff);
        this.asm.addRR64(0, 1);
        this.asm.movRMBase(1, 5, resCapOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jlLabel(noGrow);
        // newCap = resCap; while (newCap < resLen + bread + 1) newCap *= 2
        this.asm.movRMBase(0, 5, resCapOff);
        this.asm.movMBaseR(5, 0, tmpOff);
        this.asm.bindLabel(growCapLoop);
        this.asm.movRMBase(0, 5, resLenOff);
        this.asm.movRMBase(1, 5, breadOff);
        this.asm.addRR64(0, 1);
        this.asm.addRI32(0, 1);
        this.asm.movRMBase(1, 5, tmpOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jleLabel(growCapDone);
        this.asm.movRMBase(0, 5, tmpOff);
        this.asm.addRR64(0, 0);
        this.asm.movMBaseR(5, 0, tmpOff);
        this.asm.jmpLabel(growCapLoop);
        this.asm.bindLabel(growCapDone);
        // newRes = HeapAlloc(newCap); copy res[0..resLen]
        int newResOff = this.allocLocal("__llmai_newres");
        this.emitLlmaiHeapAlloc(tmpOff);
        this.asm.movMBaseR(5, 0, newResOff);
        this.emitLlmaiMemcpy(newResOff, resOff, resLenOff, idxOff);
        this.asm.movRMBase(0, 5, newResOff);
        this.asm.movMBaseR(5, 0, resOff);
        this.asm.movRMBase(0, 5, tmpOff);
        this.asm.movMBaseR(5, 0, resCapOff);
        this.asm.bindLabel(noGrow);

        // copy chunk[0..bread] into res + resLen
        this.asm.movRMBase(0, 5, resOff);
        this.asm.movRMBase(1, 5, resLenOff);
        this.asm.addRR64(0, 1);
        int dstBaseOff = this.allocLocal("__llmai_dstbase");
        this.asm.movMBaseR(5, 0, dstBaseOff);
        this.emitLlmaiMemcpy(dstBaseOff, chunkOff, breadOff, idxOff);
        this.asm.movRMBase(0, 5, resLenOff);
        this.asm.movRMBase(1, 5, breadOff);
        this.asm.addRR64(0, 1);
        this.asm.movMBaseR(5, 0, resLenOff);
        this.asm.jmpLabel(readLoop);

        // ---- finish: terminate, close, return res ----
        this.asm.bindLabel(readDone);
        this.asm.movRMBase(0, 5, resOff);
        this.asm.movRMBase(1, 5, resLenOff);
        this.asm.addRR64(0, 1);
        this.asm.movRI64(1, 0);
        this.asm.movMBaseByteR(0, 1, 0);
        this.asm.emitCallSetup(0);

        this.asm.movRMBase(1, 5, hreOff);
        this.addImportPatch("wininet.dll", "InternetCloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hcoOff);
        this.addImportPatch("wininet.dll", "InternetCloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hinOff);
        this.addImportPatch("wininet.dll", "InternetCloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movRMBase(0, 5, resOff);
        this.asm.jmpLabel(doneLbl);

        // ---- failure paths: close what was opened, return empty string ----
        this.asm.bindLabel(failSend);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hreOff);
        this.addImportPatch("wininet.dll", "InternetCloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.bindLabel(failReq);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hcoOff);
        this.addImportPatch("wininet.dll", "InternetCloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.bindLabel(failConn);
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hinOff);
        this.addImportPatch("wininet.dll", "InternetCloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.bindLabel(failInet);
        this.emitLlmaiEmptyString();

        this.asm.bindLabel(doneLbl);
    }

    public void genWriteBytesCall(Node call) {
        // The path/data arguments sit at child(1)/child(2) for member calls
        // (file.writeString(p, d) where child(0) is the receiver) but at
        // child(0)/child(1) for the global writeString(p, d) builtin.  Using
        // the wrong slots silently skipped the write and left the file
        // uncreated (the old guard also rejected the 2-child global form).
        int pathIdx = 0;
        int dataIdx = 1;
        if (call.isMember) { pathIdx = 1; dataIdx = 2; }
        if (call.childCount() <= dataIdx) { return; }
        this.genExpr(call.child(pathIdx));
        int pathOff = this.allocLocal("__wb_path");
        this.asm.movMBaseR(5, 0, pathOff);

        this.genExpr(call.child(dataIdx));
        int dataOff = this.allocLocal("__wb_data");
        this.asm.movMBaseR(5, 0, dataOff);

        string dataType = this.inferExprType(call.child(dataIdx));
        int isString = 0;
        if (dataType == "string") { isString = 1; }

        int sizeOff = this.allocLocal("__wb_size");
        int bufOff = dataOff;
        if (isString == 1) {
            this.asm.emitCallSetup(0);
            this.asm.movRMBase(1, 5, dataOff);
            this.addImportPatch("kernel32.dll", "lstrlenA");
            this.asm.emitImm64(0, 0);
            this.asm.movRMBase(0, 0, 0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, sizeOff);
        } else {
            // int[] points at element zero; its length is stored at -8.
            // Compact the low byte of each eight-byte element in place. The
            // array allocation has enough capacity for this prefix, so this
            // avoids a second heap allocation and keeps the bootstrap ABI
            // identical across compiler generations.
            this.asm.movRMBase(10, 5, dataOff);
            this.asm.movRMBase(0, 10, -8);
            this.asm.movMBaseR(5, 0, sizeOff);

            int iOff = this.allocLocal("__wb_i");
            this.asm.movRI64(0, 0);
            this.asm.movMBaseR(5, 0, iOff);

            // Walk source elements by eight bytes and compact output bytes
            // with ordinary [base] stores. This deliberately avoids the
            // indexed-SIB encoder so stage2 and later stages use the same
            // conservative instruction subset as stage1.
            this.asm.movRMBase(10, 5, dataOff);
            this.asm.movRR64(11, 10);
            int loopLbl = this.newLabel();
            int doneLbl = this.newLabel();
            this.asm.bindLabel(loopLbl);
            this.asm.movRMBase(0, 5, iOff);
            this.asm.movRMBase(8, 5, sizeOff);
            this.asm.cmpRR64(0, 8);
            this.asm.jgeLabel(doneLbl);
            this.asm.movRMBase(8, 10, 0);
            this.asm.andRImm(8, 0xFF);
            this.asm.movMBaseByteR(11, 8, 0);
            this.asm.addRI32(10, 8);
            this.asm.addRI32(11, 1);
            this.asm.movRMBase(0, 5, iOff);
            this.asm.addRI32(0, 1);
            this.asm.movMBaseR(5, 0, iOff);
            this.asm.jmpLabel(loopLbl);
            this.asm.bindLabel(doneLbl);
        }

        // LINUX SysV backend (additive): open(path, O_WRONLY|O_CREAT|O_TRUNC)
        // + write + close via libc. The shuffled Windows CreateFileA shape
        // below reaches open with GENERIC_WRITE flags and no O_CREAT, so new
        // files fail with ENOENT and the bytes are lost silent (EBADF). The
        // WINDOWS block below is byte-identical to before.
        if (this.isLinuxTarget()) {
            this.genLinuxWriteBytesFile(pathOff, bufOff, sizeOff);
            return;
        }

        this.asm.emitCallSetup(24);
        this.asm.movRI64(0, 2);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRI64(0, 0x80);
        this.asm.movMBaseR(4, 0, 40);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(4, 0, 48);
        this.asm.movRMBase(1, 5, pathOff);
        this.asm.movRI64(2, 0x40000000);
        this.asm.xorRR64(8, 8);
        this.asm.xorRR64(9, 9);
        this.addImportPatch("kernel32.dll", "CreateFileA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int hfileOff = this.allocLocal("__wb_hfile");
        this.asm.movMBaseR(5, 0, hfileOff);
        int writtenOff = this.allocLocal("__wb_written");
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, writtenOff);

        this.asm.emitCallSetup(8);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRMBase(1, 5, hfileOff);
        this.asm.movRMBase(0, 5, bufOff);
        this.asm.movRR64(2, 0);
        this.asm.movRMBase(8, 5, sizeOff);
        this.asm.leaRBase(9, 5, writtenOff);
        this.addImportPatch("kernel32.dll", "WriteFile");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hfileOff);
        this.addImportPatch("kernel32.dll", "CloseHandle");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }

    // LINUX SysV backend (additive): open/write/close tail for writeBytes
    // (writeFile/writeString route through genWriteBytesCall too). bufOff
    // holds the compacted bytes (int[]) or the literal chars (string),
    // sizeOff their count. Mirrors silverc-rs gen_write_bytes_linux and the
    // genLinuxEprintCall write shape (SysV regs + addImportPatchDirect).
    public void genLinuxWriteBytesFile(int pathOff, int bufOff, int sizeOff) {
        this.linuxBackend.genLinuxWriteBytesFile(this, pathOff, bufOff, sizeOff);
    }
}

class PeImport {
    public prop string dll;
    public prop string name;

    construct (string dll, string name) {
        this.dll = dll;
        this.name = name;
    }
}

class PeDllGroup {
    public prop string dll;
    public prop int count;

    construct (string dll) {
        this.dll = dll;
        this.count = 0;
    }
}

#on MAC
// MAC.md Phase C -- AAPCS64 emit slots (code-only, UNVALIDATED until Mac
// hardware, s10). Share Phase-A a64Enc tables (never redesigned here); x64
// Win64/SysV paths untouched. Full per-construct body lowering (X0-X7/V0-V7,
// [SP+0] stack args, 16-byte SP always, X29/X30 chain, no red-zone, X0/X1/V0
// returns, dyld bind patching, mmap heap, exit thunks) is hardware-gated:
// v1 wires the libSystem exit bind + fixed entry stub through these helpers
// (the Mach-O emitter ignores bodies), and these helpers exist so the MAC
// build resolves the A64 sequences. Never CALLED on Win64/SysV paths.

// Frame-chain prologue: stp x29,x30,[sp,#-16]! ; add x29,sp,#0.
void macEmitFrameChain(MiniAsm asm) {
    asm.emitU32(a64EncStpPre(29, 30, 31, -16));
    asm.emitU32(a64EncAddImm(29, 31, 0, false));
}

// Exit thunk: adrp x16,got / ldr x16,[x16,#lo] / movz x0,#0 / blr x16 / ret.
// The caller binds exit (libSystem) so got/lo resolve; X0 carries status,
// X16 the dyld target (AAPCS64 indirect-call reg, objc_msgSend-shaped).
// 16-byte-SP-safe (no stack use at all).
void macEmitExitThunk(MiniAsm asm, int pageOff, int lo) {
    asm.emitU32(a64EncAdrp(16, pageOff));
    asm.emitU32(a64EncLdrImm(16, 16, lo));
    asm.emitU32(a64EncMovz(0, 0, 0));
    asm.emitU32(a64EncBlr(16));
    asm.emitU32(a64EncRet(30));
}
#off
