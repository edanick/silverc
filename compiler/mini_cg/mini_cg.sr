    // True when a bare call to `name` resolves as a granted linux export.
    // Target-gated: on WINDOWS builds linux grants never resolve, so WINDOWS
    // emission is unaffected by linux imports in the source.
    public bool linuxCallResolves(string name) {
        if (!this.isLinuxTarget()) { return false; }
        for (int i = 0; i < this.linuxLibs.length; i++) {
            if (this.linuxTableHas(this.linuxLibs[i], name)) { return true; }
        }
        for (int g = 0; g < this.linuxGrants.length; g++) {
            string grant = this.linuxGrants[g];
            if (grant.length > name.length + 1 && projectSlice(grant, grant.length - name.length, grant.length) == name && grant[grant.length - name.length - 1] == '|') { return true; }
        }
        for (int a = 0; a < this.linuxAliasLocals.length; a++) {
            if (this.linuxAliasLocals[a] == name) { return true; }
        }
        return false;
    }

    // Resolve a free-function name to its (lib, export) on the Linux target:
