mod export mini_cg_linux;

// ============================================================================
// LINUX backend - MiniCg SysV emission helpers (split from mini_cg core).
// ============================================================================
// Holds the 46 SysV-only helpers moved out of `class MiniCg`: the linux grant
// tables (linuxModuleLib / linuxExportTable / linuxTableHas / linuxAddLib /
// linuxAddGrant / linuxAddGrantAlias / linuxAddGrantNamed / linuxAllowed /
// registerLinuxImport / checkLinuxModuleGrant / linuxModuleOf /
// linuxResolveLib / linuxResolveExport / linuxResolveAliasLib /
// linuxKnownExport / linuxBareLib), DLL/name remaps (linuxImportLib /
// linuxImportName), SysV ABI addressing (sysvRegAt), ELF addressing
// (elfCodeVaddr / elfDataVaddr / computeGotAddresses), the cargs/stack layer
// (emitLinuxStackCapture / emitLinuxStackTopLoad / genLinuxCargsCall), the
// float-aware variadic tails (emitLinuxVariadicTail / emitLinuxSprintfStaged)
// and the genLinux* file/os/input/print tails plus the mmap heap redirect
// (emitLinuxHeapAllocFromR8). All bodies are SysV-only: RDI/RSI/RDX/RCX/R8/R9,
// no shadow space, libc.so.6/libX11/libXtst imports, GOT patching.
//
// The file is UNGATED (no whole-file #on): the helpers must exist on both
// targets because the core wrappers call them; they are simply never CALLED
// on Windows. There is deliberately NO duplicate `class MiniCg` here: the
// type checker overwrites same-name classes, corrupting field offsets, so the
// helpers live on `class MiniCgLinux` and take `MiniCg cg` when they touch
// core state (pure table/address helpers take no `cg`).
// ============================================================================

class MiniCgLinux {

    public int sysvRegAt(int i) {
        if (i == 0) { return 7; }
        if (i == 1) { return 6; }
        if (i == 2) { return 2; }
        if (i == 3) { return 1; }
        if (i == 4) { return 8; }
        return 9;
    }

    public string linuxImportLib(string dll) {
        if (dll == "kernel32.dll") { return "libc.so.6"; }
        if (dll == "msvcrt.dll") { return "libc.so.6"; }
        if (dll == "ucrtbase.dll") { return "libc.so.6"; }
        if (dll == "ws2_32.dll") { return "libc.so.6"; }
        return "";
    }

    public string linuxImportName(string dll, string name) {
        if (dll == "kernel32.dll") {
            if (name == "ExitProcess") { return "exit"; }
            if (name == "VirtualAlloc") { return "mmap"; }
            if (name == "CloseHandle") { return "close"; }
            if (name == "CreateFileA") { return "open"; }
            if (name == "ReadFile") { return "read"; }
            if (name == "WriteFile") { return "write"; }
            if (name == "DeleteFileA") { return "unlink"; }
            if (name == "MoveFileA") { return "rename"; }
            if (name == "RemoveDirectoryA") { return "rmdir"; }
            if (name == "GetFileAttributesA") { return "stat"; }
            if (name == "FindFirstFileA") { return "opendir"; }
            if (name == "FindNextFileA") { return "readdir"; }
            if (name == "FindClose") { return "closedir"; }
            if (name == "GetEnvironmentVariableA") { return "getenv"; }
            if (name == "SetEnvironmentVariableA") { return "setenv"; }
            if (name == "GetComputerNameA") { return "gethostname"; }
            if (name == "GetCurrentProcessId") { return "getpid"; }
            if (name == "Sleep") { return "nanosleep"; }
            if (name == "GetTickCount" || name == "GetTickCount64") { return "clock_gettime"; }
            if (name == "QueryPerformanceCounter" || name == "QueryPerformanceFrequency") { return "clock_gettime"; }
            if (name == "GetLocalTime" || name == "GetSystemTime") { return "clock_gettime"; }
            if (name == "SetFilePointer" || name == "GetFileSize") { return "lseek"; }
            if (name == "lstrlenA") { return "strlen"; }
            return "";
        }
        // msvcrt/ucrtbase overlap on the same C library: glibc carries every
        // name both DLLs export except the Windows-only underscore helpers.
        if (dll == "msvcrt.dll" || dll == "ucrtbase.dll") {
            if (name == "_atoi64") { return "atoll"; }
            return name;
        }
        if (dll == "ws2_32.dll") {
            if (name == "closesocket") { return "close"; }
            if (name == "socket" || name == "bind" || name == "listen" || name == "accept" || name == "recv" || name == "send" || name == "shutdown" || name == "connect" || name == "setsockopt" || name == "getaddrinfo" || name == "freeaddrinfo") { return name; }
            return "";
        }
        return "";
    }

    public string linuxModuleLib(string module) {
        if (module == "libc") { return "libc.so.6"; }
        if (module == "x11") { return "libX11.so.6"; }
        if (module == "xtst") { return "libXtst.so.6"; }
        return "";
    }

    public string linuxExportTable(string lib) {
        if (lib == "libc.so.6") { return "exit mmap munmap malloc free read write open close lseek stat unlink rename mkdir rmdir opendir readdir closedir getenv setenv clock_gettime nanosleep localtime_r gmtime_r fork execve waitpid kill pipe dup2 _exit execvpe getpid pthread_create pthread_join sysconf uname gethostname getlogin_r statvfs getrandom rand srand getuid printf strlen strcmp strcpy memcpy memset socket connect bind listen accept send recv setsockopt getaddrinfo freeaddrinfo"; }
        if (lib == "libX11.so.6") { return "XOpenDisplay XCloseDisplay XQueryPointer XWarpPointer XFlush XCreateSimpleWindow XMapWindow XUnmapWindow XDestroyWindow XStoreName XDefaultRootWindow XScreenCount XDisplayWidth XDisplayHeight XStringToKeysym XKeysymToKeycode XQueryKeymap"; }
        if (lib == "libXtst.so.6") { return "XTestFakeButtonEvent XTestFakeKeyEvent XTestFakeMotionEvent XTestQueryExtension"; }
        return "";
    }

    public bool linuxTableHas(string lib, string fn) {
        string table = this.linuxExportTable(lib);
        int i = 0;
        while (i < table.length) {
            while (i < table.length && table[i] == ' ') { i++; }
            int start = i;
            while (i < table.length && table[i] != ' ') { i++; }
            if (i > start && fn == projectSlice(table, start, i)) { return true; }
        }
        return false;
    }

    public void linuxAddLib(MiniCg cg, string lib) {
        if (lib.length == 0) { return; }
        for (int i = 0; i < cg.linuxLibs.length; i++) {
            if (cg.linuxLibs[i] == lib) { return; }
        }
        cg.linuxLibs.add(lib);
    }

    public void linuxAddGrant(MiniCg cg, string lib, string fn) {
        if (lib.length == 0 || fn.length == 0) { return; }
        string grant = lib + "|" + fn;
        for (int i = 0; i < cg.linuxGrants.length; i++) {
            if (cg.linuxGrants[i] == grant) { return; }
        }
        cg.linuxGrants.add(grant);
    }

    public void linuxAddGrantAlias(MiniCg cg, string lib, string exportName, string localName) {
        if (lib.length == 0 || exportName.length == 0 || localName.length == 0) { return; }
        if (exportName == localName) { this.linuxAddGrant(cg, lib, exportName); return; }
        for (int i = 0; i < cg.linuxAliasLocals.length; i++) {
            if (cg.linuxAliasLocals[i] == localName && cg.linuxAliasExports[i] == exportName && cg.linuxAliasLibs[i] == lib) { return; }
        }
        cg.linuxAliasLocals.add(localName);
        cg.linuxAliasExports.add(exportName);
        cg.linuxAliasLibs.add(lib);
    }

    public void linuxAddGrantNamed(MiniCg cg, string lib, Node nameNode) {
        if (nameNode.isAlias && nameNode.strVal.length > 0) {
            this.linuxAddGrantAlias(cg, lib, nameNode.name, nameNode.strVal);
            return;
        }
        this.linuxAddGrant(cg, lib, nameNode.name);
    }

    public bool linuxAllowed(MiniCg cg, string lib, string fn) {
        for (int i = 0; i < cg.linuxLibs.length; i++) {
            if (cg.linuxLibs[i] == lib) {
                if (this.linuxTableHas(lib, fn)) { return true; }
            }
        }
        string grant = lib + "|" + fn;
        for (int i = 0; i < cg.linuxGrants.length; i++) {
            if (cg.linuxGrants[i] == grant) { return true; }
        }
        return false;
    }

    public void registerLinuxImport(MiniCg cg, Node node) {
        string source = node.typeHint;
        bool all = node.isStatic;
        if (source != "linux" && source.length > 6) {
            string prefix = projectSlice(source, 0, 6);
            if (prefix != "linux.") { return; }
        } else if (source != "linux") {
            return;
        }
        if (source == "linux") {
            if (all) {
                this.linuxAddLib(cg, this.linuxModuleLib("libc"));
                this.linuxAddLib(cg, this.linuxModuleLib("x11"));
                this.linuxAddLib(cg, this.linuxModuleLib("xtst"));
                return;
            }
            this.checkLinuxModuleGrant(cg, node.name, node);
            for (int j = 0; j < node.childCount(); j++) {
                this.checkLinuxModuleGrant(cg, node.child(j).name, node);
            }
            return;
        }
        string module = projectSlice(source, 6, source.length);
        string lib = this.linuxModuleLib(module);
        if (lib.length > 0) {
            if (all) {
                this.linuxAddLib(cg, lib);
                return;
            }
            this.linuxAddGrantNamed(cg, lib, node);
            for (int j = 0; j < node.childCount(); j++) {
                this.linuxAddGrantNamed(cg, lib, node.child(j));
            }
            return;
        }
        if (cg.customNative.declared(module)) {
            string lin = cg.customNative.linFile(module);
            if (lin.length == 0) {
                printline("Error: " + nativeUndeclaredMsg(source));
                exit(1);
                return;
            }
            if (all) {
                printline("Error: " + nativeStarMsg(source));
                exit(1);
                return;
            }
            this.linuxAddGrantNamed(cg, lin, node);
            for (int j2 = 0; j2 < node.childCount(); j2++) {
                this.linuxAddGrantNamed(cg, lin, node.child(j2));
            }
            return;
        }
        printline("Error: " + nativeUndeclaredMsg(source));
        exit(1);
    }

    public void checkLinuxModuleGrant(MiniCg cg, string modName, Node node) {
        if (modName.length == 0) { return; }
        string lib = this.linuxModuleLib(modName);
        if (lib.length > 0) {
            this.linuxAddLib(cg, lib);
            return;
        }
        if (cg.customNative.declared(modName)) {
            printline("Error: " + nativeStarMsg("linux." + modName));
            exit(1);
            return;
        }
        printline("Error: " + nativeUndeclaredMsg("linux." + modName));
        exit(1);
    }

    public string linuxModuleOf(string lib) {
        if (lib == "libc.so.6") { return "libc"; }
        if (lib == "libX11.so.6") { return "x11"; }
        if (lib == "libXtst.so.6") { return "xtst"; }
        return lib;
    }

    public string linuxResolveLib(MiniCg cg, string name) {
        for (int i = 0; i < cg.linuxLibs.length; i++) {
            if (this.linuxTableHas(cg.linuxLibs[i], name)) { return cg.linuxLibs[i]; }
        }
        for (int g = 0; g < cg.linuxGrants.length; g++) {
            string grant = cg.linuxGrants[g];
            if (grant.length > name.length + 1 && projectSlice(grant, grant.length - name.length, grant.length) == name && grant[grant.length - name.length - 1] == '|') {
                return projectSlice(grant, 0, grant.length - name.length - 1);
            }
        }
        return "";
    }

    public string linuxResolveExport(MiniCg cg, string name) {
        for (int a = 0; a < cg.linuxAliasLocals.length; a++) {
            if (cg.linuxAliasLocals[a] == name) { return cg.linuxAliasExports[a]; }
        }
        return name;
    }

    public string linuxResolveAliasLib(MiniCg cg, string name) {
        for (int a = 0; a < cg.linuxAliasLocals.length; a++) {
            if (cg.linuxAliasLocals[a] == name) { return cg.linuxAliasLibs[a]; }
        }
        return "";
    }

    public bool linuxKnownExport(string name) {
        if (this.linuxTableHas("libc.so.6", name)) { return true; }
        if (this.linuxTableHas("libX11.so.6", name)) { return true; }
        if (this.linuxTableHas("libXtst.so.6", name)) { return true; }
        return false;
    }

    public string linuxBareLib(string name) {
        if (this.linuxTableHas("libc.so.6", name)) { return "libc.so.6"; }
        if (this.linuxTableHas("libX11.so.6", name)) { return "libX11.so.6"; }
        if (this.linuxTableHas("libXtst.so.6", name)) { return "libXtst.so.6"; }
        return "";
    }

    public int elfCodeVaddr() {
        return 0x400000 + 0x1000;
    }

    public int elfDataVaddr(MiniCg cg) {
        int codeLen = cg.asm.buf.length;
        int PAGE = 0x1000;
        int rxFilesz = codeLen;
        int m = rxFilesz % PAGE;
        if (m != 0) { rxFilesz = rxFilesz + (PAGE - m); }
        return 0x400000 + 0x1000 + rxFilesz;
    }

    public int[] computeGotAddresses(MiniCg cg) {
        int[] gotAddrs = [];
        int dataLen = cg.stringData.length + cg.globalAreaSize;
        int PAGE = 0x1000;
        int dataFilesz = dataLen;
        int m = dataFilesz % PAGE;
        if (m != 0) { dataFilesz = dataFilesz + (PAGE - m); }
        int rwVaddr = this.elfDataVaddr(cg) + dataFilesz;
        for (int i = 0; i < cg.importDlls.length; i++) {
            gotAddrs.add(rwVaddr + 24 + i * 8);
        }
        return gotAddrs;
    }

    public void emitLinuxStackCapture(MiniCg cg) {
        int stIdx = cg.findGlobal("__linux_stack_top");
        cg.asm.movRR64(0, 4);
        int sp = cg.asm.buf.length;
        cg.asm.emitImm64(1, 0);
        cg.globalPatchOffsets.add(sp + 2);
        cg.globalPatchIndices.add(stIdx);
        cg.asm.movMBaseR(1, 0, 0);
    }

    public void emitLinuxStackTopLoad(MiniCg cg) {
        int stIdx = cg.findGlobal("__linux_stack_top");
        int sp = cg.asm.buf.length;
        cg.asm.emitImm64(0, 0);
        cg.globalPatchOffsets.add(sp + 2);
        cg.globalPatchIndices.add(stIdx);
        cg.asm.movRMBase(0, 0, 0);
    }

    public void genLinuxCargsCall(MiniCg cg) {
        this.emitLinuxStackTopLoad(cg);
        int rspOff = cg.allocLocal("__cargs_rsp");
        cg.asm.movMBaseR(5, 0, rspOff);
        int argcOff = cg.allocLocal("__cargs_argc");
        int arrOff = cg.allocLocal("__cargs_arr");
        int iOff = cg.allocLocal("__cargs_i");
        // argc = [RSP0]
        cg.asm.movRMBase(0, 5, rspOff);
        cg.asm.movRMBase(0, 0, 0);
        cg.asm.movMBaseR(5, 0, argcOff);
        // size = (argc+1)*8 into R8; malloc + zero via the heap helper.
        cg.asm.movRMBase(0, 5, argcOff);
        cg.asm.addRI32(0, 1);
        cg.asm.shlR64Imm(0, 3);
        cg.asm.movRR64(8, 0);
        this.emitLinuxHeapAllocFromR8(cg);
        cg.asm.movMBaseR(5, 0, arrOff);
        // [arr] = argc
        cg.asm.movRMBase(1, 5, argcOff);
        cg.asm.movRMBase(0, 5, arrOff);
        cg.asm.movMBaseR(0, 1, 0);
        // i = 0; while i < argc: arr[8+i*8] = argv[i]
        cg.asm.xorRR64(0, 0);
        cg.asm.movMBaseR(5, 0, iOff);
        int loopL = cg.newLabel();
        int doneL = cg.newLabel();
        cg.asm.bindLabel(loopL);
        cg.asm.movRMBase(0, 5, iOff);
        cg.asm.movRMBase(1, 5, argcOff);
        cg.asm.cmpRR64(0, 1);
        cg.asm.jgeLabel(doneL);
        // argv[i]: R10 = RSP0 + 8 + i*8; R10 = [R10]
        cg.asm.movRMBase(10, 5, rspOff);
        cg.asm.addRI32(10, 8);
        cg.asm.movRMBase(11, 5, iOff);
        cg.asm.shlR64Imm(11, 3);
        cg.asm.addRR64(10, 11);
        cg.asm.movRMBase(10, 10, 0);
        // arr[8+i*8] = argv[i]
        cg.asm.movRMBase(11, 5, arrOff);
        cg.asm.addRI32(11, 8);
        cg.asm.movRMBase(1, 5, iOff);
        cg.asm.shlR64Imm(1, 3);
        cg.asm.addRR64(11, 1);
        cg.asm.movMBaseR(11, 10, 0);
        // i++
        cg.asm.movRMBase(0, 5, iOff);
        cg.asm.addRI32(0, 1);
        cg.asm.movMBaseR(5, 0, iOff);
        cg.asm.jmpLabel(loopL);
        cg.asm.bindLabel(doneL);
        // Arrays point at their first element: skip the length word.
        cg.asm.movRMBase(0, 5, arrOff);
        cg.asm.addRI32(0, 8);
    }

    public void emitLinuxVariadicTail(MiniCg cg, string lib, string fn, int[] fixedOffs, int[] valOffs, Node[] vals) {
        int firstFixed = fixedOffs.length;
        int gpNeed = 0;
        int xmNeed = 0;
        for (int i = 0; i < vals.length; i++) {
            if (cg.isFloatLike(vals[i])) { xmNeed++; } else { gpNeed++; }
        }
        int gpMax = 6 - firstFixed;
        int gpOver = gpNeed - gpMax;
        if (gpOver < 0) { gpOver = 0; }
        int xmOver = xmNeed - 8;
        if (xmOver < 0) { xmOver = 0; }
        cg.emitAbiCallSetup((gpOver + xmOver) * 8);
        for (int f = 0; f < firstFixed; f++) {
            cg.asm.movRMBase(this.sysvRegAt(f), 5, fixedOffs[f]);
        }
        int gp = 0;
        int xm = 0;
        int st = 0;
        int al = 0;
        for (int i = 0; i < vals.length; i++) {
            if (cg.isFloatLike(vals[i])) {
                if (xm < 8) {
                    cg.asm.movRMBase(0, 5, valOffs[i]);
                    cg.emitMovqXmmGpr(xm, 0);
                    xm++;
                    al++;
                } else {
                    cg.asm.movRMBase(0, 5, valOffs[i]);
                    cg.asm.movMBaseR(4, 0, st * 8);
                    st++;
                }
            } else {
                if (gp < gpMax) {
                    cg.asm.movRMBase(this.sysvRegAt(firstFixed + gp), 5, valOffs[i]);
                    gp++;
                } else {
                    cg.asm.movRMBase(0, 5, valOffs[i]);
                    cg.asm.movMBaseR(4, 0, st * 8);
                    st++;
                }
            }
        }
        cg.addImportPatchDirect(lib, fn);
        cg.asm.emitImm64(0, 0);
        cg.asm.movRMBase(10, 0, 0);
        cg.asm.movRI64(0, al);
        cg.asm.callR64(10);
        cg.emitAbiCallTeardown();
    }

    public void emitLinuxSprintfStaged(MiniCg cg, bool isFloat) {
        cg.asm.movRR64(7, 1);
        cg.asm.movRR64(6, 2);
        cg.asm.movRR64(2, 8);
        if (isFloat) {
            cg.emitMovqXmmGpr(0, 2);
        }
        cg.emitAbiCallSetup(0);
        cg.addImportPatchDirect("libc.so.6", "sprintf");
        cg.asm.emitImm64(0, 0);
        cg.asm.movRMBase(10, 0, 0);
        cg.asm.xorRR64(0, 0);
        if (isFloat) {
            cg.asm.incR64(0);
        }
        cg.asm.callR64(10);
        cg.emitAbiCallTeardown();
    }

    public void genLinuxEprintCall(MiniCg cg, Node call, bool newline) {
        if (call.childCount() < 1) { return; }
        Node arg = call.child(0);
        cg.genExpr(arg);
        int msgOff = cg.allocLocal("__emsg");
        cg.asm.movMBaseR(5, 0, msgOff);
        int lenOff = cg.allocLocal("__elen");
        cg.asm.movRMBase(7, 5, msgOff);
        cg.addImportPatchDirect("libc.so.6", "strlen");
        cg.asm.emitImm64(0, 0);
        cg.asm.movRMBase(0, 0, 0);
        cg.emitAbiCallSetup(0);
        cg.asm.callR64(0);
        cg.emitAbiCallTeardown();
        cg.asm.movMBaseR(5, 0, lenOff);
        cg.asm.movRI64(7, 2);
        cg.asm.movRMBase(6, 5, msgOff);
        cg.asm.movRMBase(2, 5, lenOff);
        cg.emitAbiCallSetup(0);
        cg.addImportPatchDirect("libc.so.6", "write");
        cg.asm.emitImm64(0, 0);
        cg.asm.movRMBase(0, 0, 0);
        cg.asm.callR64(0);
        cg.emitAbiCallTeardown();
        if (newline) {
            int nlIdx = cg.addString("\n");
            int sp = cg.asm.buf.length;
            cg.asm.emitImm64(0, 0);
            cg.stringPatchOffsets.add(sp + 2);
            cg.stringPatchIndices.add(nlIdx);
            cg.asm.movRR64(6, 0);
            cg.asm.movRI64(7, 2);
            cg.asm.movRI64(2, 1);
            cg.emitAbiCallSetup(0);
            cg.addImportPatchDirect("libc.so.6", "write");
            cg.asm.emitImm64(0, 0);
            cg.asm.movRMBase(0, 0, 0);
            cg.asm.callR64(0);
            cg.emitAbiCallTeardown();
        }
    }

    public void genLinuxGetEnvCall(MiniCg cg, Node call) {
        int keyIdx = 0;
        if (call.isMember) { keyIdx = 1; }
        if (call.childCount() <= keyIdx) { cg.emitLlmaiStringLiteral(""); return; }
        cg.genExpr(call.child(keyIdx));
        int keyOff = cg.allocLocal("__env_linux_key");
        cg.asm.movMBaseR(5, 0, keyOff);
        cg.asm.movRMBase(7, 5, keyOff);
        cg.emitAbiCallSetup(0);
        cg.addImportPatchDirect("libc.so.6", "getenv");
        cg.asm.emitImm64(0, 0);
        cg.asm.movRMBase(0, 0, 0);
        cg.asm.callR64(0);
        cg.emitAbiCallTeardown();
        int notFound = cg.newLabel();
        int done = cg.newLabel();
        cg.asm.cmpRI32(0, 0);
        cg.asm.jeLabel(notFound);
        cg.asm.jmpLabel(done);
        cg.asm.bindLabel(notFound);
        cg.emitLlmaiStringLiteral("");
        cg.asm.bindLabel(done);
    }

    public void genLinuxFileExists(MiniCg cg, int pathOff) {
        cg.asm.movRMBase(7, 5, pathOff);
        cg.asm.xorRR64(6, 6);
        cg.asm.xorRR64(2, 2);
        cg.emitAbiCallSetup(0);
        cg.addImportPatchDirect("libc.so.6", "open");
        cg.asm.emitImm64(0, 0);
        cg.asm.movRMBase(0, 0, 0);
        cg.asm.callR64(0);
        cg.emitAbiCallTeardown();
        int feNo = cg.newLabel();
        int feDone = cg.newLabel();
        cg.asm.cmpRI32(0, 0);
        cg.asm.jlLabel(feNo);
        cg.asm.movRR64(7, 0);
        cg.emitAbiCallSetup(0);
        cg.addImportPatchDirect("libc.so.6", "close");
        cg.asm.emitImm64(0, 0);
        cg.asm.movRMBase(0, 0, 0);
        cg.asm.callR64(0);
        cg.emitAbiCallTeardown();
        cg.asm.movRI64(0, 1);
        cg.asm.jmpLabel(feDone);
        cg.asm.bindLabel(feNo);
        cg.asm.xorRR64(0, 0);
        cg.asm.bindLabel(feDone);
    }

    public void genLinuxFileDeleteCall(MiniCg cg, Node call) {
        int pathIdx = 1;
        if (call.childCount() <= pathIdx) { cg.asm.xorRR64(0, 0); return; }
        cg.genExpr(call.child(pathIdx));
        int pathOff = cg.allocLocal("__fldel_path");
        cg.asm.movMBaseR(5, 0, pathOff);
        cg.asm.movRMBase(7, 5, pathOff);
        cg.emitAbiCallSetup(0);
        cg.addImportPatchDirect("libc.so.6", "unlink");
        cg.asm.emitImm64(0, 0);
        cg.asm.movRMBase(0, 0, 0);
        cg.asm.callR64(0);
        cg.emitAbiCallTeardown();
    }

