    public void genLinuxReadStringFile(MiniCg cg, int pathOff) {
        cg.asm.movRI64(8, 144);
        this.emitLinuxHeapAllocFromR8(cg);
        int stOff = cg.allocLocal("__rs_linux_st");
        cg.asm.movMBaseR(5, 0, stOff);
        cg.asm.movRMBase(7, 5, pathOff);
        cg.asm.movRMBase(6, 5, stOff);
        cg.emitAbiCallSetup(0);
        cg.addImportPatchDirect("libc.so.6", "stat");
        cg.asm.emitImm64(0, 0);
        cg.asm.movRMBase(0, 0, 0);
        cg.asm.callR64(0);
        cg.emitAbiCallTeardown();
        int rsErr = cg.newLabel();
        int rsDone = cg.newLabel();
        cg.asm.cmpRI32(0, 0);
        cg.asm.jneLabel(rsErr);
        cg.asm.movRMBase(0, 5, stOff);
        cg.asm.movRMBase(0, 0, 48);
        int sizeOff = cg.allocLocal("__rs_linux_size");
        cg.asm.movMBaseR(5, 0, sizeOff);
        cg.asm.movRMBase(8, 5, sizeOff);
        cg.asm.addRI32(8, 1);
        this.emitLinuxHeapAllocFromR8(cg);
        int bufOff = cg.allocLocal("__rs_linux_buf");
        cg.asm.movMBaseR(5, 0, bufOff);
        cg.asm.movRMBase(7, 5, pathOff);
        cg.asm.xorRR64(6, 6);
        cg.asm.xorRR64(2, 2);
        cg.emitAbiCallSetup(0);
        cg.addImportPatchDirect("libc.so.6", "open");
        cg.asm.emitImm64(0, 0);
        cg.asm.movRMBase(0, 0, 0);
        cg.asm.callR64(0);
        cg.emitAbiCallTeardown();
        int hfileOff = cg.allocLocal("__rs_linux_hfile");
        cg.asm.movMBaseR(5, 0, hfileOff);
        cg.asm.cmpRI32(0, 0);
        cg.asm.jlLabel(rsErr);
        cg.asm.movRMBase(7, 5, hfileOff);
        cg.asm.movRMBase(6, 5, bufOff);
        cg.asm.movRMBase(2, 5, sizeOff);
        cg.emitAbiCallSetup(0);
        cg.addImportPatchDirect("libc.so.6", "read");
        cg.asm.emitImm64(0, 0);
        cg.asm.movRMBase(0, 0, 0);
        cg.asm.callR64(0);
        cg.emitAbiCallTeardown();
        cg.asm.cmpRI32(0, 0);
        cg.asm.jlLabel(rsErr);
        int breadOff = cg.allocLocal("__rs_linux_bread");
        cg.asm.movMBaseR(5, 0, breadOff);
        cg.asm.movRMBase(0, 5, bufOff);
        cg.asm.movRMBase(1, 5, breadOff);
        cg.asm.addRR64(0, 1);
        cg.asm.movRI64(1, 0);
        cg.asm.movMBaseByteR(0, 1, 0);
        cg.asm.movRMBase(7, 5, hfileOff);
        cg.emitAbiCallSetup(0);
        cg.addImportPatchDirect("libc.so.6", "close");
        cg.asm.emitImm64(0, 0);
        cg.asm.movRMBase(0, 0, 0);
        cg.asm.callR64(0);
        cg.emitAbiCallTeardown();
        cg.asm.movRMBase(0, 5, bufOff);
        cg.asm.jmpLabel(rsDone);
        cg.asm.bindLabel(rsErr);
        cg.emitThrowException("file not found");
        cg.asm.bindLabel(rsDone);
    }

    public void genLinuxInputCall(MiniCg cg) {
        int bufSize = 4096;
        int sizeOff = cg.allocLocal("__in_size");
        cg.asm.movRI64(0, bufSize);
        cg.asm.movMBaseR(5, 0, sizeOff);
        cg.asm.movRMBase(8, 5, sizeOff);
        this.emitLinuxHeapAllocFromR8(cg);
        int bufOff = cg.allocLocal("__in_buf");
        cg.asm.movMBaseR(5, 0, bufOff);
        int breadOff = cg.allocLocal("__in_bread");
        cg.asm.movRI64(0, 0);
        cg.asm.movMBaseR(5, 0, breadOff);
        // read(0, buf, 4096)
        cg.asm.xorRR64(7, 7);
        cg.asm.movRMBase(6, 5, bufOff);
        cg.asm.movRMBase(2, 5, sizeOff);
        cg.emitAbiCallSetup(0);
        cg.addImportPatchDirect("libc.so.6", "read");
        cg.asm.emitImm64(0, 0);
        cg.asm.movRMBase(0, 0, 0);
        cg.asm.callR64(0);
        cg.emitAbiCallTeardown();
        int readOk = cg.newLabel();
        cg.asm.cmpRI32(0, 0);
        cg.asm.jgeLabel(readOk);
        cg.asm.xorRR64(0, 0);
        cg.asm.bindLabel(readOk);
        cg.asm.movMBaseR(5, 0, breadOff);
        // Null-terminate the buffer at the bytes-read position
        cg.asm.movRMBase(0, 5, bufOff);
        cg.asm.movRMBase(1, 5, breadOff);
        cg.asm.addRR64(0, 1);
        cg.asm.movRI64(1, 0);
        cg.asm.movMBaseByteR(0, 1, 0);
        // Return buffer pointer in RAX
        cg.asm.movRMBase(0, 5, bufOff);
    }

    public void emitLinuxHeapAllocFromR8(MiniCg cg) {
        cg.asm.pushR64(8);
        cg.asm.movRR64(7, 8);
        cg.emitAbiCallSetup(0);
        cg.addImportPatchDirect("libc.so.6", "malloc");
        if (cg.runtimeMode) {
            cg.heapAllocPatchPos.add(cg.asm.buf.length + 2);
        }
        cg.asm.emitImm64(0, 0);
        cg.asm.movRMBase(0, 0, 0);
        cg.asm.callR64(0);
        cg.emitAbiCallTeardown();
        int okLbl = cg.newLabel();
        int doneLbl = cg.newLabel();
        cg.asm.orRR64(0, 0);
        cg.asm.jneLabel(okLbl);
        cg.asm.popR64(1);
        cg.asm.jmpLabel(doneLbl);
        cg.asm.bindLabel(okLbl);
        cg.asm.movRR64(7, 0);
        cg.asm.xorRR64(6, 6);
        cg.asm.popR64(2);
        cg.asm.pushR64(7);
        cg.emitAbiCallSetup(0);
        cg.addImportPatchDirect("libc.so.6", "memset");
        cg.asm.emitImm64(0, 0);
        cg.asm.movRMBase(0, 0, 0);
        cg.asm.callR64(0);
        cg.emitAbiCallTeardown();
        cg.asm.popR64(0);
        cg.asm.bindLabel(doneLbl);
    }

    public void genLinuxWriteBytesFile(MiniCg cg, int pathOff, int bufOff, int sizeOff) {
        int hfileOff = cg.allocLocal("__wb_hfile");
        int writtenOff = cg.allocLocal("__wb_written");
        cg.asm.movRI64(0, 0);
        cg.asm.movMBaseR(5, 0, writtenOff);
        cg.asm.movRMBase(7, 5, pathOff);
        cg.asm.movRI64(6, 0x241);
        cg.asm.movRI64(2, 0x1A4);
        cg.emitAbiCallSetup(0);
        cg.addImportPatchDirect("libc.so.6", "open");
        cg.asm.emitImm64(0, 0);
        cg.asm.movRMBase(0, 0, 0);
        cg.asm.callR64(0);
        cg.emitAbiCallTeardown();
        cg.asm.movMBaseR(5, 0, hfileOff);
        cg.asm.movRMBase(7, 5, hfileOff);
        cg.asm.movRMBase(6, 5, bufOff);
        cg.asm.movRMBase(2, 5, sizeOff);
        cg.emitAbiCallSetup(0);
        cg.addImportPatchDirect("libc.so.6", "write");
        cg.asm.emitImm64(0, 0);
        cg.asm.movRMBase(0, 0, 0);
        cg.asm.callR64(0);
        cg.emitAbiCallTeardown();
        cg.asm.movMBaseR(5, 0, writtenOff);
        cg.asm.movRMBase(7, 5, hfileOff);
        cg.emitAbiCallSetup(0);
        cg.addImportPatchDirect("libc.so.6", "close");
        cg.asm.emitImm64(0, 0);
        cg.asm.movRMBase(0, 0, 0);
        cg.asm.callR64(0);
        cg.emitAbiCallTeardown();
    }
