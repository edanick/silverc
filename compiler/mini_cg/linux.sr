        cg.emitAbiCallTeardown();
        cg.asm.movMBaseR(5, 0, hOff);
        cg.asm.cmpRI32(0, 0);
        cg.asm.jeLabel(noFiles);
        int widxOff = cg.allocLocal("__fde_widx");
        cg.asm.xorRR64(0, 0);
        cg.asm.movMBaseR(5, 0, widxOff);
        int p2Loop = cg.newLabel();
