        cg.asm.jeLabel(skip);
        cg.asm.cmpRI32(1, 46);
        cg.asm.jneLabel(checkFilter);
        cg.asm.movzxByteMBase(1, 0, 21);
        cg.asm.cmpRI32(1, 0);
        cg.asm.jeLabel(skip);
        cg.asm.bindLabel(checkFilter);
        if (filter == 1) {
            cg.asm.movRMBase(0, 5, nodeOff);
            cg.asm.movzxByteMBase(1, 0, 18);
            cg.asm.cmpRI32(1, 4);
            cg.asm.jeLabel(skip);
        } else if (filter == 2) {
            cg.asm.movRMBase(0, 5, nodeOff);
            cg.asm.movzxByteMBase(1, 0, 18);
            cg.asm.cmpRI32(1, 4);
            cg.asm.jneLabel(skip);
        }
    }

