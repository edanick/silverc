    public void emitLinuxDirentTest(MiniCg cg, int nodeOff, int filter, int skip) {
        cg.asm.movRMBase(0, 5, nodeOff);
        int checkFilter = cg.newLabel();
        cg.asm.movzxByteMBase(1, 0, 19);
        cg.asm.cmpRI32(1, 46);
