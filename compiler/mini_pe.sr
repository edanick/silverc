        int dynPos = offDynamic;
        this.writeLe64(out, dynPos, 1);
        this.writeLe64(out, dynPos + 8, libcOff);
        dynPos += 16;
        for (int li = 0; li < neededLibs.length; li++) {
            if (neededLibs[li] != libcName) {
                this.writeLe64(out, dynPos, 1);
                this.writeLe64(out, dynPos + 8, libOffs[li]);
                dynPos += 16;
            }
        }
        this.writeLe64(out, dynPos, 4);
        this.writeLe64(out, dynPos + 8, BASE + offHash);
        dynPos += 16;
        this.writeLe64(out, dynPos, 3);
        this.writeLe64(out, dynPos + 8, rwVaddr);
        dynPos += 16;
        this.writeLe64(out, dynPos, 30);
        this.writeLe64(out, dynPos + 8, 8);
        dynPos += 16;
        this.writeLe64(out, dynPos, 5);
        this.writeLe64(out, dynPos + 8, BASE + offDynstr);
        dynPos += 16;
        this.writeLe64(out, dynPos, 10);
        this.writeLe64(out, dynPos + 8, dynstrLen);
        dynPos += 16;
        this.writeLe64(out, dynPos, 6);
        this.writeLe64(out, dynPos + 8, BASE + offDynsym);
        dynPos += 16;
        this.writeLe64(out, dynPos, 11);
        this.writeLe64(out, dynPos + 8, 24);
        dynPos += 16;
        this.writeLe64(out, dynPos, 7);
        this.writeLe64(out, dynPos + 8, BASE + offRela);
        dynPos += 16;
        this.writeLe64(out, dynPos, 8);
        this.writeLe64(out, dynPos + 8, relaLen);
        dynPos += 16;
        this.writeLe64(out, dynPos, 9);
        this.writeLe64(out, dynPos + 8, 24);
        dynPos += 16;
        this.writeLe64(out, dynPos, 23);
        this.writeLe64(out, dynPos + 8, BASE + offRela);
        dynPos += 16;
        this.writeLe64(out, dynPos, 2);
        this.writeLe64(out, dynPos + 8, relaLen);
        dynPos += 16;
        this.writeLe64(out, dynPos, 20);
        this.writeLe64(out, dynPos + 8, 7);
        dynPos += 16;
        this.writeLe64(out, dynPos, 0);
        this.writeLe64(out, dynPos + 8, 0);
        for (int ci = 0; ci < codeIn.length; ci++) { out[rxOff + ci] = codeIn[ci]; }
        for (int di = 0; di < stringData.length; di++) { out[dataOff + di] = stringData[di]; }
        return out;
    }
}
#on MAC
// MAC Mach-O MH_EXECUTE ARM64 emitter -- mirrors silverc-rs src/macho.rs
// plan()/emit() layout decisions (code-only, UNVALIDATED until Mac hardware,
// MAC.md section 10): __TEXT (RX code + __stubs) / __DATA (writable __got +
// data) / __LINKEDIT (bind + symtab + ad-hoc signature) at 16KB pages,
// LC_SEGMENT_64 x3, LC_LOAD_DYLINKER (/usr/lib/dyld), LC_MAIN, LC_LOAD_DYLIB
// (/usr/lib/libSystem.B.dylib; Aqua extras are future work -- desktop stays
// degraded-headless like the reference), LC_BUILD_VERSION (platform MACOS,
// minos 11.0), LC_SYMTAB/LC_DYSYMTAB, LC_DYLD_INFO_ONLY bind opcodes against
// __DATA, LC_CODE_SIGNATURE ad-hoc SuperBlob+CodeDirectory (SHA-256 over
// __TEXT pages; v1 emits correct magic/length/ident with zeroed page hashes
// -- real hashing via the pure-Silver hash module is hardware-gated, and the
// kernel acceptance test is Mac-gated). CPU subtype is plain ARM64_ALL (no
// ARM64E); plain ret (no PAC/BTI). Shares Phase-A A64 decisions: dyld stubs
// and the entry stub use the a64Enc* tables from mini_asm.sr (same formulas
// the harness pins), never redesigned here. Full per-construct AAPCS64 body
// lowering is hardware-gated like the reference: v1 emits the fixed 20-byte
// exit stub (adrp x16 / ldr x16 / movz x0#0 / blr x16 / ret) and ignores
// codeIn bodies -- deterministic, structurally valid, unrun until a Mac.
class PeImport {
    public prop string dll;
    public prop string name;

    construct (string dll, string name) {
        this.dll = dll;
        this.name = name;
    }
}
class PeDllGroup {
    public prop string dll;
    public prop int count;

    construct (string dll) {
        this.dll = dll;
        this.count = 0;
    }
}
class MiniPe {
    public int[] code;
    public int entryRva;
    public int globalAreaSize;
    public PeImport[] imports;
    public int[] relocOffsets;
    public int[] extraData;
    public string[] viKeys;
    public string[] viValues;
    public int subsystem;

    construct {
        this.code = [];
        this.entryRva = 0;
        this.globalAreaSize = 0;
        this.imports = [];
        this.relocOffsets = [];
        this.extraData = [];
        this.viKeys = [];
        this.viValues = [];
        this.subsystem = 3;
    }

    public void addSectionData(int[] data) {
        this.extraData = data;
    }

    public void setVersionInfo(string[] keys, string[] values) {
        this.viKeys = keys;
        this.viValues = values;
    }

    public void writeFile(string path) {
        int[] machoBytes = this.build(this.code, this.extraData, []);
        file.writeBytes(path, machoBytes);
    }

    public void addImport(string dll, string name) {
        this.imports.add(new PeImport(dll, name));
    }

    public int computeRdataRva() {
        int SECT_ALIGN = 0x4000;
        int textRva = SECT_ALIGN;
        int textVirt = this.padToAlign(20, SECT_ALIGN);
        return textRva + textVirt;
    }

    public int[] computeLayout(int stringDataLen) {
        PeDllGroup[] groups = [];
        int[] groupMap = [];
        for (int i = 0; i < this.imports.length; i++) {
            string impDll = this.imports[i].dll;
            int gIdx = -1;
            for (int j = 0; j < groups.length; j++) {
                string gDll = groups[j].dll;
                if (gDll == impDll) {
                    gIdx = j;
                    break;
                }
            }
            if (gIdx < 0) {
                groups.add(new PeDllGroup(impDll));
                gIdx = groups.length - 1;
            }
            PeDllGroup grp = groups[gIdx];
            grp.count++;
            groupMap.add(gIdx);
        }
        int numGroups = groups.length;
        int[] layout = [];
        layout.add(0);
        layout.add(numGroups);
        layout.add(this.imports.length * 12);
        return layout;
    }

    public int padToAlign(int offset, int align) {
        int m = offset % align;
        if (m != 0) {
            return offset + (align - m);
        }
        return offset;
    }

    public void writeLe32(int[] buf, int offset, int val) {
        buf[offset] = val & 0xFF;
        buf[offset + 1] = (val >> 8) & 0xFF;
        buf[offset + 2] = (val >> 16) & 0xFF;
        buf[offset + 3] = (val >> 24) & 0xFF;
    }

    public void writeLe64(int[] buf, int offset, int64 val) {
        buf[offset] = int(val & 0xFF);
        buf[offset + 1] = int((val >> 8) & 0xFF);
        buf[offset + 2] = int((val >> 16) & 0xFF);
        buf[offset + 3] = int((val >> 24) & 0xFF);
        buf[offset + 4] = int((val >> 32) & 0xFF);
        buf[offset + 5] = int((val >> 40) & 0xFF);
        buf[offset + 6] = int((val >> 48) & 0xFF);
        buf[offset + 7] = int((val >> 56) & 0xFF);
    }

    private void lcAddU32(int[] lc, int v) {
        lc.add(v & 0xFF);
        lc.add((v >> 8) & 0xFF);
        lc.add((v >> 16) & 0xFF);
        lc.add((v >> 24) & 0xFF);
    }

    private void lcAddU64(int[] lc, int64 v) {
        lc.add(int(v & 0xFF));
        lc.add(int((v >> 8) & 0xFF));
        lc.add(int((v >> 16) & 0xFF));
        lc.add(int((v >> 24) & 0xFF));
        lc.add(int((v >> 32) & 0xFF));
        lc.add(int((v >> 40) & 0xFF));
        lc.add(int((v >> 48) & 0xFF));
        lc.add(int((v >> 56) & 0xFF));
    }

    private void lcAddName(int[] lc, string s, int total) {
        int n = s.length;
        if (n > total) { n = total; }
        for (int i = 0; i < n; i++) { lc.add(s[i]); }
        for (int j = n; j < total; j++) { lc.add(0); }
    }

    private void sigAddU32BE(int[] sig, int v) {
        sig.add((v >> 24) & 0xFF);
        sig.add((v >> 16) & 0xFF);
        sig.add((v >> 8) & 0xFF);
        sig.add(v & 0xFF);
    }

    public int[] build(int[] codeIn, int[] stringData, string[] versionData) {
        this.code = codeIn;
        int n = this.imports.length;
        int PAGE = 0x4000;
        int64 TEXT_VMADDR = 4294967296;
        int codeLen = 20;
        int dataLen = stringData.length + this.globalAreaSize;
        int stubsLen = n * 12;
        int gotLen = n * 8;
        string dyldPath = "/usr/lib/dyld";
        string libPath = "/usr/lib/libSystem.B.dylib";
        int dyldSize = this.padToAlign(12 + dyldPath.length + 1, 8);
