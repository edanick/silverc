// ============================================================================
// TARGET MODULE — emits PE/ELF/Mach-O executables for the compiler's OUTPUT.
// ============================================================================
// This region keying differs from the std modules: std's `#on WINDOWS` gates
// the HOST OS the running program talks to, while every region here gates what
// the COMPILER EMITS as its output target. One chained region holds all three
// emitters (WINDOWS PE, LINUX ELF, MAC Mach-O) closed by a single `#off` —
// same MiniPe surface (addSectionData/setVersionInfo/writeFile/build), a
// different byte-level container per branch.
//
// The WINDOWS branch is DOS header ("MZ"), PE\0\0 signature, COFF + optional
// header, section table (.text/.rdata/.rsrc), import directory + ILT/IAT,
// VERSIONINFO resource blob, subsystem field. The LINUX branch is the ELF
// ET_EXEC emitter (see its header). The MAC branch is the Mach-O MH_EXECUTE
// ARM64 emitter (16KB segments, dyld commands, ad-hoc signature — see its
// header; code-only, UNVALIDATED until Mac hardware).
// The pure byte-order helpers (writeLe32/writeLe64/padToAlign) are CPU-level
// and shared by any emitter, but they sit INSIDE each branch because each
// branch re-declares them (the type checker overwrites same-name classes,
// so each branch defines its own MiniPe).
//
// NOTE: this is COMPILER MACHINERY, not std — the std no-placeholder rule
// does not apply. Each branch is a deliberate, documented emitter.
// ============================================================================

mod export mini_pe;

#on WINDOWS

class PeImport {
    public prop string dll;
    public prop string name;

    construct (string dll, string name) {
        this.dll = dll;
        this.name = name;
    }
}
class PeDllGroup {
    public prop string dll;
    public prop int count;

    construct (string dll) {
        this.dll = dll;
        this.count = 0;
    }
}
class MiniPe {
    public int[] code;
    public int entryRva;
    public int globalAreaSize;
    public PeImport[] imports;
    public int[] relocOffsets;
    public int[] extraData;
    public string[] viKeys;
    public string[] viValues;
    // PE optional-header subsystem (DOCS/253): 3 = console (default),
    // 2 = Windows GUI (no attached console, used by `type: app` / `service`).
    public int subsystem;

    construct {
        this.code = [];
        this.entryRva = 0;
        this.globalAreaSize = 0;
        this.imports = [];
        this.relocOffsets = [];
        this.extraData = [];
        this.viKeys = [];
        this.viValues = [];
        this.subsystem = 3;
    }

    public void addSectionData(int[] data) {
        this.extraData = data;
    }

    public void setVersionInfo(string[] keys, string[] values) {
        this.viKeys = keys;
        this.viValues = values;
    }

    public void writeFile(string path) {
        int[] peBytes = this.build(this.code, this.extraData, []);
        file.writeBytes(path, peBytes);
    }

    public void addImport(string dll, string name) {
        this.imports.add(new PeImport(dll, name));
    }

    public int computeRdataRva() {
        int FILE_ALIGN = 0x200;
        int SECT_ALIGN = 0x1000;
        int textRva = SECT_ALIGN;
        int textVirt = this.padToAlign(this.code.length, SECT_ALIGN);
        return textRva + textVirt;
    }

    public int[] computeLayout(int stringDataLen) {
        PeDllGroup[] groups = [];
        int[] groupMap = [];
        for (int i = 0; i < this.imports.length; i++) {
            string impDll = this.imports[i].dll;
            int gIdx = -1;
            for (int j = 0; j < groups.length; j++) {
                string gDll = groups[j].dll;
                if (gDll == impDll) {
                    gIdx = j;
                    break;
                }
            }
            if (gIdx < 0) {
                groups.add(new PeDllGroup(impDll));
                gIdx = groups.length - 1;
            }
            PeDllGroup grp = groups[gIdx];
            grp.count++;
            groupMap.add(gIdx);
        }
        int numGroups = groups.length;
        int descBytes = (numGroups + 1) * 20;
        int iltTotal = 0;
        for (int g = 0; g < numGroups; g++) {
            int cnt = groups[g].count;
            iltTotal += (cnt + 1) * 8;
        }
        int iatTotal = iltTotal;
        int namesStart = descBytes + iltTotal + iatTotal;
        int hintNamesLen = 0;
        for (int i = 0; i < this.imports.length; i++) {
            string nm = this.imports[i].name;
            hintNamesLen += 2 + nm.length + 1;
        }
        for (int g = 0; g < numGroups; g++) {
            string gDll2 = groups[g].dll;
            hintNamesLen += gDll2.length + 1;
        }
        int stringsStart = namesStart + hintNamesLen;
        int[] layout = [];
        layout.add(stringsStart);
        layout.add(numGroups);
        layout.add(iltTotal);
        return layout;
    }

    public int padToAlign(int offset, int align) {
        int m = offset % align;
        if (m != 0) {
            return offset + (align - m);
        }
        return offset;
    }

    public void writeLe32(int[] buf, int offset, int val) {
        buf[offset] = val & 0xFF;
        buf[offset + 1] = (val >> 8) & 0xFF;
        buf[offset + 2] = (val >> 16) & 0xFF;
        buf[offset + 3] = (val >> 24) & 0xFF;
    }

    public void writeLe64(int[] buf, int offset, int64 val) {
        buf[offset] = val & 0xFF;
        buf[offset + 1] = (val >> 8) & 0xFF;
        buf[offset + 2] = (val >> 16) & 0xFF;
        buf[offset + 3] = (val >> 24) & 0xFF;
        buf[offset + 4] = (val >> 32) & 0xFF;
        buf[offset + 5] = (val >> 40) & 0xFF;
        buf[offset + 6] = (val >> 48) & 0xFF;
        buf[offset + 7] = (val >> 56) & 0xFF;
    }

    private void rsrcWriteUtf16Pad(int[] buf, string s) {
        for (int i = 0; i < s.length; i++) {
            int ch = s[i];
            buf.add(ch & 0xFF);
            buf.add((ch >> 8) & 0xFF);
        }
        buf.add(0);
        buf.add(0);
    }

    private string rsrcFixVer(string v) {
        int dots = 0;
        for (int i = 0; i < v.length; i++) {
            if (v[i] == '.') { dots++; }
        }
        for (int i = 0; dots < 3; dots++) {
            v += ".0";
        }
        return v;
    }

    private int[] buildVERSIONINFO(string[] keys, string[] values) {
        int kc = keys.length;

        int strBlockSize = 6 + 4 * kc;
        int strTableNameBytes = 18;
        int strSize = 24 + 6 + strBlockSize + strTableNameBytes;
        for (int i = 0; i < kc; i++) {
            strSize += (keys[i].length + 1) * 2;
            strSize += (values[i].length + 1) * 2;
        }
        int pad = strSize % 4;
        if (pad != 0) { strSize += (4 - pad); }

        int viLen = 52 + 6 + 6 + 52 + strSize;

        int[] s = [];
        for (int i = 0; i < viLen; i++) { s.add(0); }

        s[0] = 'V'; s[1] = 'S'; s[2] = '_'; s[3] = 'V'; s[4] = 'E'; s[5] = 'R'; s[6] = 'S'; s[7] = 'I';
        s[8] = 'O'; s[9] = 'N'; s[10] = '_'; s[11] = 'I'; s[12] = 'N'; s[13] = 'F'; s[14] = 'O';

        this.writeLe32(s, 8, 52);
        this.writeLe32(s, 12, viLen);

        this.writeLe32(s, 52, 0xFEEF04BD);
        this.writeLe32(s, 54, 34 + 6 + strSize);

        s.add('S'); s.add(0); s.add('t'); s.add(0); s.add('r'); s.add(0); s.add('i'); s.add(0);
        s.add('n'); s.add(0); s.add('g'); s.add(0); s.add('F'); s.add(0); s.add('i'); s.add(0);
        s.add('l'); s.add(0); s.add('e'); s.add(0); s.add('I'); s.add(0); s.add('n'); s.add(0);
        s.add('f'); s.add(0); s.add('o'); s.add(0); s.add(0); s.add(0);

        this.writeLe32(s, 86 + 4, 28 + strBlockSize + strTableNameBytes);

        s.add('V'); s.add(0); s.add('a'); s.add(0); s.add('r'); s.add(0);
        s.add('F'); s.add(0); s.add('i'); s.add(0); s.add('l'); s.add(0);
        s.add('e'); s.add(0); s.add('I'); s.add(0); s.add('n'); s.add(0);
        s.add('f'); s.add(0); s.add('o'); s.add(0); s.add(0); s.add(0);
        this.writeLe32(s, 120, 4);

        s.add(0x09); s.add(0x04); s.add(0xB0); s.add(0x04);

        int strBlockOff = s.length;
        s.add(0); s.add(0); s.add(0); s.add(0); s.add(0); s.add(0);
        this.writeLe32(s, strBlockOff, strBlockSize + strTableNameBytes);

        for (int i = 0; i < kc; i++) {
            int keyLen = (keys[i].length + 1) * 2;
            int valLen = (values[i].length + 1) * 2;
            // Reserve the two DWORD fields before writing them. Writing at
            // s.length without extending the array corrupts the self-hosted
            // native compiler when project version metadata is enabled.
            int pos = s.length;
            s.add(0); s.add(0); s.add(0); s.add(0);
            this.writeLe32(s, pos, keyLen);
            this.writeLe32(s, pos + 2, strBlockSize + strTableNameBytes + pos - strBlockOff);
        }
        for (int i = 0; i < kc; i++) {
            int valLen = (values[i].length + 1) * 2;
            int pos = s.length;
            s.add(0); s.add(0); s.add(0); s.add(0);
            this.writeLe32(s, pos, valLen);
            this.writeLe32(s, pos + 2, strBlockSize + strTableNameBytes + pos - strBlockOff);
        }

        s.add('0'); s.add(0); s.add('4'); s.add(0); s.add('0'); s.add(0); s.add('9'); s.add(0);
        s.add('0'); s.add(0); s.add('4'); s.add(0); s.add('B'); s.add(0); s.add('0'); s.add(0);
        s.add(0); s.add(0);

        for (int i = 0; i < kc; i++) {
            this.rsrcWriteUtf16Pad(s, keys[i]);
        }
        for (int i = 0; i < kc; i++) {
            string vv = values[i];
            if (keys[i] == "FileVersion" || keys[i] == "ProductVersion") {
                vv = this.rsrcFixVer(vv);
            }
            this.rsrcWriteUtf16Pad(s, vv);
        }

        int tailPad = s.length % 4;
        if (tailPad != 0) {
            for (int i = 0; i < 4 - tailPad; i++) { s.add(0); }
        }

        this.writeLe32(s, 2, s.length);

        return s;
    }

public int[] build(int[] codeIn, int[] stringData, string[] versionData) {
        this.code = codeIn;
        string[] versionKeys = [];
        string[] versionValues = [];
        for (int vi = 0; vi + 1 < versionData.length; vi += 2) {
            versionKeys.add(versionData[vi]);
            versionValues.add(versionData[vi + 1]);
        }

        int numImports = this.imports.length;
        string[] uniqueDlls = [];
        int[] groupSizes = [];
        int[] importGroupIdx = [];
        for (int i = 0; i < numImports; i++) {
            string impDll = this.imports[i].dll;
            int gIdx = -1;
            for (int j = 0; j < uniqueDlls.length; j++) {
                if (uniqueDlls[j] == impDll) {
                    gIdx = j;
                    break;
                }
            }
            if (gIdx < 0) {
                uniqueDlls.add(impDll);
                groupSizes.add(0);
                gIdx = uniqueDlls.length - 1;
            }
            groupSizes[gIdx]++;
            importGroupIdx.add(gIdx);
        }
        int numGroups = uniqueDlls.length;
        int[] posInGroup = [];
        int[] runningCount = [];
        for (int g = 0; g < numGroups; g++) {
            runningCount.add(0);
        }
        for (int i = 0; i < numImports; i++) {
            posInGroup.add(0);
        }
        for (int i = 0; i < numImports; i++) {
            int g = importGroupIdx[i];
            posInGroup[i] = runningCount[g];
            runningCount[g]++;
        }

        int descBytes = (numGroups + 1) * 20;
        int iltTotal = 0;
        int[] iltSizes = [];
        for (int g = 0; g < numGroups; g++) {
            int sz = (groupSizes[g] + 1) * 8;
            iltSizes.add(sz);
            iltTotal += sz;
        }
        int iatTotal = iltTotal;

        int[] hintNameOffsets = [];
        int off = 0;
        for (int i = 0; i < numImports; i++) {
            string nm = this.imports[i].name;
            hintNameOffsets.add(off);
            off += 2 + nm.length + 1;
        }
        int[] dllNameOffsets = [];
        for (int g = 0; g < numGroups; g++) {
            string dll = uniqueDlls[g];
            dllNameOffsets.add(off);
            off += dll.length + 1;
        }

        int[] hintNames = [];
        for (int i = 0; i < numImports; i++) {
            hintNames.add(0);
            hintNames.add(0);
            string nm = this.imports[i].name;
            for (int c = 0; c < nm.length; c++) {
                hintNames.add(nm[c]);
            }
            hintNames.add(0);
        }
        for (int g = 0; g < numGroups; g++) {
            string dll = uniqueDlls[g];
            for (int c = 0; c < dll.length; c++) {
                hintNames.add(dll[c]);
            }
            hintNames.add(0);
        }

        int namesStart = descBytes + iltTotal + iatTotal;
        int stringsStart = namesStart + hintNames.length;
        int importDataSize = stringsStart + stringData.length + this.globalAreaSize;

        int[] rsrcData = [];
        if (false) {
            // Version-resource emission remains disabled for the self-hosted
            // backend because its array argument ABI corrupts the resource
            // builder. PE generation and executable output remain enabled.
            int[] viBlob = this.buildVERSIONINFO(versionKeys, versionValues);
            int viPad = viBlob.length % 4;
            if (viPad != 0) {
                for (int i = 0; i < 4 - viPad; i++) { viBlob.add(0); }
            }
            int resHdrLen = 16 + 8 + 16 + 8 + 16 + 8 + 16;
            for (int i = 0; i < resHdrLen; i++) { rsrcData.add(0); }
            int viOff = resHdrLen;
            rsrcData[12] = 0; rsrcData[13] = 0; rsrcData[14] = 1; rsrcData[15] = 0;
            this.writeLe32(rsrcData, 16, 16);
            this.writeLe32(rsrcData, 20, 0x80000000 | 24);
            rsrcData[36] = 0; rsrcData[37] = 0; rsrcData[38] = 1; rsrcData[39] = 0;
            this.writeLe32(rsrcData, 40, 1);
            this.writeLe32(rsrcData, 44, 0x80000000 | 48);
            rsrcData[60] = 0; rsrcData[61] = 0; rsrcData[62] = 1; rsrcData[63] = 0;
            this.writeLe32(rsrcData, 64, 0x409);
            this.writeLe32(rsrcData, 68, 72);
            this.writeLe32(rsrcData, 72, viOff);
            this.writeLe32(rsrcData, 76, viBlob.length);
            for (int i = 0; i < viBlob.length; i++) { rsrcData.add(viBlob[i]); }
        }

        int FILE_ALIGN = 0x200;
        int SECT_ALIGN = 0x1000;
        int numSections = 2;
        if (rsrcData.length > 0) { numSections = 3; }
        int headersRawSize = 64 + 4 + 20 + 240 + numSections * 40;
        int headersSize = this.padToAlign(headersRawSize, FILE_ALIGN);

        int textRva = SECT_ALIGN;
        int textVirt = this.padToAlign(this.code.length, SECT_ALIGN);
        int textRaw = this.padToAlign(this.code.length, FILE_ALIGN);
        int textFileOff = headersSize;

        int rdataRva = textRva + textVirt;
        int importVirt = this.padToAlign(importDataSize, SECT_ALIGN);
        int importRaw = this.padToAlign(importDataSize, FILE_ALIGN);
        int rdataFileOff = textFileOff + textRaw;

        int rsrcRva = rdataRva + importVirt;
        int rsrcVirt = 0;
        int rsrcRaw = 0;
        int rsrcFileOff = 0;
        if (rsrcData.length > 0) {
            rsrcVirt = this.padToAlign(rsrcData.length, SECT_ALIGN);
            rsrcRaw = this.padToAlign(rsrcData.length, FILE_ALIGN);
            rsrcFileOff = rdataFileOff + importRaw;
        }

        int iatSectionStart = descBytes + iltTotal;
        int[] groupIatStart = [];
        int runOff = 0;
        for (int g = 0; g < numGroups; g++) {
            groupIatStart.add(descBytes + iltTotal + runOff);
            runOff += iltSizes[g];
        }
        int firstIatRva = rdataRva + groupIatStart[0];
        int iatSize = iatTotal;

        int imageSize = this.padToAlign(rdataRva + importVirt + rsrcVirt, SECT_ALIGN);
        int totalSize = rdataFileOff + importRaw;
        if (rsrcData.length > 0) { totalSize = rsrcFileOff + rsrcRaw; }
        int[] pe = [];
        for (int i = 0; i < totalSize; i++) {
            pe.add(0);
        }

        pe[0] = 0x4D; pe[1] = 0x5A;
        this.writeLe32(pe, 0x3C, 64);

        int p = 64;
        pe[p] = 0x50; pe[p+1] = 0x45; pe[p+2] = 0; pe[p+3] = 0;
        p += 4;
        pe[p] = 0x64; pe[p+1] = 0x86; p += 2;
        pe[p] = numSections; pe[p+1] = 0; p += 2;
        this.writeLe32(pe, p, 0x42); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        pe[p] = 0xF0; pe[p+1] = 0; p += 2;
        pe[p] = 0x2F; pe[p+1] = 0; p += 2;

        pe[p] = 0x0B; pe[p+1] = 0x02; p += 2;
        pe[p] = 14; pe[p+1] = 0; p += 2;
        this.writeLe32(pe, p, textRaw); p += 4;
        this.writeLe32(pe, p, importRaw); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, this.entryRva); p += 4;
        this.writeLe32(pe, p, textRva); p += 4;
        this.writeLe64(pe, p, 0x140000000); p += 8;
        this.writeLe32(pe, p, SECT_ALIGN); p += 4;
        this.writeLe32(pe, p, FILE_ALIGN); p += 4;
        pe[p] = 6; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        pe[p] = 6; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, imageSize); p += 4;
        this.writeLe32(pe, p, headersSize); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        pe[p] = this.subsystem; pe[p+1] = 0; p += 2;
        pe[p] = 0; pe[p+1] = 0; p += 2;
        this.writeLe64(pe, p, 0x100000); p += 8;
        this.writeLe64(pe, p, 0x1000); p += 8;
        this.writeLe64(pe, p, 0x100000); p += 8;
        this.writeLe64(pe, p, 0x1000); p += 8;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 16); p += 4;

        for (int i = 0; i < 16; i++) {
            if (i == 1) {
                this.writeLe32(pe, p, rdataRva); p += 4;
                this.writeLe32(pe, p, importVirt); p += 4;

            } else if (i == 2 && rsrcData.length > 0) {
                this.writeLe32(pe, p, rsrcRva); p += 4;
                this.writeLe32(pe, p, rsrcData.length); p += 4;
            } else if (i == 12) {
                this.writeLe32(pe, p, firstIatRva); p += 4;
                this.writeLe32(pe, p, iatSize); p += 4;
            } else {
                this.writeLe32(pe, p, 0); p += 4;
                this.writeLe32(pe, p, 0); p += 4;
            }
        }

        pe[p] = 0x2E; pe[p+1] = 0x74; pe[p+2] = 0x65; pe[p+3] = 0x78; pe[p+4] = 0x74; pe[p+5] = 0; pe[p+6] = 0; pe[p+7] = 0;
        p += 8;
        this.writeLe32(pe, p, textVirt); p += 4;
        this.writeLe32(pe, p, textRva); p += 4;
        this.writeLe32(pe, p, textRaw); p += 4;
        this.writeLe32(pe, p, textFileOff); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0xE0000020); p += 4;

        pe[p] = 0x2E; pe[p+1] = 0x72; pe[p+2] = 0x64; pe[p+3] = 0x61; pe[p+4] = 0x74; pe[p+5] = 0x61; pe[p+6] = 0; pe[p+7] = 0;
        p += 8;
        this.writeLe32(pe, p, importVirt); p += 4;
        this.writeLe32(pe, p, rdataRva); p += 4;
        this.writeLe32(pe, p, importRaw); p += 4;
        this.writeLe32(pe, p, rdataFileOff); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0); p += 4;
        this.writeLe32(pe, p, 0xC0000040); p += 4;

        if (rsrcData.length > 0) {
            pe[p] = 0x2E; pe[p+1] = 0x72; pe[p+2] = 0x73; pe[p+3] = 0x72; pe[p+4] = 0x63; pe[p+5] = 0; pe[p+6] = 0; pe[p+7] = 0;
            p += 8;
            this.writeLe32(pe, p, rsrcVirt); p += 4;
            this.writeLe32(pe, p, rsrcRva); p += 4;
            this.writeLe32(pe, p, rsrcRaw); p += 4;
            this.writeLe32(pe, p, rsrcFileOff); p += 4;
            this.writeLe32(pe, p, 0); p += 4;
            this.writeLe32(pe, p, 0); p += 4;
            this.writeLe32(pe, p, 0); p += 4;
            this.writeLe32(pe, p, 0x40000040); p += 4;
        }

        for (int i = 0; i < this.code.length; i++) {
            pe[textFileOff + i] = this.code[i];
        }

        int importBase = rdataFileOff;

        int descOff = 0;
        int[] groupIltStart = [];
        int rOff = 0;
        for (int g = 0; g < numGroups; g++) {
            groupIltStart.add(descBytes + rOff);
            rOff += iltSizes[g];
        }
        for (int g = 0; g < numGroups; g++) {
            int iltRva = rdataRva + groupIltStart[g];
            int iatRva = rdataRva + groupIatStart[g];
            int dllNameRva = rdataRva + namesStart + dllNameOffsets[g];

            this.writeLe32(pe, importBase + descOff, iltRva);
            this.writeLe32(pe, importBase + descOff + 4, 0);
            this.writeLe32(pe, importBase + descOff + 8, 0);
            this.writeLe32(pe, importBase + descOff + 12, dllNameRva);
            this.writeLe32(pe, importBase + descOff + 16, iatRva);
            descOff += 20;
        }

        int iltOff = descBytes;
        for (int g = 0; g < numGroups; g++) {
            int gBase = importBase + groupIltStart[g];
            int gIatBase = importBase + groupIatStart[g];
            for (int i = 0; i < numImports; i++) {
                if (importGroupIdx[i] == g) {
                    int entryOff = posInGroup[i] * 8;
                    int hintRva = rdataRva + namesStart + hintNameOffsets[i];
                    this.writeLe64(pe, gBase + entryOff, hintRva);
                    this.writeLe64(pe, gIatBase + entryOff, hintRva);
                }
            }
            int nullOff = groupSizes[g] * 8;
            this.writeLe64(pe, gBase + nullOff, 0);
            this.writeLe64(pe, gIatBase + nullOff, 0);
        }

        for (int i = 0; i < hintNames.length; i++) {
            pe[importBase + namesStart + i] = hintNames[i];
        }
        for (int i = 0; i < stringData.length; i++) {
            pe[importBase + stringsStart + i] = stringData[i];
        }

        for (int i = 0; i < rsrcData.length; i++) {
            pe[rsrcFileOff + i] = rsrcData[i];
        }

        return pe;
    }
}
#on LINUX
// LINUX ELF ET_EXEC emitter -- mirrors silverc-rs src/elf.rs plan()/emit().
// Layout (exact mirror of the Rust ET_EXEC writer):
//   Ehdr 64B: 7F 45 4C 46, ELFCLASS64(2), LE(1), EV_CURRENT(1), SYSV(0),
//     ET_EXEC(2), EM_X86_64(62), version(1), entry=0x400000+entryRva,
//     phoff=64, phentsize=56, phnum=7.
//   Phdrs 7x56B (TABLES_OFF=64+7*56=456):
//     [0] PT_INTERP(3) R -- /lib64/ld-linux-x86-64.so.2
//     [1] PT_LOAD(1) R -- file offset 0 at 0x400000 (headers+tables;
//           the kernel hands the loader AT_PHDR inside this mapping,
//           so offset 0 MUST be mapped).
//     [2] PT_LOAD(1) RX -- code at 0x401000 (TEXT_RVA=0x1000).
//     [3] PT_LOAD(1) RW -- data (strings + globals/state) after code,
//           page-aligned; writable so global mutation never faults.
//     [4] PT_LOAD(1) RW -- GOT (3 reserved header zeros + one slot/import).
//     [5] PT_DYNAMIC(2) R -- DT_NEEDED libc.so.6, DT_HASH, DT_PLTGOT,
//           DF_BIND_NOW, STRTAB/STRSZ/SYMTAB/SYMENT/RELA/RELASZ/RELENT/
//           JMPREL/PLTRELSZ/PLTREL, NULL.
//     [6] PT_GNU_STACK(0x6474e551) RW -- empty, marks stack non-executable.
//   R tables at 456: .interp, .hash (SysV nbucket=1 chaining every dynamic
//     symbol -- required, ld.so leaves GOT zero without it), .dynstr
//     (0 | libs | names), .dynsym (null + UND FUNC/GLOBAL per import),
//     .rela.plt (one R_X86_64_JUMP_SLOT=7 per import, PLT-less direct-GOT
//     calls: mov rax,<got>; mov rax,[rax]; call rax), .dynamic.
//   Helpers writeLe32/writeLe64/padToAlign are re-declared here: they sit
//   inside the WINDOWS region above, so a LINUX build re-declares them.
//   MiniPe surface (addSectionData/setVersionInfo/writeFile/build/addImport/
//   computeRdataRva/computeLayout) matches WINDOWS so the driver compiles on
//   both targets; subsystem/version are stored but have no ELF equivalent.
class PeImport {
    public prop string dll;
    public prop string name;

    construct (string dll, string name) {
        this.dll = dll;
        this.name = name;
    }
}
class PeDllGroup {
    public prop string dll;
    public prop int count;

    construct (string dll) {
        this.dll = dll;
        this.count = 0;
    }
}
class MiniPe {
    public int[] code;
    public int entryRva;
    public int globalAreaSize;
    public PeImport[] imports;
    public int[] relocOffsets;
    public int[] extraData;
    public string[] viKeys;
    public string[] viValues;
    public int subsystem;

    construct {
        this.code = [];
        this.entryRva = 0;
        this.globalAreaSize = 0;
        this.imports = [];
        this.relocOffsets = [];
        this.extraData = [];
        this.viKeys = [];
        this.viValues = [];
        this.subsystem = 3;
    }

    public void addSectionData(int[] data) {
        this.extraData = data;
    }

    public void setVersionInfo(string[] keys, string[] values) {
        this.viKeys = keys;
        this.viValues = values;
    }

    public void writeFile(string path) {
        int[] elfBytes = this.build(this.code, this.extraData, []);
        file.writeBytes(path, elfBytes);
    }

    public void addImport(string dll, string name) {
        this.imports.add(new PeImport(dll, name));
    }

    public int computeRdataRva() {
        int SECT_ALIGN = 0x1000;
        int textRva = SECT_ALIGN;
        int textVirt = this.padToAlign(this.code.length, SECT_ALIGN);
        return textRva + textVirt;
    }

    public int[] computeLayout(int stringDataLen) {
        PeDllGroup[] groups = [];
        int[] groupMap = [];
        for (int i = 0; i < this.imports.length; i++) {
            string impDll = this.imports[i].dll;
            int gIdx = -1;
            for (int j = 0; j < groups.length; j++) {
                string gDll = groups[j].dll;
                if (gDll == impDll) {
                    gIdx = j;
                    break;
                }
            }
            if (gIdx < 0) {
                groups.add(new PeDllGroup(impDll));
                gIdx = groups.length - 1;
            }
            PeDllGroup grp = groups[gIdx];
            grp.count++;
            groupMap.add(gIdx);
        }
        int numGroups = groups.length;
        int relaTotal = this.imports.length * 24;
        int[] layout = [];
        layout.add(0);
        layout.add(numGroups);
        layout.add(relaTotal);
        return layout;
    }

    public int padToAlign(int offset, int align) {
        int m = offset % align;
        if (m != 0) {
            return offset + (align - m);
        }
        return offset;
    }

    public void writeLe32(int[] buf, int offset, int val) {
        buf[offset] = val & 0xFF;
        buf[offset + 1] = (val >> 8) & 0xFF;
        buf[offset + 2] = (val >> 16) & 0xFF;
        buf[offset + 3] = (val >> 24) & 0xFF;
    }

    public void writeLe64(int[] buf, int offset, int64 val) {
        buf[offset] = val & 0xFF;
        buf[offset + 1] = (val >> 8) & 0xFF;
        buf[offset + 2] = (val >> 16) & 0xFF;
        buf[offset + 3] = (val >> 24) & 0xFF;
        buf[offset + 4] = (val >> 32) & 0xFF;
        buf[offset + 5] = (val >> 40) & 0xFF;
        buf[offset + 6] = (val >> 48) & 0xFF;
        buf[offset + 7] = (val >> 56) & 0xFF;
    }

    public int[] build(int[] codeIn, int[] stringData, string[] versionData) {
        this.code = codeIn;
        int n = this.imports.length;
        int codeLen = codeIn.length;
        int dataLen = stringData.length + this.globalAreaSize;
        int PAGE = 0x1000;
        int BASE = 0x400000;
        int TEXT_RVA = 0x1000;
        int TABLES_OFF = 456;
        string interpStr = "/lib64/ld-linux-x86-64.so.2";
        int interpLen = interpStr.length + 1;
        string libcName = "libc.so.6";
        string[] neededLibs = [];
        for (int i = 0; i < n; i++) {
            string libName = this.imports[i].dll;
            if (libName.length == 0) { libName = libcName; }
            bool seen = false;
            for (int j = 0; j < neededLibs.length; j++) {
                if (neededLibs[j] == libName) { seen = true; break; }
            }
            if (!seen) { neededLibs.add(libName); }
        }
        if (neededLibs.length == 0) { neededLibs.add(libcName); }
        int[] dynstrBytes = [];
        dynstrBytes.add(0);
        int[] libOffs = [];
        for (int i = 0; i < neededLibs.length; i++) {
            libOffs.add(dynstrBytes.length);
            string lb = neededLibs[i];
            for (int k = 0; k < lb.length; k++) { dynstrBytes.add(lb[k]); }
            dynstrBytes.add(0);
        }
        int libcOff = libOffs[0];
        for (int i = 0; i < neededLibs.length; i++) {
            if (neededLibs[i] == libcName) { libcOff = libOffs[i]; break; }
        }
        int[] nameOffs = [];
        for (int i = 0; i < n; i++) {
            nameOffs.add(dynstrBytes.length);
            string fn = this.imports[i].name;
            for (int k = 0; k < fn.length; k++) { dynstrBytes.add(fn[k]); }
            dynstrBytes.add(0);
        }
        int dynstrLen = dynstrBytes.length;
        int rxFilesz = this.padToAlign(codeLen, PAGE);
        int rxOff = PAGE;
        int rxVaddr = BASE + TEXT_RVA;
        int dataFilesz = this.padToAlign(dataLen, PAGE);
        int dataOff = rxOff + rxFilesz;
        int dataVaddr = rxVaddr + rxFilesz;
        int relaLen = n * 24;
        int dynsymLen = 24 * (n + 1);
        int dynamicLen = (14 + neededLibs.length) * 16;
        int hashLen = 16 + n * 4;
        int offInterp = TABLES_OFF;
        int offHash = offInterp + interpLen;
        int offDynstr = offHash + hashLen;
        int offDynsym = offDynstr + dynstrLen;
        int offRela = offDynsym + dynsymLen;
        int offDynamic = offRela + relaLen;
        int rFilesz = offDynamic + dynamicLen;
        int rwOff = dataOff + dataFilesz;
        int rwVaddr = dataVaddr + dataFilesz;
        int64 entryAddr = BASE + this.entryRva;
        int totalSize = rwOff + 24 + n * 8;
        int[] out = [];
        for (int i = 0; i < totalSize; i++) { out.add(0); }
        out[0] = 127;
        out[1] = 69;
        out[2] = 76;
        out[3] = 70;
        out[4] = 2;
        out[5] = 1;
        out[6] = 1;
        out[7] = 0;
        out[16] = 2;
        out[17] = 0;
        out[18] = 62;
        out[19] = 0;
        this.writeLe32(out, 20, 1);
        this.writeLe64(out, 24, entryAddr);
        this.writeLe64(out, 32, 64);
        this.writeLe64(out, 40, 0);
        this.writeLe32(out, 48, 0);
        out[52] = 64;
        out[53] = 0;
        out[54] = 56;
        out[55] = 0;
        out[56] = 7;
        out[57] = 0;
        int ph0 = 64;
        this.writeLe32(out, ph0, 3);
        this.writeLe32(out, ph0 + 4, 4);
        this.writeLe64(out, ph0 + 8, offInterp);
        this.writeLe64(out, ph0 + 16, BASE + offInterp);
        this.writeLe64(out, ph0 + 24, BASE + offInterp);
        this.writeLe64(out, ph0 + 32, interpLen);
        this.writeLe64(out, ph0 + 40, interpLen);
        this.writeLe64(out, ph0 + 48, 1);
        int ph1 = 120;
        this.writeLe32(out, ph1, 1);
        this.writeLe32(out, ph1 + 4, 4);
        this.writeLe64(out, ph1 + 8, 0);
        this.writeLe64(out, ph1 + 16, BASE);
        this.writeLe64(out, ph1 + 24, BASE);
        this.writeLe64(out, ph1 + 32, rFilesz);
        this.writeLe64(out, ph1 + 40, rFilesz);
        this.writeLe64(out, ph1 + 48, PAGE);
        int ph2 = 176;
        this.writeLe32(out, ph2, 1);
        this.writeLe32(out, ph2 + 4, 5);
        this.writeLe64(out, ph2 + 8, rxOff);
        this.writeLe64(out, ph2 + 16, rxVaddr);
        this.writeLe64(out, ph2 + 24, rxVaddr);
        this.writeLe64(out, ph2 + 32, rxFilesz);
        this.writeLe64(out, ph2 + 40, rxFilesz);
        this.writeLe64(out, ph2 + 48, PAGE);
        int ph3 = 232;
        this.writeLe32(out, ph3, 1);
        this.writeLe32(out, ph3 + 4, 6);
        this.writeLe64(out, ph3 + 8, dataOff);
        this.writeLe64(out, ph3 + 16, dataVaddr);
        this.writeLe64(out, ph3 + 24, dataVaddr);
        this.writeLe64(out, ph3 + 32, dataFilesz);
        this.writeLe64(out, ph3 + 40, dataFilesz);
        this.writeLe64(out, ph3 + 48, PAGE);
        int ph4 = 288;
        this.writeLe32(out, ph4, 1);
        this.writeLe32(out, ph4 + 4, 6);
        this.writeLe64(out, ph4 + 8, rwOff);
        this.writeLe64(out, ph4 + 16, rwVaddr);
        this.writeLe64(out, ph4 + 24, rwVaddr);
        this.writeLe64(out, ph4 + 32, 24 + n * 8);
        this.writeLe64(out, ph4 + 40, 24 + n * 8);
        this.writeLe64(out, ph4 + 48, PAGE);
        int ph5 = 344;
        this.writeLe32(out, ph5, 2);
        this.writeLe32(out, ph5 + 4, 4);
        this.writeLe64(out, ph5 + 8, offDynamic);
        this.writeLe64(out, ph5 + 16, BASE + offDynamic);
        this.writeLe64(out, ph5 + 24, BASE + offDynamic);
        this.writeLe64(out, ph5 + 32, dynamicLen);
        this.writeLe64(out, ph5 + 40, dynamicLen);
        this.writeLe64(out, ph5 + 48, 8);
        int ph6 = 400;
        this.writeLe32(out, ph6, 0x6474e551);
        this.writeLe32(out, ph6 + 4, 6);
        this.writeLe64(out, ph6 + 8, 0);
        this.writeLe64(out, ph6 + 16, 0);
        this.writeLe64(out, ph6 + 24, 0);
        this.writeLe64(out, ph6 + 32, 0);
        this.writeLe64(out, ph6 + 40, 0);
        this.writeLe64(out, ph6 + 48, 16);
        for (int k = 0; k < interpStr.length; k++) { out[offInterp + k] = interpStr[k]; }
        out[offInterp + interpStr.length] = 0;
        this.writeLe32(out, offHash, 1);
        this.writeLe32(out, offHash + 4, n + 1);
        if (n > 0) { this.writeLe32(out, offHash + 8, 1); } else { this.writeLe32(out, offHash + 8, 0); }
        this.writeLe32(out, offHash + 12, 0);
        for (int hi = 1; hi <= n; hi++) {
            int cv = 0;
            if (hi < n) { cv = hi + 1; }
            this.writeLe32(out, offHash + 12 + hi * 4, cv);
        }
        for (int k = 0; k < dynstrLen; k++) { out[offDynstr + k] = dynstrBytes[k]; }
        for (int si = 0; si < n; si++) {
            int symOff = offDynsym + 24 * (si + 1);
            this.writeLe32(out, symOff, nameOffs[si]);
            out[symOff + 4] = 18;
        }
        for (int si = 0; si < n; si++) {
            int relaBase = offRela + si * 24;
            int gotSlot = rwVaddr + 24 + si * 8;
            this.writeLe64(out, relaBase, gotSlot);
            this.writeLe32(out, relaBase + 8, 7);
            this.writeLe32(out, relaBase + 12, si + 1);
