mod export progress;

import * from win32.kernel32;

// Compilation progress reporting (ported from silverc-rs src/progress.rs,
// commit 74a3fe4). Prints one STDERR line per module processed so the user
// sees how far a compile has advanced: files done / files total, percentage
// complete, and an estimated time remaining. STDERR is used on purpose —
// stdout stays clean for program output (`print`, `threads.length`, ...).
//
// `total` is discovered up front (entry + transitively resolved imports) by a
// counting pass that mirrors the same import-resolution used by the real
// collection, so the counts are exact and the last line always reads 100%.

class ProgressReporter {
    private prop int total;
    private prop int processed;
    private prop int startTick;
    private prop bool enabled;
    // When the parsing phase finished (all per-module lines printed); used so
    // the codegen start line can report how long the parse phase took.
    private prop int parseDoneTick;
    private prop bool parseDoneSet;

    construct (int total) {
        this.total = total;
        this.processed = 0;
        this.startTick = GetTickCount();
        this.enabled = true;
        this.parseDoneTick = 0;
        this.parseDoneSet = false;
    }

    // How many modules have been recorded so far.
    public int processedCount() {
        return this.processed;
    }

    public int totalCount() {
        return this.total;
    }

    public int elapsedMs() {
        int ms = GetTickCount() - this.startTick;
        if (ms < 0) { return 0; }
        return ms;
    }

    // Record one module as processed and (when enabled) print its line.
    public void moduleDone(string name) {
        this.processed = this.processed + 1;
        if (this.enabled) {
            this.printLine(name);
        }
    }

    // Final "<pct>% done" line after the last module.
    public void finish() {
        if (!this.enabled) { return; }
        int total = this.total;
        if (total < this.processed) { total = this.processed; }
        eprintln(this.percentOf(total).toString() + "% done");
    }

    // Mark the parsing phase as finished. The codegen start line reports how
    // long parsing took so the fast phase and the heavy phases are visually
    // separated.
    public void parseDone() {
        if (!this.parseDoneSet) {
            this.parseDoneSet = true;
            this.parseDoneTick = GetTickCount();
        }
    }

    // Phase B start: `codegen: emitting native code...` plus the parse-phase
    // duration when it is known.
    public void phaseCodegen() {
        if (!this.enabled) { return; }
        if (this.parseDoneSet) {
            int elapsedMs = this.parseDoneTick - this.startTick;
            if (elapsedMs < 0) { elapsedMs = 0; }
            eprintln("codegen: emitting native code... (parsing took " + formatDuration(elapsedMs / 1000) + ")");
        } else {
            eprintln("codegen: emitting native code...");
        }
    }

    // Phase B tick: called after each function has been emitted; prints
    // `codegen: N/M functions` every 500 functions (and on the final one) —
    // but only once the program is large enough for the line to carry
    // information, so small compiles stay quiet.
    public void codegenTick(int done, int total) {
        if (!this.enabled) { return; }
        if (total >= 500 && (done == total || done % 500 == 0)) {
            eprintln("codegen: " + done.toString() + "/" + total.toString() + " functions");
        }
    }

    // Phase C start: printed right before the PE image is written out.
    public void phaseEmit() {
        if (this.enabled) {
            eprintln("writing executable...");
        }
    }

    // Cache-flush phase start: printed before the bytecode cache session is
    // flushed (`--cache-bytecode`).
    public void phaseCache() {
        if (this.enabled) {
            eprintln("syncing bytecode cache...");
        }
    }

    // Cache-flush phase end: `cache: K/M files re-cached` — K files whose
    // bytecode was rewritten this run, M files the cache tracks in total.
    public void cacheDone(int recached, int total) {
        if (this.enabled) {
            eprintln("cache: " + recached.toString() + "/" + total.toString() + " files re-cached");
        }
    }

    private void printLine(string name) {
        int total = this.total;
        if (total < this.processed) { total = this.processed; }
        int pct = this.percentOf(total);
        if (this.processed >= total) {
            eprintln("[" + this.processed.toString() + "/" + total.toString() + "] module " + name + " 100% done");
        } elif (this.processed == 0) {
            eprintln("[" + this.processed.toString() + "/" + total.toString() + "] module " + name + " " + pct.toString() + "% ~estimating... left");
        } else {
            eprintln("[" + this.processed.toString() + "/" + total.toString() + "] module " + name + " " + pct.toString() + "% ~" + this.eta() + " left");
        }
    }

    // Estimated time remaining: `elapsed / processed * remaining`, formatted
    // as a human duration.
    public string eta() {
        int elapsedMs = GetTickCount() - this.startTick;
        if (elapsedMs < 0) { elapsedMs = 0; }
        int remaining = this.total - this.processed;
        if (remaining < 0) { remaining = 0; }
        if (this.processed == 0 || remaining == 0) {
            return "estimating...";
        }
        int etaSecs = (elapsedMs * remaining / this.processed + 500) / 1000;
        return formatDuration(etaSecs);
    }

    // 0..100 percent, rounded to the nearest whole number and capped at 100.
    public int percentOf(int total) {
        if (total <= 0) { return 100; }
        int pct = this.processed * 100 / total;
        int rem = (this.processed * 100) % total;
        if (rem * 2 >= total) { pct = pct + 1; }
        if (pct > 100) { pct = 100; }
        return pct;
    }
}

// Human duration: `<1s`, `45s`, `3m 12s`, `1h 5m`.
public string formatDuration(int secs) {
    if (secs == 0) { return "<1s"; }
    if (secs < 60) { return secs.toString() + "s"; }
    int minutes = secs / 60;
    int seconds = secs % 60;
    if (minutes < 60) { return minutes.toString() + "m " + seconds.toString() + "s"; }
    int hours = minutes / 60;
    int remMinutes = minutes % 60;
    return hours.toString() + "h " + remMinutes.toString() + "m";
}
