                    }
                    else { s = s + "\\" + esc; }
                }
            } else {
                s = s + charToString(ch);
            }
        }
        Token tok = new Token(3, s, ln, cl);
        tok.strVal = s;
        return tok;
    }

    private Token readChar() {
        int ln = this.line; int cl = this.col;
        char ch = ' ';
        if (this.pos < this.srcLen) {
            ch = this.src[this.pos]; this.advance();
            if (ch == '\\' && this.pos < this.srcLen) {
                char esc = this.src[this.pos]; this.advance();
                if (esc == 'n') { ch = '\n'; }
                else if (esc == 't') { ch = '\t'; }
                else if (esc == '0') { ch = '\0'; }
                else if (esc == 'r') { ch = '\r'; }
                else if (esc == '\\') { ch = '\\'; }
                else if (esc == '\'') { ch = '\''; }
                else if (esc == 'x') {
                    // Hex escape \xHH (e.g. '\x1B').
                    int hv = 0;
                    int nd = 0;
                    while (nd < 2 && this.pos < this.srcLen) {
                        char hc = this.src[this.pos];
                        int dv = -1;
                        if (hc >= '0' && hc <= '9') { dv = hc - '0'; }
                        elif (hc >= 'a' && hc <= 'f') { dv = hc - 'a' + 10; }
                        elif (hc >= 'A' && hc <= 'F') { dv = hc - 'A' + 10; }
                        if (dv < 0) { break; }
                        this.advance();
                        hv = hv * 16 + dv;
                        nd = nd + 1;
                    }
                    if (nd > 0) { ch = hv; } else { ch = esc; }
                }
                else { ch = esc; }
            }
        }
        if (this.pos < this.srcLen && this.src[this.pos] == '\'') {
            this.advance();
        }
        string charText = "";
        charText = charText + ch;
        Token tok = new Token(4, charText, ln, cl);
        tok.charVal = ch;
        return tok;
    }

    private Token readNumber() {
        int ln = this.line; int cl = this.col;
        int firstCode = this.currentCode;
        this.advance();
        string s = "";
        if (firstCode == 48) { s = s + "0"; }
        elif (firstCode == 49) { s = s + "1"; }
        elif (firstCode == 50) { s = s + "2"; }
        elif (firstCode == 51) { s = s + "3"; }
        elif (firstCode == 52) { s = s + "4"; }
        elif (firstCode == 53) { s = s + "5"; }
        elif (firstCode == 54) { s = s + "6"; }
        elif (firstCode == 55) { s = s + "7"; }
        elif (firstCode == 56) { s = s + "8"; }
        elif (firstCode == 57) { s = s + "9"; }
        bool isFloat = false;
        int base = 10;
        if (firstCode == 48 && this.pos < this.srcLen) {
            char next = this.src[this.pos];
            if (next == 'x' || next == 'X') {
                this.advance();
                base = 16;
                s = "";
            }
        }
        while (this.pos < this.srcLen) {
            char ch = this.src[this.pos];
            if ((ch >= '0' && ch <= '9') || ch == '_') {
                s = s + ch; this.advance();
            } elif (base == 16 && ((ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F'))) {
                s = s + ch; this.advance();
            } elif (ch == '.' && !isFloat) {
                if (this.peek() == '.') { break; }
                isFloat = true; s = s + "."; this.advance();
            } elif (ch == 'e' || ch == 'E') {
                isFloat = true; s = s + ch; this.advance();
if (this.pos < this.srcLen) {
                char sign = this.src[this.pos];
                if (sign == '+' || sign == '-') {
                    s = s + sign; this.advance();
                }
            }
            } else { break; }
        }
        Token tok = new Token(1, s, ln, cl);
