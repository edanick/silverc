        // the one in scope for the code being generated now, which is what the
        // forward scan used to get wrong: every catch after the first resolved
        // to the FIRST catch's slot and read the first thrown value.
        for (int i = this.localNames.length - 1; i >= 0; i = i - 1) {
            if (this.strEq(this.localNames[i], name)) {
                return this.localOffsets[i];
            }
        }
        return 0;
    }

    public int findGlobal(string name) {
        for (int i = 0; i < this.globalNames.length; i++) {
            if (this.strEq(this.globalNames[i], name)) {
                return i;
            }
        }
        return -1;
    }

    public void genGlobalLoad(int gi) {
        // Load the 8-byte global slot value into RAX.  The slot's absolute
        // address is patched after codegen (see patchGlobalRefs).
        int sp = this.asm.buf.length;
        this.asm.emitImm64(0, 0);
        this.globalPatchOffsets.add(sp + 2);
        this.globalPatchIndices.add(gi);
        this.asm.movRMBase(0, 0, 0);
    }

    public void genGlobalStore(int gi) {
        // Store the value currently in RAX into the global slot.  Mirrors
        // genGlobalLoad but dereferences the patched slot address as a store.
        this.asm.pushR64(0);
        int sp = this.asm.buf.length;
        this.asm.emitImm64(0, 0);
        this.globalPatchOffsets.add(sp + 2);
        this.globalPatchIndices.add(gi);
        this.asm.popR64(1);
        this.asm.movMBaseR(0, 1, 0);
    }

    public void emitExceptionJump() {
        if (this.currentCatch >= 0) {
            this.asm.jmpLabel(this.currentCatch);
        } elif (this.currentFinally >= 0) {
            this.asm.jmpLabel(this.currentFinally);
        } elif (this.currentExcHandler >= 0) {
            this.asm.jmpLabel(this.currentExcHandler);
        } else {
            this.asm.jmpLabel(this.currentReturnLabel);
        }
    }

    public void emitReturnJump() {
        if (this.currentFinally >= 0) {
            this.asm.movMBaseR(5, 0, this.currentFinallyRetVal);
            this.asm.movRI64(0, 1);
            this.asm.movMBaseR(5, 0, this.currentFinallyRetFlag);
            this.asm.jmpLabel(this.currentFinally);
        } else {
            this.asm.jmpLabel(this.currentReturnLabel);
        }
    }

    public void emitThrowException(string message) {
        // Allocate a 32-byte exception object with the std Exception layout
        // (message@0, line@8, column@16, reason@24), store it in the global
        // exception state, and dispatch to the nearest handler.
        int sizeOff = this.allocLocal("__exc_size");
        this.asm.movRI64(0, 32);
        this.asm.movMBaseR(5, 0, sizeOff);
        this.emitLlmaiHeapAlloc(sizeOff);
        int objOff = this.allocLocal("__exc_obj");
        this.asm.movMBaseR(5, 0, objOff);
        this.emitLlmaiStringLiteral(message);
        this.asm.movRMBase(1, 5, objOff);
        this.asm.movMBaseR(1, 0, 0);
        this.asm.movMBaseR(1, 0, 24);
        this.asm.xorRR64(2, 2);
        this.asm.movMBaseR(1, 2, 8);
        this.asm.movMBaseR(1, 2, 16);
        int evIdx = this.findGlobal("__exc_value");
        this.asm.movRMBase(0, 5, objOff);
        this.genGlobalStore(evIdx);
        this.asm.movRI64(0, 1);
        int eaIdx = this.findGlobal("__exc_active");
        this.genGlobalStore(eaIdx);
        this.emitExceptionJump();
    }

    public void emitDivisorCheck() {
        // RCX holds the divisor before an idiv. Throw DivideByZeroException
        // when it is zero.
        int ok = this.newLabel();
        this.asm.cmpRI32(1, 0);
        this.asm.jneLabel(ok);
        this.emitThrowException("division by zero");
        this.asm.bindLabel(ok);
    }
