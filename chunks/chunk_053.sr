        // receivers and toFloat/toFloat64 on float receivers lower to a bare
        // reload of the operand. Without this, `idx.toInt().toInt()` (common in
        // silveri) routed through genUserCall and corrupted RAX when the
        // receiver was itself a call expression.
        if (this.strEq(name, "toInt") || this.strEq(name, "toInt64") || this.strEq(name, "toNumber")) {
            if (this.strEq(recvType, "int") || this.strEq(recvType, "int32") || this.strEq(recvType, "int64") || this.strEq(recvType, "bool") || this.strEq(recvType, "char")) {
                return true;
            }
        }
        if (this.strEq(name, "toFloat") || this.strEq(name, "toFloat64")) {
            if (this.strEq(recvType, "float") || this.strEq(recvType, "float64")) {
                return true;
            }
        }
        if (this.strEq(recvType, "string")) {
            if (this.strEq(name, "contains") || this.strEq(name, "trim") || this.strEq(name, "trimEnd") || this.strEq(name, "trimStart") || this.strEq(name, "trimLeft") || this.strEq(name, "trimRight") || this.strEq(name, "split") || this.strEq(name, "lines") || this.strEq(name, "startsWith") || this.strEq(name, "endsWith") || this.strEq(name, "indexOf") || this.strEq(name, "find") || this.strEq(name, "substr") || this.strEq(name, "substring") || this.strEq(name, "toLower") || this.strEq(name, "lower") || this.strEq(name, "toUpper") || this.strEq(name, "upper") || this.strEq(name, "replace") || this.strEq(name, "pad") || this.strEq(name, "padLeft") || this.strEq(name, "padRight") || this.strEq(name, "slugify") || this.strEq(name, "length") || this.strEq(name, "toInt64") || this.strEq(name, "toInt") || this.strEq(name, "toNumber")) {
                return true;
            }
        }
        if (this.strEq(recvType, "char")) {
            if (this.strEq(name, "isDigit") || this.strEq(name, "isAlpha") || this.strEq(name, "isAlphaNum") || this.strEq(name, "isLower") || this.strEq(name, "isUpper") || this.strEq(name, "isWhiteSpace")) {
                return true;
            }
        }
        return false;
    }

    public void genBuiltinMemberCall(Node call) {
        Node recv = call.child(0);
        string name = call.name;
        string recvType = this.inferExprType(recv);
        if (this.strEq(name, "toString")) {
            if (this.strEq(recvType, "string")) {
                this.genExpr(recv);
            } elif (this.strEq(recvType, "char")) {
                this.genCharToString(recv);
            } elif (call.childCount() >= 2 && call.child(1).kind == 2) {
                this.genIntToStringRadix(recv, call.child(1).strVal);
            } else {
                this.genIntToString(recv);
            }
            return;
        }
        if (this.strEq(name, "toInt") || this.strEq(name, "toInt64") || this.strEq(name, "toNumber")) {
            if (this.strEq(recvType, "int") || this.strEq(recvType, "int32") || this.strEq(recvType, "int64") || this.strEq(recvType, "bool") || this.strEq(recvType, "char")) {
                this.genExpr(recv);
                return;
            }
        }
        if (this.strEq(name, "toFloat") || this.strEq(name, "toFloat64")) {
            if (this.strEq(recvType, "float") || this.strEq(recvType, "float64")) {
                this.genExpr(recv);
                return;
            }
        }
        if (this.strEq(name, "length")) {
            // string.length() - call form of the .length field access.
            this.genExpr(recv);
            this.asm.movRR64(1, 0);
            this.addImportPatch("ucrtbase.dll", "strlen");
            int sLenM = 0xDEADBEEFCAFEBAC1;
            this.asm.emitImm64(0, sLenM);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            return;
        }
        if (this.strEq(name, "contains")) {
            if (call.childCount() < 2) { this.asm.xorRR64(0, 0); return; }
            int recvOff = this.allocLocal("__contains_recv");
            this.genExpr(recv);
            this.asm.movMBaseR(5, 0, recvOff);
            this.genExpr(call.child(1));
            this.asm.movRR64(2, 0);
            this.asm.movRMBase(1, 5, recvOff);
            this.addImportPatch("ucrtbase.dll", "strstr");
            int sContains = 0xDEADBEEFCAFEBAD7;
            this.asm.emitImm64(0, sContains);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            int notFound = this.newLabel();
            int containsDone = this.newLabel();
            this.asm.cmpRI32(0, 0);
            this.asm.jeLabel(notFound);
            this.asm.movRI64(0, 1);
            this.asm.jmpLabel(containsDone);
            this.asm.bindLabel(notFound);
            this.asm.xorRR64(0, 0);
            this.asm.bindLabel(containsDone);
            return;
        }
        if (this.strEq(name, "toInt64") || this.strEq(name, "toInt") || this.strEq(name, "toNumber")) {
            // Convert a string to an integer via strtoll().  When no digit is
            // consumed (endptr still points at the original string) the input
            // is not numeric and a FormatException is thrown.
            if (call.childCount() < 1) { this.asm.xorRR64(0, 0); return; }
            this.genExpr(recv);
