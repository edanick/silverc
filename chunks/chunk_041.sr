        } elif (call.isMember && call.childCount() > 0 && call.child(0).kind == 6 && !recvIsUserSymbol && (this.strEq(call.child(0).name, "fs") || this.strEq(call.child(0).name, "file") || this.strEq(call.child(0).name, "folder")) && (this.strEq(call.name, "getenv") || this.strEq(call.name, "getEnv"))) {
