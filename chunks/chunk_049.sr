        return 0;
    }

    public void genAsmCall(Node call) {
        string name = call.name;
        if (this.strEq(name, "ret")) {
            this.asm.ret();
            return;
        }
        if (this.strEq(name, "label")) {
            string lbl = "";
            if (call.childCount() > 0 && call.child(0).kind == 2) {
                lbl = call.child(0).strVal;
            }
            this.asm.label(lbl);
            return;
        }
        if (this.strEq(name, "bindLabel")) {
            int id = 0;
            if (call.childCount() > 0) {
                id = this.asmOperand(call.child(0));
            }
            this.asm.bindLabel(id);
            return;
        }
        if (this.strEq(name, "emitImm64")) {
            int reg = 0;
            int64 imm = 0;
            if (call.childCount() > 1) {
                reg = this.asmOperand(call.child(1));
            }
            if (call.childCount() > 2) {
                Node immNode = call.child(2);
                if (immNode.kind == 0) {
                    imm = immNode.intVal;
                } elif (immNode.kind == 6) {
                    imm = this.findLocal(immNode.name);
                }
            }
            this.asm.emitImm64(reg, imm);
            return;
        }
        // NOTE: avoid `continue` inside this for-loop on purpose: old compiler
        // builds miscompile continue-in-for (they skip the increment), which
        // breaks self-hosting bootstrap. Use if/else instead.
        int[] args = [];
        for (int i = 0; i < call.childCount(); i++) {
            Node c = call.child(i);
            if (c.kind != 13) {
                args.add(this.asmOperand(c));
            }
        }
        if (this.strEq(name, "pushR64")) { this.asm.pushR64(args[0]); }
        elif (this.strEq(name, "popR64")) { this.asm.popR64(args[0]); }
        elif (this.strEq(name, "movRR64")) { this.asm.movRR64(args[0], args[1]); }
        elif (this.strEq(name, "movRI64")) {
            int64 v = 0;
            if (call.childCount() > 1) { v = this.asmOperand(call.child(1)); }
            this.asm.movRI64(args[0], v);
        }
        elif (this.strEq(name, "movRMBase")) { this.asm.movRMBase(args[0], args[1], args[2]); }
        elif (this.strEq(name, "movMBaseR")) { this.asm.movMBaseR(args[0], args[1], args[2]); }
        elif (this.strEq(name, "subRI32")) { this.asm.subRI32(args[0], args[1]); }
        elif (this.strEq(name, "addRI32")) { this.asm.addRI32(args[0], args[1]); }
        elif (this.strEq(name, "xorRR64")) { this.asm.xorRR64(args[0], args[1]); }
        elif (this.strEq(name, "cmpRI32")) { this.asm.cmpRI32(args[0], args[1]); }
        elif (this.strEq(name, "cmpRR64")) { this.asm.cmpRR64(args[0], args[1]); }
        elif (this.strEq(name, "callR64")) { this.asm.callR64(args[0]); }
        elif (this.strEq(name, "leaRBase")) { this.asm.leaRBase(args[0], args[1], args[2]); }
        elif (this.strEq(name, "emitU8")) { this.asm.emitU8(args[0]); }
        elif (this.strEq(name, "emitU32")) { this.asm.emitU32(args[0]); }
        elif (this.strEq(name, "emitImm64")) { this.asm.emitImm64(args[0], args[1]); }
        elif (this.strEq(name, "emitCallSetup")) { this.asm.emitCallSetup(args[0]); }
        elif (this.strEq(name, "emitCallTeardown")) { this.asm.emitCallTeardown(); }
        elif (this.strEq(name, "addRR64")) { this.asm.addRR64(args[0], args[1]); }
        elif (this.strEq(name, "subRR64")) { this.asm.subRR64(args[0], args[1]); }
        elif (this.strEq(name, "mulRR64")) { this.asm.mulRR64(args[0]); }
        elif (this.strEq(name, "andRImm")) { this.asm.andRImm(args[0], args[1]); }
        elif (this.strEq(name, "shlR64Imm")) { this.asm.shlR64Imm(args[0], args[1]); }
        elif (this.strEq(name, "incR64")) { this.asm.incR64(args[0]); }
        elif (this.strEq(name, "decR64")) { this.asm.decR64(args[0]); }
        elif (this.strEq(name, "movByteMBaseIdxR")) { this.asm.movByteMBaseIdxR(args[0], args[1], args[2]); }
        elif (this.strEq(name, "movMBaseByteR")) { this.asm.movMBaseByteR(args[0], args[1], args[2]); }
        elif (this.strEq(name, "jeLabel")) { this.asm.jeLabel(args[0]); }
        elif (this.strEq(name, "jneLabel")) { this.asm.jneLabel(args[0]); }
        elif (this.strEq(name, "jmpLabel")) { this.asm.jmpLabel(args[0]); }
        elif (this.strEq(name, "jlLabel")) { this.asm.jlLabel(args[0]); }
        elif (this.strEq(name, "jleLabel")) { this.asm.jleLabel(args[0]); }
        elif (this.strEq(name, "jgLabel")) { this.asm.jgLabel(args[0]); }
        elif (this.strEq(name, "jgeLabel")) { this.asm.jgeLabel(args[0]); }
        elif (this.strEq(name, "movzxByteMBase")) { this.asm.movzxByteMBase(args[0], args[1], args[2]); }
        elif (this.strEq(name, "callRel32")) { this.asm.callRel32(args[0]); }
    }

    public void genUserCall(Node call) {
        string name = call.name;
        // Module-qualified call (e.g. json_runtime.get(x, "y") inside a class
        // method). The receiver is an identifier that is neither a user-class
        // instance nor `this`, so it names a module: the target must resolve
        // to the GLOBAL function, never to a method of the current class
