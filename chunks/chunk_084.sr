        this.asm.emitCallTeardown();
        this.asm.movRI64(1, 8);
        this.asm.movMBaseR(0, 1, 0);
        this.asm.movRI64(1, 0);
        this.asm.movMBaseR(0, 1, 8);
        this.asm.addRI32(0, 16);
    }

    public void genOsVersionCall() {
        // os.version - returns the Windows version string (e.g. "10.0").
        // Uses RtlGetVersion from ntdll.dll to get the real OS version,
        // then formats it as "major.minor".
        int verOff = this.allocLocal("__os_ver");

        // Zero out RTL_OSVERSIONINFOW on the stack (284 bytes).
        for (int zi = 0; zi < 36; zi++) {
            this.asm.movRI64(0, 0);
            this.asm.movMBaseR(5, 0, verOff + zi * 8);
        }
        // dwOSVersionInfoSize = 284
        this.asm.movRI64(0, 284);
        this.asm.movMBaseR(5, 0, verOff);

        // RtlGetVersion(&ver)
        this.asm.emitCallSetup(0);
        this.asm.leaRBase(1, 5, verOff);
        this.addImportPatch("ntdll.dll", "RtlGetVersion");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        // Check if build >= 22000 → Windows 11 (major == 10 with high build)
        int os110 = this.newLabel();
        int osDone = this.newLabel();
        this.asm.movRMBase(0, 5, verOff + 4);              // dwMajorVersion
        this.asm.cmpRI32(0, 10);
        this.asm.jneLabel(osDone);                          // Not 10 → emit "10.0"
        // Major == 10: check build number for Win 11
        this.asm.movRMBase(0, 5, verOff + 12);             // dwBuildNumber
        this.asm.cmpRI32(0, 22000);
        this.asm.jlLabel(osDone);                          // build < 22000 → Win 10
        // Win 11
        this.emitLlmaiStringLiteral("11.0");
        return;
        this.asm.bindLabel(osDone);
        // Win 10 or unknown → emit "10.0"
        this.emitLlmaiStringLiteral("10.0");
    }

    public void genOsBuildCall() {
        // os.build - returns the Windows build number as a string.
        int verOff = this.allocLocal("__os_bver");

        // Zero out RTL_OSVERSIONINFOW on the stack (284 bytes).
        for (int zi = 0; zi < 36; zi++) {
            this.asm.movRI64(0, 0);
            this.asm.movMBaseR(5, 0, verOff + zi * 8);
        }
        // dwOSVersionInfoSize = 284
        this.asm.movRI64(0, 284);
        this.asm.movMBaseR(5, 0, verOff);

        // RtlGetVersion(&ver)
        this.asm.emitCallSetup(0);
        this.asm.leaRBase(1, 5, verOff);
        this.addImportPatch("ntdll.dll", "RtlGetVersion");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        // Allocate a 12-byte buffer for itoa output
        this.asm.movRI64(1, 12);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD5);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        int bufOff = this.allocLocal("__os_bbuf");
        this.asm.movMBaseR(5, 0, bufOff);

        // itoa(buildNumber, buffer, 10)
        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, verOff + 12);             // R1 = dwBuildNumber
        this.asm.movRMBase(2, 5, bufOff);                  // R2 = buffer
        this.asm.movRI64(8, 10);                            // R8 = radix 10
        this.addImportPatch("msvcrt.dll", "_itoa");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD6);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        // Return buffer
        this.asm.movRMBase(0, 5, bufOff);
    }

    public void genGetExtCall(Node call) {
        // file.getExt(path) - returns extension after last dot.
