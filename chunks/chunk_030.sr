        }
        if (obj.kind == 6 && this.strEq(obj.name, "this") && !this.strEq(this.currentClassName, "")) {
            int thisOff = this.findLocal("this");
            int fieldOff = this.findFieldOffset(this.currentClassName, fieldName);
            if (fieldOff < 0) { return; }
            this.asm.movRMBase(0, 5, thisOff);
            this.asm.movRMBase(0, 0, fieldOff);
            return;
        }
        if (obj.kind == 6) {
            string varType = this.getLocalType(obj.name);
            if (!this.strEq(varType, "")) {
                this.genExpr(obj);
                string elemType = this.arrayElementType(varType);
                string lookupType = varType;
                if (!this.strEq(elemType, "")) { lookupType = elemType; }
                int fieldOff = this.findFieldOffset(lookupType, fieldName);
                if (fieldOff < 0) {
                    // A self-hosted compiler can temporarily lose the class
                    // type table while rebuilding it.  If the member name is
                    // unique across the known layouts, its slot is still
                    // unambiguous and the fallback keeps object reads typed.
                    fieldOff = this.findFieldOffsetInAllClasses(fieldName);
                }
                if (fieldOff >= 0) {
                    this.asm.movRMBase(0, 0, fieldOff);
                }
                return;
            }
        }
        if (obj.kind == 24) {
            Node arrNode = obj.child(0);
            string arrType = this.inferExprType(arrNode);
            this.genArrayIndex(obj);
            string elemType = this.inferExprType(obj);
            if (this.strEq(elemType, "")) { elemType = this.arrayElementType(arrType); }
            if (!this.strEq(elemType, "")) {
                int fieldOff = this.findFieldOffset(elemType, fieldName);
                if (fieldOff >= 0) {
                    this.asm.movRMBase(0, 0, fieldOff);
                }
            }
            return;
        }
        if (obj.kind == 13) {
            this.genMemberAccess(obj);
            string objType = this.inferMemberAccessType(obj);
            int fieldOff = this.findFieldOffset(objType, fieldName);
            if (fieldOff < 0) {
                fieldOff = this.findFieldOffsetInAllClasses(fieldName);
            }
            if (fieldOff >= 0) {
                this.asm.movRMBase(0, 0, fieldOff);
            }
            return;
        }
        if (obj.kind == 10) {
            // Member access on a call result (e.g. this.advance().text):
            // evaluate the call, then load the field using the call's
            // inferred return type.  Falls back to a whole-program field
            // scan when the return type cannot be resolved.
            this.genExpr(obj);
            string retType = this.inferExprType(obj);
            int fieldOff = this.findFieldOffset(retType, fieldName);
            if (fieldOff < 0) {
                fieldOff = this.findFieldOffsetInAllClasses(fieldName);
            }
            if (fieldOff >= 0) {
                this.asm.movRMBase(0, 0, fieldOff);
            }
            return;
        }
        this.genExpr(obj);
    }

    public string inferExprType(Node expr) {
        if (expr.kind == 0) {
            return "int";
        }
        if (expr.kind == 2) {
            return "string";
        }
        if (expr.kind == 3) {
            return "char";
        }
        if (expr.kind == 4) {
            return "bool";
        }
        if (expr.kind == 66) {
            return "dict<string,int>";
        }
        if (expr.kind == 23) {
            if (expr.childCount() > 0) {
                return this.inferExprType(expr.child(0));
            }
            return "";
        }
        if (expr.kind == 67) {
            return this.inferExprType(expr.child(0));
        }
