        if (isFloat) {
            tok.intVal = 0;
        } else {
            // Parse the digit string manually.  The toInt64 / toInt64FromBase
            // builtin methods are not dispatched by every backend, so compute
            // the value directly with arithmetic that all stages support.
            int64 val = 0;
            for (int i = 0; i < s.length; i++) {
                char ch = s[i];
                int d = -1;
                if (ch >= '0' && ch <= '9') { d = ch - '0'; }
                elif (base == 16 && ch >= 'a' && ch <= 'f') { d = ch - 'a' + 10; }
                elif (base == 16 && ch >= 'A' && ch <= 'F') { d = ch - 'A' + 10; }
                if (d >= 0) { val = val * base + d; }
            }
            tok.intVal = val;
        }
        return tok;
    }

    private Token readIdent() {
        int ln = this.line; int cl = this.col;
        int firstCode = this.currentCode;
        this.advance();
        string s = "";
        if (firstCode == 97) { s = s + "a"; }
        elif (firstCode == 98) { s = s + "b"; }
        elif (firstCode == 99) { s = s + "c"; }
        elif (firstCode == 100) { s = s + "d"; }
        elif (firstCode == 101) { s = s + "e"; }
        elif (firstCode == 102) { s = s + "f"; }
        elif (firstCode == 103) { s = s + "g"; }
        elif (firstCode == 104) { s = s + "h"; }
        elif (firstCode == 105) { s = s + "i"; }
        elif (firstCode == 106) { s = s + "j"; }
        elif (firstCode == 107) { s = s + "k"; }
        elif (firstCode == 108) { s = s + "l"; }
        elif (firstCode == 109) { s = s + "m"; }
        elif (firstCode == 110) { s = s + "n"; }
        elif (firstCode == 111) { s = s + "o"; }
        elif (firstCode == 112) { s = s + "p"; }
        elif (firstCode == 113) { s = s + "q"; }
        elif (firstCode == 114) { s = s + "r"; }
        elif (firstCode == 115) { s = s + "s"; }
        elif (firstCode == 116) { s = s + "t"; }
        elif (firstCode == 117) { s = s + "u"; }
        elif (firstCode == 118) { s = s + "v"; }
        elif (firstCode == 119) { s = s + "w"; }
        elif (firstCode == 120) { s = s + "x"; }
        elif (firstCode == 121) { s = s + "y"; }
        elif (firstCode == 122) { s = s + "z"; }
        elif (firstCode == 65) { s = s + "A"; }
        elif (firstCode == 66) { s = s + "B"; }
        elif (firstCode == 67) { s = s + "C"; }
        elif (firstCode == 68) { s = s + "D"; }
        elif (firstCode == 69) { s = s + "E"; }
        elif (firstCode == 70) { s = s + "F"; }
        elif (firstCode == 71) { s = s + "G"; }
        elif (firstCode == 72) { s = s + "H"; }
        elif (firstCode == 73) { s = s + "I"; }
        elif (firstCode == 74) { s = s + "J"; }
        elif (firstCode == 75) { s = s + "K"; }
        elif (firstCode == 76) { s = s + "L"; }
        elif (firstCode == 77) { s = s + "M"; }
        elif (firstCode == 78) { s = s + "N"; }
        elif (firstCode == 79) { s = s + "O"; }
        elif (firstCode == 80) { s = s + "P"; }
        elif (firstCode == 81) { s = s + "Q"; }
        elif (firstCode == 82) { s = s + "R"; }
        elif (firstCode == 83) { s = s + "S"; }
        elif (firstCode == 84) { s = s + "T"; }
        elif (firstCode == 85) { s = s + "U"; }
        elif (firstCode == 86) { s = s + "V"; }
        elif (firstCode == 87) { s = s + "W"; }
        elif (firstCode == 88) { s = s + "X"; }
        elif (firstCode == 89) { s = s + "Y"; }
        elif (firstCode == 90) { s = s + "Z"; }
        elif (firstCode == 95) { s = s + "_"; }
        while (this.pos < this.srcLen) {
            char ch = this.src[this.pos];
            if (isAlphaNum(ch) || ch == '_') {
                s = s + ch; this.advance();
            } else { break; }
        }
        int kind = this.keywordKind(s);
        Token tok = new Token(kind, s, ln, cl);
        if (kind == 7) { tok.strVal = s; }
        return tok;
    }

    private int keywordKind(string s) {
        if (this.strEq(s, "if")) { return 10; }
        if (this.strEq(s, "else")) { return 11; }
        if (this.strEq(s, "while")) { return 12; }
        if (this.strEq(s, "for")) { return 13; }
        if (this.strEq(s, "foreach")) { return 14; }
        if (this.strEq(s, "return")) { return 15; }
        if (this.strEq(s, "match")) { return 16; }
        if (this.strEq(s, "void")) { return 17; }
        if (this.strEq(s, "int")) { return 18; }
