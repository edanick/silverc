        this.emitU8(lo >> 16);
        this.emitU8(lo >> 24);
        int hi = (imm >> 32) & 0xFFFFFFFF;
        this.emitU8(hi);
        this.emitU8(hi >> 8);
        this.emitU8(hi >> 16);
        this.emitU8(hi >> 24);
