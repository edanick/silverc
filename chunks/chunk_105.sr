        if (this.check(123)) { this.advance(); vt = vt + "?"; }
        v.typeHint = vt;
        v.name = this.advance().text;
        n.children.add(v);
        this.expect(54);
        n.children.add(this.parseExpr(0));
        this.expect(101);
        n.children.add(this.parseBlock());
        return n;
    }

    private Token peek() {
        if (this.pos < this.tokens.length) {
            return this.tokens[this.pos];
        }
        return this.tokens[this.tokens.length - 1];
    }

    private Token advance() {
        // Guard against running past the EOF sentinel (e.g. an unterminated
        // paren/brace/bracket at end of file): reading tokens[this.pos] beyond
        // the array would be an out-of-bounds access.
        if (this.pos >= this.tokens.length) {
            Token eof = this.tokens[this.tokens.length - 1];
            printline("Parse error at line " + eof.line.toString() + ", column " + eof.col.toString() + ": unexpected end of file");
            exit(1);
            return eof;
        }
        Token t = this.tokens[this.pos];
        this.pos = this.pos + 1;
        return t;
    }

    private bool check(int kind) {
        Token t = this.peek();
        return t.kind == kind;
    }

    private Token expect(int kind) {
        if (this.check(kind)) {
            return this.advance();
        }
        Token tok = this.peek();
        printline("Parse error at line " + tok.line.toString() + ", column " + tok.col.toString() + ": expected " + this.kindName(kind) + " but found " + this.tokenText(tok));
        exit(1);
        return this.peek();
    }

    private string kindName(int kind) {
        if (kind == 0) { return "end of file"; }
        if (kind == 1) { return "number"; }
        if (kind == 3) { return "string"; }
        if (kind == 4) { return "character"; }
        if (kind == 5) { return "boolean"; }
        if (kind == 6) { return "null"; }
        if (kind == 7) { return "identifier"; }
        if (kind == 10) { return "if"; }
        if (kind == 11) { return "else"; }
        if (kind == 12) { return "while"; }
        if (kind == 13) { return "for"; }
        if (kind == 14) { return "foreach"; }
        if (kind == 15) { return "return"; }
        if (kind == 16) { return "match"; }
        if (kind == 17) { return "void"; }
        if (kind == 18) { return "int"; }
        if (kind == 19) { return "int32"; }
        if (kind == 20) { return "int64"; }
        if (kind == 22) { return "float"; }
        if (kind == 23) { return "float64"; }
        if (kind == 25) { return "bool"; }
        if (kind == 26) { return "char"; }
        if (kind == 27) { return "string"; }
        if (kind == 28) { return "var"; }
        if (kind == 29) { return "struct"; }
        if (kind == 30) { return "class"; }
        if (kind == 31) { return "enum"; }
        if (kind == 32) { return "def"; }
        if (kind == 33) { return "found"; }
        if (kind == 34) { return "collect"; }
        if (kind == 35) { return "mod"; }
        if (kind == 36) { return "import"; }
        if (kind == 37) { return "from"; }
        if (kind == 38) { return "as"; }
        if (kind == 39) { return "new"; }
        if (kind == 40) { return "const"; }
        if (kind == 44) { return "public"; }
        if (kind == 45) { return "private"; }
        if (kind == 46) { return "static"; }
        if (kind == 47) { return "prop"; }
        if (kind == 48) { return "construct"; }
        if (kind == 49) { return "unset"; }
        if (kind == 50) { return "mut"; }
        if (kind == 51) { return "ref"; }
        if (kind == 52) { return "try"; }
        if (kind == 53) { return "catch"; }
        if (kind == 54) { return "in"; }
        if (kind == 55) { return "to"; }
        if (kind == 56) { return "elif"; }
        if (kind == 57) { return "break"; }
        if (kind == 58) { return "continue"; }
