        // ReadFile(stdin, buf, 4096, &read, 0)
        this.asm.emitCallSetup(8);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRMBase(1, 5, hstdinOff);
        this.asm.movRMBase(2, 5, bufOff);
        this.asm.movRMBase(8, 5, sizeOff);
        this.asm.leaRBase(9, 5, breadOff);
        this.addImportPatch("kernel32.dll", "ReadFile");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        // Null-terminate the buffer at the bytes-read position
        this.asm.movRMBase(0, 5, bufOff);
        this.asm.movRMBase(1, 5, breadOff);
        this.asm.addRR64(0, 1);
        this.asm.movRI64(1, 0);
        this.asm.movMBaseByteR(0, 1, 0);

        // Return buffer pointer in RAX
        this.asm.movRMBase(0, 5, bufOff);
    }

    public void emitLlmaiStringLiteral(string s) {
        int strIdx = this.addString(s);
        int sp = this.asm.buf.length;
        this.asm.emitImm64(0, 0);
        int strPatchPos = sp + 2;
        this.stringPatchOffsets.add(strPatchPos);
        this.stringPatchIndices.add(strIdx);
    }

    public void emitLlmaiHeapAlloc(int sizeOff) {
        // RAX = HeapAlloc(GetProcessHeap(), 0, [sizeOff])
        this.asm.emitCallSetup(0);
        this.addImportPatch("kernel32.dll", "GetProcessHeap");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.emitCallSetup(0);
        this.asm.movRR64(1, 0);
        this.asm.xorRR64(2, 2);
        this.asm.movRMBase(8, 5, sizeOff);
        this.addImportPatch("kernel32.dll", "HeapAlloc");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }

    public void emitLlmaiEmptyString() {
        int emptySize = this.allocLocal("__llmai_empty_size");
        this.asm.movRI64(0, 1);
        this.asm.movMBaseR(5, 0, emptySize);
        this.emitLlmaiHeapAlloc(emptySize);
        this.asm.movRI64(1, 0);
        this.asm.movMBaseByteR(0, 1, 0);
    }

    public void emitLlmaiMemcpy(int dstOff, int srcOff, int lenOff, int idxOff) {
        // for idx in 0..len: dst[idx] = src[idx]
        int cpLoop = this.newLabel();
        int cpEnd = this.newLabel();
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, idxOff);
        this.asm.bindLabel(cpLoop);
        this.asm.movRMBase(0, 5, idxOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(cpEnd);
        // byte = src[idx]
        this.asm.movRMBase(0, 5, srcOff);
        this.asm.movRMBase(1, 5, idxOff);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(2, 0, 0);
        // dst[idx] = byte  (movByteMBaseIdxR encodes [base + index])
        this.asm.movRMBase(0, 5, dstOff);
        this.asm.movRMBase(1, 5, idxOff);
        this.asm.movByteMBaseIdxR(0, 1, 2);
        this.asm.movRMBase(0, 5, idxOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, idxOff);
        this.asm.jmpLabel(cpLoop);
        this.asm.bindLabel(cpEnd);
    }

    // llmai.chat(url, headers, body) -> raw HTTP response body string.
    // Emits a WinInet POST (ANSI versions, no UTF-16 conversion needed) with
    // the URL parsed at runtime: host/port/path are extracted from `url`.
    public void genLlmaiChatCall(Node call) {
        if (call.childCount() < 4) {
            this.emitLlmaiEmptyString();
            return;
        }
        this.genExpr(call.child(1));
        int urlOff = this.allocLocal("__llmai_url");
        this.asm.movMBaseR(5, 0, urlOff);
