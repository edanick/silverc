    public void bindLabel(int id) {
        this.labelPositions[id] = this.buf.length;
    }

    public int getLabelOffset(int id) {
        if (id < this.labelPositions.length && this.labelPositions[id] >= 0) {
            return this.labelPositions[id];
        }
        return 0;
    }

    public void addReloc(int labelId, int offset, int is32) {
