        node.name = this.advance().text;
        this.expect(102);
        while (!this.check(103) && !this.check(0)) {
            Node field = new Node();
            field.typeHint = this.advance().text;
            string fn = this.advance().text;
            field.name = fn;
            field.kind = 0;
            node.children.add(field);
            this.expect(106);
        }
        this.expect(103);
        return node;
    }

    private Node parseClass() {
        Node node = new Node();
        node.kind = 102;
        this.expect(30);
        node.name = this.advance().text;
        if (this.check(109) || this.check(60)) {
            this.advance();
            node.parentClass = this.advance().text;
        }
        this.expect(102);
        while (!this.check(103) && !this.check(0)) {
            Node member = this.parseClassMember();
            if (member != null) { node.children.add(member); }
        }
        this.expect(103);
        return node;
    }

    private Node? parseEnum() {
        this.expect(31);
