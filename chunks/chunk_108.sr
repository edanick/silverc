            value = value + 1;
            if (this.check(107)) { this.advance(); }
        }
        this.expect(103);
        return node;
    }

    private Node? parseClassMember() {
        if (this.check(44) || this.check(45)) { this.advance(); }
        if (this.check(46)) { this.advance(); }
        if (this.check(48)) {
            Node ctor = new Node();
            ctor.kind = 100;
            ctor.name = "construct";
            this.advance();
            this.expect(100);
            Node params = new Node();
            while (!this.check(101) && !this.check(0)) {
                Node param = new Node();
                string cpt = this.advance().text;
                if (this.check(120)) {
                    while (!this.check(121) && !this.check(106) && !this.check(103)) {
                        cpt = cpt + this.advance().text;
                    }
                    if (this.check(121)) { cpt = cpt + ">"; this.advance(); }
                }
                if (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } cpt = cpt + "[]"; }
                if (this.check(123)) { this.advance(); cpt = cpt + "?"; }
                param.typeHint = cpt;
                param.name = this.advance().text;
                if (this.check(110)) {
                    this.advance();
                    param.children.add(this.parseExpr(0));
                }
                params.children.add(param);
                if (this.check(107)) { this.advance(); }
            }
            this.expect(101);
            ctor.children.add(params);
            ctor.children.add(this.parseBlock());
            return ctor;
        }
        if (this.check(47)) {
            this.advance();
            Node field = new Node();
            field.kind = 50;
            string ft = this.advance().text;
            if (this.check(120)) {
                while (!this.check(121) && !this.check(106) && !this.check(103)) {
                    ft = ft + this.advance().text;
                }
                if (this.check(121)) { ft = ft + ">"; this.advance(); }
            }
            if (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } ft = ft + "[]"; }
