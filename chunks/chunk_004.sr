    Token[] tokens;
    tokens = lexer.tokenize();

    Parser parser;
    parser = new Parser(tokens);

    Node[] ast;
    ast = parser.parseProgram();

    MiniAsm asm;
    asm = new MiniAsm();

    MiniCg cg;
    cg = new MiniCg(asm);

    cg.genProgram(ast);

    cg.getStringData();

    MiniPe pe;
    pe = new MiniPe();

    int entryOff = cg.mainLabelOffset;
    if (cg.globalNames.length > 0) { entryOff = cg.entryOffset; }
    pe.entryRva = 0x1000 + entryOff;

    for (int i = 0; i < cg.importDlls.length; i++) {
        pe.addImport(cg.importDlls[i], cg.importFuncs[i]);
    }

    int[] stringData = cg.stringData;

    int[] finalCode = asm.getBytes();
    pe.code = finalCode;

        int rdataRva = pe.computeRdataRva();
        int[] layout = pe.computeLayout(stringData.length);
        int stringsStart = layout[0];
        int[] iatAddrs = cg.computeIatAddresses(layout);

    cg.patchForwardCalls(finalCode);

    cg.patchStringRefs(finalCode, stringsStart, rdataRva);
    cg.patchImportRefs(finalCode, iatAddrs, rdataRva);
    cg.patchGlobalRefs(finalCode, stringsStart + stringData.length, rdataRva);

    string[] viKeys = [];
    string[] viValues = [];
    if (inputIsProject) {
        string manifest2 = file.readString(inputFile);
        string viName = projectManifestValue(manifest2, "name");
        string viVers = projectManifestValue(manifest2, "version");
        string viDesc = projectManifestValue(manifest2, "description");
        string viProd = projectManifestValue(manifest2, "product");
        string viCopy = projectManifestValue(manifest2, "copyright");
        string viComp = projectManifestValue(manifest2, "company");
        if (viName != "")   { viKeys.add("FileDescription");  viValues.add(viName); }
        if (viProd != "")  { viKeys.add("ProductName");      viValues.add(viProd); }
        if (viCopy != "")  { viKeys.add("LegalCopyright");   viValues.add(viCopy); }
        if (viComp != "")  { viKeys.add("CompanyName");      viValues.add(viComp); }
        if (viName != "")  { viKeys.add("InternalName");     viValues.add(viName); }
        if (viName != "")  { viKeys.add("OriginalFilename"); viValues.add(viName + ".exe"); }
        if (viVers != "")  { viKeys.add("FileVersion");      viValues.add(viVers); }
        if (viVers != "")  { viKeys.add("ProductVersion");   viValues.add(viVers); }
    }
    string[] versionData = [];
    for (int vi = 0; vi < viKeys.length; vi++) {
        versionData.add(viKeys[vi]);
        versionData.add(viValues[vi]);
    }

    pe.globalAreaSize = cg.globalAreaSize;
    int[] peData = pe.build(finalCode, stringData, versionData);
    file.writeBytes(outputFile, peData);
    }
}

class MiniAsm {
    public prop int[] buf;
    public prop int[] labelPositions;
    public prop int[] relocLabelIds;
    public prop int[] relocOffsets;
    public prop int[] relocIs32;
    public prop int resolved;

    construct () {
        this.buf = [];
        this.labelPositions = [];
        this.relocLabelIds = [];
        this.relocOffsets = [];
        this.relocIs32 = [];
        this.resolved = 0;
    }

    public void emitU8(int b) {
        this.buf.add(b & 0xFF);
    }

    public void emitU16(int v) {
        this.emitU8(v);
