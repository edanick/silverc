        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, lenOff);

        int trimLoop = this.newLabel();
        int trimDone = this.newLabel();
        int trimKeep = this.newLabel();
        this.asm.bindLabel(trimLoop);
        this.asm.movRMBase(0, 5, lenOff);
        this.asm.cmpRI32(0, 0);
        this.asm.jleLabel(trimDone);
        this.asm.subRI32(0, 1);
        this.asm.movRMBase(1, 5, srcOff);
        this.asm.addRR64(1, 0);
        this.asm.movzxByteMBase(2, 1, 0);
        this.asm.cmpRI32(2, 32);
        this.asm.jeLabel(trimKeep);
        this.asm.cmpRI32(2, 9);
        this.asm.jeLabel(trimKeep);
        this.asm.cmpRI32(2, 10);
        this.asm.jeLabel(trimKeep);
        this.asm.cmpRI32(2, 13);
        this.asm.jneLabel(trimDone);
        this.asm.bindLabel(trimKeep);
        this.asm.movMBaseR(5, 0, lenOff);
        this.asm.jmpLabel(trimLoop);
        this.asm.bindLabel(trimDone);

        this.asm.movRMBase(1, 5, lenOff);
        this.asm.addRI32(1, 1);
        this.addImportPatch("msvcrt.dll", "malloc");
        int sTrimAlloc = 0xDEADBEEFCAFEBAD9;
        this.asm.emitImm64(0, sTrimAlloc);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, outOff);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, iOff);
        int copyLoop = this.newLabel();
        int copyDone = this.newLabel();
        this.asm.bindLabel(copyLoop);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.cmpRR64(0, 1);
        this.asm.jgeLabel(copyDone);
        this.asm.movRMBase(1, 5, srcOff);
        this.asm.addRR64(1, 0);
        this.asm.movzxByteMBase(2, 1, 0);
        this.asm.movRMBase(1, 5, outOff);
        this.asm.addRR64(1, 0);
        this.asm.movMBaseByteR(1, 2, 0);
        this.asm.movRMBase(0, 5, iOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, iOff);
        this.asm.jmpLabel(copyLoop);
        this.asm.bindLabel(copyDone);
        this.asm.movRMBase(0, 5, outOff);
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.addRR64(0, 1);
        this.asm.xorRR64(2, 2);
        this.asm.movMBaseByteR(0, 2, 0);
        this.asm.movRMBase(0, 5, outOff);
    }

    // mode: 0 = trim end, 1 = trim start, 2 = trim both.
    // hasSet: 0 = whitespace, 1 = use setNode as the set of trim characters.
    public void genTrimCore(Node recv, Node setNode, int hasSet, int mode) {
        int srcOff = this.allocLocal("__trim_src");
        int lenOff = this.allocLocal("__trim_len");
        int setOff = this.allocLocal("__trim_set");
        int startOff = this.allocLocal("__trim_start");
        int endOff = this.allocLocal("__trim_end");
        int iOff = this.allocLocal("__trim_i");
        int outOff = this.allocLocal("__trim_out");

        this.genExpr(recv);
        this.asm.movMBaseR(5, 0, srcOff);
        if (hasSet == 1) {
            this.genExpr(setNode);
            this.asm.movMBaseR(5, 0, setOff);
        }

        // len = strlen(src)
        this.asm.movRMBase(1, 5, srcOff);
        this.addImportPatch("ucrtbase.dll", "strlen");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD8);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        this.asm.movMBaseR(5, 0, lenOff);

        // start = 0, end = len
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(5, 0, startOff);
        this.asm.movRMBase(0, 5, lenOff);
        this.asm.movMBaseR(5, 0, endOff);
