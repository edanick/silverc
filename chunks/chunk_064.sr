
        if (mode == 1 || mode == 2) {
            int sLoop = this.newLabel();
            int sDone = this.newLabel();
            int sSkip = this.newLabel();
            this.asm.bindLabel(sLoop);
            this.asm.movRMBase(0, 5, startOff);
            this.asm.movRMBase(1, 5, endOff);
            this.asm.cmpRR64(0, 1);
            this.asm.jgeLabel(sDone);
            this.asm.movRMBase(1, 5, srcOff);
            this.asm.movRMBase(0, 5, startOff);
            this.asm.addRR64(1, 0);
            this.asm.movzxByteMBase(2, 1, 0);
            if (hasSet == 1) {
                this.asm.movRMBase(1, 5, setOff);
                this.addImportPatch("ucrtbase.dll", "strchr");
                this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB1);
                this.asm.movRMBase(0, 0, 0);
                this.asm.emitCallSetup(0);
                this.asm.callR64(0);
                this.asm.emitCallTeardown();
                this.asm.cmpRI32(0, 0);
                this.asm.jneLabel(sSkip);
                this.asm.jmpLabel(sDone);
            } else {
                this.asm.cmpRI32(2, 32);
                this.asm.jeLabel(sSkip);
                this.asm.cmpRI32(2, 9);
                this.asm.jeLabel(sSkip);
                this.asm.cmpRI32(2, 10);
                this.asm.jeLabel(sSkip);
                this.asm.cmpRI32(2, 13);
                this.asm.jneLabel(sDone);
            }
            this.asm.bindLabel(sSkip);
            this.asm.movRMBase(0, 5, startOff);
            this.asm.addRI32(0, 1);
            this.asm.movMBaseR(5, 0, startOff);
            this.asm.jmpLabel(sLoop);
            this.asm.bindLabel(sDone);
        }

        if (mode == 0 || mode == 2) {
            int eLoop = this.newLabel();
            int eDone = this.newLabel();
            int eSkip = this.newLabel();
            this.asm.bindLabel(eLoop);
            this.asm.movRMBase(0, 5, endOff);
            this.asm.movRMBase(1, 5, startOff);
            this.asm.cmpRR64(0, 1);
            this.asm.jleLabel(eDone);
            this.asm.movRMBase(1, 5, srcOff);
            this.asm.movRMBase(0, 5, endOff);
            this.asm.subRI32(0, 1);
            this.asm.addRR64(1, 0);
            this.asm.movzxByteMBase(2, 1, 0);
            if (hasSet == 1) {
                this.asm.movRMBase(1, 5, setOff);
                this.addImportPatch("ucrtbase.dll", "strchr");
                this.asm.emitImm64(0, 0xDEADBEEFCAFEBAB1);
                this.asm.movRMBase(0, 0, 0);
                this.asm.emitCallSetup(0);
                this.asm.callR64(0);
                this.asm.emitCallTeardown();
                this.asm.cmpRI32(0, 0);
                this.asm.jneLabel(eSkip);
                this.asm.jmpLabel(eDone);
            } else {
                this.asm.cmpRI32(2, 32);
                this.asm.jeLabel(eSkip);
                this.asm.cmpRI32(2, 9);
                this.asm.jeLabel(eSkip);
                this.asm.cmpRI32(2, 10);
                this.asm.jeLabel(eSkip);
                this.asm.cmpRI32(2, 13);
                this.asm.jneLabel(eDone);
            }
            this.asm.bindLabel(eSkip);
            this.asm.movRMBase(0, 5, endOff);
            this.asm.subRI32(0, 1);
            this.asm.movMBaseR(5, 0, endOff);
            this.asm.jmpLabel(eLoop);
            this.asm.bindLabel(eDone);
        }

        // newLen = end - start
        this.asm.movRMBase(0, 5, endOff);
        this.asm.movRMBase(1, 5, startOff);
        this.asm.subRR64(0, 1);
        this.asm.movMBaseR(5, 0, lenOff);

        // out = malloc(newLen + 1)
        this.asm.movRMBase(1, 5, lenOff);
        this.asm.addRI32(1, 1);
        this.addImportPatch("msvcrt.dll", "malloc");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD9);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
