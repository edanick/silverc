            Node rhs = this.parseExpr(nextMin);
            Node bin = new Node(); bin.kind = 7;
            bin.op = this.tokenToOp(op);
            bin.children.add(lhs);
            bin.children.add(rhs);
            lhs = bin;
        }
        return lhs;
    }

    private int tokenToOp(int kind) {
        if (kind == 111) { return 1; }
        if (kind == 112) { return 2; }
        if (kind == 113) { return 3; }
        if (kind == 114) { return 4; }
        if (kind == 115) { return 13; }
        if (kind == 134) { return 5; }
        if (kind == 135) { return 6; }
        if (kind == 120) { return 7; }
        if (kind == 136) { return 8; }
        if (kind == 121) { return 9; }
        if (kind == 137) { return 10; }
        if (kind == 138) { return 11; }
        if (kind == 139) { return 12; }
        if (kind == 110) { return 20; }
        if (kind == 130) { return 14; }
        if (kind == 131) { return 15; }
        if (kind == 132) { return 16; }
        if (kind == 133) { return 17; }
        if (kind == 140) { return 18; }
        if (kind == 141) { return 19; }
        if (kind == 144) { return 20; }
        if (kind == 148) { return 25; }
        if (kind == 116) { return 22; }
        if (kind == 117) { return 23; }
        if (kind == 118) { return 24; }
        return 0;
    }

    private int getPrec(int kind) {
        if (kind == 110 || kind == 130 || kind == 131 || kind == 132 || kind == 133 || kind == 148) { return 1; }
        if (kind == 139) { return 2; }
        if (kind == 138) { return 3; }
        if (kind == 135 || kind == 134) { return 4; }
        if (kind == 120 || kind == 136 || kind == 121 || kind == 137) { return 5; }
        if (kind == 117) { return 6; }
        if (kind == 116) { return 7; }
        if (kind == 118) { return 7; }
        if (kind == 140 || kind == 141) { return 8; }
        if (kind == 111 || kind == 112) { return 9; }
        if (kind == 113 || kind == 114 || kind == 115) { return 10; }
        if (kind == 144) { return 11; }
        return -1;
    }

    private Node parsePrefix() {
        Token t = this.advance();
        Node n = new Node();
        n.line = t.line; n.col = t.col;
        int kind = t.kind;

        if (kind == 1) { n.kind = 0; n.intVal = t.intVal; return n; }
        if (kind == 2) { n.kind = 1; n.floatVal = t.floatVal; return n; }
        if (kind == 3) { n.kind = 2; n.strVal = t.strVal; return n; }
        if (kind == 4) { n.kind = 3; n.charVal = t.charVal; return n; }
        if (kind == 5) {
            n.kind = 4;
            n.boolVal = this.strEq(t.text, "true");
            return n;
        }
        if (kind == 6) { n.kind = 5; return n; }
        if (kind == 7) { n.kind = 6; n.name = t.text; return n; }        if (kind == 39) {
            Node ctor = new Node();
            ctor.kind = 10;
            ctor.name = this.advance().text;
            if (this.check(104)) {
                // new T[n]: native array allocation.  A zero/omitted size
                // produces an empty array; a positive constant size produces
                // that many zeroed slots.
                this.advance();
                Node sizeExpr = this.parseExpr(0);
                this.expect(105);
                Node arr = new Node(); arr.kind = 19;
                if (sizeExpr.kind == 0) {
                    arr.op = 1;
                    arr.intVal = sizeExpr.intVal;
                }
                if (sizeExpr.kind == 0 && sizeExpr.intVal > 0 && sizeExpr.intVal <= 256) {
                    for (int zi = 0; zi < sizeExpr.intVal; zi++) {
                        Node zero = new Node(); zero.kind = 0; zero.intVal = 0;
                        arr.children.add(zero);
                    }
                }
                return arr;
            }
            this.expect(100);
            while (!this.check(101) && !this.check(0)) {
                ctor.children.add(this.parseExpr(0));
                if (this.check(107)) { this.advance(); }
            }
