            if (this.check(123)) { this.advance(); ft = ft + "?"; }
            field.typeHint = ft;
            field.name = this.advance().text;
            this.expect(106);
            return field;
        }
        if (this.check(28) || this.check(18) || this.check(19) || this.check(20) || this.check(25) || this.check(27) || this.check(22) || this.check(23) || this.check(26) || this.check(7)) {
            int savedPos = this.pos;
            string ft = this.advance().text;
            if (this.check(120)) {
                while (!this.check(121) && !this.check(106) && !this.check(103)) {
                    ft = ft + this.advance().text;
                }
                if (this.check(121)) { ft = ft + ">"; this.advance(); }
            }
            if (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } ft = ft + "[]"; }
            if (this.check(123)) { this.advance(); ft = ft + "?"; }
            if (this.check(7) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == 106) {
                Node field = new Node();
                field.kind = 50;
                field.typeHint = ft;
                field.name = this.advance().text;
                this.expect(106);
                return field;
            }
            // Legacy class sources (cd_test_classes.sr) omit the trailing
            // semicolon on fields.  Accept `Type name` followed by another
            // type/field or the closing brace as a field declaration.
            if (this.check(7) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind != 100 && this.tokens[this.pos + 1].kind != 102) {
                Node field = new Node();
                field.kind = 50;
                field.typeHint = ft;
                field.name = this.advance().text;
                if (this.check(106)) { this.advance(); }
                return field;
            }
            this.pos = savedPos;
        }
        return this.parseFunction();
    }

    private Node parseFunction() {
        Node node = new Node();
        node.kind = 100;
        if (this.check(44) || this.check(45) || this.check(46)) { this.advance(); }
        string retType = this.advance().text;
        if (this.check(120)) {
            while (!this.check(121) && !this.check(106) && !this.check(103)) {
                retType = retType + this.advance().text;
            }
            if (this.check(121)) { retType = retType + ">"; this.advance(); }
        }
        if (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } retType = retType + "[]"; }
        if (this.check(123)) { this.advance(); retType = retType + "?"; }
        node.typeHint = retType;
        node.name = this.advance().text;
        this.expect(100);
        Node params = new Node();
        while (!this.check(101) && !this.check(0)) {
            Node param = new Node();
            string pt = this.advance().text;
            if (this.check(120)) {
                while (!this.check(121) && !this.check(106) && !this.check(103)) {
                    pt = pt + this.advance().text;
                }
                if (this.check(121)) { pt = pt + ">"; this.advance(); }
            }
            if (this.check(104)) { this.advance(); if (this.check(105)) { this.advance(); } pt = pt + "[]"; }
            if (this.check(123)) { this.advance(); pt = pt + "?"; }
            param.typeHint = pt;
            param.name = this.advance().text;
            if (this.check(110)) {
                this.advance();
                param.children.add(this.parseExpr(0));
            }
            params.children.add(param);
            if (this.check(107)) { this.advance(); }
        }
        this.expect(101);
        node.children.add(params);
        if (this.check(141)) {
            this.advance();
            node.children.add(this.parseExpr(0));
        } else {
            node.children.add(this.parseBlock());
        }
        return node;
    }

    private Node parseBlock() {
        Node block = new Node();
        block.kind = 16;
        this.expect(102);
        while (!this.check(103) && !this.check(0)) {
            block.children.add(this.parseStmt());
        }
        this.expect(103);
        return block;
    }

