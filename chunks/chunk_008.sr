        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void shlR64Imm(int reg, int imm) {
        // reg is encoded in the ModRM.rm field, so reg 8-15 needs REX.B (bit 0).
        // (REX.R would be wrong here; that extends the /4 opcode-extension field.)
        int rFlag = 0;
        if (reg > 7) { rFlag = 1; }
        this.emitU8(0x48 | rFlag);
        this.emitU8(0xC1);
        this.emitU8(0xE0 | (reg & 7));
        this.emitU8(imm & 0xFF);
    }

    public void movByteMBaseIdxR(int base, int index, int src) {
        int rb = 0;
        int ri = 0;
        int rs = 0;
        if (base > 7) { rb = 1; }
        if (index > 7) { ri = 1; }
        if (src > 7) { rs = 1; }
        int rex = 0x40 | (rs << 2) | (ri << 1) | rb;
        this.emitU8(rex);
        this.emitU8(0x88);
        if (base == 5 || base == 13) {
            this.emitU8(0x44 | ((src & 7) << 3));
            this.emitU8(((index & 7) << 3) | (base & 7));
            this.emitU8(0);
        } else {
            this.emitU8(0x04 | ((src & 7) << 3));
            this.emitU8(((index & 7) << 3) | (base & 7));
        }
    }

    public void movRImm32(int dst, int imm) {
        if (dst > 7) { this.emitU8(0x41); }
        this.emitU8(0xB8 + (dst & 7));
        this.emitU32(imm);
    }

    public void movRMBaseDisp8(int r, int base, int disp) {
        int rex = 0x48;
        if (r > 7) { rex = rex | 0x04; }
        if (base > 7) { rex = rex | 0x01; }
        this.emitU8(rex);
        this.emitU8(0x8B);
        this.emitU8(0x40 | ((r & 7) << 3) | (base & 7));
        this.emitU8(disp & 0xFF);
    }

    public void orRR64(int dst, int src) {
        int rFlag = 0;
        int sFlag = 0;
        if (src > 7) { rFlag = 1; }
        if (dst > 7) { sFlag = 1; }
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x09);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void andRR64(int dst, int src) {
        int rFlag = 0;
        int sFlag = 0;
        if (src > 7) { rFlag = 1; }
        if (dst > 7) { sFlag = 1; }
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x21);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void imulRR64(int dst, int src) {
        int rFlag = 0;
        int sFlag = 0;
        if (src > 7) { rFlag = 1; }
        if (dst > 7) { sFlag = 1; }
        this.emitU8(0x48 | (rFlag << 2) | sFlag);
        this.emitU8(0x0F);
        this.emitU8(0xAF);
        this.emitU8(0xC0 | ((src & 7) << 3) | (dst & 7));
    }

    public void syscall() {
        this.emitU8(0x0F);
        this.emitU8(0x05);
    }

    public void cdq() {
        this.emitU8(0x99);
    }

    public void cqo() {
        this.emitU8(0x48);
        this.emitU8(0x99);
    }

    public void idivR64(int r) {
        if (r > 7) { this.emitU8(0x49); } else { this.emitU8(0x48); }
        this.emitU8(0xF7);
        this.emitU8(0xF8 | (r & 7));
    }
