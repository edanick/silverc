            if (arg[0] == '-') {
                if (arg[1] == 'h') {
                    if (arg[2] == 'e') {
                        if (arg[3] == 'l') {
                            if (arg[4] == 'p') {
                                showHelp = true;
                                isOption = true;
                            }
                        }
                    }
                }
            }
        }
        if (arg.length == 6) {
            if (arg[0] == '-') {
                if (arg[1] == '-') {
                    if (arg[2] == 'h') {
                        if (arg[3] == 'e') {
                            if (arg[4] == 'l') {
                                if (arg[5] == 'p') {
                                    showHelp = true;
                                    isOption = true;
                                }
                            }
                        }
                    }
                }
            }
        }
        if (arg.length == 9) {
            if (arg[0] == '-') {
                if (arg[1] == '-') {
                    if (arg[2] == 'v') {
                        if (arg[3] == 'e') {
                            if (arg[4] == 'r') {
                                if (arg[5] == 's') {
                                    if (arg[6] == 'i') {
                                        if (arg[7] == 'o') {
                                            if (arg[8] == 'n') {
                                                showVersion = true;
                                                isOption = true;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if (isOption == false) {
            if (inputSet == false) {
                inputFile = arg;
                inputSet = true;
            } else {
                if (outputSet == false) {
                    outputFile = arg;
                    outputSet = true;
                }
            }
        }
        argIdx = argIdx + 1;
    }

    bool skipCompile = false;
    if (showVersion) {
        printline("Silver Compiler v0.4.0");
        printline("Language: Silver");
        printline("Version:  0.4.0");
        printline("Copyright: © 2025 Edan M.");
        printline("Run with --help for usage information.");
        skipCompile = true;
    }

    if (args.length <= 1) {
        printHelp();
        skipCompile = true;
    } elif (showHelp) {
        printHelp();
        skipCompile = true;
    }

    if (inputFile == "") {
        inputFile = "compiler_driver.sr";
    }
    if (outputFile == "") {
        outputFile = "silverc";
    }

    // Compute the exact project suffix once. Keeping this decision in one
    // boolean avoids duplicated string-index lowering in self-generated stages.
    bool inputIsProject = false;
    string projectType = "";
    if (!skipCompile) {
        inputIsProject = projectHasSuffix(inputFile, ".srp");
        if (inputIsProject) {
            string manifest = file.readString(inputFile);
            projectType = projectManifestValue(manifest, "type");
