            this.asm.xorRR64(1, 1);
            this.asm.movMBaseByteR(0, 1, 0);
            this.asm.movRMBase(0, 5, dstOff);
        } else {
            // Array slice: allocSize = (len + 2) * 8; header [capacity, length].
            this.asm.movRMBase(0, 5, lenOff);
            this.asm.addRI32(0, 2);
            this.asm.shlR64Imm(0, 3);
            this.asm.movRR64(1, 0);
            this.addImportPatch("msvcrt.dll", "malloc");
            int sSlAlloc2 = 0xDEADBEEFCAFEBAC2;
            this.asm.emitImm64(0, sSlAlloc2);
            this.asm.movRMBase(0, 0, 0);
            this.asm.emitCallSetup(0);
            this.asm.callR64(0);
            this.asm.emitCallTeardown();
            this.asm.movMBaseR(5, 0, dstOff);
            this.asm.movRMBase(0, 5, dstOff);
            this.asm.movRMBase(1, 5, lenOff);
            this.asm.movMBaseR(0, 1, 0);
            this.asm.movRMBase(0, 5, dstOff);
            this.asm.movRMBase(1, 5, lenOff);
            this.asm.movMBaseR(0, 1, 8);
            int iOff2 = this.allocLocal("__sl_i2");
            this.asm.xorRR64(0, 0);
            this.asm.movMBaseR(5, 0, iOff2);
            int slLoop2 = this.newLabel();
            int slDone2 = this.newLabel();
            this.asm.bindLabel(slLoop2);
            this.asm.movRMBase(0, 5, iOff2);
            this.asm.movRMBase(8, 5, lenOff);
            this.asm.cmpRR64(0, 8);
            this.asm.jgeLabel(slDone2);
            // src element index = (start + i) * esize
            this.asm.movRMBase(10, 5, startOff);
            this.asm.movRMBase(11, 5, iOff2);
            this.asm.addRR64(10, 11);
            if (!isByteArr) { this.asm.shlR64Imm(10, 3); }
            this.asm.movRMBase(11, 5, baseOff);
            this.asm.addRR64(11, 10);
            // dst element index = dst + 16 + i * esize
            this.asm.movRMBase(9, 5, dstOff);
            this.asm.addRI32(9, 16);
            this.asm.movRMBase(8, 5, iOff2);
            if (!isByteArr) { this.asm.shlR64Imm(8, 3); }
            this.asm.addRR64(9, 8);
            if (isByteArr) {
                this.asm.movzxByteMBase(10, 11, 0);
                this.asm.movMBaseByteR(9, 10, 0);
            } else {
                this.asm.movRMBase(10, 11, 0);
                this.asm.movMBaseR(9, 10, 0);
            }
            this.asm.movRMBase(0, 5, iOff2);
            this.asm.addRI32(0, 1);
            this.asm.movMBaseR(5, 0, iOff2);
            this.asm.jmpLabel(slLoop2);
            this.asm.bindLabel(slDone2);
            this.asm.movRMBase(0, 5, dstOff);
            this.asm.addRI32(0, 16);
        }
    }

    public void genArrayAny(Node call) {
        Node arrNode = call.child(0);
        int arrOff = this.allocLocal("__arr_any_arr");
        this.genExpr(arrNode);
        this.asm.movMBaseR(5, 0, arrOff);
        this.asm.movRMBase(0, 5, arrOff);
        this.asm.movRMBase(0, 0, -8);
        int yes = this.newLabel();
        int done = this.newLabel();
        this.asm.cmpRI32(0, 0);
        this.asm.jgLabel(yes);
        this.asm.xorRR64(0, 0);
        this.asm.jmpLabel(done);
        this.asm.bindLabel(yes);
        this.asm.movRI64(0, 1);
        this.asm.bindLabel(done);
    }

    public void genArrayAll(Node call) {
        Node arrNode = call.child(0);
        string arrType = this.inferExprType(arrNode);
        string elemType = this.arrayElementType(arrType);
        bool stringElements = this.strEq(elemType, "string");
        int arrOff = this.allocLocal("__arr_all_arr");
        int targetOff = this.allocLocal("__arr_all_target");
        int lenOff = this.allocLocal("__arr_all_len");
        int iOff = this.allocLocal("__arr_all_i");

        this.genExpr(arrNode);
        this.asm.movMBaseR(5, 0, arrOff);
        if (call.childCount() >= 2) {
            this.genExpr(call.child(1));
        } else {
            this.asm.xorRR64(0, 0);
        }
        this.asm.movMBaseR(5, 0, targetOff);
        this.asm.movRMBase(0, 5, arrOff);
