        int sEx = 0xDEADBEEFCAFEBABF;
        this.asm.emitImm64(0, sEx);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
    }

    public void patchForwardCalls(int[] code) {
        for (int i = 0; i < this.forwardCalls.length; i++) {
            int patchPos = this.forwardCalls[i];
            string targetName = this.forwardCallNames[i];
            string targetClass = this.forwardCallClasses[i];
            int targetOff = -1;
            for (int j = 0; j < this.funcNames.length; j++) {
                if (this.strEq(this.funcNames[j], targetName) && this.strEq(this.funcClasses[j], targetClass)) {
                    targetOff = this.funcOffsets[j];
                }
            }
            if (targetOff >= 0) {
                int rel32 = targetOff - (patchPos + 4);
                code[patchPos] = rel32 & 0xFF;
                code[patchPos + 1] = (rel32 >> 8) & 0xFF;
                code[patchPos + 2] = (rel32 >> 16) & 0xFF;
                code[patchPos + 3] = (rel32 >> 24) & 0xFF;
            }
        }
    }    public void emitMethod(Node func, string className) {
    this.currentFunctionName = func.name;
    int emitIdx = -1;
    for (int fi = 0; fi < this.funcNames.length; fi++) {
        if (this.funcOffsets[fi] == -1 && this.strEq(this.funcNames[fi], func.name) && this.strEq(this.funcClasses[fi], className)) {
            emitIdx = fi;
            break;
        }
    }
    if (emitIdx >= 0) {
        this.funcOffsets[emitIdx] = this.asm.buf.length;
    } else {
        this.funcNames.add(func.name);
        this.funcClasses.add(className);
        this.funcRetTypes.add(func.typeHint);
        this.funcOffsets.add(this.asm.buf.length);
    }
    this.localOffsets = [];
    this.localNames = [];
    this.localTypes = [];
    this.stackSize = 0;
    this.currentClassName = className;
    this.asm.label(func.name);
    this.asm.pushR64(5);
    this.asm.movRR64(5, 4);
    this.allocLocal("this");
    int[] paramRegs = [1, 2, 8, 9];
    int numParams = 0;
    if (func.childCount() > 0) {
        Node params = func.child(0);
        numParams = params.childCount();
        for (int i = 0; i < params.childCount(); i++) {
            this.allocLocal(params.child(i).name);
            this.localTypes[this.localTypes.length - 1] = params.child(i).typeHint;
        }
    }
    this.emitFunctionBody(func);
}    public void emitFunction(Node func) {
    this.currentFunctionName = func.name;
    if (this.strEq(func.name, "main")) {
        this.mainLabelOffset = this.asm.buf.length;
        this.hasMain = true;
    }
    int emitIdx = -1;
    for (int fi = 0; fi < this.funcNames.length; fi++) {
        if (this.funcOffsets[fi] == -1 && this.strEq(this.funcNames[fi], func.name)) {
            emitIdx = fi;
            break;
        }
    }
    if (emitIdx >= 0) {
        this.funcOffsets[emitIdx] = this.asm.buf.length;
    } else {
        this.funcNames.add(func.name);
        this.funcClasses.add("");
        this.funcRetTypes.add(func.typeHint);
        this.funcOffsets.add(this.asm.buf.length);
    }
    this.localOffsets = [];
    this.localNames = [];
    this.localTypes = [];
    this.stackSize = 0;
    this.currentClassName = "";
    this.asm.label(func.name);
    this.asm.pushR64(5);
    this.asm.movRR64(5, 4);
    if (func.childCount() > 0) {
        Node paramsFn = func.child(0);
        for (int i = 0; i < paramsFn.childCount(); i++) {
            this.allocLocal(paramsFn.child(i).name);
            this.localTypes[this.localTypes.length - 1] = paramsFn.child(i).typeHint;
        }
    }
