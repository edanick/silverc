        this.asm.bindLabel(notHttps);
        this.asm.movRI64(0, 80);
        this.asm.movMBaseR(5, 0, portOff);
        this.asm.bindLabel(httpsDone);

        // ---- path handling ----
        this.emitLlmaiStringLiteral("/");
        this.asm.movMBaseR(5, 0, pathOff);
        int pathColon = this.newLabel();
        int pathSlash = this.newLabel();
        int pathNone = this.newLabel();
        int pathDone = this.newLabel();
        this.asm.movRMBase(0, 5, hstartOff);
        this.asm.movRMBase(1, 5, jOff);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(0, 0, 0);
        this.asm.cmpRI32(0, 58);
        this.asm.jeLabel(pathColon);
        this.asm.cmpRI32(0, 47);
        this.asm.jeLabel(pathSlash);
        this.asm.jmpLabel(pathNone);

        // ':' -> parse port digits, then find '/' at or after them
        this.asm.bindLabel(pathColon);
        this.asm.movRMBase(0, 5, jOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, kOff);
        this.asm.movRI64(0, 0);
        this.asm.movMBaseR(5, 0, portOff);
        int portLoop = this.newLabel();
        int portDone = this.newLabel();
        this.asm.bindLabel(portLoop);
        this.asm.movRMBase(0, 5, hstartOff);
        this.asm.movRMBase(1, 5, kOff);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(2, 0, 0);
        this.asm.cmpRI32(2, 48);
        this.asm.jlLabel(portDone);
        this.asm.cmpRI32(2, 57);
        this.asm.jgLabel(portDone);
        this.asm.movRMBase(0, 5, portOff);
        this.asm.movRI64(1, 10);
        this.asm.imulRR64(0, 1);
        this.asm.subRI32(2, 48);
        this.asm.addRR64(0, 2);
        this.asm.movMBaseR(5, 0, portOff);
        this.asm.movRMBase(0, 5, kOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, kOff);
        this.asm.jmpLabel(portLoop);
        this.asm.bindLabel(portDone);
        int pathFind = this.newLabel();
        int pathFindDone = this.newLabel();
        int pathFromK = this.newLabel();
        this.asm.bindLabel(pathFind);
        this.asm.movRMBase(0, 5, hstartOff);
        this.asm.movRMBase(1, 5, kOff);
        this.asm.addRR64(0, 1);
        this.asm.movzxByteMBase(0, 0, 0);
        this.asm.cmpRI32(0, 0);
        this.asm.jeLabel(pathFindDone);
        this.asm.cmpRI32(0, 47);
        this.asm.jeLabel(pathFromK);
        this.asm.movRMBase(0, 5, kOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, kOff);
        this.asm.jmpLabel(pathFind);
        this.asm.bindLabel(pathFindDone);
        this.asm.jmpLabel(pathDone);
        // '/' found after the port digits -> path = host + k
        this.asm.bindLabel(pathFromK);
        this.asm.movRMBase(0, 5, hstartOff);
        this.asm.movRMBase(1, 5, kOff);
        this.asm.addRR64(0, 1);
        this.asm.movMBaseR(5, 0, pathOff);
        this.asm.jmpLabel(pathDone);

        // '/' at host[j] -> path = host + j
        this.asm.bindLabel(pathSlash);
        this.asm.movRMBase(0, 5, hstartOff);
        this.asm.movRMBase(1, 5, jOff);
        this.asm.addRR64(0, 1);
        this.asm.movMBaseR(5, 0, pathOff);
        this.asm.jmpLabel(pathDone);

        // no path -> keep "/"
        this.asm.bindLabel(pathNone);
        this.asm.bindLabel(pathDone);

        // ---- copy host to a heap buffer: hbuf = HeapAlloc(hostLen + 1) ----
        this.asm.movRMBase(0, 5, hlenOff);
        this.asm.addRI32(0, 1);
        this.asm.movMBaseR(5, 0, tmpOff);
        this.emitLlmaiHeapAlloc(tmpOff);
        this.asm.movMBaseR(5, 0, hbufOff);
        this.emitLlmaiMemcpy(hbufOff, hstartOff, hlenOff, idxOff);
        this.asm.movRMBase(0, 5, hbufOff);
        this.asm.movRMBase(1, 5, hlenOff);
        this.asm.addRR64(0, 1);
        this.asm.movRI64(1, 0);
