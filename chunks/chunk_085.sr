        // Uses strrchr; returns a pointer into the original string.
        int pathIdx = 0;
        if (call.isMember) { pathIdx = 1; }
        if (call.childCount() <= pathIdx) { this.emitLlmaiStringLiteral(""); return; }

        this.genExpr(call.child(pathIdx));
        int pOff = this.allocLocal("__ge_p");
        this.asm.movMBaseR(5, 0, pOff);

        // strrchr(path, '.'). Same pattern as genStrlenCall.
        this.asm.movRR64(1, 0);
        this.asm.movRI64(2, 46);
        this.addImportPatch("ucrtbase.dll", "strrchr");
        this.asm.emitImm64(0, 0xDEADBEEFCAFEBAD0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.emitCallSetup(0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
        // R0 = dot or NULL
        int dOff = this.allocLocal("__ge_d");
        this.asm.movMBaseR(5, 0, dOff);

        int geHas = this.newLabel();
        int geEnd = this.newLabel();
        this.asm.cmpRI32(0, 0);
        this.asm.jneLabel(geHas);

        // No dot
        this.emitLlmaiStringLiteral("");
        this.asm.jmpLabel(geEnd);

        // Has dot: return dot + 1
        this.asm.bindLabel(geHas);
        this.asm.movRMBase(0, 5, dOff);
        this.asm.movRI64(1, 1);
        this.asm.addRR64(0, 1);

        this.asm.bindLabel(geEnd);
    }

    public void genReadStringCall(Node call) {
        // The path argument sits at child(1) for member calls (`file.readString(p)`
        // where child(0) is the receiver) but at child(0) for the global
        // `readFile(p)` builtin.  Using the wrong slot silently skipped the
        // read and left garbage in RAX.
        int pathIdx = 0;
        if (call.isMember) { pathIdx = 1; }
        if (call.childCount() <= pathIdx) { return; }
        this.genExpr(call.child(pathIdx));
        int pathOff = this.allocLocal("__rs_path");
        this.asm.movMBaseR(5, 0, pathOff);

        this.asm.emitCallSetup(24);
        this.asm.movRI64(0, 3);
        this.asm.movMBaseR(4, 0, 32);
        this.asm.movRI64(0, 0x80);
        this.asm.movMBaseR(4, 0, 40);
        this.asm.xorRR64(0, 0);
        this.asm.movMBaseR(4, 0, 48);
        this.asm.movRMBase(1, 5, pathOff);
        this.asm.movRI64(2, 0x80000000);
        this.asm.movRI64(8, 1);
        this.asm.xorRR64(9, 9);
        this.addImportPatch("kernel32.dll", "CreateFileA");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int hfileOff = this.allocLocal("__rs_hfile");
        this.asm.movMBaseR(5, 0, hfileOff);

        // CreateFileA returns INVALID_HANDLE_VALUE (-1) when the path does
        // not exist. Throw FileNotFoundException in that case.
        int rsDone = this.newLabel();
        int rsCont = this.newLabel();
        this.asm.movRI64(1, 0xFFFFFFFFFFFFFFFF);
        this.asm.cmpRR64(0, 1);
        this.asm.jneLabel(rsCont);
        this.emitThrowException("file not found");
        this.asm.bindLabel(rsCont);

        this.asm.emitCallSetup(0);
        this.asm.movRMBase(1, 5, hfileOff);
        this.asm.xorRR64(2, 2);
        this.addImportPatch("kernel32.dll", "GetFileSize");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();

        int sizeOff = this.allocLocal("__rs_size");
        this.asm.movMBaseR(5, 0, sizeOff);

        this.asm.emitCallSetup(0);
        this.addImportPatch("kernel32.dll", "GetProcessHeap");
        this.asm.emitImm64(0, 0);
        this.asm.movRMBase(0, 0, 0);
        this.asm.callR64(0);
        this.asm.emitCallTeardown();
