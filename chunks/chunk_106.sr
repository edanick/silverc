        if (kind == 59) { return "export"; }
        if (kind == 60) { return "extends"; }
        if (kind == 64) { return "throw"; }
        if (kind == 100) { return "("; }
        if (kind == 101) { return ")"; }
        if (kind == 102) { return "{"; }
        if (kind == 103) { return "}"; }
        if (kind == 104) { return "["; }
        if (kind == 105) { return "]"; }
        if (kind == 106) { return ";"; }
        if (kind == 107) { return ","; }
        if (kind == 108) { return "."; }
        if (kind == 109) { return ":"; }
        if (kind == 110) { return "="; }
        if (kind == 111) { return "+"; }
        if (kind == 112) { return "-"; }
        if (kind == 113) { return "*"; }
        if (kind == 114) { return "/"; }
        if (kind == 115) { return "%"; }
        if (kind == 116) { return "&"; }
        if (kind == 117) { return "|"; }
        if (kind == 118) { return "^"; }
        if (kind == 119) { return "~"; }
        if (kind == 120) { return "<"; }
        if (kind == 121) { return ">"; }
        if (kind == 122) { return "!"; }
        if (kind == 123) { return "?"; }
        if (kind == 125) { return "#"; }
        if (kind == 130) { return "+="; }
        if (kind == 131) { return "-="; }
        if (kind == 132) { return "*="; }
        if (kind == 133) { return "/="; }
        if (kind == 134) { return "=="; }
        if (kind == 135) { return "!="; }
        if (kind == 136) { return "<="; }
        if (kind == 137) { return ">="; }
        if (kind == 138) { return "&&"; }
        if (kind == 139) { return "||"; }
        if (kind == 140) { return "<<"; }
        if (kind == 141) { return ">>"; }
        if (kind == 142) { return "++"; }
        if (kind == 143) { return "--"; }
        if (kind == 144) { return ".."; }
        if (kind == 145) { return "->"; }
        if (kind == 146) { return "=>"; }
        if (kind == 147) { return "..."; }
        if (kind == 148) { return "??"; }
        return "token(" + kind.toString() + ")";
    }

    private string tokenText(Token t) {
        if (t.kind == 0) { return "end of file"; }
        if (t.kind == 3) { return "\"" + t.text + "\""; }
        if (t.kind == 4) { return "'" + t.text + "'"; }
        return t.text;
    }

    public Node[] parseProgram() {
        Node[] items = [];
        Node mainBody = new Node();
        mainBody.kind = 16;
        bool mainSeen = false;
        while (!this.check(0)) {
            int posBefore = this.pos;
            Node? item = this.parseItem();
            if (item != null) {
                if (item.kind == 100 && this.strEq(item.name, "main")) {
                    mainSeen = true;
                }
                if (item.kind == 61 || item.kind == 50 || item.kind == 16 || item.kind == 53 || item.kind == 54 || item.kind == 55 || item.kind == 59 || item.kind == 68) {
                    mainBody.children.add(item);
                } else {
                    items.add(item);
                }
            }
            if (this.pos == posBefore) {
                break;
            }
        }
        if (mainBody.children.length > 0 && !mainSeen) {
            Node main = new Node();
            main.kind = 100;
            main.name = "main";
            main.typeHint = "void";
            Node params = new Node();
            main.children.add(params);
            main.children.add(mainBody);
            items.add(main);
        }
        if (mainSeen) {
            // Top-level variable declarations become real globals when a main
            // function exists: keep them in the program list so codegen can
            // allocate writable slots and run their initializers before main().
            for (int gi = 0; gi < mainBody.children.length; gi++) {
                if (mainBody.children[gi].kind == 50) {
                    items.add(mainBody.children[gi]);
                }
            }
        }
        return items;
